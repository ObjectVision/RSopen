////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Met deze file kunnen de zgn VariantData (Data die specifiek zijn voor Varianten en relatief veel rekentijd kosten om te produceren) worden geexporteerd.
// De Data worden weggeschreven naar de LocalDataDir. Het model gaat er default vanuit dat het deze 'ontkoppelde' Data kan gebruiken, en dus niet hoeft te (her)genereren.
// Dit laatste kan worden aangepast in de /ModelParameters of worden 'overruled' vanuit de batch omgeving
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container WriteVariantData : using = "Classifications;Geography"
{
	container per_Variant :=
		for_each_ne(
			/VariantParameters/VariantK/name
			, 'per_Variant_T('+string(id(/VariantParameters/VariantK))+'[uint8])'
		);
	
	Template per_Variant_T
	{
		//
		parameter<VariantParameters/VariantK> Variant_rel; 
		//
		
		parameter<string> Variant_name  := VariantParameters/VariantK/name[Variant_rel];
		parameter<Bool>   Variant_LeentStand := VariantParameters/VariantK/LeentStand[Variant_rel]
		, Descr = "Leent deze variant haar stand van een andere? Zo ja, dan draait haar allocatie niet en heeft ze dus geen variantdata nodig: de EvidentBenut van deze variant krijgt geen enkele lezer, en de opbrengstentifs staan onder de setnaam uit Geschiktheden/OpbrengstenSet die ze met de uitlenende variant deelt en die dus al door die variant geschreven zijn.

					Gemeten in de productierun van 4 september 2026, waarin BAU2 de stand van BAU leent: 233 seconden voor een EvidentBenut die nul keer gelezen is, en 133 seconden om de BAU-set opbrengstentifs voor de tweede keer te schrijven.

					Wie de allocatie van deze variant weer aanzet, zet StandVanVariant in VariantK terug op de variant zelf; dan valt LeentStand vanzelf om en komt de variantdata terug. En raakt dat een keer uit de pas, dan is dat niet fataal: vraagt de allocatie een EvidentBenut op zonder geldig bestand, dan rekent en schrijft ze hem alsnog.";

		parameter<String> Generate_Run1 :=
			 Impl/EvidentBenut
		, Descr = "Maakt de EvidentBenut-tifs voor deze variant. Sinds EvidentBenut per variant staat is dit weer echt variantwerk. Strikt genomen is deze stap optioneel geworden: vraagt de allocatie de EvidentBenut op terwijl er geen geldig bestand ligt, dan rekent en schrijft hij hem alsnog. Je roept dit dus alleen apart aan om de dure stap op een gekozen moment te laten gebeuren en om vroeg te falen.";

		parameter<String> Generate_Run2 :=
			 Impl/Suitability_Opbrengsten_perOP + ';' + Impl/Veenbouwstenen
		, Descr = "Activeer dit item om alle te ontkoppelen variant data te genereren.";

		container Impl
		{
			parameter<String> EvidentBenut := 'Ready'
			, ExplicitSuppliers = "=Variant_LeentStand
										? ''
										: (ModelParameters/SectorAllocRegio/Uq_Sectors/HasZonSector
											? 'VariantData/'+Variant_name+'/EvidentBenut/Make_IsEvidentBenut_AdminDomain;VariantData/'+Variant_name+'/EvidentBenut/Make_IsEvidentBenutZon_AdminDomain'
											: 'VariantData/'+Variant_name+'/EvidentBenut/Make_IsEvidentBenut_AdminDomain')"
			, Descr = "De zon-variant komt er alleen bij wanneer de zonsector meedraait, en een variant die haar stand leent maakt niets: zie Variant_LeentStand.";

			parameter<String> Veenbouwstenen := 'Ready'
			, ExplicitSuppliers = "=Variant_name == 'NbSGenuanceerd'
									? 'SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Write_Bouwsteenkaart'
									: ''"
			, Descr = "Schrijft de kaart met de gealloceerde veenbouwsteen weg, voor team effectbepaling (#764). Alleen NbSGenuanceerd heeft een veenlevering, dus voor de andere varianten is er niets te leveren en blijft de lijst leeg.

						Dit hangt hier en niet aan een eigen batchstap, omdat een uitlevering die alleen op verzoek ontstaat er in een productierun niet is. De kaart is variantwerk en hoort dus in dezelfde stap als de andere variantdata.";

			parameter<String> Suitability_Opbrengsten_perOP := 'Ready'
			, ExplicitSuppliers = "=Variant_LeentStand
										? ''
										: 'VariantData/'+Variant_name+'/Suitability/Src/Wonen/Impl/WriteOpbrengsten_perOP/GenerateAll'"
			, Descr = "De opbrengstentifs per ontwikkelpakket. Een variant die haar stand leent slaat dit over: die deelt haar OpbrengstenSet met de uitlenende variant, dus ze zou dezelfde bestanden een tweede keer schrijven. Zie Variant_LeentStand.";

		}
	}
}
