////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Met deze file kunnen de zgn VariantData (Data die specifiek zijn voor Varianten en relatief veel rekentijd kosten om te produceren) worden geexporteerd.
// De Data worden weggeschreven naar de LocalDataDir. Het model gaat er default vanuit dat het deze 'ontkoppelde' Data kan gebruiken, en dus niet hoeft te (her)genereren.
// Dit laatste kan worden aangepast in de /ModelParameters of worden 'overruled' vanuit de batch omgeving
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container WriteVariantData : using = "Classifications;Geography"
{
	parameter<String> Generate_EvidentBenut := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasZonSector
														? '/EvidentBenutBGT/Generate + /EvidentBenutBGT/Generate_Zon'
														: '/EvidentBenutBGT/Generate'
	, Descr = "Genereert de EvidentBenut-tifs. Dit staat bewust HIER en niet in per_Variant_T: EvidentBenut hangt af van de gekozen BGT-klassenset, niet van de variant, en wordt daarom een keer per unieke set gemaakt in plaats van een keer per variant (issue 20). De zon-variant komt er alleen bij wanneer de zonsector meedraait.";

	container per_Variant :=
		for_each_ne(
			/VariantParameters/VariantK/name
			, 'per_Variant_T('+string(id(/VariantParameters/VariantK))+'[uint8])'
		);
	
	Template per_Variant_T
	{
		//
		parameter<VariantParameters/VariantK> Variant_rel; 
		//
		
		parameter<string> Variant_name  := VariantParameters/VariantK/name[Variant_rel];
		
		parameter<String> Generate_Run1 := Generate_EvidentBenut
		, Descr = "Activeer dit item om alle te ontkoppelen variant data te genereren. LET OP: de inhoud hiervan is niet meer variantspecifiek, want EvidentBenut wordt gedeeld over varianten met dezelfde BGT-klassenset. Een aanroep volstaat dus; per variant aanroepen levert hetzelfde resultaat en geen extra werk.";
		
		parameter<String> Generate_Run2 := 
			 Impl/Suitability_Opbrengsten_perOP 
		, Descr = "Activeer dit item om alle te ontkoppelen variant data te genereren.";
		
		container Impl 
		{
			parameter<String> Suitability_Opbrengsten_perOP := 'Ready', ExplicitSuppliers = "='VariantData/'+Variant_name+'/Suitability/Src/Wonen/Impl/WriteOpbrengsten_perOP/GenerateAll'";
			
		}
	}
}
