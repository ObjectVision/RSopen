// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Landelijke reeksen over het ruimtegebruik van werken en de bouwgrond, voor een artikel in ESB. Alle uitvoer
// gaat als csv naar %LocalDataProjDir%/ESB_Ruimte. Laadt via #include: WerkenPerBaan, WaardePerM2, Bouwterrein.
//


container ESB_Ruimte
: Descr = "Landelijke reeksen over het ruimtegebruik van werken en de bouwgrond, voor een artikel in ESB over de verdeling van de fysieke ruimte. Op aanvraag; niets hier draait mee in een allocatierun. Alleen op de tak esb-ruimte."
{
	parameter<String> UitvoerDir := '%LocalDataProjDir%/ESB_Ruimte', Descr = "De map waar de csv's van deze analyses heen gaan.";

	#include <WerkenPerBaan.dms>
	#include <WaardePerM2.dms>
	#include <Bouwterrein.dms>
}
