// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De inrichting van het stedelijk groen dat de sector StedelijkGroen aanlegt. Zie ObjectVision/RSopen#480.
//


container StedelijkGroen
: Descr = "De inrichting van het nieuwe stedelijk groen (#480): drie inrichtingstypen met hun verdeling over verharding, gras, struik, boom, water en bruin, in dezelfde klassen als de inrichting van een
			ontwikkelpakket. Welk deel van het nieuwe groen van elk type is, staat per variant in VariantK (FractieParkStedelijkGroen en de twee rijen daarna)."
{
	unit<UInt8> InrichtingK : nrofrows = 3
	, Descr = "De inrichtingstypen van nieuw stedelijk groen, gemeten in de bestaande parken. Een park met minstens 15 procent water is een blauwgroen park, een park met minstens 30 procent bos een stadsbos,
				de rest een gewoon park; beide grenzen liggen ongeveer bij het bovenste kwart van de parken en zijn een keuze. De fracties zijn het gemiddelde van de parken van een type, gewogen naar hun
				oppervlakte."
	, Source = "Parken: BRT TOP10NL van 1 juni 2026, functioneel gebied park (2.162 parken, 16.983 ha). Verhard, groen, water en bruin: de BGT-oppervlakken per cel van 25 m uit de levering van 19 augustus 2026,
				over de cellen waarvan het middelpunt in het park ligt. Boom en struik: Atlas Natuurlijk Kapitaal (RIVM), bomenkaart en struikenkaart 2022 (10 m, AHN4 met de infraroodluchtfoto van 2022),
				boom begrensd op het groen en struik op het groen naast de boom, gras de rest van het groen. Bos voor de indeling in typen: BRT TOP10NL 2026, terrein bos (#480)."
	{
		attribute<String>  name    : ['Park', 'Stadsbos', 'BlauwgroenPark'];
		attribute<String>  Label   : ['park', 'stadsbos', 'blauwgroen park'], DialogType = "LabelText";
		attribute<Float32> Verhard : [0.296, 0.197, 0.225], Descr = "Paden, pleinen en parkeerplaatsen, als fractie van het park.";
		attribute<Float32> Gras    : [0.278, 0.153, 0.165], Descr = "Groen zonder boomkroon of struik, als fractie van het park.";
		attribute<Float32> Struik  : [0.055, 0.072, 0.058], Descr = "Struiken van 1 tot 2,5 meter hoog, als fractie van het park.";
		attribute<Float32> Boom    : [0.219, 0.467, 0.263], Descr = "Boomkroon, van bovenaf gezien, als fractie van het park; kroon boven paden of water telt niet mee.";
		attribute<Float32> Water   : [0.074, 0.063, 0.238], Descr = "Open water, als fractie van het park.";
		attribute<Float32> Bruin   : [0.078, 0.048, 0.051], Descr = "Onbegroeide grond, zoals zand en erf, als fractie van het park.";
		attribute<Float32> Som     := add(Verhard, Gras, Struik, Boom, Water, Bruin)
		, IntegrityCheck = "all(abs(this - 1f) < 0.002f)"
		, Descr = "De zes fracties samen; hoort 1 te zijn.";
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	parameter<UInt32>  MinInwonersWoonkern := 50000
	, Descr = "Alleen het groentekort van woningen in een kern met minstens zoveel inwoners wordt een claim voor nieuw stedelijk groen. Een kern is een BRT-woonkern, met zijn eigen aantal inwoners; een nieuwbouwwijk buiten de woonkernen telt als de grootste kern waar hij aan vastzit. De referentie van de normtoets is bedoeld voor groen in de stad; in een dorp telt de landbouwgrond eromheen niet als groen, en zonder deze grens komen er ringen van parken om dorpen in het open land (#480)."
	, Source = "Alterra (2002), Groene meters, Alterra-rapport 584: de referentie van 75 m2 groen per woning, voor groen in de stad, getoetst in tien steden van de G30; de grens ligt bij de omvang van die steden. Inwoners: BRT, plaatsen met type woonkern, peildatum 1 juli 2025.";

	parameter<Float32> MinTekortAandeelVanCel := 0.02f
	, Descr = "Een cel komt alleen in aanmerking voor nieuw stedelijk groen als het groentekort dat de woningen eromheen hem in totaal toedelen, minstens dit deel van zijn oppervlak is. Zonder drempel komen de parken ook op cellen die nauwelijks tekort oplossen, vooral aan de stadsrand, omdat landbouwgrond daar het goedkoopst is (#480).";

	parameter<Bool>    VormtoetsTeltBestaandGroenEnWater := FALSE
	, Descr = "Telt de vormtoets van nieuw stedelijk groen het bestaande groen, de natuur en het water mee voor de minimale omvang? Dan haalt een nieuw park van 0,4 ha tegen een bestaand park van 0,6 ha de omvang van 1 ha. Voor de breedte telt het niet mee: het nieuwe groen moet zelf breed genoeg zijn, anders haalt een losse cel langs een sloot of plantsoen de breedte-eis door wat er naast ligt. Uit, dan moet een nieuw park de vormtoets met wat er dit zichtjaar is aangelegd halen. Hij staat uit tot de toets op de kaart in #906.";

	parameter<Float32> OpslagAansluitenBestaandGroen := 0.5f
	, Descr = "Hoeveel geschikter een cel voor nieuw stedelijk groen is als hij grenst aan bestaand groen, natuur of water, als fractie: de geschiktheid en de baat worden met 1 plus deze waarde vermenigvuldigd. Zo groeit een bestaand park liever aan dan dat er een los park naast komt, want een groter park is meer waard; het voorstel van Deltares in #480, de waarde is een keuze (#906).";

	parameter<meter>   AfstandHoofdinfra := 50[meter]
	, Descr = "Binnen deze afstand van de hartlijn van een weg van een type uit HoofdinfraWegtype, of van een spoorlijn van een type uit HoofdinfraSpoortype, komt geen nieuw stedelijk groen, behalve waar de weg of spoorlijn in een tunnel ligt. Een strook langs grote infrastructuur is geen park: het is er lawaaiig en langs het spoor vaak niet toegankelijk, terwijl de normtoets het wel als groen telt (#480).";
	parameter<UInt8>   BufferHoekenHoofdinfra := 8b
	, Descr = "Het aantal hoeken waarmee de buffer langs de hoofdinfra zijn rondingen aan de uiteinden en in de knikken van een lijn benadert (nr_angles van bg_buffer_linestring). Hoe meer hoeken, hoe ronder de strook en hoe langer het rekenen; een andere waarde maakt de strook opnieuw.";

	unit<UInt8> HoofdinfraWegtype : nrofrows = 2
	, Descr = "De wegtypen van de BRT (typeweg van de hartlijn) waarlangs geen nieuw stedelijk groen komt, binnen AfstandHoofdinfra. Regionale wegen staan er niet in: in een stad zijn dat vaak de grote straten, en gewone stadsparken grenzen daaraan (#480)."
	{
		attribute<String> name : ['autosnelweg', 'hoofdweg'];
	}

	unit<UInt8> HoofdinfraSpoortype : nrofrows = 3
	, Descr = "De spoortypen van de BRT (typespoorbaan van het spoorbaandeel) waarlangs geen nieuw stedelijk groen komt, binnen AfstandHoofdinfra. Tram staat er niet in, want die rijdt meestal door een straat (#480)."
	{
		attribute<String> name : ['trein', 'metro', 'sneltram'];
	}
}
