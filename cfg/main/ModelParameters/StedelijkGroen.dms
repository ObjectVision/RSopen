// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De inrichting van het stedelijk groen dat de sector StedelijkGroen aanlegt. Zie ObjectVision/RSopen#480.
//


container StedelijkGroen
: Descr = "De inrichting van het nieuwe stedelijk groen (#480): drie inrichtingstypen met hun verdeling over verharding, gras, struik, boom, water en bruin, in dezelfde klassen als de inrichting van een
			ontwikkelpakket. Welk deel van het nieuwe groen van elk type is, staat per variant in VariantK (FractieParkStedelijkGroen en de twee rijen daarna)."
{
	unit<UInt8> InrichtingK : nrofrows = 3
	, Descr = "De inrichtingstypen van nieuw stedelijk groen, gemeten in de bestaande parken. Een park met minstens 15 procent water is een blauwgroen park, een park met minstens 30 procent bos een stadsbos,
				de rest een gewoon park; beide grenzen liggen ongeveer bij het bovenste kwart van de parken en zijn een keuze. De fracties zijn het gemiddelde van de parken van een type, gewogen naar hun
				oppervlakte."
	, Source = "Parken: BRT TOP10NL van 1 juni 2026, functioneel gebied park (2.162 parken, 16.983 ha). Verhard, groen, water en bruin: de BGT-oppervlakken per cel van 25 m uit de levering van 19 augustus 2026,
				over de cellen waarvan het middelpunt in het park ligt. Boom en struik: Atlas Natuurlijk Kapitaal (RIVM), bomenkaart en struikenkaart 2022 (10 m, AHN4 met de infraroodluchtfoto van 2022),
				boom begrensd op het groen en struik op het groen naast de boom, gras de rest van het groen. Bos voor de indeling in typen: BRT TOP10NL 2026, terrein bos (#480)."
	{
		attribute<String>  name    : ['Park', 'Stadsbos', 'BlauwgroenPark'];
		attribute<String>  Label   : ['park', 'stadsbos', 'blauwgroen park'], DialogType = "LabelText";
		attribute<Float32> Verhard : [0.296, 0.197, 0.225], Descr = "Paden, pleinen en parkeerplaatsen, als fractie van het park.";
		attribute<Float32> Gras    : [0.278, 0.153, 0.165], Descr = "Groen zonder boomkroon of struik, als fractie van het park.";
		attribute<Float32> Struik  : [0.055, 0.072, 0.058], Descr = "Struiken van 1 tot 2,5 meter hoog, als fractie van het park.";
		attribute<Float32> Boom    : [0.219, 0.467, 0.263], Descr = "Boomkroon, van bovenaf gezien, als fractie van het park; kroon boven paden of water telt niet mee.";
		attribute<Float32> Water   : [0.074, 0.063, 0.238], Descr = "Open water, als fractie van het park.";
		attribute<Float32> Bruin   : [0.078, 0.048, 0.051], Descr = "Onbegroeide grond, zoals zand en erf, als fractie van het park.";
		attribute<Float32> Som     := add(Verhard, Gras, Struik, Boom, Water, Bruin)
		, IntegrityCheck = "all(abs(this - 1f) < 0.002f)"
		, Descr = "De zes fracties samen; hoort 1 te zijn.";
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	parameter<Float32> MinTekortAandeelVanCel := 0.25f
	, Descr = "Een cel komt alleen in aanmerking voor nieuw stedelijk groen als het groentekort dat de woningen eromheen hem in totaal toedelen, minstens dit deel van zijn oppervlak is. Zo komt er geen park van een hectare bij een gehucht dat een paar honderd vierkante meter tekort heeft (#480).";
}
