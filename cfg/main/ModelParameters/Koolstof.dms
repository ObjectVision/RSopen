// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Parameters van de indicatoren koolstofopslag en -vastlegging en methaan. Zie ObjectVision/RSopen#483 en #657.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Koolstof
: Descr = "Parameters van de indicatoren koolstofopslag en -vastlegging (#483) en methaan (#657): de kentallen en de aannames die bij Deltares ter controle liggen. De lezers,
			Templates/Indicatoren/CarbonStorageSequestration_T en Methaan_T, dragen de toelichting per waarde; welke aannames nog bevestiging vragen staat in #632 en #758."
{
	parameter<string>                       Koolstof_MaxSrc                        := 'Cmax_ha_invest'; // Cmax_ha_WUR
	
	parameter<String>                       Koolstof_SOMERSEmissieVariant          := 'Mediaan', Descr = "Welke SOMERS-emissievariant de koolstofboekhouding voedt: Minimum, Mediaan of Maximum, zie Classifications/CO2/EmissieK. De indicator SOMERS_CO2_laagveen rapporteert alle drie; de voorraad kan er maar een verwerken.";

	parameter<Float32>                      Koolstof_VeenOrganischeStofdichtheid   := 0.103f, Descr = "Dichtheid van de organische stof in veen, in ton per m3, voor het omrekenen van veendikte naar een koolstofreserve; niet de droge bulkdichtheid, want daar zit de minerale fractie in. Het gemiddelde voor de Nederlandse ondergrond zonder het diep begraven veen, met 0,080 en 0,150 als minimum- en maximumscenario.", Source = "Erkens et al. 2016, Hydrogeology Journal, aangewezen door Deltares in #657";
	parameter<Float32>                      Koolstof_VeenKoolstoffractie           := 0.5f, Descr = "Massafractie koolstof in de organische stof van veen, voor het omrekenen van veendikte naar een koolstofreserve. Samen met de organischestofdichtheid geeft 0,103 maal 0,5 maal 10.000 een reserve van 515 ton C per hectare per meter veen.", Source = "Erkens et al. 2016, Hydrogeology Journal, dezelfde aanname (52 kg C per m3)";

	parameter<Float32>                      Koolstof_MineraleOndergrens_tonC_ha    := 75f, Descr = "De koolstofvoorraad die in de bovenste 30 cm achterblijft als de veenbovengrond daar volledig is geoxideerd, in ton C per hectare; de veenoxidatie schrijft af tot deze grens en niet tot nul
											(Zichtjaar/Carbon/Stock/Afschrijfbaar_ha in het sjabloon, #736). Zonder ondergrens loopt de voorraad tot nul leeg, en zo'n bodem bestaat niet: aerobe oxidatie eindigt in een moerige
											eerdgrond of een humeuze zandgrond. 75 volgt uit 3.000 m3 per hectare maal een bulkdichtheid van 1,25 ton per m3 maal 4 procent organische stof maal koolstoffractie 0,5, en ligt tussen het
											vijfde en het tiende percentiel van agrarisch grasland op zand in de bodemkoolstofkaart. Op nul geeft het gedrag van voor #736.";

	parameter<Float32>                      Koolstof_VastleggingsdeelInWisselperiode := 0.5f, Descr = "Welk deel van de periode meetelt als aanwastijd in het zichtjaar waarin de klasse wisselt (#737): 1 neemt aan dat de verandering aan het begin van de periode viel, 0 telt de wisselperiode niet mee, 0,5 is de middenaanname. Van belang omdat de eerste periode zeventien jaar beslaat.";

	parameter<Bool>                         Koolstof_KlassenAanvullen              := TRUE, Descr = "Vul de zestien LGN-klassen die in de koolstoftabel van Deltares ontbreken aan met een koolstofklasse (TRUE, #737); de toewijzingen staan met reden in
											Classifications/Grondgebruik/CarbonClassAanvulling, elk overgenomen van de LGN-klasse waarvan zij een variant zijn. Zonder klasse doet een cel aan geen enkele kant mee: er wordt niet
											afgeboekt als erop gebouwd wordt, en de vastleggingspoort (LegtVast in het sjabloon) ziet de verandering niet. Een schakelaar omdat de toewijzingen van Object Vision zijn en niet van
											Deltares.";

	// ----- Vervolg op RSopen #657: de kentallen van team Veen en het veen buiten de SOMERS-percelen -----
	// Drie aannames die bij Deltares ter controle liggen. Ze stonden alle drie uit tot 3 september 2026; sindsdien staan
	// ze aan, op de reactie van team Veen in #657 en het besluit over stedelijk veen. Aan betekent hier niet bevestigd:
	// het vragenblok dat bij de oplevering meegaat staat in #632, en #758 houdt bij wat er nog uit moet komen.
	// De kengetallen zelf staan in Classifications/Grondgebruik/VeenBroeikasgas.
	parameter<Bool>                         Koolstof_VeenVastleggingUitBouwstenen  := TRUE, Descr = "Gebruik op veen- en moerige bodem de vastleggingskentallen van team Veen voor de veenvormende klassen, in plaats van de generieke Cseq_ha uit de koolstofklassentabel (#657). Team Veen geeft
												voor de veenvormende bouwstenen een veel hogere netto opname dan de tabel, en de voorraad uit de bodemkoolstofkaart ligt op veen ver boven het klassemaximum van riet, zodat de vastlegging
												daar anders nul blijft; de schakelaar zet daarom het kental en het maximum om, met als aanname dat veenvorming koolstof toevoegt in plaats van naar een plafond toegroeit. Sinds #758 alleen
												in de NbS-varianten, want BAU en BAU2 rekenen uitsluitend met SOMERS, en binnen dat regime vervangen de kentallen de hele SOMERS-stroom (CarbonStorageSequestration_T/VeenKentalGeldt).";
	parameter<Float32>                      Koolstof_EF_Veen_tonCO2_ha_jaar        := 13f, Descr = "Emissiefactor voor gedraineerd veen buiten de SOMERS-percelen, in ton CO2 per hectare per jaar. De 13 van bouwsteen 1 uit de veenlevering en niet de 10,59 uit EF_low_nl_2025.csv, op aanwijzing van Deltares in #793, voor consistentie met de bouwstenen.", Source = "bouwstenentabel team Veen, bouwsteen 1 (#793); de csv EF_low_nl_2025 uit #657 geeft 10,59";
	parameter<Float32>                      Koolstof_EF_Moerig_tonCO2_ha_jaar      := 11.96f, Descr = "Idem voor de moerige gronden, uit dezelfde tabel: 1,196 kg CO2 per m2 per jaar. Dat de moerige gronden hoger staan dan de veengronden is wat de aangeleverde tabel zegt; het is niet nagevraagd.";
	parameter<Bool>                         Koolstof_EFStedelijkOpNul              := FALSE, Descr = "Houd het bestaand stedelijk gebied op de veenbodem buiten de SOMERS-percelen op nul uitstoot (TRUE), of pas de emissiefactor ook daar toe (FALSE)? Op FALSE volgens #758: de
												emissiefactorentabel geeft panden, erven, openbare ruimte en stedelijk groen op veen dezelfde factor als de percelen. Nieuwbouw in de NbS-varianten stoot niet uit, want daar wordt volgens
												Deltares zo ingericht dat de oxidatie stopt; dat onderscheid zit in CarbonStorageSequestration_T/VeenKental. De aanname is nog niet door team Veen bevestigd (#632).";
	parameter<Bool>                         Koolstof_KentalUitBouwsteencomponent   := TRUE, Descr = "Krijgen natte teelt en vernat grasland het kental van hun eigen bouwsteencomponent (TRUE), of dat van de koolstofklasse waarin hun landgebruik valt (FALSE)? Alleen binnen het kentalregime,
												dus met Koolstof_VeenVastleggingUitBouwstenen in een NbS-variant. Trap 2 van #684 legt een bouwsteen ruimtelijk uit elkaar in componenten terwijl de kentallen per hele bouwsteen gelden; op
												TRUE krijgt het natte-teeltdeel het kental van de bouwstenen die geheel natte teelt zijn (3b en 4b), op FALSE dat van koolstofklasse 18, een mozaiek met 0,30 natte teelt, plus de
												veenvormende vastlegging. Welke van de twee de bedoeling is ligt als vraag bij Deltares in #778; de kentallen per component staan in Classifications/Grondgebruik/NbSVeen/NbSLandgebruik.";
}
