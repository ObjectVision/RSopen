// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de ModelParameters: Parameters die voor elk scenario en elke Variant hetzelfde zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Advanced
{
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Wonen              := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Wonen              := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Werken             := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Werken             := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Verblijfsrecreatie := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Verblijfsrecreatie := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Waterberging                       := 2[ha];

	parameter<uint8>     IterVanafWaarWeAfgewezenCellenUitsluitenInAlloc             := 1b, Descr = "Vanaf welke iteratie afgewezen cellen uit de beschikbaarheid gaan. Een cel die losliggend boven de zaaglijn uitkomt haalt de erosie-eis nooit en wordt anders elke iteratie opnieuw gekozen en afgewezen; uitsluiten vanaf de eerste iteratie houdt het proces in beweging (#643).";
	parameter<float32>   MorfologischeCleaning_Aantal_BuurCellenAllocOmTeOverleven   := 6f, Descr = "Terugvalwaarde; de allocatie gebruikt de sectorspecifieke waarde hieronder. De erosie telt over een 3x3-blok inclusief de cel zelf en eist er parameter+1 van de negen, dus dit is een minimale beukmaat: op 6 overleeft alleen wat minstens 75 meter breed is, op 3 tot en met 5 alles vanaf 50 meter, daaronder ook een lint van een enkele cel (#643).";
	parameter<float32>   MorfologischeCleaning_BuurCellen_Wonen                      := 6f, Descr = "Minimale beukmaat voor wonen: 6 is 75 meter, 5 is 50 meter. Op 5 gaat het binnenstedelijke aandeel van 20,4 naar 24,3 procent en komen er 6.496 woningen bij, maar overleeft ook een lint van 50 meter langs een weg. Dat is de afweging.";
	parameter<float32>   MorfologischeCleaning_BuurCellen_Werken                     := 6f;
	parameter<float32>   MorfologischeCleaning_BuurCellen_Verblijfsrecreatie         := 6f;
	parameter<float32>   MorfologischeCleaning_BuurCellen_Waterberging               := 6f;

	parameter<String>    AdminDomain_ref               := '25m', Descr = "Ruimtelijke resolutie waarop de allocatieresultaten worden geadminstreerd";
	parameter<String>    AllocDomain_ref               := '100m', Descr = "Ruimtelijke resolutie waarop de allocatie plaatsvindt (keuze-eenheid)";
	parameter<string>    AllocatieFileName             := '%LocalDataProjDir%/Allocatie/@CASUS@/Stand@JAAR@/@STANDPATH@_@SA@_SS-@SS@.tif'
	, Descr = "Sjabloon voor de bestandsnaam van de standtifs; de placeholders worden gevuld met de casus, het zichtjaar, StandVar/path, ModelParameters/StudyArea en het aantal
				Sector/xSubsector-combinaties. Ingevuld in Templates/Allocatie/Zichtjaar_T (lezen en schrijven), Templates/Indicatoren.dms en Templates/Indicatoren_T/Export.dms (alleen lezen). De
				indicatorenkant vult @CASUS@ met StandCasus_name en niet met Casus_name (#730): via VariantParameters/VariantK/StandVanVariant kan een variant de stand van een andere lezen, zoals BAU2 die
				van BAU, en dan is er geen eigen allocatiemap.";

	parameter<string>    ImperviousnessMapYear         := 'y2024';
	parameter<Bool>      BAG_LogistiekDynamisch        :=  TRUE, Descr = "Vult de statische logistieke pandenset (stand 2021) aan met een LISA-afgeleide typering van nieuwbouw vanaf 2021, via het ontkoppelde bestand LogistiekAanvulling_FileName. Zonder aanvulling
											kan nieuwbouw nooit logistiek worden en telt zij als Nijverheid. Hergenereren na een BAG- of LISA-vintagewissel: tijdelijk op FALSE, WritePrivData/LogistiekAanvulling/Generate draaien en
											weer op TRUE, want met de parameter aan trekt het pand-domein het nog te schrijven bestand als supplier mee.";

	parameter<uint16>    FromWhichDoWeKeepTIGRISconstant := 2060w;
	parameter<YearRange> PlancapaciteitGeldigTotEnMet    := 2050[YearRange], Descr = "Tot en met welk zichtjaar plancapaciteit de zeef-restricties opheft; daarna vervalt de vrijstelling door harde en zachte plannen, want een vastgesteld plan uit de jaren twintig zegt niets
																					meer over waar in 2060 gebouwd mag worden. Op 2050 geldt de vrijstelling in Y2040 en Y2050, hetzelfde jaar waarop de claim bevriest (FromWhichDoWeKeepTIGRISconstant). Werkt sinds #682 ook op
																					de basisjaar-zeef, die daarom twee uitkomsten levert waaruit Zeef_T/BasisjaarZeefItem per zichtjaar kiest; de trede-voorrang volgt dezelfde datum via TredeVolgtPlancapaciteitVervaldatum.";

	parameter<Bool>      TredeVolgtPlancapaciteitVervaldatum := TRUE, Descr = "Vervalt de trede-voorrang van plancapaciteit op dezelfde datum als de restrictievrijstelling (#739)? Op TRUE zakt een cel binnen een hard of zacht plan vanaf het zichtjaar na
																					PlancapaciteitGeldigTotEnMet naar de stimuli-trede of de restcategorie; op FALSE houdt hij zijn plek bovenaan de ladder tot het eindjaar. Een aparte schakelaar omdat de trede zwaarder weegt
																					dan de zeef: de as staat vooraan in de combine en IterSubsector_T ordent strikt lexicografisch. Van de vijf trede-assen bewegen deze, de UrbanContour-as en de eigendom-as mee;
																					OV-bereikbaarheid en bouwterrein staan op het basisjaar (#749).";

	parameter<YearRange> EigendomGeldigTotEnMet   := 2050[YearRange], Descr = "Tot en met welk zichtjaar het grondeigendom uit het basisjaar de trede-voorrang bepaalt (#749). Werkt alleen met EigendomVolgtVervaldatum hieronder aan, en staat bewust los van PlancapaciteitGeldigTotEnMet: een vastgesteld plan en een eigendomsverhouding verouderen niet op hetzelfde tempo, dus de twee horen apart instelbaar te zijn.";
	parameter<Bool>      EigendomVolgtVervaldatum := TRUE, Descr = "Vervalt de eigendom-as van de trede na EigendomGeldigTotEnMet (#749)? Op TRUE valt elke cel daarna in de klasse Totaal en onderscheidt de as niets meer; op FALSE bepaalt het grondeigendom van het basisjaar de voorrang tot het eindjaar. Er is geen bron voor de ontwikkeling van het eigendom, dus dit zet de as uit en vervangt hem niet.";

	parameter<Bool>      UrbanContourVolgtNieuwbouw := TRUE, Descr = "Groeit het bestaand bebouwd gebied van de trede mee met wat het model bouwt (#749)? Op TRUE wordt de as per zichtjaar opnieuw opgebouwd in
																					Templates/Allocatie/Zichtjaar_T/TredeDynamischeUrbanContour: de UrbanContour van het basisjaar plus een schijf van 100 meter, een AllocDomain-cel, rond wat in eerdere zichtjaren voor wonen
																					of werken is gealloceerd. De toewijzing aan trede-klassen gaat daarmee van een keer per variant naar een keer per zichtjaar; de ladder zelf blijft gedeeld. De eigendom-as leest de
																					UrbanContour via BaseData en groeit niet mee.";

	parameter<Bool>      MilieuzoneringVrijgesteldDoorZachtPlan := FALSE, Descr = "Zet een zacht plan de milieuzonering opzij (#742)? Op FALSE alleen een hard plan, op TRUE elk plan. Een hard plan heeft de toets op geluid, geur, stof en gevaar doorlopen en een zacht plan is een voornemen; daarom FALSE.";

	// GRONDGEBRUIK 
	parameter<meter2>                       MinimumPandFootprint             := 20[meter2], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor werken worden gehanteerd. Hiervoor wordt de pandfootprint gebruikt.";
	parameter<Woning>                       MinimumWoningAmount              := 5[Woning], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor wonen worden gehanteerd. Hiervoor wordt het aantal woningen gebruikt.";
	parameter<Verblijfsobject>              MinimumVerblijfsobjectAmount     := 1[Verblijfsobject], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor verblijfsrecreatie worden gehanteerd. Hiervoor wordt het aantal verblijfsobjecten gebruikt.";
	parameter<UInt32>                       MinimumGroupSize                 := 3, Descr = "Om de landgebruikskaart aan te laten sluiten bij de BBG, wordt een vergelijkbare methodiek gehanteerd waarbij 25m cellen worden gegroepeerd. Pas als deze drempel wordt bereikt wordt een cel overwogen om in de landgebruikskaart te komen.";
	parameter<Bool>                         ToetsWonenOpWaterInKaart         := FALSE, Descr = "Laat de landgebruikskaart afbreken zodra wonen is gealloceerd op een cel die de kaart water noemt (Toets_WonenOpWater/Woningen_WaterWintVanWonen in Templates/Indicatoren/Landgebruikskaart). Uit, want de zeef geeft in IJburg 2 met opzet water vrij voor wonen (#665); pas aanzetten als het getal nul is.";

	parameter<Bool>                         SchadeToetstBouwwijzeVanPakket   := TRUE, Descr = "Waarop bepaalt de overstromingsschade wat een maatregel aan een nieuwbouwwoning doet (#681, met Deltares)? Op TRUE op de bouwwijze van het gealloceerde ontwikkelpakket: de schadefactor wordt
																									afgelezen bij de waterdiepte min BouwwijzeK/SchadevrijeDiepte, met een ondergrens van nul, zoals SSM2017 een hoger vloerpeil zelf als verschuiving langs de diepte-as doet. Op FALSE een
																									drempel op de eis van de plek, waarbij de woning niet meetelt zodra de gevaarzone bouwen met maatregelen voorschrijft. De schakelaar werkt op twee plaatsen:
																									Grondgebruik/Zichtjaar/IsOverstromingsbestendig (de drempel) en Parameters/<watersysteem>/Diepte_Nieuwbouw (de verschuiving).";


	// KOOLSTOF (indicator koolstofopslag en -vastlegging, zie RSopen #483)
	parameter<string>                       Koolstof_MaxSrc                        := 'Cmax_ha_invest'; // Cmax_ha_WUR
	
	parameter<Bool>                         Koolstof_BasisvoorraadUitKaart         := TRUE, Descr = "Startvoorraad koolstof in het basisjaar uit de bodemkoolstofkaart van de Atlas Natuurlijk Kapitaal (TRUE, SourceData/Bodem/BodemKoolstofvoorraad) of op nul beginnen zoals voorheen (FALSE). Op nul beginnen geeft een bovengrens van de vastlegging, omdat er in werkelijkheid al koolstof in de bodem zit.";
	parameter<Bool>                         Koolstof_BasisvoorraadBegrenzen        := FALSE, Descr = "Begrens de startvoorraad uit de kaart op het maximum van de landgebruiksklasse in het basisjaar (variant 3 uit RSopen #483). De kaart ligt op ongeveer tweederde van het areaal boven dat maximum, omdat de kaart de bodemvoorraad in de bovenste 30 cm geeft en het maximum uit de kengetallentabel komt. Alleen zinvol in combinatie met Koolstof_BasisvoorraadUitKaart.";
	parameter<Bool>                         Koolstof_AfboekenAlleenBijLagerMaximum := TRUE, Descr = "Afboeken naar het maximum van de nieuwe klasse gebeurt alleen bij een landgebruiksverandering naar een klasse met een lager maximum (TRUE, variant 1 uit #483). Op FALSE wordt afgeboekt zodra
											de voorraad boven het maximum van de eigen klasse uitkomt, ook zonder verandering, wat met een startvoorraad uit de kaart een grote eenmalige afboeking in het eerste zichtjaar geeft.";
	// ----- Spoor 3 uit RSopen #657: de veenoxidatie uit SOMERS schrijft af van de koolstofvoorraad -----
	parameter<Bool>                         Methaan_WaterkentalAlleenOpPermanentWater := TRUE, Descr = "Krijgt alleen permanent open water het methaankental van de waterklasse (TRUE), of ook elke cel waar waterberging is gealloceerd (FALSE)? Op aanwijzing van Deltares in #793: geen uitstoot
				simuleren waar vandaag niets boekt. Een gealloceerde bergingscel krijgt sinds #778 koolstofklasse 16 maar staat het grootste deel van het jaar droog; met de schakelaar aan slaat zij de
				klasseroute over en valt zij terug op de droogleggingsroute. De cellen die uit de veenlevering werkelijk open water worden (bouwsteen 9a en 9b) lopen langs hun beheertype en houden het
				kental.";
	parameter<Bool>                         Koolstof_SOMERSAlleenMetVeenpakket     := TRUE, Descr = "Laat SOMERS alleen uitstoot boeken waar de ondergrondkaart een veenpakket geeft (TRUE), of overal waar SOMERS een emissie rapporteert (FALSE)? Op aanwijzing van Deltares in #793 op de vraag
				uit #733: zonder deze afbakening loopt de uitstoot door tot 2120 op een voorraad die er niet is. De toets is MakeDefined(Peat_thickness, 0) > 0, dus een ontbrekende waarde en een dikte nul
				tellen beide als geen veenpakket; de voorraadkant heeft haar eigen afbakening in Veenreserve/DraagtReserve.";
	parameter<Bool>                         Koolstof_SOMERSAfschrijven             := TRUE, Descr = "Laat de veenoxidatie die SOMERS_CO2_laagveen rapporteert van de koolstofvoorraad afschrijven (TRUE, spoor 3 uit #657). Op FALSE staan twee boekhoudingen naast elkaar: SOMERS laat de koolstof als jaarlijkse stroom verdwijnen terwijl de voorraad onaangeroerd blijft en bij een landgebruiksverandering alsnog in zijn geheel wordt afgeboekt.";
	parameter<String>                       Koolstof_SOMERSEmissieVariant          := 'Mediaan', Descr = "Welke SOMERS-emissievariant de koolstofboekhouding voedt: Minimum, Mediaan of Maximum, zie Classifications/CO2/EmissieK. De indicator SOMERS_CO2_laagveen rapporteert alle drie; de voorraad kan er maar een verwerken.";

	parameter<Bool>                         Koolstof_VeenreserveGebruiken          := TRUE, Descr = "Vang de veenoxidatie eerst op in een aparte veenreserve onder de bovenste 30 cm en pas daarna in de voorraad uit de bodemkoolstofkaart (TRUE). De kaart geeft de bovenste 30 cm terwijl SOMERS
											de hele gedraineerde veenkolom laat oxideren; zonder reserve is de voorraad op de veenweidepercelen binnen de modelhorizon op en verschillen de varianten niet meer. De reserve komt uit
											SourceData/Landbouw/Peat_thickness (GeoTOP), begrensd met de twee schakelaars hieronder.";
	parameter<Bool>                         Koolstof_VeenreserveOpBodemkaart       := TRUE, Descr = "Beperk de veenreserve tot de veengronden en moerige gronden van BOFEK2020 plus de SOMERS-veenweidepercelen (TRUE), of vul hem overal waar GeoTOP veen ziet (FALSE)? Op aanwijzing van Deltares
																															in #657: GeoTOP telt ook begraven veen mee dat niet oxideert. Sinds #736 is het masker de unie van bodemkaart en percelen (Veenreserve/DraagtReserve in het sjabloon), omdat een deel van de
																															percelen buiten de veen- en moerige gronden ligt en daar wel een oxidatievraag heeft; zie #733.";
	parameter<Bool>                         Koolstof_VeenreserveBegrenzenOpGLG     := FALSE, Descr = "Begrens de veenreserve op de gemiddeld laagste grondwaterstand van het basisjaar (TRUE), of vul hem met de hele veenkolom onder de bovenste 30 cm (FALSE)? Op FALSE sinds #736. De emissiekant
																															houdt de drooglegging per variant constant, dus bij een oxiderend en klinkend maaiveld zakt het peil mee en migreert de aerobe schijf naar beneden; cumulatief over de reeks is een grens die
																															met het maaiveld meebeweegt gelijk aan geen grens. De twee pools betegelen dan de kolom: de bodemkoolstofkaart 0 tot 0,30 m, de reserve 0,30 m tot de veenbasis. Bovendien ligt de NHI-GLG op
																															een deel van de veenweideblokken hoger dan de drooglegging waarmee SOMERS rekent, wat binnen een balans niet te verdedigen is.";

	parameter<Float32>                      Koolstof_VeenOrganischeStofdichtheid   := 0.103f, Descr = "Dichtheid van de organische stof in veen, in ton per m3, voor het omrekenen van veendikte naar een koolstofreserve; niet de droge bulkdichtheid, want daar zit de minerale fractie in. Het gemiddelde voor de Nederlandse ondergrond zonder het diep begraven veen, met 0,080 en 0,150 als minimum- en maximumscenario.", Source = "Erkens et al. 2016, Hydrogeology Journal, aangewezen door Deltares in #657";
	parameter<Float32>                      Koolstof_VeenKoolstoffractie           := 0.5f, Descr = "Massafractie koolstof in de organische stof van veen, voor het omrekenen van veendikte naar een koolstofreserve. Samen met de organischestofdichtheid geeft 0,103 maal 0,5 maal 10.000 een reserve van 515 ton C per hectare per meter veen.", Source = "Erkens et al. 2016, Hydrogeology Journal, dezelfde aanname (52 kg C per m3)";

	parameter<Float32>                      Koolstof_MineraleOndergrens_tonC_ha    := 75f, Descr = "De koolstofvoorraad die in de bovenste 30 cm achterblijft als de veenbovengrond daar volledig is geoxideerd, in ton C per hectare; de veenoxidatie schrijft af tot deze grens en niet tot nul
											(Zichtjaar/Carbon/Stock/Afschrijfbaar_ha in het sjabloon, #736). Zonder ondergrens loopt de voorraad tot nul leeg, en zo'n bodem bestaat niet: aerobe oxidatie eindigt in een moerige
											eerdgrond of een humeuze zandgrond. 75 volgt uit 3.000 m3 per hectare maal een bulkdichtheid van 1,25 ton per m3 maal 4 procent organische stof maal koolstoffractie 0,5, en ligt tussen het
											vijfde en het tiende percentiel van agrarisch grasland op zand in de bodemkoolstofkaart. Op nul geeft het gedrag van voor #736.";

	parameter<Bool>                         Koolstof_AfboekenAlleenBijBodemingreep := TRUE, Descr = "Afboeken gebeurt alleen bij een verandering naar een landgebruiksklasse die de bodem afdekt of afgraaft, zoals wegen en bebouwing (TRUE, spoor 1 uit #657); de kolom MagAfboeken in
											Classifications/Grondgebruik/CarbonClass zegt welke klassen dat zijn. Op FALSE boekt elke verandering naar een klasse met een lager maximum af, ook een die alleen de begroeiing betreft.
											Nodig omdat de startvoorraad de bodem in de bovenste 30 cm is en het klassemaximum een totaal van bodem en biomassa; anders boekt elke overgang naar natuur koolstof af die in de bodem blijft
											zitten.";

	parameter<Bool>                         Koolstof_VastleggenAlleenNaVerandering := TRUE, Descr = "Vastleggen gebeurt alleen op cellen waar de koolstofklasse sinds het basisjaar is veranderd, en de aanwas telt vanaf de periode van die verandering (TRUE, #737): de rekenregel van Deltares
											in #483 laat de klok bij de verandering beginnen. Op FALSE krijgt elke cel elk zichtjaar Cseq_ha maal de periodelengte zolang de voorraad onder het klassemaximum ligt, ook bestaand bos dat
											een eeuw niets doet; dat gat tussen kaartvoorraad en klassemaximum is daar een verschil in afbakening en geen groeiruimte.";

	parameter<Float32>                      Koolstof_VastleggingsdeelInWisselperiode := 0.5f, Descr = "Welk deel van de periode meetelt als aanwastijd in het zichtjaar waarin de klasse wisselt (#737): 1 neemt aan dat de verandering aan het begin van de periode viel, 0 telt de wisselperiode niet mee, 0,5 is de middenaanname. Van belang omdat de eerste periode zeventien jaar beslaat. Alleen zinvol met Koolstof_VastleggenAlleenNaVerandering aan.";

	parameter<Bool>                         Koolstof_KlassenAanvullen              := TRUE, Descr = "Vul de zestien LGN-klassen die in de koolstoftabel van Deltares ontbreken aan met een koolstofklasse (TRUE, #737); de toewijzingen staan met reden in
											Classifications/Grondgebruik/CarbonClassAanvulling, elk overgenomen van de LGN-klasse waarvan zij een variant zijn. Zonder klasse doet een cel aan geen enkele kant mee: er wordt niet
											afgeboekt als erop gebouwd wordt, en de poort van Koolstof_VastleggenAlleenNaVerandering ziet de verandering niet. Een schakelaar omdat de toewijzingen van Object Vision zijn en niet van
											Deltares.";

	// ----- Vervolg op RSopen #657: de kentallen van team Veen en het veen buiten de SOMERS-percelen -----
	// Drie aannames die bij Deltares ter controle liggen. Ze stonden alle drie uit tot 3 september 2026; sindsdien staan
	// ze aan, op de reactie van team Veen in #657 en het besluit over stedelijk veen. Aan betekent hier niet bevestigd:
	// het vragenblok dat bij de oplevering meegaat staat in #632, en #758 houdt bij wat er nog uit moet komen.
	// De kengetallen zelf staan in Classifications/Grondgebruik/VeenBroeikasgas.
	parameter<Bool>                         Koolstof_VeenVastleggingUitBouwstenen  := TRUE, Descr = "Gebruik op veen- en moerige bodem de vastleggingskentallen van team Veen voor de veenvormende klassen, in plaats van de generieke Cseq_ha uit de koolstofklassentabel (#657). Team Veen geeft
												voor de veenvormende bouwstenen een veel hogere netto opname dan de tabel, en de voorraad uit de bodemkoolstofkaart ligt op veen ver boven het klassemaximum van riet, zodat de vastlegging
												daar anders nul blijft; de schakelaar zet daarom het kental en het maximum om, met als aanname dat veenvorming koolstof toevoegt in plaats van naar een plafond toegroeit. Sinds #758 alleen
												in de NbS-varianten, want BAU en BAU2 rekenen uitsluitend met SOMERS, en binnen dat regime vervangen de kentallen de hele SOMERS-stroom (CarbonStorageSequestration_T/VeenKentalGeldt).";
	parameter<Bool>                         Koolstof_OxidatieBuitenSOMERS          := TRUE, Descr = "Boek ook veenoxidatie op de veen- en moerige gronden buiten de SOMERS-veenweidepercelen, met de emissiefactoren van Deltares uit #657 (EF_low_nl_2025.csv). De factor is een getal per
												bodemtype zonder grondwaterstand, dus hij verzet het niveau van de landelijke balans en niet het verschil tussen de varianten, behalve waar het landgebruik naar water of bebouwing gaat. De
												factoren gelden voor laag Nederland; hoog Nederland staat achter de schakelaar hieronder.";
	parameter<Bool>                         Koolstof_OxidatieBuitenSOMERSOokHoogNL := TRUE, Descr = "Pas de emissiefactoren voor laag Nederland ook toe op hoog Nederland; op FALSE blijft hoog Nederland op nul. Op aanwijzing van Deltares in #657, die voor hoog Nederland zelf ook de laag-Nederlandse factoren aanhoudt. Alleen zinvol samen met Koolstof_OxidatieBuitenSOMERS.";
	parameter<Float32>                      Koolstof_EF_Veen_tonCO2_ha_jaar        := 13f, Descr = "Emissiefactor voor gedraineerd veen buiten de SOMERS-percelen, in ton CO2 per hectare per jaar. De 13 van bouwsteen 1 uit de veenlevering en niet de 10,59 uit EF_low_nl_2025.csv, op aanwijzing van Deltares in #793, voor consistentie met de bouwstenen.", Source = "bouwstenentabel team Veen, bouwsteen 1 (#793); de csv EF_low_nl_2025 uit #657 geeft 10,59";
	parameter<Float32>                      Koolstof_EF_Moerig_tonCO2_ha_jaar      := 11.96f, Descr = "Idem voor de moerige gronden, uit dezelfde tabel: 1,196 kg CO2 per m2 per jaar. Dat de moerige gronden hoger staan dan de veengronden is wat de aangeleverde tabel zegt; het is niet nagevraagd.";
	parameter<Bool>                         Koolstof_EFStedelijkOpNul              := FALSE, Descr = "Houd het bestaand stedelijk gebied op de veenbodem buiten de SOMERS-percelen op nul uitstoot (TRUE), of pas de emissiefactor ook daar toe (FALSE)? Op FALSE volgens #758: de
												emissiefactorentabel geeft panden, erven, openbare ruimte en stedelijk groen op veen dezelfde factor als de percelen. Nieuwbouw in de NbS-varianten stoot niet uit, want daar wordt volgens
												Deltares zo ingericht dat de oxidatie stopt; dat onderscheid zit in CarbonStorageSequestration_T/VeenKental. De aanname is nog niet door team Veen bevestigd (#632).";
	parameter<Bool>                         Koolstof_KentalUitBouwsteencomponent   := TRUE, Descr = "Krijgen natte teelt en vernat grasland het kental van hun eigen bouwsteencomponent (TRUE), of dat van de koolstofklasse waarin hun landgebruik valt (FALSE)? Alleen binnen het kentalregime,
												dus met Koolstof_VeenVastleggingUitBouwstenen in een NbS-variant. Trap 2 van #684 legt een bouwsteen ruimtelijk uit elkaar in componenten terwijl de kentallen per hele bouwsteen gelden; op
												TRUE krijgt het natte-teeltdeel het kental van de bouwstenen die geheel natte teelt zijn (3b en 4b), op FALSE dat van koolstofklasse 18, een mozaiek met 0,30 natte teelt, plus de
												veenvormende vastlegging. Welke van de twee de bedoeling is ligt als vraag bij Deltares in #778; de kentallen per component staan in Classifications/Grondgebruik/NbSVeen/NbSLandgebruik.";
	parameter<Bool>                         Methaan_Meetellen                      := TRUE, Descr = "Reken de methaanuitstoot uit natte veenbodems mee als aparte indicator (#657); een toevoeging, de CO2-indicatoren veranderen er niet van. Team Veen geeft naast het CO2-kental per bouwsteen
												ook een methaankental, en dat is het grootste: de varianten die het meeste veen vernatten scoren op CO2 het beste en hebben tegelijk de meeste natte hectares. De kentallen staan in
												Classifications/Grondgebruik/VeenBroeikasgas; sloten en de methaan van natte natuur buiten de veenbodem ontbreken.";

	// ===== VERDISCONTERING VAN DE KOSTEN- EN WAARDE-INDICATOREN (#651) =====
	// De landelijke MKBA-richtlijn schrijft sinds 1 januari 2026 een termijnstructuur voor: een eerste discontovoet
	// tot en met horizon 35 jaar en een tweede daarna. Beide zijn reeel, dus bij constante prijzen, wat aansluit op
	// het model: alle bedragen staan in prijzen van het basisjaar. Bron: Rapport Werkgroep discontovoet 2025,
	// versie 1.00 van 19 september 2025, kabinetsreactie en inwerkingtreding per 2026-01-01. De standaardvoeten zijn
	// opgebouwd uit een risicovrije component van 0,0 procent plus een risico-opslag van 2,8 respectievelijk 1,8 procent.
	//   https://www.rwseconomie.nl/discontovoet
	//   https://open.overheid.nl/documenten/43d845b2-d837-4e34-9a46-dffe460e043a/file
	// De richtlijn kent ook een lage variant (2,2 en 1,4 procent) voor onvermijdbare vaste kosten zonder alternatieve
	// aanwending en een hoge variant (4,2 en 2,7 procent) voor baten die sterk met de conjunctuur meebewegen. Welke
	// variant per indicator hoort is een inhoudelijke keuze die nog met Deltares en PBL te maken is; hier staat de
	// standaardvariant. Voor natuur bestaat aparte PBL-guidance die hier nog niet is verwerkt.
	parameter<Float32>   Discontovoet_TotHorizonGrens  := 0.028f, Descr = "Eerste discontovoet: geldt voor kosten en baten tot en met DiscontoHorizonGrens jaar na het basisjaar. Reeel, standaardvariant uit het Rapport Werkgroep discontovoet 2025.";
	parameter<Float32>   Discontovoet_NaHorizonGrens   := 0.018f, Descr = "Tweede discontovoet: geldt voor de jaren daarna. Reeel, standaardvariant uit het Rapport Werkgroep discontovoet 2025. Dat de voet na 35 jaar daalt is precies waarom dit voor NL2120 uitmaakt: bij een vlakke 2,8 procent zou een euro in 2120 nog 6,9 cent waard zijn, met de termijnstructuur 12,6 cent. Voor 2060 maakt het weinig uit, 36,0 tegen 36,7 cent.";
	parameter<jaar>      DiscontoHorizonGrens          := 35[jaar], Descr = "Horizon waarop de richtlijn van de eerste naar de tweede discontovoet overgaat, geteld vanaf het eerste jaar waarin kosten of baten optreden. Dat eerste jaar is hier Model_StartYear.";
	parameter<Bool>      VerdisconteerIndicatoren      := TRUE, Descr = "Staat de verdiscontering aan? Op FALSE is de factor 1 en blijft elke NCW-indicator gelijk aan zijn nominale tegenhanger; bedoeld om het effect zichtbaar te maken zonder twee runs te
																						vergelijken. De schakelaar zit via Verdiscontering_Horizon_T/Factor ook in Suitability_Wonen_perOP_T en dus in de allocatie; dat maakt vandaag niets uit omdat
																						JaarWaarinFunderingschadeZichtbaar in alle varianten gelijk is aan Model_StartYear (#680), maar wijkt dat jaar per variant af, dan verzet deze rapportageknop de allocatie.";

	parameter<String>    IndicatorRegio_ref            := =quote(replace_value(expand(., '%env:IndicatorRegio%'), 'env:IndicatorRegio', 'NL'))
	, Descr = "Op welke regio-indeling de indicatorentabellen aggregeren, voor alle indicatoren tegelijk (#658). Te zetten met de omgevingsvariabele IndicatorRegio, net als ExportZichtjaar; zonder die
											variabele NL. Opties: NL, Provincie, COROP, Gemeente, NVM en de vier landschapsgebieden Landschap_Kust, Landschap_Rivieren, Landschap_Veen en Landschap_Zand, de begrenzingen die de
											landschapsteams aanleveren (#760); die overlappen elkaar, dus elk is een eenheid van een regel met een masker, een run per gebied (batch/RunIndicatoren.ps1 -IndicatorRegio Landschappen). De
											partitie LandschapsRegio van #705 is geen exportoptie meer en blijft alleen voor het diagnoseharnas. De keuze raakt uitsluitend de tabellen: de grids staan op celniveau, de
											_Per_NL-parameters zijn altijd het landelijke totaal en claimrealisatie aggregeert op de allocatieregio van de sector.";

	parameter<String>    IndicatorRegio_path           := switch(
			  case(IndicatorRegio_ref == 'NL',        '/SourceData/RegioIndelingen/NL')
			, case(IndicatorRegio_ref == 'Provincie', '/SourceData/RegioIndelingen/Provincie/StudyArea')
			, case(IndicatorRegio_ref == 'COROP',     '/SourceData/RegioIndelingen/COROP/StudyArea')
			, case(IndicatorRegio_ref == 'Gemeente',  '/SourceData/RegioIndelingen/Gemeente')
			, case(IndicatorRegio_ref == 'NVM',       '/SourceData/RegioIndelingen/NVM')
			, case(IndicatorRegio_ref == 'Landschap_Kust', '/SourceData/Landschap/Landschapsgebieden/Kust/Gebied')
			, case(IndicatorRegio_ref == 'Landschap_Rivieren', '/SourceData/Landschap/Landschapsgebieden/Rivieren/Gebied')
			, case(IndicatorRegio_ref == 'Landschap_Veen', '/SourceData/Landschap/Landschapsgebieden/Veen/Gebied')
			, case(IndicatorRegio_ref == 'Landschap_Zand', '/SourceData/Landschap/Landschapsgebieden/Zand/Gebied')
			, ''
		)
	, IntegrityCheck = "this != ''"
	, Descr = "Het pad achter IndicatorRegio_ref; de indicatorensjablonen zetten hier hun unit Regio op met een =-expansie. Elke indeling die hier bij komt moet name en Per_AdminDomain_Fijn hebben:
											Per_AdminDomain loopt bij de meeste indelingen over AllocDomain (100 meter) terwijl de kaarten op 25 meter zijn gemaskeerd, zodat cellen stil uit de kolommen vielen (#748). Een geometry is
											sinds #705 niet meer nodig. Provincie en COROP wijzen naar hun StudyArea-selectie, zodat een kleiner studiegebied geen lege regels geeft; een onbekende naam laat de IntegrityCheck vallen.";

	// --- BAG-nieuwbouw (#703) ---
	parameter<uint32> MaxLeeftijdPijplijn := 5
	, Descr = "Hoeveel jaar oud een voorkomen met de status gevormd, bouw gestart of bouwvergunning verleend hoogstens mag zijn om als pijplijn mee te tellen, gerekend vanaf BAG_RecentYear (#703). Een
				vergunning die nooit tot bouw kwam draagt die status nog jaren en zou anders als toevoeging in de boeken komen zonder route eruit. De verdeling van de statusjaren knikt rond vier tot vijf
				jaar terug, waar de bouwtijd van een normaal project ophoudt. Op 0 geldt geen ondergrens.";

	parameter<int32>  PijplijnOndergrensDatum := MaxLeeftijdPijplijn == 0 ? 0i : int32((/ModelParameters/BAG_RecentYear - MaxLeeftijdPijplijn) * 10000 + 101)
	, Descr = "De ondergrens als BAG-datum, dus jjjjmmdd. Op 0 doet de toets niets, want elke begindatum ligt daarboven.";

	parameter<Bool> LogistiekePijplijnHeuristiek := FALSE
	, Descr = "Typeer panden in aanbouw of vergund als logistiek op pandkenmerken, zonder LISA-banen (#703): status bouw gestart of vergund, voetafdruk vanaf LogistiekePijplijn_MinFootprint, ligging op een
				IBIS-werklocatie en niet hoger dan LogistiekePijplijn_MaxHoogte_cm. Zonder deze heuristiek telt de hele logistieke pijplijn als Nijverheid, want de LISA-aanvulling herkent een pand pas als
				er banen zitten. Staat uit: op de gerealiseerde nieuwbouw haalt de heuristiek het logistieke oppervlak wel binnen maar met een precisie van minder dan de helft, dus aanzetten verplaatst
				evenveel oppervlak ten onrechte als het herstelt, en de vertekening herstelt zichzelf zodra LISA banen ziet.";
	parameter<m2PandFootprint> LogistiekePijplijn_MinFootprint := 2500[m2PandFootprint]
	, Descr = "Ondergrens op de pandvoetafdruk, gelijk aan MinFootprint_Leeg uit de LISA-aanvulling: dat is daar de drempel voor panden zonder eigen vestiging, en een pand in aanbouw heeft per definitie nog geen vestiging.";
	parameter<float32> LogistiekePijplijn_MaxHoogte_cm := 2500f
	, Descr = "Bovengrens op de AHN-pandhoogte in centimeters, dus 25 meter. Panden zonder hoogte tellen als laag genoeg, via een expliciete IsDefined-toets: de AHN-jaargang is het modeljaar, dus panden in aanbouw missen er vrijwel altijd in, en null vergelijkt in GeoDMS naar FALSE en niet naar null.";

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Waarden die tot september 2026 als kaal getal in de lopende code stonden. Ze zijn hierheen verplaatst zonder
	// de waarde te veranderen, dus deze verhuizing is per constructie uitkomstneutraal. De regel is dat een keuze
	// die iemand zou kunnen willen verzetten hier staat en niet in de expressie: een getal in een expressie is niet
	// te vinden zonder de code te lezen, en verschijnt dus ook niet in een variantvergelijking of een audittrail.
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////

	parameter<Float32>   ClaimRealisatie_NormOnder := 0.98f
	, Descr = "Onder welke realisatiegraad een regio als onderrealisatie telt in Templates/Indicatoren/ClaimRealisatie. Stond als kaal getal op zes plekken: eenmaal voor wonen en eenmaal per werksubsector, telkens in drie toetsen. De band is bewust symmetrisch rond 1; wie hem verruimt of versmalt hoort beide grenzen mee te nemen.";

	parameter<Float32>   ClaimRealisatie_NormBoven := 1.02f
	, Descr = "Boven welke realisatiegraad een regio als overrealisatie telt. Zie ClaimRealisatie_NormOnder. Let op dat het toetsharnas batch/ToetsOplevering.ps1 een eigen, ruimere band hanteert voor het landelijke totaal; die staat daar en niet hier, want dat is een oordeel over een levering en geen modelparameter.";

	parameter<meter>     Claimregio_Bufferstraal := 2500[meter]
	, Descr = "Straal waarmee de claimregio-polygonen worden gebufferd voordat ze op het grid gaan, in Templates/Claims/Claims_TargetUnits_T en Templates/Claims/ZichtjaarXScenarioxAllocRegios; vangt cellen op die net buiten een regiogrens vallen, vooral langs de kust en de grote wateren. Een parameter zodat de twee lezers gelijk blijven.";

	parameter<meter>     Bevolkingskern_Bufferstraal := 1000[meter]
	, Descr = "Straal van de buffer rond bevolkingskernen naar grootteklasse, in SourceData/RegioIndelingen/Maak_PopK_Buffers_T. Voedt de OV-klassen, de dichtheidsfactoren per kerngrootte en een trede-as. Stond als kaal getal in het buffersjabloon.";

	parameter<Float32>   Bevolkingskern_Grens_Groot := 100000f
	, Descr = "Inwonergrens waarboven een kern als grote kern telt. Stond als kaal getal in SourceData/RegioIndelingen. De drie klassen zijn samen uitputtend: onder de kleine grens, ertussen, en boven deze grens.";

	parameter<Float32>   Bevolkingskern_Grens_Klein := 20000f
	, Descr = "Inwonergrens tussen een kleine en een middelgrote kern; zie Bevolkingskern_Grens_Groot. Sinds #749 kan het inwonertal uit de CBS-vierkanten komen in plaats van uit de bevolkingskernen van 2011, die op vijftallen zijn afgerond, zodat een kern vlak bij een grens van klasse kan wisselen.";

	parameter<UInt32>    Landschap_Vereenvoudiging_Straal_m := 2500
	, Descr = "Over welke straal de landschapskaart wordt vereenvoudigd, in meters, in SourceData/Landschap: per cel het aandeel van elk landschap binnen deze straal, en de cel gaat naar het landschap met
						het hoogste aandeel boven Landschap_Vereenvoudiging_Drempel. Groter laat verspreide leveringspolygonen in elkaar overlopen en enclaves verdwijnen; op nul blijft de kaart op de leveringen
						zelf. Voorlopig 2.500 meter (#705). Moet een straal zijn waarvoor Geography/Distmatrices_100m een kern kent.";

	parameter<Float32>   Landschap_Vereenvoudiging_Drempel := 0.05f
	, Descr = "Welk aandeel een landschap binnen de vereenvoudigingsstraal minstens moet halen voordat de cel eraan wordt toegewezen. Daaronder blijft de cel zonder landschap. Zie Landschap_Vereenvoudiging_Straal_m.";

	parameter<meter>     MaxPlausibeleOverstromingsdiepte := 100[meter]
	, Descr = "Bovengrens waarboven een waterdiepte uit de dieptekaarten als onzin wordt beschouwd en op null gaat, in SourceData/Water. Honderd meter ligt ruim boven elke diepte die in Nederland kan optreden en vangt de vulwaarden van de leveringen af.";

}
