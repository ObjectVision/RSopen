//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de ModelParameters: Parameters die voor elk scenario en elke Variant hetzelfde zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Advanced
{
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Wonen              := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Wonen              := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Werken             := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Werken             := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Verblijfsrecreatie := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Verblijfsrecreatie := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Waterberging                       := 2[ha];

	parameter<uint8>     IterVanafWaarWeAfgewezenCellenUitsluitenInAlloc             := 1b, Descr = "Vanaf welke iteratie afgewezen cellen uit de beschikbaarheid gaan. Dit mechanisme is de motor van het proces en niet de rem: een cel die losliggend boven de zaaglijn uitkomt heeft geen gealloceerde buren en haalt de erosie-eis nooit, dus zolang hij beschikbaar blijft kiest de allocatie hem elke iteratie opnieuw en wijst hem elke iteratie opnieuw af. Op 5 kostte dat vier lege iteraties. Zie ObjectVision/RSopen#643.";
	parameter<float32>   MorfologischeCleaning_Aantal_BuurCellenAllocOmTeOverleven   := 6f, Descr = "Terugvalwaarde; de allocatie gebruikt de sectorspecifieke waarde hieronder. Deze eis is feitelijk een minimale beukmaat en geen vloeiende knop. De erosie telt over een 3x3-blok inclusief de cel zelf en eist er parameter+1 van de negen. Een strook van een cel geeft er drie, van twee cellen zes, en de kern van een strook van drie cellen negen. Op 6 overleeft dus alleen wat minstens 75 meter breed is, op 3 tot en met 5 alles vanaf 50 meter, en pas daaronder overleeft een lint van een enkele cel. Zie ObjectVision/RSopen#643.";
	parameter<float32>   MorfologischeCleaning_BuurCellen_Wonen                      := 6f, Descr = "Minimale beukmaat voor wonen: 6 is 75 meter, 5 is 50 meter. Op 5 gaat het binnenstedelijke aandeel van 20,4 naar 24,3 procent en komen er 6.496 woningen bij, maar overleeft ook een lint van 50 meter langs een weg. Dat is de afweging.";
	parameter<float32>   MorfologischeCleaning_BuurCellen_Werken                     := 6f;
	parameter<float32>   MorfologischeCleaning_BuurCellen_Verblijfsrecreatie         := 6f;
	parameter<float32>   MorfologischeCleaning_BuurCellen_Waterberging               := 6f;

	parameter<String>    AdminDomain_ref               := '25m', Descr = "Ruimtelijke resolutie waarop de allocatieresultaten worden geadminstreerd";
	parameter<String>    AllocDomain_ref               := '100m', Descr = "Ruimtelijke resolutie waarop de allocatie plaatsvindt (keuze-eenheid)";
	parameter<string>    AllocatieFileName             := '%LocalDataProjDir%/Allocatie/@CASUS@/Stand@JAAR@/@STANDPATH@_@SA@_SS-@SS@.tif'
	, Descr = "Sjabloon voor de bestandsnaam van de standtifs. De placeholders worden gevuld met Casus_name, het zichtjaar, StandVar/path, ModelParameters/StudyArea en het aantal Sector/xSubsector-combinaties.

						Op drie plekken wordt dit sjabloon ingevuld: Templates/Allocatie/Zichtjaar_T (lezen en schrijven), Templates/Indicatoren.dms (alleen lezen) en Templates/Indicatoren_T/Export.dms (dat vervolgens Allocatie door Indicatoren vervangt).

						LET OP bij @CASUS@: dat is NIET vanzelfsprekend de casus die hem opvraagt. De indicatorenkant vult hem sinds #730 met StandCasus_name en niet met Casus_name, en die kan naar een andere variant wijzen. BAU2 leest zo de standtifs van BAU en alloceert zelf niet meer; de kolom die dat stuurt is VariantParameters/VariantK/StandVanVariant. Er is daardoor geen map Allocatie/WLO_hoog_BAU2 meer, en dat is geen fout.

						De allocatiekant vult hem wel gewoon met Casus_name, want die schrijft en mag dus nooit in andermans map terechtkomen.";

	parameter<string>    ImperviousnessMapYear         := 'y2024';
	parameter<Bool>      BAG_LogistiekDynamisch        :=  TRUE, Descr = "Vult de statische logistieke pandenset (stand 2021) aan met een LISA-afgeleide typering van nieuwbouw vanaf 2021, via het ontkoppelde bestand LogistiekAanvulling_FileName. Genereren of hergenereren (na een BAG- of LISA-vintagewissel of een versie-ophoging): zet deze parameter tijdelijk op FALSE, draai WritePrivData/LogistiekAanvulling/Generate en zet hem weer op TRUE; met de parameter aan trekt het pand-domein het nog te schrijven bestand als supplier mee en faalt de generatie (zelfde procedure als bij BAG_WP5_rel_Ontkoppeld). Zonder aanvulling kan nieuwbouw nooit logistiek worden en telt die mee als Nijverheid: gemeten op BAG-2026 gaat dat om 355 ha footprint, oplopend met circa 100 tot 150 ha per jaar.";

	parameter<uint16>    FromWhichDoWeKeepTIGRISconstant := 2060w;
	parameter<YearRange> PlancapaciteitGeldigTotEnMet    := 2050[YearRange], Descr = "Tot en met welk zichtjaar plancapaciteit de zeef-restricties opheft. Plannen hebben een beperkte looptijd; in zichtjaren na dit jaar vervalt de vrijstelling van restricties door harde en zachte plannen.
																					Op 2050 betekent dat: de vrijstelling geldt in Y2040 en Y2050 en is weg vanaf Y2060. Dat valt samen met FromWhichDoWeKeepTIGRISconstant hierboven, waar de wonen- en werkenclaim bevriest. Vanaf datzelfde zichtjaar staat het model dus zowel zonder claimgroei als zonder planvrijstelling, en dat is de bedoeling: een vastgesteld plan uit de jaren twintig zegt niets meer over waar in 2060 of 2120 gebouwd mag worden.
																					Sinds #682 werkt de vervaldatum ook op de basisjaar-zeef, waar de inhoudelijke restricties staan: de restrictiekaarten, de milieuzonering, de Natura 2000-buffer, de bodemtoetsen, het landschapsregime, de zeehaven, het energielabel en evident benut. Die zeef is zichtjaaronafhankelijk en levert daarom twee uitkomsten; Zeef_T/BasisjaarZeefItem kiest er per zichtjaar een van. Tot #682 raakte deze parameter alleen de twee planvlaggen in Zeef_T/Src, en die voeden daar sinds #670 nog maar een enkele toets, de sloopleeftijd buiten harde plancapaciteit.
																					De trede-voorrang van plancapaciteit volgt deze vervaldatum sinds #739, achter de schakelaar TredeVolgtPlancapaciteitVervaldatum hieronder.";

	parameter<Bool>      TredeVolgtPlancapaciteitVervaldatum := TRUE, Descr = "Vervalt de trede-voorrang van plancapaciteit op dezelfde datum als de restrictievrijstelling (#739)? Staat sinds september 2026 op TRUE: een cel binnen een hard of zacht plan zakt vanaf het zichtjaar na PlancapaciteitGeldigTotEnMet naar de stimuli-trede of de restcategorie. Op FALSE houdt hij zijn plek bovenaan de ladder tot en met het eindjaar. Zowel harde als zachte plannen vervallen, en op dezelfde datum: 2060 ligt zo ver weg dat het onderscheid in looptijd tussen de twee er niet meer toe doet.
																					Waarom dit een aparte schakelaar is en niet meelift op de zeef: de trede weegt zwaarder dan de zeef. De as staat vooraan in de combine en is daarmee het zwaarste cijfer, en Templates/Allocatie/IterSubsector_T ordent strikt lexicografisch, dus een cel in een hogere trede gaat altijd voor op elke cel in een lagere trede, ongeacht de geschiktheid. Bij wonen bezetten harde plannen de bovenste 36 van 144 treden, en bij nijverheid en logistiek is plancapaciteit de enige inhoudelijke as van de acht.
																					Van de vijf trede-assen bewegen er sinds #749 drie mee: deze, de UrbanContour-as via UrbanContourVolgtNieuwbouw en de eigendom-as via EigendomVolgtVervaldatum. De OV-bereikbaarheid en het bouwterrein staan nog op het basisjaar; voor de eerste is er geen bron die zegt hoe hij zich ontwikkelt, en de tweede hoeft niet omdat een cel die het model eenmaal bebouwt de rest van de reeks niet meer in de allocatie komt. Zie #739 en #749.";

	parameter<Bool>      RondBevolkingskernVolgtUrbanContour := TRUE, Descr = "Waarop staan de buffers rond kernen naar inwonertal (#749)? Staat sinds september 2026 op TRUE: op de begrenzing bebouwd gebied met het inwonertal uit de CBS-vierkanten, dus 2022 en 2023 in plaats van tweemaal 2011. Op FALSE op de CBS-bevolkingskernen van 2011 met hun eigen BEV11TOT.
																					Deze buffers voeden de OV-klassen, de dichtheidsfactoren per kerngrootte en een trede-as, dus dit verzet meer dan de trede alleen.
																					LET OP: de buffers zijn ontkoppeld en staan als tif in %LocalDataProjDir%/BaseData/PopBuffers. De twee bronnen schrijven naar verschillende bestanden, de nieuwe met prefix UrbanContour_, dus ze overschrijven elkaar niet. De UrbanContour-set is op 3 september 2026 gegenereerd op 25 meter (#759); na een wissel van peiljaar of van de CBS-vierkanten moet dat opnieuw, met SourceData/RegioIndelingen/BegrenzingBebouwdGebied/Maak_PopK_Buffers/Generate. Zonder die stap valt de leeskant om op een ontbrekend bestand.";

	parameter<YearRange> EigendomGeldigTotEnMet := 2050[YearRange], Descr = "Tot en met welk zichtjaar het grondeigendom uit het basisjaar de trede-voorrang bepaalt (#749). Werkt alleen met EigendomVolgtVervaldatum hieronder aan, en staat bewust los van PlancapaciteitGeldigTotEnMet: een vastgesteld plan en een eigendomsverhouding verouderen niet op hetzelfde tempo, dus de twee horen apart instelbaar te zijn.";
	parameter<Bool>      EigendomVolgtVervaldatum := TRUE, Descr = "Vervalt de eigendom-as van de trede na EigendomGeldigTotEnMet (#749)? Staat sinds september 2026 op TRUE: vanaf het zichtjaar na EigendomGeldigTotEnMet valt elke cel in de klasse Totaal van die as en onderscheidt de as niets meer. Op FALSE bepaalt het grondeigendom van het basisjaar de voorrang tot en met het eindjaar.
																					Grondeigendom in 2026 zegt weinig over 2060, en anders dan bij de OV-bereikbaarheid is er hier iets te doen: de as heeft een catch-all, dus platleggen kan zonder de ladder te verbouwen. Wat blijft staan is dat er geen bron is die zegt hoe het eigendom zich ontwikkelt; dit zet de as uit en vervangt hem niet.";

	parameter<Bool>      UrbanContourVolgtNieuwbouw := TRUE, Descr = "Groeit het bestaand bebouwd gebied mee met wat het model bouwt (#749)? Staat sinds september 2026 op TRUE: de as wordt per zichtjaar opnieuw opgebouwd in Templates/Allocatie/Zichtjaar_T/TredeDynamischeUrbanContour, als de UrbanContour van het basisjaar verenigd met een schijf van 100 meter rond de cellen die het model in eerdere zichtjaren voor wonen of werken heeft gealloceerd.
																					De prijs staat er tegenover: de toewijzing van cellen aan trede-klassen en de ArgMin daarover gaan van een keer per variant naar een keer per zichtjaar. De ladder zelf blijft gedeeld, want die is statisch.
																					Waarom 100 meter: dat is precies een AllocDomain-cel, dus direct aangrenzend op de resolutie waarop gealloceerd wordt. Ruimer werkt niet, want een schijf van 500 meter om het bestaande bebouwde gebied voegt al 862.700 hectare toe, bijna tweemaal dat gebied zelf.
																					Wat NIET meegroeit is de eigendom-as, die UrbanContour via BaseData leest en niet via de trede-bron. Zie #749.";

	parameter<Bool>      MilieuzoneringVrijgesteldDoorZachtPlan := FALSE, Descr = "Zet een zacht plan de milieuzonering opzij (#742)? Op FALSE, de stand van vandaag, alleen een hard plan; op TRUE elk plan.
																					De VNG-richtafstanden gaan over geluid, geur, stof en gevaar. Een hard plan is een onherroepelijk bestemmingsplan of een verleende vergunning en heeft die toets doorlopen; een zacht plan is een voornemen en niet. Dat is de reden om FALSE als default te houden.
																					Tot #742 stond de toets in beide plangroepen van Zeef_Basisjaar_T tegelijk. Dat gaf geen dubbeltelling maar maakte de zachte vrijstelling wel onbereikbaar, want de zeef noemt een cel restrictief zodra een van de groepen dat doet. De uitkomst was dus altijd die van FALSE. Op TRUE komt er voor wonen ongeveer 2.480 hectare beschikbaar.";

	// GRONDGEBRUIK 
	parameter<meter2>                       MinimumPandFootprint             := 20[meter2], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor werken worden gehanteerd. Hiervoor wordt de pandfootprint gebruikt.";
	parameter<Woning>                       MinimumWoningAmount              := 5[Woning], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor wonen worden gehanteerd. Hiervoor wordt het aantal woningen gebruikt.";
	parameter<Verblijfsobject>              MinimumVerblijfsobjectAmount     := 1[Verblijfsobject], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor verblijfsrecreatie worden gehanteerd. Hiervoor wordt het aantal verblijfsobjecten gebruikt.";
	parameter<UInt32>                       MinimumGroupSize                 := 3, Descr = "Om de landgebruikskaart aan te laten sluiten bij de BBG, wordt een vergelijkbare methodiek gehanteerd waarbij 25m cellen worden gegroepeerd. Pas als deze drempel wordt bereikt wordt een cel overwogen om in de landgebruikskaart te komen.";
	parameter<Bool>                         ToetsWonenOpWaterInKaart         := FALSE, Descr = "Laat de landgebruikskaart afbreken zodra de switch in Templates/Indicatoren/Landgebruikskaart wonen zou hebben opgeleverd op een cel die de kaart water noemt, zie Toets_WonenOpWater/Woningen_WaterWintVanWonen daar. Standaard uit, want die toestand bestaat vandaag al: de zeef geeft in IJburg 2 met opzet water vrij voor wonen, terwijl de waterklassen verder als evident benut staan. Meet het getal eerst en zet deze schakelaar pas aan als het nul is. Zie #665.";

	parameter<Bool>                         SchadeToetstBouwwijzeVanPakket   := TRUE, Descr = "Waarop bepaalt de overstromingsschade wat een maatregel aan een nieuwbouwwoning doet? Op TRUE, de huidige stand, op de bouwwijze van het ontwikkelpakket dat er werkelijk gealloceerd is: de schadefactor wordt afgelezen bij de waterdiepte ter plaatse min BouwwijzeK/SchadevrijeDiepte, met een ondergrens van nul. Blijft het water onder de ontwerpdiepte, dan is de schade nul; komt het erboven, dan telt de restdiepte. Op FALSE het gedrag tot #681: een drempel op de eis van de plek, waar de woning niet meetelt zodra de overstromingsgevaarzone bouwen met maatregelen voorschrijft, ongeacht wat er staat en ongeacht hoe diep het water komt.
																									De keuze is beslecht in #681, met Deltares. Twee gronden. Ten eerste gaat de aanname over het gebouw en niet over de plek: de eis is een voldoende maar geen noodzakelijke voorwaarde, want gevaarzone 0 en 1 stellen geen eis terwijl de NbS-pakketten daar wel met maatregelen landen. Ten tweede is een drempel de verkeerde vorm: SSM2017 doet een hoger gelegen vloerpeil zelf als verschuiving langs de diepte-as, functie 395 is functie 9 exact 2,50 meter opgeschoven. De verschuiving is onder de ontwerpdiepte identiek aan de drempel en haalt er de klip boven de ontwerpdiepte uit.
																									De schakelaar staat op twee plaatsen tegelijk: Grondgebruik/Zichtjaar/IsOverstromingsbestendig (de drempel, op TRUE uit) en Parameters/<watersysteem>/Diepte_Nieuwbouw (de verschuiving, op FALSE uit). Zie #665 en #681.";

	parameter<UInt8>                        MinimumCountNieuwNatuur          := 10b, Descr = "In de aggregatie van NVK kaarten het aantal 25m cellen in een 100m die nieuwe natuur zijn om dit in het zichtjaar op te nemen.";

	// KOOLSTOF (indicator koolstofopslag en -vastlegging, zie RSopen #483)
	parameter<string>                       Koolstof_MaxSrc                        := 'Cmax_ha_invest'; // Cmax_ha_WUR
	
	parameter<Bool>                         Koolstof_BasisvoorraadUitKaart         := TRUE, Descr = "Startvoorraad koolstof in het basisjaar uit de bodemkoolstofkaart van de Atlas Natuurlijk Kapitaal (TRUE, SourceData/Bodem/BodemKoolstofvoorraad) of op nul beginnen zoals voorheen (FALSE). Op nul beginnen geeft een bovengrens van de vastlegging, omdat er in werkelijkheid al koolstof in de bodem zit.";
	parameter<Bool>                         Koolstof_BasisvoorraadBegrenzen        := FALSE, Descr = "Begrens de startvoorraad uit de kaart op het maximum van de landgebruiksklasse in het basisjaar (variant 3 uit RSopen #483). De kaart ligt op ongeveer tweederde van het areaal boven dat maximum, omdat de kaart de bodemvoorraad in de bovenste 30 cm geeft en het maximum uit de kengetallentabel komt. Alleen zinvol in combinatie met Koolstof_BasisvoorraadUitKaart.";
	parameter<Bool>                         Koolstof_AfboekenAlleenBijLagerMaximum := TRUE, Descr = "Afboeken naar het maximum van de nieuwe klasse gebeurt alleen waar dat maximum ook daadwerkelijk lager is dan dat van de vorige periode, dus bij een landgebruiksverandering naar een klasse met een lager maximum (TRUE, variant 1 uit RSopen #483). Bij FALSE wordt afgeboekt zodra de voorraad boven het maximum van de eigen klasse uitkomt, ook zonder landgebruiksverandering; in combinatie met een startvoorraad uit de kaart levert dat in het eerste zichtjaar een eenmalige afboeking van ruim 500 Mton CO2 op.";
	// ----- Spoor 3 uit RSopen #657: de veenoxidatie uit SOMERS schrijft af van de koolstofvoorraad -----
	parameter<Bool>                         Koolstof_SOMERSAfschrijven             := TRUE, Descr = "Laat de veenoxidatie die SOMERS_CO2_laagveen rapporteert daadwerkelijk van de koolstofvoorraad afschrijven (TRUE, spoor 3 uit RSopen #657). Zonder dit staan er twee boekhoudingen naast elkaar die dezelfde koolstof beschrijven: SOMERS laat hem als jaarlijkse stroom verdwijnen terwijl de voorraad onaangeroerd blijft, en bij een landgebruiksverandering wordt diezelfde koolstof alsnog in zijn geheel afgeboekt. Op Y2030 telde daardoor 3,3 van de 11,5 Mton CO2 in NbSGenuanceerd dubbel. Bij FALSE valt de berekening terug op de oude, met een afschrijving van nul.";
	parameter<String>                       Koolstof_SOMERSEmissieVariant          := 'Mediaan', Descr = "Welke SOMERS-emissievariant de koolstofboekhouding voedt: Minimum, Mediaan of Maximum, zie Classifications/CO2/EmissieK. De indicator SOMERS_CO2_laagveen rapporteert alle drie; de voorraad kan er maar een verwerken.";

	parameter<Bool>                         Koolstof_VeenreserveGebruiken          := TRUE, Descr = "Vang de veenoxidatie eerst op in een aparte veenreserve onder de bovenste 30 cm, en pas daarna in de voorraad uit de bodemkoolstofkaart (TRUE). Dit is nodig omdat de twee kanten van de balans anders verschillende reservoirs zijn: de kaart geeft de bovenste 30 cm, terwijl SOMERS de hele gedraineerde veenkolom laat oxideren. Zonder reserve is de voorraad op de veenweidepercelen bij het BAU-tempo binnen de modelhorizon op, waarna de varianten niet meer van elkaar verschillen. De reserve komt uit SourceData/Landbouw/Peat_thickness, de veendikte uit GeoTOP, en wordt begrensd door de bodemkaart en de grondwaterstand; zie de twee schakelaars hieronder.";
	parameter<Bool>                         Koolstof_VeenreserveOpBodemkaart       := TRUE, Descr = "Beperk de veenreserve tot de veengronden en moerige gronden van BOFEK2020 (TRUE), of vul hem overal waar GeoTOP veen ziet (FALSE)? Op aanwijzing van Deltares in #657: GeoTOP telt ook begraven en diep begraven veen mee dat niet oxideert, en dat verklaart de factor bijna drie tussen de twee kaarten. BOFEK is bovendien de kaart waarop SOMERS zelf rekent, dus met deze afbakening beschrijven de twee kanten van de balans hetzelfde gebied. Gemeten effect: 438.667 ha veenbodem tegen 1,21 mln ha met veendikte in GeoTOP.
																															De zin dat BOFEK de kaart is waarop SOMERS zelf rekent klopt niet overal, en dat is in #733 gemeten: 39.084 van de 245.968 hectare SOMERS-veenweideperceel ligt buiten de veen- en moerige gronden van BOFEK2020. Daar kreeg de cel wel een oxidatievraag en door deze schakelaar geen enkele reserve, ook niet waar GeoTOP wel een veendikte geeft, en dat was goed voor 35,7 van de 96,1 Mton CO2 die in BAU tot 2120 ongedekt bleef.
																															Sinds #736 is het masker daarom niet meer de bodemkaart alleen maar de unie van de bodemkaart en de SOMERS-veenweidepercelen; zie Veenreserve/DraagtReserve in het sjabloon. Het argument om de bodemkaart te nemen, dat GeoTOP ook begraven veen meetelt dat niet oxideert, gaat niet op waar SOMERS zelf zegt dat de cel oxideert: daar is een oxideerbare veenkolom een gegeven van de vraagkant en hoort er een pool tegenover te staan. Deze schakelaar gaat dus alleen nog over de vraag of de reserve ook buiten die twee afbakeningen gevuld mag worden, overal waar GeoTOP veen ziet.
																															Wat de unie oplevert is minder dan de 35,7 Mton, want op maar 17.540 van die 39.084 hectare geeft GeoTOP een veendikte. Gemeten haalt de unie de ongedekte post in BAU van 96,1 naar 86,9 Mton CO2.";
	parameter<Bool>                         Koolstof_VeenreserveBegrenzenOpGLG     := FALSE, Descr = "Begrens de veenreserve op de gemiddeld laagste grondwaterstand van het basisjaar (TRUE), of vul hem met de hele veenkolom onder de bovenste 30 cm (FALSE)? Staat sinds #736 op FALSE. Hij stond op TRUE op aanwijzing van Deltares in #657: oxidatie treedt alleen op boven de grondwaterstand, dus wat daaronder ligt komt niet vrij zolang het peil niet daalt.
																															Die voorwaarde is precies wat BAU niet doet. De emissiekant houdt de drooglegging per variant over alle zichtjaren constant, en een constante drooglegging bij een oxiderend en klinkend maaiveld betekent per definitie dat het peil meezakt. De aerobe zone is dan geen vaste schijf in de kolom maar een schijf van vaste dikte die met het maaiveld naar beneden migreert. De basisjaar-GLG is een toestand van dat systeem en geen randvoorwaarde eraan.
																															Reken de migratie uit en de schakelaar wordt overbodig. Noem de schijfdikte g, de veendikte D en de cumulatieve maaivelddaling S. De onderkant van de aerobe zone staat dan op g plus S, en de nog beschikbare reserve is min(D, g+S) min 0,30 min S. Over de hele reeks is dat D min 0,30: de hele kolom onder de toplaag. Een grens die met het maaiveld meebeweegt is cumulatief identiek aan geen grens, dus FALSE is niet de ruime variant maar de correcte implementatie van de migrerende schijf.
																															Twee dingen vallen daarmee op hun plaats. De twee pools betegelen de kolom precies: de bodemkoolstofkaart dekt 0 tot 0,30 m en de reserve 0,30 m tot de veenbasis, zonder gat en zonder overlap. En de veenbasis is een echte, zelfterminerende grens die al in de data ligt, anders dan een grondwaterstand uit een ander model.
																															Gemeten op de productierun van 01-09-2026, op de 166.582 hectare veenweideperceel waar GeoTOP een veendikte geeft: BAU vraagt 170,5 Mton CO2, oftewel 0,542 m veen over 97 jaar en 5,6 mm maaivelddaling per jaar, terwijl de met de GLG gereserveerde schijf 0,453 m dik is. De vraag overtreft de schijf dus met ongeveer twintig procent, en de 5,6 mm per jaar ligt naast de 6 mm die team Veen voor de niet-vernatte bouwsteen geeft. In NbSGenuanceerd bindt de grens nauwelijks: daar is de vraag 0,241 m tegen dezelfde schijf.
																															Er is nog een tweede reden, los van de horizon. De voorraadkant leest een GLG uit de NHI-referentiesom 2017, de emissiekant de mediane drooglegging per peilvak. Op 25,6 procent van de veenweideblokken ligt die GLG hoger dan de drooglegging waarmee SOMERS op diezelfde cel rekent, dus daar begrenst de voorraadkant de reserve boven de diepte waarvan de emissiekant uitgaat dat hij ontwaterd is. Binnen een balans is dat niet te verdedigen. Beide kaarten zijn bovendien 250 meter, ingelezen op het 25-meterdomein, dus het verschil tussen slootkant en perceelsmidden zien ze niet.
																															Verwacht er #733 niet mee op te lossen. Het loslaten verschuift in BAU 3,0 van de 86,9 Mton CO2 ongedekte oxidatie; de rest ligt op cellen waar de veendikte ontbreekt en daar helpt geen grens. Wat wel verandert is het gerapporteerde voorraadniveau: de reserve gaat landelijk van 218 naar 863 Mton CO2. Dat is geen inflatie maar een correctie, want die koolstof ligt er werkelijk; het niveau van de reserve valt in CO2FlowTovBasisjaar tussen basisjaar en zichtjaar weg, dus de indicator verandert alleen daar waar de oude reserve te krap was.";

	parameter<Float32>                      Koolstof_VeenOrganischeStofdichtheid   := 0.103f, Descr = "Dichtheid van de organische stof in veen, in ton per m3, voor het omrekenen van veendikte naar een koolstofreserve. Dit is uitdrukkelijk niet de droge bulkdichtheid van het veen: die is hoger, want daar zit de minerale fractie in. 0,103 is de gemiddelde organischestofdichtheid van veen in de Nederlandse ondergrond volgens de publicatie die Deltares in #657 heeft aangewezen (Erkens et al. 2016, Hydrogeology Journal). Dat gemiddelde is bepaald zonder het diep begraven veen onder meer dan 150 cm klastisch dek, dat volgens diezelfde publicatie niet oxideert, en past dus bij de reserve die hier bedoeld is. De publicatie geeft daarnaast een minimum- en een maximumscenario van 0,080 en 0,150.";
	parameter<Float32>                      Koolstof_VeenKoolstoffractie           := 0.5f, Descr = "Massafractie koolstof in de organische stof van veen, voor het omrekenen van veendikte naar een koolstofreserve. Bevestigd door de publicatie uit #657: die neemt hetzelfde aan en komt daarmee op een koolstofdichtheid van 52 kg per m3. Samen met de organischestofdichtheid geeft 0,103 maal 0,5 maal 10.000 een reserve van 515 ton C per hectare per meter veen. Tot 27-08-2026 stond hier 0,13 maal 0,5, oftewel 650.";

	parameter<Float32>                      Koolstof_MineraleOndergrens_tonC_ha    := 75f, Descr = "De koolstofvoorraad die in de bovenste 30 cm achterblijft als de veenbovengrond daar volledig is geoxideerd, in ton C per hectare. De veenoxidatie schrijft af tot aan deze grens en niet tot nul; zie Zichtjaar/Carbon/Stock/Afschrijfbaar_ha in het sjabloon. Op nul zetten geeft het gedrag van voor #736 terug.
											Waarom dit nodig is (#736). Zonder ondergrens liep de voorraad tot precies nul leeg: in BAU stond op de productierun van 01-09-2026 115.884 van de 245.968 hectare veenweideperceel in 2120 op nul ton koolstof over beide pools, met grasland erop. Zo'n bodem bestaat niet. Aerobe oxidatie van een veenbovengrond eindigt in een moerige eerdgrond of een humeuze zandgrond, en het grasland brengt jaarlijks wortels en strooisel in.
											Waar 75 vandaan komt. Twee wegen die onafhankelijk van elkaar op hetzelfde uitkomen. De rekenweg: de bovenste 30 cm is 3.000 m3 per hectare, een gerijpte humeuze zandige bovengrond onder blijvend grasland heeft een droge bulkdichtheid rond 1,25 ton per m3 en 4 procent organische stof, en met dezelfde koolstoffractie van 0,5 als hierboven geeft dat 3.000 maal 1,25 maal 0,04 maal 0,5 is 75 ton C per hectare. De band die bij de spreiding in bulkdichtheid en organischestofgehalte hoort is 70 tot 90.
											De tweede weg is de bodemkoolstofkaart zelf, dezelfde bron, diepte en eenheid als de startvoorraad. Op agrarisch grasland op de zandgronden van BOFEK2020 ligt het vijfde percentiel op 71,3 en het tiende op 76,5 ton C per hectare; op de kleigronden ligt beide op 80,6. De twee laagste kaartwaarden die werkelijk agrarisch grasland op zand beschrijven zijn 71,3 en 76,5, en 75 ligt daar precies tussen. Wat de kaart daaronder geeft is duin- en stuifzand onder bollen, bos en bebouwing, en dat is niet waar een voormalige veenweide onder gras in eindigt.
											Waarom niet hoger. Een ondergrens moet een ondergrens zijn en geen gemiddelde. Bij 75 ligt 3,5 procent van het Nederlandse agrarisch grasland in de kaart onder de grens; bij 90 is dat 29 procent en op de zandgronden zelfs 46,5 procent, en dan is het geen vloer meer maar een bijtelling. Op de veenweidepercelen zelf begint 1.080 van de 245.968 hectare onder de 75; bij 90 is dat 7.957 en bij 110 13.227.
											Wat de grens met de uitkomst doet. De afschrijving wordt kleiner, dus de indicator CO2FlowTovBasisjaar wordt gunstiger, en precies datzelfde bedrag verschuift naar Stock/Ongedekt_Cumulatief_ha. De eerlijke optelsom CO2FlowTovBasisjaar_InclOngedekt verandert er dus op de tweede orde na niets van; wat verandert is dat de gerapporteerde eindkaart een bodem beschrijft die kan bestaan.";

	parameter<Bool>                         Koolstof_AfboekenAlleenBijBodemingreep := TRUE, Descr = "Afboeken gebeurt alleen bij een verandering naar een landgebruiksklasse die de bodem daadwerkelijk afdekt of afgraaft, zoals wegen en bebouwing (TRUE, spoor 1 uit RSopen #657). De kolom MagAfboeken in Classifications/Grondgebruik/CarbonClass bepaalt welke klassen dat zijn. Bij FALSE boekt elke verandering naar een klasse met een lager maximum af, ook een verandering die alleen de begroeiing betreft.
											Waarom dit nodig is: de startvoorraad komt uit de bodemkoolstofkaart van de bovenste 30 cm, terwijl het klassemaximum een totaal van bodem en biomassa uit de kengetallentabel is. Die twee zijn niet vergelijkbaar en de kaart ligt op ongeveer tweederde van het areaal boven het maximum. Zonder deze schakelaar boekt daardoor elke overgang naar natuur koolstof af die gewoon in de bodem blijft zitten, en telt een deel daarvan bovendien dubbel met de veenoxidatie uit SOMERS_CO2_laagveen.";

	parameter<Bool>                         Koolstof_VastleggenAlleenNaVerandering := TRUE, Descr = "Vastleggen gebeurt alleen op cellen waar de koolstofklasse sinds het basisjaar is veranderd, en de aanwas telt vanaf de periode waarin die verandering viel (TRUE, RSopen #737). Bij FALSE krijgt elke cel elk zichtjaar Cseq_ha maal de periodelengte opgeteld zolang de voorraad onder het klassemaximum ligt, ook als er een eeuw lang niets gebeurt; dat is het gedrag van voor #737.
											Waarom dit nodig is. Dit is de andere helft van de rekenregel die Deltares in #483 heeft opgeschreven. Die regel vermenigvuldigt de opbouw met (zichtjaar min het jaar van de landgebruiksverandering), dus de klok begint bij de verandering. De afboekkant van diezelfde regel zit al in Koolstof_AfboekenAlleenBijLagerMaximum; de opbouwkant is nooit ingebouwd en telde gewoon de verstreken periode.
											Het is bovendien de spiegel van de mismatch waar Koolstof_AfboekenAlleenBijBodemingreep hieronder voor staat. De startvoorraad is de bodem in de bovenste 30 cm en het klassemaximum is een totaal van bodem en biomassa. Op een cel die van klasse verandert is het gat tussen die twee de biomassa die nog moet groeien, en dan is aangroeien juist goed. Op een cel die niet verandert is datzelfde gat een verschil in afbakening, want de biomassa staat er al; daar was de aanwas een boekhoudkundig verschijnsel.
											Wat het met de uitkomst doet, gemeten op de productierun van 01-09-2026 tot 2120. Van de 214,68 Mton CO2 bruto toename in BAU valt 171,94 Mton, 80 procent, op 588.206 hectare waarvan de landgebruiksklasse in 2120 gelijk is aan die in het basisjaar. Vijf bosklassen leveren daarvan 154,65 Mton in BAU tegen 154,48 in NbSGenuanceerd: bestaand bos dat in geen enkele variant verandert en dat 97 jaar lang op beginsnelheid doorgroeide. Dat verklaart waarom de opbouwkant tot vijf cijfers gelijk was tussen BAU en BAU2 en waarom het kopgetal van plus 7,2 Mton een restje van 3 procent tussen twee grote getallen was.";

	parameter<Float32>                      Koolstof_VastleggingsdeelInWisselperiode := 0.5f, Descr = "Welk deel van de periode meetelt als aanwastijd in het zichtjaar waarin de klasse wisselt (#737). Op 1 telt de hele periode mee, wat neerkomt op de aanname dat de verandering aan het begin van de periode plaatsvond; op 0 telt de wisselperiode niet mee. 0,5 is de middenaanname: de verandering valt gemiddeld halverwege.
											Waarom dit nodig is. De eerste allocatieperiode is zeventien jaar, want Model_StartYear is 2023 en Model_FirstZichtjaar is 2040. Zonder deze fractie krijgt een hectare die in de Y2040-kaart bos is geworden zeventien jaar aanwas toegekend alsof zij in 2023 al was aangeplant. Gemeten op de productierun: loofbos stond op Y2040 op 112 ton CO2 per hectare, precies 1,8 maal 17 maal 44/12. De aanwas van een jonge opstand is in de vestigingsfase juist laag, dus de volle periode is aan de ruime kant.
											Alleen zinvol samen met Koolstof_VastleggenAlleenNaVerandering: staat die op FALSE, dan wisselt vrijwel geen enkele cel van klasse en raakt deze fractie niets.";

	parameter<Bool>                         Koolstof_KlassenAanvullen              := TRUE, Descr = "Vul de zestien LGN-klassen die in de koolstoftabel van Deltares ontbreken aan met een koolstofklasse (TRUE, restpunt van RSopen #737). De toewijzingen staan in Classifications/Grondgebruik/CarbonClassAanvulling, met per regel de reden. Op FALSE houden die klassen geen koolstofklasse, zoals voor #737.
											Waarom dit nodig is. Het gaat om 217.132 hectare, waarvan 96.904 natuurlijk beheerd agrarisch grasland, 30.631 overige moerasvegetatie, 22.510 fruitkwekerij en 19.705 gras in het kustgebied. Zonder koolstofklasse doet zo'n cel aan geen enkele kant mee. Het zichtbaarste gevolg is dat er niet wordt afgeboekt wanneer erop gebouwd wordt: de afboeking toetst op MaximumDaalt en dat vergelijkt met het klassemaximum van het basisjaar, dus met null, en die toets is dan altijd FALSE. Gemeten op de productierun van 01-09-2026 gaat dat om 0,90 Mton CO2 in BAU en 1,22 in NbSGenuanceerd, op 2.846 respectievelijk 3.711 hectare.
											Sinds Koolstof_VastleggenAlleenNaVerandering hierboven weegt het tweede gevolg zwaarder. Die poort vergelijkt de klasse van het zichtjaar met die van het basisjaar; is die laatste null, dan is de vergelijking null en ziet de poort de verandering niet. Zonder deze aanvulling zou de vastlegging op juist deze hectares dichtstaan, ook waar er nieuwe natuur of nieuw bos van is gemaakt.
											Waarom hij een schakelaar heeft en niet gewoon aanstaat. De toewijzingen zijn van Object Vision en niet van Deltares, en ze verzetten getallen ten opzichte van de levering van 01-09-2026. Elke regel neemt de klasse over van de LGN-klasse waar hij een variant van is, dus er wordt geen kental verzonnen, maar de keuze mag terug als Deltares hem anders ziet.";

	// ----- Vervolg op RSopen #657: de kentallen van team Veen en het veen buiten de SOMERS-percelen -----
	// Drie aannames die nog bij Deltares ter controle liggen. Alle drie staan uit, zodat de lopende uitdraaien niet
	// veranderen; zet ze aan om te meten wat ze doen. De kengetallen zelf staan in Classifications/Grondgebruik/VeenBroeikasgas.
	parameter<Bool>                         Koolstof_VeenVastleggingUitBouwstenen  := TRUE, Descr = "Gebruik op veen- en moerige bodem de vastleggingskentallen van team Veen voor de veenvormende klassen, in plaats van de generieke Cseq_ha uit de koolstofklassentabel (#657).
												Waarom dit nodig is. Team Veen geeft voor de veenvormende bouwstenen een netto opname van 3 tot 7 ton CO2 per hectare per jaar; de koolstofklassentabel komt op dezelfde samenstelling niet verder dan 0,4 tot 2,7. Zie Classifications/Grondgebruik/NbSVeen/Vergelijking. Op de veenbodem is dat verschil bovendien geen kwestie van het kental alleen: de voorraad uit de bodemkoolstofkaart ligt daar rond 169 ton C per hectare, ver boven het klassemaximum van 55 van Riet en watervegetatie, waardoor min_elem in Groei_ha nooit ruimte ziet en de vastlegging op precies die klasse hoe dan ook nul blijft. Deze schakelaar zet daarom zowel het kental als het maximum om.
												De aanname erachter is dat veenvorming koolstof toevoegt in plaats van naar een plafond toegroeit: de vegetatie maakt nieuwe bodem. Dat is de reden dat Hoogveen in de tabel al een maximum van 930 draagt en de rietklasse niet.";
	parameter<Bool>                         Koolstof_OxidatieBuitenSOMERS          := TRUE, Descr = "Boek ook veenoxidatie op de veen- en moerige gronden die buiten de SOMERS-veenweidepercelen liggen, met de emissiefactoren die Deltares op 31-08-2026 in #657 heeft aangeleverd (EF_low_nl_2025.csv).
												Gemeten omvang van het gat: 231.783 ha veen en moerige grond buiten de percelen waarop SOMERS rekent, waar RSopen op dit moment nergens oxidatie boekt. Daarvan ligt 92.613 ha in laag Nederland en 139.170 ha in hoog Nederland; zie Diagnose657.
												Twee dingen om te weten voordat je hem aanzet. De factor is een enkel getal per bodemtype zonder grondwaterstand, dus hij verandert het niveau van de landelijke balans en niet het verschil tussen de varianten, behalve waar het landgebruik naar water of bebouwing gaat. En de factoren gelden voor laag Nederland; voor hoog Nederland heeft Deltares laten weten dat ze niet representatief zijn, vandaar de aparte schakelaar hieronder.";
	parameter<Bool>                         Koolstof_OxidatieBuitenSOMERSOokHoogNL := FALSE, Descr = "Pas de emissiefactoren voor laag Nederland ook toe op hoog Nederland (FALSE laat hoog Nederland op nul). Staat uit omdat Deltares in #657 heeft gemeld dat de factoren van hoog Nederland nog niet representatief zijn en er nog aan gewerkt wordt. Het gaat om 118.689 ha met een niet-stedelijk en niet-waterlandgebruik, oftewel 1,36 Mton CO2 per jaar als je de laag-Nederlandse factoren toch zou gebruiken. Alleen zinvol samen met Koolstof_OxidatieBuitenSOMERS.";
	parameter<Float32>                      Koolstof_EF_Veen_tonCO2_ha_jaar        := 10.59f, Descr = "Emissiefactor voor veengrond buiten de SOMERS-percelen, in ton CO2 per hectare per jaar. Uit EF_low_nl_2025.csv, aangeleverd door Deltares op 31-08-2026 bij #657: 1,059 kg CO2 per m2 per jaar voor elke landlaag op veen behalve de wateren. Ter vergelijking: SOMERS komt in BAU op de veenweidepercelen op gemiddeld 12,1 ton per hectare per jaar uit, dus dit is een BAU-achtig niveau en geen vernattingsniveau.";
	parameter<Float32>                      Koolstof_EF_Moerig_tonCO2_ha_jaar      := 11.96f, Descr = "Idem voor de moerige gronden, uit dezelfde tabel: 1,196 kg CO2 per m2 per jaar. Dat de moerige gronden hoger staan dan de veengronden is wat de aangeleverde tabel zegt; het is niet nagevraagd.";
	parameter<Bool>                         Koolstof_EFStedelijkOpNul              := FALSE, Descr = "Houd het stedelijk gebied op de veenbodem buiten de SOMERS-percelen op nul uitstoot (TRUE), of pas de emissiefactor ook daar toe (FALSE)?
												Dit is een openstaande tegenspraak. Deltares heeft op 27-08-2026 in #657 bevestigd dat stedelijk gebied geen CO2-uitstoot heeft en ook geen restemissie, en die nul staat als aanname bij ModelParameters/Landbouw/CO2_Uitstoot_StedelijkGebruik. De tabel van 31-08-2026 geeft panden, erven, openbare ruimte en stedelijk groen op veen daarentegen dezelfde 1,059 als de percelen. Tot dat is uitgezocht houden we de eerdere bevestiging aan. Het gaat om 31.801 ha in laag Nederland, oftewel ongeveer 0,34 Mton CO2 per jaar.";
	parameter<Bool>                         Methaan_Meetellen                      := TRUE, Descr = "Reken de methaanuitstoot uit natte veenbodems mee als aparte indicator (#657). Dit is een toevoeging en geen wijziging: de bestaande CO2-indicatoren veranderen er niet van.
												Waarom dit erbij hoort. Team Veen geeft in dezelfde tabel waaruit de bouwstenen komen naast een CO2-kental ook een methaankental per bouwsteen, en dat tweede getal is het grootste. In de eindtoestand 2120 komt de CO2-balans van het veengebied volgens die tabel op ongeveer nul uit, terwijl er 3,1 Mton CO2-equivalent per jaar aan methaan tegenover staat. Het gat heeft bovendien richting: de varianten die het meeste veen vernatten scoren op CO2 het beste en hebben tegelijk de meeste natte hectares. Zolang het model alleen CO2 telt, leest dat als een schoon resultaat.
												De kentallen staan in Classifications/Grondgebruik/VeenBroeikasgas. Zie de indicator Methaan voor wat er wel en niet in zit; sloten en de methaan van natte natuur buiten de veenbodem ontbreken.";

	// ===== VERDISCONTERING VAN DE KOSTEN- EN WAARDE-INDICATOREN (#651) =====
	// De landelijke MKBA-richtlijn schrijft sinds 1 januari 2026 een termijnstructuur voor: een eerste discontovoet
	// tot en met horizon 35 jaar en een tweede daarna. Beide zijn reeel, dus bij constante prijzen, wat aansluit op
	// het model: alle bedragen staan in prijzen van het basisjaar. Bron: Rapport Werkgroep discontovoet 2025,
	// versie 1.00 van 19 september 2025, kabinetsreactie en inwerkingtreding per 2026-01-01. De standaardvoeten zijn
	// opgebouwd uit een risicovrije component van 0,0 procent plus een risico-opslag van 2,8 respectievelijk 1,8 procent.
	//   https://www.rwseconomie.nl/discontovoet
	//   https://open.overheid.nl/documenten/43d845b2-d837-4e34-9a46-dffe460e043a/file
	// De richtlijn kent ook een lage variant (2,2 en 1,4 procent) voor onvermijdbare vaste kosten zonder alternatieve
	// aanwending en een hoge variant (4,2 en 2,7 procent) voor baten die sterk met de conjunctuur meebewegen. Welke
	// variant per indicator hoort is een inhoudelijke keuze die nog met Deltares en PBL te maken is; hier staat de
	// standaardvariant. Voor natuur bestaat aparte PBL-guidance die hier nog niet is verwerkt.
	parameter<Float32>   Discontovoet_TotHorizonGrens  := 0.028f, Descr = "Eerste discontovoet: geldt voor kosten en baten tot en met DiscontoHorizonGrens jaar na het basisjaar. Reeel, standaardvariant uit het Rapport Werkgroep discontovoet 2025.";
	parameter<Float32>   Discontovoet_NaHorizonGrens   := 0.018f, Descr = "Tweede discontovoet: geldt voor de jaren daarna. Reeel, standaardvariant uit het Rapport Werkgroep discontovoet 2025. Dat de voet na 35 jaar daalt is precies waarom dit voor NL2120 uitmaakt: bij een vlakke 2,8 procent zou een euro in 2120 nog 6,9 cent waard zijn, met de termijnstructuur 12,6 cent. Voor 2060 maakt het weinig uit, 36,0 tegen 36,7 cent.";
	parameter<jaar>      DiscontoHorizonGrens          := 35[jaar], Descr = "Horizon waarop de richtlijn van de eerste naar de tweede discontovoet overgaat, geteld vanaf het eerste jaar waarin kosten of baten optreden. Dat eerste jaar is hier Model_StartYear.";
	parameter<Bool>      VerdisconteerIndicatoren      := TRUE, Descr = "Staat de verdiscontering aan? Op FALSE blijft elke NCW-indicator gelijk aan zijn nominale tegenhanger, want de factor is dan 1. Bedoeld om het effect van de verdiscontering zichtbaar te maken zonder twee runs te hoeven vergelijken.
																						Raakt de funderingsschade nu FEITELIJK niet, maar niet door constructie (#680). Verdiscontering_Horizon_T/Factor leest deze schakelaar wel, en Suitability_Wonen_perOP_T roept dat sjabloon aan, dus hij zit in de allocatie. Dat het vandaag niets uitmaakt komt alleen doordat JaarWaarinFunderingschadeZichtbaar in alle varianten gelijk is aan Model_StartYear: de horizon is nul, de deler 1, en dan geeft de schakelaar in beide standen factor 1. Zet dat jaar per variant verschillend, wat de verhaallijn van eerder zichtbaar maken juist vraagt, dan gaat deze rapportageknop de allocatie verzetten. Regel dat eerst, bijvoorbeeld met een eigen factor voor de suitability, voordat dat jaar gaat afwijken.";

	parameter<String>    IndicatorRegio_ref            := =quote(replace_value(expand(., '%env:IndicatorRegio%'), 'env:IndicatorRegio', 'NL'))
	, Descr = "Op welke regio-indeling de indicatoren aggregeren. Een keuze, geldig voor alle indicatoren tegelijk (#658). Te zetten met de omgevingsvariabele IndicatorRegio, net als ExportZichtjaar, zodat de vier landschapsruns van #760 te scripten zijn zonder de configuratie te bewerken; zonder die variabele staat hij op NL. Opties: NL, Provincie, COROP, Gemeente, NVM, Landschap, en de vier losse landschapsgebieden Landschap_Kust, Landschap_Rivieren, Landschap_Veen en Landschap_Zand.

											Landschap is de vijfdeling uit #705, een partitie waarin elke cel bij precies een landschap hoort. Die wordt sinds #760 niet meer voor de rapportage gebruikt.

											De vier opties Landschap_Kust en verder zijn de begrenzingen die de landschapsteams zelf aanleveren (#760). Die overlappen elkaar, dus ze kunnen geen gedeelde indeling vormen; elk is een eenheid van een regel met alleen een masker. Kies er een en de indicatorentabel gaat over dat landschap. Een run levert daarnaast altijd de landelijke tabel, dus vier runs geven de vier landschappen plus Nederland.

											Hiervoor stond de indeling elf keer los in de indicatorensjablonen, meestal op Provincie en soms op Provincie/StudyArea, waardoor een tabel per indicator een andere doorsnede kon geven. Nu leest elk sjabloon IndicatorRegio_path hieronder.

											De keuze raakt uitsluitend de tabellen. De grids staan er altijd op celniveau naast en veranderen niet mee, en de _Per_NL-parameters bij de indicatoren zijn altijd het landelijke totaal. Claimrealisatie valt hier bewust buiten: die aggregeert per definitie op de allocatieregio van de sector, want daar wordt de claim ook opgelegd.

											Voor de productierun van #658 staat dit op NL: een tabel van een regel, met alle indicatoren als kolom naast elkaar. Zet hem op Provincie om weer een regionale doorsnede te krijgen. Een fijnere indeling dan Gemeente maakt de tabellen groot en de gemiddelden dun bezet; NVM is de indeling waarop de wonen-claim wordt opgelegd en is daarom handig naast de claimrealisatie.";

	parameter<String>    IndicatorRegio_path           := switch(
			  case(IndicatorRegio_ref == 'NL',        '/SourceData/RegioIndelingen/NL')
			, case(IndicatorRegio_ref == 'Provincie', '/SourceData/RegioIndelingen/Provincie/StudyArea')
			, case(IndicatorRegio_ref == 'COROP',     '/SourceData/RegioIndelingen/COROP/StudyArea')
			, case(IndicatorRegio_ref == 'Gemeente',  '/SourceData/RegioIndelingen/Gemeente')
			, case(IndicatorRegio_ref == 'NVM',       '/SourceData/RegioIndelingen/NVM')
			, case(IndicatorRegio_ref == 'Landschap', '/SourceData/Landschap/LandschapsRegio')
			, case(IndicatorRegio_ref == 'Landschap_Kust', '/SourceData/Landschap/Landschapsgebieden/Kust/Gebied')
			, case(IndicatorRegio_ref == 'Landschap_Rivieren', '/SourceData/Landschap/Landschapsgebieden/Rivieren/Gebied')
			, case(IndicatorRegio_ref == 'Landschap_Veen', '/SourceData/Landschap/Landschapsgebieden/Veen/Gebied')
			, case(IndicatorRegio_ref == 'Landschap_Zand', '/SourceData/Landschap/Landschapsgebieden/Zand/Gebied')
			, ''
		)
	, IntegrityCheck = "this != ''"
	, Descr = "Het pad achter IndicatorRegio_ref. De indicatorensjablonen zetten hier hun unit Regio op, met een =-expansie. Elke indeling die hier bij kan komen moet name en Per_AdminDomain_Fijn hebben; die twee gebruiken de sjablonen. Dat is sinds #748 Per_AdminDomain_Fijn en niet Per_AdminDomain: die laatste loopt bij de meeste indelingen over AllocDomain, dus over een rasterisering op 100 meter, terwijl de weggeschreven kaarten op 25 meter zijn gemaskeerd. Studiegebiedcellen waarvan de bovenliggende cel van 100 meter geen regio kreeg vielen daardoor stil uit elke kolom, in de NL-indeling 4.311,94 hectare. Een geometry is sinds #705 niet meer nodig: de waterbergingstabel leidt zijn blokindeling met modus uit Per_AdminDomain af, zodat ook een rasterindeling als Landschap kan meedoen. Provincie en COROP wijzen naar hun StudyArea-selectie, zodat een run op een kleiner studiegebied geen lege regels oplevert. Een lege uitkomst betekent een onbekende naam in IndicatorRegio_ref en laat de IntegrityCheck hier vallen.";

	// --- BAG-nieuwbouw (#703) ---
	parameter<uint32> MaxLeeftijdPijplijn := 5
	, Descr = "Hoeveel jaar oud een voorkomen met de status gevormd, bouw gestart of bouwvergunning verleend hoogstens mag zijn om nog als pijplijn mee te tellen. Gerekend vanaf BAG_RecentYear, dus met de waarde 5 en BAG_RecentYear 2026 tellen voorkomens vanaf 1 januari 2021 mee.

				De route NaRecentJaarWelActief telde tot #703 elk voorkomen mee dat op de peildatum die status droeg, ongeacht ouderdom. Een bouwvergunning uit 2012 die nooit tot bouw kwam draagt die status nog steeds en kwam dus als toevoeging aan de startsituatie in de boeken, zonder dat er een route bestaat die hem er ooit weer uit haalt.

				De grens is empirisch bepaald op de jaargang 20260710. Van de 312.969 verblijfsobjecten die op 1 januari 2026 de status gevormd dragen komt 40,5 procent uit 2025, 31,2 uit 2024 en 12,7 uit 2023; vanaf 2021 terug zakt elk jaar onder de 3,5 procent en blijft dalen. Bij de 135.087 panden met bouw gestart of bouwvergunning verleend is het beeld hetzelfde: 62,0 procent uit 2025 en 20,6 uit 2024. De verdeling knikt dus rond vier tot vijf jaar terug, en dat is ook waar de bouwtijd van een normaal project ophoudt.

				Met de waarde 5 valt 3,7 procent van de verblijfsobjecten af, goed voor 5,2 procent van hun gebruiksoppervlak, en 4,6 procent van de panden. Op 0 komt het gedrag van voor #703 terug, want dan geldt er geen ondergrens.";

	parameter<int32>  PijplijnOndergrensDatum := MaxLeeftijdPijplijn == 0 ? 0i : int32((/ModelParameters/BAG_RecentYear - MaxLeeftijdPijplijn) * 10000 + 101)
	, Descr = "De ondergrens als BAG-datum, dus jjjjmmdd. Op 0 doet de toets niets, want elke begindatum ligt daarboven.";

	parameter<Bool> LogistiekePijplijnHeuristiek := FALSE
	, Descr = "Typeer panden in aanbouw of vergund als logistiek op pandkenmerken, zonder LISA-banen (#703). De LISA-afgeleide aanvulling (BAG_LogistiekDynamisch) kan een pand pas als logistiek herkennen zodra er een vestiging met banen zit, dus de hele logistieke pijplijn telt als Nijverheid; de pijplijnterm van logistiek is exact nul terwijl er wel distributiecentra in aanbouw zijn.
				De heuristiek: status bouw gestart of bouwvergunning verleend, voetafdruk vanaf LogistiekePijplijn_MinFootprint, ligging op een IBIS-werklocatie (jaargang ModelParameters/IBIS_Year), en niet hoger dan LogistiekePijplijn_MaxHoogte_cm.
				Staat op FALSE op grond van de validatie in Diagnose667/D703: op de gerealiseerde nieuwbouw vanaf het modeljaar, waar de LISA-typering als waarheid beschikbaar is, haalt de heuristiek wel 85 procent van het logistieke oppervlak binnen maar is de precisie 43 procent, en die precisie is vlak over elke voetafdrukdrempel van 2.500 tot 20.000 m2. Grootte plus IBIS-ligging onderscheidt een distributiecentrum dus niet van een productiehal. Aanzetten verplaatst daardoor evenveel oppervlak ten onrechte naar Logistiek als er nu ten onrechte in Nijverheid staat, en omdat logistiek per m2 ongeveer twee keer zoveel banen draagt, zou het de banen uit de pijplijn per saldo verhogen. De vertekening herstelt zichzelf bovendien: zodra een centrum oplevert en LISA er banen ziet, schuift het bij de volgende jaargang naar logistiek.";
	parameter<m2PandFootprint> LogistiekePijplijn_MinFootprint := 2500[m2PandFootprint]
	, Descr = "Ondergrens op de pandvoetafdruk, gelijk aan MinFootprint_Leeg uit de LISA-aanvulling: dat is daar de drempel voor panden zonder eigen vestiging, en een pand in aanbouw heeft per definitie nog geen vestiging.";
	parameter<float32> LogistiekePijplijn_MaxHoogte_cm := 2500f
	, Descr = "Bovengrens op de AHN-pandhoogte in centimeters, dus 25 meter. Panden zonder hoogte tellen als laag genoeg, via een expliciete IsDefined-toets: de AHN-jaargang is het modeljaar, dus panden in aanbouw missen er vrijwel altijd in, en null vergelijkt in GeoDMS naar FALSE en niet naar null.";

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Waarden die tot september 2026 als kaal getal in de lopende code stonden. Ze zijn hierheen verplaatst zonder
	// de waarde te veranderen, dus deze verhuizing is per constructie uitkomstneutraal. De regel is dat een keuze
	// die iemand zou kunnen willen verzetten hier staat en niet in de expressie: een getal in een expressie is niet
	// te vinden zonder de code te lezen, en verschijnt dus ook niet in een variantvergelijking of een audittrail.
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////

	parameter<Float32>   ClaimRealisatie_NormOnder := 0.98f
	, Descr = "Onder welke realisatiegraad een regio als onderrealisatie telt in Templates/Indicatoren/ClaimRealisatie. Stond als kaal getal op zes plekken: eenmaal voor wonen en eenmaal per werksubsector, telkens in drie toetsen. De band is bewust symmetrisch rond 1; wie hem verruimt of versmalt hoort beide grenzen mee te nemen.";

	parameter<Float32>   ClaimRealisatie_NormBoven := 1.02f
	, Descr = "Boven welke realisatiegraad een regio als overrealisatie telt. Zie ClaimRealisatie_NormOnder. Let op dat het toetsharnas batch/ToetsOplevering.ps1 een eigen, ruimere band hanteert voor het landelijke totaal; die staat daar en niet hier, want dat is een oordeel over een levering en geen modelparameter.";

	parameter<meter>     Claimregio_Bufferstraal := 2500[meter]
	, Descr = "Straal waarmee de claimregio-polygonen worden gebufferd voordat ze op het grid worden gelegd, in Templates/Claims/Claims_TargetUnits_T en Templates/Claims/ZichtjaarXScenarioxAllocRegios. De buffer vangt cellen op die net buiten een regiogrens vallen maar er wel bij horen, vooral langs de kust en de grote wateren. Stond als kaal getal 2500.0 op beide plekken; dat die twee gelijk moeten blijven was nergens vastgelegd.";

	parameter<meter>     Bevolkingskern_Bufferstraal := 1000[meter]
	, Descr = "Straal van de buffer rond bevolkingskernen naar grootteklasse, in SourceData/RegioIndelingen/Maak_PopK_Buffers_T. Voedt de OV-klassen, de dichtheidsfactoren per kerngrootte en een trede-as. Stond als kaal getal in het buffersjabloon.";

	parameter<Float32>   Bevolkingskern_Grens_Groot := 100000f
	, Descr = "Inwonergrens waarboven een kern als grote kern telt. Stond als kaal getal in SourceData/RegioIndelingen. De drie klassen zijn samen uitputtend: onder de kleine grens, ertussen, en boven deze grens.";

	parameter<Float32>   Bevolkingskern_Grens_Klein := 20000f
	, Descr = "Inwonergrens tussen een kleine en een middelgrote kern. Zie Bevolkingskern_Grens_Groot. Sinds #749 kan het inwonertal uit de CBS-vierkanten komen in plaats van uit de bevolkingskernen van 2011; die zijn op vijftallen afgerond, dus een kern vlak bij een grens kan van klasse wisselen. Gemeten: van de 3.106 gebieden liggen er twee net boven en vier net onder de 20.000, en een net boven en een net onder de 100.000.";

	parameter<UInt32>    Landschap_Vereenvoudiging_Straal_m := 2500
	, Descr = "Over welke straal de landschapskaart wordt vereenvoudigd, in meters, in SourceData/Landschap. Per cel wordt van elk landschap het aandeel binnen deze straal bepaald en de cel gaat naar het landschap met het hoogste aandeel, mits dat boven Landschap_Vereenvoudiging_Drempel ligt. Groter laat verspreide leveringspolygonen in elkaar overlopen en laat enclaves verdwijnen; op nul blijft de kaart op de leveringen zelf liggen. De projectgroep koos in #705 voorlopig 2.500 meter.

						De waarde moet een straal zijn waarvoor Geography/Distmatrices_100m een kern kent, want de kernnaam wordt eruit opgebouwd.";

	parameter<Float32>   Landschap_Vereenvoudiging_Drempel := 0.05f
	, Descr = "Welk aandeel een landschap binnen de vereenvoudigingsstraal minstens moet halen voordat de cel eraan wordt toegewezen. Daaronder blijft de cel zonder landschap. Zie Landschap_Vereenvoudiging_Straal_m.";

	parameter<meter>     MaxPlausibeleOverstromingsdiepte := 100[meter]
	, Descr = "Bovengrens waarboven een waterdiepte uit de dieptekaarten als onzin wordt beschouwd en op null gaat, in SourceData/Water. Honderd meter ligt ruim boven elke diepte die in Nederland kan optreden en vangt de vulwaarden van de leveringen af.";

}
