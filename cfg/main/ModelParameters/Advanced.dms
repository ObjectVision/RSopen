// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de ModelParameters: Parameters die voor elk scenario en elke Variant hetzelfde zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Advanced
{
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Wonen              := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Wonen              := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Werken             := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Werken             := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Binnenstedelijk_Verblijfsrecreatie := 0.4[ha];
	parameter<ha>        Minimum_alloc_group_size_Buitenstedelijk_Verblijfsrecreatie := 2[ha];
	parameter<ha>        Minimum_alloc_group_size_Waterberging                       := 2[ha];

	parameter<uint8>     IterVanafWaarWeAfgewezenCellenUitsluitenInAlloc             := 1b, Descr = "Vanaf welke iteratie afgewezen cellen uit de beschikbaarheid gaan. Dit mechanisme is de motor van het proces en niet de rem: een cel die losliggend boven de zaaglijn uitkomt heeft geen gealloceerde buren en haalt de erosie-eis nooit, dus zolang hij beschikbaar blijft kiest de allocatie hem elke iteratie opnieuw en wijst hem elke iteratie opnieuw af. Op 5 kostte dat vier lege iteraties. Zie ObjectVision/RSopen#643.";
	parameter<float32>   MorfologischeCleaning_Aantal_BuurCellenAllocOmTeOverleven   := 6f, Descr = "Terugvalwaarde; de allocatie gebruikt de sectorspecifieke waarde hieronder. Deze eis is feitelijk een minimale beukmaat en geen vloeiende knop. De erosie telt over een 3x3-blok inclusief de cel zelf en eist er parameter+1 van de negen. Een strook van een cel geeft er drie, van twee cellen zes, en de kern van een strook van drie cellen negen. Op 6 overleeft dus alleen wat minstens 75 meter breed is, op 3 tot en met 5 alles vanaf 50 meter, en pas daaronder overleeft een lint van een enkele cel. Zie ObjectVision/RSopen#643.";
	parameter<float32>   MorfologischeCleaning_BuurCellen_Wonen                      := 6f, Descr = "Minimale beukmaat voor wonen: 6 is 75 meter, 5 is 50 meter. Op 5 gaat het binnenstedelijke aandeel van 20,4 naar 24,3 procent en komen er 6.496 woningen bij, maar overleeft ook een lint van 50 meter langs een weg. Dat is de afweging.";
	parameter<float32>   MorfologischeCleaning_BuurCellen_Werken                     := 6f;
	parameter<float32>   MorfologischeCleaning_BuurCellen_Verblijfsrecreatie         := 6f;
	parameter<float32>   MorfologischeCleaning_BuurCellen_Waterberging               := 6f;

	parameter<String>    AdminDomain_ref               := '25m', Descr = "Ruimtelijke resolutie waarop de allocatieresultaten worden geadminstreerd";
	parameter<String>    AllocDomain_ref               := '100m', Descr = "Ruimtelijke resolutie waarop de allocatie plaatsvindt (keuze-eenheid)";
	parameter<string>    AllocatieFileName             := '%LocalDataProjDir%/Allocatie/@CASUS@/Stand@JAAR@/@STANDPATH@_@SA@_SS-@SS@.tif'; //Casus_name, Zichtjaar, StandVar/path, ModelParameters/StudyArea, #/Classifications/Actor/Sector/xSubsector

	parameter<string>    ImperviousnessMapYear         := 'y2024';
	parameter<Bool>      BAG_LogistiekDynamisch        :=  TRUE, Descr = "Vult de statische logistieke pandenset (stand 2021) aan met een LISA-afgeleide typering van nieuwbouw vanaf 2021, via het ontkoppelde bestand LogistiekAanvulling_FileName. Genereren of hergenereren (na een BAG- of LISA-vintagewissel of een versie-ophoging): zet deze parameter tijdelijk op FALSE, draai WritePrivData/LogistiekAanvulling/Generate en zet hem weer op TRUE; met de parameter aan trekt het pand-domein het nog te schrijven bestand als supplier mee en faalt de generatie (zelfde procedure als bij BAG_WP5_rel_Ontkoppeld). Zonder aanvulling kan nieuwbouw nooit logistiek worden en telt die mee als Nijverheid: gemeten op BAG-2026 gaat dat om 355 ha footprint, oplopend met circa 100 tot 150 ha per jaar.";

	parameter<uint16>    FromWhichDoWeKeepTIGRISconstant := 2060w;
	parameter<YearRange> PlancapaciteitGeldigTotEnMet    := 2050[YearRange], Descr = "Tot en met welk zichtjaar plancapaciteit de zeef-restricties opheft. Plannen hebben een beperkte looptijd; in zichtjaren na dit jaar vervalt de vrijstelling van restricties door harde en zachte plannen in de zichtjaar-zeef. De trede-voorrang van plancapaciteit blijft wel staan (de tredes zijn zichtjaar-onafhankelijk); die uitfaseren is een aparte verbouwing.";

	// GRONDGEBRUIK 
	parameter<meter2>                       MinimumPandFootprint             := 20[meter2], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor werken worden gehanteerd. Hiervoor wordt de pandfootprint gebruikt.";
	parameter<Woning>                       MinimumWoningAmount              := 5[Woning], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor wonen worden gehanteerd. Hiervoor wordt het aantal woningen gebruikt.";
	parameter<Verblijfsobject>              MinimumVerblijfsobjectAmount     := 1[Verblijfsobject], Descr = "Om dominantie te bepalen in de landgebruikskaart moet een ondergrens voor verblijfsrecreatie worden gehanteerd. Hiervoor wordt het aantal verblijfsobjecten gebruikt.";
	parameter<UInt32>                       MinimumGroupSize                 := 3, Descr = "Om de landgebruikskaart aan te laten sluiten bij de BBG, wordt een vergelijkbare methodiek gehanteerd waarbij 25m cellen worden gegroepeerd. Pas als deze drempel wordt bereikt wordt een cel overwogen om in de landgebruikskaart te komen.";
	parameter<Bool>                         ToetsWonenOpWaterInKaart         := FALSE, Descr = "Laat de landgebruikskaart afbreken zodra de switch in Templates/Indicatoren/Landgebruikskaart wonen zou hebben opgeleverd op een cel die de kaart water noemt, zie Toets_WonenOpWater/Woningen_WaterWintVanWonen daar. Standaard uit, want die toestand bestaat vandaag al: de zeef geeft in IJburg 2 met opzet water vrij voor wonen, terwijl de waterklassen verder als evident benut staan. Meet het getal eerst en zet deze schakelaar pas aan als het nul is. Zie #665.";

	parameter<Bool>                         SchadeToetstBouwwijzeVanPakket   := TRUE, Descr = "Waarop bepaalt de overstromingsschade wat een maatregel aan een nieuwbouwwoning doet? Op TRUE, de huidige stand, op de bouwwijze van het ontwikkelpakket dat er werkelijk gealloceerd is: de schadefactor wordt afgelezen bij de waterdiepte ter plaatse min BouwwijzeK/SchadevrijeDiepte, met een ondergrens van nul. Blijft het water onder de ontwerpdiepte, dan is de schade nul; komt het erboven, dan telt de restdiepte. Op FALSE het gedrag tot #681: een drempel op de eis van de plek, waar de woning niet meetelt zodra de overstromingsgevaarzone bouwen met maatregelen voorschrijft, ongeacht wat er staat en ongeacht hoe diep het water komt.
																									De keuze is beslecht in #681, met Deltares. Twee gronden. Ten eerste gaat de aanname over het gebouw en niet over de plek: de eis is een voldoende maar geen noodzakelijke voorwaarde, want gevaarzone 0 en 1 stellen geen eis terwijl de NbS-pakketten daar wel met maatregelen landen. Ten tweede is een drempel de verkeerde vorm: SSM2017 doet een hoger gelegen vloerpeil zelf als verschuiving langs de diepte-as, functie 395 is functie 9 exact 2,50 meter opgeschoven. De verschuiving is onder de ontwerpdiepte identiek aan de drempel en haalt er de klip boven de ontwerpdiepte uit.
																									De schakelaar staat op twee plaatsen tegelijk: Grondgebruik/Zichtjaar/IsOverstromingsbestendig (de drempel, op TRUE uit) en Parameters/<watersysteem>/Diepte_Nieuwbouw (de verschuiving, op FALSE uit). Zie #665 en #681.";

	parameter<UInt8>                        MinimumCountNieuwNatuur          := 10b, Descr = "In de aggregatie van NVK kaarten het aantal 25m cellen in een 100m die nieuwe natuur zijn om dit in het zichtjaar op te nemen.";

	// KOOLSTOF (indicator koolstofopslag en -vastlegging, zie RSopen #483)
	parameter<string>                       Koolstof_MaxSrc                        := 'Cmax_ha_invest'; // Cmax_ha_WUR
	
	parameter<Bool>                         Koolstof_BasisvoorraadUitKaart         := TRUE, Descr = "Startvoorraad koolstof in het basisjaar uit de bodemkoolstofkaart van de Atlas Natuurlijk Kapitaal (TRUE, SourceData/Bodem/BodemKoolstofvoorraad) of op nul beginnen zoals voorheen (FALSE). Op nul beginnen geeft een bovengrens van de vastlegging, omdat er in werkelijkheid al koolstof in de bodem zit.";
	parameter<Bool>                         Koolstof_BasisvoorraadBegrenzen        := FALSE, Descr = "Begrens de startvoorraad uit de kaart op het maximum van de landgebruiksklasse in het basisjaar (variant 3 uit RSopen #483). De kaart ligt op ongeveer tweederde van het areaal boven dat maximum, omdat de kaart de bodemvoorraad in de bovenste 30 cm geeft en het maximum uit de kengetallentabel komt. Alleen zinvol in combinatie met Koolstof_BasisvoorraadUitKaart.";
	parameter<Bool>                         Koolstof_AfboekenAlleenBijLagerMaximum := TRUE, Descr = "Afboeken naar het maximum van de nieuwe klasse gebeurt alleen waar dat maximum ook daadwerkelijk lager is dan dat van de vorige periode, dus bij een landgebruiksverandering naar een klasse met een lager maximum (TRUE, variant 1 uit RSopen #483). Bij FALSE wordt afgeboekt zodra de voorraad boven het maximum van de eigen klasse uitkomt, ook zonder landgebruiksverandering; in combinatie met een startvoorraad uit de kaart levert dat in het eerste zichtjaar een eenmalige afboeking van ruim 500 Mton CO2 op.";
	// ----- Spoor 3 uit RSopen #657: de veenoxidatie uit SOMERS schrijft af van de koolstofvoorraad -----
	parameter<Bool>                         Koolstof_SOMERSAfschrijven             := TRUE, Descr = "Laat de veenoxidatie die SOMERS_CO2_laagveen rapporteert daadwerkelijk van de koolstofvoorraad afschrijven (TRUE, spoor 3 uit RSopen #657). Zonder dit staan er twee boekhoudingen naast elkaar die dezelfde koolstof beschrijven: SOMERS laat hem als jaarlijkse stroom verdwijnen terwijl de voorraad onaangeroerd blijft, en bij een landgebruiksverandering wordt diezelfde koolstof alsnog in zijn geheel afgeboekt. Op Y2030 telde daardoor 3,3 van de 11,5 Mton CO2 in NbSGenuanceerd dubbel. Bij FALSE valt de berekening terug op de oude, met een afschrijving van nul.";
	parameter<String>                       Koolstof_SOMERSEmissieVariant          := 'Mediaan', Descr = "Welke SOMERS-emissievariant de koolstofboekhouding voedt: Minimum, Mediaan of Maximum, zie Classifications/CO2/EmissieK. De indicator SOMERS_CO2_laagveen rapporteert alle drie; de voorraad kan er maar een verwerken.";

	parameter<Bool>                         Koolstof_VeenreserveGebruiken          := TRUE, Descr = "Vang de veenoxidatie eerst op in een aparte veenreserve onder de bovenste 30 cm, en pas daarna in de voorraad uit de bodemkoolstofkaart (TRUE). Dit is nodig omdat de twee kanten van de balans anders verschillende reservoirs zijn: de kaart geeft de bovenste 30 cm, terwijl SOMERS de hele gedraineerde veenkolom laat oxideren. Zonder reserve is de voorraad op de veenweidepercelen bij het BAU-tempo binnen de modelhorizon op, waarna de varianten niet meer van elkaar verschillen. De reserve komt uit SourceData/Landbouw/Peat_thickness, de veendikte uit GeoTOP, en wordt begrensd door de bodemkaart en de grondwaterstand; zie de twee schakelaars hieronder.";
	parameter<Bool>                         Koolstof_VeenreserveOpBodemkaart       := TRUE, Descr = "Beperk de veenreserve tot de veengronden en moerige gronden van BOFEK2020 (TRUE), of vul hem overal waar GeoTOP veen ziet (FALSE)? Op aanwijzing van Deltares in #657: GeoTOP telt ook begraven en diep begraven veen mee dat niet oxideert, en dat verklaart de factor bijna drie tussen de twee kaarten. BOFEK is bovendien de kaart waarop SOMERS zelf rekent, dus met deze afbakening beschrijven de twee kanten van de balans hetzelfde gebied. Gemeten effect: 438.667 ha veenbodem tegen 1,21 mln ha met veendikte in GeoTOP.";
	parameter<Bool>                         Koolstof_VeenreserveBegrenzenOpGLG     := TRUE, Descr = "Begrens de veenreserve op de gemiddeld laagste grondwaterstand van het basisjaar (TRUE), of vul hem met de hele veenkolom (FALSE)? Ook op aanwijzing van Deltares in #657: oxidatie treedt alleen op boven de grondwaterstand, dus wat daaronder ligt komt niet vrij zolang het peil niet daalt. De GLG en niet de GHG, want dat is binnen die redenering de ruime kant.

																															Deze twee eisen wringen wel met de wens uit datzelfde antwoord om de reserve zo groot mogelijk te nemen: samen laten ze er nog geen tiende van over. Zet hem op FALSE om dat te meten; de vergelijking staat in Diagnose/Veenreserve.";
	parameter<Float32>                      Koolstof_VeenOrganischeStofdichtheid   := 0.103f, Descr = "Dichtheid van de organische stof in veen, in ton per m3, voor het omrekenen van veendikte naar een koolstofreserve. Dit is uitdrukkelijk niet de droge bulkdichtheid van het veen: die is hoger, want daar zit de minerale fractie in. 0,103 is de gemiddelde organischestofdichtheid van veen in de Nederlandse ondergrond volgens de publicatie die Deltares in #657 heeft aangewezen (Erkens et al. 2016, Hydrogeology Journal). Dat gemiddelde is bepaald zonder het diep begraven veen onder meer dan 150 cm klastisch dek, dat volgens diezelfde publicatie niet oxideert, en past dus bij de reserve die hier bedoeld is. De publicatie geeft daarnaast een minimum- en een maximumscenario van 0,080 en 0,150.";
	parameter<Float32>                      Koolstof_VeenKoolstoffractie           := 0.5f, Descr = "Massafractie koolstof in de organische stof van veen, voor het omrekenen van veendikte naar een koolstofreserve. Bevestigd door de publicatie uit #657: die neemt hetzelfde aan en komt daarmee op een koolstofdichtheid van 52 kg per m3. Samen met de organischestofdichtheid geeft 0,103 maal 0,5 maal 10.000 een reserve van 515 ton C per hectare per meter veen. Tot 27-08-2026 stond hier 0,13 maal 0,5, oftewel 650.";

	parameter<Bool>                         Koolstof_AfboekenAlleenBijBodemingreep := TRUE, Descr = "Afboeken gebeurt alleen bij een verandering naar een landgebruiksklasse die de bodem daadwerkelijk afdekt of afgraaft, zoals wegen en bebouwing (TRUE, spoor 1 uit RSopen #657). De kolom MagAfboeken in Classifications/Grondgebruik/CarbonClass bepaalt welke klassen dat zijn. Bij FALSE boekt elke verandering naar een klasse met een lager maximum af, ook een verandering die alleen de begroeiing betreft.

											Waarom dit nodig is: de startvoorraad komt uit de bodemkoolstofkaart van de bovenste 30 cm, terwijl het klassemaximum een totaal van bodem en biomassa uit de kengetallentabel is. Die twee zijn niet vergelijkbaar en de kaart ligt op ongeveer tweederde van het areaal boven het maximum. Zonder deze schakelaar boekt daardoor elke overgang naar natuur koolstof af die gewoon in de bodem blijft zitten, en telt een deel daarvan bovendien dubbel met de veenoxidatie uit SOMERS_CO2_laagveen.";

	// ----- Vervolg op RSopen #657: de kentallen van team Veen en het veen buiten de SOMERS-percelen -----
	// Drie aannames die nog bij Deltares ter controle liggen. Alle drie staan uit, zodat de lopende uitdraaien niet
	// veranderen; zet ze aan om te meten wat ze doen. De kengetallen zelf staan in Classifications/Grondgebruik/VeenBroeikasgas.
	parameter<Bool>                         Koolstof_VeenVastleggingUitBouwstenen  := FALSE, Descr = "Gebruik op veen- en moerige bodem de vastleggingskentallen van team Veen voor de veenvormende klassen, in plaats van de generieke Cseq_ha uit de koolstofklassentabel (#657).

											Waarom dit nodig is. Team Veen geeft voor de veenvormende bouwstenen een netto opname van 3 tot 7 ton CO2 per hectare per jaar; de koolstofklassentabel komt op dezelfde samenstelling niet verder dan 0,4 tot 2,7. Zie Classifications/Grondgebruik/NbSVeen/Vergelijking. Op de veenbodem is dat verschil bovendien geen kwestie van het kental alleen: de voorraad uit de bodemkoolstofkaart ligt daar rond 169 ton C per hectare, ver boven het klassemaximum van 55 van Riet en watervegetatie, waardoor min_elem in Groei_ha nooit ruimte ziet en de vastlegging op precies die klasse hoe dan ook nul blijft. Deze schakelaar zet daarom zowel het kental als het maximum om.

											De aanname erachter is dat veenvorming koolstof toevoegt in plaats van naar een plafond toegroeit: de vegetatie maakt nieuwe bodem. Dat is de reden dat Hoogveen in de tabel al een maximum van 930 draagt en de rietklasse niet.";
	parameter<Bool>                         Koolstof_OxidatieBuitenSOMERS          := FALSE, Descr = "Boek ook veenoxidatie op de veen- en moerige gronden die buiten de SOMERS-veenweidepercelen liggen, met de emissiefactoren die Deltares op 31-08-2026 in #657 heeft aangeleverd (EF_low_nl_2025.csv).

											Gemeten omvang van het gat: 231.783 ha veen en moerige grond buiten de percelen waarop SOMERS rekent, waar RSopen op dit moment nergens oxidatie boekt. Daarvan ligt 92.613 ha in laag Nederland en 139.170 ha in hoog Nederland; zie Diagnose657.

											Twee dingen om te weten voordat je hem aanzet. De factor is een enkel getal per bodemtype zonder grondwaterstand, dus hij verandert het niveau van de landelijke balans en niet het verschil tussen de varianten, behalve waar het landgebruik naar water of bebouwing gaat. En de factoren gelden voor laag Nederland; voor hoog Nederland heeft Deltares laten weten dat ze niet representatief zijn, vandaar de aparte schakelaar hieronder.";
	parameter<Bool>                         Koolstof_OxidatieBuitenSOMERSOokHoogNL := FALSE, Descr = "Pas de emissiefactoren voor laag Nederland ook toe op hoog Nederland (FALSE laat hoog Nederland op nul). Staat uit omdat Deltares in #657 heeft gemeld dat de factoren van hoog Nederland nog niet representatief zijn en er nog aan gewerkt wordt. Het gaat om 118.689 ha met een niet-stedelijk en niet-waterlandgebruik, oftewel 1,36 Mton CO2 per jaar als je de laag-Nederlandse factoren toch zou gebruiken. Alleen zinvol samen met Koolstof_OxidatieBuitenSOMERS.";
	parameter<Float32>                      Koolstof_EF_Veen_tonCO2_ha_jaar        := 10.59f, Descr = "Emissiefactor voor veengrond buiten de SOMERS-percelen, in ton CO2 per hectare per jaar. Uit EF_low_nl_2025.csv, aangeleverd door Deltares op 31-08-2026 bij #657: 1,059 kg CO2 per m2 per jaar voor elke landlaag op veen behalve de wateren. Ter vergelijking: SOMERS komt in BAU op de veenweidepercelen op gemiddeld 12,1 ton per hectare per jaar uit, dus dit is een BAU-achtig niveau en geen vernattingsniveau.";
	parameter<Float32>                      Koolstof_EF_Moerig_tonCO2_ha_jaar      := 11.96f, Descr = "Idem voor de moerige gronden, uit dezelfde tabel: 1,196 kg CO2 per m2 per jaar. Dat de moerige gronden hoger staan dan de veengronden is wat de aangeleverde tabel zegt; het is niet nagevraagd.";
	parameter<Bool>                         Koolstof_EFStedelijkOpNul              := TRUE, Descr = "Houd het stedelijk gebied op de veenbodem buiten de SOMERS-percelen op nul uitstoot (TRUE), of pas de emissiefactor ook daar toe (FALSE)?

											Dit is een openstaande tegenspraak. Deltares heeft op 27-08-2026 in #657 bevestigd dat stedelijk gebied geen CO2-uitstoot heeft en ook geen restemissie, en die nul staat als aanname bij ModelParameters/Landbouw/CO2_Uitstoot_StedelijkGebruik. De tabel van 31-08-2026 geeft panden, erven, openbare ruimte en stedelijk groen op veen daarentegen dezelfde 1,059 als de percelen. Tot dat is uitgezocht houden we de eerdere bevestiging aan. Het gaat om 31.801 ha in laag Nederland, oftewel ongeveer 0,34 Mton CO2 per jaar.";

	parameter<Bool>                         Methaan_Meetellen                      := TRUE, Descr = "Reken de methaanuitstoot uit natte veenbodems mee als aparte indicator (#657). Dit is een toevoeging en geen wijziging: de bestaande CO2-indicatoren veranderen er niet van.

											Waarom dit erbij hoort. Team Veen geeft in dezelfde tabel waaruit de bouwstenen komen naast een CO2-kental ook een methaankental per bouwsteen, en dat tweede getal is het grootste. In de eindtoestand 2120 komt de CO2-balans van het veengebied volgens die tabel op ongeveer nul uit, terwijl er 3,1 Mton CO2-equivalent per jaar aan methaan tegenover staat. Het gat heeft bovendien richting: de varianten die het meeste veen vernatten scoren op CO2 het beste en hebben tegelijk de meeste natte hectares. Zolang het model alleen CO2 telt, leest dat als een schoon resultaat.

											De kentallen staan in Classifications/Grondgebruik/VeenBroeikasgas. Zie de indicator Methaan voor wat er wel en niet in zit; sloten en de methaan van natte natuur buiten de veenbodem ontbreken.";

	// ===== VERDISCONTERING VAN DE KOSTEN- EN WAARDE-INDICATOREN (#651) =====
	// De landelijke MKBA-richtlijn schrijft sinds 1 januari 2026 een termijnstructuur voor: een eerste discontovoet
	// tot en met horizon 35 jaar en een tweede daarna. Beide zijn reeel, dus bij constante prijzen, wat aansluit op
	// het model: alle bedragen staan in prijzen van het basisjaar. Bron: Rapport Werkgroep discontovoet 2025,
	// versie 1.00 van 19 september 2025, kabinetsreactie en inwerkingtreding per 2026-01-01. De standaardvoeten zijn
	// opgebouwd uit een risicovrije component van 0,0 procent plus een risico-opslag van 2,8 respectievelijk 1,8 procent.
	//   https://www.rwseconomie.nl/discontovoet
	//   https://open.overheid.nl/documenten/43d845b2-d837-4e34-9a46-dffe460e043a/file
	// De richtlijn kent ook een lage variant (2,2 en 1,4 procent) voor onvermijdbare vaste kosten zonder alternatieve
	// aanwending en een hoge variant (4,2 en 2,7 procent) voor baten die sterk met de conjunctuur meebewegen. Welke
	// variant per indicator hoort is een inhoudelijke keuze die nog met Deltares en PBL te maken is; hier staat de
	// standaardvariant. Voor natuur bestaat aparte PBL-guidance die hier nog niet is verwerkt.
	parameter<Float32>   Discontovoet_TotHorizonGrens  := 0.028f, Descr = "Eerste discontovoet: geldt voor kosten en baten tot en met DiscontoHorizonGrens jaar na het basisjaar. Reeel, standaardvariant uit het Rapport Werkgroep discontovoet 2025.";
	parameter<Float32>   Discontovoet_NaHorizonGrens   := 0.018f, Descr = "Tweede discontovoet: geldt voor de jaren daarna. Reeel, standaardvariant uit het Rapport Werkgroep discontovoet 2025. Dat de voet na 35 jaar daalt is precies waarom dit voor NL2120 uitmaakt: bij een vlakke 2,8 procent zou een euro in 2120 nog 6,9 cent waard zijn, met de termijnstructuur 12,6 cent. Voor 2060 maakt het weinig uit, 36,0 tegen 36,7 cent.";
	parameter<jaar>      DiscontoHorizonGrens          := 35[jaar], Descr = "Horizon waarop de richtlijn van de eerste naar de tweede discontovoet overgaat, geteld vanaf het eerste jaar waarin kosten of baten optreden. Dat eerste jaar is hier Model_StartYear.";
	parameter<Bool>      VerdisconteerIndicatoren      := TRUE, Descr = "Staat de verdiscontering aan? Op FALSE blijft elke NCW-indicator gelijk aan zijn nominale tegenhanger, want de factor is dan 1. Bedoeld om het effect van de verdiscontering zichtbaar te maken zonder twee runs te hoeven vergelijken.
																						Raakt de funderingsschade NIET: die werd voor #651 al verdisconteerd, en dezelfde formule staat in Suitability_Wonen_perOP_T en dus in de allocatie. Een rapportageknop hoort de allocatie niet te verzetten.";

	parameter<String>    IndicatorRegio_ref            := 'NL'
	, Descr = "Op welke regio-indeling de indicatoren aggregeren. Een keuze, geldig voor alle indicatoren tegelijk (#658). Opties: NL, Provincie, COROP, Gemeente, NVM, Landschap.

											Landschap is de vijfdeling kust, rivieren, veen, zand en overig uit #705, zodat een tabel per landschapsteam optelt. Zie SourceData/Landschap/LandschapsRegio voor de afbakening.

											Hiervoor stond de indeling elf keer los in de indicatorensjablonen, meestal op Provincie en soms op Provincie/StudyArea, waardoor een tabel per indicator een andere doorsnede kon geven. Nu leest elk sjabloon IndicatorRegio_path hieronder.

											De keuze raakt uitsluitend de tabellen. De grids staan er altijd op celniveau naast en veranderen niet mee, en de _Per_NL-parameters bij de indicatoren zijn altijd het landelijke totaal. Claimrealisatie valt hier bewust buiten: die aggregeert per definitie op de allocatieregio van de sector, want daar wordt de claim ook opgelegd.

											Voor de productierun van #658 staat dit op NL: een tabel van een regel, met alle indicatoren als kolom naast elkaar. Zet hem op Provincie om weer een regionale doorsnede te krijgen. Een fijnere indeling dan Gemeente maakt de tabellen groot en de gemiddelden dun bezet; NVM is de indeling waarop de wonen-claim wordt opgelegd en is daarom handig naast de claimrealisatie.";

	parameter<String>    IndicatorRegio_path           := switch(
			  case(IndicatorRegio_ref == 'NL',        '/SourceData/RegioIndelingen/NL')
			, case(IndicatorRegio_ref == 'Provincie', '/SourceData/RegioIndelingen/Provincie/StudyArea')
			, case(IndicatorRegio_ref == 'COROP',     '/SourceData/RegioIndelingen/COROP/StudyArea')
			, case(IndicatorRegio_ref == 'Gemeente',  '/SourceData/RegioIndelingen/Gemeente')
			, case(IndicatorRegio_ref == 'NVM',       '/SourceData/RegioIndelingen/NVM')
			, case(IndicatorRegio_ref == 'Landschap', '/SourceData/Landschap/LandschapsRegio')
			, ''
		)
	, IntegrityCheck = "this != ''"
	, Descr = "Het pad achter IndicatorRegio_ref. De indicatorensjablonen zetten hier hun unit Regio op, met een =-expansie. Elke indeling die hier bij kan komen moet name en Per_AdminDomain hebben; die twee gebruiken de sjablonen. Een geometry is sinds #705 niet meer nodig: de waterbergingstabel leidt zijn blokindeling met modus uit Per_AdminDomain af, zodat ook een rasterindeling als Landschap kan meedoen. Provincie en COROP wijzen naar hun StudyArea-selectie, zodat een run op een kleiner studiegebied geen lege regels oplevert. Een lege uitkomst betekent een onbekende naam in IndicatorRegio_ref en laat de IntegrityCheck hier vallen.";

	// --- BAG-nieuwbouw (#703) ---
	parameter<uint32> MaxLeeftijdPijplijn := 5
	, Descr = "Hoeveel jaar oud een voorkomen met de status gevormd, bouw gestart of bouwvergunning verleend hoogstens mag zijn om nog als pijplijn mee te tellen. Gerekend vanaf BAG_RecentYear, dus met de waarde 5 en BAG_RecentYear 2026 tellen voorkomens vanaf 1 januari 2021 mee.

				De route NaRecentJaarWelActief telde tot #703 elk voorkomen mee dat op de peildatum die status droeg, ongeacht ouderdom. Een bouwvergunning uit 2012 die nooit tot bouw kwam draagt die status nog steeds en kwam dus als toevoeging aan de startsituatie in de boeken, zonder dat er een route bestaat die hem er ooit weer uit haalt.

				De grens is empirisch bepaald op de jaargang 20260710. Van de 312.969 verblijfsobjecten die op 1 januari 2026 de status gevormd dragen komt 40,5 procent uit 2025, 31,2 uit 2024 en 12,7 uit 2023; vanaf 2021 terug zakt elk jaar onder de 3,5 procent en blijft dalen. Bij de 135.087 panden met bouw gestart of bouwvergunning verleend is het beeld hetzelfde: 62,0 procent uit 2025 en 20,6 uit 2024. De verdeling knikt dus rond vier tot vijf jaar terug, en dat is ook waar de bouwtijd van een normaal project ophoudt.

				Met de waarde 5 valt 3,7 procent van de verblijfsobjecten af, goed voor 5,2 procent van hun gebruiksoppervlak, en 4,6 procent van de panden. Op 0 komt het gedrag van voor #703 terug, want dan geldt er geen ondergrens.";

	parameter<int32>  PijplijnOndergrensDatum := MaxLeeftijdPijplijn == 0 ? 0i : int32((/ModelParameters/BAG_RecentYear - MaxLeeftijdPijplijn) * 10000 + 101)
	, Descr = "De ondergrens als BAG-datum, dus jjjjmmdd. Op 0 doet de toets niets, want elke begindatum ligt daarboven.";

	parameter<Bool> LogistiekePijplijnHeuristiek := FALSE
	, Descr = "Typeer panden in aanbouw of vergund als logistiek op pandkenmerken, zonder LISA-banen (#703). De LISA-afgeleide aanvulling (BAG_LogistiekDynamisch) kan een pand pas als logistiek herkennen zodra er een vestiging met banen zit, dus de hele logistieke pijplijn telt als Nijverheid; de pijplijnterm van logistiek is exact nul terwijl er wel distributiecentra in aanbouw zijn.
				De heuristiek: status bouw gestart of bouwvergunning verleend, voetafdruk vanaf LogistiekePijplijn_MinFootprint, ligging op een IBIS-werklocatie (jaargang ModelParameters/IBIS_Year), en niet hoger dan LogistiekePijplijn_MaxHoogte_cm.
				Staat op FALSE op grond van de validatie in Diagnose667/D703: op de gerealiseerde nieuwbouw vanaf het modeljaar, waar de LISA-typering als waarheid beschikbaar is, haalt de heuristiek wel 85 procent van het logistieke oppervlak binnen maar is de precisie 43 procent, en die precisie is vlak over elke voetafdrukdrempel van 2.500 tot 20.000 m2. Grootte plus IBIS-ligging onderscheidt een distributiecentrum dus niet van een productiehal. Aanzetten verplaatst daardoor evenveel oppervlak ten onrechte naar Logistiek als er nu ten onrechte in Nijverheid staat, en omdat logistiek per m2 ongeveer twee keer zoveel banen draagt, zou het de banen uit de pijplijn per saldo verhogen. De vertekening herstelt zichzelf bovendien: zodra een centrum oplevert en LISA er banen ziet, schuift het bij de volgende jaargang naar logistiek.";
	parameter<m2PandFootprint> LogistiekePijplijn_MinFootprint := 2500[m2PandFootprint]
	, Descr = "Ondergrens op de pandvoetafdruk, gelijk aan MinFootprint_Leeg uit de LISA-aanvulling: dat is daar de drempel voor panden zonder eigen vestiging, en een pand in aanbouw heeft per definitie nog geen vestiging.";
	parameter<float32> LogistiekePijplijn_MaxHoogte_cm := 2500f
	, Descr = "Bovengrens op de AHN-pandhoogte in centimeters, dus 25 meter. Panden zonder hoogte tellen als laag genoeg, via een expliciete IsDefined-toets: de AHN-jaargang is het modeljaar, dus panden in aanbouw missen er vrijwel altijd in, en null vergelijkt in GeoDMS naar FALSE en niet naar null.";

}
