//
// De parameters van de indeling in pendelregio's en stadregio's, die BaseData/RegioIndelingen/PendelregioIndeling afleidt (#392).
//
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container PendelregioIndeling
: Descr = "De parameters van de indeling in pendelregio's en stadregio's (#392). Ze volgen de methode voor functional urban areas van de Europese Commissie, het JRC en de OECD, met de drempels van die methode; de indeling zelf staat in BaseData/RegioIndelingen/PendelregioIndeling."
{
	parameter<String>  Pendel_filedate       := '20261123', Descr = "Welke levering van de CBS-tabel 85481NED, banen van werknemers van woon- naar werkgemeente, de indeling leest: de datum in de naam van het bestand onder %RSo_DataDir%/Actoren/Pendel/.";
	parameter<UInt32>  Pendel_EersteJaar     := 2023, Descr = "Het eerste jaar van de pendel waarover gemiddeld wordt. In 2023 en 2024 is de gemeente-indeling van de pendel gelijk aan die van RegioIndelingen_CBSjaar; eerdere jaren hebben gemeenten van voor een herindeling.";
	parameter<UInt32>  Pendel_LaatsteJaar    := 2024, Descr = "Het laatste jaar van de pendel waarover gemiddeld wordt; de stand in december van elk jaar.";
	parameter<String>  Vierkant_Jaar         := '2023', Descr = "Het jaar van de CBS-vierkantstatistiek van 100 meter waaruit de inwoners en woningen per gemeente en per vierkant van 1 km komen.";
	parameter<Float64> Centrum_Dichtheid     := 1500d, Descr = "Inwoners per vierkant van 1 km waarboven een vierkant bij een stedelijk centrum hoort (Degree of Urbanisation).";
	parameter<Float64> Centrum_MinInwoners   := 50000d, Descr = "Het kleinste aantal inwoners van een aaneengesloten stedelijk centrum (Degree of Urbanisation).";
	parameter<Float64> Stad_Aandeel          := 0.5d, Descr = "Het deel van de inwoners van een gemeente dat in een stedelijk centrum woont om stad te zijn.";
	parameter<Float64> Pendel_Drempel        := 0.15d, Descr = "Het deel van de werkende inwoners dat naar een stad pendelt om erbij te horen, voor een gemeente bij een stad en voor twee steden onderling.";
	parameter<Float64> Buur_Afstand          := 10d, Descr = "De buffer in meter om de gemeentegrenzen waarbinnen twee gemeenten buren zijn; zo tellen ook gemeenten die elkaar alleen in een punt raken.";
	parameter<UInt32>  AantalRondes_Pendelzone := 3, Descr = "Het aantal rondes waarin een pendelzone losliggende delen verliest en ingesloten gemeenten erbij krijgt.";
	parameter<UInt32>  AantalRondes_Buren    := 25, Descr = "Het grootste aantal rondes waarin een gemeente buiten een regio naar een buurregio gaat. Een controle in de indeling eist dat de laatste ronde niets meer verandert, dus een te laag aantal valt op.";
}
