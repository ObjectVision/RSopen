container Piekbuiberging
: Descr = "Parameters van de indicator piekbuiberging (Templates/Indicatoren/Piekbuiberging.dms en de container Piekbuiberging in Templates/Indicatoren_T/Basisjaar.dms). De lezers daar dragen de toelichting per waarde; hier staan de waarden bij elkaar zodat ze in de metadata-export van een levering verschijnen (ExportSettings.dms)."
{
	parameter<string>  Grid_ref                           := '500m', Descr = "De blokmaat waarop opgave en aanbod tegen elkaar worden weggestreept: 100m of 500m. Toelichting en gevoeligheid bij de lezer in Basisjaar.dms.";
	parameter<string>  Kans_ref                           := '1000', Descr = "Welke van de twee dieptekaarten de opgave levert: 1000 (140 mm in 2 uur, herhalingstijd ongeveer 1000 jaar) of 100 (70 mm). Toelichting bij de lezer in Basisjaar.dms.";
	parameter<bool>    OpbouwBestaandGebied               := TRUE, Descr = "Tijdprofiel voor het aanbod in bestaand gebied (#746): TRUE laat het lineair oplopen van nul in het basisjaar naar de volle fractie in OpbouwEindjaar, op verzoek van Deltares; op FALSE geldt de fractie die 2050 in haar naam draagt al volledig in het eerste zichtjaar. Toelichting bij de lezer in Basisjaar.dms.";
	parameter<uint32>  OpbouwEindjaar                     := 2050, IntegrityCheck = "this > uint32(Model_StartYear)", Descr = "Het jaar waarin het aanbod in bestaand gebied volledig is wanneer OpbouwBestaandGebied aanstaat; komt uit de naam van de fracties FractieGroenDakBestaandeBouwIn2050 en FractieBlauwDakBestaandeBouwIn2050. De controle houdt hem boven het basisjaar, want de noemer van de tijdfactor is een uint32-verschil en zou anders stil omslaan.";
	parameter<float32> AandeelWijkwegInOpenbareVerharding := 0.50f
	, IntegrityCheck = "this >= 0f && this <= 1f"
	, Descr = "Welk deel van de openbare verharding in een nieuwe wijk rijbaan is (#757). Nodig omdat het ontwikkelpakket de openbare verharding als een getal geeft en geen rijbaan apart kent, terwijl de
				holle weg een maatregel op de rijbaan is en de halfverharding op alles. De 0,50 is de verhouding tussen rijbaan en halfverhardbaar oppervlak in de BGT-capaciteitskaarten, een landelijk
				gemiddelde van de bestaande stad als proxy voor een nieuwe wijk. Gelezen door Templates/Indicatoren/Piekbuiberging/Aanbod/WaarAllocatieHeeftPlaatsgevonden.dms, container OpVerhardOpenbaar
				bij wonen en in de template daaronder.", Source = "BGT-capaciteitskaarten, rijbaan lokale weg plus OV-baan tegenover halfverhardbaar oppervlak";

	parameter<Bool> KostenInExploitatiesaldo := TRUE
	, Descr = "Telt de aanlegkosten van de piekbuibergingsmaatregelen mee in het exploitatiesaldo van een ontwikkelpakket (#798)? Op TRUE stuurt de post de allocatie, op verzoek van Deltares: een pakket
				met veel blauwe daken en wadi's wordt duurder dan hetzelfde pakket zonder, en dat verschilt per variant omdat de fracties in VariantK per variant staan; de post is van dezelfde orde als het
				exploitatiesaldo zelf. Op FALSE telt de indicator (Templates/Indicatoren/Piekbuiberging.dms, container Kosten) de kosten nog wel, maar weegt de allocatie ze niet. Gelezen door
				Templates/Suitabilities/Suitability_Wonen_perOP_T.dms; alleen wonen kent een exploitatiesaldo, bij werken tellen de maatregelen alleen in de indicator.";

	parameter<float32> OpslagIndirecteKosten := 0.15f
	, IntegrityCheck = "this >= 0f && this < 1f"
	, Descr = "Opslag op de aanlegkosten van de maatregelen waarvan het kental van team Stad komt (#798): die levering geeft kale aanlegkosten per m2 en noemt bouwplaatskosten en planuitwerking als aparte
				posten van elk 5 tot 10 procent, dus tweemaal het gemiddelde van die bandbreedte. Classifications/WaterretentieK/OpslagIndirecteKosten zegt per maatregel of hij van toepassing is; de
				bedragen van de Deltares-wiki zijn inclusief graafwerk en bestrating en krijgen de opslag niet.", Source = "260706_kengetallen_NL2120.xlsx van team Stad (#798)";

	container Dakvorm
	: Descr = "Proxy voor de dakvorm van panden (#746). Team Stad van Deltares besloot dat een blauw dak alleen op een plat dak mag en dat een groen dak op een schuin dak niets bergt. De BAG kent geen
				dakvorm, dus de vorm volgt uit het pandtype van het model: een meergezinspand en een werkpand gelden als plat, een eengezinspand en een verblijfsrecreatiepand als schuin. Een aanname en geen
				waarneming; het daktype per pand uit 3D BAG (b3_dak_type) zou beter zijn maar zit niet in de brondata. Drie lezers: Templates/Indicatoren/Piekbuiberging/Aanbod.dms (bestaand gebied),
				Aanbod/WaarAllocatieHeeftPlaatsgevonden.dms container Wonen (woningtype van het pakket, of de woningtelling bij BAG-nieuwbouw) en de template WerkenEnVerblijfsrecreatie daarin."
	{
		attribute<float32> FractiePlatDak (/Classifications/Vastgoed/WP2) : [0.00, 1.00]
		, IntegrityCheck = "all(this >= 0f && this <= 1f)"
		, Descr = "Aandeel van het dakoppervlak dat plat is, per woningtype in de volgorde van WP2: eengezins 0, meergezins 1. Positioneel, dus de volgorde van Classifications/Vastgoed/WP2 is leidend.";
		parameter<float32> FractiePlatDakWerken := 1.00f
		, IntegrityCheck = "this >= 0f && this <= 1f"
		, Descr = "Aandeel van het dakoppervlak van werkpanden dat plat is. In bestaand gebied is dat de hele werkfootprint uit de BAG, inclusief de logiespanden die via Ov_consumentendiensten onder werken vallen.";
		parameter<float32> FractiePlatDakVerblijfsrecreatie := 0.00f
		, IntegrityCheck = "this >= 0f && this <= 1f"
		, Descr = "Aandeel van het dakoppervlak van nieuwe verblijfsrecreatie dat plat is. Recreatiewoningen en chalets hebben overwegend een schuin dak, en het dak van zo'n cel is bovendien een vast kental van 4,3 procent van de cel (ModelParameters/Verblijfsrecreatie), dus hier staat nul. Alleen de nieuwbouwtak leest dit; in bestaand gebied zit de logiesfootprint in werken.";
	}
}
