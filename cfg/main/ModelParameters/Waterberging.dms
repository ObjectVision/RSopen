container Waterberging
: Descr = "Parameters voor de waterberging-geschiktheid, zie BaseData/Suitabilities/Waterberging."
{
	parameter<meter>   Minimum_Waterschijf    := 1[meter], Descr = "De waterschijf (diepte) van een waterbergingsgebied moet minimaal deze waarde zijn. Cellen die dat niet halen worden in de zeef uitgesloten (Templates/Beschikbaarheden/Zeef_T/Impl/TeOndiepVoorWaterberging) en krijgen daarnaast geschiktheid 0. Alleen die geschiktheid van 0 volstaat niet, want de allocatie maakt daar undefined van en undefined sorteert vooraan, waardoor zulke cellen onderaan de rangorde komen maar niet uitgesloten zijn.";
	parameter<meter>   Maximum_Waterschijf    := 10[meter], Descr = "En hoogstens deze waarde. Boven deze diepte is de waarde in de dieptekaart geen bergingsschijf meer maar het waterlichaam dat er al ligt: van de cellen boven de tien meter is 41 procent water volgens BBG 2022 (overig binnenwater, Rijn en Maas, recreatief binnenwater, binnenwater voor delfstofwinning) en de mediane diepte is 11,4 meter. Zulke cellen krijgen geen diepte, dus geen geschiktheid en geen bergingscapaciteit.
																		Deze grens stond tot #665 als een kale 10 in SourceData/Water.dms op de dieptekaart zelf, waar ook de zeef en de overstromingsschade uit lezen. Dat was de plek van de fout, niet de grens zelf: zie de Descr bij SourceData/Water/Dieptekaart. Tien meter is bovendien een ruwe invulling van wat in #394 als een waterschijf van 1 tot 2 meter is aangedragen en toen is blijven liggen; wie die eis alsnog wil, verlaagt deze parameter.";

	parameter<float32> Kwel_AfkapBoven        :=  2f, Descr = "Afkapgrens in mm/d: meer kwel dan deze grens weegt niet extra positief mee in de geschiktheid. Voorlopige waarde; definitieve afkapgrenzen volgen bij de definitieve kwel-wegzijgingskaart (Deltares).";
	parameter<float32> Wegzijging_AfkapOnder  := -2f, Descr = "Afkapgrens in mm/d: sterkere wegzijging dan deze grens weegt niet extra negatief mee in de geschiktheid. Voorlopige waarde; definitieve afkapgrenzen volgen bij de definitieve kwel-wegzijgingskaart (Deltares).";

	parameter<bool>    GeschiktheidGeclusterd := TRUE, Descr = "Rangschikt de allocatie op de geschiktheid van de omgeving in plaats van die van de losse cel, door de geschiktheid eerst te middelen over een schijf met straal ClusterPotentiaal. Zonder deze stap kiest de zaaglijn de losse toppen van het geschiktheidsoppervlak, en die liggen verspreid; de toets op minimale clusteromvang gooit ze daarna weg. Zie ObjectVision/RSopen#575.";
	parameter<string>  ClusterPotentiaal      := '100m', Descr = "Straal waarover de geschiktheid gemiddeld wordt als GeschiktheidGeclusterd aanstaat. Een schijf van 100 meter is 3,1 ha en dekt daarmee de Minimum_alloc_group_size_Waterberging van 2 ha ruim. Kleiner dan de minimumcluster heeft geen zin, want dan blijven er nog steeds te kleine groepen boven de zaaglijn uitkomen.";

	parameter<string>  MeerNabijPotentiaal    := '1000m', Descr = "Reikwijdte van het afstandsverval rond bestaande meren. Vrij scherp gekozen, tbv clustering van waterberging rond bestaand water.";
	parameter<string>  VeenNabijPotentiaal    := '5000m', Descr = "Reikwijdte van het afstandsverval rond veengebieden, zodat waterberging zoveel mogelijk nabij het veen landt.";

	unit<UInt8> Claims: NrOfRows = 9
	, Descr = "Benodigde waterberging per waterbergingsregio, aangeleverd door Deltares (ObjectVision/RSopen#575). Eenheid is m3 per maand, berekend voor de maand juli. De tabel is niet variantspecifiek: hij bevat alle aangeleverde kolommen. Welke kolom een RS-variant gebruikt bepalen VariantK/WaterbergingClaimBron en VariantK/WaterbergingOpBestaandWater. De aangeleverde waarden hebben meer decimalen dan hier staan; ze zijn afgerond op hele m3, ruim binnen de precisie van float32 bij deze ordegrootte. De restregio staat op 0: buiten de veen-deelgebieden is er geen opgave."
	{
		attribute<String> Deelgebied:
		[
			'0. Rest van Nederland'         ,
			'1. Friesland-Groningen'        ,
			'2. Wieden-Weerribben'          ,
			'3.1 Veluwe/Utrechtse heuvelrug',
			'3.2 Veluwe/Utrechtse heuvelrug',
			'3.3 Veluwe/Utrechtse heuvelrug',
			'4. Noord-Holland'              ,
			'5. Randstad-Groene Hart'       ,
			'6. Rivierengebied'             
		], Descr = "Sleutel voor de koppeling aan RegioIndelingen/Waterbergingsregio/label. Moet exact overeenkomen met het veld naam in shapes_deelgebieden_veen.shp, plus de restregio.";
		
		attribute<meter3> Nieuw_BAU_Y2050        : [       0, 45602243,   946606,    76236,  2347696,  1078759, 10372440, 39022826, 37590883], Descr = "Benodigde waterberging in 2050 in variant BAU1, zonder peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> Nieuw_BAU2_Y2050       : [       0, 63324476,  3095441,   982032,  5726229,  1442932, 13518614, 43283690, 59212337], Descr = "Benodigde waterberging in 2050 in variant BAU2, zonder peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> Nieuw_BAU_Y2100        : [       0, 46180876,  2453062,   862589,  2804673,   705316, 11725177, 40779444, 48796513], Descr = "Benodigde waterberging in 2100 in variant BAU1, zonder peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> Nieuw_BAU2_Y2100       : [       0, 67784300,  3004129,  1401502,  6343234,  1136661, 13968940, 45629454, 69623479], Descr = "Benodigde waterberging in 2100 in variant BAU2, zonder peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> OokBestaand_BAU_Y2050  : [       0, 12246181,        0,        0,  2015446,        0,  1865284, 23220045, 22766665], Descr = "Benodigde waterberging in 2050 in variant BAU1, met 15 cm peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> OokBestaand_BAU2_Y2050 : [       0, 29968413,        0,        0,  5393979,        0,  5011457, 27480909, 44388118], Descr = "Benodigde waterberging in 2050 in variant BAU2, met 15 cm peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> OokBestaand_BAU_Y2100  : [       0, 12824814,        0,        0,  2472423,        0,  3218021, 24976663, 33972294], Descr = "Benodigde waterberging in 2100 in variant BAU1, met 15 cm peilopzet op bestaand oppervlaktewater.";
		attribute<meter3> OokBestaand_BAU2_Y2100 : [       0, 34428237,        0,        0,  6010984,        0,  5461784, 29826673, 54799260], Descr = "Benodigde waterberging in 2100 in variant BAU2, met 15 cm peilopzet op bestaand oppervlaktewater.";
	}
}
