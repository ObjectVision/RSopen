container Waterberging
: Descr = "Parameters voor de waterberging-geschiktheid, zie BaseData/Suitabilities/Waterberging."
{
	parameter<meter>   Minimum_Waterschijf    := 1[meter], Descr = "De waterschijf (diepte) van een waterbergingsgebied moet minimaal deze waarde zijn. Locaties met een kleinere diepte krijgen geschiktheid 0.";

	parameter<float32> Kwel_AfkapBoven        :=  2f, Descr = "Afkapgrens in mm/d: meer kwel dan deze grens weegt niet extra positief mee in de geschiktheid. Voorlopige waarde; definitieve afkapgrenzen volgen bij de definitieve kwel-wegzijgingskaart (Deltares).";
	parameter<float32> Wegzijging_AfkapOnder  := -2f, Descr = "Afkapgrens in mm/d: sterkere wegzijging dan deze grens weegt niet extra negatief mee in de geschiktheid. Voorlopige waarde; definitieve afkapgrenzen volgen bij de definitieve kwel-wegzijgingskaart (Deltares).";

	parameter<string>  MeerNabijPotentiaal    := '1000m', Descr = "Reikwijdte van het afstandsverval rond bestaande meren. Vrij scherp gekozen, tbv clustering van waterberging rond bestaand water.";
	parameter<string>  VeenNabijPotentiaal    := '5000m', Descr = "Reikwijdte van het afstandsverval rond veengebieden, zodat waterberging zoveel mogelijk nabij het veen landt.";
}
