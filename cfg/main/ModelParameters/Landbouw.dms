container Landbouw : using = "Classifications/Actor"
{
	parameter<string> Boervariant_name        := replace_value(expand(., '%env:RSO_BOERVARIANT_NAME%')       , 'env:RSO_BOERVARIANT_NAME'       , 'RationeleBoer'); // RationeleBoer, IntermediateBoer, ConservatieveBoer
	parameter<string> BeregeningScenario_name := replace_value(expand(., '%env:RSO_BEREGENINGSCENARIO_NAME%'), 'env:RSO_BEREGENINGSCENARIO_NAME', 'B2_Beregening_percelenmetinstal_ongelim')
	, Descr = "Welke beregeningsvariant de WWL-schaderelatie gebruikt. Opties: A_GeenBeregening, B1_Beregening_allepercelen_ongelim, B2_Beregening_percelenmetinstal_ongelim.

				De default is B2, en dat is de afspraak uit #542: Deltares heeft daar de beregeningskaart Basisprognoses 2018 aangeleverd, waarin 0 geen beregening is en 1 en 2 allebei wel, uit grondwater respectievelijk oppervlaktewater. B2 is precies die kaart, dus alleen de percelen die in 2018 een installatie hadden.

				Deze parameter stond tot 5 september 2026 op B1 EN werd door niets gelezen; de actieve route las onvoorwaardelijk de kaart van 2018. Het model rekende dus B2 terwijl de parameter B1 zei. Bij het koppelen van de parameter aan de route is de default op B2 gezet, zodat de uitkomst dezelfde blijft als voor die koppeling en gelijk aan wat #542 afspreekt. Wie B1 wil moet dat nu bewust doen; dat verlaagt de opbrengstderving op landbouwgrond met 0,6 tot 5,5 procentpunt, gemeten op zichtjaar 2040 van BAU.

				Wat hier nog NIET in zit, uit dezelfde discussie in #542: bij natte teelten hoort geen beregening. Nu krijgt elke cel de variant die de kaart of het scenario zegt, ook de opgelegde natte teelt."; 

	// Manual ConstGrowthMinMax UndefinedMax
	parameter<Bool>             LandbouwAlleenOpBestaandAreaal            := replace_value(expand(., '%env:RSO_LANDBOUW_ALLEEN_BESTAAND%'), 'env:RSO_LANDBOUW_ALLEEN_BESTAAND', 'TRUE')[bool], Descr = "Mag de landbouwallocatie alleen grond aanraken die in het basisjaar al landbouw was?

				Aan sinds 5 september 2026. De redenering is dat er geen nieuw landbouwareaal bijkomt: stedelijke functies en natuur komen juist IN PLAATS VAN landbouw, dus het areaal kan alleen verliezen. Zonder deze toets is het totaal alleen begrensd door de som van de bovengrenzen per klasse, en die staat op 105 procent van het basisjaar; landbouw zou dan kunnen uitbreiden op elke cel die geen andere sector opeist.

				De bovengrens per klasse blijft wel boven de honderd procent staan, en dat is met opzet: binnen het bestaande areaal kan een gewas wel degelijk groeien ten koste van een ander. Deze schakelaar begrenst het totaal, de bandbreedte begrenst de verschuiving per gewas.

				Zie Templates/Allocatie/Iter_Landbouw_T/Allocatie_Prep/MagLandbouwWorden voor de uitvoering.";

	parameter<Bool>             ClaimVolgtBeschikbareRuimte               := replace_value(expand(., '%env:RSO_CLAIM_VOLGT_RUIMTE%'), 'env:RSO_CLAIM_VOLGT_RUIMTE', 'TRUE')[bool], Descr = "Beweegt de landbouwclaim mee met de ruimte die er in deze variant nog voor landbouw is?

				Dit is het antwoord van Deltares op de derde openstaande vraag in #780: landbouw als geheel is een restclaim, elke gridcel moet in 2120 gevuld zijn, en de LGN-stand van het basisjaar is de gewasverdeling waarop wordt teruggevallen zolang een regio geen gebiedspecifieke opgave voor 2120 levert.

				Staat deze schakelaar aan, dan geeft de claim uit claims_conservatief nog steeds de verdeling over de gewassen, maar schaalt het TOTAAL per allocatieregio naar wat de allocator daar werkelijk aan landbouw kwijt kan. Staat hij uit, dan is de claim een bandbreedte rond het basisjaar die zich niets van de ruimte aantrekt, en haalt een variant die veel landbouwgrond herbestemt de allocatie niet: WLO_hoog_NbSGenuanceerd viel daarop om.

				De uitvoering staat in Templates/Allocatie/Iter_Landbouw_T/Allocatie_Prep/Claims/Restclaim. Die plek is niet toevallig: alleen daar is bekend wat de allocator werkelijk beschikbaar heeft, want daar staat Suitabilities. De claimcontainer zelf kan dat niet zien zonder een kringverwijzing.";

	parameter<Float32>          Krimpmarge                                := 0.98f, Descr = "Hoeveel van de beschikbare ruimte de geschaalde ondergrenzen hoogstens mogen vullen, in Iter_Landbouw_T/Allocatie_Prep/Claims/Restclaim.

				Waarom dit niet 1 is. De toets daar is dat elke klasse haar ondergrens kwijt kan en dat alle klassen samen hun ondergrenzen kwijt kunnen. Die twee zijn samen noodzakelijk maar niet voldoende: dat beide opgaan betekent nog niet dat er een toewijzing bestaat die aan beide tegelijk voldoet, want een cel die voor de ene klasse beschikbaar is hoeft dat voor de andere niet te zijn. Dat is de voorwaarde van Hall, en die toetsen we niet. Daarbovenop rondt de omrekening van hectares naar hele cellen per klasse af.

				De marge grijpt alleen in een regio waar de ondergrenzen niet passen. Past het wel, dan blijft de claim precies staan en verandert er niets; dat is met opzet, want anders zou deze marge ook regio's raken die geen probleem hebben. Gemeten op 7 september 2026, zichtjaar 2040: in WLO_hoog_BAU knijpt hij de krapste provincie tot 0,97 en laat hij de rest ongemoeid, in WLO_hoog_NbSGenuanceerd knijpt hij tot 0,95.

				Zet dit hoger en de allocatie wordt krapper en kan alsnog omvallen; zet het lager en er blijft in de geknepen regio's meer grond over voor de restcategorie NonLandbouw dan het scenario bedoelt.";

	parameter<String>           ClaimVariant                              := 'Manual', Descr = "Kies hier de manier waarop de minimale en maximale claims voor landbouw worden bepaald. Manual: handmatig in te vullen, ConstGrowthMinMax: op basis van een constante groei tov het vorige zichtjaar, UndefinedMax: minimale claims worden handmatig ingevuld, maximale claims zijn onbegrensd (undefined)";
	parameter<Float32>          Landbouw_Claim_Growth                     := 0.20f, Descr = "factor waarmee de max claims voor Landbouw worden bepaald tov prev zichtjaar";
	parameter<jaarlijks>        Rentevoet                                 := 0.055[jaarlijks], Descr = "Rentevoet die wordt gebruikt voor de contante waarde berekeningen";
	parameter<jaarlijks>        Rentevoet_RationeleBoer                   := Rentevoet;
	parameter<jaarlijks>        Rentevoet_IntermediateBoer                := 0.080[jaarlijks]; //TODO: checken met Marnix/Femke
	parameter<jaarlijks>        Rentevoet_ConservatieveBoer               := 0.16[jaarlijks]; //TODO: checken met Marnix/Femke
	parameter<Float32>          ConversionCostPremium_RationeleBoer       := 0.00f; //TODO: checken met Marnix/Femke
	parameter<Float32>          ConversionCostPremium_IntermediateBoer    := 0.20f; //TODO: checken met Marnix/Femke
	parameter<Float32>          ConversionCostPremium_ConservatieveBoer   := 1.00f; //TODO: checken met Marnix/Femke
	parameter<jaar>             afschrijvingsperiode                      := 20[jaar], Descr = "Afschrijvingsperiode voor investeringen in de landbouw (bijv. gewasverandering)";
	parameter<Bool>             Kostenvoet_InclusiefLoonwerk              := FALSE
	, Descr = "FALSE is de definitie van dit model en geen tussenstand: elk saldo in de landbouwgeschiktheid is bruto geldopbrengst min toegerekende kosten bij eigen mechanisatie, dus voor loonwerk, arbeid, machines, gebouwen, grond en rente over levende have. Dat is de enige voet die KWIN Veehouderij (saldo per koe, blz. 149, met loonwerk als aparte regel eronder), KWIN-AGV (toegerekende kosten per gewas, loonwerk in een eigen hoofdstuk) en het BIN (saldo voor werk door derden) alle drie delen. Melkvee: dierposten per koe plus Graslandkosten en Maiskosten zonder loonwerk (KWIN blz. 108 min de 595 loonwerk; KWIN-AGV 885 en 892). Akkerbouw: KWIN-AGV toegerekende kosten. Slootonderhoud, rente over vee en rente over omlopend gewaskapitaal blijven aan beide kanten buiten het saldo; KWIN-AGV rekent die laatste vermoedelijk wel in de toegerekende kosten, de regel wordt bij het lezen van KWIN-AGV 2026 gemeld (orde 50 tot 150 per ha).

				TRUE is een gevoeligheidsstand en mag pas als definitie gelden wanneer beide kanten een volledige loonwerkregel hebben: gras op de voet van KWIN blz. 144 (ploegen, zaaien, mest uitrijden, maaien, wiersen, inkuilen, kunstmest strooien; de norm van blz. 108 telt alleen mest uitrijden, inkuilen en sloten), mais de KWIN-AGV kolom loonwerk in plaats van KWIN blz. 144, en per akkerbouwgewas en bodem de KWIN-AGV kolom loonwerk (poten of zaaien, spuiten, rooien, transport, stro persen bij tarwe). Nu staat de akkerbouwregel Loonwerk op 0 met de Descr ontbreekt, zodat TRUE de akkerbouw ongewijzigd laat en melkvee circa 600 per ha zwaarder zet: dat is precies het definitieverschil dat de opdrachtgever in #780 uitsluit, en daarom staat de schakelaar uit. Gelezen door Dairy_T (Graslandkosten_loonwerk, Maiskosten_loonwerk) en Akkerbouw_T (Loonwerk per gewas).";
	parameter<Float32>          Verzilt_Areaal_Fractie                    := 0.40f, Descr = "xx% van het oppervlak van risico's 2-4 is in de toekomst niet geschikt voor de gewassen: Appelbomen, consumptieaardappelen, laanbomen, tulpen, zaaiuien en zetmeelaardappelen. Deze plekken worden random gekozen"; 
	parameter<Float32>          Verzilt_OpbrengstDerving                  := 1f, Descr = "Mate van effect van verzilting op opbrengsten derving van de gewassen die daardoor worden aangetast."; 
	parameter<Float32>          Verzilt_OpbrengstDerving_Y2030            := 0f, Descr = "Mate van effect van verzilting op opbrengsten derving van de gewassen die daardoor worden aangetast."; 
	parameter<kg_ha_jaarlijks>  CO2_Uitstoot_StedelijkGebruik             := 0[kg_ha_jaarlijks], Descr = "CO2 uitstoot door omzetting van landbouwgrond naar stedelijk gebruik. De nul is bevestigd door Deltares in #657: stedelijk gebied heeft in SOMERS geen veenemissie, ook geen restemissie.";
	parameter<kg_ha_jaarlijks>  CO2_Uitstoot_Water                        := 0[kg_ha_jaarlijks], Descr = "CO2 uitstoot door omzetting van landbouwgrond naar water. De nul is bevestigd door Deltares in #657 en geldt ook voor waterberging, dus ook daar geen restemissie. Let op: uit waterberging en natte natuur komt wel methaan, en dat rekent het model nergens mee.";
	
	parameter<String>           VerziltingsScenario                       := 'Stoom2050', Descr = "Welk verziltingsscenario wordt toegepast. Opties: Stoom2050, Stoom2100";
	
	parameter<Eur_ton> CO2_prijs_minimum: [30], Descr = "Minimale CO2 prijs (in Eur/ton) die wordt gebruikt in de berekening van de contante waarde van CO2 reductie door landbouwgrond om te zetten naar andere functies.";
	parameter<Eur_ton> CO2_prijs_maximum: [80], Descr = "Maximale CO2 prijs (in Eur/ton) die wordt gebruikt in de berekening van de contante waarde van CO2 reductie door landbouwgrond om te zetten naar andere functies.";
	
	attribute<Float32> CO2_Reductie (RegioIndelingen/Provincie) := switch(
		 case(id(Provincie) == Provincie/v/groningen, 0.06f)
		,case(id(Provincie) == Provincie/v/friesland, 0.45f)
		,case(id(Provincie) == Provincie/v/overijssel, 0.10f)
		,case(id(Provincie) == Provincie/v/utrecht, 0.09f)
		,case(id(Provincie) == Provincie/v/noord_holland, 0.09f)
		,case(id(Provincie) == Provincie/v/zuid_holland, 0.21f)
		,null_f
	), Descr = "Indicatieve CO2 (equivalente) reductieopgave per Provincie (in %, totale opgave is 1Mton/jaar t.o.v. 1990). Uit mail DGWB, d.d. 8-5-2025";
	
	container Aanlegkosten_waterinfiltratiesystemen
	: Descr = "actieve (pompgestuurde) systemen. Indicatief, uit mail DGWB, d.d. 8-5-2025", URL = "https://loketveenweideboeren.nl/aanleg-waterinfiltratiesysteem/"
	{
		parameter<Eur_ha> passief_laag := 4000[Eur_ha];
		parameter<Eur_ha> passief_hoog := 5000[Eur_ha];
		parameter<Eur_ha> actief_laag  := 6000[Eur_ha];
		parameter<Eur_ha> actief_hoog  := 7500[Eur_ha];
	}
	
	container claims_conservatief
	: Descr = "De claimvariant die alle vier de varianten in VariantParameters/VariantK/Claim_agrarisch_Variant gebruiken.

				De onder- en bovengrens per landbouwklasse zijn een bandbreedte rond het basisjaarareaal. Tot 5 september 2026 stonden die als zesentwintig met de hand geschreven regels, met 0,95 dertien keer en 1,05 twaalf keer los opgeschreven, plus drie stille uitzonderingen. Nu staan ze als twee parameters met een for_each eroverheen, zodat zichtbaar is dat het om een aanname gaat en niet om zesentwintig.

				WAT DIT IS EN WAT NIET. Dit is een plaatshouder. In #780 staat de bedoelde opzet: regionale arealen en geschiktheidskaarten per gebied, te leveren door team effectbepaling. Zolang die er niet zijn houdt deze bandbreedte het areaal bij het basisjaar in de buurt.

				Hoeveel deze band stuurt is gemeten op 5 september 2026, zichtjaar 2040 van WLO_hoog_BAU, door hem op 0,05 en op 0,25 te zetten. De absolute verschuiving tussen die twee is 263.060 ha, dus 14,9 procent van het gealloceerde areaal: een hectare op de zeven hangt aan dit ene getal.

				De RICHTING van die verschuiving is belangrijker dan de omvang. Bij een ruimere band schuiven de gewassen niet onderling maar verdwijnen ze: elf van de vijftien klassen krimpen en het totaal zakt van 1.762.678 naar 1.508.020 ha. De allocator kiest op die grond liever de restcategorie NonLandbouw dan welk gewas ook, en dat kan maar een ding betekenen: op ongeveer een kwart van het landbouwareaal heeft geen enkel gewas een positieve contante waarde, en de ondergrens is het enige dat daar landbouw neerzet. Boomgaard is de enige klasse die bij loslaten groeit, met twintig procent.

				Wie dit wil repareren moet dus niet aan deze band draaien maar aan de netto-opbrengst. De eerste verdachte is de opbrengstderving: die heeft over het raster een gemiddelde van 0,81, en als dat op landbouwgrond ook zo hoog ligt is de hydrologie de dominante term en niet de prijzen.

				De drie verdwenen uitzonderingen. Ten eerste hadden Cranberry, Yacon en Rijst hun bovengrens van StartYear/Rietteelt in plaats van van zichzelf, want hun eigen basisjaarareaal is nul en dan zou de bovengrens ook nul zijn. Dat is nu Introductieruimte, een expliciete regel voor elk gewas zonder basisjaarareaal. Ten tweede stond Rietteelt op een eigen factor 2,0; die valt nu onder dezelfde Introductieruimte, die ruimer is. Ten derde hadden de drie melkveeklassen een onbegrensde bovengrens, waardoor gg_vee_intensief vanuit nul naar 28.472 ha kon groeien; dat is nu weg, en die klasse heeft sinds dezelfde datum ook een echt basisjaarareaal via Grasland_tijdelijk."
	{
		parameter<Float32> Claimbandbreedte := float32(replace_value(expand(., '%env:RSO_CLAIMBANDBREEDTE%'), 'env:RSO_CLAIMBANDBREEDTE', '0.05'))
		, Descr = "Hoeveel het areaal van een landbouwklasse per allocatieregio mag afwijken van het basisjaar. Bij 0,05 loopt de band van 95 tot 105 procent.

					Dit is de knop voor de gevoeligheidsanalyse, en hij is via de omgevingsvariabele RSO_CLAIMBANDBREEDTE te zetten zodat een reeks geen configwijziging kost, net als bij Boervariant_name. Zet hem op 0,25 en kijk hoeveel de gewasverdeling beweegt. Beweegt hij nauwelijks, dan is de economie zwak en heeft schaven aan kentallen weinig zin. Beweegt hij sterk, dan bepaalt de claim het antwoord en niet het model.";

		parameter<Ha> Introductieruimte := 1000[Ha]
		, Descr = "Bovengrens per allocatieregio voor een EXOTISCH gewas, dus de ruimte die een gewas krijgt om te ontstaan dat in het basisjaar geen areaal heeft. Zonder deze regel is de bovengrens van zo'n klasse nul maal de bandbreedte, dus nul, en kan het gewas nooit verschijnen.

					De vlag is Actor/LandbouwKlasses/IsExotisch, en die staat aan voor Rietteelt, Cranberry, Rijst, Yacon en Moerasbomen. Dat onderscheid is er met opzet. Een klasse die leeg is omdat zij nieuw is hoort ruimte te krijgen; een klasse die leeg is omdat haar invoer is weggevallen hoort dat niet. Dat tweede geldt voor GG_vee_intensief: die berustte op melkkoeien per hectare uit de landbouwtelling 2014, en sinds #751 is de voedergewassenkaart vervangen door de BRP, die geen veedichtheid kent. Zonder deze splitsing zou die klasse hier twaalfduizend hectare per jaar uit het niets kunnen krijgen op vier parameters zonder bronvermelding, en dat is precies het soort getal dat later als modeluitkomst wordt gelezen

					De waarde is een aanname en geen meting. Zij vervangt drie regels die hun bovengrens van riet leenden, wat neerkwam op ongeveer 664 ha landelijk en alleen in de provincies waar al riet stond. Duizend hectare per provincie is twaalfduizend landelijk, dus 0,65 procent van het landbouwareaal: genoeg om een nieuw gewas zichtbaar te maken, te weinig om het beeld te laten kantelen. Wie de exotische gewassen serieus wil doorrekenen zet dit getal bewust hoger en leest eerst de toelichting bij Templates/Landbouw.dms container Exotisch, want de geschiktheid van die gewassen rust op kansenkaarten en niet op een opbrengstcurve.";

		parameter<String> Ondergrens_str    := string(1f - Claimbandbreedte)+'f';
		parameter<String> Bovengrens_str    := string(1f + Claimbandbreedte)+'f';
		parameter<String> Introductie_str   := string(float32(Introductieruimte))+'[ha]';

		container MinClaims_manual :=
			for_each_nedv(
				Classifications/Actor/LandbouwKlasses/name
				, quote('StartYear/'+Classifications/Actor/LandbouwKlasses/name+' * ')+'+Ondergrens_str'
				, void
				, String
			), Descr = "Ondergrens per klasse: het basisjaarareaal maal een min de bandbreedte.";

		container MaxClaims_manual :=
			for_each_nedv(
				Classifications/Actor/LandbouwKlasses/name
				, Classifications/Actor/LandbouwKlasses/IsExotisch
					? quote('max_elem(StartYear/'+Classifications/Actor/LandbouwKlasses/name+' * ')+'+Bovengrens_str+'+quote(', ')+'+Introductie_str+'+quote(')')
					: quote('StartYear/'+Classifications/Actor/LandbouwKlasses/name+' * ')+'+Bovengrens_str'
				, void
				, String
			), Descr = "Bovengrens per klasse: het basisjaarareaal maal een plus de bandbreedte, met de Introductieruimte als vloer zodat een klasse zonder basisjaarareaal kan ontstaan.";
	}
	//"herkomst in rijen, bestemming in kolommen";
	unit<UInt8> Transitiekosten :=
		for_each_nedv(
			Classifications/Actor/LandbouwKlasses/name
			, replace(
				'union_data(Classifications/Actor/LandbouwKlasses, '+asList('Transitiekosten_src/'+Classifications/Actor/LandbouwKlasses/name+'__@Best@', ',')+')',
				'@Best@', Classifications/Actor/LandbouwKlasses/name)
			,Classifications/Actor/LandbouwKlasses
			, Eur_ha
		), Descr = "Transitiekosten matrix, in Eur/ha, per herkomst en bestemming. Herkomst en bestemming zijn de landbouwklassen. De transitiekosten worden gebruikt om de contante waarde van een gewasverandering te berekenen. De transitiekosten worden alleen in rekening gebracht als er daadwerkelijk een gewasverandering plaatsvindt (dus niet bij een claim op hetzelfde gewas). De transitiekosten worden per ha in rekening gebracht. De transitiekosten worden alleen in rekening gebracht als er daadwerkelijk een gewasverandering plaatsvindt (dus niet bij een claim op hetzelfde gewas). De transitiekosten worden per ha in rekening gebracht.";
	
	#include<Gewas_parameters.dms>
	#include<Melkvee_parameters.dms>
	
	container Beleid
	: Descr = "Beleidsankers voor de landbouwgeschiktheid die niet per variant verschillen (#780): de mestprijs van het basisjaar en het subsidiabele aandeel van het natuurlijk grasland. De ankers van de GLB-paden per zichtjaar komen hier in commit 2 van #780 bij; tot dan leest Templates/Landbouw.dms de GLB nog uit de oude kolommen van VariantK."
	{
		parameter<Eur_m3> Mestprijs_basisjaar := 25[Eur_m3]
		, Descr = "Afzetprijs van rundveedrijfmest in het basisjaar, euro per m3. Bron: KWIN Veehouderij 2025-2026 blz. 25, norm middellange termijn 25 euro per m3 bij afzet over lange afstand; korte afstand 12,50 tot 27,50 af boerderij; voorjaar 2025 20 tot 35 euro per ton. Ter vergelijking het BIN, betaald gemiddelde per m3: 12 in 2023, 17 in 2024, 23 in 2025; DCA marginaal 30 tot 38. Status: onderbouwd voor het basisjaar.";

		parameter<Ratio> GLB_factor_extensief := 0.806[Ratio]
		, Descr = "Aandeel van het areaal gg_vee_extensief dat GLB-hectaresteun en eco-regeling ontvangt. METING op de eigen basisjaarkaart, 7 september 2026, BRP 2025 (ModelParameters/BRP_Year) op LGN 2025, via Diagnose/PerIssue/Diagnose780/Metingen/Tabel_Extensief. Van de 1.334.877 cellen gg_vee_extensief draagt 1.075.643 (80,6 procent) BRP-code 331 grasland natuurlijk met landbouwactiviteiten of 1926 agrarisch natuurmengsel; 48.730 (3,7 procent) draagt code 332 grasland natuurlijk met hoofdfunctie natuur; 107.888 (8,1 procent) heeft geen BRP-perceel en komt uit LGN 45; de overige 102.616 (7,7 procent) dragen een BRP-code zonder landbouwklasse, zoals 335 natuurterreinen, en krijgen hun klasse eveneens uit LGN 45. Per bodemtak: klei 0,809, zand 0,790, veen 0,839.

					De lezing erachter: volgens de RVO-gewascodelijst komt 332 niet in aanmerking voor basispremie en eco-regeling en 331 en 1926 wel; voor de cellen zonder BRP-perceel of zonder landbouwcode is de aanname niet subsidiabel, want zonder opgave als subsidiabel landbouwareaal is er geen betaling. Bevestiging van die lezing bij RVO staat als vraag open in #780. Stond in de specificatie op 0,5 als aanname tot de meting. Status: meting.";
	}

	container per_ModelType
	: Descr = "Klasseparameters van de drie melkveeklassen voor Dairy_T (#780). De klassenstructuur blijft in deze ronde staan: gg_vee_extensief is natuurlijk beheerd grasland zonder melkkoeien, gg_vee is productiegrasland met voedergewas, gg_vee_intensief is een plaatshouder zonder basisjaarareaal die per referentie gelijk is aan gg_vee.

				Tot 7 september 2026 stonden hier FCE, MaxYieldGrass, Perc_FeedDryMatter en MilkPricePremium per klasse, zonder bron. Die bleken de index melkproductie per koe (geen voederconversie), de maximale grasproductie, het ruwvoeraandeel in het rantsoen en de biologische melkprijspremie uit PBL 2016, Dalende bodems, stijgende kosten, bijlage 2 tabel B6: een BIN-typologie van het laagveengebied in 2014 op prijspeil 2010. Zij zijn met het voedermodel vervallen; de economie staat nu in Melkvee_parameters.dms. De akkerbouwklassen lezen hier niets meer: de container Akkerbouw met Holding_costs_Ratio 0,208 uit LUS_AgriVali2011 was sinds 5f2b9f93 ongelezen en is weg."
	{
		container gg_vee_extensief
		: Descr = "Natuurlijk beheerd grasland: LGN 45, BRP 331, 332 en 1926. Geen melkkoeien; het gras wordt op stam verkocht tegen Melkvee/Grond/Prijs_natuurgras, geen mais, geen deep drainage; de GLB maal Beleid/GLB_factor_extensief omdat BRP 332 niet subsidiabel is; ontvangt vanaf commit 2 van #780 GLB_Diensten_extensief en op veen de veenvergoeding. De oude MilkPricePremium van 30 euro per ton was de biologische premie uit PBL 2016 tabel B6, toegepast op een klasse die sinds #751 geen biologisch grasland is."
		{
			parameter<Ratio> Koedichtheid_factor  := 0.0[Ratio], Descr = "Nul: op natuurlijk beheerd grasland staan in dit model geen melkkoeien; het gras is ruwvoer voor de markt.";
			parameter<Bool>  IsNatuurlijkGrasland := TRUE, Descr = "Kiest in Dairy_T de opbrengst, de prijs en de kosten van natuurlijk grasland.";
		}

		container gg_vee
		: Descr = "Productiegrasland met voedergewas: LGN 1 en 2, BRP 265 en 266 en de maiscodes. Dichtheid gelijk aan Melkvee/Dichtheid/D_ref."
		{
			parameter<Ratio> Koedichtheid_factor  := 1.0[Ratio], Descr = "Een: de referentiedichtheid van een gemiddelde productiehectare.";
			parameter<Bool>  IsNatuurlijkGrasland := FALSE;
		}

		container gg_vee_intensief
		: Descr = "Plaatshouder zonder basisjaarareaal (#751): de klasse berustte op melkkoeien per hectare uit de landbouwtelling 2014 en de BRP kent geen veedichtheid. Per referentie gelijk aan gg_vee, wordt niet gealloceerd (claim nul, IsExotisch FALSE) en blijft staan om LU_ModelType niet te hernummeren."
		{
			parameter<Ratio> Koedichtheid_factor  := ../gg_vee/Koedichtheid_factor;
			parameter<Bool>  IsNatuurlijkGrasland := ../gg_vee/IsNatuurlijkGrasland;
		}
	}


	container Transitiekosten_src
	{
		parameter<Float32> Indexatie_Diogo2015 := 1.40f
		, Descr = "Prijsindex waarmee de investeringsbedragen van Diogo (2015) naar het prijspeil van 2025 worden gebracht.

					LET OP: dit is een index en geen meting. De bedragen hieronder zijn omschakelkosten per hectare per bedrijfstype uit Diogo (2015), tabel 5, en die zijn elf jaar oud en nooit geindexeerd, terwijl de opbrengstenkant sinds september 2026 op KWIN 2025-2026 staat. Die scheefheid werkt maar een kant op: te lage omschakelkosten maken de drempel te laag en de boer daarmee te beweeglijk, precies de grootheid die de boervarianten juist willen sturen.

					De waarde is de consumentenprijsindex over 2015 tot 2025, ruwweg veertig procent. Twee redenen om hem als voorlopig te lezen. Een algemene prijsindex is niet hetzelfde als een index op landbouwinvesteringen, die in 2021 tot 2023 sterker opliep. En de eigen ijkpunten van dit model wijzen iets hoger: de graslandkosten gingen van 774 in LUS_AgriVali2011 naar 1105 in KWIN 2025-2026, een factor 1,43 over veertien jaar.

					Waar de echte getallen vandaan zouden moeten komen: KWIN-AGV 2026 paragraaf 4.3 en 4.4 geven vervangingswaarden van gebouwen, verhardingen, drainage en werktuigen. Daaruit is per bedrijfstype een omschakelbedrag op te bouwen, maar dat is een eigen klus en geen opzoekactie, want KWIN kent geen kostenpost per bedrijfstype per hectare.";

		container InvestmentCosts : Descr = "Omschakelkosten per hectare per bedrijfstype, uit Diogo (2015), tabel 5, maal Indexatie_Diogo2015. Zie daar waarom die index er staat en waarom hij voorlopig is."
		{
			parameter<Eur_ha> DairyFarming      := 14269[Eur_ha] * Indexatie_Diogo2015;
			parameter<Eur_ha> ArableFarming     :=  7257[Eur_ha] * Indexatie_Diogo2015;
			parameter<Eur_ha> FruitGrowing      := 35858[Eur_ha] * Indexatie_Diogo2015;
			parameter<Eur_ha> FlowerGrowing     := 26254[Eur_ha] * Indexatie_Diogo2015;
			parameter<Eur_ha> TreeNursery       := 35055[Eur_ha] * Indexatie_Diogo2015;
		}
		
		// parameter<Eur_m2> Kosten_urbaan_afbraak              := 311.555209[Eur_m2], Descr = "from PeatyMeadows"; // @Jip deze is overbodig in deze cfg toch, omdat we eerder gealloceerde klassen zoals urbaan op slot zetten bij de alloc van later gealloc klassen zoals Landbouw
		// parameter<Eur_m2> Akkerbouw                          := InvestmentCosts/ArableFarming[Eur_m2];
		// parameter<Eur_m2> Default_min_transitiekosten        := 100[Eur_m2];
		
		// van riet naar...
		parameter<Eur_ha> Rietteelt__Rietteelt               := 0[Eur_ha];
		parameter<Eur_ha> Rietteelt__Akkerbouw               := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rietteelt__Aardappelen             := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rietteelt__Bieten                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rietteelt__Granen                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rietteelt__Cranberry               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Rietteelt__Boomgaard               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Rietteelt__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f; // lijkt me niet zo duur
		parameter<Eur_ha> Rietteelt__Rijst                   := InvestmentCosts/FruitGrowing; // lijjkt me duur om in te richten
		parameter<Eur_ha> Rietteelt__Yacon                   := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rietteelt__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Rietteelt__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Rietteelt__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		// van Akkerbouw naar...
		// Deze rij stond uitgecommentarieerd uit de tijd dat Akkerbouw de verzamelklasse was waar Aardappelen,
		// Bieten en Granen uit zijn gesplitst. Sinds #751 is Akkerbouw de restklasse voor akker- en tuinbouw die
		// het model niet apart noemt, vertegenwoordigd door zaaiuien, en dus een gewone dertiende klasse. De
		// drie regels naar Aardappelen, Bieten en Granen hebben er nooit in gestaan en zijn hier toegevoegd op
		// het bedrag dat de andere overgangen tussen genoemde akkerbouwgewassen ook dragen.
		parameter<Eur_ha> Akkerbouw__Rietteelt               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Akkerbouw__Akkerbouw               := 0[Eur_ha];
		parameter<Eur_ha> Akkerbouw__Aardappelen             := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Akkerbouw__Bieten                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Akkerbouw__Granen                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Akkerbouw__Cranberry               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Akkerbouw__Boomgaard               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Akkerbouw__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Akkerbouw__Rijst                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Akkerbouw__Yacon                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Akkerbouw__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Akkerbouw__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Akkerbouw__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Aardappelen__Rietteelt               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Aardappelen__Akkerbouw               := InvestmentCosts/ArableFarming; // #751: was 0 toen Akkerbouw de verzamelklasse van dit gewas was, nu een gewone gewaswissel
		parameter<Eur_ha> Aardappelen__Aardappelen             := 0[Eur_ha];
		parameter<Eur_ha> Aardappelen__Bieten                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Aardappelen__Granen                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Aardappelen__Cranberry               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Aardappelen__Boomgaard               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Aardappelen__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Aardappelen__Rijst                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Aardappelen__Yacon                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Aardappelen__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Aardappelen__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Aardappelen__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Bieten__Rietteelt               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Bieten__Akkerbouw               := InvestmentCosts/ArableFarming; // #751: was 0 toen Akkerbouw de verzamelklasse van dit gewas was, nu een gewone gewaswissel
		parameter<Eur_ha> Bieten__Aardappelen             := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bieten__Bieten                  := 0[Eur_ha];
		parameter<Eur_ha> Bieten__Granen                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bieten__Cranberry               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Bieten__Boomgaard               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Bieten__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Bieten__Rijst                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Bieten__Yacon                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Bieten__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Bieten__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Bieten__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Granen__Rietteelt               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Granen__Akkerbouw               := InvestmentCosts/ArableFarming; // #751: was 0 toen Akkerbouw de verzamelklasse van dit gewas was, nu een gewone gewaswissel
		parameter<Eur_ha> Granen__Aardappelen             := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Granen__Bieten                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Granen__Granen                  := 0[Eur_ha];
		parameter<Eur_ha> Granen__Cranberry               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Granen__Boomgaard               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Granen__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Granen__Rijst                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Granen__Yacon                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Granen__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Granen__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Granen__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Cranberry__Rietteelt               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Cranberry__Akkerbouw               := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Cranberry__Aardappelen             := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Cranberry__Bieten                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Cranberry__Granen                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Cranberry__Cranberry               := 0[Eur_ha];
		parameter<Eur_ha> Cranberry__Boomgaard               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Cranberry__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Cranberry__Rijst                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Cranberry__Yacon                   := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Cranberry__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Cranberry__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Cranberry__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Boomgaard__Rietteelt               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__Akkerbouw               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__Aardappelen               := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__Bieten                  := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__Granen                  := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__Cranberry               := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Boomgaard__Boomgaard               := 0[Eur_ha];
		parameter<Eur_ha> Boomgaard__Moerasbomen             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__Rijst                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Boomgaard__Yacon                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomgaard__gg_vee_extensief        := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Boomgaard__gg_vee                  := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Boomgaard__gg_vee_intensief        := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Moerasbomen__Rietteelt             := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Moerasbomen__Akkerbouw             := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Moerasbomen__Aardappelen           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Moerasbomen__Bieten                := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Moerasbomen__Granen                := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Moerasbomen__Cranberry             := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Moerasbomen__Boomgaard             := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Moerasbomen__Moerasbomen           := 0[Eur_ha];
		parameter<Eur_ha> Moerasbomen__Rijst                 := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Moerasbomen__Yacon                 := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Moerasbomen__gg_vee_extensief      := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Moerasbomen__gg_vee                := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Moerasbomen__gg_vee_intensief      := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Rijst__Rietteelt                   := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__Akkerbouw                   := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__Aardappelen                 := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__Bieten                      := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__Granen                      := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__Cranberry                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Rijst__Boomgaard                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Rijst__Moerasbomen                 := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__Rijst                       := 0[Eur_ha];
		parameter<Eur_ha> Rijst__Yacon                       := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Rijst__gg_vee_extensief            := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Rijst__gg_vee                      := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Rijst__gg_vee_intensief            := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> Yacon__Rietteelt                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Yacon__Akkerbouw                   := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Yacon__Aardappelen                 := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Yacon__Bieten                      := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Yacon__Granen                      := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Yacon__Cranberry                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Yacon__Boomgaard                   := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Yacon__Moerasbomen                 := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Yacon__Rijst                       := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Yacon__Yacon                       := 0[Eur_ha];
		parameter<Eur_ha> Yacon__gg_vee_extensief            := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Yacon__gg_vee                      := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Yacon__gg_vee_intensief            := InvestmentCosts/DairyFarming;
		
		parameter<Eur_ha> gg_vee_extensief__Rietteelt        := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> gg_vee_extensief__Akkerbouw        := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_extensief__Aardappelen       := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_extensief__Bieten           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_extensief__Granen           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_extensief__Cranberry        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee_extensief__Boomgaard        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee_extensief__Moerasbomen      := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> gg_vee_extensief__Rijst            := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee_extensief__Yacon            := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_extensief__gg_vee_extensief := 0[Eur_ha];
		parameter<Eur_ha> gg_vee_extensief__gg_vee           := InvestmentCosts/DairyFarming * 0.5f;
		parameter<Eur_ha> gg_vee_extensief__gg_vee_intensief := InvestmentCosts/DairyFarming * 0.75f;
		
		parameter<Eur_ha> gg_vee__Rietteelt                  := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> gg_vee__Akkerbouw                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee__Aardappelen                := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee__Bieten                     := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee__Granen                     := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee__Cranberry                  := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee__Boomgaard                  := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee__Moerasbomen                := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> gg_vee__Rijst                      := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee__Yacon                      := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee__gg_vee_extensief           := 0[Eur_ha];
		parameter<Eur_ha> gg_vee__gg_vee                     := 0[Eur_ha];
		parameter<Eur_ha> gg_vee__gg_vee_intensief           := InvestmentCosts/DairyFarming * 0.5f;
		
		parameter<Eur_ha> gg_vee_intensief__Rietteelt        := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> gg_vee_intensief__Akkerbouw        := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_intensief__Aardappelen      := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_intensief__Bieten           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_intensief__Granen           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_intensief__Cranberry        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee_intensief__Boomgaard        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee_intensief__Moerasbomen      := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> gg_vee_intensief__Rijst            := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> gg_vee_intensief__Yacon            := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> gg_vee_intensief__gg_vee_extensief := 0[Eur_ha];
		parameter<Eur_ha> gg_vee_intensief__gg_vee           := 0[Eur_ha];
		parameter<Eur_ha> gg_vee_intensief__gg_vee_intensief := 0[Eur_ha];
		
		// van Overigen naar...
		parameter<Eur_ha> Overigen__Rietteelt        := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Overigen__Akkerbouw        := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Overigen__Aardappelen      := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Overigen__Bieten           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Overigen__Granen           := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Overigen__Cranberry        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Overigen__Boomgaard        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Overigen__Moerasbomen      := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Overigen__Rijst            := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Overigen__Yacon            := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Overigen__gg_vee_extensief := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Overigen__gg_vee           := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Overigen__gg_vee_intensief := InvestmentCosts/DairyFarming;

		// ---- Toegevoegd 5 september 2026 met de klassen Bollen en Boomkwekerij (#751-restklasse gesplitst).
		// De bedragen volgen dezelfde regel als de rest van de matrix: de bestemming bepaalt de investeringscategorie,
		// dus naar Bollen geldt FlowerGrowing en naar Boomkwekerij TreeNursery, beide uit Diogo (2015) tabel 5.

		// van Bollen naar...
		parameter<Eur_ha> Bollen__Rietteelt                    := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Bollen__Aardappelen                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bollen__Bieten                       := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bollen__Granen                       := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bollen__Cranberry                    := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Bollen__Boomgaard                    := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Bollen__Moerasbomen                  := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Bollen__Rijst                        := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Bollen__Yacon                        := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bollen__gg_vee_extensief             := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Bollen__gg_vee                       := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Bollen__gg_vee_intensief             := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Bollen__Akkerbouw                    := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Bollen__Bollen                       := 0[Eur_ha];
		parameter<Eur_ha> Bollen__Boomkwekerij                 := InvestmentCosts/TreeNursery;

		// van Boomkwekerij naar...
		parameter<Eur_ha> Boomkwekerij__Rietteelt              := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomkwekerij__Aardappelen            := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Boomkwekerij__Bieten                 := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Boomkwekerij__Granen                 := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Boomkwekerij__Cranberry              := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Boomkwekerij__Boomgaard              := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Boomkwekerij__Moerasbomen            := InvestmentCosts/ArableFarming * 0.5f;
		parameter<Eur_ha> Boomkwekerij__Rijst                  := InvestmentCosts/FruitGrowing;
		parameter<Eur_ha> Boomkwekerij__Yacon                  := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Boomkwekerij__gg_vee_extensief       := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Boomkwekerij__gg_vee                 := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Boomkwekerij__gg_vee_intensief       := InvestmentCosts/DairyFarming;
		parameter<Eur_ha> Boomkwekerij__Akkerbouw              := InvestmentCosts/ArableFarming;
		parameter<Eur_ha> Boomkwekerij__Bollen                 := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Boomkwekerij__Boomkwekerij           := 0[Eur_ha];

		// naar Bollen en Boomkwekerij, vanuit de bestaande klassen en vanuit Overigen
		parameter<Eur_ha> Rietteelt__Bollen                    := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Rietteelt__Boomkwekerij              := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Aardappelen__Bollen                  := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Aardappelen__Boomkwekerij            := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Bieten__Bollen                       := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Bieten__Boomkwekerij                 := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Granen__Bollen                       := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Granen__Boomkwekerij                 := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Cranberry__Bollen                    := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Cranberry__Boomkwekerij              := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Boomgaard__Bollen                    := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Boomgaard__Boomkwekerij              := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Moerasbomen__Bollen                  := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Moerasbomen__Boomkwekerij            := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Rijst__Bollen                        := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Rijst__Boomkwekerij                  := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Yacon__Bollen                        := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Yacon__Boomkwekerij                  := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> gg_vee_extensief__Bollen             := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> gg_vee_extensief__Boomkwekerij       := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> gg_vee__Bollen                       := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> gg_vee__Boomkwekerij                 := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> gg_vee_intensief__Bollen             := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> gg_vee_intensief__Boomkwekerij       := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Akkerbouw__Bollen                    := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Akkerbouw__Boomkwekerij              := InvestmentCosts/TreeNursery;
		parameter<Eur_ha> Overigen__Bollen                     := InvestmentCosts/FlowerGrowing;
		parameter<Eur_ha> Overigen__Boomkwekerij               := InvestmentCosts/TreeNursery;
	}
}