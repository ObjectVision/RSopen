container Landbouw : using = "Classifications/Actor"
{
	parameter<string> Boervariant_name        := 'RationeleBoer'; // RationeleBoer, IntermediateBoer, ConservatieveBoer
	parameter<string> BeregeningScenario_name := 'B2_Beregening_percelenmetinstal_ongelim' 
	, Descr = "Welke beregeningsvariant de WWL-schaderelatie gebruikt: A_GeenBeregening, B1_Beregening_allepercelen_ongelim of B2_Beregening_percelenmetinstal_ongelim. B2 is de afspraak uit #542: alleen de
				percelen die volgens de beregeningskaart Basisprognoses 2018 van Deltares een installatie hadden. B1 verlaagt de opbrengstderving op landbouwgrond met enkele procentpunten. Nog niet
				ingebouwd: bij natte teelten hoort geen beregening (#542)."; 

	// Manual ConstGrowthMinMax UndefinedMax

	parameter<Float32>          Krimpmarge                                := 0.98f, Descr = "Hoeveel van de beschikbare ruimte de geschaalde ondergrenzen hoogstens mogen vullen, in Iter_Landbouw_T/Allocatie_Prep/Claims/Restclaim. Niet 1, want de toets daar (elke klasse en alle
				klassen samen passen) is noodzakelijk maar niet voldoende voor een toewijzing die aan beide tegelijk voldoet, en de omrekening naar hele cellen rondt af. Grijpt alleen in een regio waar de
				ondergrenzen niet passen. Hoger maakt de allocatie krapper en kan haar laten omvallen; lager laat in de geknepen regio's meer grond over voor de restcategorie NonLandbouw.";

	parameter<String>           ClaimVariant                              := 'Manual', Descr = "Kies hier de manier waarop de minimale en maximale claims voor landbouw worden bepaald. Manual: handmatig in te vullen, ConstGrowthMinMax: op basis van een constante groei tov het vorige zichtjaar, UndefinedMax: minimale claims worden handmatig ingevuld, maximale claims zijn onbegrensd (undefined)";
	parameter<Float32>          Landbouw_Claim_Growth                     := 0.20f, Descr = "factor waarmee de max claims voor Landbouw worden bepaald tov prev zichtjaar";
	parameter<jaarlijks>        Rentevoet                                 := 0.055[jaarlijks], Descr = "Rentevoet die wordt gebruikt voor de contante waarde berekeningen";
	parameter<jaarlijks>        Rentevoet_RationeleBoer                   := Rentevoet;
	parameter<jaarlijks>        Rentevoet_IntermediateBoer                := 0.080[jaarlijks];
	parameter<jaarlijks>        Rentevoet_ConservatieveBoer               := 0.16[jaarlijks];
	parameter<Float32>          ConversionCostPremium_RationeleBoer       := 0.00f;
	parameter<Float32>          ConversionCostPremium_IntermediateBoer    := 0.20f;
	parameter<Float32>          ConversionCostPremium_ConservatieveBoer   := 1.00f
	, Descr = "De opslag op de transitiekosten per boervariant, waarmee Akkerbouw_T, Dairy_T en Iter_Landbouw_T de matrix uit Transitiekosten_src vermenigvuldigen: de rationele boer betaalt het bedrag
				zoals het er staat, de conservatieve het dubbele. Met de rentevoet hierboven wordt de omschakeldrempel van een conservatieve boer zo ongeveer vier keer die van een rationele. Aanname zonder
				bron, als vraag bij de opdrachtgever.";
	parameter<jaar>             afschrijvingsperiode                      := 20[jaar], Descr = "Afschrijvingsperiode voor investeringen in de landbouw (bijv. gewasverandering)";
	parameter<Bool>             Kostenvoet_InclusiefLoonwerk              := FALSE
	, Descr = "Kostenvoet van het saldo in de landbouwgeschiktheid. FALSE is de definitie van dit model: bruto geldopbrengst min toegerekende kosten bij eigen mechanisatie, de voet die KWIN Veehouderij,
				KWIN-AGV en het BIN delen; loonwerk, arbeid, machines, gebouwen, grond en rente over levende have blijven buiten het saldo. TRUE telt de loonwerkregel mee en is een gevoeligheidsstand, want
				de akkerbouwkolom Loonwerk is maar voor een deel van de gewassen gevuld; hij mag pas als definitie gelden wanneer beide kanten een volledige loonwerkregel hebben. Gelezen door Dairy_T
				(Graslandkosten_loonwerk, Maiskosten_loonwerk) en Akkerbouw_T (Loonwerk per gewas).";
	parameter<Float32>          Verzilt_Areaal_Fractie                    := 0.40f, Descr = "xx% van het oppervlak van risico's 2-4 is in de toekomst niet geschikt voor de gewassen: Appelbomen, consumptieaardappelen, laanbomen, tulpen, zaaiuien en zetmeelaardappelen. Deze plekken worden random gekozen"; 
	parameter<Float32>          Verzilt_OpbrengstDerving                  := 1f, Descr = "Mate van effect van verzilting op opbrengsten derving van de gewassen die daardoor worden aangetast."; 
	parameter<Float32>          Verzilt_OpbrengstDerving_Y2030            := 0f, Descr = "Mate van effect van verzilting op opbrengsten derving van de gewassen die daardoor worden aangetast."; 
	parameter<kg_ha_jaarlijks>  CO2_Uitstoot_StedelijkGebruik             := 0[kg_ha_jaarlijks], Descr = "CO2 uitstoot door omzetting van landbouwgrond naar stedelijk gebruik. De nul is bevestigd door Deltares in #657: stedelijk gebied heeft in SOMERS geen veenemissie, ook geen restemissie.";
	parameter<kg_ha_jaarlijks>  CO2_Uitstoot_Water                        := 0[kg_ha_jaarlijks], Descr = "CO2 uitstoot door omzetting van landbouwgrond naar water. De nul is bevestigd door Deltares in #657 en geldt ook voor waterberging, dus ook daar geen restemissie. Let op: uit waterberging en natte natuur komt wel methaan, en dat rekent het model nergens mee.";
	
	parameter<String>           VerziltingsScenario                       := 'Stoom2050', Descr = "Welk verziltingsscenario wordt toegepast. Opties: Stoom2050, Stoom2100";
	
	parameter<Eur_ton> CO2_prijs_minimum: [30], Descr = "Minimale CO2 prijs (in Eur/ton) die wordt gebruikt in de berekening van de contante waarde van CO2 reductie door landbouwgrond om te zetten naar andere functies.";
	parameter<Eur_ton> CO2_prijs_maximum: [80], Descr = "Maximale CO2 prijs (in Eur/ton) die wordt gebruikt in de berekening van de contante waarde van CO2 reductie door landbouwgrond om te zetten naar andere functies.";
	
	attribute<Float32> CO2_Reductie (RegioIndelingen/Provincie) := switch(
		 case(id(Provincie) == Provincie/v/groningen, 0.06f)
		,case(id(Provincie) == Provincie/v/friesland, 0.45f)
		,case(id(Provincie) == Provincie/v/overijssel, 0.10f)
		,case(id(Provincie) == Provincie/v/utrecht, 0.09f)
		,case(id(Provincie) == Provincie/v/noord_holland, 0.09f)
		,case(id(Provincie) == Provincie/v/zuid_holland, 0.21f)
		,null_f
	), Descr = "Indicatieve CO2 (equivalente) reductieopgave per Provincie (in %, totale opgave is 1Mton/jaar t.o.v. 1990). Uit mail DGWB, d.d. 8-5-2025";
	
	container Aanlegkosten_waterinfiltratiesystemen
	: Descr = "actieve (pompgestuurde) systemen. Indicatief, uit mail DGWB, d.d. 8-5-2025", URL = "https://loketveenweideboeren.nl/aanleg-waterinfiltratiesysteem/"
	{
		parameter<Eur_ha> passief_laag := 4000[Eur_ha];
		parameter<Eur_ha> passief_hoog := 5000[Eur_ha];
		parameter<Eur_ha> actief_laag  := 6000[Eur_ha];
		parameter<Eur_ha> actief_hoog  := 7500[Eur_ha];
	}
	
	container claims_conservatief
	: Descr = "De claimvariant die alle vier de varianten in VariantParameters/VariantK/Claim_agrarisch_Variant gebruiken: per landbouwklasse een onder- en bovengrens als bandbreedte rond het
				basisjaarareaal, uit twee parameters met een for_each eroverheen. Een plaatshouder: de bedoelde opzet uit #780 is regionale arealen en geschiktheidskaarten per gebied van team
				effectbepaling, en tot die er zijn houdt deze band het areaal bij het basisjaar. Gewassen zonder basisjaarareaal krijgen hun bovengrens uit Introductieruimte; GG_vee_intensief heeft geen
				basisjaarareaal en geen vlag IsExotisch, dus onder- en bovengrens nul, en wordt niet gealloceerd."
	{
		parameter<Float32> Claimbandbreedte := float32(replace_value(expand(., '%env:RSO_CLAIMBANDBREEDTE%'), 'env:RSO_CLAIMBANDBREEDTE', '0'))
		, Descr = "Hoeveel het areaal van een landbouwklasse per allocatieregio mag afwijken van het basisjaar: bij 0,05 loopt de band van 95 tot 105 procent, bij 0 staat elke klasse op haar basisjaarareaal
					maal de restclaimfactor. Op 0 op besluit van de opdrachtgever na #782 en #780: in BAU verandert de landbouw niets ten opzichte van het basisjaar zolang team landbouw niets anders levert;
					alleen de restclaim haalt er per regio af wat niet meer past. Via de omgevingsvariabele RSO_CLAIMBANDBREEDTE te zetten voor een gevoeligheidsanalyse: beweegt de gewasverdeling bij 0,25
					nauwelijks, dan is de economie zwak; beweegt zij sterk, dan bepaalt de claim het antwoord.";

		parameter<Ha> Introductieruimte := 1000[Ha]
		, Descr = "Bovengrens per allocatieregio voor een exotisch gewas (Actor/LandbouwKlasses/IsExotisch: Rietteelt, Cranberry, Rijst, Yacon en Moerasbomen), dus de ruimte om te ontstaan voor een gewas
					zonder basisjaarareaal, waarvan de bovengrens anders nul maal de bandbreedte is. Bewust alleen voor klassen die leeg zijn omdat zij nieuw zijn, niet voor GG_vee_intensief, die leeg is omdat
					haar invoer (veedichtheid uit de landbouwtelling 2014) met #751 is weggevallen. Duizend hectare per provincie is een aanname: genoeg om een nieuw gewas zichtbaar te maken, te weinig om het
					beeld te laten kantelen; zie Templates/Landbouw.dms container Exotisch voor wat de geschiktheid van die gewassen waard is.";

		parameter<String> Ondergrens_str    := string(1f - Claimbandbreedte)+'f';
		parameter<String> Bovengrens_str    := string(1f + Claimbandbreedte)+'f';
		parameter<String> Introductie_str   := string(float32(Introductieruimte))+'[ha]';

		parameter<Bool> ExotenActief := FALSE
		, Descr = "Doen de exotische gewassen (Actor/LandbouwKlasses/IsExotisch) mee in de allocatie? Uit, op besluit van de opdrachtgever: zij hebben geen opbrengstdervingscurve maar een kansenkaart die als
					derving wordt gelezen (Templates/Landbouw.dms, container Exotisch), en daar komt op de landbouwgrond een negatief saldo uit dat meer over de kaart zegt dan over de landbouw. Uit betekent dat
					zij uit de subsectorlijst van de sector Landbouw vallen (Classifications/Actor/LandbouwKlasses/Actief; Rietteelt blijft subsector voor de natte teelt uit de veenlevering) en dat onder- en
					bovengrens nul zijn. Wat exogeen wordt opgelegd blijft staan (#684), en de geschiktheidskaarten worden nog berekend. Ook te zetten via de omgevingsvariabele RSO_EXOTEN_ACTIEF.";

		container MinClaims_manual :=
			for_each_nedv(
				Classifications/Actor/LandbouwKlasses/name
				, Classifications/Actor/LandbouwKlasses/IsExotisch && !ExotenActief
					? quote('const(0[ha], RegioUnit, ha)')
					: quote('StartYear/'+Classifications/Actor/LandbouwKlasses/name+' * ')+'+Ondergrens_str'
				, void
				, String
			), Descr = "Ondergrens per klasse: het basisjaarareaal maal een min de bandbreedte; nul voor een exotisch gewas zolang ExotenActief uit staat.";

		container MaxClaims_manual :=
			for_each_nedv(
				Classifications/Actor/LandbouwKlasses/name
				, Classifications/Actor/LandbouwKlasses/IsExotisch
					? (ExotenActief
						? quote('max_elem(StartYear/'+Classifications/Actor/LandbouwKlasses/name+' * ')+'+Bovengrens_str+'+quote(', ')+'+Introductie_str+'+quote(')')
						: quote('const(0[ha], RegioUnit, ha)'))
					: quote('StartYear/'+Classifications/Actor/LandbouwKlasses/name+' * ')+'+Bovengrens_str'
				, void
				, String
			), Descr = "Bovengrens per klasse: het basisjaarareaal maal een plus de bandbreedte, met de Introductieruimte als vloer zodat een klasse zonder basisjaarareaal kan ontstaan; nul voor een exotisch gewas zolang ExotenActief uit staat.";
	}
	unit<UInt8> Transitiekosten :=
		for_each_nedv(
			/Classifications/Actor/LandbouwKlasses/name
			, replace(
				  '(Transitiekosten_src/Veldtype    != Transitiekosten_src/Bouwstenen/@Best@/Veldtype    ? Transitiekosten_src/Bouwstenen/@Best@/Inv_veld      + Transitiekosten_src/Opruimen_veld : 0[Eur_ha])'
				+ ' + (Transitiekosten_src/Machinepark != Transitiekosten_src/Bouwstenen/@Best@/Machinepark ? Transitiekosten_src/Bouwstenen/@Best@/Inv_machines                                     : 0[Eur_ha])'
				+ ' + (Transitiekosten_src/Systeem    != Transitiekosten_src/Bouwstenen/@Best@/Systeem    ? Transitiekosten_src/Bouwstenen/@Best@/Inv_specifiek + Transitiekosten_src/Opruimen_specifiek + Transitiekosten_src/Restwaardeverlies * Transitiekosten_src/Onverhandelbaar : 0[Eur_ha])'
				, '@Best@', /Classifications/Actor/LandbouwKlasses/name)
			+ ' * Transitiekosten_src/Dekking'
			, /Classifications/Actor/LandbouwKlasses
			, Eur_ha
		)
	, Descr = "De transitiekostenmatrix in euro per hectare, herkomst in rijen en bestemming in kolommen: per bestemming een attribuut over LandbouwKlasses, met als index de klasse waar de cel vandaan
				komt. Per paar berekend uit de bouwstenen in Transitiekosten_src (#202): per component kost de omschakeling niets als herkomst en bestemming hetzelfde label dragen, en anders de investering
				van de bestemming plus het opruimen van de herkomst, bij het systeem ook het verlies van de niet terugverdiende herkomstinvestering. De diagonaal is nul per constructie. De factor Dekking
				trekt de toetsen in Transitiekosten_src/Controle in de rekengraaf en mag niet weg. Afnemers: Templates/Landbouw/Suitability_T/Factoren/Transitiekosten (herkomst van het basisjaar) en
				Iter_Landbouw_T/Allocatie_Prep/Conversiekosten (herkomst van het lopende zichtjaar), beide met de opslag van de boervariant; de rij Overigen staat als losse parameters
				Transitiekosten_src/Overigen__<klasse>.";
	
	#include<Gewas_parameters.dms>
	#include<Melkvee_parameters.dms>
	#include<Scenario_parameters.dms>
	
	container Beleid
	: Descr = "Beleidsankers voor de landbouwgeschiktheid die niet per variant verschillen (#780), prijspeil 2025: de GLB in het basisjaar en in 2028 (de knik van het nieuwe meerjarig financieel kader), de
				mestprijs van het basisjaar en het subsidiabele aandeel van het natuurlijk grasland. De ankers voor 2040 en 2050 staan per variant in VariantParameters/VariantK;
				Templates/Landbouw/Suitability_T trekt er een stuksgewijs lineair pad doorheen. Alle kentallen zijn reeel constant; PriceMult werkt alleen op de bruto geldopbrengst."
	{
		parameter<Eur_Ha_jaarlijks> GLB_Hectaresteun_basisjaar := 233[Eur_Ha_jaarlijks]
		, Descr = "Hectaresteun per ha subsidiabel areaal in het basisjaar 2023, prijspeil 2025: basisinkomenssteun plus de extra betaling voor de eerste 40 ha, omgerekend naar een gemiddeld gangbaar melkveebedrijf van 62 ha, en met de CPI van 2023 naar 2025.", Source = "RVO definitieve tarieven 2023 (213,28 plus 54,53 maal 40 gedeeld door 62), bedrijfsgrootte WUR-factsheet BIN 2023, CPI 1,063";
		parameter<Eur_Ha_jaarlijks> GLB_Hectaresteun_2028 := 138[Eur_Ha_jaarlijks]
		, Descr = "Hectaresteun per ha in 2028, het eerste jaar van het nieuwe meerjarig financieel kader, prijspeil 2025: 0,76 maal het 2027-niveau, omdat de Nederlandse envelop in het EC-voorstel met 24 procent daalt en de hectaresteun blijft bestaan. Voorlopig, want het besluit over het MFK valt op zijn vroegst eind 2026.", Source = "EC-voorstel COM(2025) 565 van 16 juli 2025; 2027-niveau 158 plus 32 uit het Nationaal Strategisch Plan; prijspeil 2027 naar 2025 gedeeld door 1,05 (aanname)";
		parameter<Eur_Ha_jaarlijks> GLB_Eco_basisjaar := 98[Eur_Ha_jaarlijks]
		, Descr = "Verwachte ontvangst uit de eco-regeling per ha in het basisjaar, prijspeil 2025: de tarieven brons, zilver en goud gewogen met de deelname van gangbare melkveebedrijven. Bruto, dus zonder de kosten van de eco-activiteiten, en voor akkerbouw en melkvee gelijk om beide sectoren op dezelfde voet te houden.", Source = "tarieven RVO 2023 tot 2026 (KWIN Veehouderij blz. 110), deelname BIN 2023 (WUR-factsheet: goud 19, zilver 58, brons 13 procent), gedeeld door CPI 1,063";
		parameter<Eur_Ha_jaarlijks> GLB_Eco_2028 := 75[Eur_Ha_jaarlijks]
		, Descr = "Verwachte ontvangst uit de eco-regeling per ha in 2028, prijspeil 2025: 0,76 maal 99 (104 nominaal in 2027 gedeeld door 1,05). KEUZE, want in het EC-voorstel COM(2025) 565 gaan eco-regeling en ANLb op in een gecofinancierde interventie waarvan de omvang niet vastligt. Status: voorlopig.";
		parameter<Eur_Ha_jaarlijks> GLB_Diensten_extensief_basisjaar := 0[Eur_Ha_jaarlijks]
		, Descr = "Vergoeding voor diensten op natuurlijk beheerd grasland (gg_vee_extensief) per ha in het basisjaar. Nul, want er is geen bron voor de ANLb- en SNL-dekking op LGN 45 in het basisjaar; de 2040- en 2050-ankers per variant staan in VariantK.", Source = "ontbreekt; ankers voor wie het wil vullen: SNL N12.02 311 per ha (BIJ12 2026), ANLb extensief beweid 950 en kruidenrijk grasland 1.700 (BoerenNatuur 2026)";
		parameter<Eur_Ha_jaarlijks> Veen_vergoeding_basisjaar := 30[Eur_Ha_jaarlijks]
		, Descr = "Veenweidevergoeding per ha grasland op veengrond in het basisjaar. Aanname zonder bron, overgenomen van de oude kolommen ANLb_veen_Bedrag maal ANLb_veen_Fractie in VariantK. Wordt pas hoger als de NbS-varianten een eigen hydrologie hebben, anders komt de vergoeding zonder de derving van de vernatting; vraag aan team Veen.", Source = "aanname; ankers RVO-regeling veenweide 2027 en 2028 (545 tot 1.355 per ha naar drooglegging) en het ANLb-budget van circa 900 per ha onder contract";
		parameter<Eur_m3> Mestprijs_basisjaar := 25[Eur_m3]
		, Descr = "Afzetprijs van rundveedrijfmest in het basisjaar, euro per m3, de norm voor de middellange termijn bij afzet over lange afstand.", Source = "KWIN Veehouderij 2025-2026 blz. 25; ter vergelijking BIN betaald gemiddelde 12 (2023), 17 (2024), 23 (2025) per m3";
		parameter<Ratio> GLB_factor_extensief := 0.806[Ratio]
		, Descr = "Aandeel van het areaal gg_vee_extensief dat GLB-hectaresteun en eco-regeling ontvangt: het deel met BRP-code 331 (grasland natuurlijk met landbouwactiviteiten) of 1926 (agrarisch
				natuurmengsel), want 332 (hoofdfunctie natuur) komt volgens de RVO-gewascodelijst niet in aanmerking en cellen zonder BRP-perceel zijn niet als subsidiabel areaal opgegeven. Bevestiging van
				die lezing bij RVO staat open in #780.", Source = "eigen basisjaarkaart, BRP 2025 op LGN 2025 (#780)";
	}

	container per_LandbouwKlasse
	: Descr = "Klasseparameters van de drie melkveeklassen voor Dairy_T (#780): gg_vee_extensief is natuurlijk beheerd grasland zonder melkkoeien, gg_vee is productiegrasland met voedergewas,
				gg_vee_intensief is een plaatshouder zonder basisjaarareaal die per referentie gelijk is aan gg_vee. De economie staat in Melkvee_parameters.dms; de akkerbouwklassen lezen hier niets."
	{
		container gg_vee_extensief
		: Descr = "Natuurlijk beheerd grasland: LGN 45, BRP 331, 332 en 1926. Geen melkkoeien; het gras wordt op stam verkocht tegen Melkvee/Grond/Prijs_natuurgras, geen mais, geen deep drainage, de GLB maal Beleid/GLB_factor_extensief omdat BRP 332 niet subsidiabel is, plus GLB_Diensten_extensief en op veen de veenvergoeding (#780)."
		{
			parameter<Ratio> Koedichtheid_factor  := 0.0[Ratio], Descr = "Nul: op natuurlijk beheerd grasland staan in dit model geen melkkoeien; het gras is ruwvoer voor de markt.";
			parameter<Bool>  IsNatuurlijkGrasland := TRUE, Descr = "Kiest in Dairy_T de opbrengst, de prijs en de kosten van natuurlijk grasland.";
		}

		container gg_vee
		: Descr = "Productiegrasland met voedergewas: LGN 1 en 2, BRP 265 en 266 en de maiscodes. Dichtheid gelijk aan Melkvee/Dichtheid/D_ref."
		{
			parameter<Ratio> Koedichtheid_factor  := 1.0[Ratio], Descr = "Een: de referentiedichtheid van een gemiddelde productiehectare.";
			parameter<Bool>  IsNatuurlijkGrasland := FALSE, Descr = "Productiegrasland: Dairy_T rekent met de referentiedichtheid, de bruto grasopbrengst per bodemtak, mais en de graslandkosten.";
		}

		container gg_vee_intensief
		: Descr = "Plaatshouder zonder basisjaarareaal (#751): de klasse berustte op melkkoeien per hectare uit de landbouwtelling 2014 en de BRP kent geen veedichtheid. Per referentie gelijk aan gg_vee, wordt niet gealloceerd (claim nul, IsExotisch FALSE) en blijft staan om LU_ModelType niet te hernummeren."
		{
			parameter<Ratio> Koedichtheid_factor  := ../gg_vee/Koedichtheid_factor;
			parameter<Bool>  IsNatuurlijkGrasland := ../gg_vee/IsNatuurlijkGrasland;
		}
	}


	container Transitiekosten_src
	: Descr = "De bouwstenen waaruit de transitiekostenmatrix wordt opgebouwd (#202). De transitiekosten van herkomst naar bestemming zijn de investering in het bestemmingssysteem die de herkomst niet al
				heeft, plus de beeindigingskosten van de herkomst die niet worden terugverdiend; de diagonaal is daarmee nul. Drie componenten met elk een deelbaarheidslabel: veldtype (de inrichting van het
				perceel), machinepark (werktuigen, met een tweedehandsmarkt en dus zonder opruimpost) en systeem (gebouwen, installaties en plantopstand, met opruimen en restwaardeverlies); draagt de
				herkomst hetzelfde label als de bestemming, dan kost die component niets. De vier akkerbouwklassen delen alle drie de labels, want een gewaswissel binnen het bouwplan is geen
				bedrijfsomschakeling (besluit opdrachtgever); Bollen en Boomkwekerij hebben een eigen bovenbouw. Geen dubbeltelling met het saldo, dat sinds #780 geen arbeid, gebouwen, machines of grond
				bevat. Prijspeil 2025 en 2026 uit KWIN-AGV 2026 en KWIN Veehouderij 2025-2026; drie klassen rusten voor hun totaal nog op Diogo (2015), zie container Diogo2015. Niet inbegrepen:
				grondaankoop, vergunningen, advieskosten en het inkomensgat tijdens de omschakeljaren."
	{
		parameter<Float32> Restwaardeverlies := 0.5f
		, Descr = "Welk deel van de niet-verhandelbare investering van de herkomst verloren gaat bij een omschakeling; de knop onder de kant vanaf een systeem (#202) en de meest aanvechtbare aanname van de
					matrix. Een half is de verwachtingswaarde bij lineaire afschrijving over twintig jaar en een gelijkmatige leeftijdsopbouw. Op nul kost het verlaten van een systeem alleen het opruimen; op
					een is elke omschakeling zo duur dat de allocatie op het basisjaar vastloopt. Keuze, voor te leggen aan de opdrachtgever.", Source = "KWIN Veehouderij 2025-2026 blz. 154 en 155 (restwaarde stal na twintig jaar nul, technische levensduur langer)";

		parameter<Float32> Dekking := 1f
		, ExplicitSuppliers = "Controle/Onverhandelbaar_past;Controle/Laagste_bedrag"
		, Descr = "Neutrale factor van een, meevermenigvuldigd in elke gegenereerde term van unit Transitiekosten. HAAL HEM NIET WEG omdat hij niets doet: dat is precies zijn functie. De twee toetsen in Controle hangen aan geen enkel item dat het model opvraagt, en een IntegrityCheck die niet in de rekengraaf zit wordt nooit geevalueerd. Via deze factor lopen ze mee zodra de matrix wordt uitgerekend.";

		container Controle
		: Descr = "Twee toetsen op de bouwstenen, in de rekengraaf gehangen via Dekking hierboven."
		{
			attribute<Eur_ha> Onverhandelbaar_past (/Classifications/Actor/LandbouwKlasses) := Inv_specifiek - Onverhandelbaar
			, IntegrityCheck = "all(this >= 0[Eur_ha])"
			, Descr = "Het niet-verhandelbare deel kan niet groter zijn dan de investering waar het een deel van is. Faalt deze toets, dan is bij een klasse Onverhandelbaar boven Inv_specifiek gezet.";

			attribute<Eur_ha> Laagste_bedrag (/Classifications/Actor/LandbouwKlasses) := min_elem(min_elem(Inv_veld, Opruimen_veld), min_elem(min_elem(Inv_machines, Inv_specifiek), min_elem(Onverhandelbaar, Opruimen_specifiek)))
			, IntegrityCheck = "all(this >= 0[Eur_ha])"
			, Descr = "Geen enkel bedrag in de bouwstenen mag negatief zijn. Een negatief bedrag zou een omschakeling geld opleveren en dat is in deze matrix nooit bedoeld.";
		}

		container Diogo2015
		: Descr = "De laatste drie bedragen die nog op Diogo (2015) tabel 3.5 rusten, maal de index hieronder: voor Boomgaard, Bollen en Boomkwekerij is geen KWIN gelezen, want KWIN Fruitteelt, KWIN
				Bloembollen en KWIN Boomkwekerij zijn aparte uitgaven die niet in huis zijn. Het totaal per hectare blijft daar het bedrag uit de bron; alleen de verdeling over veld, werktuigen en systeem
				is nieuw."
		{
			parameter<Float32> Indexatie := 1.40f
			, Descr = "Prijsindex van het prijspeil van Diogo (2015) naar 2025. De bron noemt geen prijspeil, maar de economische data komen uit LEI (2013) en het cijfer 7.257 stond al in het VU-rapport van
				november 2013, dus het prijspeil is 2011 of 2012; de consumentenprijsindex over 2011 tot 2025 is ruwweg 1,45 tot 1,50, dus 1,40 is eerder te laag dan te hoog. Alleen nog van belang voor de
				drie klassen hieronder.";

			parameter<Eur_ha> FruitGrowing  := 35858[Eur_ha] * Indexatie, Descr = "50.201 na indexatie. Diogo (2015) tabel 3.5, investment costs fruit growing.";
			parameter<Eur_ha> FlowerGrowing := 26254[Eur_ha] * Indexatie, Descr = "36.756 na indexatie. Diogo (2015) tabel 3.5, investment costs flower growing.";
			parameter<Eur_ha> TreeNursery   := 35055[Eur_ha] * Indexatie, Descr = "49.077 na indexatie. Diogo (2015) tabel 3.5, investment costs tree nursery.";
		}

		container Bouwstenen
		: Descr = "Per landbouwklasse plus de rij Overigen negen regels: drie labels en zes bedragen, vervangingswaarden per hectare exclusief btw op prijspeil 2025 tenzij anders vermeld, in de volgorde van
					LandbouwKlasses. Elke klasse uit Classifications/Actor/LandbouwKlasses moet hier een container hebben; ontbreekt er een, dan valt de union_data hieronder om op Unknown identifier, en dat is
					de bedoeling."
		{
			container Rietteelt
			: Descr = "Natte teelt op veen, riet en lisdodde. De klasse is de bestemming van de opgelegde natte teelt uit de veenlevering (#684) en telt daar als gerealiseerde claim, ook met ExotenActief uit. Zie #258 voor het saldo."
			{
				parameter<String> Veldtype           := 'Nat';
				parameter<Eur_ha> Inv_veld           := 11450[Eur_ha], Descr = "Inrichting van een nat perceel: aanleg van kaden en compartimentering, pompen en peilbeheervoorziening. De enige gevonden begroting met dezelfde kostenindeling als dit model, dus toegerekende kosten apart van bewerkingskosten, grond en gebouwen.", Source = "saldoberekening lisdodde VIPNL, Hogeschool Van Hall Larenstein, versie d011024, prijspeil 2024 (9.700 plus 1.250 plus 500)";
				parameter<Eur_ha> Opruimen_veld      :=  1500[Eur_ha], Descr = "Opruimen van kaden en stuw wanneer er weer een droge teelt op komt. Het opnieuw draineren zit niet hier maar in Inv_veld van de bestemming. Status: aanname zonder bron; geen enkele geraadpleegde bron begroot het terugdraaien van een natte teelt.";
				parameter<String> Machinepark        := 'Nat';
				parameter<Eur_ha> Inv_machines       :=     0[Eur_ha], Descr = "Nul: de oogst van riet en lisdodde gaat in alle geraadpleegde begrotingen als loonwerk, met lichte machines op rupsonderstel van de loonwerker. Die post staat als Loonwerk in Gewas_parameters en niet als eigen werktuigenpark. Status: keuze, volgt de bron.";
				parameter<String> Systeem            := 'Riet';
				parameter<Eur_ha> Inv_specifiek      :=   500[Eur_ha], Descr = "Zaaien van lisdodde; poten van stekken kost 2.500 per ha en is de dure route. Staat hier als eenmalige aanplant en niet als jaarlijkse kostenpost in het saldo, anders telt hij dubbel; zie de Descr van Toegerekend bij per_Gewas/Rietteelt.", Source = "VIPNL, dezelfde bron als Inv_veld; voor riet noemt de Factsheet Natte Teelten een aanplant in dezelfde orde";
				parameter<Eur_ha> Onverhandelbaar    :=   500[Eur_ha], Descr = "De aanplant is niet te verplaatsen.";
				parameter<Eur_ha> Opruimen_specifiek :=     0[Eur_ha], Descr = "Nul: het opruimen van een natte teelt zit in Opruimen_veld en niet in een aparte installatie.";
			}

			container Aardappelen
			: Descr = "Akkerbouw. Deelt alle drie de labels met Bieten, Granen en Akkerbouw, dus de overgangen tussen die vier kosten nul; zie de kopregels van deze container."
			{
				parameter<String> Veldtype           := 'Bouwland';
				parameter<Eur_ha> Inv_veld           := 1700[Eur_ha], Descr = "Buisdrainage bij een drainafstand van 10 m, de volledige aanleg. Op een perceel dat als grasland al drainage heeft is dit te hoog, en het model weet niet welke percelen drainage hebben. De akkerbouwkant staat verder helemaal op KWIN-AGV, daarom die bron en niet de lagere uit KWIN Veehouderij of de ACSG-notitie voor BIJ12.", Source = "KWIN-AGV 2026, module 4/78 (3.250 bij 5 m, 2.100 bij 8 m, 1.700 bij 10 m); KWIN Veehouderij 2025-2026 blz. 88 geeft 1.045 tot 1.280, ACSG 2022 715 tot 1.620";
				parameter<Eur_ha> Opruimen_veld      :=    0[Eur_ha], Descr = "Nul: drainage blijft onder elk volgend gebruik bruikbaar en hoeft niet te worden verwijderd. Er is ook geen bron gevonden voor de kosten van het verwijderen ervan.";
				parameter<String> Machinepark        := 'Akkerbouw';
				parameter<Eur_ha> Inv_machines       := 4600[Eur_ha], Descr = "Het bewerkingsgebonden werktuigenpark van een akkerbouwbedrijf per hectare: de ondergrens van de bandbreedtes voor twee trekkers, wentelploeg, veldspuit, kunstmeststrooier en twee kipwagens, gedeeld door de bedrijfsgrootte. Een zaaimachine en een eg zitten er niet in, dus een ondergrens.", Source = "KWIN-AGV 2026 module 4/79 (samen 276.700 euro), bedrijfsgrootte 60 ha (LMM 2024: 59,4 ha cultuurgrond)";
				parameter<String> Systeem            := 'Akkerbouw';
				parameter<Eur_ha> Inv_specifiek      := 4350[Eur_ha], Descr = "De gewasgebonden werktuigen en de bewaring van hetzelfde bedrijf van 60 ha: aardappelbunkerrooier, pootmachine en uienrooier plus een aardappelbewaarplaats van 750 ton, het bouwplanaandeel aardappelen van dit model maal 60 ha maal 45 ton. Uienbewaring is niet apart geteld.", Source = "KWIN-AGV 2026 module 4/79 (werktuigen 163.600, is 2.727 per ha) en 4/78 (bewaarplaats 27.500 plus 95 per ton, is 1.646 per ha)";
				parameter<Eur_ha> Onverhandelbaar    := 1650[Eur_ha], Descr = "Alleen de bewaarplaats. Werktuigen hebben een tweedehandsmarkt en worden bij een omschakeling verkocht, dus zij gaan niet verloren.";
				parameter<Eur_ha> Opruimen_specifiek :=    0[Eur_ha], Descr = "Nul: een bewaarplaats hoeft niet gesloopt te worden om er iets anders op het land te telen.";
			}

			container Bieten
			: Descr = "Akkerbouw, dezelfde negen regels als Aardappelen; zie daar voor de bronnen. Het systeemlabel is gelijk, dus de overgang tussen deze klassen kost nul."
			{
				parameter<String> Veldtype           := ../Aardappelen/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld;
				parameter<String> Machinepark        := ../Aardappelen/Machinepark;
				parameter<Eur_ha> Inv_machines       := ../Aardappelen/Inv_machines;
				parameter<String> Systeem            := ../Aardappelen/Systeem;
				parameter<Eur_ha> Inv_specifiek      := ../Aardappelen/Inv_specifiek;
				parameter<Eur_ha> Onverhandelbaar    := ../Aardappelen/Onverhandelbaar;
				parameter<Eur_ha> Opruimen_specifiek := ../Aardappelen/Opruimen_specifiek;
			}

			container Granen
			: Descr = "Akkerbouw, per referentie gelijk aan Aardappelen; zie daar."
			{
				parameter<String> Veldtype           := ../Aardappelen/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld;
				parameter<String> Machinepark        := ../Aardappelen/Machinepark;
				parameter<Eur_ha> Inv_machines       := ../Aardappelen/Inv_machines;
				parameter<String> Systeem            := ../Aardappelen/Systeem;
				parameter<Eur_ha> Inv_specifiek      := ../Aardappelen/Inv_specifiek;
				parameter<Eur_ha> Onverhandelbaar    := ../Aardappelen/Onverhandelbaar;
				parameter<Eur_ha> Opruimen_specifiek := ../Aardappelen/Opruimen_specifiek;
			}

			container Cranberry
			: Descr = "Exotisch gewas op een kansenkaart van WUR, uit via ExotenActief. Meerjarige aanplant op een nat veenbed. Geen bron; de bedragen zijn een verdeling van het fruitbedrag van Diogo over de drie componenten."
			{
				parameter<String> Veldtype           := 'Nat';
				parameter<Eur_ha> Inv_veld           := ../Rietteelt/Inv_veld,      Descr = "Gelijk aan de natte inrichting van Rietteelt; zie daar. Status: aanname.";
				parameter<Eur_ha> Opruimen_veld      := ../Rietteelt/Opruimen_veld, Descr = "Gelijk aan Rietteelt; zie daar. Status: aanname.";
				parameter<String> Machinepark        := 'Nat';
				parameter<Eur_ha> Inv_machines       := ../Rietteelt/Inv_machines,  Descr = "Gelijk aan Rietteelt; zie daar. Status: aanname.";
				parameter<String> Systeem            := 'Cranberry';
				parameter<Eur_ha> Inv_specifiek      := Diogo2015/FruitGrowing - ../Rietteelt/Inv_veld - ../Rietteelt/Inv_machines, Descr = "Het fruitbedrag van Diogo (50.201) min de natte inrichting en de natte mechanisatie, dus 39.701 voor de aanplant zelf. Status: ontbreekt, en het bedrag zegt meer over de bron dan over cranberry.";
				parameter<Eur_ha> Onverhandelbaar    := Inv_specifiek,              Descr = "De aanplant is niet te verplaatsen.";
				parameter<Eur_ha> Opruimen_specifiek := ../Boomgaard/Opruimen_specifiek, Descr = "Gelijk aan het rooien van een boomgaard; zie daar. Status: aanname.";
			}

			container Boomgaard
			: Descr = "Fruitteelt, appel en peer. Het TOTAAL van de drie componenten is het bedrag van Diogo (2015) tabel 3.5, want er is geen KWIN Fruitteelt in huis; de verdeling over veld, werktuigen en systeem is een schatting. Het rooien is wel onderbouwd."
			{
				parameter<String> Veldtype           := 'Bouwland';
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld,      Descr = "Een boomgaard staat op ontwaterd land, dus dezelfde drainage als bouwland; zie Aardappelen.";
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld, Descr = "Nul, zie Aardappelen.";
				parameter<String> Machinepark        := 'Fruit';
				parameter<Eur_ha> Inv_machines       := 13500[Eur_ha], Descr = "Fruitteeltmechanisatie per hectare: spuit, plukwagens, sorteerlijn en koelcel. Schatting, zo gekozen dat de drie componenten samen op het Diogo-bedrag uitkomen. Status: ontbreekt, KWIN Fruitteelt nodig.";
				parameter<String> Systeem            := 'Fruit';
				parameter<Eur_ha> Inv_specifiek      := Diogo2015/FruitGrowing - ../Aardappelen/Inv_veld - Inv_machines, Descr = "De meerjarige plantopstand met steunsysteem, hagelnet en druppelirrigatie: het Diogo-bedrag van 50.201 min de drainage en de mechanisatie, dus 35.001. Status: ontbreekt, KWIN Fruitteelt nodig.";
				parameter<Eur_ha> Onverhandelbaar    := Inv_specifiek, Descr = "Een plantopstand met steunsysteem is niet te verplaatsen en heeft geen tweedehandsmarkt.";
				parameter<Eur_ha> Opruimen_specifiek := 4900[Eur_ha], Descr = "Rooien van de plantopstand en de grond weer vlak maken: appel en peer per boom plus egaliseren, op prijspeil 2009 en met de consumentenprijsindex naar 2025. De duurdere van de twee
				rooivarianten in de bron, want een perceel dat weer bouwland wordt moet wortelvrij zijn. Het verwijderen van hagelnet en druppelirrigatie en de opbrengst van het hout zitten er niet in.", Source = "Kwantitatieve Informatie Fruitteelt 2009/2010 (PPO rapport 2009-41), tabel 14.5.2 en 14.5.3 (3.375 per ha, maal 1,45)";
			}

			container Moerasbomen
			: Descr = "Korte-omloophout op natte grond, exotisch gewas op een kansenkaart van WUR, uit via ExotenActief. Geen bron."
			{
				parameter<String> Veldtype           := 'Nat';
				parameter<Eur_ha> Inv_veld           := ../Rietteelt/Inv_veld,      Descr = "Gelijk aan de natte inrichting van Rietteelt; zie daar.";
				parameter<Eur_ha> Opruimen_veld      := ../Rietteelt/Opruimen_veld, Descr = "Gelijk aan Rietteelt; zie daar.";
				parameter<String> Machinepark        := 'Nat';
				parameter<Eur_ha> Inv_machines       := ../Rietteelt/Inv_machines,  Descr = "Gelijk aan Rietteelt; zie daar.";
				parameter<String> Systeem            := 'Moerasbomen';
				parameter<Eur_ha> Inv_specifiek      := 4000[Eur_ha], Descr = "Aanplant van korte-omloophout op natte grond. Status: aanname zonder bron. De oude matrix zette dit op de helft van het akkerbouwbedrag met als enige toelichting 'lijkt me niet zo duur'.";
				parameter<Eur_ha> Onverhandelbaar    := Inv_specifiek, Descr = "De aanplant is niet te verplaatsen.";
				parameter<Eur_ha> Opruimen_specifiek := 1000[Eur_ha], Descr = "Rooien van de stobben. Status: aanname zonder bron.";
			}

			container Rijst
			: Descr = "Exotisch gewas op een kansenkaart van WUR, uit via ExotenActief. Geen bron."
			{
				parameter<String> Veldtype           := 'Nat';
				parameter<Eur_ha> Inv_veld           := ../Rietteelt/Inv_veld,      Descr = "Gelijk aan de natte inrichting van Rietteelt; zie daar. Rijst vraagt een peil dat per perceel te zetten is, net als riet.";
				parameter<Eur_ha> Opruimen_veld      := ../Rietteelt/Opruimen_veld, Descr = "Gelijk aan Rietteelt; zie daar.";
				parameter<String> Machinepark        := 'Nat';
				parameter<Eur_ha> Inv_machines       := ../Rietteelt/Inv_machines,  Descr = "Gelijk aan Rietteelt; zie daar.";
				parameter<String> Systeem            := 'Rijst';
				parameter<Eur_ha> Inv_specifiek      := 2000[Eur_ha], Descr = "Zaaigoed en de inrichting die riet niet vraagt. Status: aanname zonder bron. De oude matrix zette rijst op het fruitbedrag met als enige toelichting 'lijjkt me duur om in te richten'.";
				parameter<Eur_ha> Onverhandelbaar    :=    0[Eur_ha], Descr = "Nul: rijst is een eenjarig gewas, er blijft geen aanplant staan.";
				parameter<Eur_ha> Opruimen_specifiek :=    0[Eur_ha], Descr = "Nul: zie Onverhandelbaar.";
			}

			container Yacon
			: Descr = "Exotisch knolgewas op bouwland, op een kansenkaart van WUR, uit via ExotenActief. Geen bron."
			{
				parameter<String> Veldtype           := ../Aardappelen/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld;
				parameter<String> Machinepark        := ../Aardappelen/Machinepark, Descr = "Yacon is een knolgewas op bouwland en deelt het basiswerktuigenpark met de akkerbouw.";
				parameter<Eur_ha> Inv_machines       := ../Aardappelen/Inv_machines;
				parameter<String> Systeem            := 'Yacon';
				parameter<Eur_ha> Inv_specifiek      := 2000[Eur_ha], Descr = "Plantmateriaal en een eigen oogst- en bewaarlijn. Status: aanname zonder bron. De oude matrix rekende hier wisselend het volle of het halve akkerbouwbedrag, afhankelijk van de herkomst, zonder reden.";
				parameter<Eur_ha> Onverhandelbaar    := 1000[Eur_ha], Descr = "De helft, als schatting voor het niet-verhandelbare deel. Status: aanname.";
				parameter<Eur_ha> Opruimen_specifiek :=    0[Eur_ha];
			}

			container GG_vee_extensief
			: Descr = "Natuurlijk beheerd grasland: LGN 45, BRP 331, 332 en 1926. Geen melkkoeien en geen bedrijfsgebouw; het gras wordt op stam verkocht (Dairy_T/IsNatuurlijkGrasland). Deelt het veldtype en het werktuigenpark met de melkveeklassen, maar niet het systeem: daar zit precies het punt van #202, want de overgang van gg_vee naar deze klasse is een afwaardering en kostte in de oude matrix nul."
			{
				parameter<String> Veldtype           := 'Grasland';
				parameter<Eur_ha> Inv_veld           := ../GG_vee/Inv_veld,      Descr = "Dezelfde inzaai als productiegrasland; zie GG_vee. Een kruidenrijk mengsel is niet goedkoper dan BG4.";
				parameter<Eur_ha> Opruimen_veld      := ../GG_vee/Opruimen_veld, Descr = "Hetzelfde scheuren als bij productiegrasland; zie GG_vee.";
				parameter<String> Machinepark        := 'Grasland';
				parameter<Eur_ha> Inv_machines       := ../GG_vee/Inv_machines,  Descr = "Hetzelfde graslandwerktuigenpark; zie GG_vee. Het gras moet ook hier gemaaid en afgevoerd worden.";
				parameter<String> Systeem            := 'NatuurlijkGrasland';
				parameter<Eur_ha> Inv_specifiek      :=    0[Eur_ha], Descr = "Nul: natuurlijk beheerd grasland vraagt per hectare geen stal, geen mestopslag en geen eigen installatie. Status: keuze.";
				parameter<Eur_ha> Onverhandelbaar    :=    0[Eur_ha], Descr = "Nul, zie Inv_specifiek.";
				parameter<Eur_ha> Opruimen_specifiek :=    0[Eur_ha], Descr = "Nul, zie Inv_specifiek.";
			}

			container GG_vee
			: Descr = "Productiegrasland met voedergewas: LGN 1 en 2, BRP 265 en 266 en de maiscodes. Dit is de klasse waar #202 het over heeft: hier staat de stal die bij een omschakeling leeg komt te staan."
			{
				parameter<String> Veldtype           := 'Grasland';
				parameter<Eur_ha> Inv_veld           :=  916[Eur_ha], Descr = "Volledige herinzaai van grasland op zandgrond (klei 985): grondonderzoek, onkruidbestrijding, zaaizaad, startgift, spuiten, frezen, ploegen en inzaai. Bekalken zit er niet in, want dat is geen voorwaarde voor de inzaai; doorzaai is graslandvernieuwing en geen aanleg.", Source = "KWIN Veehouderij 2025-2026 blz. 137";
				parameter<Eur_ha> Opruimen_veld      :=  320[Eur_ha], Descr = "Het scheuren van de zode wanneer het perceel bouwland wordt: uit dezelfde begroting de posten die alleen over het opruimen gaan, glyfosaat, spuiten, frezen en ploegen. Beprijst alleen een
				bewerking: op veengrond mag blijvend grasland volgens GLMC 2 niet worden omgezet, en het model blokkeert akkerbouw op veenweide, behalve waar het basisjaar er al akkerbouw draagt (Templates/Landbouw/AkkerbouwOpVeen_toegestaan, #785).", Source = "KWIN Veehouderij 2025-2026 blz. 137 (33 plus 40 plus 102 plus 144); WLR rapport 1296 (2022) geeft 198 tot 213 zonder frezen";
				parameter<String> Machinepark        := 'Grasland';
				parameter<Eur_ha> Inv_machines       := 4300[Eur_ha], Descr = "Het werktuigenpark van een melkveebedrijf per hectare, afgeleid uit de afschrijving op machines per 100 kg melk maal de melkproductie per hectare, bij tien procent afschrijving per jaar als aanname.", Source = "BIN 2020, WUR-verkenning economische prestatie melkveehouderij (edepot.wur.nl/640609): 2,47 euro per 100 kg bij 17.459 kg per ha";
				parameter<String> Systeem            := 'Melkvee';
				parameter<Eur_ha> Inv_specifiek      := 10600[Eur_ha], Descr = "Ligboxenstal met mestopslag per hectare: het midden van de bandbreedte per koeplaats voor een stal van honderd melkkoeien maal de referentiedichtheid uit Melkvee_parameters/Dichtheid/Koedichtheid_referentie. Dekt ruwbouw, inrichting, melkstal, grondwerk, water en elektra; jongveehuisvesting en de melkmachine niet, dus een ondergrens.", Source = "KWIN Veehouderij 2025-2026 blz. 155 (6.800 tot 7.530 per koeplaats, maal 1,48 koe per ha); kruiscontrole WEcR factsheet 2021-019 tabel 24, 838 euro per m2 stal";
				parameter<Eur_ha> Onverhandelbaar    := 10600[Eur_ha], Descr = "De hele stalinvestering: een stal is niet te verplaatsen en heeft geen tweedehandsmarkt los van de grond. KWIN zet de restwaarde na twintig jaar expliciet op nul.";
				parameter<Eur_ha> Opruimen_specifiek :=  650[Eur_ha], Descr = "Sloop en afvoer van de stal, per m2 staloppervlakte maal het staloppervlak per melkkoe en de koedichtheid. De schrootopbrengst is niet gevonden en dus niet afgetrokken.", Source = "Lbv-plus (RVO, prijspeil 2023) 45 euro per m2 bij 9,7 m2 per koe en 1,48 koe per ha; bevestigd door DLV Advies 2019 en Alterra-rapport 2632 (2015)";
			}

			container GG_vee_intensief
			: Descr = "Plaatshouder zonder basisjaarareaal (#751), per referentie gelijk aan GG_vee en met hetzelfde systeemlabel, dus de overgang tussen beide kost nul. De klasse berustte op een veedichtheid uit
				de landbouwtelling 2014 die de BRP niet meer levert, wordt niet gealloceerd en blijft alleen bestaan om LU_ModelType niet te hernummeren. Krijgt zij ooit weer een eigen dichtheid, dan hoort
				Inv_specifiek mee te schalen en het systeemlabel te verschillen."
			{
				parameter<String> Veldtype           := ../GG_vee/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../GG_vee/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../GG_vee/Opruimen_veld;
				parameter<String> Machinepark        := ../GG_vee/Machinepark;
				parameter<Eur_ha> Inv_machines       := ../GG_vee/Inv_machines;
				parameter<String> Systeem            := ../GG_vee/Systeem;
				parameter<Eur_ha> Inv_specifiek      := ../GG_vee/Inv_specifiek;
				parameter<Eur_ha> Onverhandelbaar    := ../GG_vee/Onverhandelbaar;
				parameter<Eur_ha> Opruimen_specifiek := ../GG_vee/Opruimen_specifiek;
			}

			container Akkerbouw
			: Descr = "De restklasse akker- en tuinbouw uit #751, vertegenwoordigd door zaaiuien. Per referentie gelijk aan Aardappelen; zie daar."
			{
				parameter<String> Veldtype           := ../Aardappelen/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld;
				parameter<String> Machinepark        := ../Aardappelen/Machinepark;
				parameter<Eur_ha> Inv_machines       := ../Aardappelen/Inv_machines;
				parameter<String> Systeem            := ../Aardappelen/Systeem;
				parameter<Eur_ha> Inv_specifiek      := ../Aardappelen/Inv_specifiek;
				parameter<Eur_ha> Onverhandelbaar    := ../Aardappelen/Onverhandelbaar;
				parameter<Eur_ha> Opruimen_specifiek := ../Aardappelen/Opruimen_specifiek;
			}

			container Bollen
			: Descr = "Bloembollen, vertegenwoordigd door tulp. Deelt het veldtype en het basiswerktuigenpark met de akkerbouw, maar niet het systeem: de bollenschuur met koeling is een eigen investering. Het
				totaal van de drie componenten is het bedrag van Diogo (2015); de verdeling is nieuw. Het bezanden van een perceel tot bollengrond zit er niet in, want de klasse ligt op de percelen waar in
				het basisjaar al bollen staan."
			{
				parameter<String> Veldtype           := ../Aardappelen/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld;
				parameter<String> Machinepark        := ../Aardappelen/Machinepark, Descr = "Hetzelfde basiswerktuigenpark als de akkerbouw: trekkers, ploeg, spuit en kipwagens. De plantmachine, de rooier en de spoelinstallatie staan in Inv_specifiek.";
				parameter<Eur_ha> Inv_machines       := ../Aardappelen/Inv_machines;
				parameter<String> Systeem            := 'Bollen';
				parameter<Eur_ha> Inv_specifiek      := Diogo2015/FlowerGrowing - ../Aardappelen/Inv_veld - ../Aardappelen/Inv_machines, Descr = "Bollenschuur met koeling en ventilatie, plantmachine, rooier en spoelinstallatie: het Diogo-bedrag min de drainage en het basiswerktuigenpark. Om dit echt te maken is KWIN Bloembollen nodig, dat wel bouwstenen per m2 geeft maar geen norm voor het aantal m2 per hectare.", Source = "Diogo (2015) 36.756 min de twee akkerbouwcomponenten; KWIN Bloembollen en Bolbloemen (PPO nr. 719, prijspeil 2005) voor de bouwstenen";
				parameter<Eur_ha> Onverhandelbaar    := 20000[Eur_ha], Descr = "De schuur met de koelcellen, geschat op twee derde van Inv_specifiek; de plantmachine en de rooier zijn wel verhandelbaar. Status: aanname.";
				parameter<Eur_ha> Opruimen_specifiek :=     0[Eur_ha], Descr = "Nul: er is geen bron gevonden voor het terugbrengen van een bollenperceel naar gewoon bouwland, en een bollenschuur hoeft niet gesloopt te worden om het land anders te gebruiken. Status: ontbreekt.";
			}

			container Boomkwekerij
			: Descr = "Boomkwekerij, vertegenwoordigd door laanbomen. Zelfde opzet als Bollen: veldtype en basiswerktuigenpark van de akkerbouw, eigen systeem, totaal van Diogo."
			{
				parameter<String> Veldtype           := ../Aardappelen/Veldtype;
				parameter<Eur_ha> Inv_veld           := ../Aardappelen/Inv_veld;
				parameter<Eur_ha> Opruimen_veld      := ../Aardappelen/Opruimen_veld;
				parameter<String> Machinepark        := ../Aardappelen/Machinepark;
				parameter<Eur_ha> Inv_machines       := ../Aardappelen/Inv_machines;
				parameter<String> Systeem            := 'Boomkwekerij';
				parameter<Eur_ha> Inv_specifiek      := Diogo2015/TreeNursery - ../Aardappelen/Inv_veld - ../Aardappelen/Inv_machines, Descr = "Containerveld met folie en beregening, potmachine, koelcel en de meerjarige opstand: het Diogo-bedrag van 49.077 min de drainage en het basiswerktuigenpark, dus 42.777. Status: afgeleid van Diogo, KWIN Boomkwekerij nodig.";
				parameter<Eur_ha> Onverhandelbaar    := 30000[Eur_ha], Descr = "Het containerveld en de koelcel, geschat op twee derde van Inv_specifiek. Status: aanname.";
				parameter<Eur_ha> Opruimen_specifiek :=     0[Eur_ha], Descr = "Nul: geen bron gevonden voor het opruimen van een containerveld. Status: ontbreekt.";
			}

			container Overigen
			: Descr = "De herkomstrij voor een cel die in de herkomstkaart geen landbouwklasse draagt: buiten de landbouw, en landbouw zonder BRP- of LGN-klasse. De allocatie raakt die cellen sinds #605 bijna niet
						meer aan (Iter_Landbouw_T/Allocatie_Prep/MagLandbouwWorden). Alle bedragen nul en alle labels eigen, dus de omschakeling betaalt de volledige inrichting van de bestemming; bewust
						conservatief. Hoort niet in Classifications/Actor/LandbouwKlasses en wordt alleen via de parameters Overigen__<klasse> hieronder gelezen."
			{
				parameter<String> Veldtype           := 'Onbekend';
				parameter<Eur_ha> Inv_veld           := 0[Eur_ha];
				parameter<Eur_ha> Opruimen_veld      := 0[Eur_ha];
				parameter<String> Machinepark        := 'Geen';
				parameter<Eur_ha> Inv_machines       := 0[Eur_ha];
				parameter<String> Systeem            := 'Onbekend';
				parameter<Eur_ha> Inv_specifiek      := 0[Eur_ha];
				parameter<Eur_ha> Onverhandelbaar    := 0[Eur_ha];
				parameter<Eur_ha> Opruimen_specifiek := 0[Eur_ha];
			}
		}

		// ---- De bouwstenen als vector over de landbouwklassen, zodat de matrix ze per herkomst kan indexeren ----

		attribute<String> Veldtype           (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Veldtype', ',')+')';
		attribute<Eur_ha> Inv_veld           (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Inv_veld', ',')+')';
		attribute<Eur_ha> Opruimen_veld      (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Opruimen_veld', ',')+')';
		attribute<String> Machinepark        (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Machinepark', ',')+')';
		attribute<Eur_ha> Inv_machines       (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Inv_machines', ',')+')';
		attribute<String> Systeem            (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Systeem', ',')+')';
		attribute<Eur_ha> Inv_specifiek      (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Inv_specifiek', ',')+')';
		attribute<Eur_ha> Onverhandelbaar    (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Onverhandelbaar', ',')+')';
		attribute<Eur_ha> Opruimen_specifiek (/Classifications/Actor/LandbouwKlasses) := ='union_data(/Classifications/Actor/LandbouwKlasses, '+AsList('Bouwstenen/'+/Classifications/Actor/LandbouwKlasses/name+'/Opruimen_specifiek', ',')+')';

		// ---- De rij Overigen ----

		attribute<Eur_ha> Vanuit_Overigen (/Classifications/Actor/LandbouwKlasses) :=
			  (Bouwstenen/Overigen/Veldtype    != Veldtype    ? Inv_veld      + Bouwstenen/Overigen/Opruimen_veld : 0[Eur_ha])
			+ (Bouwstenen/Overigen/Machinepark != Machinepark ? Inv_machines                                      : 0[Eur_ha])
			+ (Bouwstenen/Overigen/Systeem     != Systeem     ? Inv_specifiek + Bouwstenen/Overigen/Opruimen_specifiek + Restwaardeverlies * Bouwstenen/Overigen/Onverhandelbaar : 0[Eur_ha])
		, Descr = "Dezelfde regel als in unit Transitiekosten, maar dan met Overigen als herkomst, dus met de vectoren aan de BESTEMMINGSkant. Omdat Overigen alle bedragen op nul heeft komt hier de volledige inrichting van de bestemming uit.";

		parameter<Eur_ha> Overigen__Rietteelt        := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Rietteelt];
		parameter<Eur_ha> Overigen__Aardappelen      := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Aardappelen];
		parameter<Eur_ha> Overigen__Bieten           := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Bieten];
		parameter<Eur_ha> Overigen__Granen           := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Granen];
		parameter<Eur_ha> Overigen__Cranberry        := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Cranberry];
		parameter<Eur_ha> Overigen__Boomgaard        := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Boomgaard];
		parameter<Eur_ha> Overigen__Moerasbomen      := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Moerasbomen];
		parameter<Eur_ha> Overigen__Rijst            := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Rijst];
		parameter<Eur_ha> Overigen__Yacon            := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Yacon];
		parameter<Eur_ha> Overigen__GG_vee_extensief := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/GG_vee_extensief];
		parameter<Eur_ha> Overigen__GG_vee           := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/GG_vee];
		parameter<Eur_ha> Overigen__GG_vee_intensief := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/GG_vee_intensief];
		parameter<Eur_ha> Overigen__Akkerbouw        := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Akkerbouw];
		parameter<Eur_ha> Overigen__Bollen           := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Bollen];
		parameter<Eur_ha> Overigen__Boomkwekerij     := Vanuit_Overigen[/Classifications/Actor/LandbouwKlasses/V/Boomkwekerij];
	}
}
