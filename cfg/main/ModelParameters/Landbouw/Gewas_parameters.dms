container per_Gewas
: Descr = "Gewasparameters van de akkerbouwklassen voor Templates/Landbouw/Akkerbouw_T. De melkveeparameters staan sinds 7 september 2026 in Melkvee_parameters.dms (#780); de container Dairy met het voedermodel uit LUS_AgriVali2011 is daarmee vervallen."
{
	container Rietteelt
	{
		container Riet
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 10[ton_ha_jaarlijks];    // Kuhlman et al. 2013
			parameter<Eur_ton>          MarketPrice                   := 120[Eur_ton];            // Kuhlman et al. 2013
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 500[Eur_Ha_jaarlijks];   // Kuhlman et al. 2013
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 500[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 0[Eur_Ha_jaarlijks];    // Geen GLB voor riet
			parameter<Ratio>            Rotation_BodemK_kleiig        := 1.0[Ratio];              // Meerjarige teelt
			parameter<Ratio>            Rotation_BodemK_zandig        := 1.0[Ratio];
		}
		container Lisdodde
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 15[ton_ha_jaarlijks];    // Geschat, WUR
			parameter<Eur_ton>          MarketPrice                   := 150[Eur_ton];            // Geschat
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 600[Eur_Ha_jaarlijks];   // Geschat
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 600[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 0[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 1.0[Ratio];
			parameter<Ratio>            Rotation_BodemK_zandig        := 1.0[Ratio];
		}
	}

	container Aardappelen
	{
		container Aardappelen  
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 43[ton_ha_jaarlijks];    // BIJ12-2024 gewogen gem.
			parameter<Eur_ton>          MarketPrice                   := 190[Eur_ton];            // BIJ12-2024 gewogen gem.
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 5357[Eur_Ha_jaarlijks], Descr = "KWIN-AGV 2026, saldoberekeningen gangbare teelten, paragraaf 6.2. Toegerekende kosten per ha, dus zonder loonwerk en arbeid; dat is precies de post die het model van de brutogeldopbrengst aftrekt. Consumptieaardappelen kleigrond IJsselmeerpolders. Stond op 3300, een schatting van 40 procent van de bruto-opbrengst.";
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 5157[Eur_Ha_jaarlijks], Descr = "Idem, consumptieaardappelen zandgrond Zuidoost. Stond op 3000.";
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks]; // RVO-GLB 2024
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.27[Ratio];             // Diogo-2015
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.48[Ratio];
		}
		
		// container Consumptieaardappelen
		// {
			// parameter<ton_ha_jaarlijks> MaxYield                      := 49.5[ton_ha_jaarlijks]; // BIJ12-2024 klei IJsselmeerp.
			// parameter<Eur_ton>          MarketPrice                   := 170[Eur_ton];          // BIJ12-2024
			// parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 3400[Eur_Ha_jaarlijks];
			// parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 3400[Eur_Ha_jaarlijks];
			// parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			// parameter<Ratio>            Rotation_BodemK_kleiig        := 0.16[Ratio];            // Diogo-2015 15.6%
			// parameter<Ratio>            Rotation_BodemK_zandig        := 0.15[Ratio];
		// }
		// container Pootaardappelen
		// {
			// parameter<ton_ha_jaarlijks> MaxYield                      := 36.0[ton_ha_jaarlijks]; // BIJ12-2024 klei-gem.
			// parameter<Eur_ton>          MarketPrice                   := 310[Eur_ton];          // BIJ12-2024
			// parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 4500[Eur_Ha_jaarlijks];
			// parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 4500[Eur_Ha_jaarlijks];
			// parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			// parameter<Ratio>            Rotation_BodemK_kleiig        := 0.12[Ratio];            // Diogo-2015 11.9%
			// parameter<Ratio>            Rotation_BodemK_zandig        := 0.04[Ratio];
		// }
		// container Zetmeelaardappelen
		// {
			// parameter<ton_ha_jaarlijks> MaxYield                      := 40.0[ton_ha_jaarlijks]; // BIJ12-2024
			// parameter<Eur_ton>          MarketPrice                   := 100[Eur_ton];          // BIJ12-2024
			// parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 1600[Eur_Ha_jaarlijks];
			// parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 1600[Eur_Ha_jaarlijks];
			// parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			// parameter<Ratio>            Rotation_BodemK_kleiig        := 0.00[Ratio];
			// parameter<Ratio>            Rotation_BodemK_zandig        := 0.29[Ratio];            // Diogo-2015 28.8%
		// }
	}

	container Bieten
	{
		container Bieten
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 89[ton_ha_jaarlijks];    // BIJ12-2024 klei-gem.
			parameter<Eur_ton>          MarketPrice                   := 45[Eur_ton];             // BIJ12-2024
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 1475[Eur_Ha_jaarlijks], Descr = "KWIN-AGV 2026, saldoberekeningen gangbare teelten, paragraaf 6.2. Toegerekende kosten per ha, dus zonder loonwerk en arbeid; dat is precies de post die het model van de brutogeldopbrengst aftrekt. Suikerbieten kleigrond IJsselmeerpolders. Stond op 1600 als schatting.";
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 1698[Eur_Ha_jaarlijks], Descr = "Idem, suikerbieten zandgrond zuidoost. Stond op 1450. Let op de richting: bij bieten liggen de kosten op zand HOGER dan op klei, omgekeerd aan de schatting die hier stond, en de opbrengst is er juist lager (80 tegen 97 ton per ha).";
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.15[Ratio];             // Diogo-2015
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.21[Ratio];
		}
	}

	container Granen
	{
		container Granen
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 9[ton_ha_jaarlijks];     // BIJ12-2024 wintertarwe-dominant
			parameter<Eur_ton>          MarketPrice                   := 225[Eur_ton];            // BIJ12-2024
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 1142[Eur_Ha_jaarlijks], Descr = "KWIN-AGV 2026, saldoberekeningen gangbare teelten, paragraaf 6.2. Toegerekende kosten per ha, dus zonder loonwerk en arbeid; dat is precies de post die het model van de brutogeldopbrengst aftrekt. Wintertarwe kleigrond zuidwest. Stond op 800 als schatting.

						KWIN rekent bij wintertarwe naast het hoofdproduct ook stro mee, 4.800 kg per ha a 0,13 euro, dus 624 euro per ha bruto. Het model kent geen bijproduct en laat dat dus liggen. Wie dat wil meenemen verhoogt MarketPrice, maar dan is dat getal niet langer de BIJ12-graanprijs die er nu staat.";
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 1235[Eur_Ha_jaarlijks], Descr = "Idem, wintertarwe zandgrond. Stond op 750.";
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.49[Ratio];             // Diogo-2015
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.29[Ratio];
		}
	}

	container Akkerbouw
	: Descr = "De restklasse akkerbouw uit #751: akker- en tuinbouwgewassen die het model niet apart noemt. Draagt het gewas Uien, want de LGN-tabel gebruikt zaai-uien al als vertegenwoordiger van overige landbouwgewassen (klasse 6, WWL_ID 13), en de opbrengstdervingscurve van de Water Wijzer Landbouw is voor dat gewas beschikbaar.

				LET OP: de twee economische kentallen hieronder zijn een plaatshouder en geen uiengetal. Zij staan gelijk aan Granen, de grootste genoemde akkerbouwklasse, zodat de restklasse een verdedigbare orde van grootte heeft in plaats van een gat. Zij bepalen de netto-opbrengst van de landbouw in de exporttabel; zolang de landbouwsector niet wordt gealloceerd is dat het enige waar zij op doorwerken. Vervang ze door uiencijfers uit dezelfde bron als de rest, BIJ12, voordat die exportpost naar buiten gaat."
	{
		container Uien
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 50[ton_ha_jaarlijks], Descr = "Zaaiuien, gemiddeld over kleigrond IJsselmeerpolders (47,5 ton per ha) en zandgrond (53). Bron: KWIN-AGV 2026, saldoberekeningen groentegewassen, paragraaf 6.3. Stond als plaatshouder gelijk aan Granen op 9.";
			parameter<Eur_ton>          MarketPrice                   := 220[Eur_ton], Descr = "Zaaiuien, 0,22 euro per kg. Zelfde bron. Stond als plaatshouder op 225.";
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 4568[Eur_Ha_jaarlijks], Descr = "Toegerekende kosten zaaiuien kleigrond IJsselmeerpolders. Zelfde bron. Stond als plaatshouder op 800.";
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 4631[Eur_Ha_jaarlijks], Descr = "Toegerekende kosten zaaiuien zandgrond. Zelfde bron. Stond op 750.";
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.17[Ratio], Descr = "MODELKEUZE, geen KWIN-getal, en hij hoort bij de regel erboven. Zaaiuien draaien in de praktijk ongeveer een op zes, en dat is wat hier staat.

						Deze twee rotatiegetallen stonden als plaatshouder op 0,49 en 0,29, overgenomen van Granen. Met de graankentallen erbij was dat onschuldig. Met de uienkentallen erbij niet: uien leveren per gewashectare ruim 6.700 euro netto tegen ruim 1.100 voor tarwe, en bij een rotatieaandeel van 0,49 zou deze restklasse elke andere akkerbouwklasse overal verslaan. De rotatie is dus niet los te zetten van de opbrengst en de prijs; wie een van de drie vervangt moet de andere twee nalopen.

						De klasse dekt meer dan uien alleen, namelijk alle akker- en tuinbouw die het model niet apart noemt (#751). Zaaiuien is de vertegenwoordiger omdat de opbrengstdervingscurve van de Water Wijzer Landbouw voor dat gewas beschikbaar is. Of een op zes de juiste weerslag is van die hele restklasse is een vraag voor het landbouwteam.";
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.17[Ratio], Descr = "Zie Rotation_BodemK_kleiig. Stond op 0,29.";
		}
	}

	container Bollen
	: Descr = "Bloembollen, vertegenwoordigd door tulp. Afgesplitst van de restklasse Akkerbouw op 5 september 2026, omdat LGN-klasse 10 al naar WWL-gewas 20 verwijst en die dervingscurve dus beschikbaar is.

				LET OP: de vijf economische kentallen hieronder zijn OVERGENOMEN van de restklasse Akkerbouw, waar deze klasse tot 5 september 2026 in zat, en dus zaaiuiengetallen. Dat is met opzet en het is geen schatting: de winst van deze klasse zit in de opbrengstdervingscurve van de Water Wijzer Landbouw, die voor Tulpen wel bestaat en voor de restklasse als geheel niet. Door de economie gelijk te houden aan de klasse waar zij uit komt, is het verschil tussen deze drie klassen zuiver hydrologisch: per cel wint het gewas dat daar het minst aan droogte of natheid verliest.

				Zij zijn dus GEEN Tulpengetallen en horen vervangen te worden. KWIN-AGV 2026 dekt ze niet, dat boek gaat over akkerbouw en vollegrondsgroenten; hiervoor is KWIN Bloembollen of KWIN Boomkwekerij nodig, of BIJ12. Let bij het vervangen op de koppeling tussen opbrengst, prijs en rotatieaandeel: die drie zijn niet los van elkaar te zetten, zie de toelichting bij Akkerbouw/Uien/Rotation_BodemK_kleiig."
	{
		container Tulpen
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 50[ton_ha_jaarlijks];    // overgenomen van Akkerbouw/Uien
			parameter<Eur_ton>          MarketPrice                   := 220[Eur_ton];            // overgenomen van Akkerbouw/Uien
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 4568[Eur_Ha_jaarlijks];  // overgenomen van Akkerbouw/Uien
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 4631[Eur_Ha_jaarlijks];  // overgenomen van Akkerbouw/Uien
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.17[Ratio];             // overgenomen van Akkerbouw/Uien
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.17[Ratio];
		}
	}

	container Boomkwekerij
	: Descr = "Boomkwekerij, vertegenwoordigd door laanbomen. Afgesplitst van de restklasse Akkerbouw op 5 september 2026, omdat LGN-klasse 61 al naar WWL-gewas 23 verwijst.

				LET OP: de vijf economische kentallen hieronder zijn OVERGENOMEN van de restklasse Akkerbouw, waar deze klasse tot 5 september 2026 in zat, en dus zaaiuiengetallen. Dat is met opzet en het is geen schatting: de winst van deze klasse zit in de opbrengstdervingscurve van de Water Wijzer Landbouw, die voor Laanbomen wel bestaat en voor de restklasse als geheel niet. Door de economie gelijk te houden aan de klasse waar zij uit komt, is het verschil tussen deze drie klassen zuiver hydrologisch: per cel wint het gewas dat daar het minst aan droogte of natheid verliest.

				Zij zijn dus GEEN Laanbomengetallen en horen vervangen te worden. KWIN-AGV 2026 dekt ze niet, dat boek gaat over akkerbouw en vollegrondsgroenten; hiervoor is KWIN Bloembollen of KWIN Boomkwekerij nodig, of BIJ12. Let bij het vervangen op de koppeling tussen opbrengst, prijs en rotatieaandeel: die drie zijn niet los van elkaar te zetten, zie de toelichting bij Akkerbouw/Uien/Rotation_BodemK_kleiig."
	{
		container Laanbomen
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 50[ton_ha_jaarlijks];    // overgenomen van Akkerbouw/Uien
			parameter<Eur_ton>          MarketPrice                   := 220[Eur_ton];            // overgenomen van Akkerbouw/Uien
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 4568[Eur_Ha_jaarlijks];  // overgenomen van Akkerbouw/Uien
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 4631[Eur_Ha_jaarlijks];  // overgenomen van Akkerbouw/Uien
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.17[Ratio];             // overgenomen van Akkerbouw/Uien
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.17[Ratio];
		}
	}

	container Boomgaard
	{
		container Boomgaard
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 35[ton_ha_jaarlijks];    // CBS/BIJ12 schatting
			parameter<Eur_ton>          MarketPrice                   := 400[Eur_ton];            // BIJ12 schatting
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 6900[Eur_Ha_jaarlijks]; // Diogo-2015 Table 5
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 6900[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 260[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 1.0[Ratio];              // Meerjarig
			parameter<Ratio>            Rotation_BodemK_zandig        := 1.0[Ratio];
		}
	}

	container Cranberry
	{
		container Cranberry
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 15[ton_ha_jaarlijks];
			parameter<Eur_ton>          MarketPrice                   := 800[Eur_ton];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 4800[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 4800[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 0[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 1.0[Ratio];
			parameter<Ratio>            Rotation_BodemK_zandig        := 1.0[Ratio];
		}
	}

	container Moerasbomen
	{
		container Moerasbomen
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 8[ton_ha_jaarlijks];
			parameter<Eur_ton>          MarketPrice                   := 80[Eur_ton];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 300[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 300[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 0[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 1.0[Ratio];
			parameter<Ratio>            Rotation_BodemK_zandig        := 1.0[Ratio];
		}
	}

	container Rijst
	{
		container Rijst
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 5[ton_ha_jaarlijks];
			parameter<Eur_ton>          MarketPrice                   := 500[Eur_ton];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 1000[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 1000[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 0[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 1.0[Ratio];
			parameter<Ratio>            Rotation_BodemK_zandig        := 1.0[Ratio];
		}
	}

	container Yacon
	{
		container Yacon
		{
			parameter<ton_ha_jaarlijks> MaxYield                      := 30[ton_ha_jaarlijks];
			parameter<Eur_ton>          MarketPrice                   := 300[Eur_ton];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_kleiig := 3600[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> ProductionCosts_BodemK_zandig := 3600[Eur_Ha_jaarlijks];
			parameter<Eur_Ha_jaarlijks> CAP_subsidy                   := 0[Eur_Ha_jaarlijks];
			parameter<Ratio>            Rotation_BodemK_kleiig        := 0.25[Ratio];
			parameter<Ratio>            Rotation_BodemK_zandig        := 0.25[Ratio];
		}
	}
}