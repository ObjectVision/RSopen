	container Yacon
	: Descr = "Yacon, exotisch gewas op kansenkaarten van WUR; kentallen zonder bron. Tot 7 september 2026 stond hier een Rotation van 0,25 die het saldo van circa 5.600 naar circa 1.400 per ha bracht; met de rotatie weg begrenst de Introductieruimte van 1.000 ha per regio de klasse. Status: ontbreekt."
	{
		container Yacon
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 30, 30, 30], Descr = "Zonder bron. Status: ontbreekt.";
			parameter<Eur_ton>          Prijs           := 300[Eur_ton], Descr = "Zonder bron. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Onbekend, nul. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 3600, 3600, 3600], Descr = "Zonder bron. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt.";
			parameter<Bool>             GLB_subsidiabel := TRUE, Descr = "Yacon staat als landbouwgrond op de RVO-gewascodelijst; bevestiging bij RVO staat als vraag open.";
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}
