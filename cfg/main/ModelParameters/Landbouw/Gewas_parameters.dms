////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
//
// Gewasparameters van de akkerbouwklassen voor Templates/Landbouw/Akkerbouw_T (#780).
//
// Elke gewascontainer per_Gewas/<klasse>/<gewas> levert dezelfde interface aan Akkerbouw_T/PerGewas_T:
//   Geldopbrengst (Bodemtak) [Eur_Ha_jaarlijks]  bruto geldopbrengst per ha bij derving nul: Opbrengst maal Prijs plus Bijproduct
//   Toegerekend   (Bodemtak) [Eur_Ha_jaarlijks]  toegerekende kosten per ha bij eigen mechanisatie (KWIN-AGV)
//   Loonwerk      (Bodemtak) [Eur_Ha_jaarlijks]  loonwerk per ha, alleen gelezen bij Kostenvoet_InclusiefLoonwerk op TRUE
//   GLB_subsidiabel          [Bool]              ontvangt het gewas de hectaresteun en de eco-regeling
// De bodemtak is Classifications/Landbouw/Bodemtak met de volgorde Geen, Klei, Zand, Veen; de kolom Geen is nul, want op cellen
// zonder bodemcode zet Akkerbouw_T de netto-opbrengst op nul. Een gewas met meer teelten (aardappelen consumptie, poot en zetmeel;
// granen wintertarwe en zomergerst) krijgt later containers Teelten/<teelt> met dezelfde bouwstenen en gewichten die per tak tot een
// sommeren; in deze ronde heeft elk gewas een teelt.
//
// Kostenvoet: saldo eigen mechanisatie, zie ModelParameters/Landbouw/Kostenvoet_InclusiefLoonwerk. Prijspeil: opbrengsten en prijzen
// uit de BIJ12-actualisatie van juni 2024 (KWIN-AGV-methodiek, vijfjaarsgemiddelden 2019-2023), kosten uit KWIN-AGV 2026; de prijzen
// komen bij de levering van KWIN-AGV 2026 uit dezelfde saldoberekening als de kosten. De rotatie is uit het saldo verdwenen: het
// klasseareaal komt uit BRP en LGN per gewas, dus een klassehectare draagt het naamgewas op de volle hectare en het bouwplanaandeel
// leeft in de claim (#780).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container per_Gewas
: Descr = "Gewasparameters van de akkerbouwklassen voor Templates/Landbouw/Akkerbouw_T, per klasse een container met een of meer gewassen; zie de kopregels van dit bestand voor de interface. De melkveeparameters staan sinds 7 september 2026 in Melkvee_parameters.dms (#780); de container Dairy met het voedermodel uit LUS_AgriVali2011 is daarmee vervallen.

			Regio-toewijzing per bodemtak (AANNAME, bij WUR te toetsen): Klei is het areaalgewogen gemiddelde van het Noordelijk, Centraal en Zuidwestelijk kleigebied voor de opbrengsten (gewichten 0,30, 0,25 en 0,45 op het CBS-bouwlandareaal) met de kosten van het Centraal kleigebied (de IJsselmeerpolders, waar KWIN-AGV de kleinste regioverschillen geeft en die de repo al had); Zand is het Zuidoostelijk zandgebied; Veen (V_W) is voor de akkerbouw dalgrond, dus het Noordoostelijk zand- en dalgrondgebied zodra KWIN-AGV daar is gelezen, en tot dan de zandkolom.

			Wat er tot 7 september 2026 stond en waarom het weg is: een kolom Rotation per gewas (0,27 voor aardappelen, 0,17 voor uien) die het saldo met het bouwplanaandeel vermenigvuldigde. Het klasseareaal is echter al het jaarlijkse gewasareaal uit BRP en LGN, dus dat telde het bouwplanaandeel tweemaal en zette de akkerbouw met een factor 2 tot 7 onder de melkvee voordat er een kental was vergeleken. De Diogo-aandelen staan als documentatie in de Descr van de klassecontainers. Een kolom CAP_subsidy (260 of 0) werd door niets gelezen; de GLB komt uit Templates/Landbouw/Suitability_T/TotaalSubsidie en de vlag GLB_subsidiabel zegt of een gewas hem ontvangt."
{
	container Rietteelt
	: Descr = "Natte teelt op veen: riet en lisdodde, twee gewassen in een klasse; Akkerbouw_T kiest per cel het beste. Beide zonder KWIN-bron: de rietgetallen komen uit de rietstudie van 2013 (Kuhlman et al.), de lisdoddegetallen zijn een schatting met WUR als aanduiding. Bij derving nul wint lisdodde (1.840 tegen 890 per ha bij GLB 190). Status: ontbreekt; bron nodig van WUR."
	{
		container Riet
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 10, 10, 10], Descr = "Kuhlman et al. 2013, rietstudie; drie bodemkolommen gelijk. Status: ontbreekt.";
			parameter<Eur_ton>          Prijs           := 120[Eur_ton], Descr = "Kuhlman et al. 2013. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 500, 500, 500], Descr = "Kuhlman et al. 2013; onbekend of dit toegerekende kosten bij eigen mechanisatie zijn. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt.";
			parameter<Bool>             GLB_subsidiabel := TRUE, Descr = "Geteeld riet staat als landbouwgrond op de RVO-gewascodelijst; het oude 'geen GLB voor riet' had geen bron en werd bovendien door niets gelezen. Bevestiging bij RVO staat als vraag open.";
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
		container Lisdodde
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 15, 15, 15], Descr = "Geschat, WUR. Status: ontbreekt.";
			parameter<Eur_ton>          Prijs           := 150[Eur_ton], Descr = "Geschat. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 600, 600, 600], Descr = "Geschat. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt.";
			parameter<Bool>             GLB_subsidiabel := TRUE, Descr = "Zie Riet.";
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Aardappelen
	: Descr = "Aardappelen, vertegenwoordigd door consumptieaardappelen. Bouwplanaandelen ter documentatie (proefschrift Pinto en Diogo 2018, tabel 3.3, BRP 2007-2012): klei consumptie 15,6, poot 11,9, zetmeel 0,3 procent; zand consumptie 14,8, poot 4,0, zetmeel 28,8 procent. Die aandelen werkten tot 7 september 2026 als Rotation 0,27 en 0,48 op het saldo en zijn daaruit verdwenen (zie per_Gewas).

				Bekende overschatting: op zand en dalgrond staat vooral zetmeel (40 ton a 100 euro, BIJ12 2024) en poot, terwijl hier op alle takken de consumptieaardappel staat; tot KWIN-AGV Noordoost en de teelten poot en zetmeel zijn gelezen is de klasse daar in de orde van 1.000 euro per ha te gunstig. De claimband is de rem. De uitgecommentarieerde teeltcontainers van voor #780 zijn verwijderd; zij komen terug als Teelten/<teelt> zodra KWIN-AGV poot en zetmeel levert."
	{
		container Aardappelen
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 47.5, 49.5, 49.5]
			, Descr = "Consumptieaardappelen, kg per ha. Bron: BIJ12 juni 2024 (KWIN-AGV-methodiek, vijfjaarsgemiddelde 2019-2023): kleigrond IJsselmeerpolders 49.500, kleigrond Zuidwest 46.500, gewogen 47.500 voor klei; zandgrond Zuidoost 49.500; veen gelijk aan zand (zie de klassecontainer). Stond op 43 als een ongedocumenteerde weging van consumptie, poot en zetmeel. Status: voorlopig.";
			parameter<Eur_ton>          Prijs           := 170[Eur_ton]
			, Descr = "Consumptieaardappelen, 0,17 euro per kg. Bron: BIJ12 juni 2024 (vijfjaarsgemiddelde 2019-2023). Ter vergelijking Eurostat apri_ap_crpouta, Nederland: 2015-2024 gemiddeld 175, 2020-2024 gemiddeld 191 euro per ton. Stond op 190. Status: voorlopig, uit KWIN-AGV 2026 te lezen samen met de kosten.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 5357, 5157, 5157]
			, Descr = "KWIN-AGV 2026, saldoberekeningen gangbare teelten, paragraaf 6.2. Toegerekende kosten per ha, dus zonder loonwerk en arbeid; dat is precies de post die het model van de brutogeldopbrengst aftrekt. Klei: consumptieaardappelen kleigrond IJsselmeerpolders 5.357 (stond op 3.300, een schatting van 40 procent van de bruto-opbrengst); zand: consumptieaardappelen zandgrond Zuidoost 5.157 (stond op 3.000); veen gelijk aan zand, aanname. Status: onderbouwd.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0]
			, Descr = "Ontbreekt: de KWIN-AGV kolom loonwerk (poten, spuiten, rooien, transport) is nog niet gelezen. Alleen gelezen bij Kostenvoet_InclusiefLoonwerk op TRUE, en juist omdat dit nul is mag die schakelaar niet aan.";
			parameter<Bool>             GLB_subsidiabel := TRUE, Descr = "Subsidiabel landbouwareaal volgens de RVO-gewascodelijst.";
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Bieten
	: Descr = "Suikerbieten. Bouwplanaandelen ter documentatie (proefschrift 2018 tabel 3.3): klei 15, zand 21 procent, tot 7 september 2026 als Rotation op het saldo."
	{
		container Bieten
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 89, 83.5, 76.5]
			, Descr = "Suikerbieten, kg per ha. Bron: BIJ12 juni 2024 (vijfjaarsgemiddelde 2019-2023): kleigrond Noord 80.000, IJsselmeerpolders 96.500, Zuidwest 90.000, gewogen 88.600 voor klei; zandgrond Zuidoost 83.500; veen: Noordelijke zand- en dalgrond 76.500. Status: voorlopig.";
			parameter<Eur_ton>          Prijs           := 45[Eur_ton]
			, Descr = "Suikerbieten, 45,23 euro per ton. Bron: BIJ12 juni 2024. Ter vergelijking Cosun 2017-2025 gemiddeld 48, Eurostat 2020-2024 49,5. De EU Agricultural Outlook 2024-2035 verwacht voor suiker een reele daling van 1,3 procent per jaar; die staat niet in VariantK/PriceMult_Bieten, dat op 1,00 blijft. Status: voorlopig.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 1475, 1698, 1698]
			, Descr = "KWIN-AGV 2026, saldoberekeningen gangbare teelten, paragraaf 6.2, toegerekende kosten per ha zonder loonwerk en arbeid. Klei: suikerbieten kleigrond IJsselmeerpolders 1.475 (stond op 1.600 als schatting); zand: suikerbieten zandgrond Zuidoost 1.698 (stond op 1.450; let op de richting, bij bieten liggen de kosten op zand hoger dan op klei en de opbrengst juist lager); veen gelijk aan zand, aanname. Status: onderbouwd, veen aanname.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt, zie Aardappelen/Loonwerk.";
			parameter<Bool>             GLB_subsidiabel := TRUE;
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Granen
	: Descr = "Granen, vertegenwoordigd door wintertarwe. Bouwplanaandelen ter documentatie (proefschrift 2018 tabel 3.3): klei 49, zand 29 procent, tot 7 september 2026 als Rotation op het saldo. Zomergerst komt als tweede teelt zodra KWIN-AGV 2026 is gelezen."
	{
		container Granen
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 9.3, 9.3, 9.3]
			, Descr = "Wintertarwe, kg per ha. Bron: BIJ12 juni 2024 (vijfjaarsgemiddelde 2019-2023): kleigrond Zuidwest en IJsselmeerpolders 9.400, zware kleigrond 9.100, gewogen 9.300; zandgrond 9.300; veen gelijk aan zand. Stond op 9. Status: voorlopig.";
			parameter<Eur_ton>          Prijs           := 230[Eur_ton]
			, Descr = "Wintertarwe, 0,23 euro per kg. Bron: BIJ12 juni 2024. Ter vergelijking Eurostat 2015-2024 gemiddeld 197, 2020-2024 gemiddeld 232; EU Agricultural Outlook tarwe reeel vlak. Stond op 225. Status: voorlopig.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 624, 624, 624]
			, Descr = "Stro: 4.800 kg per ha a 0,13 euro is 624 euro per ha. Bron: KWIN-AGV 2026, saldoberekening wintertarwe kleigrond; zand en veen hetzelfde bedrag, aanname. Bij eigen mechanisatie geen aftrek; in de stand met loonwerk hoort het persen (grootpak 15,84 per pak, KWIN Veehouderij blz. 87, circa 190 per ha) in de loonwerkregel. Tot 7 september 2026 liet het model het stro liggen. Status: onderbouwd voor klei.";
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 1142, 1235, 1235]
			, Descr = "KWIN-AGV 2026, saldoberekeningen gangbare teelten, paragraaf 6.2, toegerekende kosten per ha zonder loonwerk en arbeid. Klei: wintertarwe kleigrond Zuidwest 1.142 (stond op 800 als schatting); zand: wintertarwe zandgrond 1.235 (stond op 750); veen gelijk aan zand, aanname. Status: onderbouwd.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt, zie Aardappelen/Loonwerk.";
			parameter<Bool>             GLB_subsidiabel := TRUE;
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Akkerbouw
	: Descr = "De restklasse akkerbouw uit #751: akker- en tuinbouwgewassen die het model niet apart noemt. Draagt het gewas Uien, want de LGN-tabel gebruikt zaai-uien al als vertegenwoordiger van overige landbouwgewassen (klasse 6, WWL_ID 13), en de opbrengstdervingscurve van de Water Wijzer Landbouw is voor dat gewas beschikbaar.

				LET OP: uien vertegenwoordigen de bovenkant van LGN 6. De klasse dekt ook peen, graszaad, korrelmais, luzerne, peulvruchten en koolzaad, met lagere saldi; met alleen uien is de klasse overschat en de claimband is de rem. Tot 7 september 2026 stond hier een Rotation van 0,17 (een op zes) die dat compenseerde, maar die telde het bouwplanaandeel dubbel met het klasseareaal uit BRP en LGN (zie per_Gewas). Een mix van LGN 6-teelten als vertegenwoordiging van de restklasse staat als vraag bij WUR."
	{
		container Uien
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 47.5, 53, 53]
			, Descr = "Zaaiuien, kg per ha. Bron: KWIN-AGV 2026, saldoberekeningen groentegewassen, paragraaf 6.3: kleigrond IJsselmeerpolders 47.500, zandgrond 53.000; alleen die twee regio's, dus geen kleigemiddelde; veen gelijk aan zand. Stond tot 5 september 2026 als plaatshouder gelijk aan Granen op 9, daarna op het gemiddelde 50. Status: onderbouwd.";
			parameter<Eur_ton>          Prijs           := 220[Eur_ton]
			, Descr = "Zaaiuien, 0,22 euro per kg. Bron: KWIN-AGV 2026. Ter vergelijking Eurostat 2015-2024 gemiddeld 208, 2020-2024 gemiddeld 243. Status: onderbouwd.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 4568, 4631, 4631]
			, Descr = "Toegerekende kosten zaaiuien per ha zonder loonwerk en arbeid. Bron: KWIN-AGV 2026, paragraaf 6.3: kleigrond IJsselmeerpolders 4.568, zandgrond 4.631; veen gelijk aan zand. Status: onderbouwd.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt, zie Aardappelen/Loonwerk.";
			parameter<Bool>             GLB_subsidiabel := TRUE;
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Bollen
	: Descr = "Bloembollen, vertegenwoordigd door tulp. Afgesplitst van de restklasse Akkerbouw op 5 september 2026, omdat LGN-klasse 10 al naar WWL-gewas 20 verwijst en die dervingscurve dus beschikbaar is.

				LET OP: de economische kentallen hieronder zijn OVERGENOMEN van de restklasse Akkerbouw, waar deze klasse tot 5 september 2026 in zat, en dus zaaiuiengetallen. Dat is met opzet en het is geen schatting: de winst van deze klasse zit in de opbrengstdervingscurve van de Water Wijzer Landbouw, die voor Tulpen wel bestaat en voor de restklasse als geheel niet. Door de economie gelijk te houden aan de klasse waar zij uit komt, is het verschil tussen deze klassen zuiver hydrologisch: per cel wint het gewas dat daar het minst aan droogte of natheid verliest.

				Zij zijn dus GEEN Tulpengetallen en horen vervangen te worden. KWIN-AGV 2026 dekt ze niet, dat boek gaat over akkerbouw en vollegrondsgroenten; hiervoor is KWIN Bloembollen nodig, of BIN. Let daarbij ook op de arbeid: bollen, boomkwekerij en fruit hebben per ha veel hogere niet-toegerekende kosten (losse arbeid) dan akkerbouw en melkvee, en die staan in geen enkel saldo van dit model; zie de Descr van Totaal_NonAugmented in Akkerbouw_T."
	{
		container Tulpen
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 47.5, 53, 53], Descr = "Overgenomen van Akkerbouw/Uien; geen tulpengetal. Status: ontbreekt.";
			parameter<Eur_ton>          Prijs           := 220[Eur_ton], Descr = "Overgenomen van Akkerbouw/Uien; geen tulpengetal. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 4568, 4631, 4631], Descr = "Overgenomen van Akkerbouw/Uien; geen tulpengetal. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt.";
			parameter<Bool>             GLB_subsidiabel := TRUE;
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Boomkwekerij
	: Descr = "Boomkwekerij, vertegenwoordigd door laanbomen. Afgesplitst van de restklasse Akkerbouw op 5 september 2026, omdat LGN-klasse 61 al naar WWL-gewas 23 verwijst.

				LET OP: de economische kentallen hieronder zijn OVERGENOMEN van de restklasse Akkerbouw, waar deze klasse tot 5 september 2026 in zat, en dus zaaiuiengetallen. Dat is met opzet en het is geen schatting: de winst van deze klasse zit in de opbrengstdervingscurve van de Water Wijzer Landbouw, die voor Laanbomen wel bestaat en voor de restklasse als geheel niet. Door de economie gelijk te houden aan de klasse waar zij uit komt, is het verschil tussen deze klassen zuiver hydrologisch.

				Zij zijn dus GEEN Laanbomengetallen en horen vervangen te worden. KWIN-AGV 2026 dekt ze niet; hiervoor is KWIN Boomkwekerij nodig, of BIN. Zie Bollen voor de waarschuwing over arbeid."
	{
		container Laanbomen
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 47.5, 53, 53], Descr = "Overgenomen van Akkerbouw/Uien; geen laanbomengetal. Status: ontbreekt.";
			parameter<Eur_ton>          Prijs           := 220[Eur_ton], Descr = "Overgenomen van Akkerbouw/Uien; geen laanbomengetal. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 4568, 4631, 4631], Descr = "Overgenomen van Akkerbouw/Uien; geen laanbomengetal. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt.";
			parameter<Bool>             GLB_subsidiabel := TRUE;
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

	container Boomgaard
	: Descr = "Fruitteelt, appel en peer. Alle drie de kentallen zonder bruikbare bron: opbrengst en prijs zijn schattingen, en de 6.900 is de post jaarlijkse vaste kosten fruitteelt uit tabel 3.5 van het proefschrift (Diogo 2015, prijspeil 2011, alle vaste kosten), die in geen definitie van dit model past. KWIN Fruitteelt of BIN nodig; zie Bollen voor de waarschuwing over arbeid. Status: ontbreekt."
	{
		container Boomgaard
		{
			attribute<ton_ha_jaarlijks> Opbrengst       (/Classifications/Landbouw/Bodemtak) : [0, 35, 35, 35], Descr = "Schatting, CBS/BIJ12, zonder herleidbare bron. Status: ontbreekt.";
			parameter<Eur_ton>          Prijs           := 400[Eur_ton], Descr = "Schatting, BIJ12, zonder herleidbare bron. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Bijproduct      (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0];
			attribute<Eur_Ha_jaarlijks> Toegerekend     (/Classifications/Landbouw/Bodemtak) : [0, 6900, 6900, 6900], Descr = "Proefschrift Diogo 2015 tabel 3.5, jaarlijkse vaste kosten fruitteelt, prijspeil 2011; geen toegerekende kosten en dus niet op de kostenvoet van dit model. Status: ontbreekt.";
			attribute<Eur_Ha_jaarlijks> Loonwerk        (/Classifications/Landbouw/Bodemtak) : [0, 0, 0, 0], Descr = "Ontbreekt.";
			parameter<Bool>             GLB_subsidiabel := TRUE;
			attribute<Eur_Ha_jaarlijks> Geldopbrengst   (/Classifications/Landbouw/Bodemtak) := Opbrengst * Prijs + Bijproduct;
		}
	}

