////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
//
// Melkveeparameters voor Templates/Landbouw/Dairy_T (#780): het KWIN-saldo per koe, de grondposten per hectare per bodemtak,
// de referentiedichtheid en de mestafzet boven de gebruiksnorm. Vervangt het voedermodel uit LUS_AgriVali2011 (FCE, MaxYieldGrass,
// Perc_FeedDryMatter, TotalFeedExo, feed_composition_share, Feed_concentrates, Holding_costs, Manure_revenue) dat tot 7 september
// 2026 in per_Gewas/Dairy en per_LandbouwKlasse stond en waarvan de herkomst PBL 2016 (Dalende bodems, stijgende kosten, tabel B6) bleek.
//
// Prijspeil 2025, alle bedragen exclusief btw, reeel constant over de zichtjaren. Bronnen: KWIN Veehouderij 2025-2026 (hier KWIN-V,
// bladzijden zijn de gedrukte nummers), KWIN-AGV 2026, Handboek Melkveehouderij 2023-2024, RVO Tabel 6 (2025), CBS StatLine 80780ned.
// De status van elke parameter staat in de Descr: onderbouwd (bron citeerbaar), voorlopig (afleiding of keuze met een bron als anker),
// meting (uit de eigen basisjaarkaart, met datum en BRP-jaar).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Melkvee
: Descr = "Parameters van de melkveegeschiktheid in Templates/Landbouw/Dairy_T, naar de vier bouwstenen van het saldo per hectare: Dier (het KWIN-saldo per koe zonder grondposten), Grond (gras- en
maisopbrengst en de toegerekende kosten per hectare, per bodemtak), Dichtheid (de referentiedichtheid in melkkoeien per hectare) en Mest (de stikstofexcretie waarmee de afzet boven de
gebruiksnorm wordt berekend). Kostenvoet saldo eigen mechanisatie, zie ModelParameters/Landbouw/Kostenvoet_InclusiefLoonwerk; de loonwerkregels staan apart. De bodemafhankelijke parameters
zijn attributen op Classifications/Landbouw/Bodemtak (Geen, Klei, Zand, Veen) en worden in Dairy_T met [Bodemtak_rel] gelezen; de kolom Geen is nul en de kolom Veen is de HELP-klasse V_W,
veen en moerig (#785)."
{
	container Dier
	: Descr = "Per gemiddeld aanwezige melkkoe, uit de saldoberekening gangbaar melkvee van KWIN Veehouderij: 85 procent grasland, 15 procent mais, 9.000 kg melk, BBPR-begroting op
middellangetermijnprijzen. De splitsing in dierposten (hier) en grondposten (container Grond) is een eigen indeling: bemesting, gewasbescherming, zaaizaad en afdekking staan in KWIN in
hetzelfde saldo maar horen bij de hectare. Het loonwerk valt buiten de kostenvoet en de overige opbrengsten vervallen omdat de GLB per hectare komt (Templates/Landbouw.dms, TotaalSubsidie).
Het saldo per koe ligt circa 4 procent boven de BIN-praktijk en op het KWIN-voorbeeldbedrijf 4 procent onder de KWIN-uitkomst per hectare.", Source = "KWIN Veehouderij 2025-2026, blz. 149 (tabel) en 150 (toelichting); ijking op BIN 2022, 2023 en 2020"
	{
		parameter<ton_koe_jaarlijks> Melk_per_koe := 9.0[ton_koe_jaarlijks]
		, Descr = "Geleverde melk per gemiddeld aanwezige melkkoe per jaar, het uitgangspunt van de KWIN-saldoberekening; de voerkosten en de omzet en aanwas zijn erop begroot, dus het saldo hoort bij dit getal en niet bij een hogere praktijkwaarde.", Source = "KWIN Veehouderij 2025-2026 blz. 149 en 150; ter vergelijking CRV 9.103 kg, ZuivelNL 9.300 kg in 2024";

		parameter<Eur_ton> MilkPrice := 490[Eur_ton]
		, Descr = "Melkprijs exclusief btw, euro per 100 kg, de KWIN-prognose voor de komende tien jaar; in Dairy_T vermenigvuldigd met VariantParameters/VariantK/PriceMult_Melk, in alle varianten 1,00 (EU
Agricultural Outlook 2024-2035: melk reeel vlak). Gevoeligheidsstanden voor PriceMult_Melk: 0,94 (WSER-saldoreeks 2020-2024) en 0,84 (tienjaarsgemiddelde). Het prijspeil verschilt van de
akkerbouw, waarvan de prijzen tot de levering van KWIN-AGV 2026 op BIJ12 vijfjaarsgemiddelden 2019-2023 staan; de rangorde melkvee boven aardappelen op klei hangt van dat venster af en is
een besluit voor de opdrachtgever in #780.", Source = "KWIN Veehouderij 2025-2026 blz. 115 en 150; WUR-panel april 2026 51,50; WSER 2015-2024 gemiddeld 41,07";

		parameter<Eur_koe_jaarlijks> Omzet_en_aanwas := 465[Eur_koe_jaarlijks]
		, Descr = "Omzet en aanwas per melkkoe: stierkalf, vaarskalf, drachtige vaars en slachtkoe. KWIN prijst alle afgevoerde koeien tegen de slachtkoeprijs terwijl een deel uitval met een zeer lage opbrengst is, dus dit bedrag is circa 40 per koe te hoog.", Source = "KWIN Veehouderij 2025-2026 blz. 150 (0,57 stierkalf a 150, 0,20 vaarskalf a 75, 0,02 vaars a 1.700, 0,30 slachtkoe a 1.100); BIN meerjarig 300 tot 350";

		parameter<Eur_koe_jaarlijks> Dierkosten := 1656[Eur_koe_jaarlijks]
		, Descr = "Toegerekende dierposten per melkkoe: voer inclusief al het krachtvoer, strooisel, reinigingsmiddelen, water, elektriciteit en veekosten; daarom kent het model geen apart krachtvoerspoor.
Niet inbegrepen: de grondposten uit hetzelfde saldo (per hectare in Grond/Graslandkosten en Grond/Maiskosten), de afrastering (apart), het loonwerk (buiten de kostenvoet) en de overige
opbrengsten (de GLB komt per hectare).", Source = "KWIN Veehouderij 2025-2026 blz. 149 en 150 (voer 1.133, strooisel 38, reiniging 16, water 47, elektriciteit 108, veekosten 314)";

		parameter<Eur_koe_jaarlijks> Afrastering := 70[Eur_koe_jaarlijks]
		, Descr = "Afrastering per melkkoe. Bron: KWIN-V blz. 149. Zit noch in de graslandnorm van 1.105 per ha (blz. 108) noch in Dierkosten, en staat daarom apart. In werkelijkheid schaalt afrastering met de perceelsomtrek en niet met de koe; bij een vaste referentiedichtheid maakt dat niets uit, bij de latere koedichtheid per gemeente wel. Status: onderbouwd.";

		parameter<ton_koe_jaarlijks> Ruwvoer_per_koe := 6.5[ton_koe_jaarlijks]
		, Descr = "Ruwvoerbehoefte per melkkoe inclusief jongvee, in ton droge stof per jaar, naast het krachtvoer uit Dierkosten. Een afleiding en geen KWIN-getal: het energieminimum via CVB-normen geeft 5,8
ton, de praktische opname uit het Handboek Melkveehouderij 6,3 tot 7,0, en 6,5 ligt in het midden. Met 6,5 komt de draagkracht bij derving nul tussen de referentiedichtheid van 1,48 en de
LMM-dichtheid van melkveebedrijven uit. Voorlopig; vraag aan WUR.", Source = "CVB-normen, KWIN Veehouderij 2025-2026 blz. 126, 128 en 194, Handboek Melkveehouderij hoofdstuk 6";
	}

	container Grond
	: Descr = "Grondposten per hectare, per bodemtak (Geen, Klei, Zand, Veen), op de kostenvoet eigen mechanisatie; de loonwerkregels staan apart en worden alleen bij
					ModelParameters/Landbouw/Kostenvoet_InclusiefLoonwerk op TRUE gelezen. Het voeraanbod is grasopbrengst maal de verliesfactoren maal het grasaandeel, plus maisopbrengst maal het inkuilverlies
					maal het maisaandeel; het bouwplan van gg_vee komt uit Aandeel_mais. Natuurlijk grasland (gg_vee_extensief) heeft een eigen opbrengst, geen mais, geen bemesting en verkoopt zijn gras op
					stam."
	{
		attribute<ton_ha_jaarlijks> Grasopbrengst_bruto (/Classifications/Landbouw/Bodemtak) : [0, 11.6, 11.9, 11.1]
		, Descr = "Bruto droge-stofopbrengst van productiegrasland per bodemtak, gemaaid, voor veld- en inkuilverliezen; de rij advies min 100 kg N, omdat de gebruiksnormen zonder derogatie onder het maximale
N-regime liggen. Bewust de rij zand vochthoudend en niet zand droog, omdat de opbrengstderving van de Water Wijzer Landbouw de droogte per cel al rekent en droog zand anders dubbel telt; of
die derving ten opzichte van de potentie of van de praktijkopbrengst is gedefinieerd staat als vraag bij Deltares.", Source = "Handboek Melkveehouderij 2023-2024, hoofdstuk 3, tabel 3.10, rij advies min 100 N (klei 11.600, zand 11.900, veen 11.100 kg ds)";

		parameter<Ratio> Verlies_veld_inkuil := 0.907[Ratio]
		, Descr = "Fractie van de bruto grasopbrengst die na veld- en inkuilverlies overblijft: veldverlies 5,3 procent en inkuilverlies 4,2 procent droge stof, (1 - 0,053) x (1 - 0,042) = 0,907. Bron: KWIN-V blz. 126. Status: onderbouwd.";

		parameter<Ratio> Verlies_beweiding := 0.95[Ratio]
		, Descr = "Fractie van de grasopbrengst die na beweidingsverlies overblijft. Aanname: ongeveer de helft van het gras wordt beweid en het beweidingsverlies op dat deel is 15 tot 25 procent, dus 10
					procent op de helft. Voorlopig; vraag aan WUR om een netto benutbare opbrengst per grondsoort inclusief beweiding, dan vervallen deze factor en Verlies_veld_inkuil samen.", Source = "KWIN Veehouderij 2025-2026 blz. 140 (kuil bij weiden plus maaien tegen alleen maaien), Handboek Melkveehouderij hoofdstuk 6";

		parameter<ton_ha_jaarlijks> Grasopbrengst_natuurlijk := 5.0[ton_ha_jaarlijks]
		, Descr = "Netto benutbare droge-stofopbrengst van natuurlijk beheerd grasland (LGN 45, BRP 331, 332 en 1926), de klasse gg_vee_extensief; netto, want het gras wordt in Dairy_T op stam verkocht en de koper oogst. Voorlopig; vraag aan WUR om opbrengst en voederwaarde van natuurlijk beheerd grasland.", Source = "KWIN Veehouderij 2025-2026 blz. 194, laagste trede van de zoogkoeientabel (5 ton ds draagt 0,8 zoogkoe), onderliggend PraktijkRapport 1 (2002)";

		attribute<Ratio> Aandeel_mais (/Classifications/Landbouw/Bodemtak) : [0, 0.117, 0.269, 0.091]
		, Descr = "Aandeel van de hectare gg_vee dat mais draagt, per bodemtak: het bouwplanaandeel binnen de klasse, geen vruchtwisseling. Bepaald op de eigen basisjaarkaart over de gg_vee-cellen met een
BRP-perceel, omdat het saldo het bouwplan van een geregistreerd melkveebedrijf beschrijft; op de moerige gronden binnen V_W staat wel degelijk mais. Op natuurlijk grasland zet Dairy_T het
maisaandeel op nul.", Source = "BRP 2025 (maiscodes 259, 316, 317, 1935) op LGN 2025, met de bodemtak uit SourceData/Landbouw/HELP/Bodem_HELP, via Diagnose/PerIssue/Diagnose780/Metingen/Tabel_Mais";

		attribute<Ratio> Aandeel_gras (/Classifications/Landbouw/Bodemtak) := 1[Ratio] - Aandeel_mais
		, Descr = "Het grasaandeel, het complement van Aandeel_mais; de twee sommeren binnen de klasse tot een.";

		attribute<Eur_Ha_jaarlijks> Graslandkosten (/Classifications/Landbouw/Bodemtak) : [0, 510, 474, 434]
		, Descr = "Toegerekende kosten van productiegrasland per hectare zonder loonwerk, per bodemtak: bemesting, kuilafdekking en herinzaai en graslandverzorging op klei uit de KWIN-graslandnorm, met zand en
veen afgeleid via het N-advies per grondsoort. De norm is bedoeld voor schapen, geiten en zoogkoeien bij 200 procent maaien, bevat in de post herinzaai ongeveer de helft loonwerk (niet
gecorrigeerd) en komt uit een ander KWIN-saldo dan de dierkosten, waardoor het model melkvee circa 6 procent van het saldo zwaarder rekent dan zijn eigen bron; het alternatief, de
grondposten van het melkveesaldo per koe maal de koedichtheid, hoort als besluit in #780.", Source = "KWIN Veehouderij 2025-2026 blz. 108 (bemesting 335, afdekking 30, herinzaai 145), N-advies Handboek Melkveehouderij tabel 3.10, overige bemesting blz. 135";

		parameter<Eur_Ha_jaarlijks> Graslandkosten_loonwerk := 595[Eur_Ha_jaarlijks]
		, Descr = "Loonwerk op productiegrasland per hectare, alleen gelezen bij Kostenvoet_InclusiefLoonwerk op TRUE. Geen volledige loonwerkregel: de norm telt alleen mest uitrijden, inkuilen en sloten reinigen, terwijl maaien, wiersen en kunstmest strooien ontbreken; zolang die er niet bij staan zet TRUE gras 150 tot 250 per ha lichter dan mais en akkerbouw.", Source = "KWIN Veehouderij 2025-2026 blz. 108 (zodenbemester 165, grashakselaar 390, sloten 40); ontbrekende bewerkingen op blz. 87";

		parameter<Eur_Ha_jaarlijks> Graslandkosten_natuurlijk := 0[Eur_Ha_jaarlijks]
		, Descr = "Toegerekende kosten van natuurlijk beheerd grasland per hectare: geen bemesting, geen herinzaai, geen kuilafdekking, want het gras wordt op stam verkocht en de koper oogst. Slootonderhoud (40 per ha, loonwerk in KWIN-V blz. 108) valt aan beide kanten buiten het saldo; de akkerbouw draagt die post ook niet. Status: voorlopig, een keuze zonder KWIN-tegenhanger.";

		attribute<ton_ha_jaarlijks> Maisopbrengst_bruto (/Classifications/Landbouw/Bodemtak) : [0, 14.2, 14.6, 14.6]
		, Descr = "Droge-stofopbrengst snijmais per bodemtak, voor inkuilverlies. Veen krijgt de zandwaarde, aanname: de mais binnen V_W staat op de moerige en dalgronden en niet in het veenweidegebied. De editie waaruit de kleiwaarde komt moet bij de levering van KWIN-AGV 2026 worden bevestigd, want BIJ12 (2024) citeert voor klei 15.100 kg.", Source = "KWIN-AGV 2026, saldoberekening snijmais (kleigrond 14.200, goede zandgrond 14.600 kg ds)";

		parameter<Ratio> Verlies_inkuil_mais := 0.95[Ratio]
		, Descr = "Fractie van de bruto maisopbrengst die na inkuilen overblijft: inkuilverlies snijmais 5 procent droge stof. Bron: KWIN-V blz. 125 en 146. Status: onderbouwd.";

		attribute<Eur_Ha_jaarlijks> Maiskosten (/Classifications/Landbouw/Bodemtak) : [0, 885, 892, 892]
		, Descr = "Toegerekende kosten snijmais per hectare zonder loonwerk, per bodemtak; veen gelijk aan zand (aanname, zie Maisopbrengst_bruto). Het loonwerk staat apart in Maiskosten_loonwerk, zodat gras en mais op dezelfde voet staan.", Source = "KWIN-AGV 2026, saldoberekening snijmais (kleigrond 885, zandgrond 892)";

		attribute<Eur_Ha_jaarlijks> Maiskosten_loonwerk (/Classifications/Landbouw/Bodemtak) : [0, 1232, 1177, 1177]
		, Descr = "Loonwerk snijmais per hectare, alleen gelezen bij Kostenvoet_InclusiefLoonwerk op TRUE; klei plus 55 volgens de voetnoot, veen gelijk aan zand. Bij de levering van KWIN-AGV 2026 te vervangen door de kolom loonwerk van de saldoberekening snijmais.", Source = "KWIN Veehouderij 2025-2026 blz. 144, kolom snijmais op zandgrond (ploegen 144, zaaiklaar 82, zaaien 95, spuiten 40, oogsten 595, aanrijden 100, cultivateren 82, sloot 39)";

		parameter<Eur_ton> Prijs_ruwvoer_aankoop := 160[Eur_ton]
		, Descr = "Aankoopprijs van ruwvoer bij een tekort, per ton droge stof: ingekuilde snijmais geleverd 0,16 euro per kg ds. Bron: KWIN-V blz. 125. Stond in het oude voedermodel als Price_fresh_ton 56 gedeeld door een drogestofgehalte 0,35. Status: onderbouwd.";

		parameter<Eur_ton> Prijs_ruwvoer_verkoop := 101[Eur_ton]
		, Descr = "Verkoopprijs van een ruwvoeroverschot van productiegrasland, per ton droge stof: gras op stam. In de tekstextractie van de pdf staan de labels van de tabel een regel boven hun getallen; de
toewijzing is gecontroleerd op de optelling (verkoop op stam plus oogst in loonwerk is de aankoopprijs), controle in de pdf zelf staat open. KWIN zelf: er wordt weinig gras verhandeld.", Source = "KWIN Veehouderij 2025-2026 blz. 126, tabel prijzen gras (verkoop op stam 325 per ha, 0,101 per kg ds)";

		parameter<Eur_ton> Prijs_natuurgras := 75[Eur_ton]
		, Descr = "Verkoopprijs van gras van natuurlijk beheerd grasland, op stam, per ton droge stof. AFLEIDING: KWIN-V blz. 196 waardeert eigen gras voor zoogkoeien op 0,10 euro per kVEM en blz. 194 zet natuurgraskuil op 750 VEM per kg ds, dus 75 per ton ds. De route via gras op stam (0,112 per kVEM, blz. 126) geeft 84 als bovengrens. Verving 98, wat de prijs van gras van 945 VEM was. Status: voorlopig.";
	}

	container Dichtheid
	: Descr = "De koedichtheid waarmee de geschiktheid rekent: melkkoeien per hectare van een gemiddelde productiehectare (grasland zonder natuurlijk grasland, plus voedergewas), gelijk voor de drie
					bodemtakken. Een referentiedichtheid en niet de dichtheid van vandaag, want de allocator mag niet belonen dat een regio nu intensiever is. Voor een volgende ronde vervangen de
					CBS-koedichtheid per gemeente (StatLine 80781ned) en een regime per variant alleen Dairy_T/Koedichtheid."
	{
		parameter<koe_ha> Koedichtheid_referentie := 1.48[koe_ha]
		, Descr = "Melk- en kalfkoeien per hectare productiegrasland plus voedergewas, Nederland 2023. Natuurlijk grasland staat niet in de noemer omdat het in dit model de klasse gg_vee_extensief met nul melkkoeien is; met natuurlijk grasland erin is het 1,35. Per provincie loopt het uiteen van 1,06 (Zeeland) tot 1,90 (Flevoland).", Source = "CBS StatLine 80780ned, 2023: 1.573.787 koeien op 957.765 ha grasland min 89.610 ha natuurlijk grasland plus 195.256 ha groenvoedergewas";

		attribute<Ratio> f_bodem (/Classifications/Landbouw/Bodemtak) : [0, 1.00, 1.00, 1.00]
		, Descr = "Bodemfactor op de referentiedichtheid: geen, een keuze. De LMM-verhoudingen op melkveebedrijven beschrijven de intensiteit van bedrijven en niet van de gemiddelde hectare; over alle
					bedrijven geeft CBS voor de veen-, zand- en kleiprovincies vrijwel dezelfde koedichtheid. De productiviteit van de bodem werkt al via Grasopbrengst_bruto en de voerbalans, dus een
					bodemfactor zou de bodem tweemaal tellen. De LMM-waarden (klei 0,99, zand 1,06, veen 0,86) zijn de gevoeligheidsstand; de kolom Geen is nul.", Source = "Agrimatie 2024 (LMM meetmelk per ha voedergewas per grondsoort), CBS 80780ned 2023 per provincie";

		attribute<koe_ha> D_ref (/Classifications/Landbouw/Bodemtak) := Koedichtheid_referentie * f_bodem
		, Descr = "De dichtheid van een gemiddelde productiehectare per bodemtak, dus 1,48 op klei, zand en veen. Alternatief dat als vraag bij Deltares ligt: D_ref gelijk aan de draagkracht bij derving nul (1,60, 1,73, 1,53), waarmee elke ton derving direct 160 euro voeraankoop kost in plaats van eerst een overschot te verkleinen. Status: keuze, voorlopig.";
	}

	container Mest
	: Descr = "Stikstofexcretie per melkkoe inclusief jongvee, waarmee Dairy_T de mestafzet boven de gebruiksnorm berekent: koedichtheid maal excretie is de productie in kg N per ha, en het deel boven de
gebruiksnorm wordt tegen de mestprijs afgevoerd; het grondgebonden punt ligt bij 1,10 koe per ha. Fosfaat is niet bindend (het omslagpunt ligt bij 1,7 koe per ha) en staat alleen hier.", Source = "RVO Tabel 6 (fosfaat 43,5 kg per melkkoe), KWIN Veehouderij 2025-2026 blz. 32 (jongvee) en 39 (fosfaatgebruiksnorm 95 kg per ha)"
	{
		parameter<kg_koe_jaarlijks> N_excretie_melkkoe := 116.5[kg_koe_jaarlijks]
		, Descr = "Forfaitaire stikstofexcretie van een melkkoe met 9.000 kg melk (klasse 8.875 tot 9.124 kg, ureum 20), de wettelijke productie waarmee de gebruiksnorm wordt getoetst; een correctie voor gasvormige verliezen bestaat alleen voor staldieren. Bij ureum 22 zou het 120,0 zijn.", Source = "RVO Tabel 6 Stikstof en fosfaat per melkkoe 2025 (drijfmest), gelijk aan KWIN Veehouderij 2025-2026 blz. 35";

		parameter<kg_jaarlijks> N_excretie_kalf := 32.3[kg_jaarlijks]
		, Descr = "Forfaitaire stikstofexcretie van jongvee jonger dan een jaar, kg N per dier per jaar, drijfmest. Bron: KWIN-V blz. 32 (RVO Tabel 4). Status: onderbouwd.";

		parameter<kg_jaarlijks> N_excretie_pink := 66.9[kg_jaarlijks]
		, Descr = "Forfaitaire stikstofexcretie van jongvee van een jaar en ouder, kg N per dier per jaar, drijfmest. Bron: KWIN-V blz. 32 (RVO Tabel 4). Status: onderbouwd.";

		parameter<Float32> Kalveren_per_koe := 0.38f
		, Descr = "Stuks jongvee jonger dan een jaar per melkkoe. Bron: KWIN-V blz. 122: bij 30 procent vervanging 7,6 stuks jongvee per 10 melkkoeien; de verdeling half om half over kalveren en pinken is een aanname. Status: voorlopig.";

		parameter<Float32> Pinken_per_koe := 0.38f
		, Descr = "Stuks jongvee van een jaar en ouder per melkkoe. Zie Kalveren_per_koe. Status: voorlopig.";

		parameter<kg_koe_jaarlijks> N_excretie_per_koe := N_excretie_melkkoe + (Kalveren_per_koe * N_excretie_kalf + Pinken_per_koe * N_excretie_pink) / 1[koe]
		, Descr = "Stikstofexcretie per melkkoe inclusief het bijbehorende jongvee: 116,5 + 0,38 x 32,3 + 0,38 x 66,9 = 154,2 kg N per koe per jaar. Afgeleid.";

		parameter<kg_m3> N_per_m3 := 4.0[kg_m3]
		, Descr = "Stikstofgehalte van rundveedrijfmest, kg N per m3. Bron: KWIN-V blz. 30 (rundvee dunne mest 4,0 kg N per ton bij 1.005 kg per m3) en het rekenvoorbeeld op blz. 44. Status: onderbouwd.";
	}
}
