// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De scenario-as van de WWL-schaderelatie, gesplitst in klimaat en groei (#782).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Scenario
: Descr = "Welk scenario de WWL-schaderelatie leest, gesplitst in een klimaathelft en een groeihelft (#782). In de relatiedatabase heet de niet-referentiepositie WarmHoog: Warm is het klimaatscenario
			en Hoog de hoge groei van woningen en banen uit WLO_hoog, en beide gelden in deze studie voor alle varianten, dus ze horen hier en niet in VariantK. De twee helften zijn niet onafhankelijk
			in te stellen, want Classifications/Landbouw/WWL_Klimaatscenarios kent alleen Referentie (1991-2020) en WarmHoog (2036-2065), de twee klimaatbanden in de netcdf. Deze parameters sturen
			alleen de klimaatband van de schaderelatie; de grondwaterstanden waarmee die wordt afgelezen komen per variant uit VariantParameters/VariantK/Hydrologie_Levering."
{
	parameter<string> Klimaat_name := 'Warm'
	, Descr = "Het klimaatscenario: Warm kiest de band 2036-2065 van de relatiedatabase, Referentie de band 1991-2020. Volgens #782 kijkt deze studie in alle varianten naar Warm. Dat is niet hetzelfde als
				het klimaat van de grondwaterstanden: BAU2 leest de referentiestanden (R2050BP18 en R2085BP18) en rekent daarop een warme schaderelatie; of BAU2 daarmee nog de bedoelde gevoeligheidsvariant
				is staat open in #782.";

	parameter<string> Groei_name := first(/Classifications/Modellering/ScenarioK/TableRef) == 'hoog' ? 'Hoog' : 'Laag'
	, IntegrityCheck = "#(/Classifications/Modellering/ScenarioK) == 1"
	, Descr = "De groeihelft, afgeleid uit het scenario dat het model draait en niet als tekst herhaald. ScenarioK telt op dit moment een rij, WLO_hoog met TableRef hoog, en dat levert Hoog op. De IntegrityCheck valt om zodra er een tweede scenario bij komt, want dan zegt first() niet meer welk scenario de casus draait en moet deze parameter per casus worden opgehaald.";

	parameter<string> Basisjaar_name := 'Referentie'
	, Descr = "Welk scenario het basisjaar leest. Referentie, want het basisjaar is waargenomen en niet geprojecteerd: SourceData/Water/Grondwaterstanden zet er voor elke variant REF2017BP18 op, en de schaderelatie hoort daarbij te passen. Deltares bevestigt dat in #782.";

	parameter<string> WarmHoog := Klimaat_name == 'Referentie' ? 'Referentie' : Klimaat_name + Groei_name
	, Descr = "De combinatie van de twee helften, de naam van de band in de relatiedatabase, die letterlijk gelijk moet zijn aan een naam in Classifications/Landbouw/WWL_Klimaatscenarios. De tak naar
				Referentie staat er omdat die band geen groeihelft in haar naam draagt. Zet iemand Klimaat_name op iets anders dan Warm, dan draagt dit item een andere waarde dan zijn naam belooft.";

	parameter</Classifications/Landbouw/WWL_Klimaatscenarios> WarmHoog_rel := rlookup(WarmHoog, /Classifications/Landbouw/WWL_Klimaatscenarios/name)
	, IntegrityCheck = "IsDefined(WarmHoog_rel)"
	, Descr = "De band in de relatiedatabase die bij de combinatie hoort. De check valt om bij een naam die de database niet kent, en dat is de enige plek waar een verkeerd gezette Klimaat_name nog zichtbaar wordt: verderop wordt dit alleen nog een bandnummer.";

	parameter</Classifications/Landbouw/WWL_Klimaatscenarios> Basisjaar_rel := rlookup(Basisjaar_name, /Classifications/Landbouw/WWL_Klimaatscenarios/name)
	, IntegrityCheck = "IsDefined(Basisjaar_rel)";
}
