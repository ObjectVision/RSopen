//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Regenwaterhergebruik
: Descr = "Parameters van de indicator regenwaterhergebruik (#507, Templates/Indicatoren/Regenwaterhergebruik.dms): de systeemcurves van Deltares per provincie en daktype, de drinkwatervraag per
			woning, het deel daarvan dat met regenwater kan, de tank per woning en het besparingsdoel. Ze staan hier bij elkaar zodat ze in de metadata-export van een levering verschijnen
			(ExportSettings.dms)."
{
	parameter<UInt32> Herhalingstijd := 5
	, IntegrityCheck = "this == 1 || this == 2 || this == 5 || this == 10 || this == 20 || this == 50 || this == 100"
	, Descr = "Welke systeemcurves de indicator leest: eens in hoeveel jaar de tank langer dan zeven dagen achter elkaar leeg mag staan. Een kortere herhalingstijd is een ruimere norm en geeft bij
				dezelfde tank een grotere besparing; Deltares stelt voorlopig vijf jaar voor (#507)."
	, Source = "Deltares, systeemcurves van het RWH-model per provincie en daktype, levering van 9 oktober 2026; de keuze voor vijf jaar: Deltares in #507, 14 oktober 2026";

	parameter<m3_Woning_jaar> DrinkwatervraagPerWoning := 108.8[m3_Woning_jaar]
	, Descr = "Het drinkwatergebruik van een huishouden per jaar; het model telt een woning als een huishouden."
	, Source = "Deltares (2023), Huishoudelijk regenwaterhergebruik, rapport 11208014-029-BGS-0001, paragraaf 3.3.1: Vitens leverde in 2020 283 mln m3 aan 2,6 mln huishoudens (Vewin, 2022)";

	parameter<Float32> AandeelVervangbaar := 0.45f
	, IntegrityCheck = "this > 0f && this <= 1f"
	, Descr = "Welk deel van het drinkwatergebruik met regenwater kan: tuin, toilet en wasmachine. Begrenst de besparing per cel."
	, Source = "Deltares (2023), Huishoudelijk regenwaterhergebruik, tabel 4, ambitieniveau 3";

	parameter<m3_Woning> TankPerWoning := 5[m3_Woning]
	, IntegrityCheck = "this > 0[m3_Woning]"
	, Descr = "De tank per woning in de eerste vraag van de indicator: wat bespaart een vaste tank. Het dak van de cel begrenst wat hij levert, dus een gestapelde woning met weinig dak bespaart met
				dezelfde tank veel minder."
	, Source = "De Vlaamse verplichting voor een eengezinswoning van meer dan 40 m2 dak, een hemelwaterput van ten minste 5.000 liter, aangehaald in Deltares (2023), Huishoudelijk regenwaterhergebruik, paragraaf 1.1";

	parameter<Float32> Besparingsdoel := 0.20f
	, IntegrityCheck = "this > 0f && this <= AandeelVervangbaar"
	, Descr = "Het besparingsdoel in de tweede vraag van de indicator: welke tank per woning dit deel van het drinkwatergebruik met regenwater dekt. Kan het dak dat bij geen enkele tankgrootte
				leveren, dan telt de woning als niet haalbaar."
	, Source = "Beleidsbrief Water en Bodem sturend (IenW, 2022): 20 procent minder drinkwatergebruik per persoon in 2035, aangehaald in Deltares (2023), Huishoudelijk regenwaterhergebruik, paragraaf 1.1";

	parameter<mm> MaximaleTank := 500[mm]
	, IntegrityCheck = "this > 0[mm]"
	, Descr = "De grootste tank, in mm over het aangesloten dak, die de tweede vraag van de indicator toelaat; 500 mm is 0,5 m3 per m2 dak. Daarboven is de systeemcurve een extrapolatie, en bij een
				vraag vlak onder het plafond van de curve loopt de benodigde tank naar oneindig. Een woning die een grotere tank nodig heeft telt als niet haalbaar."
	, Source = "Deltares in #507, 14 oktober 2026: de simulaties achter de systeemcurves van 9 oktober lopen van 1 tot 500 mm tank, en boven ongeveer 1.000 mm levert een grotere tank weinig meer op";

	unit<UInt8> Daktype : NrOfRows = 3
	, Descr = "De drie daktypen van de systeemcurves. Bij gelijke oppervlakken in een cel wint de eerste rij."
	{
		attribute<String> name     : ['schuin', 'plat', 'groen'];
		attribute<String> Levering : ['sloped_roof', 'flat_roof', 'green_roof'], Descr = "De map van dit daktype in de levering van Deltares.";
		attribute<String> Label    := name;

		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}

	unit<UInt32> Systeemcurve : NrOfRows = 252
	, Descr = "De parameters van de systeemcurve y = a * x^n / (x^n + b) per provincie, daktype en herhalingstijd. x is de tank in mm over het aangesloten dak, y de drinkwatervraag in mm per jaar
				die de tank dekt met de leveringszekerheid van de herhalingstijd: niet vaker dan eens in die tijd langer dan zeven dagen achter elkaar leeg. De provincies dienen als grove
				klimaatzones. Met een script uit de csv-bestanden van de levering overgenomen."
	, Source = "Deltares, RWH-model (github.com/daanrooze/RWHmodel), map 2026-10-09 RESULTS bij #507"
	{
		parameter<UInt32> nrAttr := 6;
