		attribute<String>  Provincie      := Elements/Text[value(uint32(id(.)) * nrAttr + 0, Elements)];
		attribute<String>  Daktype_name   := Elements/Text[value(uint32(id(.)) * nrAttr + 1, Elements)];
		attribute<UInt32>  Herhalingstijd := uint32(float64(Elements/Text[value(uint32(id(.)) * nrAttr + 2, Elements)]));
		attribute<Float32> a              := float32(float64(Elements/Text[value(uint32(id(.)) * nrAttr + 3, Elements)])), Descr = "Het plafond van de curve in mm per jaar: wat het dak bij een oneindige tank levert.";
		attribute<Float32> b              := float32(float64(Elements/Text[value(uint32(id(.)) * nrAttr + 4, Elements)]));
		attribute<Float32> n              := float32(float64(Elements/Text[value(uint32(id(.)) * nrAttr + 5, Elements)]));

		attribute</SourceData/RegioIndelingen/Provincie> Provincie_rel := rlookup(Provincie, /SourceData/RegioIndelingen/Provincie/name), IntegrityCheck = "all(IsDefined(this))";
		attribute<Daktype>                               Daktype_rel   := rlookup(Daktype_name, Daktype/name), IntegrityCheck = "all(IsDefined(this))";
	}

	unit<UInt32> CurveGekozen := select_with_attr_by_cond(Systeemcurve, Systeemcurve/Herhalingstijd == Herhalingstijd)
	, Descr = "De curves van de gekozen herhalingstijd, een per provincie en daktype."
	{
		attribute<UInt32> Sleutel := uint32(Provincie_rel) * #Daktype + uint32(Daktype_rel)
		, IntegrityCheck = "sum_uint32(IsDefined(this)) == #/SourceData/RegioIndelingen/Provincie * #Daktype"
		, Descr = "Provincie maal daktype, de sleutel waarop de indicator per cel zoekt. De controle eist een curve voor elke provincie en elk daktype, dus ook dat de gekozen herhalingstijd geleverd is.";
	}
}
