// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Waarop de banenclaim wordt geankerd. Zie #667.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container ClaimBasisjaar
: Descr = "Waarop de banenclaim wordt geankerd: op het niveau dat TIGRIS voor het basisjaar geeft, of op de waargenomen LISA-trend in datzelfde jaar (#667). RSopen begint met de LISA-stand van het
			basisjaar en zet die af tegen een claim uit een TIGRIS-pad; liggen die uit elkaar, dan wordt dat verschil in het eerste zichtjaar een overschot dat er nooit meer uit gaat, want het model kan
			geen banen laten krimpen. Op het totaal is het verschil conjunctureel en geen niveaufout in TIGRIS, dus ankeren op de waarneming van 2023 zou een hoogconjunctuur in de claim planten; per
			subsector blijft een verschil staan dat landelijk tot nul optelt, en dat corrigeert deze schakelaar."
{
	parameter<String> Anker := 'TrendLISARegio'
	, Descr = "Drie waarden. TIGRIS is de terugvalstand en het gedrag van voor #667: de claim is het niveau dat de levering geeft. TrendLISA schaalt de claim per subsector met de verhouding tussen de
				waargenomen trendwaarde in het basisjaar en de TIGRIS-waarde in datzelfde jaar; een landelijke factor per subsector, dus het ruimtelijke patroon van TIGRIS blijft intact en de claims op NVM,
				COROP, Provincie en NL blijven onderling consistent. TrendLISARegio doet hetzelfde met een factor per allocatieregio uit PrivData/TrendBasisjaar (per gemeente, opgeteld naar de
				regio-indeling) en corrigeert dus ook waar gebouwd wordt; omdat een verhouding niet optelbaar is lopen de claims op de vier indelingen dan een fractie van een promille uiteen."
	, IntegrityCheck = "This == 'TIGRIS' || This == 'TrendLISA' || This == 'TrendLISARegio'";

	parameter<Job> Ondergrens := 200[Job]
	, Descr = "Onder hoeveel banen in het basisjaar een regio bij de regionale variant terugvalt op de landelijke factor, want een verhouding tussen twee kleine getallen is ruis. Op de 76 NVM-regio's bijt deze grens nergens.";

	container TrendLISA
	: Descr = "De waargenomen trendwaarde per werksubsector in het claimbasisjaar, in banen: per subsector een lineaire trend over 2012 tot en met 2022, doorgetrokken naar 2023, zodat het piekjaar zelf de schatting niet meebepaalt. Opnieuw te bepalen bij een nieuwe LISA-jaargang of een ander Model_StartYear; het venster is een keuze.", Source = "LISA-reeks 1996-2023 uit de levering LISA2023, op de gemeentegrenzen van 2023"
	{
		parameter<Job> Nijverheid             := 1479534[Job];
		parameter<Job> Logistiek              := 1273199[Job];
		parameter<Job> Detailhandel           :=  769448[Job];
		parameter<Job> Ov_consumentendiensten := 1217052[Job];
		parameter<Job> Zak_dienstverlening    := 1938552[Job];
		parameter<Job> Overheid_kw_diensten   := 2430331[Job];
	}
}
