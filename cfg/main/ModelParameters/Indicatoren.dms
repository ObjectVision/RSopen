//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Indicatoren
: Descr = "Parameters van de indicatoren die geen eigen bestand hebben; koolstof en methaan staan in Koolstof.dms, de piekbuiberging in Piekbuiberging.dms."
{
	parameter<Woning_ha> MaxWoningenInGroen               := 5[Woning_ha], Descr = "Tot deze woningdichtheid telt een groencel mee in de bereikbaarheid van groen op de BBG (Templates/Indicatoren/BereikbaarheidGroenBBG_T/Extent0).";
	parameter<ha>        MinimumAaneengeslotenOppervlakte := 1[Ha], Descr = "Vanaf deze omvang telt een aaneengesloten groengebied mee in de bereikbaarheid van groen op de BBG (BereikbaarheidGroenBBG_T/Extent).";

	unit<UInt8> Domein : nrofrows = 10
	, Descr = "De indicatordomeinen, dezelfde indeling als Templates/Indicatoren_T/Export/generates/Themas, met per projectlijn een kolom die zegt of die projectlijn het domein levert; de kolom van
				ModelParameters/Productieprofiel geldt. De landgebruikskaart staat als eigen rij naast Grondgebruik, want een projectlijn kan verstedelijking en inbreiding leveren zonder die kaart, en de kaart
				leest met de verharding de BGT-oppervlakken van WriteBasedata/Generate_Run4_IndicatorenData. De basedata, de variantdata, het controleharnas, de export en de ketens tussen de zichtjaren
				lezen dit, zodat een run alleen rekent en alleen bronnen leest voor wat de projectlijn oplevert. Welke sectoren alloceren staat hier los van, in ModelParameters/SectorAllocRegio."
	{
		attribute<String> name                 : ['Grondgebruik', 'Wonen', 'Werken', 'Water', 'Natuur', 'Landbouw', 'Koolstof', 'Sloop', 'Tabellen', 'Landgebruikskaart'];
		attribute<Bool>   NL2120               : [        TRUE,    TRUE,     TRUE,    TRUE,     TRUE,       TRUE,       TRUE,    TRUE,       TRUE,                TRUE];
		attribute<Bool>   RuimteVoorWoningbouw : [        TRUE,    TRUE,     TRUE,   FALSE,    FALSE,      FALSE,      FALSE,   FALSE,       TRUE,               FALSE]
		, Descr = "Woningbouw: waar en hoe er gebouwd wordt, wat het kost en oplevert, de werklocaties die ernaast gealloceerd worden, en de claimrealisatie in de tabellen; zonder landgebruikskaart.";
		attribute<Bool>   Standaard            : [        TRUE,    TRUE,     TRUE,   FALSE,    FALSE,      FALSE,      FALSE,   FALSE,       TRUE,               FALSE]
		, Descr = "Wonen en werken: de verstedelijking, de woningvoorraad en de werklocaties met hun dichtheid, kosten en opbrengsten, en de tabellen. Zonder water, natuur, landbouw, koolstof, de sloop door
					natuur en water, en de landgebruikskaart, zodat een run ook zonder de landbouw- en waterbronnen loopt.";
		attribute<Bool>   Actief               := =/ModelParameters/Productieprofiel
		, IntegrityCheck = "this[V/Landgebruikskaart] || !(this[V/Water] || this[V/Natuur] || this[V/Landbouw])"
		, Descr = "De kolom van de projectlijn van deze werkkopie. Water, Natuur en Landbouw lezen de landgebruikskaart, dus wie een daarvan levert, levert ook de kaart.";
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	container Geleverd
	: Descr = "Per indicatordomein of de projectlijn het levert, als losse vlag, zodat de export en de ketens tussen de zichtjaren er in een meta-expressie kort naar kunnen wijzen."
	{
		parameter<Bool> Grondgebruik      := Domein/Actief[Domein/V/Grondgebruik];
		parameter<Bool> Wonen             := Domein/Actief[Domein/V/Wonen];
		parameter<Bool> Werken            := Domein/Actief[Domein/V/Werken];
		parameter<Bool> Water             := Domein/Actief[Domein/V/Water];
		parameter<Bool> Natuur            := Domein/Actief[Domein/V/Natuur];
		parameter<Bool> Landbouw          := Domein/Actief[Domein/V/Landbouw];
		parameter<Bool> Koolstof          := Domein/Actief[Domein/V/Koolstof];
		parameter<Bool> Sloop             := Domein/Actief[Domein/V/Sloop];
		parameter<Bool> Tabellen          := Domein/Actief[Domein/V/Tabellen];
		parameter<Bool> Landgebruikskaart := Domein/Actief[Domein/V/Landgebruikskaart];
	}
}
