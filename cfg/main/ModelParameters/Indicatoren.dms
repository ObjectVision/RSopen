container Indicatoren
: Descr = "Parameters van de indicatoren die geen eigen bestand hebben; koolstof en methaan staan in Koolstof.dms, de piekbuiberging in Piekbuiberging.dms."
{
	parameter<Woning_ha> MaxWoningenInGroen               := 5[Woning_ha] , Descr = "Tot deze woningdichtheid telt een groencel mee in de bereikbaarheid van groen op de BBG (Templates/Indicatoren/BereikbaarheidGroenBBG_T/Extent0).";
	parameter<ha>        MinimumAaneengeslotenOppervlakte := 1[Ha]        , Descr = "Vanaf deze omvang telt een aaneengesloten groengebied mee in de bereikbaarheid van groen op de BBG (BereikbaarheidGroenBBG_T/Extent).";

	container Groennorm
	: Descr = "De referenties waaraan BereikbaarheidGroen/Normtoets het groen toetst (#400). Geen van de vier is een wettelijke of landelijk vastgestelde norm; de status staat per parameter in Source."
	{
		parameter<m2_Woning> GroenPerWoning := 75[m2_Woning]
		, IntegrityCheck = "this > 0[m2_Woning]"
		, Descr = "De referentie voor de beschikbaarheid van groen: zoveel m2 groen per woning, als gemiddelde over een gebied en niet als eis per woning."
		, Source = "Alterra (2002), Groene meters; toetsing van de groennorm uit het Beoordelingskader Groen in de stad: een historische beleidsreferentie, geen actuele norm (#400)";
		parameter<meter> Straal := 300[meter]
		, IntegrityCheck = "this == 300[meter] || this == 500[meter] || this == 1000[meter]"
		, Descr = "Hemelsbreed, de afstand waarbinnen groen bij een woning telt, voor de drie toetsen: het groen dat een woning met de woningen om haar heen deelt, de afstand tot een groenplek en de kroonbedekking. Alleen 300, 500 of 1000 meter, want daarvoor bestaan de afstandsmatrices. Hemelsbreed en niet over het netwerk is een vereenvoudiging van het model."
		, Source = "3+30+300-richtlijn, Konijnendijk (2023), Evidence-based guidelines for greener, healthier, more resilient neighbourhoods: introducing the 3-30-300 rule, Journal of Forestry Research 34: een groene ruimte binnen 300 meter van elke woning; een internationale vuistregel, geen Nederlandse norm (#400)";
		parameter<ha> MinOppervlakteGroenplek := 1[ha]
		, IntegrityCheck = "this > 0[ha]"
		, Descr = "Hoe groot een aaneengesloten groengebied moet zijn om als groenplek te tellen. De richtlijn noemt 0,5 tot 1 ha; 1 ha is een keuze van het model, dezelfde als MinimumAaneengeslotenOppervlakte hierboven."
		, Source = "3+30+300-richtlijn, Konijnendijk (2023), minimale omvang van de groene ruimte 0,5 tot 1 ha (#400)";
		parameter<Float32> Kroonbedekking := 0.3f
		, IntegrityCheck = "this > 0f && this < 1f"
		, Descr = "De referentie voor de kroonbedekking: zoveel van het land binnen de straal rond een woning ligt van bovenaf gezien onder een boomkroon, als fractie; water telt niet mee."
		, Source = "3+30+300-richtlijn, Konijnendijk (2023): 30 procent kroonbedekking in elke buurt; een internationale vuistregel, geen Nederlandse norm. De buurt is hier de schijf van de straal rond de woning (#480)";
	}

	unit<UInt8> Domein : nrofrows = 10
	, Descr = "De indicatordomeinen, dezelfde indeling als Templates/Indicatoren_T/Export/generates/Themas, met per projectlijn een kolom die zegt of die projectlijn het domein levert; de kolom van
				ModelParameters/Productieprofiel geldt. De landgebruikskaart staat als eigen rij naast Grondgebruik, want een projectlijn kan verstedelijking en inbreiding leveren zonder die kaart, en de kaart
				leest met de verharding de BGT-oppervlakken van WriteBasedata/Generate_Run4_IndicatorenData. De basedata, de variantdata, het controleharnas, de export en de ketens tussen de zichtjaren
				lezen dit, zodat een run alleen rekent en alleen bronnen leest voor wat de projectlijn oplevert. Welke sectoren alloceren staat hier los van, in ModelParameters/SectorAllocRegio."
	{
		attribute<String> name                 : ['Grondgebruik', 'Wonen', 'Werken', 'Water', 'Natuur', 'Landbouw', 'Koolstof', 'Sloop', 'Tabellen', 'Landgebruikskaart'];
		attribute<Bool>   NL2120               : [        TRUE,    TRUE,     TRUE,    TRUE,     TRUE,       TRUE,       TRUE,    TRUE,       TRUE,                TRUE];
		attribute<Bool>   RuimteVoorWoningbouw : [        TRUE,    TRUE,     TRUE,   FALSE,    FALSE,      FALSE,      FALSE,   FALSE,       TRUE,               FALSE]
		, Descr = "Woningbouw: waar en hoe er gebouwd wordt, wat het kost en oplevert, de werklocaties die ernaast gealloceerd worden, en de claimrealisatie in de tabellen; zonder landgebruikskaart.";
		attribute<Bool>   Standaard            : [        TRUE,    TRUE,     TRUE,   FALSE,    FALSE,      FALSE,      FALSE,   FALSE,       TRUE,               FALSE]
		, Descr = "Wonen en werken: de verstedelijking, de woningvoorraad en de werklocaties met hun dichtheid, kosten en opbrengsten, en de tabellen. Zonder water, natuur, landbouw, koolstof, de sloop door
					natuur en water, en de landgebruikskaart, zodat een run ook zonder de landbouw- en waterbronnen loopt.";
		attribute<Bool>   DGWBStad             : [        TRUE,    TRUE,     TRUE,    TRUE,     TRUE,       TRUE,       TRUE,    TRUE,       TRUE,                TRUE], Descr = "Het project stad voor DGWB: alle domeinen, zoals NL2120.";
		attribute<Bool>   Actief               := =/ModelParameters/Productieprofiel
		, IntegrityCheck = "this[V/Landgebruikskaart] || !(this[V/Water] || this[V/Natuur] || this[V/Landbouw])"
		, Descr = "De kolom van de projectlijn van deze werkkopie. Water, Natuur en Landbouw lezen de landgebruikskaart, dus wie een daarvan levert, levert ook de kaart.";
		container         V                    := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	container Geleverd
	: Descr = "Per indicatordomein of de projectlijn het levert, als losse vlag, zodat de export en de ketens tussen de zichtjaren er in een meta-expressie kort naar kunnen wijzen."
	{
		parameter<Bool> Grondgebruik      := Domein/Actief[Domein/V/Grondgebruik];
		parameter<Bool> Wonen             := Domein/Actief[Domein/V/Wonen];
		parameter<Bool> Werken            := Domein/Actief[Domein/V/Werken];
		parameter<Bool> Water             := Domein/Actief[Domein/V/Water];
		parameter<Bool> Natuur            := Domein/Actief[Domein/V/Natuur];
		parameter<Bool> Landbouw          := Domein/Actief[Domein/V/Landbouw];
		parameter<Bool> Koolstof          := Domein/Actief[Domein/V/Koolstof];
		parameter<Bool> Sloop             := Domein/Actief[Domein/V/Sloop];
		parameter<Bool> Tabellen          := Domein/Actief[Domein/V/Tabellen];
		parameter<Bool> Landgebruikskaart := Domein/Actief[Domein/V/Landgebruikskaart];
	}

	container Overstromingsschade_Prijspeil
	: Descr = "Brengt de maximale schadebedragen van de SSM van hun prijspeil naar dat van Model_StartYear, het prijspeil waarop RSopen ook de bouw- en sloopkosten rekent; constante prijzen, dus zonder reele groei naar de
				zichtjaren (#609). Opstal en directe bedrijfsschade gaan met de bouwkostenindex, want de SSM leidt het opstalbedrag af uit bouwkosten van nieuwbouwwoningen; inboedel, indirecte bedrijfsschade en de
				categorie Overig met de consumentenprijsindex; wegen en spoor met de GWW-index. Gelezen door Templates/Indicatoren/SSM2017_Overstromingsschades/Parameters."
	{
		parameter<YearRange> Prijspeil_SSM := 2011[YearRange], Descr = "Prijspeil van de bedragen in de schadetabel van de SSM.", Source = "Deltares, Gebruikershandleiding SSM2017 v3 (2020), bijlage A: prijspeil 2011, economische waarden 2014";

		unit<UInt8> Jaar : nrofrows = 5
		, Descr = "Jaarcijfers van de drie prijsindexen; de rij van Prijspeil_SSM en die van Model_StartYear moeten erin staan."
		{
			attribute<YearRange> Jaar       : [ 2011,   2022,   2023,   2024,   2025];
			attribute<Float32>   Bouwkosten : [133.4,  179.1,  189.2,  194.2,  201.3], Descr = "Inputprijsindex bouwkosten nieuwbouwwoningen, totaal, jaarcijfer, 2000=100.", Source = "CBS 80444ned", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/80444ned/table";
			attribute<Float32>   CPI        : [93.73, 121.43, 126.09, 130.31, 134.56], Descr = "Consumentenprijsindex, alle bestedingen, jaarcijfer, 2015=100.", Source = "CBS 83131NED", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83131NED/table";
			attribute<Float32>   GWW        : [145.6,  196.0,  202.1,  208.4,  210.6], Descr = "Inputprijsindex grond-, weg- en waterbouw, totaal 42/43, 2000=100, als gemiddelde van de gepubliceerde perioden van het jaar: tot en met 2023 vier kwartaalmaanden, daarna twaalf maanden.", Source = "CBS 81139ned", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/81139ned/table";
		}

		parameter<Jaar>    Jaar_Prijspeil := rlookup(Prijspeil_SSM, Jaar/Jaar), IntegrityCheck = "IsDefined(this)";
		parameter<Jaar>    Jaar_Start     := rlookup(/ModelParameters/Model_StartYear, Jaar/Jaar), IntegrityCheck = "IsDefined(this)";

		parameter<Float32> Bouwkosten     := Jaar/Bouwkosten[Jaar_Start] / Jaar/Bouwkosten[Jaar_Prijspeil], Descr = "Factor van Prijspeil_SSM naar Model_StartYear voor opstal en directe bedrijfsschade.";
		parameter<Float32> CPI            := Jaar/CPI[Jaar_Start] / Jaar/CPI[Jaar_Prijspeil]              , Descr = "Factor van Prijspeil_SSM naar Model_StartYear voor inboedel, indirecte bedrijfsschade en Overig.";
		parameter<Float32> GWW            := Jaar/GWW[Jaar_Start] / Jaar/GWW[Jaar_Prijspeil]              , Descr = "Factor van Prijspeil_SSM naar Model_StartYear voor wegen en spoor.";
	}
}
