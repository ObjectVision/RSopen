//
// Parameters van de indicatoren die geen eigen bestand hebben. Zie ObjectVision/RSopen#801.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Indicatoren
: Descr = "Parameters van de indicatoren die geen eigen bestand hebben; koolstof en methaan staan in Koolstof.dms, de piekbuiberging in Piekbuiberging.dms."
{
	parameter<Woning_ha> MaxWoningenInGroen               := 5[Woning_ha], Descr = "Tot deze woningdichtheid telt een groencel mee in de bereikbaarheid van groen op de BBG (Templates/Indicatoren/BereikbaarheidGroenBBG_T/Extent0).";
	parameter<ha>        MinimumAaneengeslotenOppervlakte := 1[Ha], Descr = "Vanaf deze omvang telt een aaneengesloten groengebied mee in de bereikbaarheid van groen op de BBG (BereikbaarheidGroenBBG_T/Extent).";

	unit<UInt8> Domein : nrofrows = 10
	, Descr = "De indicatordomeinen, dezelfde indeling als Templates/Indicatoren_T/Export/generates/Themas plus de landgebruikskaart, met per projectlijn een kolom die zegt of die projectlijn het
				domein levert; de kolom van ModelParameters/Productieprofiel geldt. De landgebruikskaart staat als eigen rij naast Grondgebruik, want een projectlijn kan verstedelijking en inbreiding leveren
				zonder die kaart, en de kaart leest met de verharding de BGT-oppervlakken van WriteBasedata/Generate_Run4_IndicatorenData. Diagnose/Voorwaarde en WriteBasedata lezen dit, zodat het
				controleharnas en de basedata alleen rekenen wat de projectlijn oplevert."
	{
		attribute<String> name                 : ['Grondgebruik', 'Wonen', 'Werken', 'Water', 'Natuur', 'Landbouw', 'Koolstof', 'Sloop', 'Tabellen', 'Landgebruikskaart'];
		attribute<Bool>   NL2120               : [        TRUE,    TRUE,     TRUE,    TRUE,     TRUE,       TRUE,       TRUE,    TRUE,       TRUE,                TRUE];
		attribute<Bool>   RuimteVoorWoningbouw : [        TRUE,    TRUE,    FALSE,   FALSE,    FALSE,      FALSE,      FALSE,   FALSE,       TRUE,               FALSE]
		, Descr = "Woningbouw: waar en hoe er gebouwd wordt, wat het kost en oplevert, en de claimrealisatie in de tabellen; zonder landgebruikskaart.";
		attribute<Bool>   Actief               := =/ModelParameters/Productieprofiel
		, IntegrityCheck = "this[V/Landgebruikskaart] || !(this[V/Water] || this[V/Natuur] || this[V/Landbouw])"
		, Descr = "De kolom van de projectlijn van deze werkkopie. Water, Natuur en Landbouw lezen de landgebruikskaart, dus wie een daarvan levert, levert ook de kaart.";
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
}
