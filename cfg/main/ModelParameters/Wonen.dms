container Wonen
{
	parameter<Yr>        GeenSlooptotLeeftijd_BinnenHardePlancapaciteit      := 25[Yr], Descr = "Geen sloop van panden jonger dan deze leeftijd op cellen met harde plancapaciteit voor de betreffende subsector. Geldt in Templates/Beschikbaarheden/Zeef_T voor elke sector die daar
				langskomt, niet alleen wonen; de tegenhanger buiten harde plancapaciteit is VariantK/GeenSlooptotLeeftijd_BuitenHardePlancapaciteit, en de twee toetsen sluiten elkaar sinds #586 uit. De
				leeftijd is sinds #735 die van het jongste pand in de cel. Alleen gevuld zolang er geldige plancapaciteit is, dus tot en met Advanced/PlancapaciteitGeldigTotEnMet.";
	parameter<String>    Suitability_ref                                     := 'ExploitatieSaldo', Descr = "Grondslag voor de empirische onderbouwing van de geschiktheid van ontwikkelpakketten binnen de sector Wonen: ExploitatieSaldo, ResidueleWaarde";
	parameter<String>    grondproductie_kosten_Variant                       := 'Nominaal_Faktondatabase', Descr = "Welke van de zes uitkomsten van Grondproductiekosten/C het saldo gebruikt: Nominaal is de puntschatting, Low en High alleen een bandbreedte. Faktondatabase is de goedkoopste van de
				twee bronnen, vooral via PlanProces, en staat hier vanwege het ontwikkelaarsperspectief van het saldo (#809), al zegt de bron niet wat voor exploitaties die database bevat (#846).";
	parameter<ha>        Grondproductie_OmvangPlangebied                     := 2[ha], Descr = "Omvang van het plangebied voor de regressievariabele OmvangPlangebied, die alleen in PlanProces meetelt: een kleiner plangebied geeft hogere kosten per hectare. Een eigen parameter en
				niet de minimale clusteromvang, want die gaat over de vorm van een cluster (#809). De steekproef liep van minder dan een halve tot 298 hectare; de bijlage zelf rekende met 1 (#846).";
	parameter<Float32>   Grondproductie_MaxKaveldichtheid                    := 73f, Descr = "Plafond op de regressievariabele Kaveldichtheid2018 in BouwWoonrijp en PlanProces, in kavels per hectare: het hoogste wat de schattingssteekproef kende, zodat het model niet buiten de
				data extrapoleert. Met coefficient 0,024 lineair in de exponent is de kostenfactor daar 5,8, en zonder plafond op de bronkaart, die tot 217 loopt, 183 (#809, #846)."
	, Source = "PBL, bijlage Grondproductiekosten en transformatiepotentie, m.m.v. Fakton, versie december 2019, tabel 3: kaveldichtheid in de steekproef 0 tot 73 per hectare, gemiddeld 9";
	parameter<Eur_ha>    Grondproductie_Bovenwijks                           := 64243[Eur_ha], Descr = "Kosten van bovenwijkse voorzieningen per hectare, gelijk voor elke cel en elke onzekerheidsvariant: het steekproefgemiddelde, want de regressie Bovenwijks is een log-model op
				een post die voor bijna de helft van de plannen nul is en geeft daarom geen verwachtingswaarde (#846). Op het prijspeil van de schatting; Grondproductiekosten/Results indexeert hem mee."
	, Source = "PBL, bijlage Grondproductiekosten en transformatiepotentie, m.m.v. Fakton, versie december 2019, tabel 2: bovenwijkse voorzieningen gemiddeld 64.243 euro per hectare, 135 exploitaties zonder deze kosten";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_B                 := TRUE, Descr = "Mag B, partieel ophogen, meedoen? Hoogt alleen bebouwing, straten en overige openbare ruimte op en laat tuinen, parken en water op het oorspronkelijke materiaal liggen.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_C                 := TRUE, Descr = "Mag C, ophogen met een vaste 1,20 meter zand, meedoen? Alleen toegestaan waar integraal ophogen met niet meer dan 1,20 meter toe kan, en daar is C per definitie niet goedkoper, dus hij wint nooit. Zie de toelichting bij Bodemdalingkosten/Beschikbaar/C.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_D                 := TRUE, Descr = "Mag D, licht ophoogmateriaal met EPS, meedoen? Alleen beschikbaar waar de EPS-kaart een waarde geeft.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_E                 := TRUE, Descr = "Mag E, alles funderen, meedoen? Let op dat de heipaallengte in de levering is afgekapt op de klasse boven 14 meter, dus dit alternatief is onderschat op de 3.370 km2 waar die afkapping bijt.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_F                 := TRUE, Descr = "Mag F, drijvend bouwen, meedoen? De afgraafdieptes op de zandgronden lopen tot 251 meter en maken dit alternatief daar vanzelf onbetaalbaar; dat is bedoeld gedrag van het rapport en geen fout.";

	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2022                := 1.23f, Descr = "Voor 2022 met 2017==100 -> 1.23; voor 2023 met 2017=100 -> 1.29", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83887NED/table";
	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2023                := 1.29f, Descr = "Voor 2022 met 2017==100 -> 1.23; voor 2023 met 2017=100 -> 1.29", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83887NED/table";
	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2024                := 1.33f, Descr = "Inputprijsindex bouwkosten nieuwbouwwoningen (component Totaal), herbasering 2017=100. 2022->1.23, 2023->1.29. Tabel 83887NED (2015=100) stopt in 2023; 2024/2025 uit opvolger 85728NED (2021=100), aan 83887NED geketend op overlapjaar 2023: index_Y = (134.2/103.9) * (jaar_Y / 115.4). 2024: 118.5 -> 1.33.", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/85728NED/table";
	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2025                := 1.37f, Descr = "Inputprijsindex bouwkosten nieuwbouwwoningen (component Totaal), herbasering 2017=100. Zie _naar_2024 voor methode; geketend op overlapjaar 2023: (134.2/103.9) * (jaar_2025 / 115.4). 2025: 122.8 -> 1.37.", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/85728NED/table";

	parameter<float32>   WoningPrijsVerandering_2022_naar_2023               := 0.971f, Descr = "Jaarlijkse groei van 2022 op 2023, obv gemiddelde woningverkoop. Bron CBS Statline.";
	parameter<float32>   WoningPrijsVerandering_2023_naar_2023               := 1f, Descr = "Jaarlijkse groei van 2022 op 2023, obv gemiddelde woningverkoop. Bron CBS Statline.";
	parameter<float32>   WoningPrijsVerandering_2023_naar_2024               := 1.084f, Descr = "Groei 2023->2024, obv gemiddelde verkoopprijs bestaande koopwoningen: 450985/416153 = 1.084. Bron CBS 85773NED (GemiddeldeVerkoopprijs).";
	parameter<float32>   WoningPrijsVerandering_2023_naar_2025               := 1.152f, Descr = "Groei 2023->2025, obv gemiddelde verkoopprijs bestaande koopwoningen: 479527/416153 = 1.152. Bron CBS 85773NED (GemiddeldeVerkoopprijs).";
	
	parameter<String>    OPGroenAlsNatuur_ref                                := 'Inrichtingstype', Descr = "Welk groen uit de ontwikkelpakketten meetelt als natuur in de hedonische groenwaardering (#566, #677): Inrichtingstype is al het groen van de pakketten waarvan het type in Classifications/Grondgebruik/InrichtingstypeK GroenTeltAlsNatuur heeft, uitgeefbaar plus openbaar, volgens de
																				afspraak met Deltares in #566; Alle laat elk pakket meetellen, Geen zet het uit. De coefficient hoort bij fr_natuur_tot2500m op LGN-natuur, dat bos en gras binnen bebouwd gebied uitsluit
																				maar moeras en riet niet; natuurinclusief ingerichte pakketten zijn landschappen met woningen erin en dat groen geldt als echte natuur. Werkt op de indicator en op de allocatie tegelijk (sinds #637 hetzelfde
																				sjabloon Templates/Suitabilities/Groenfracties_T), dus met een terugkoppeling over zichtjaren heen.";

	parameter<String>    OPWaterAlsWater_ref                                 := 'Alle', Descr = "Welk water uit de ontwikkelpakketten meetelt als open water in de hedonische groenwaardering (#677): Alle is het gedrag van voor #677, Inrichtingstype beperkt het tot de pakketten waarvan het type WaterTeltAlsWater heeft, Geen zet het uit.
																				De waterfractie van de gewone pakketten is een vaste invulling van 0,40 van het onverharde deel en geen ontwerp; alleen de natuurinclusief ingerichte pakketten hebben een ontworpen waterfractie. Op Inrichtingstype overstappen
																				is een gedragswijziging en ligt bij Deltares; de echte oplossing is een ingeschatte waterfractie voor de gewone pakketten.";

	parameter<float32>   DrijvendBehoudtWaterFractie                         := 0f, Descr = "Welk deel van het bestaande wateroppervlak onder een drijvend ontwikkelpakket water blijft in de hedonische groenwaardering (#505, #614). Op 0 bepaalt de inrichting van het pakket de
																								watercelwaarde volledig, dus een drijvende buurt op open water gaat als grotendeels gedempt de boeken in; op 1 blijft het water onder de woningen bestaan. Grijpt alleen aan op cellen met een
																								fysiek ingericht pakket met bouwwijze IsDrijvend die in het basisjaar water waren volgens LGN. Werkt alleen op de hedonische waardering; de verhardingsindicator boekt de inrichting nog alsof
																								die op land ligt (#665).";

	parameter<int32>   VBO_opp_truncation_upper        := 500i;
	parameter<int32>   VBO_opp_truncation_lower        := 10i;
	
	container Sloopkosten
	: Descr = "De kosten van het slopen van het bestaande opstal, in euro per vierkante meter vloeroppervlak, prijspeil 2017 en met PrijsIndex_Bouwkosten naar het zichtjaar: een basisbedrag per bouwtype
				plus een asbesttoeslag op bouwjaar. Het niveau is sinds #701 geijkt op de EIB-marktstudies voor VERAS (omzet totaalsloop van gebouwen gedeeld door het gesloopte vloeroppervlak uit de BAG),
				die voor 2018 en 2023 onafhankelijk op 104 en 113 euro per m2 op prijspeil 2023 uitkomen; daarin zit slopen, materiaalscheiding, afvoer, terreinwerk en marge, maar geen asbestverwijdering en
				geen bodemsanering. Offerteprijzen van onderaf liggen ongeveer de helft lager, maar gelden een eenvoudige vrijstaande situatie en niet de binnenstedelijke herontwikkeling waar dit model over
				gaat.", Source = "EIB, Marktstudie sloopsector voor VERAS, edities 2019 (over 2018) en 2024 (over 2023); zie #701"
	, URL = "https://www.sloopaannemers.nl/site/media/upload/files/2555_rapportage-marktstudie-slopers-2024-definitief-pdf_pdf_20241114134645.pdf"
	{
		parameter<Eur_m2>  Basis_Rijtjeswoning_2017    :=  48[Eur_m2], Descr = "Basiskental woningsloop voor een rijtjeswoning, prijspeil 2017. De onderlinge verhouding tussen de vier woningtypen komt van bouwkostenkompas; het niveau is met een factor 2,2 geijkt op de sectorcijfers uit de toelichting op de container, zodat de gesloopte woningvoorraad gewogen op circa 53 euro uitkomt; de asbesttoeslag geldt alleen voor niet-woningen.", Source = "verhouding www.bouwkostenkompas.nl (niet meer toegankelijk), niveau EIB-marktstudies (#701)";
		parameter<Eur_m2>  Basis_Twee_onder_1_kap_2017 :=  88[Eur_m2], Descr = "Idem, 114 euro op prijspeil 2023.";
		parameter<Eur_m2>  Basis_Vrijstaand_2017       := 125[Eur_m2], Descr = "Basiskental woningsloop voor een vrijstaande woning, prijspeil 2017. Het minst zekere van de vier: bouwkostenkompas zette vrijstaand op 2,6 maal rijtjeswoning, en die spreiding blijft staan hoewel de bron niet meer te raadplegen is; meer gevel, terreinwerk en een eigen fundering maken een hogere prijs per m2 aannemelijk.", Source = "verhouding www.bouwkostenkompas.nl (niet meer toegankelijk), niveau EIB-marktstudies (#701)";
		parameter<Eur_m2>  Basis_Appartement_2017      :=  48[Eur_m2], Descr = "Idem, 62 euro op prijspeil 2023.";

		parameter<Eur_m2>  Basis_Hal_2017 := 43[Eur_m2]
		, Descr = "Basiskental voor het deel van het niet-woonvloeroppervlak dat hal is: groot, eenlaags en eenvoudig van constructie. Een stalen hal gaat snel tegen de vlakte en het staal heeft restwaarde. Dit is de onderkant van het sectorcijfer en de bovenkant van de agrarische offertes van 30 tot 45 euro per m2. Prijspeil 2017, dus 55 euro op prijspeil 2023.";

		parameter<Eur_m2>  Basis_OverigeUtiliteit_2017 := 101[Eur_m2]
		, Descr = "Basiskental voor de overige utiliteit (kantoren, winkels, scholen, zorg), prijspeil 2017: meerlaags, meer binnenafwerking en installaties, vaker binnenstedelijk. Zo gekozen dat de landelijke mix van hal en overige utiliteit uitkomt op het sectorcijfer; de verhouding tussen de twee is marktkennis, het niveau volgt uit de mix.", Source = "niveau EIB-marktstudies (#701), verhouding hal tegen overig is een aanname";

		parameter<Eur_m2>  AsbestToeslag_2017 := 20[Eur_m2]
		, Descr = "Toeslag per vierkante meter vloeroppervlak voor panden met een bouwjaar voor AsbestBouwjaarGrens, boven op het basiskental: de helft van de kosten per m2 asbesthoudend dak of gevelpaneel,
					omdat lang niet elk pand van voor 1994 een asbestdak heeft en bij een meerlaags pand het dak kleiner is dan het vloeroppervlak. Beredeneerd en niet waargenomen; op 0[Eur_m2] valt de
					component weg.", Source = "ruim 40 euro per m2 dak (Van Bree, Hulsker en Wienhoven 2012, geciteerd in de EIB-marktstudie 2014)";

		parameter<yr>      AsbestBouwjaarGrens := 1994[yr]
		, Descr = "Bouwjaar waaronder de asbesttoeslag geldt: 1994 is het jaar van het Nederlandse verbod op het toepassen van asbest. Panden zonder bouwjaar krijgen geen toeslag, wat de post eerder te laag dan te hoog maakt.";

		parameter<Eur_m2>  rijtjeswoning         := ='Basis_Rijtjeswoning_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  twee_onder_1_kap      := ='Basis_Twee_onder_1_kap_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  vrijstaand            := ='Basis_Vrijstaand_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  appartement           := ='Basis_Appartement_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  Hal                   := ='Basis_Hal_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  OverigeUtiliteit      := ='Basis_OverigeUtiliteit_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  Asbest                := ='AsbestToeslag_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
	}

	container Vervanging
	: Descr = "De jaarlijkse kans dat een bestaande woning wordt gesloopt en op dezelfde plek in dezelfde dichtheid terugkomt, per bouwperiode van het pand (#859). Van 2013 tot en met 2024 was deze
				vervanging bijna twee derde van alle sloop op sloop-nieuwbouwlocaties; omdat de voorraad er niet door verandert ziet een allocatie op netto claims haar niet, en daarom boekt het model haar
				apart, in de indicator SloopNieuwbouwPerWoningtype en in de verwervingskosten, zie BaseData/Suitabilities/Wonen/Vervanging. Verdichtende sloop-nieuwbouw valt erbuiten, die hoort bij
				de allocatie (#860). Landelijke kansen; de meting per stedelijkheidsklasse verschilt weinig en niet eenduidig. De klasse vanaf 2002 staat op nul, omdat de gemeten kans daar vooral uit
				registratiecorrecties van jonge panden bestaat. De controlewaarde vervanging_per_jaar in Diagnose/ChecksBasisjaar bewaakt wat de kansen samen op de voorraad van het basisjaar geven; op
				nul zetten schakelt de stroom uit."
	, Source = "BAG-levering 20260710: woonverblijfsobjecten gesloopt van 2013 tot en met 2024 op locaties waar daarna is gebouwd zonder netto groei van de voorraad, per bouwperiode van het pand, gedeeld door de voorraad van die bouwperiode (#855, #859)"
	{
		unit<UInt8> Src : nrofrows = 8, Descr = "De kans per bouwperiode op naam, zodat een verschoven klasse in Bouwperiode luid omvalt in plaats van stil te verspringen."
		{
			attribute<String>  name        : ['d_constrlt1926', 'd_constr19261950', 'd_constr19511965', 'd_constr19661973', 'd_constr19741981', 'd_constr19821991', 'd_constr19922001', 'd_constrgt2001'];
			attribute<Float32> KansPerJaar : [0.00128, 0.00106, 0.00227, 0.00098, 0.00041, 0.00009, 0.00004, 0]
			, Descr = "Als fractie van de voorraad per jaar: 0,128 procent voor de woningen van voor 1926, 0,227 procent voor 1951 tot 1966 als hoogste, 0,004 procent voor 1992 tot 2002 en nul vanaf 2002.";
		}
		attribute<Float32> KansPerJaar (/Classifications/Vastgoed/Bouwperiode) := Src/KansPerJaar[rlookup(/Classifications/Vastgoed/Bouwperiode/name, Src/name)], IntegrityCheck = "all(IsDefined(this))"
		, Descr = "De kans per klasse van Bouwperiode, de klassenindeling van het hedonische prijsmodel, zodat kans en waardefactor dezelfde klassen delen.";
	}

	container Energielabel
	: Descr = "De opslag op de verwervingskosten van woningen naar het energielabel van de cel (#860). Een goed label is een woning waarin net is geinvesteerd en die meer waard is dan het hedonische
				prijsmodel zegt, want dat heeft geen labelterm; de opslag maakt zo'n cel duurder om uit te kopen in plaats van haar uit te sluiten, zoals de zeefregel GeenSloopvanafELabel doet. De
				opslag krimpt lineair naar nul in KrimpJaar: het model houdt het label van het basisjaar terwijl de voorraad door renovatie naar de goede labels toegroeit, zodat het label steeds minder
				zegt over het verschil tussen cellen; daarna doen de leeftijdsregel en de vervangingskans het werk. Op nul zetten schakelt de post uit."
	, Source = "Brounen en Kok (2011), On the economics of energy labels in the housing market, Journal of Environmental Economics and Management 62(2), 166-179, doi:10.1016/j.jeem.2010.11.006:
				tabel 3 kolom 2, de coefficienten per label op de log van de transactieprijs per m2 van 31.993 gelabelde woningen 2008-2009, ten opzichte van label D; E is niet significant"
	{
		attribute<Float32> Opslag (/Classifications/Vastgoed/Energielabel) : [0.102, 0.056, 0.022, 0, -0.005, -0.025, -0.051, 0]
		, Descr = "Als fractie van de hedonische waarde, per label A tot en met G ten opzichte van D, en nul voor een cel zonder label (N).";
		parameter<YearRange> KrimpJaar := 2050[YearRange], IntegrityCheck = "this > /ModelParameters/Model_StartYear"
		, Descr = "Het jaar waarin de opslag nul is. De nationale isolatiestandaard en de Europese richtlijn sturen op een voorraad zonder slechte labels rond dit jaar; vanaf het begin van de periode die hier eindigt telt het label niet meer.";
	}

	container SocialeHuur
	: Descr = "Hoe de sociale huur in de allocatie de vrije sector volgt (#528). De twee sectoren alloceren los van elkaar en de sociale huur heeft het lagere saldo, dus zonder deze koppeling landt wat
				een regio niet kwijt kan op de valstaplagen op de goedkoopste grond van de COROP of de provincie, los van waar de vrije sector van dezelfde claim landt. Hier krijgt de sociale huur in
				de rangorde van haar eigen cellen een bonus naar het aantal woningen dat de vrije sector dit zichtjaar al binnen Straal heeft gekregen (Templates/Allocatie/Iter_T, container
				VrijeSectorNieuwbouw): voluit bij Referentie woningen of meer, naar rato daaronder, zodat een groot nieuwbouwgebied zwaarder trekt dan een enkel cluster. Een binaire nabijheid
				werkt niet: in Noord-Holland heeft bijna elke cel binnen 250 meter wel vrije-sectornieuwbouw, en de sociale huur bleef dan op de goedkoopste grond. De score voor de keuze tussen
				subsectoren en de beschikbaarheid blijven de eigen, zodat de vrije sector een betwiste cel wint. Gemengde buurten dus, geen gemengde cellen. Bonus op nul schakelt de koppeling
				uit en geeft de allocatie van voor #528."
	{
		parameter<meter>   Straal     := 500[meter], IntegrityCheck = "IsDefined(rlookup(this, /Geography/Matrix/size))"
		, Descr = "Binnen welke afstand de vrije-sectornieuwbouw van dit zichtjaar voor een cel meetelt. Moet een straal uit Geography/Matrix zijn, want de telling gebruikt de afstandsmatrix met die naam.";
		parameter<Woning>  Referentie := 1000[Woning], IntegrityCheck = "this > 0[Woning]"
		, Descr = "Bij hoeveel nieuwe vrije-sectorwoningen binnen Straal de bonus voluit geldt; daaronder naar rato. Duizend woningen binnen 500 meter is een dichte nieuwe wijk van dertig woningen per
					hectare over ruim veertig procent van de schijf; een los cluster van honderd woningen telt dan voor een tiende.";
		parameter<Float32> Bonus      := 1f, IntegrityCheck = "this >= 0f"
		, Descr = "De opslag op de rang van een cel in de eigen rangorde van de sociale huur bij een voluit geldende nabijheid, als fractie van die rang: op een verdubbelt de rangscore, zodat zo'n cel alle
					verder gelegen cellen inhaalt tot op het dubbele van haar eigen rang. Op de rang en niet op het saldo, omdat het saldo negatief kan zijn. Te ijken op het aandeel sociale huur per regio tegen de
					claimgroei (#528).";
	}

	container Herontwikkeleenheid
	: Descr = "De herontwikkeleenheid waarover de verwervings- en sloopkosten van de bestaande bebouwing worden uitgesmeerd (#861), zie BaseData/Suitabilities/Wonen/Herontwikkeleenheid. Zonder
				uitsmering hangen die kosten alleen aan de cellen met panden en is een tuincel of een stuk openbare ruimte in woongebied voor niets te koop."
	{
		parameter<meter> Straal := 50[meter], IntegrityCheck = "IsDefined(rlookup(this, /Geography/Matrix/size))"
		, Descr = "Tot welke afstand van een cel met een pand de omliggende cellen bij zijn herontwikkeleenheid horen en in de kosten delen: twee cellen van 25 meter, de diepte van een woning met
					haar tuin en de straat ervoor. Op 25 meter raakt de uitsmering alleen de buurcellen; groter maakt de kosten in een buurt vlakker. Moet een straal uit Geography/Matrix zijn. Te ijken op de
					sloop door het model per jaar en de inbreidingsfractie tegen de BAG (#861).";
	}

	unit<UInt32> Bouwkosten := ='SourceData/RegioIndelingen/CBS/Y'+string(ModelParameters/Model_StartYear)+'/gpkg/landsdeel_gegeneraliseerd'
	, Descr = "Bouwkosten per m2 bvo van nieuwbouwwoningen per landsdeel en per eigendom, kolom GemiddeldeBouwkostenPerM_3; de perioden zijn voortschrijdende jaargemiddelden (sleutel 2023VJ12 is januari
				tot en met december 2023). Alleen de kolom van Model_StartYear wordt gelezen, dus het prijspeil volgt uit die kolom en niet uit PrijsIndex_Bouwkosten; staat Model_StartYear op een jaar
				zonder kolom, dan faalt de naam-expansie hard, en dat is bedoeld. De splitsing naar woningtype zit sinds #673 in Bouwkosten_Woningtype hieronder.", Source = "CBS 83673NED, Bouwvergunningen kerncijfers nieuwbouwwoningen, uitgelezen september 2025 en nagelopen bij #673"
	, URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83673NED/table?dl=C651A" 
	{
		attribute<String> Landsdeel_naam     : ['Noord','Oost','West','Zuid'];
		attribute<String> label              := statnaam;
		attribute<Eur_m2> Huurwoningen_2022  : [ 945, 1029, 1102, 1021];
		attribute<Eur_m2> Huurwoningen_2023  : [1220, 1198, 1379, 1108];
		attribute<Eur_m2> Huurwoningen_2024  : [1273, 1293, 1500, 1224];
		attribute<Eur_m2> Huurwoningen_2025  : [1288, 1336, 1604, 1204];
		
		attribute<Eur_m2> Koopwoningen_2022  : [ 995,  995, 1054,  969];
		attribute<Eur_m2> Koopwoningen_2023  : [1193, 1100, 1233, 1089];
		attribute<Eur_m2> Koopwoningen_2024  : [1216, 1124, 1293, 1081];
		attribute<Eur_m2> Koopwoningen_2025  : [1290, 1189, 1348, 1134];
		
		attribute<Eur_m2> Huurwoningen       := ='Huurwoningen_'+string(ModelParameters/Model_StartYear);
		attribute<Eur_m2> Koopwoningen       := ='Koopwoningen_'+string(ModelParameters/Model_StartYear), IntegrityCheck = "All(Landsdeel_naam+'-Nederland' == statnaam)", Descr = "Check om ervoor te zorgen dat de volgorde deze handmatig opgegeven waardes matches met de volgorde van de regios.";
		
		attribute<.>      Per_AllocDomain (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>      Per_AdminDomain (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];

		attribute<Eur_m2> SocialeHuur (AdminDomain) := Huurwoningen[Per_AdminDomain];
		attribute<Eur_m2> VrijeSector (AdminDomain) := Koopwoningen[Per_AdminDomain];
	}
	
	container Bouwkosten_Woningtype
	: Descr = "De differentiatie van de bouwkosten naar woningtype (#673). Het niveau blijft bij CBS 83673NED hierboven, dat alleen naar landsdeel en huur tegen koop splitst; deze container draagt een
				dimensieloze verhouding tussen de vier woningtypen plus de nieuwbouwmix waarop die verhouding wordt genormaliseerd. De verhouding is de mediaan over vijf gemeentelijke kengetallenlijsten
				voor de bouwlegestoets (Groningen, Sudwest-Fryslan, Hulst, Sluis, Harderwijk), die alle op het Kengetallenkompas Bouwkosten van IGG teruggaan; dat zijn normbedragen en geen
				marktwaarnemingen, vandaar alleen de verhouding. De huur/koop-as van CBS draagt het woningtype al indirect mee, want huurnieuwbouw is grotendeels gestapeld; door de index te delen door het
				mixgewogen gemiddelde binnen de huursector blijft het gewogen gemiddelde per landsdeel en huursector exact het CBS-cijfer. Een enkele normalisator per huursector kan een huursectorkorting
				die per woningtype verschilt niet uitdrukken; die keuze ligt bij Deltares."
	, URL = "https://lokaleregelgeving.overheid.nl/CVDR747733/1"
	{
		unit<UInt8> Src: NrOfRows = 4
		, Descr = "De kentallen per woningtype, met de naam als sleutel zodat de volgorde van WP4 hier niet hoeft te worden nagebouwd."
		{ //                                        0                  1                   2                3
			attribute<String>  WP4_name          : ['rijtjeswoning', 'twee_onder_1_kap', 'vrijstaand', 'appartement'];
			attribute<String>  Label            := WP4_name, DialogType = "LabelText";

			attribute<Float32> Index             : [           1.00,               1.15,         1.12,          1.30], IntegrityCheck = "all(this > 0f)"
			, Descr = "Relatieve bouwkosten per m2 bvo, rijtjeswoning is 1,00; dimensieloos, het niveau komt van CBS. Mediaan over de vijf gemeentelijke kengetallenlijsten uit de toelichting op de container. De
				appartementwaarde is die van een appartementenblok tot 6 lagen en niet van een woontoren, want de meergezinspakketten lopen van 2 tot 7 bouwlagen; zie Classifications/Modellering/BouwlaagK.", Source = "gemeentelijke kengetallenlijsten bouwleges Groningen 2022, Sudwest-Fryslan, Hulst 2026, Sluis 2025 en Harderwijk 2026 (#673)";

			attribute<Float32> EengezinsMix      : [          0.576,              0.149,        0.275,          0.00], IntegrityCheck = "abs(sum(this) - 1f) < 0.001f"
			, Descr = "De woningtypeverdeling binnen de eengezinsnieuwbouw: rijtjeswoningen (tussen plus hoek), twee-onder-een-kap en vrijstaand. Appartement staat op nul, want dat type zit in de andere tak van de splitsing.", Source = "CBS 86084NED, nieuwbouw 2023 naar woningtype";

			attribute<Classifications/Vastgoed/WP4> WP4_rel := rlookup(WP4_name, /Classifications/Vastgoed/WP4/name), IntegrityCheck = "all(IsDefined(this))"
			, Descr = "Koppeling naar de BAG-typologie via de naam en niet via een nummer, zodat een typefout hard faalt in plaats van stil naar het verkeerde type te wijzen. Zelfde constructie als Dieptevermogen_rel bij BouwwijzeK.";
		}

		unit<UInt8> MixSrc: NrOfRows = 2
		, Descr = "Het aandeel gestapelde bouw in de nieuwbouw per huursector, waarop de index wordt genormaliseerd."
		{ //                                         0                1
			attribute<String>  VSSH_name          : ['VrijeSector', 'SocialeHuur'];
			attribute<String>  Label             := VSSH_name, DialogType = "LabelText";

			attribute<Float32> MeergezinsAandeel  : [         0.16,          0.87], IntegrityCheck = "all(this >= 0f && this <= 1f)"
			, Descr = "Het aandeel appartementen in de nieuwbouw van deze huursector, afgeleid uit dezelfde CBS-tabel als het niveau: de gemiddelde oppervlakte per nieuwbouwwoning per huursector, opgelost tegen de
						gemiddelde oppervlakte van eengezins en meergezins in de jonge voorraad met de vormfactoren van dit model. Terugrekenen geeft het landelijke aandeel meergezins dat CBS 86084NED feitelijk
						telt. De gevoeligheid is tweede orde; zet beide waarden gelijk om de correctie voor de dubbeltelling met de huur/koop-as uit te zetten.", Source = "CBS 83673NED (oppervlakte per nieuwbouwwoning 2023) en CBS 82550NED (gebruiksoppervlak voorraad bouwjaar 2015 tot 2025)";

			attribute<Float32> Normalisator      := MeergezinsAandeel * Index_appartement + (1f - MeergezinsAandeel) * Index_eengezins, IntegrityCheck = "all(this > 0f)"
			, Descr = "Het mixgewogen gemiddelde van de index binnen deze huursector: 1,094 voor de vrije sector en 1,268 voor de sociale huur. Delen door deze waarde houdt het gemiddelde kental per m2 bvo per landsdeel gelijk aan het CBS-cijfer.";

			attribute<Classifications/Vastgoed/VSSH> VSSH_rel := rlookup(VSSH_name, /Classifications/Vastgoed/VSSH/name), IntegrityCheck = "all(IsDefined(this))"
			, Descr = "Koppeling naar de huursectorindeling via de naam, zelfde constructie als Src/WP4_rel.";
		}

		parameter<Float32> Index_appartement := Index_perWP4[/Classifications/Vastgoed/WP4/V/appartement]
		, Descr = "De index van het appartement, apart gezet omdat de normalisatie de splitsing eengezins tegen meergezins volgt en niet de vier typen los.";

		parameter<Float32> Index_eengezins   := sum(Src/Index * Src/EengezinsMix), IntegrityCheck = "this > 0f"
		, Descr = "Het naar de nieuwbouwverdeling gewogen gemiddelde van de index over de drie grondgebonden typen.";

		attribute<Float32> Index_perWP4         (/Classifications/Vastgoed/WP4)  := rjoin(/Classifications/Vastgoed/WP4/name,  Src/WP4_name,     Src/Index), IntegrityCheck = "all(IsDefined(this))"
		, Descr = "De index op het WP4-domein, zodat Templates/VariantData_T/Geschiktheden/Bouwkosten er met OP/WP4_rel in kan indexeren. De join loopt op naam, dus een hernoemd of verdwenen woningtype faalt hard.";

		attribute<Float32> Normalisator_perVSSH (/Classifications/Vastgoed/VSSH) := rjoin(/Classifications/Vastgoed/VSSH/name, MixSrc/VSSH_name, MixSrc/Normalisator), IntegrityCheck = "all(IsDefined(this) && this > 0f)"
		, Descr = "De normalisator op het VSSH-domein, zodat dezelfde template er met OP/VSSH_rel in kan indexeren.";
	}

	parameter<Bool> BouwwijzeOpslagInBouwkosten := FALSE
	, Descr = "Laat de bouwwijze meetellen in de bouwkosten, via Classifications/Modellering/BouwwijzeK/Kostenopslag; sinds #723 de opslag van de bouwwijze die per cel gekozen wordt uit wat het pakket
				toelaat. Op FALSE staat er geen factor in de formule. Pas op TRUE als de kentallen per bouwwijze bekend zijn, en kijk dan ook naar de dummy AndersBouwen in
				BaseData/Suitabilities/Grondproductiekosten, die hetzelfde anders bouwen al beprijst in hetzelfde saldo (#505, #662).";
	
	container WoningtypeEengezins
	: Descr = "Het quotum per woningtype binnen de eengezinsclaim (#847). Op elke allocatieregio van wonen wordt de eengezinsclaim van elke regio verdeeld over de groepen hieronder naar het aandeel
				dat daar in de basisperiode is gebouwd (BaseData/StartState/WoningtypeEengezins, per indeling), en elk deel wordt alleen met pakketten van dat type gevuld. Zonder quotum kiest de
				allocatie per cel het pakket met het hoogste saldo, en dat is bijna overal een rijpakket. Wat een regio niet kwijt kan gaat met de restclaim van de subsector naar het volgende
				allocatieniveau, waar het aandeel van die grovere indeling de verdeling opnieuw bepaalt."
	{
		parameter<Bool>   Actief                := TRUE, Descr = "Zet het quotum aan. Op FALSE kiest de allocatie per cel weer het pakket met het hoogste saldo per hectare, zoals voor #847, en blijft de rest van deze
					container alleen de telling van het gebouwde aandeel; de controlewaarde woningtype_eengezins_afwijking in Diagnose ligt dan ruim boven zijn norm. Voor de toets van het quotum tegen de
					geschiktheidsreparaties van #847, #858 en #859, die het quotum overbodig zouden moeten maken.";
		parameter<Yr>     BasisperiodeVan       := 2016[Yr], Descr = "Het eerste bouwjaar van de periode waarover het gebouwde aandeel per woningtype wordt geteld.";
		parameter<Yr>     BasisperiodeTotEnMet  := 2025[Yr], Descr = "Het laatste bouwjaar van de basisperiode, het laatste volle jaar voor de BAG-stand van BAG_RecentYear.", IntegrityCheck = "this >= BasisperiodeVan";
		parameter<UInt32> MinimumAantalPerRegio := 200, Descr = "Een regio waar in de basisperiode minder eengezinswoningen zijn gebouwd krijgt het landelijke aandeel, want daar bepalen een paar projecten de verdeling.";
		parameter<String> Rekenregel            := '847', Descr = "Versiesleutel van de afleiding in de fingerprint van het ontkoppelde aandeel; verander hem mee met de afleiding, met het nummer van het issue.";

		unit<UInt8> Groep : NrOfRows = 3
		, Descr = "De woningtypegroepen binnen eengezins, in de volgorde waarin de allocatie ze binnen een iteratie vult: elke groep kiest uit de cellen die de groepen ervoor hebben laten liggen. De
					dichtste groep eerst, want een rijpakket levert per hectare bijna altijd meer saldo dan een vrijstaand pakket en krijgt de cel zonder quotum ook."
		{
			attribute<String> WP4_name          : ['rijtjeswoning', 'twee_onder_1_kap', 'vrijstaand'], IntegrityCheck = "all(IsDefined(this))";
			attribute<String> name              := WP4_name;
			attribute<String> Label             := name, DialogType = "LabelText";
			attribute<Bool>   AlleenVrijeSector : [FALSE, FALSE, TRUE], IntegrityCheck = "all(IsDefined(this))"
			, Descr = "Vult alleen de vrije sector deze groep? Sociale huur bouwt geen vrijstaande woningen, dus het vrijstaande deel van de eengezinsclaim van een regio komt bij de vrije sector, ook in een set die een vrijstaand pakket voor sociale huur kent.";
			attribute<Bool>   VolgtRijwoningen  : [FALSE, TRUE, FALSE], IntegrityCheck = "all(IsDefined(this))"
			, Descr = "Volgt deze groep in haar rangorde de rijwoningen van dit zichtjaar (Nabijheid)? Twee-onder-een-kap wel: die gaat in de praktijk in projecten met rijwoningen mee. Vrijstaand niet: dat staat grotendeels op losse kavels en in linten, en het model zet het al zo neer (#847).";
			attribute<Classifications/Vastgoed/WP4> WP4_rel := rlookup(WP4_name, /Classifications/Vastgoed/WP4/name), IntegrityCheck = "all(IsDefined(this))";
		}

		container Nabijheid
		: Descr = "Hoe een typegroep in de allocatie de rijwoningen volgt (#847). Elke groep heeft onder het quotum een eigen zaaglijn, en het saldo per pakket zegt niets over wat er naast komt, dus zonder
					koppeling zet het model twee-onder-een-kap los van de rijwoningen neer waar het in de praktijk in hetzelfde project staat. Dezelfde constructie als SocialeHuur: een groep met
					Groep/VolgtRijwoningen krijgt in de rangorde van haar eigen cellen een bonus naar het aantal rijwoningen dat dit zichtjaar al binnen Straal is gezet (Templates/Allocatie/Iter_T,
					container RijwoningNieuwbouw) plus de rijwoningen die de rijgroep in dezelfde iteratie kiest (IterSubsector_T_Wonen/Quotum/Groep_T/RijDezeIteratie), voluit bij Referentie woningen
					of meer en naar rato daaronder. De beschikbaarheid en de score voor de keuze tussen subsectoren blijven de eigen. Bonus op nul schakelt de koppeling uit en geeft de allocatie van
					voor deze term."
		{
			parameter<meter>   Straal     := 100[meter], IntegrityCheck = "IsDefined(rlookup(this, /Geography/Matrix/size))"
			, Descr = "Binnen welke afstand de rijnieuwbouw van dit zichtjaar voor een cel meetelt: de schaal van een bouwblok of een deelplan. Moet een straal uit Geography/Matrix zijn, want de telling gebruikt de afstandsmatrix met die naam.";
			parameter<Woning>  Referentie := 10[Woning], IntegrityCheck = "this > 0[Woning]"
			, Descr = "Bij hoeveel nieuwe rijwoningen binnen Straal de bonus voluit geldt; daaronder naar rato. Tien woningen is ongeveer drie cellen van een stedelijk rijpakket, de rand van een bouwblok; een enkele cel telt voor een derde. Een hogere referentie laat de groep minder vaak aansluiten (#847).";
			parameter<Float32> Bonus      := 1f, IntegrityCheck = "this >= 0f"
			, Descr = "De opslag op de rang van een cel in de eigen zaaglijn van de groep bij een voluit geldende nabijheid, als fractie van die rang; op een verdubbelt de rangscore, zoals SocialeHuur/Bonus. Op de rang en niet op het saldo, omdat het saldo negatief kan zijn.";
			parameter<Float32> LadderSprong := 1f, IntegrityCheck = "this >= 0f && this <= 1f"
			, Descr = "Hoe ver een cel met een voluit geldende nabijheid boven haar eigen trede uitkomt, als fractie van de hele ladder: op een gaat zij voor elke cel zonder rijnieuwbouw in de buurt, op nul
						telt alleen de bonus op de rang binnen de trede. De bonus alleen doet weinig: de rijnieuwbouw landt grotendeels onderaan de ladder, buiten plannen en contour, terwijl de losse
						twee-onder-een-kap op dorpse cellen hoger op de ladder zit die voor een rijpakket niet beschikbaar zijn; een projectmix vraagt dat de groep de rijwoningen de ladder af volgt (#847).";
		}
	}

	container Verwervingskosten
	: Descr = "De verwervingskosten van het bestaande vastgoed op een locatie. Woningen op de hedonische prijs per woningtype; niet-woningen op de WOZ-woningprijs per vierkante meter uit de brondata maal
				een verhouding naar de samenstelling van het vloeroppervlak in de cel (hal tegen overige utiliteit), met het kental hieronder als terugval (#674). De WOZ-brondata gaat alleen over woningen,
				dus de woningprijs zegt waar een pand staat en niet wat het is; een verhouding per object uit de CBS-maatwerklevering is niet bruikbaar omdat de prijs met oppervlak wordt vermenigvuldigd en
				hallen het meeste oppervlak dragen tegen een lage prijs. De twee prijsniveaus zijn een aanname die bevestiging vraagt; zet beide verhoudingen gelijk om de differentiatie uit te zetten, op 1
				om de woningprijs onverkort te nemen."
	{
		parameter<Float32> NietWoningen_WOZVerhouding_Hal    := 0.186f, Descr = "Waarmee de WOZ-woningprijs per vierkante meter wordt vermenigvuldigd voor het deel van het niet-woonvloeroppervlak dat hal is (industrie, logistiek en utiliteit-combi); komt uit op circa 600 euro per m2 op prijspeil 2023. Aanname, zie de toelichting op de container.";
		parameter<Float32> NietWoningen_WOZVerhouding_Overig := 0.423f, Descr = "Idem voor de overige utiliteit: kantoor, winkel, bijeenkomst, cel, gezondheidszorg, onderwijs, overige gebruiksfunctie, sport en logies. De uitkomst is circa 1.400 euro per m2 op prijspeil 2023, want de woningprijs gewogen met dat oppervlak is 3.311.";
		parameter<Float32> NietWoningen_FractieHal_Default   := 0.62f, Descr = "Terugval voor de fractie hal in een cel waar geen enkele utiliteitsklasse oppervlak heeft; het landelijke aandeel. Komt in de praktijk niet voor.";
		parameter<Float32> NietWoningen_MaxBouwlagenPerCel   := 45f, IntegrityCheck = "this > 0f"
		, Descr = "Hoeveel keer het eigen celoppervlak een cel maximaal aan niet-woonvloeroppervlak mag dragen; begrenst opp_per_grid en Samenstelling/Voor1994 in BaseData/Suitabilities/Verwervingskosten, en
					daarmee de verwervings- en sloopkosten van niet-woningen. Een fysieke bovengrens en geen percentiel: het hoogste niet-woongebouw van Nederland, de Maastoren, heeft 44 bruikbare lagen, dus
					wat daarboven zit kan niet bestaan. Zonder grens domineerden enkele cellen met honderd of meer lagen elke uitdraai van het saldo, terwijl de allocatie er niets van merkte omdat zulke cellen
					nooit winnen. Raakt een handvol cellen; de oorzaak in de BAG is niet uitgezocht, dit is een keuze van team RS. Verlagen bijt snel, want onder de tien lagen raakt de grens echte hoogbouw.";

		parameter<Eur_m2> NietWoningen_2017 := 700[Eur_m2]
		, Descr = "Landelijk kental voor de verwervingsprijs van een vierkante meter niet-woonvloeroppervlak, prijspeil 2017, alleen voor de cellen waar de WOZ-brondata niets geeft. Geijkt op de WOZ-kant die
				het vervangt: gewogen met het vloeroppervlak per cel en na de twee verhoudingen hierboven landelijk circa 900 euro per m2 op prijspeil 2023, en 700 maal de bouwkostenindex komt daarop uit.
				Een kental van 10.000, zoals hier voor #674 stond, is geen prijs maar een verbod op binnenstedelijke transformatie van werklocaties naar wonen.";

		parameter<Eur_m2> NietWoningen := ='NietWoningen_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear), Descr = "Het kental op het prijspeil van Model_StartYear. De bouwkostenindex is hier een benadering: een verwervingsprijs is een marktwaarde en volgt niet noodzakelijk de bouwkosten. De WOZ-kant heeft zijn eigen indexering via Groeifactor_CommercieelVastgoed.";
	}
	
	parameter<meter>               StedelijkVrijstaandEGVS_UrbanContourBuffer := 250[meter]
	, Descr = "De rand rond het bestaande bebouwde gebied van een kern vanaf StedelijkVrijstaandEGVS_MinimumInwonersKern waarin het stedelijke vrijstaande pakket ook mag landen, het toepassingsgebied BebouwdGebiedMetRand (#847). Stadsuitbreiding komt net buiten de begrenzing te liggen, en in deze rand is de gebouwde vrijstaande kavel nog die van binnen de begrenzing."
	, Source = "Afgeleid uit de BAG-levering 20260710 en de kadastrale kaart van 20231206: tot 250 meter buiten de begrenzing van 2012 is de mediane kavel van de vrijstaande nieuwbouw 2016-2025 in stedelijke gemeenten gelijk aan die binnen de begrenzing, daarbuiten groeit hij (#847)";
	parameter<Float32>             StedelijkVrijstaandEGVS_MinimumInwonersKern := /ModelParameters/Advanced/Bevolkingskern_Grens_Klein
	, Descr = "Vanaf welk inwonertal een kern de rand van StedelijkVrijstaandEGVS_UrbanContourBuffer krijgt (#847). Aan de rand van een dorp is de gebouwde vrijstaande kavel groter dan die van het
				stedelijke pakket, dus daar en ook binnen de bebouwde kom van een dorp is DorpsLandLaagEGVS het vrijstaande pakket (toepassingsgebied BuitenBebouwdGebiedMetRand). Dezelfde grens als de kleine kern in de
				OV-tredes en de dichtheden; zet hem hier los als het pakket een andere grens moet krijgen.";
	parameter<meter>               Hoogbouwgrens                := 15[meter], Descr = "De hoogte van een woongebouw vanaf waar we het hoogbouw noemen. Bron: expert judgement PBL"; 
	parameter<meter>               Bouwlaaghoogte               := 2.6[meter], Descr = "Aanname voor de hoogte van een bouwlaag. Onder andere nodig om bij benadering het aantal verdiepingen per gebouw te kunnen schatten. Bron: expert judgement PBL";
	parameter<Woonoppervlak_m2BVO> VormfactorEengezins          := 0.76[Woonoppervlak_m2BVO], Descr = "De vormfactor is de verhouding tussen het verhuurbare vloeroppervlak (woonoppervlak in het geval van wonen) van een gebouw en het totale (bruto) vloeroppervlak.";
	parameter<Woonoppervlak_m2BVO> VormfactorMeergezins         := 0.78[Woonoppervlak_m2BVO], Descr = "De vormfactor is de verhouding tussen het verhuurbare vloeroppervlak (woonoppervlak in het geval van wonen) van een gebouw en het totale (bruto) vloeroppervlak.";
	parameter<Woonoppervlak_m2BVO> VormfactorHoogbouw           := 0.65[Woonoppervlak_m2BVO], Descr = "De vormfactor is de verhouding tussen het verhuurbare vloeroppervlak (woonoppervlak in het geval van wonen) van een gebouw en het totale (bruto) vloeroppervlak. PBL-8 gaat uit van 0.5. Obv expert judgement PBL gaan er tussenin zitten."; 
	parameter<Float32>             DefaultFractieUitgeefbaar    := 0.5f, Descr = "Aandeel van een NettoBuurt dat uitgeefbaar is (= gebouwFootprint plus evt niet gemeentelijke buitenruimte (tuinen etc.)). Bron: expert judgement PBL.";
	parameter<Float32>             FractieUitgeefbaarTinyHouses := 0.25f, Descr = "Aandeel van een NettoBuurt dat uitgeefbaar is (= gebouwFootprint plus evt niet gemeentelijke buitenruimte (tuinen etc.)). Bron: expert judgement PBL.";
	parameter<Float32>             DefaultVerharding            := 0.10f, Descr = "Het uitgeefbare deel van een gridcel dat (dus) niet in beslag wordt genomen door gebouwen en dat gebruikt wordt voor verharde wegen, paden, parkeerplaatsen. Voor gebruik op 100x100m resolutie. Bron: expert judgement PBL in overleg met WUR";

	container DefaultFractiesGrasBoomStruikInGroen
	: Descr = "Fractie van het groen in een gridcel dat wordt gebruikt door diverse subTypen groen. Voor gebruik op 100x100m resolutie. Bron: expert judgement PBL in overleg met WUR"
	{
		parameter<Float32> Gras   := 0.4f;
		parameter<Float32> Boom   := 0.4f;
		parameter<Float32> Struik := 0.2f;
	}
	
	parameter<cm>    MaxBodemdaling                := 40[cm], Descr = "Maximale bodemdaling op slappe/zetytingsgevoelige gronden waarop beheerskosten voor infra 'acceptabel' worden voorondersteld. Bron: expert judgement PBL i.o.m Deltares";
	
	container BAG_woonpand_Typering
	: Descr = "Technische instellingen om de woonpand typering on the fly te kunnen berekenen met de beste performance. Zie afweging in de URL"
	, URL   = "https://github.com/ObjectVision/GeoDMS/issues/816#issuecomment-2426041271"
	{
		parameter<UInt32>  nr_x_tiles         :=  50, Descr = ""; //oude setting 7   
		parameter<UInt32>  nr_y_tiles         :=  50, Descr = ""; //oude setting 13
		parameter<Float64> inflate_size       := 0.2d, Descr = "Inflate van panden in meters om overlap te detecteren (e.g. bepaling rijtjeswoningen)"; 
	}
	
	unit<uint8> MilieuCat : NrOfRows = 14
	, Descr = "Per milieucategorie van een bedrijventerrein, zoals IBIS die levert, de restrictiebuffer daaromheen voor wonen: de VNG-richtafstanden, telkens de grootste van de vier aspecten. Sinds #694
				met subcategorieen, omdat Gelderland en Utrecht 3.1 en 4.2 leveren en de rest alleen hoofdgetallen; Cat3, Cat4 en Cat5 zonder subcategorie houden de grootste richtafstand van hun
				hoofdcategorie en zijn de namen die ModelParameters/Werken doorgeeft. Cat1 krijgt 0 omdat 10 meter kleiner is dan een gridcel; Cat0 staat er omdat de brondata hem invult, zodat de
				IntegrityCheck op MilieuCat_rel in IBIS.dms iets zegt. Categorie_x10 is de categorie maal tien zodat 3.1 en 3.2 als geheel getal uit elkaar te houden zijn; de leeskant parseert de brontekst
				met float64.", Source = "VNG, Bedrijven en milieuzonering, editie 2009"
	, URL = "https://vng.nl/publicaties/bedrijven-en-milieuzonering"
	{
		attribute<string> Name          : ['Cat0','Cat1','Cat2','Cat3','Cat3_1','Cat3_2','Cat4','Cat4_1','Cat4_2','Cat5','Cat5_1','Cat5_2','Cat5_3','Cat6'];
		attribute<uint8>  Categorie_x10 : [    0,    10,    20,    30,      31,      32,    40,      41,      42,    50,      51,      52,      53,    60];
		attribute<meter>  Buffer_wonen  : [    0,     0,    30,   100,      50,     100,   300,     200,     300,  1000,     500,     700,    1000,  1500];
		attribute<string> Label         := Name, DialogType = "LabelText";
		
		parameter<bool>   AanvullenBijOnbekend        := TRUE
		, Descr = "Krijgt een werklocatie zonder bruikbare milieucategorie (X, X=onbekend of leeg) een aanname op grond van zijn werklocatietype (#694)? Op FALSE houdt zo'n terrein een buffer van nul en
					blokkeert het wonen nergens. Een schakelaar, anders dan de subcategorieen hierboven, omdat het invullen van een ontbrekende categorie een aanname is en geen leesreparatie. Het gat zit vooral
					in Zeeland en omvat zeehaventerreinen als het Sloegebied, in werkelijkheid de zwaarste terreinen van het land; de jaargang 2023 heeft hetzelfde gat.";
		parameter<uint8>  Aanvulling_Zeehaven         := 50b, Descr = "Welke Categorie_x10 een zeehaventerrein krijgt waarvan IBIS de milieucategorie niet levert. 50 is categorie 5, oftewel 1.000 meter. Empirisch verankerd en niet gekozen: van de 45 zeehaventerreinen die de categorie wel invullen is zowel de modus als de mediaan 5, en het oppervlaktegewogen gemiddelde exact 5,00.";
		parameter<uint8>  Aanvulling_Bedrijventerrein := 30b, Descr = "Welke Categorie_x10 een gewoon bedrijventerrein krijgt waarvan IBIS de milieucategorie niet levert; 30 is categorie 3, oftewel 100 meter, de modus en mediaan van de terreinen die de categorie wel invullen. Economische zones (retail, onderwijs, zorg, agribusiness) krijgen geen aanvulling, want dat is geen vervuilende bedrijvigheid.";
		parameter<float32> TransformatieDrempel       := 0.5f
		, Descr = "Een werklocatie waarvan minstens dit deel van de cellen onder een woningbouwplan ligt, hard of zacht, uit de plancaplevering van ModelParameters/PlanCapaciteit_filedate, telt als
					transformerend: daar verdwijnt de bedrijvigheid, dus het terrein houdt geen milieuzone, niet op het terrein zelf en niet eromheen. De zone van terreinen die blijven, houdt stand, zodat wonen naast
					bedrijvigheid die blijft geweerd blijft. Een hard plan was al vrijgesteld (#742); deze regel gaat over zachte plannen en over wat het model zelf alloceert. Een waarde boven 1 zet de regel uit.";
		
		parameter<meter>  Buffer_rond_Nijverheid := ='Buffer_wonen[v/'+Werken/MilieuCatDist_restrictief_anderesectoren_Nijverheid+']';
		parameter<meter>  Buffer_rond_Logistiek  := ='Buffer_wonen[v/'+Werken/MilieuCatDist_restrictief_anderesectoren_Logistiek+']';

		parameter<meter>  Buffer_omgekeerd_Nijverheid := ='Buffer_wonen[v/'+Werken/OmgekeerdeMilieuzonering/MilieuCatDist_Nijverheid+']', Descr = "Afstand die nieuwe nijverheid zelf tot aaneengesloten woongebied aanhoudt (#669). Staat los van Buffer_rond_Nijverheid, zodat de VNG-nuances voor gemengd gebied en voor de milieucategorie per activiteit alleen in de omgekeerde richting gezet kunnen worden.";
		parameter<meter>  Buffer_omgekeerd_Logistiek  := ='Buffer_wonen[v/'+Werken/OmgekeerdeMilieuzonering/MilieuCatDist_Logistiek+']', Descr = "Idem voor logistiek.";
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	parameter<float32> FractieBoomInGroenInTarraBuurt   := 0.20f, Descr = "Grove aanname binenn dit poject. Needs work";
	parameter<float32> FractieStruikInGroenInTarraBuurt := 0.20f, Descr = "Grove aanname binenn dit poject. Needs work";
	parameter<float32> FractieGrasInGroenInTarraBuurt   := 0.60f, Descr = "Grove aanname binenn dit poject. Needs work";
	
	parameter<Eur_pand> Funderingsschade_P95 := 97200[Eur_pand], Descr = "Verouderd (#408): de cap gebeurt nu per woning via SourceData/Vastgoed/Funderingsschade/Kentallen/P99_perWoning (k_i <= s_i * P99_perWoning), met herverdeling van het surplus binnen de buurt. Deze per-pand-waarde kapte grote appartementenpanden structureel af (23% verlies).";

	// ===== MORTALITEIT DOOR GROENVERANDERING (#484) =====
	// De indicator rekent een verandering van de groenindex om in een verandering van het aantal sterfgevallen.
	// Daarvoor is nodig hoeveel bewoners er in een cel wonen en hoe groot hun kans op overlijden is. Beide komen
	// uit de CBS Kerncijfers wijken en buurten, dus staan hier alleen nog de keuzes die niet uit die data volgen:
	// welk jaar, hoe sterk kleine buurten naar hun wijk krimpen, en waarbinnen de huishoudensgrootte wordt
	// begrensd. De effectmaat zelf staat in Templates/Indicatoren.dms, want die komt uit het RIVM-onderzoek.
	parameter<String>         KWB_Jaar                     := '2024', Descr = "Welk jaar van de CBS Kerncijfers wijken en buurten moet worden gebruikt. Het bestand Data/CBS_KWB/CBS_KWB_<jaar>_bevolking_sterfte.csv moet bestaan en de CBS-gebiedsindeling van hetzelfde jaar moet in RegioIndelingen/CBS zitten.";
	parameter<Persoon>        Sterfte_KrimpGewicht         := 500[Persoon], Descr = "Hoe zwaar het cijfer van de bovenliggende regio meetelt in de sterftekans van een buurt, uitgedrukt in inwoners. Zonder krimp levert een buurt van 70 inwoners met een verzorgingshuis een sterftekans van 40% per jaar op. Op nul krijgt elke buurt zijn eigen ongecorrigeerde cijfer; heel hoog krijgt elke buurt het landelijke cijfer.";
	parameter<Persoon_Woning> PersonenPerWoning_Ondergrens := 1.0[Persoon_Woning], Descr = "Ondergrens waarbinnen de uit CBS en modelvoorraad afgeleide huishoudensgrootte wordt begrensd.";
	parameter<Persoon_Woning> PersonenPerWoning_Bovengrens := 4.0[Persoon_Woning], Descr = "Bovengrens waarbinnen de uit CBS en modelvoorraad afgeleide huishoudensgrootte wordt begrensd. Buurten waar het model weinig woningen kent maar het CBS veel inwoners telt, lopen anders sterk op. Onder- en bovengrens gelijk zetten geeft overal diezelfde huishoudensgrootte.";

	parameter<String>         NDVI_basisjaar_ref          := 'mid', Descr = "Welke rand van de NDVI-bandbreedte per landgebruiksklasse het basisjaar gebruikt: min, mid of max.";

	container Grondwaarde
	: using = "/Classifications/Grondgebruik/CBSKlasse"
	, Descr = "De verwervingskosten van de grond zelf, per bodemgebruiksklasse van het basisjaar; grondslag voor Verwervingskosten/Grond in Suitability_Wonen_perOP_T (#787). Zonder deze post trok het saldo
				alleen het opstal af en was de grond gratis, zodat dezelfde grond drie behandelingen kreeg: de WOZ is grond plus opstal, de niet-woningprijs alleen opstal, onbebouwde grond niets. Het gaat
				om de gebruikswaarde en niet om de prijs na vergunning, want het saldo is zelf de residuele grondwaarde. De post haalt de zwakste marges weg en verschuift de rangorde nauwelijks: de sprong
				van landbouwgrond naar woningbouwgrond is een factor tien tot twintig, en wat greenfield tegenhoudt zijn de restricties, de plancapaciteit en evident benut."
	{
		parameter<Bool> GrondwaardeInSaldo := TRUE, Descr = "Telt de grondwaarde mee in het exploitatiesaldo (#787). Op FALSE is onbebouwde grond gratis en krijgt dezelfde grond drie behandelingen, zie de container. De prijzen per klasse hieronder zijn deels aanname: alleen de agrarische regels hebben een bron.";

		parameter<Eur_ha> Agrarisch_grasland := 86400[Eur_ha], Descr = "Kadaster, kwartaalbericht agrarische grondmarkt, jaargemiddelde 2025 voor grasland.";
		parameter<Eur_ha> Agrarisch_bouwland := 106700[Eur_ha], Descr = "Kadaster, idem, jaargemiddelde 2025 voor bouwland.";
		parameter<Eur_ha> Agrarisch_overig   := 95400[Eur_ha], Descr = "Kadaster, idem, landelijk jaargemiddelde 2025 over alle agrarische grond. Dat lag 11,8 procent boven 2024 en overschreed in het vierde kwartaal voor het eerst de honderdduizend euro per hectare.";

		parameter<Float32> Factor_Uitkoopfunctie := 2.0f, Descr = "Vermenigvuldiger op de agrarische prijs voor klassen waar verwerving betekent dat een functie moet worden uitgekocht en elders teruggebouwd: stedelijk groen, sportterrein, volkstuin, dagrecreatief en verblijfsrecreatief terrein, begraafplaats en zonnepark. Aanname zonder bron; kalibreren tegen werkelijke uitkoopdossiers voordat de uitkomst als getal naar buiten gaat.";

		parameter<Eur_ha> Natuur := 95400[Eur_ha], Descr = "Bos en natuurlijk terrein op het landelijke agrarische gemiddelde. Natuurgrond wisselt in de markt onder de landbouwprijs, maar verwerving voor bebouwing vraagt compensatie, en dat trekt het minstens terug naar dit niveau. AANNAME in die zin dat de compensatieplicht niet als prijs is uitgerekend.";

		parameter<Eur_ha> Stedelijk := 1000000[Eur_ha], Descr = "Bebouwd terrein, plus bouwterrein, stortplaats en delfstofwinplaats: honderd euro per vierkante meter. Een orde van grootte en geen landelijk gemiddelde, want dat bestaat niet als openbaar
					cijfer; gemeentelijke grondprijzenbrieven noemen uitgifteprijzen van grofweg honderd tot driehonderd euro, en die gelden bouwrijpe grond met bestemming, dus dit staat bewust aan de
					onderkant. Bouwterrein hoort hier en niet op nul, want iemand heeft ervoor betaald. Let op de omvang: 62.500 euro op een cel van 25 meter ligt in de orde van het exploitatiesaldo zelf, dus
					deze regel kan cellen omdraaien.", Source = "gemeentelijke grondprijzenbrieven, onderkant van de bandbreedte (#787)";

		parameter<Eur_ha> Infrastructuur := 2000000[Eur_ha], Descr = "Spoorterrein, hoofdweg, vliegveld en metro of sneltram. Dit is geen grondprijs maar een grove ondergrens voor het verleggen van infrastructuur, en hij staat er vooral zodat de klasse niet gratis is. Evident benut en de restricties sluiten deze klassen in de praktijk al uit, dus de waarde wordt zelden geraakt; gebeurt dat wel, dan is dat een signaal dat er elders iets mis is.";

		parameter<Eur_ha> Water := 1000000[Eur_ha], Descr = "Alle waterklassen. Hier klopt het kostenbegrip niet: bouwen op water is landaanwinning en dat hoort in de bouwkosten en niet in de verwerving. De waarde staat er om dezelfde reden als bij infrastructuur, namelijk dat niets gratis mag zijn, en wordt in de praktijk afgevangen door evident benut.";

		attribute<Eur_ha> PerKlasse (/Classifications/Grondgebruik/CBSKlasse) :=
		  id(/Classifications/Grondgebruik/CBSKlasse) == V/agrarisch_grasland                 ? Agrarisch_grasland
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/akker_en_meerjarige_teelt          ? Agrarisch_bouwland
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Overig_agrarisch_terrein           ? Agrarisch_overig
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Glastuinbouw                       ? Agrarisch_overig
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/bos                                ? Natuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/open_droog_natuurlijk_terrein      ? Natuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/open_nat_natuurlijk_terrein        ? Natuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Stedelijk_groen                    ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/sportterrein                       ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/volkstuin                          ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Dagrecreatief_terrein              ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Verblijfsrecreatief_terrein        ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/begraafplaats                      ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Zonnepark                          ? Agrarisch_overig * Factor_Uitkoopfunctie
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Spoorterrein                       ? Infrastructuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Hoofdweg                           ? Infrastructuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Vliegveld                          ? Infrastructuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Metro_en_sneltram                  ? Infrastructuur
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/IJsselmeer_en_Markermeer           ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Afgesloten_zeearm                  ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Rijn_en_Maas                       ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Randmeer                           ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Spaarbekken                        ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Recreatief_binnenwater             ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Binnenwater_voor_delfstofwinning   ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Vloei_en_slibveld                  ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Overig_binnenwater                 ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Waddenzee_Eems_en_Dollard          ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Oosterschelde                      ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Westerschelde                      ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Noordzee                           ? Water
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Oorspronkelijk_NoData              ? 0[Eur_ha]
		: id(/Classifications/Grondgebruik/CBSKlasse) == V/Buitenland                         ? 0[Eur_ha]
		: Stedelijk
		, Descr = "De prijs per hectare per bodemgebruiksklasse van het basisjaar. De laatste tak is Stedelijk en niet nul: alles wat niet met name staat is bebouwd terrein, zodat geen klasse per ongeluk
					gratis is; alleen NoData en buitenland staan op nul. Woonterrein staat niet op nul, want een cel woonterrein zonder verblijfsobject (tuin, plein, straatprofiel) dekt de WOZ niet; de
					dubbeltelling met de WOZ vangt de suitability af door de post op nul te zetten zodra er woningverwerving op de cel is.";
	}

	container Exploitatieposten
	: Descr = "De posten die in een residuele grondwaardeberekening tussen de aanneemsom en de verkoopprijs staan (#672): de btw over de verkoopprijs, de bijkomende kosten inclusief de rente tijdens de
				bouw, en de winst- en risicovergoeding van de ontwikkelaar. Grondslag voor Opbrengsten, BijkomendeKosten en WinstEnRisico in Suitability_Wonen_perOP_T. Zonder deze posten komt het verschil
				tussen aanneemsom en verkoopprijs als grondwaarde in het residu terecht. Geen dubbeltelling met de bouwkosten, want CBS 83673NED meet de bouwsom exclusief btw, honoraria, leges en rente; en
				niet met de grondproductiekosten, want de Fakton-regressie dekt de grondexploitatie (BouwWoonrijp, Bovenwijks, PlanProces) en niet de vastgoedexploitatie. De btw grijpt aan op de opbrengst,
				want de hedonische prijs rust op bestaande koopwoningen zonder btw en een nieuwbouwwoning wordt vrij op naam inclusief 21 procent verkocht; de stap van kosten koper naar vrij op naam en de
				verkoopkosten zijn verwaarloosd. Er staat geen schakelaar omheen: de btw is een tarief en de opslag is waargenomen; wie een post wil uitzetten zet zijn parameter op nul.", Source = "EIB, Kostenoptimalisatie woningbouw, maart 2026, in opdracht van het ministerie van VRO, 79 Woningbouwimpuls-projecten met bijna 65.000 woningen"
	, URL = "https://www.eib.nl/publicaties/kostenoptimalisatie-woningbouw/"
	{
		parameter<Float32> BTW_tarief := 0.21f, IntegrityCheck = "this >= 0f && this < 1f"
		, Descr = "Het algemene btw-tarief, Wet op de omzetbelasting 1968. Geen schatting maar een tarief; het staat hier als parameter zodat OpbrengstFactor een afleiding is en geen los getal, en zodat een gevoeligheidsanalyse mogelijk is.";

		parameter<Float32> OpbrengstFactor := 1f / (1f + BTW_tarief), IntegrityCheck = "this > 0f && this <= 1f"
		, Descr = "Het deel van de verkoopprijs dat de ontwikkelaar overhoudt: 0,826 bij 21 procent btw. Vermenigvuldigt de opbrengstterm in de suitability. Hier is ook de plek voor een latere verkoopkostenfractie, want die grijpt op dezelfde grootheid aan.";

		parameter<Float32> BijkomendeKostenOpslag := 0.389f, IntegrityCheck = "this >= 0f"
		, Descr = "Opslag op de bouwsom voor de bijkomende kosten: honoraria van ontwerp, advies en onderzoek, projectorganisatie, leges, kwaliteitsborging en vergunningen, rente tijdens de bouw, voorzieningen
					en onvoorzien. Uit het EIB-rapport in de toelichting op de container: bijkomende kosten 58.000 euro op een bouwsom van 149.300. De best onderbouwde van de drie parameters, gedefinieerd op
					dezelfde grootheid als het CBS-kental; het voorbehoud is de populatie van grote, overwegend binnenstedelijke projecten met een lange doorlooptijd, waarin de rentecomponent eerder hoog dan
					laag ligt voor een uitleglocatie.", Source = "EIB, Kostenoptimalisatie woningbouw, maart 2026, figuur stichtingskosten per woning";

		parameter<Float32> WinstEnRisicoFractie := 0.07f, IntegrityCheck = "this >= 0f && this < 1f"
		, Descr = "De winst- en risicovergoeding van de ontwikkelaar, als fractie van de vastgoedinvestering (bouwsom plus bijkomende kosten). Aanname zonder bron, de zwakste van de drie: grondprijzenbrieven
					noemen de post wel maar leggen het percentage niet vast, en het EIB-rapport meet stichtingskosten en niet de marge. Niet te verwarren met de staartkosten van de aannemer, die al in de
					aanneemsom zitten. Grondslag bewust de investering en niet de opbrengst, zodat de post zwaarder drukt waar duur gebouwd wordt; op 0 valt hij weg zonder de andere twee te raken. Kalibreren
					tegen werkelijke vastgoedexploitaties voordat de uitkomst als getal naar buiten gaat.";
	}

	container Bodemdalingkosten
	: Descr = "De tarieven van de bodemdalingkosten voor woningbouw (#505), gelezen door BaseData/Suitabilities/Bodemdalingkosten: de tabellen E-1 tot en met E-9 van bijlage E, in euro per m2, exclusief btw, prijspeil GWWkosten 2024 en een interne kostendatabase van Sweco. De opslag van 19 procent voor algemene kosten, uitvoeringskosten en winst en risico staat apart in Opslag."
	{
		parameter<Eur_m2> Ophogen_permeter     := 20[Eur_m2],  Descr = "Ophogen en voorbelasten met ophoogzand, per m2 per meter ophoging.";
		parameter<Eur_m2> Paal_kort            := 25[Eur_m2],  Descr = "Heipalen van 1,2 tot 5 meter.";
		parameter<Eur_m2> Paal_permeter        := 25[Eur_m2],  Descr = "Heipalen boven 5 meter, per meter paallengte.";
		parameter<Eur_m2> Afgraven_permeter    := 15[Eur_m2],  Descr = "Afgraven en afvoeren grond, per m2 per meter, transportafstand circa 25 km, geen restwaarde.";
		parameter<Eur_m2> Afgraven_vast        := 15[Eur_m2],  Descr = "Afgraven en afvoeren grond onder bebouwing bij drijvend bouwen, per m2.";
		parameter<Eur_m2> Drijfconstructie     := 600[Eur_m2], Descr = "Drijf- en aanmeerconstructie. De gevoeligheidsanalyse F.11 van het rapport rekent met 500.";
		parameter<Eur_m2> InrichtenGroen       := 5[Eur_m2],   Descr = "Inrichten groen: struiken en heesters, gras, bermen.";
		parameter<Eur_m2> InrichtenPark        := 20[Eur_m2],  Descr = "Inrichten park, wijk-, buurt- of blokgroen: grasveld met bomen, betonband, een bankje met prullenbak.";
		parameter<Eur_m2> Verharding           := 75[Eur_m2],  Descr = "Straatklinkers met een fundering van menggranulaat van 0,3 m.";
		parameter<Eur_m2> Riolering            := 161[Eur_m2], Descr = "Riool exclusief verharding, drukriool met 30 procent opslag, 30/70 verdeling enkele en dubbele streng, 890 euro per m1 gedeeld door 5,5 meter straatbreedte.";
		parameter<Eur_m2> Steigers             := 1000[Eur_m2],Descr = "Plaatsen steigers voor toegang tot de woningen bij drijvend bouwen.";
		parameter<Eur_m2> Betonconstructie     := 278[Eur_m2], Descr = "Betonconstructie zonder verharding: afgraven en afvoeren tot 1,5 m, werkvloer 0,3 m, betonconstructie 0,55 m, grond of zand 2 m.";
		parameter<Eur_m2> BetonEnVerharding    := 340[Eur_m2], Descr = "Betonconstructie met verharding. Bevat blijkens de opbouw in het rapport al klinkerverharding a 62 euro, dus de losse verhardingspost van 75 euro telt hier niet nog eens bovenop. Zie AlternatiefE_TeltVerhardingApart.";

		parameter<Eur_m2> EPS_permeter         := 125[Eur_m2], Descr = "Licht ophoogmateriaal EPS, per m2 per meter laagdikte.";
		parameter<Eur_m2> EPS_afgraven_permeter:= 5[Eur_m2],   Descr = "Afgraven bij licht ophoogmateriaal, per m2 per meter. De afgegraven laag wordt in het gebied hergebruikt en hoeft niet te worden afgevoerd, vandaar het lagere tarief dan bij drijvend bouwen.";
		parameter<meter>  EPS_afdeklaag        := 0.3[meter],  Descr = "Dikte van de leeflaag bovenop het EPS, waarvoor de kaart DikteEPS is doorgerekend.";
		parameter<Eur_m2> Afdeklaag_permeter   := 20[Eur_m2],  Descr = "Aanbrengen afdeklaag van grond of zand, per m2 per meter.";

		parameter<meter>  OphoogdikteAlternatiefC := 1.2[meter], Descr = "Alternatief C hoogt overal met een vaste 1,20 meter zand op, ook waar integraal ophogen met minder toe kan.";
		parameter<meter>  OphoogdikteReferentie   := 0.2[meter], Descr = "De ophoging op een locatie zonder bodemdalingsopgave: de eis dat het nieuwe maaiveld 20 cm boven het huidige uitkomt. Het nulpunt waartegen de meerkosten worden bepaald.";

		parameter<Float32> Opslag := 1.19f, Descr = "Opslag van 19 procent voor algemene kosten, uitvoeringskosten en winst en risico, zoals in het rapport op alle aanlegkosten gelegd.";

		parameter<Eur_m2> Onderhoud_Groen      := 73.16[Eur_m2],  Descr = "Tabel E-9: groenonderhoud a 1,80 euro per m2 per jaar, contant gemaakt over 100 jaar. Geldt voor tuinen, parken en de overige openbare ruimte, in alle zes de alternatieven.";
		parameter<Eur_m2> Onderhoud_Water      := 27.73[Eur_m2],  Descr = "Tabel E-9: baggerkosten a 0,67 euro per m2 per jaar, contant over 100 jaar. Alleen bij drijvend bouwen gerekend, vanwege het grote wateroppervlak.";
		parameter<Eur_m2> Onderhoud_Verharding := 40.64[Eur_m2],  Descr = "Tabel E-9: 1,00 euro per m2 per jaar, onderhoudscyclus van 52 jaar op basis van CROW-145.";
		parameter<Eur_m2> Onderhoud_Riolering  := 108.38[Eur_m2], Descr = "Tabel E-9: 1,60 euro per m2 per jaar, stelsel een keer vervangen in 100 jaar.";
		parameter<Eur_m2> Onderhoud_Steigers   := 364.75[Eur_m2], Descr = "Tabel E-9: een keer per twee jaar schoonspuiten a 5 euro per m2 en een keer per 60 jaar vervangen a 1.000 euro per m2. Alleen bij drijvend bouwen.";

		parameter<Bool> AlternatiefE_TeltVerhardingApart := FALSE
		,	Descr = "Tabel E-3 zet bij alternatief E een kruisje bij Aanbrengen verharding en bij Aanbrengen betonconstructie en verharding, terwijl de opbouw van dat laatste bedrag in de lopende tekst al
					klinkerverharding bevat, en in E-4 heeft verharding bij E geen kruisje; dat lezen wij als een dubbeltelling in E-3 en de verharding telt bij E niet apart mee. Een aanname; zie de openstaande
					vraag aan Deltares in #505.";
	}
}
