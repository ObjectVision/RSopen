container Wonen
{
	parameter<Yr>        GeenSlooptotLeeftijd_BinnenHardePlancapaciteit      := 25[Yr], Descr = "Geen sloop toegestaan van woningen met een leeftijd jonger dan opgegeven.";
	parameter<String>    Suitability_ref                                     := 'ExploitatieSaldo', Descr = "Grondslag voor de empirische onderbouwing van de geschiktheid van ontwikkelpakketten binnen de sector Wonen: ExploitatieSaldo, ResidueleWaarde";
	parameter<String>    grondproductie_kosten_Variant                       := 'Nominaal_high', Descr = "Variant binnen een bandbreedte  t.a.v. onzekerheid qua: 1) standaardfout (statistische onzekerheid), en; 2) keuzeopties tav de controlevariabelen (referentie of niet)";
	parameter<bool>      Grondproductie_BovenwijksAlsTotaalInDuizendEuro     := TRUE, Descr = "Leest de Bovenwijks-schatting als een totaalbedrag in duizenden euro per plangebied in plaats van als euro per hectare, en rekent die om naar euro per hectare. Zonder deze correctie komt de component op circa 4 euro per hectare uit, wat geen kostenpost is. Met de correctie op 38.000 tot 55.000 euro per hectare, afhankelijk van de omvang van het plangebied. De onderbouwing staat bij Grondproductiekosten/T/CalculateCosts/NoemerCorrectie. Op FALSE zetten geeft het gedrag van voor #505.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_A                 := TRUE, Descr = "Mag inrichtingsalternatief A, integraal ophogen, meedoen in de keuze van het goedkoopste alternatief? Dit is ook de referentie voor de meerkosten, dus uitzetten heeft alleen zin als je wilt weten wat de andere vijf zonder hem doen.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_B                 := TRUE, Descr = "Mag B, partieel ophogen, meedoen? Hoogt alleen bebouwing, straten en overige openbare ruimte op en laat tuinen, parken en water op het oorspronkelijke materiaal liggen.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_C                 := TRUE, Descr = "Mag C, ophogen met een vaste 1,20 meter zand, meedoen? Alleen toegestaan waar integraal ophogen met niet meer dan 1,20 meter toe kan, en daar is C per definitie niet goedkoper, dus hij wint nooit. Zie de toelichting bij Bodemdalingkosten/Beschikbaar/C.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_D                 := TRUE, Descr = "Mag D, licht ophoogmateriaal met EPS, meedoen? Alleen beschikbaar waar de EPS-kaart een waarde geeft.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_E                 := TRUE, Descr = "Mag E, alles funderen, meedoen? Let op dat de heipaallengte in de levering is afgekapt op de klasse boven 14 meter, dus dit alternatief is onderschat op de 3.370 km2 waar die afkapping bijt.";
	parameter<bool>      Bodemdaling_AlternatiefToegestaan_F                 := TRUE, Descr = "Mag F, drijvend bouwen, meedoen? De afgraafdieptes op de zandgronden lopen tot 251 meter en maken dit alternatief daar vanzelf onbetaalbaar; dat is bedoeld gedrag van het rapport en geen fout.";

	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2022                := 1.23f, Descr = "Voor 2022 met 2017==100 -> 1.23; voor 2023 met 2017=100 -> 1.29", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83887NED/table";
	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2023                := 1.29f, Descr = "Voor 2022 met 2017==100 -> 1.23; voor 2023 met 2017=100 -> 1.29", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83887NED/table";
	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2024                := 1.33f, Descr = "Inputprijsindex bouwkosten nieuwbouwwoningen (component Totaal), herbasering 2017=100. 2022->1.23, 2023->1.29. Tabel 83887NED (2015=100) stopt in 2023; 2024/2025 uit opvolger 85728NED (2021=100), aan 83887NED geketend op overlapjaar 2023: index_Y = (134.2/103.9) * (jaar_Y / 115.4). 2024: 118.5 -> 1.33.", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/85728NED/table";
	parameter<Float32>   PrijsIndex_Bouwkosten_2017_naar_2025                := 1.37f, Descr = "Inputprijsindex bouwkosten nieuwbouwwoningen (component Totaal), herbasering 2017=100. Zie _naar_2024 voor methode; geketend op overlapjaar 2023: (134.2/103.9) * (jaar_2025 / 115.4). 2025: 122.8 -> 1.37.", URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/85728NED/table";

	parameter<float32>   WoningPrijsVerandering_2022_naar_2023               := 0.971f, Descr = "Jaarlijkse groei van 2022 op 2023, obv gemiddelde woningverkoop. Bron CBS Statline.";
	parameter<float32>   WoningPrijsVerandering_2023_naar_2023               := 1f, Descr = "Jaarlijkse groei van 2022 op 2023, obv gemiddelde woningverkoop. Bron CBS Statline.";
	parameter<float32>   WoningPrijsVerandering_2023_naar_2024               := 1.084f, Descr = "Groei 2023->2024, obv gemiddelde verkoopprijs bestaande koopwoningen: 450985/416153 = 1.084. Bron CBS 85773NED (GemiddeldeVerkoopprijs).";
	parameter<float32>   WoningPrijsVerandering_2023_naar_2025               := 1.152f, Descr = "Groei 2023->2025, obv gemiddelde verkoopprijs bestaande koopwoningen: 479527/416153 = 1.152. Bron CBS 85773NED (GemiddeldeVerkoopprijs).";
	
	parameter<String>    OPGroenAlsNatuur_ref                                := 'NbS', Descr = "Welk groen uit de ontwikkelpakketten meetelt als natuur in de hedonische groenwaardering (#566, #677). 'NbS' is de default: al het groen van de NbS-pakketten, uitgeefbaar plus openbaar, conform de afspraak met Deltares 2026-08-20 in #566. 'Alle' laat elk pakket meetellen, 'Geen' zet het uit.
																				Waar de keuze op neerkomt, nagetrokken in #677. De coefficient hoort bij fr_natuur_tot2500m, gemeten als het aandeel LGN-natuur. LGN sluit bos en gras BINNEN bebouwd gebied uit (klassen 20, 22, 23, 28), maar moeras, riet, moerasbos en natuurlijk beheerd grasland (41, 42, 43, 45) tellen wel mee en dragen geen voorbehoud over bebouwd gebied. Of pakketgroen meetelt hangt dus af van de vraag of LGN zo een wijk als bebouwd gebied zou begrenzen, en dat is uit deze configuratie niet af te leiden.
																				De default blijft 'NbS' omdat de NbS-pakketten geen woonwijken met bermen zijn maar landschappen met woningen erin: NuanceerdLNLLaagVS heeft een bebouwd oppervlak van 8 procent (GSI 0,08), 4 tot 6 procent verharding, circa 61 procent groen en 35 procent water, en maar 16 procent van de buurt zit in uitgeefbare kavels. Het standpunt vanuit Deltares in #566 is dat dat groen echte natuur is, bijvoorbeeld aaneengesloten riet. De pakkettabel kent geen natuurtype (alleen boom, gras en struik), dus die vraag is niet op de data te beslissen; wordt zo een type ooit geleverd, dan kan het een kolom in de tabel worden.
																				Gemeten in #677, zichtjaar 2040: het pakketgroen is 12.192 ha, 3,0 procent van de natuurtoename, en 11,97 mld van de waardeverandering van de bestaande voorraad in NbSGenuanceerd. In BAU is het effect exact nul, want de zeef houdt NbS-pakketten buiten niet-NbS-varianten.
																				De schakelaar werkt op de indicator en op de allocatie tegelijk, want die lezen sinds #637 hetzelfde sjabloon Templates/Suitabilities/Groenfracties_T. Zolang hij aanstaat is er een terugkoppeling over zichtjaren heen: een nieuw pakket verhoogt de natuurfractie in de omgeving, die verhoogt de prijs, en die verhoogt in het volgende zichtjaar de geschiktheid voor nog meer bouw op dezelfde plek.";

	parameter<String>    OPWaterAlsWater_ref                                 := 'Alle', Descr = "Welk water uit de ontwikkelpakketten meetelt als open water in de hedonische groenwaardering (#677). 'Alle' is de default en is het gedrag van voor #677, toen deze kant helemaal geen schakelaar had. 'NbS' beperkt het tot de NbS-pakketten, 'Geen' zet het uit.
																				Waarom deze schakelaar er is gekomen. De waterfractie van de 27 gewone pakketten is exact 0,4000 van het onverharde deel, in elk pakket, uitgeefbaar zowel als openbaar, zonder een enkele uitzondering. Dat is geen schatting maar een invulling: groen en water zijn daar in een vaste verhouding 60 op 40 over de onverharde ruimte verdeeld. Ze staat in Default_src.dms pal naast Bruin, dat expliciet const(0f) is met de opmerking dat het niet is ingeschat. De 26 NbS-pakketten lopen wel uiteen, van 0,00 tot 0,69, en die zijn dus wel ontworpen.
																				Het gevolg is dat SuperStedelijkMGVS 8 procent van zijn private buitenruimte als open water geboekt krijgt en DorpsLandelijkEGVS 36 procent, en dat die getallen vervolgens door de coefficient fr_water_500m gaan, die op de LGN-waterklassen is geschat. Gemeten in #677, zichtjaar 2040: in BAU levert dat 3.905 ha en 3,27 mld aan woningwaarde op, volledig uit die vaste verhouding. In NbSGenuanceerd 8.881 ha en 6,35 mld, waarvan het grootste deel uit de wel ontworpen NbS-fracties komt.
																				Op 'NbS' telt alleen het water mee dat daadwerkelijk als water is ontworpen. Dat is een gedragswijziging en ligt daarom bij Deltares; de default blijft tot dan 'Alle'. De echte oplossing is een waterfractie voor de gewone pakketten die wel is ingeschat, net als de nog ontbrekende Bruin-fractie.
																				Los daarvan geldt hier niet het bezwaar dat bij het groen speelt: stedelijk water valt gewoon onder de LGN-waterklassen, dus een singel of plas in een woonwijk is dezelfde grootheid als waarop de coefficient rust. Wel meet LGN op 25 meter, dus wadi's en smalle watergangen zouden daar niet zichtbaar zijn geweest.";

	parameter<float32>   DrijvendBehoudtWaterFractie                         := 0f, Descr = "Welk deel van het bestaande wateroppervlak onder een drijvend ontwikkelpakket water blijft in de hedonische groenwaardering (#505, #614). 0f is het gedrag tot nu toe: de inrichting van het ontwikkelpakket bepaalt de watercelwaarde volledig, dus een drijvende buurt op open water gaat als grotendeels gedempt de boeken in. 1f is de andere uiterste aanname: het water blijft onder de woningen bestaan en het pakket legt zich erop.
																								De fractie grijpt alleen aan op cellen waar een ontwikkelpakket fysiek is ingericht, waarvan de bouwwijze IsDrijvend is, en die in het basisjaar water waren volgens LGN. Omdat dat basisjaarwater per cel 0 of 1 is, is een waarde tussen 0f en 1f een aanname over het pakket en geen verdeling binnen de cel.
																								Werkt alleen op de hedonische groen- en waterwaardering. De verhardingsindicator en vijf andere plekken boeken de OP-inrichting nog steeds alsof die op land ligt; zie #665.";

	parameter<Bool>      BouwperiodeInVoorraadprijs                          := TRUE, Descr = "Laat de bouwperiode van de bestaande voorraad meetellen in de hedonische prijs waarmee de verwervingskosten worden bepaald (#675). De schatting kent zeven bouwperiodedummies plus een referentieklasse, bouwjaar vanaf 2002. Op FALSE staan alle zeven op nul en waardeert het model de hele voorraad als bouwjaar vanaf 2002, de duurste klasse; dat is het gedrag van voor #675. Het weglaten is geen voorzichtige aanname: in het exploitatiesaldo is verwerving een kostenpost, dus een te hoge voorraadwaarde maakt herontwikkeling van bestaande bebouwing systematisch te duur en duwt de allocatie naar onbebouwde grond. De term komt per cel uit het BAG-bouwjaar van de woningen die er staan, zie BaseData/Suitabilities/Wonen/BouwperiodeTerm.";

	parameter<int32>   VBO_opp_truncation_upper        := 500i;
	parameter<int32>   VBO_opp_truncation_lower        := 10i;
	
	container Sloopkosten
	: Descr = "De kosten van het slopen van het bestaande opstal, in euro per vierkante meter vloeroppervlak. De kentallen staan op prijspeil 2017 en gaan met PrijsIndex_Bouwkosten naar het zichtjaar. Het kental is opgebouwd uit een basisbedrag per bouwtype plus een asbesttoeslag op bouwjaar.
				Herkomst. Tot #701 stonden hier vijf kentallen van www.bouwkostenkompas.nl: vier woningtypen en het kantoorkental voor alles wat geen woning is. Die bron is niet meer toegankelijk en de niveaus bleken bij natrekken een factor drie te laag. Sinds #700 gelden ze bovendien op drie keer zoveel vierkante meters, dus het gewicht van deze post in het exploitatiesaldo was verdrievoudigd zonder dat iemand naar het kental had gekeken.
				De ijking komt uit de marktstudies die het Economisch Instituut voor de Bouw voor brancheorganisatie VERAS maakt. Die geven omzet naar activiteit en marktsector, en daarnaast het gesloopte vloeroppervlak uit de BAG, dus samen een kental per m2. Editie 2024, over 2023 en op prijspeil 2023: omzetvolume sloopwerk 800 miljoen euro, waarvan 73 procent totaalsloop, waarvan 64 procent gebouwen (woningen 22 plus overige gebouwen 42; industrie en infra vallen af). Dat is 374 miljoen euro. Gesloopt werd circa 10.000 woningen van gemiddeld 100 tot 112 m2 plus een utiliteitsoppervlak dat 2,5 maal hoger ligt, samen circa 3,6 miljoen m2. Dat geeft 104 euro per m2.
				Dezelfde som op editie 2019 over 2018: sloopwerk 640 miljoen op prijspeil 2017, totaalsloop 68 procent, gebouwen 68 procent, dus 296 miljoen, tegen 8.700 woningen van 112 m2 plus 2,4 miljoen m2 utiliteit, samen 3,37 miljoen m2. Dat geeft 88 euro per m2 op prijspeil 2017, oftewel 113 op prijspeil 2023. Twee onafhankelijke jaren komen dus op 104 en 113 uit.
				In dat bedrag zit slopen, materiaalscheiding, afvoer, terreinwerk en de overhead en marge van de sloper. Er zit geen asbestverwijdering en geen bodemsanering in; die zijn in dezelfde EIB-tabel aparte activiteiten met eigen omzet, waarbij asbest met circa 656 miljoen euro in 2023 in dezelfde orde ligt als het sloopwerk zelf. Vandaar de asbesttoeslag als losse component.
				Twee voorbehouden bij de afleiding. De verdeling naar markt en de verdeling totaalsloop tegen renovatiesloop zijn twee aparte uitsplitsingen van dezelfde omzet en ik vermenigvuldig ze alsof ze onafhankelijk zijn. En het is de omzet van gespecialiseerde sloopbedrijven; sloopwerk dat een hoofdaannemer zelf doet zit er niet in, wat het kental eerder te laag dan te hoog maakt.
				Offerteprijzen van onderaf liggen ongeveer een factor twee lager: 30 tot 45 euro per m2 voor een agrarische stal inclusief asbest en zandaanvulling (DLV Advies, 2019), 40 tot 55 voor een complete woningsloop inclusief draagconstructie en 30 tot 35 voor sloop tot de fundering. Dat verschil is verklaarbaar: offertes gelden een eenvoudige, bereikbare, vrijstaande situatie zonder vergunningen, bemaling, tijdelijke voorzieningen en stedelijke beperkingen. Voor binnenstedelijke herontwikkeling, waar dit model over gaat, ligt de bovenkant meer voor de hand."
	, URL = "https://www.sloopaannemers.nl/site/media/upload/files/2555_rapportage-marktstudie-slopers-2024-definitief-pdf_pdf_20241114134645.pdf"
	{
		parameter<Eur_m2>  Basis_Rijtjeswoning_2017    :=  48[Eur_m2], Descr = "Basiskental woningsloop, prijspeil 2017, dus 62 euro op prijspeil 2023. De onderlinge verhouding tussen de vier woningtypen komt nog van bouwkostenkompas (22, 40, 57 en 22); alleen het niveau is met een factor 2,2 op de sectorcijfers geijkt. Gewogen naar de gesloopte woningvoorraad, die vooral uit naoorlogse rijtjeswoningen en appartementen bestaat, komt het gemiddelde daarmee rond de 53 euro op prijspeil 2017 uit, plus de asbesttoeslag voor het deel van voor 1994.";
		parameter<Eur_m2>  Basis_Twee_onder_1_kap_2017 :=  88[Eur_m2], Descr = "Idem, 114 euro op prijspeil 2023.";
		parameter<Eur_m2>  Basis_Vrijstaand_2017       := 125[Eur_m2], Descr = "Idem, 161 euro op prijspeil 2023. Dit is het minst comfortabele van de vier: bouwkostenkompas zette vrijstaand op 2,6 maal rijtjeswoning en die spreiding blijft hier staan, waardoor de bovenkant boven het landelijke sectorcijfer uitkomt. Meer facade, meer terreinwerk en een eigen fundering per woning maken een hogere prijs per m2 aannemelijk, maar de omvang van het verschil rust op een bron die niet meer te raadplegen is.";
		parameter<Eur_m2>  Basis_Appartement_2017      :=  48[Eur_m2], Descr = "Idem, 62 euro op prijspeil 2023.";

		parameter<Eur_m2>  Basis_Hal_2017 := 43[Eur_m2]
		, Descr = "Basiskental voor het deel van het niet-woonvloeroppervlak dat hal is: groot, eenlaags en eenvoudig van constructie. Een stalen hal gaat snel tegen de vlakte en het staal heeft restwaarde. Dit is de onderkant van het sectorcijfer en de bovenkant van de agrarische offertes van 30 tot 45 euro per m2. Prijspeil 2017, dus 55 euro op prijspeil 2023.";

		parameter<Eur_m2>  Basis_OverigeUtiliteit_2017 := 101[Eur_m2]
		, Descr = "Basiskental voor de overige utiliteit: kantoren, winkels, scholen, zorg. Meerlaags, meer binnenafwerking en installaties, vaker binnenstedelijk. Zo gekozen dat de landelijke mix, 42 procent hal, uitkomt op circa 77 euro per m2 op prijspeil 2017 en dus circa 100 op prijspeil 2023, wat het sectorcijfer is. Prijspeil 2017, dus 130 euro op prijspeil 2023. De verdeling van het sectorcijfer over hal en overige utiliteit staat in geen bron; de verhouding tussen deze twee is marktkennis en het niveau volgt uit de mix.";

		parameter<Eur_m2>  AsbestToeslag_2017 := 20[Eur_m2]
		, Descr = "Toeslag per vierkante meter vloeroppervlak voor panden met een bouwjaar voor AsbestBouwjaarGrens, boven op het basiskental.
					Onderbouwing: ruim 40 euro per m2 asbesthoudend dak of gevelpaneel (van Bree, Hulsker en Wienhoven 2012, geciteerd in de EIB-marktstudie 2014), tegen 7 tot 40 euro per m2 in de consumentenmarkt. De helft daarvan als toeslag per m2 VLOERoppervlak, want lang niet elk pand van voor 1994 heeft een asbestdak (van de circa 130 miljoen m2 asbestdaken in Nederland zit 75 procent in de agrarische sector) en bij een meerlaags pand is het dakoppervlak kleiner dan het vloeroppervlak.
					Dit is het zwakste van de kentallen hierboven: beredeneerd en niet gemeten. Op 0[Eur_m2] valt de component weg.";

		parameter<yr>      AsbestBouwjaarGrens := 1994[yr]
		, Descr = "Bouwjaar waaronder de asbesttoeslag geldt. 1994 is het jaar van het Nederlandse verbod op het toepassen van asbest. Gemeten op de jaarset Y2023 is 53,1 procent van het niet-woonvloeroppervlak van voor 1994, met 4,7 miljoen m2 zonder bouwjaar; dat laatste deel krijgt geen toeslag, wat de post eerder te laag dan te hoog maakt. Per gebruiksdoel loopt het aandeel van voor 1994 van 38 procent bij logistiek tot 74 procent bij bijeenkomstfunctie.";

		parameter<Eur_m2>  rijtjeswoning         := ='Basis_Rijtjeswoning_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  twee_onder_1_kap      := ='Basis_Twee_onder_1_kap_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  vrijstaand            := ='Basis_Vrijstaand_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  appartement           := ='Basis_Appartement_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  Hal                   := ='Basis_Hal_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  OverigeUtiliteit      := ='Basis_OverigeUtiliteit_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
		parameter<Eur_m2>  Asbest                := ='AsbestToeslag_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear);
	}

	unit<UInt32> Bouwkosten := ='SourceData/RegioIndelingen/CBS/Y'+string(ModelParameters/Model_StartYear)+'/gpkg/landsdeel_gegeneraliseerd'
	, Descr = "Kentallen van CBS, uitgelezen september 2025. Oppervlaktes zijn BVO!"
	, URL = "https://opendata.cbs.nl/#/CBS/nl/dataset/83673NED/table?dl=C651A" 
	{
		attribute<String> Landsdeel_naam     : ['Noord','Oost','West','Zuid'];
		attribute<String> label              := statnaam;
		attribute<Eur_m2> Huurwoningen_2022  : [ 945, 1029, 1108, 1021];
		attribute<Eur_m2> Huurwoningen_2023  : [1220, 1190, 1379, 1108];
		attribute<Eur_m2> Huurwoningen_2024  : [1273, 1293, 1497, 1224];
		attribute<Eur_m2> Huurwoningen_2025  : [1288, 1336, 1604, 1204];
		
		attribute<Eur_m2> Koopwoningen_2022  : [ 995,  995, 1054,  969];
		attribute<Eur_m2> Koopwoningen_2023  : [1193, 1100, 1233, 1089];
		attribute<Eur_m2> Koopwoningen_2024  : [1216, 1124, 1292, 1081];
		attribute<Eur_m2> Koopwoningen_2025  : [1290, 1189, 1348, 1134];
		
		attribute<Eur_m2> Huurwoningen       := ='Huurwoningen_'+string(ModelParameters/Model_StartYear);
		attribute<Eur_m2> Koopwoningen       := ='Koopwoningen_'+string(ModelParameters/Model_StartYear), IntegrityCheck = "All(Landsdeel_naam+'-Nederland' == statnaam)", Descr = "Check om ervoor te zorgen dat de volgorde deze handmatig opgegeven waardes matches met de volgorde van de regios.";
		
		attribute<.>      Per_AllocDomain (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>      Per_AdminDomain (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];

		attribute<Eur_m2> SocialeHuur (AdminDomain) := Huurwoningen[Per_AdminDomain];
		attribute<Eur_m2> VrijeSector (AdminDomain) := Koopwoningen[Per_AdminDomain];
	}
	
	container Bouwkosten_Woningtype
	: Descr = "De differentiatie van de bouwkosten naar woningtype (#673). Het niveau blijft bij CBS 83673NED hierboven; deze container draagt alleen een dimensieloze verhouding tussen de vier woningtypen, plus de nieuwbouwmix waarop die verhouding wordt genormaliseerd.

				Wat het probleem was. CBS 83673NED splitst de bouwkosten van nieuwbouwwoningen alleen naar landsdeel en naar huur tegen koop. De dimensie woningtype bestaat daar niet en kan er ook niet komen, want de vergunningenstatistiek legt van een bouwwerk wel gemeente, soort bouwwerk, bestemming, aard van de werkzaamheden, opdrachtgever, bouwkosten, inhoud, oppervlakte en bouwtijd vast, maar geen woningtype. Tot #673 kreeg elk van de 53 ontwikkelpakketten daardoor hetzelfde landsdeelkental, zodat een appartementengebouw per vierkante meter bvo evenveel kostte als een vrijstaande woning. Dat is de omgekeerde volgorde van wat de bouwkostenbureaus meten.

				Herkomst van de verhouding. Gemeentelijke kengetallenlijsten voor de bouwlegestoets, alle openbaar bekendgemaakt en alle in euro per m2 bvo. Zij gaan terug op het Kengetallenkompas Bouwkosten van IGG Bouweconomie; Sudwest-Fryslan noemt die herkomst met zoveel woorden en kwantificeert daarbij de Friese regiokorting van 7 procent, die uniform is en dus in elke verhouding wegvalt. Genormeerd op de rijtjeswoning, met per lijst de rij die het beste bij het type past, geven vijf onafhankelijke lijsten voor twee onder 1 kap, vrijstaand en appartement:
				Groningen 2022, seriematig 2 laags schuin dak 1.108, twee onder 1 kap schuin dak 1.287, cataloguswoning 2 laags 1.235 en appartementenblok tot 6 lagen 1.441, geeft 1,16 / 1,11 / 1,30.
				Sudwest-Fryslan, 977, 1.107, 1.064 en 1.264, geeft 1,13 / 1,09 / 1,29.
				Hulst 2026, 1.318, 1.517, 1.453 en 1.716, geeft 1,15 / 1,10 / 1,30.
				Sluis 2025, 1.123, 1.407, 1.530 en 1.588, geeft 1,25 / 1,36 / 1,41.
				Harderwijk 2026, 1.386, 1.298, 1.555 en 1.460, geeft 0,94 / 1,12 / 1,05.
				De kolom Index is de mediaan daarvan. Sluis en Harderwijk zijn de twee uitschieters, aan weerszijden, en de mediaan is daar ongevoelig voor. De ordening ligt in de andere drie lijsten vast: rijtjeswoning het goedkoopst, appartement het duurst. Groningen 2026, de lopende editie van dezelfde lijst, geeft voor de twee grondgebonden typen 1,15 en 1,11 en bevestigt de verhoudingen dus in de huidige jaargang.

				Waarom alleen de verhouding en niet het niveau. Dit zijn normbedragen voor de heffingsmaatstaf van leges volgens NEN 2699, bedoeld om een opgegeven aanneemsom te toetsen, en geen marktwaarnemingen; Harderwijk publiceert bovendien inclusief btw en de andere exclusief. Het niveau blijft daarom bij CBS, de enige landelijke, jaarlijks geactualiseerde waarneming van werkelijk opgegeven bouwsommen. Dezelfde werkverdeling als bij de sloopkosten sinds #701.

				Waarom er genormaliseerd wordt. De huur/koop-as van CBS draagt het woningtype al indirect mee, want huurnieuwbouw is grotendeels gestapeld: de gemiddelde oppervlakte per nieuwbouwwoning is 105 m2 bij huur en 184 m2 bij koop. De 11,8 procent waarmee het West-huurkental in 2023 boven het West-koopkental ligt is dus grotendeels type-mix. Een type-opslag daar ongeschaald bovenop zou dat effect twee keer tellen. Door de index te delen door het mixgewogen gemiddelde van diezelfde index BINNEN de huursector blijft het gewogen gemiddelde per landsdeel en huursector exact het CBS-cijfer, en gaat precies het mix-deel uit de huur/koop-spreiding.

				Wat daar uitkomt, als controle achteraf. Het resterende huursectoreffect bij hetzelfde woningtype is 0,965, dus sociale huur is 3,5 procent goedkoper per m2 bvo dan vrije sector. Dat is niet ingevoerd maar volgt uit de som, en de Groningse lijst meet er los van 1.068 tegen 1.108 voor geschakelde sociale huur tegen een seriematige rijtjeswoning, oftewel 0,964.

				Wat de constructie niet kan. In diezelfde lijst verschilt de huursectorkorting per woningtype: 0,96 grondgebonden tegen 0,87 voor sociale huur tot 4 lagen ten opzichte van het appartementenblok. Een enkele normalisator per huursector kan dat niet uitdrukken; daarvoor is een volledige tabel van vier woningtypen maal twee huursectoren nodig, en die keuze ligt bij Deltares. Verder omvat de CBS-kolom Huurwoningen ook vrijesectorhuur terwijl het model haar aan sociale huur toekent; die benadering bestond al voor #673."
	, URL = "https://lokaleregelgeving.overheid.nl/CVDR747733/1"
	{
		unit<UInt8> Src: NrOfRows = 4
		, Descr = "De kentallen per woningtype, met de naam als sleutel zodat de volgorde van WP4 hier niet hoeft te worden nagebouwd."
		{ //                                        0                  1                   2                3
			attribute<String>  WP4_name          : ['rijtjeswoning', 'twee_onder_1_kap', 'vrijstaand', 'appartement'];
			attribute<String>  Label            := WP4_name, DialogType = "LabelText";

			attribute<Float32> Index             : [           1.00,               1.15,         1.12,          1.30]
			, IntegrityCheck = "all(this > 0f)"
			, Descr = "Relatieve bouwkosten per m2 bvo, rijtjeswoning is 1,00. Dimensieloos: het niveau komt van CBS. Mediaan over vijf gemeentelijke kengetallenlijsten, zie de toelichting op de container. De appartementwaarde is gemeten op de rij appartementenblok tot 6 lagen en niet op de rij woontoren: de meergezinspakketten van dit model lopen van 2,00 tot 7,00 bouwlagen en zijn dus blokken en geen torens. Zie ook Classifications/Modellering/BouwlaagK.";

			attribute<Float32> EengezinsMix      : [          0.576,              0.149,        0.275,          0.00]
			, IntegrityCheck = "abs(sum(this) - 1f) < 0.001f"
			, Descr = "De woningtypeverdeling BINNEN de eengezinsnieuwbouw. Gemeten en niet aangenomen: CBS 86084NED telt de nieuwbouw van 2023 naar woningtype en geeft landelijk 13.735 tussenwoningen plus 6.630 hoekwoningen, samen 20.365 rijtjeswoningen, tegen 5.280 twee-onder-1-kapwoningen en 9.720 vrijstaande woningen, samen 35.365. Appartement staat hier op nul, want dat type zit in de andere tak van de splitsing.";

			attribute<Classifications/Vastgoed/WP4> WP4_rel := rlookup(WP4_name, /Classifications/Vastgoed/WP4/name)
			, IntegrityCheck = "all(IsDefined(this))"
			, Descr = "Koppeling naar de BAG-typologie via de naam en niet via een nummer, zodat een typefout hard faalt in plaats van stil naar het verkeerde type te wijzen. Zelfde constructie als Dieptevermogen_rel bij BouwwijzeK.";
		}

		unit<UInt8> MixSrc: NrOfRows = 2
		, Descr = "Het aandeel gestapelde bouw in de nieuwbouw per huursector, waarop de index wordt genormaliseerd."
		{ //                                         0                1
			attribute<String>  VSSH_name          : ['VrijeSector', 'SocialeHuur'];
			attribute<String>  Label             := VSSH_name, DialogType = "LabelText";

			attribute<Float32> MeergezinsAandeel  : [         0.16,          0.87]
			, IntegrityCheck = "all(this >= 0f && this <= 1f)"
			, Descr = "Het aandeel appartementen in de nieuwbouw van deze huursector. Afgeleid uit CBS 83673NED zelf, dus uit dezelfde tabel en dezelfde populatie waaraan het niveau is verankerd. Die tabel geeft voor 2023 een gemiddelde oppervlakte per nieuwbouwwoning van 105 m2 bij huur en 184 m2 bij koop. CBS 82550NED geeft voor de voorraad met bouwjaar 2015 tot 2025 een gemiddeld gebruiksoppervlak van 153 m2 bij eengezins en 71 m2 bij meergezins, wat met de vormfactoren van dit model, 0,76 en 0,78, neerkomt op 201 en 91 m2 bvo. Oplossen geeft 0,87 bij huur en 0,16 bij koop.

						Twee controles die deze afleiding dragen. Terugrekenen naar het landelijke aandeel appartementen in de nieuwbouw geeft 0,52 bij een huuraandeel van 0,52, en CBS 86084NED telt voor 2023 feitelijk 37.755 meergezinswoningen op 73.255 nieuwbouwwoningen, dus 0,52, met 37.950 huurwoningen, dus eveneens 0,52. En de aanname dat de oppervlakte in 83673NED een bruto maat is, is de enige rekenkundig mogelijke: bij een gebruiksoppervlakte-lezing wordt de koopvergelijking onoplosbaar, want 184 ligt dan boven de eengezinswaarde 153.

						De gevoeligheid is tweede orde. Acht procentpunt verschuiving in dit aandeel verandert de normalisator met circa twee procent, tegenover een type-differentiatie van dertig procent. Zet beide waarden gelijk om de correctie voor de dubbeltelling uit te zetten; het gewogen gemiddelde per landsdeel blijft dan nog steeds het CBS-cijfer, maar het type-effect komt dan boven op het mix-effect dat al in de huur/koop-as zit.";

			attribute<Float32> Normalisator      := MeergezinsAandeel * Index_appartement + (1f - MeergezinsAandeel) * Index_eengezins
			, IntegrityCheck = "all(this > 0f)"
			, Descr = "Het mixgewogen gemiddelde van de index binnen deze huursector: 1,094 voor de vrije sector en 1,268 voor de sociale huur. Delen door deze waarde houdt het gemiddelde kental per m2 bvo per landsdeel gelijk aan het CBS-cijfer.";

			attribute<Classifications/Vastgoed/VSSH> VSSH_rel := rlookup(VSSH_name, /Classifications/Vastgoed/VSSH/name)
			, IntegrityCheck = "all(IsDefined(this))"
			, Descr = "Koppeling naar de huursectorindeling via de naam, zelfde constructie als Src/WP4_rel.";
		}

		parameter<Float32> Index_appartement := Index_perWP4[/Classifications/Vastgoed/WP4/V/appartement]
		, Descr = "De index van het appartement, apart gezet omdat de normalisatie de splitsing eengezins tegen meergezins volgt en niet de vier typen los.";

		parameter<Float32> Index_eengezins   := sum(Src/Index * Src/EengezinsMix)
		, IntegrityCheck = "this > 0f"
		, Descr = "Het naar de gemeten nieuwbouwverdeling gewogen gemiddelde van de drie grondgebonden typen, 1,055.";

		attribute<Float32> Index_perWP4         (/Classifications/Vastgoed/WP4)  := rjoin(/Classifications/Vastgoed/WP4/name,  Src/WP4_name,     Src/Index)
		, IntegrityCheck = "all(IsDefined(this))"
		, Descr = "De index op het WP4-domein, zodat Templates/VariantData_T/Geschiktheden/Bouwkosten er met OP/WP4_rel in kan indexeren. De join loopt op naam, dus een hernoemd of verdwenen woningtype faalt hard.";

		attribute<Float32> Normalisator_perVSSH (/Classifications/Vastgoed/VSSH) := rjoin(/Classifications/Vastgoed/VSSH/name, MixSrc/VSSH_name, MixSrc/Normalisator)
		, IntegrityCheck = "all(IsDefined(this) && this > 0f)"
		, Descr = "De normalisator op het VSSH-domein, zodat dezelfde template er met OP/VSSH_rel in kan indexeren.";
	}

	parameter<Bool> BouwlaagOpslagInBouwkosten := FALSE
	, Descr = "Laat het aantal bouwlagen van een gestapeld ontwikkelpakket meetellen in de bouwkosten, via de factoren in Classifications/Modellering/BouwlaagK (#673). Op FALSE staat er een 1 in de formule en rekent Bouwkosten/perOP alsof alleen de woningtype-as bestaat.

				Waarom deze as op een schakelaar staat en de woningtype-as niet. De woningtype-as is een verbetering: vijf onafhankelijke gemeentelijke kengetallenlijsten geven dezelfde ordening en de huidige toestand, een enkel kental voor alle vier de typen, is aantoonbaar onjuist. De bouwlagen-as is iets anders. Binnen het bereik van deze pakkettentabel, 1,00 tot 7,00 lagen, meten de bronnen geen stijging maar een vlakke tot licht dalende reeks, en dat is het omgekeerde van wat je zou verwachten. Zie de toelichting op BouwlaagK voor de getallen.

				Wat de schakelaar doet als hij aangaat. Alleen de meergezinspakketten veranderen, en alleen die met minder dan 3,5 lagen: die worden 2,5 procent duurder. Zet dat naast wat er nodig zou zijn om de pakketkeuze te kantelen: er is 67 tot 76 procent opslag op de bouwkosten van appartementen nodig voordat de rangorde binnen een subsector ergens omklapt. Deze as is dus gebouwd om het kostenbeeld compleet te maken en om te blijven kloppen als er ooit pakketten boven de vijftien lagen bij komen, niet om de dichtheidsrangschikking te breken.

				Geen dubbeltelling met de vormfactor. VormfactorHoogbouw van 0,65 maakt hoogbouw al ongunstiger, maar dat werkt op het bvo per woning en dus op de dichtheid, en niet op de prijs per m2 bvo. Het sterk oplopende deel van de literatuur is per m2 gebruiksoppervlak en zit juist in die vormfactor; de reeks per m2 bvo hier is een andere grootheid en telt er niet bovenop.";

	parameter<Bool> BouwwijzeOpslagInBouwkosten := FALSE
	, Descr = "Laat de bouwwijze meetellen in de bouwkosten, via de factoren in Classifications/Modellering/BouwwijzeK/Kostenopslag. Sinds #723 is dat de kostenopslag van de bouwwijze die per cel gekozen wordt uit wat het pakket toelaat, niet langer een vast kenmerk van het pakket. Op FALSE staat er geen factor in de formule en rekent Bouwkosten/perOP exact zoals voor #505.
				Zet hem pas op TRUE als de kentallen per bouwwijze bekend zijn, en kijk dan tegelijk naar de dummy AndersBouwen in BaseData/Suitabilities/Grondproductiekosten: die beprijst met een opslag op BouwWoonrijp en op PlanProces hetzelfde anders bouwen, en beide posten komen samen in hetzelfde exploitatiesaldo. Zie #505 en #662.";
	
	container Verwervingskosten
	: Descr = "De verwervingskosten van het bestaande vastgoed op een locatie. Voor woningen komt de waarde uit de hedonische prijsanalyse per woningtype. Voor niet-woningen is dat lastiger, onder andere vanwege de heterogeniteit van commercieel vastgoed; die kant loopt over de WOZ-waarde per vierkante meter uit de brondata, met het kental hieronder als terugval. Tot #674 stond er alleen een kental van 10.000 euro per m2 op prijspeil 2017, geindexeerd naar 12.900.
				Waarom er verhoudingen overheen gaan. De WOZ-brondata die het model leest gaat alleen over woningen: de drie csv-bestanden onder Vastgoed/WOZ tellen landelijk 7,84 miljoen objecten, gelijk aan de woningvoorraad, en hun bodemgebruiksgroep zegt waar een woning staat en niet wat voor object het is. Een woning op een bedrijfsterrein in Amsterdam staat er op 3.937 euro per m2, wat de Amsterdamse woningprijs is en niet die van een bedrijfspand.
				Waarom het er twee zijn en niet een. De voor de hand liggende bron voor een enkele verhouding is pbl-woz-per-m2.xls, de CBS-maatwerklevering uit 2016 die woningen en niet-woningen apart geeft: mediaan 0,62 over de 3.440 buurten met beide waarden, identiek in 2012 en 2015. Die 0,62 is hier NIET bruikbaar, want de bron middelt per OBJECT terwijl de prijs met OPPERVLAK wordt vermenigvuldigd. Bij woningen maakt dat weinig uit, want die lijken qua maat op elkaar. Bij niet-woningen wel: 1,18 miljoen objecten van gemiddeld 468 m2, met een staart van hallen die het meeste oppervlak dragen tegen een lage prijs per m2. Een enkel kental beprijst zo'n hal als een winkel, en juist die grote panden bepalen of een cel voor transformatie afvalt.
				Daarom staat de prijs per cel op de samenstelling van het vloeroppervlak in die cel: het aandeel hal maal de hal-verhouding plus de rest maal de overige verhouding. De ruimtelijke component kan dat niet opvangen, want de woningprijs bij hallen (3.223 euro per m2) en bij overige utiliteit (3.311) verschilt landelijk maar 2,7 procent.
				DIT ZIJN AANNAMES die bevestiging vragen. De twee prijsniveaus, circa 600 euro per m2 voor hallen en circa 1.400 voor de rest op prijspeil 2023, zijn marktkennis en geen bron uit deze repo; er is geen bestand in de repo waaruit een naar oppervlak gewogen WOZ-prijs voor niet-woningen af te leiden valt. Zet beide verhoudingen op dezelfde waarde om de differentiatie naar samenstelling uit te zetten, en op 1f om de woningprijs onverkort te nemen."
	{
		parameter<Float32> NietWoningen_WOZVerhouding_Hal := 0.186f
		, Descr = "Waarmee de WOZ-woningprijs per vierkante meter wordt vermenigvuldigd voor het deel van het niet-woonvloeroppervlak dat hal is: industrie, logistiek en utiliteit-combi. Landelijk is dat 62,0 procent van de 550 miljoen m2, gemeten in het model. De uitkomst is circa 600 euro per m2 op prijspeil 2023, want de woningprijs gewogen met het hal-oppervlak is 3.223.";

		parameter<Float32> NietWoningen_WOZVerhouding_Overig := 0.423f
		, Descr = "Idem voor de overige utiliteit: kantoor, winkel, bijeenkomst, cel, gezondheidszorg, onderwijs, overige gebruiksfunctie, sport en logies. De uitkomst is circa 1.400 euro per m2 op prijspeil 2023, want de woningprijs gewogen met dat oppervlak is 3.311.";

		parameter<Float32> NietWoningen_FractieHal_Default := 0.62f
		, Descr = "Terugval voor de fractie hal in een cel waar geen enkele utiliteitsklasse oppervlak heeft. Landelijk aandeel, gemeten. Komt in de praktijk niet voor: van de cellen met niet-woonvastgoed heeft er nul geen utiliteitsoppervlak.";
		parameter<Eur_m2> NietWoningen_2017 := 700[Eur_m2]
		, Descr = "Landelijk kental voor de verwervingsprijs van een vierkante meter niet-woonvloeroppervlak, prijspeil 2017. Geijkt op de WOZ-kant die het terugvalt: die geeft, gewogen met het niet-woon vloeroppervlak per cel en na toepassing van de twee verhoudingen hierboven, landelijk circa 900 euro per m2 op prijspeil 2023, en 700 maal de bouwkostenindex 1,29 komt daarop uit. Het kental is bewust een landelijk gemiddelde en niet naar samenstelling gedifferentieerd: het geldt alleen voor de 2,4 procent van de cellen waar de WOZ-brondata niets geeft. Tot #674 stond hier 10.000 euro per m2, geindexeerd 12.900. Dat bedrag was geen prijs maar een verbod: bij een dichtheid van 28 woningen per hectare is circa 45 m2 niet-woonvloeroppervlak al genoeg om het exploitatiesaldo negatief te maken, en 97 procent van de cellen met niet-woonvastgoed zat daarboven. Binnenstedelijke transformatie van werklocaties naar wonen viel daarmee weg. Zet dit terug op 10000 en de twee verhoudingen hierboven op 1f om dat oude prijsniveau te benaderen; de oppervlaktekant is dan nog steeds anders, zie opp_per_grid in BaseData/Suitabilities/Verwervingskosten.";

		parameter<Eur_m2> NietWoningen := ='NietWoningen_2017 * PrijsIndex_Bouwkosten_2017_naar_'+string(ModelParameters/Model_StartYear)
		, Descr = "Het kental op het prijspeil van Model_StartYear. De bouwkostenindex is hier een benadering: een verwervingsprijs is een marktwaarde en volgt niet noodzakelijk de bouwkosten. De WOZ-kant heeft zijn eigen indexering via Groeifactor_CommercieelVastgoed.";
	}
	
	parameter<meter>               Hoogbouwgrens                := 15[meter], Descr = "De hoogte van een woongebouw vanaf waar we het hoogbouw noemen. Bron: expert judgement PBL"; 
	parameter<meter>               Bouwlaaghoogte               := 2.6[meter], Descr = "Aanname voor de hoogte van een bouwlaag. Onder andere nodig om bij benadering het aantal verdiepingen per gebouw te kunnen schatten. Bron: expert judgement PBL";
	parameter<Woonoppervlak_m2BVO> VormfactorEengezins          := 0.76[Woonoppervlak_m2BVO], Descr = "De vormfactor is de verhouding tussen het verhuurbare vloeroppervlak (woonoppervlak in het geval van wonen) van een gebouw en het totale (bruto) vloeroppervlak.";
	parameter<Woonoppervlak_m2BVO> VormfactorMeergezins         := 0.78[Woonoppervlak_m2BVO], Descr = "De vormfactor is de verhouding tussen het verhuurbare vloeroppervlak (woonoppervlak in het geval van wonen) van een gebouw en het totale (bruto) vloeroppervlak.";
	parameter<Woonoppervlak_m2BVO> VormfactorHoogbouw           := 0.65[Woonoppervlak_m2BVO], Descr = "De vormfactor is de verhouding tussen het verhuurbare vloeroppervlak (woonoppervlak in het geval van wonen) van een gebouw en het totale (bruto) vloeroppervlak. Kersten Nabielek (PBL) gaat uit van 0.5. Obv expert judgement PBL gaan er tussenin zitten."; 
	parameter<Float32>             DefaultFractieUitgeefbaar    := 0.5f, Descr = "Aandeel van een NettoBuurt dat uitgeefbaar is (= gebouwFootprint plus evt niet gemeentelijke buitenruimte (tuinen etc.)). Bron: expert judgement PBL.";
	parameter<Float32>             FractieUitgeefbaarTinyHouses := 0.25f, Descr = "Aandeel van een NettoBuurt dat uitgeefbaar is (= gebouwFootprint plus evt niet gemeentelijke buitenruimte (tuinen etc.)). Bron: expert judgement PBL.";
	parameter<Float32>             DefaultVerharding            := 0.10f, Descr = "Het uitgeefbare deel van een gridcel dat (dus) niet in beslag wordt genomen door gebouwen en dat gebruikt wordt voor verharde wegen, paden, parkeerplaatsen. Voor gebruik op 100x100m resolutie. Bron: expert judgement PBL in overleg met WUR";

	container DefaultFractiesGrasBoomStruikInGroen
	: Descr = "Fractie van het groen in een gridcel dat wordt gebruikt door diverse subTypen groen. Voor gebruik op 100x100m resolutie. Bron: expert judgement PBL in overleg met WUR"
	{
		parameter<Float32> Gras   := 0.4f;
		parameter<Float32> Boom   := 0.4f;
		parameter<Float32> Struik := 0.2f;
	}
	
	parameter<cm>    MaxBodemdaling                := 40[cm], Descr = "Maximale bodemdaling op slappe/zetytingsgevoelige gronden waarop beheerskosten voor infra 'acceptabel' worden voorondersteld. Bron: expert judgement PBL i.o.m Deltares";
	
	container BAG_woonpand_Typering
	: Descr = "Technische instellingen om de woonpand typering on the fly te kunnen berekenen met de beste performance. Zie afweging in de URL"
	, URL   = "https://github.com/ObjectVision/GeoDMS/issues/816#issuecomment-2426041271"
	{
		parameter<UInt32>  nr_x_tiles         :=  50, Descr = ""; //oude setting 7   
		parameter<UInt32>  nr_y_tiles         :=  50, Descr = ""; //oude setting 13
		parameter<Float64> inflate_size       := 0.2d, Descr = "Inflate van panden in meters om overlap te detecteren (e.g. bepaling rijtjeswoningen)"; 
	}
	
	unit<uint8> MilieuCat := cat_range(1b, 7b)
	, Descr = "Per milieu categorie, zoals bekend voor bedrijventerreinen (e.g. IBIS), wat is de restrictie buffer daaromheen voor wonen. Afstanden volgen de grootste VNG-richtafstand per hoofdcategorie (VNG, Bedrijven en milieuzonering, editie 2009); cat 1 (richtafstand 10 m, kleiner dan een gridcel) krijgt 0 zodat cat-1-terreinen wonen niet blokkeren."
	, URL = "https://vng.nl/publicaties/bedrijven-en-milieuzonering"
	{
		attribute<string> Name              := 'Cat'+string(MaxMilieuCat);
		attribute<uint8>  MaxMilieuCat      := id(.);
		attribute<meter>  Buffer_wonen      :=
			switch(
				 case(MaxMilieuCat == v/Cat1, 0[meter])
				,case(MaxMilieuCat == v/Cat2, 30[meter])
				,case(MaxMilieuCat == v/Cat3, 100[meter])
				,case(MaxMilieuCat == v/Cat4, 300[meter])
				,case(MaxMilieuCat == v/Cat5, 1000[meter])
				,case(MaxMilieuCat == v/Cat6, 1500[meter])
				,0[meter]
			);
		
		parameter<meter>  Buffer_rond_Nijverheid := ='Buffer_wonen[v/'+Werken/MilieuCatDist_restrictief_anderesectoren_Nijverheid+']';
		parameter<meter>  Buffer_rond_Logistiek  := ='Buffer_wonen[v/'+Werken/MilieuCatDist_restrictief_anderesectoren_Logistiek+']';

		parameter<meter>  Buffer_omgekeerd_Nijverheid := ='Buffer_wonen[v/'+Werken/OmgekeerdeMilieuzonering/MilieuCatDist_Nijverheid+']', Descr = "Afstand die nieuwe nijverheid zelf tot aaneengesloten woongebied aanhoudt (#669). Staat los van Buffer_rond_Nijverheid, zodat de VNG-nuances voor gemengd gebied en voor de milieucategorie per activiteit alleen in de omgekeerde richting gezet kunnen worden.";
		parameter<meter>  Buffer_omgekeerd_Logistiek  := ='Buffer_wonen[v/'+Werken/OmgekeerdeMilieuzonering/MilieuCatDist_Logistiek+']', Descr = "Idem voor logistiek.";
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	parameter<float32> FractieBoomInGroenInTarraBuurt   := 0.20f, Descr = "Grove aanname binenn dit poject. Needs work";
	parameter<float32> FractieStruikInGroenInTarraBuurt := 0.20f, Descr = "Grove aanname binenn dit poject. Needs work";
	parameter<float32> FractieGrasInGroenInTarraBuurt   := 0.60f, Descr = "Grove aanname binenn dit poject. Needs work";
	
	parameter<Eur_pand> Funderingsschade_P95 := 97200[Eur_pand], Descr = "Verouderd (#408): de cap gebeurt nu per woning via SourceData/Vastgoed/Funderingsschade/Kentallen/P99_perWoning (k_i <= s_i * P99_perWoning), met herverdeling van het surplus binnen de buurt. Deze per-pand-waarde kapte grote appartementenpanden structureel af (23% verlies).";

	// ===== MORTALITEIT DOOR GROENVERANDERING (#484) =====
	// De indicator rekent een verandering van de groenindex om in een verandering van het aantal sterfgevallen.
	// Daarvoor is nodig hoeveel bewoners er in een cel wonen en hoe groot hun kans op overlijden is. Beide komen
	// uit de CBS Kerncijfers wijken en buurten, dus staan hier alleen nog de keuzes die niet uit die data volgen:
	// welk jaar, hoe sterk kleine buurten naar hun wijk krimpen, en waarbinnen de huishoudensgrootte wordt
	// begrensd. De effectmaat zelf staat in Templates/Indicatoren.dms, want die komt uit het RIVM-onderzoek.
	parameter<String>         KWB_Jaar                     := '2024', Descr = "Welk jaar van de CBS Kerncijfers wijken en buurten moet worden gebruikt. Het bestand Data/CBS_KWB/CBS_KWB_<jaar>_bevolking_sterfte.csv moet bestaan en de CBS-gebiedsindeling van hetzelfde jaar moet in RegioIndelingen/CBS zitten.";
	parameter<Persoon>        Sterfte_KrimpGewicht         := 500[Persoon], Descr = "Hoe zwaar het cijfer van de bovenliggende regio meetelt in de sterftekans van een buurt, uitgedrukt in inwoners. Zonder krimp levert een buurt van 70 inwoners met een verzorgingshuis een sterftekans van 40% per jaar op. Op nul krijgt elke buurt zijn eigen ongecorrigeerde cijfer; heel hoog krijgt elke buurt het landelijke cijfer.";
	parameter<Persoon_Woning> PersonenPerWoning_Ondergrens := 1.0[Persoon_Woning], Descr = "Ondergrens waarbinnen de uit CBS en modelvoorraad afgeleide huishoudensgrootte wordt begrensd.";
	parameter<Persoon_Woning> PersonenPerWoning_Bovengrens := 4.0[Persoon_Woning], Descr = "Bovengrens waarbinnen de uit CBS en modelvoorraad afgeleide huishoudensgrootte wordt begrensd. Buurten waar het model weinig woningen kent maar het CBS veel inwoners telt, lopen anders sterk op. Onder- en bovengrens gelijk zetten geeft overal diezelfde huishoudensgrootte.";

	parameter<String>         NDVI_basisjaar_ref          := 'mid', Descr = "Welke rand van de NDVI-bandbreedte per landgebruiksklasse het basisjaar gebruikt: min, mid of max.";
}