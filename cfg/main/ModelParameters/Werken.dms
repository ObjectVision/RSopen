container Werken
{
	parameter<Bool>            Use_AltLISA                   := FALSE, Descr = "De LISA dataset is niet publiek beschikbaar, heb je hiertoe geen toegang kun je een benadering van deze set gebruiken. Zet deze dan op TRUE";
	parameter<String>          AltLISA_potential_Variant     := 'Pot0m', Descr = "Afkapstraal in de potentiaalfunctie die wordt gebruikt bij de desaggregatie van gemeentelijke LISA Data (banen per sector) naar gridcellen";
	parameter<String>          AltLISA_cluster_Variant       := 'AdminDomain', Descr = "Ruimtelijke aggregatie waarnaar LISA Data worden gedesaggregeerd";
	parameter<String>          PandFootprint_per_job_calc_yr := 'y'+string(LISA_StartYear), Descr = "Laat dit matchen aan het LISA jaar, kan iig niet later liggen dan het meest recente lisa jaar.";
	parameter<String>          Type_m2perBaan                := 'Smoothed', Descr = "PandFootprint per baan berekeken per regio of 'gesmooth'/uitgesmeerd per gridcel, o.b.v. potentiaalfunctie. De Smoothed optie geeft minder scherpe overgangen tussen regiogrenzen. Opties: 'Smoothed' 'PerRegio'"; 
	parameter<m2PandFootprint> PandFootprint_Ondergrens      := 1000[m2PandFootprint], Descr = "Om de PandFootprint per baan te berekeken is een Ondergrens nodig om afwijkende waarden weg te filteren.";
	parameter<Job>             Job_Ondergrens                := 10[Job], Descr = "Om de PandFootprint per baan te berekeken is een Ondergrens nodig om afwijkende waarden weg te filteren.";
	parameter<Float32>         Grondproductie_significatie_threshold := 0.11f, Descr = "Drempelwaarde voor de p-waarde waaronder een coëfficiënt in grondproductiekostenbepaling als significant wordt beschouwd. Indien de signifantie van een variabele in de OLS regressie lager is dan deze drempel, wordt de grondproductie component van die variabele op 0 gezet.";
	parameter<Float64>         BedrijfsterreinUitgegevenFractieAlsVolBeschouwen    := 0.8d, Descr = "Vanaf deze uitgegeven fractie telt een IBIS-werklocatie als vol en sluit de zeef het hele terrein uit voor alle werksubsectoren (ook binnen harde plancapaciteit). Binaire drempel per terrein: onder de drempel geldt geen enkele capaciteitsrem, erboven is ook het nog uitgeefbare deel dicht. Expert-keuze, niet gekalibreerd; het oudere 50-procent-criterium staat ongebruikt in IBIS.dms (Nog50Uitgeefbaar).";
	parameter<Bool>            GeschiktheidDynamisch         := TRUE, Descr = "Werken-geschiktheid per zichtjaar bijwerken met het landgebruik dat het model in eerdere zichtjaren heeft gealloceerd (#647, analoog aan #637 voor wonen). De aandelen wonen, natuur en water in de cel en het buurtaandeel overig bebouwd (1000 m) worden herberekend uit de beginstand van elk zichtjaar, zodat onder meer nieuw werken clustering opwekt; bouwterrein en de UAI blijven statisch (geen modelbron). FALSE geeft de statische kaart van voor deze wijziging.";
	parameter<Bool>            GeschiktheidAlsRaw            := TRUE, Descr = "Het raw-nut in plaats van de MNL-kans als allocatie-input per werksubsector. Binnen een subsector telt alleen de rangorde, en de kansdeling (noemer over alle sectoren, per cel verschillend) drukt cellen die voor meerdere sectoren aantrekkelijk zijn ten onrechte omlaag; de sectorconcurrentie wordt al apart beslist in de subsectorkeuze. Nodata blijft uitgesloten via raw_ordinaal (null, #599). FALSE geeft het oude gedrag (kans als input).";
	parameter<Bool>            TredePrioriteitInSubsectorKeuze := TRUE, Descr = "Wanneer meerdere werksubsectoren dezelfde cel boven hun zaaglijn hebben, eerst vergelijken op plancapaciteit- en stimuliprioriteit (KanOp-gefilterd: 3 hard, 2 zacht, 1 stimuli, 0 anders) en pas daarbinnen op de kans. Zonder deze schakelaar wint de hoogste kans ongeacht tredes, waardoor een subsector zonder plannen een cel kon afpakken van een subsector met harde plannen daar. De tredescores zelf zijn tussen subsectoren niet vergelijkbaar (verschillend aantal treden), vandaar deze uniforme prioriteit.";
	parameter<string>          MilieuCatDist_restrictief_anderesectoren_Nijverheid := 'Cat4', Descr = "Welke bufferafstand (categorie uit de VNG-tabel in ModelParameters/Wonen/MilieuCat) geldt rond nieuw gealloceerde nijverheid voor milieugevoelige sectoren (wonen, diensten, detailhandel, verblijfsrecreatie). Aanname: nieuw gemengd industrieterrein gemiddeld categorie 4 (300 m). Was Cat2; nijverheid omvat doorgaans de hogere categorieen, dus een grotere buffer dan logistiek.";
	parameter<string>          MilieuCatDist_restrictief_anderesectoren_Logistiek  := 'Cat3', Descr = "Welke bufferafstand (categorie uit de VNG-tabel in ModelParameters/Wonen/MilieuCat) geldt rond nieuw gealloceerde logistiek voor milieugevoelige sectoren. Aanname: distributiecentra vallen doorgaans in categorie 3 (100 m).";

	container OmgekeerdeMilieuzonering
	: Descr = "Instellingen voor de omgekeerde milieuzonering: nieuwe nijverheid en logistiek houden zelf afstand tot wonen. De heenrichting, waarin wonen en de andere milieugevoelige functies afstand houden tot nieuw gealloceerd vervuilend werk, staat hier los van en wordt geregeld met MilieuCatDist_restrictief_anderesectoren_*. Zie ObjectVision/RSopen#669."
	{
		parameter<String>  MilieuCatDist_Nijverheid  := MilieuCatDist_restrictief_anderesectoren_Nijverheid, Descr = "Bufferafstand die nieuwe nijverheid zelf tot wonen aanhoudt, als categorie uit de VNG-tabel in ModelParameters/Wonen/MilieuCat. Staat standaard gelijk aan de heenrichting, dus Cat4 oftewel 300 meter. Dit is de knop voor twee VNG-nuances die het model niet zelf kent: in gemengd gebied mag een stap terug worden gedaan, wat voor een cat-4-activiteit op 200 meter uitkomt, en de richtafstanden gelden per activiteit en niet per sector, terwijl het grootste deel van de SBI-codes onder nijverheid in categorie 2 of 3 valt. De keuze ligt bij PBL.";
		parameter<String>  MilieuCatDist_Logistiek   := MilieuCatDist_restrictief_anderesectoren_Logistiek, Descr = "Idem voor logistiek, standaard gelijk aan de heenrichting, dus Cat3 oftewel 100 meter.";
		
		parameter<Bool>    AlleenRondWoongebied      := TRUE, Descr = "Leg de buffer rond aaneengesloten woongebied in plaats van rond elke cel met minstens een woning. Zonder deze schakelaar telt een enkele woning in het buitengebied even zwaar als een woonwijk, waardoor de buffer van 300 meter meer dan de helft van het studiegebied beslaat en nieuwe nijverheid vrijwel nergens meer kan landen. FALSE geeft het gedrag van voor #669.";
		parameter<meter>   WoongebiedStraal          := 100[meter], Descr = "Straal waarbinnen het aandeel wooncellen bepaalt of een wooncel tot aaneengesloten woongebied hoort.";
		parameter<Float32> WoongebiedAandeel         := 0.2f, Descr = "Vanaf dit aandeel wooncellen binnen WoongebiedStraal telt een wooncel als aaneengesloten woongebied. Cellen buiten het studiegebied tellen niet mee in de noemer, zodat een woonwijk aan de kust of aan de landsgrens niet onterecht afvalt. Expert-keuze, niet gekalibreerd; de afruil is gemeten op de stand in het basisjaar met CompactedAdminDomain als noemer. Zonder drempel ligt 65,1 procent van het studiegebied binnen de 300 meter-buffer van nijverheid; bij 0,1 is dat 47,4 procent en valt 1,8 procent van de woningvoorraad buiten het woongebied, bij 0,2 respectievelijk 30,9 en 4,2 procent, bij 0,3 respectievelijk 23,6 en 7,5 procent. Zie ObjectVision/RSopen#669.";
		
		parameter<Bool>    NietOpBestaandWerkterrein := TRUE, Descr = "Laat de toets vervallen op bestaand bedrijventerrein, zodat verdichting en herstructurering van een bestaand terrein mogelijk blijven. Sluit aan bij de VNG-richtafstanden, die niet gelden tegen bestaande vergunde bedrijvigheid. Bron: de IBIS-werklocaties van het type bedrijventerrein, zeehaventerrein, platformgebonden bedrijvigheid en agribusinesscomplex. Brengt bij WoongebiedAandeel 0,2 het gesloten deel van het studiegebied voor nijverheid van 30,9 naar 29,1 procent, en het geblokkeerde deel van de harde plancapaciteit industrieterrein van 20,0 naar 3,5 procent.";
		parameter<Bool>    BestaandeBanenTellenMee   := TRUE, Descr = "Reken naast de IBIS-terreinen ook een cel die zelf al banen in de betreffende subsector heeft tot bestaand werkterrein. IBIS registreert alleen terreinen vanaf een hectare, dus zonder deze schakelaar valt bestaande nijverheid of logistiek buiten een formeel terrein alsnog onder de toets.";
	}

	container Groeifactor_CommercieelVastgoed 
	: Descr = "Groeifactor om 2017 WOZ prijzen naar 2023 niveau te halen. Bron eigen bewerking van kwartaalcijfers met 2015 als basisjaar, naar jaarcijfers met 2017 als basisjaar. Cijferbron: https://www.cbs.nl/nl-nl/maatwerk/2023/33/prijsindices-commercieel-Vastgoed, bewerkingsbron: %SourceDataDir%/Vastgoed/PRijstrends_commercieelVastgoed.xlsx"
	, URL = "https://www.cbs.nl/-/media/_excel/2023/33/prijsindex-commercieel-Vastgoed-200801202302.xlsx"
	{
		parameter<Float32> Kantoor   := 1.45f;
		parameter<Float32> industrie := 1.56f;
		parameter<Float32> winkel    := 1.15f;
	}
	
	parameter<m2BVO_job>        m2BVO_job_Kantoor_PreCORONA := 20[m2BVO_job], Descr = "De zgn. Kantoorcoefficioent voor corona (2020). Bron: Buitelaar et al., 2021 (https://www.pbl.nl/publicaties/thuiswerken-en-de-gevolgen-voor-wonen-werken-en-mobiliteit). Documentatiewaarde: de groeifactor rekent sinds #668 tegen m2BVO_job_Kantoor_Basisjaar en niet meer tegen dit jaartal.";
	parameter<m2BVO_job>        m2BVO_job_Kantoor_Basisjaar := 20[m2BVO_job], Descr = "De kantoorcoefficient zoals die geldt in het basisjaar van het model, dus in LISA_StartYear. Dit is de noemer van m2BVO_job_Kantoor_groeifactor.

																										De pandvoetafdruk per baan waar die groeifactor op aangrijpt is een waarneming uit LISA_StartYear (PandFootprint_per_job_calc_yr). Wat er in dat jaar aan bureaudeling
																										al was gerealiseerd, zit dus al in de waarneming. Rekent de groeifactor tegen de pre-coronawaarde, dan telt dat deel twee keer (#668). Alleen het verschil tussen
																										het doel (VariantK/m2BVO_job_Kantoor) en de stand in het basisjaar hoort het model nog door te voeren.

																										Staat voorlopig gelijk aan de pre-coronawaarde, want er is nog geen waarneming voor 2023 vastgesteld; daarmee is het gedrag hetzelfde als voorheen en is de keuze
																										expliciet in plaats van impliciet. Verlaag deze waarde zodra de waargenomen coefficient voor het basisjaar bekend is."
																										, IntegrityCheck = "m2BVO_job_Kantoor_Basisjaar > 0[m2BVO_job]";
	parameter<Bool>             Thuiswerk_verdikking_ook_op_bestaandekantoren := FALSE, Descr = "Verhoogt in het eerste zichtjaar het aantal kantoorbanen in elke bestaande cel met de kantoorgroeifactor, zonder de pandvoetafdruk van die cellen mee te veranderen.
																																						Staat sinds #668 uit. Het aantal banen is exogeen en is de claimvariabele: bureaudeling hoort te bepalen hoeveel ruimte dezelfde banen vragen, niet hoeveel banen er zijn.
																																						De ophoging ging rechtstreeks van de restclaim af en gaf overrealisatie voordat de allocatie begon. Gemeten in het eerste zichtjaar van de productieopzet stond zakelijke
																																		dienstverlening met de schakelaar aan op 2.437.320 banen tegen een claim van 2.018.666, en had geen van de 76 NVM-regio's nog een positieve restclaim; uit staat de stand
																																		op 2.132.655 en hebben twaalf regio's er wel een. De volledige meting staat in #668.
																																						De bedoelde werking loopt sinds #590 al langs de dichtheid: m2BVO_job_Kantoor_groeifactor verlaagt de pandvoetafdruk per kantoorbaan (PandFootprint_perJob) en verhoogt
																																						spiegelbeeldig het aantal banen per m2 (Job_Perm2PandFootprint). Elke cel die het model voor kantoren kiest, bestaand of nieuw, houdt daardoor meer banen op dezelfde
																																						voetafdruk, en dezelfde claim vraagt dus minder nieuwe kantoorruimte. Diezelfde dichtheid staat ook in de zeefdrempel (Zeef_T/TeKleineDichtheidsToenameSubsector, via
																																						PotentieleState), zodat verdikking van bestaande kantoorcellen daar eerder de minimumtoename haalt.
																																						TRUE geeft het gedrag van voor #668 terug.";
	parameter<Bool>             KantoorVerdikkingInBestaand := TRUE, Descr = "Laat de bureaudeling landen in bestaande kantoorcellen (#668). Drie ingrepen op cellen waar kantoor de werkstand domineert (KantoorDominantieDrempel): de potentiele kantoordichtheid krijgt een vloer van de eigen werkstand maal de verdikkingsfactor (DichtheidZichtjaar_T), die cellen krijgen trede-voorrang boven greenfield (Tredes/Werken en IterSubsector_T), en de sloopleeftijd- en IBIS-vol-toetsen vervallen er voor deze subsector (Zeef_T), want toewijzing is daar verdikking en geen sloop-nieuwbouw. Aanleiding, gemeten voor de reparatie: het potentieel is het omgevingsgemiddelde en geen pandcapaciteit, waardoor 40 procent van de kantoorbanen in cellen stond met een potentieel onder de eigen stand, terwijl 52 procent van de nieuw toegewezen kantoorcellen op greenfield landde. FALSE geeft het gedrag van voor deze ingreep.";
	parameter<Float32>          KantoorDominantieDrempel := 0.90f, Descr = "Vanaf dit aandeel kantoorbanen in de werkstand van een 100m-cel telt de cel als dominante kantoorcel voor KantoorVerdikkingInBestaand. Gemeten op de torencellen (potentieel onder de eigen stand): drempel 0,90 dekt 550.131 van de 838.909 torenbanen, drempel 0,95 dekt er 476.740. Onder de 0,90 wordt de vloer onzuiver: die rekent de hele werkstand van de cel tot kantoorcapaciteit, en dat is bij lagere dominantie een te grove toerekening. Merk op dat een vloer op alleen de kantoorstand pas boven aandeel 0,9624 door de dichtheidsdrempel van 10 procent zou komen (1,1429 maal aandeel groter dan 1,10); daarom rekent de vloer met de totale werkstand.";
	parameter<Bool>             VerzorgendVolgtWoongebied := TRUE, Descr = "Voorrangstrede voor de verzorgende werksubsectoren (detailhandel, overige consumentendiensten, overheid en kwartaire diensten): cellen binnen bestaand bebouwd gebied of binnen de woongebiedschijf gaan boven alles daarbuiten, zodat de zaaglijn eerst de kom en de wijkranden eet en kaal buitengebied alleen als overloop dient. Aanleiding: in de meting van 2026-08-28 zette detailhandel 95 procent van zijn nieuwe banen op cellen zonder enige werkgelegenheid en lag 60 procent van de gekozen greenfieldcellen niet binnen 250 meter van bestaand of nieuw woongebied, terwijl de geschiktheid van deze subsectoren juist naar woongebied trekt (positieve lu_share_residential-coefficienten); binnen de kom was maar 1 op 95 van het beschikbare areaal te vinden en kwam bestaand werkgebied voor ruim 98 procent niet door de dichtheidsdrempel. Bewust een trede en geen zeef: de claim blijft altijd realiseerbaar. De schijf staat per zichtjaar vast voor de allocatie begint, dus voorzieningen volgen een nieuwe wijk met een zichtjaar vertraging. FALSE geeft de tredetabel van Overigen terug.";
	parameter<Bool>             VerzorgendBlijftBijWoningbouw := TRUE, Descr = "Blijft de verzorgende werkgelegenheid staan waar wonen de cel overneemt? De allocatie is celexclusief: Allocatie_T/Impl/Verdring_Expr zet de stand van elke werksubsector op nul zodra wonen de cel wint. Elke woningbouwlocatie sloopt daarmee de buurtvoorzieningen die er stonden, dat groeit rechtstreeks door in de restclaim van juist detailhandel, overige consumentendiensten en overheid en kwartaire diensten, en die claim kan vervolgens alleen nog naar greenfield. Dat is de motor onder #710.

																																						Het basisjaar zit vol cellen met woningen en banen tegelijk, dus de menging is prima representeerbaar; alleen het moment van herallocatie vernietigde haar. Met deze schakelaar aan wordt de hoofdfunctie van de cel wonen terwijl de verzorgende banen eronder blijven staan, inclusief hun pandvoetafdruk. Niet-verzorgend werken wordt wel gesloopt: een fabriek verdwijnt wel als er een wijk komt. Andere sectoren die de cel overnemen, zoals waterberging of natuur, slopen ook gewoon door; daar verandert het landgebruik echt.

																																						Staat sinds 29 augustus 2026 aan. Gemeten in Y2040 van WLO_hoog BAU, na het volledige wonenblok: met de schakelaar uit sloopte wonen 135.924 verzorgende banen in dat ene zichtjaar, wat de restclaim van de drie subsectoren met 22,6 procent ophoogde. FALSE geeft het gedrag van voor #710 terug. Welke subsectoren verzorgend zijn staat in Classifications/Actor/Jobs6/IsVerzorgend.";
	parameter<Bool>             VerzorgendInWoonOP := TRUE, Descr = "Brengt een woonontwikkelpakket zelf een beetje verzorgende werkgelegenheid mee? In elke woonwijk zit een supermarkt en een school, maar in de celexclusieve allocatie moeten die banen als zelfstandige sector om grond concurreren, en dan belanden ze op kaal buitengebied (#710). Staat deze schakelaar aan, dan krijgt een cel die wonen wint een verzorgende stand ter hoogte van de woningdichtheid van het ontwikkelpakket maal de waargenomen verhouding banen per woning uit BaseData/StartState/VerzorgendBijWonen, als ondergrens naast wat er al stond.

																																						Dat verlaagt de restclaim van deze drie subsectoren, en dat is precies de bedoeling: de banen zijn dan al gerealiseerd bij de woningen en hoeven niet meer apart te landen. Wonen wordt voor werken gealloceerd, dus de werkenblokken zien de opgehoogde stand en trekken hem vanzelf van hun claim af.

																																						Let op het gevaar dat bij #668 al een keer toesloeg: banen zijn exogeen en zijn de claimvariabele, dus als deze regel landelijk meer banen oplevert dan de claim groeit, ontstaat overrealisatie voordat de allocatie begint. De verhouding is daarom waargenomen en niet verzonnen, en VerzorgendInWoonOP_Factor is de knop om hem te temperen. Zet deze schakelaar niet aan zonder de landelijke stand tegen de claim te leggen.

																																						Deze banen krijgen geen eigen pandvoetafdruk: ze zitten in de plint van het ontwikkelpakket en dus al in de gebouwvoetafdruk die het OP zelf oplegt. Anders zouden ze de verharding dubbel tellen.

																																						Die meting is gedaan, zie #710. Gemeten in Y2040 van WLO_hoog BAU brengt de pakketbezetting 22.657, 62.191 en 99.588 banen in, oftewel 37,2, 49,9 en 23,9 procent van de ruimte tot de claim. Alle drie blijven eronder, dus er is geen overrealisatie en de factor kan op 1 blijven. Staat sinds 29 augustus 2026 aan.";
	parameter<Float32>          VerzorgendInWoonOP_Factor := 1.0f, Descr = "Bijstelfactor op de waargenomen verhouding banen per woning uit BaseData/StartState/VerzorgendBijWonen. Op 1 volgt het model precies de basisjaarverhouding in bestaand woongebied. Lager zetten als de landelijke stand boven de claim uitkomt, hoger als de waarneming een ondergrens blijkt: de teller telt alleen de banen die op woongebiedcellen staan, en de wijkvoorzieningen die net op een centrum- of gemengde cel liggen vallen daarbuiten.", IntegrityCheck = "VerzorgendInWoonOP_Factor >= 0f";
	parameter<UInt32>           VerzorgendWoongebiedStraal := 250, Descr = "Straal in meters van de schijf rond bestaand woongebied die samen met het bebouwd gebied de voorrang van VerzorgendVolgtWoongebied vormt. Moet overeenkomen met een bestaande afstandsmatrix (Geography/Matrix), dus een van de daar gedefinieerde stralen.";
	
	parameter<Float32>          DefaultFractieUitgeefbaar := Wonen/DefaultFractieUitgeefbaar;

	// Groeifactor  t.a.v. m2pandFootprint_baan werken
	// Aanpassing van werkdichtheid op:
	// -bestaand werkgebied: /VariantData/Allocatie/Zichtjaren/Y2030/StateVoorAllocatie/Werken
	// -nieuw werkgebied: /VariantData/Dichtheid/Per_AllocDomain/Y2030/Src/Werken/Job_Perm2PandFootprint/Subsectoren
	container Groeifactor
	: Descr = "Aanpassing op trendmatige verandering in m2Footprint per baan. Expert judgement op basis van het rapport Ruimte voor werken (2022). NB: bewust lager dan de rapportwaarden (industrie 2 procent, logistiek 1 procent per jaar): met de toepassingsfactor 0,5 (#591) komt de effectieve verdunning op 0,5 en 0,25 procent per kalenderjaar; dat bleek in de toepassing beter te werken en spoort met de afvlakking van de trend sinds 2012."
	{
		parameter<jaarlijks> Nijverheid             := 0.010[jaarlijks];
		parameter<jaarlijks> Logistiek              := 0.005[jaarlijks];
		parameter<jaarlijks> Detailhandel           := 0.000[jaarlijks];
		parameter<jaarlijks> Ov_consumentendiensten := 0.000[jaarlijks];
		parameter<jaarlijks> Zak_dienstverlening    := 0.000[jaarlijks];
		parameter<jaarlijks> Overheid_kw_diensten   := 0.000[jaarlijks];
		
		parameter<float32>   Groeifactor_WanneerToepassen := 0.5f, Descr = "Wanneer in het zichtjaar moet het worden toegepast? 1= op zichtjaar, dus aantal jaren om toe te passen = Zichtjaar - prevZichtjaar. 0.5= halverwege tussen prev en zichtjaar.";
		parameter<YearRange> JaarVanafWaarGeenWerkdichtheidMeerAangepastWordt := 2050[YearRange], Descr = "Jaar vanaf wanneer de verdunning van banendichtheid in bestaande werkcellen (Groeifactor_XX) niet meer wordt toegepast. De verdunningsfactoren zijn 
																												gebaseerd op de empirische trend in m² ruimtebeslag per baan 1996-2019 (Koomen & Claassens, 2022), waarin de stijging sinds 2012 al sterk afvlakt. 
																												Lineaire doortrekking voorbij de waarnemingsperiode is daarmee niet onderbouwd. Bovendien komen de onderliggende mechanismen (verschuiving naar perifere 
																												logistiek, sectorshift van industrie naar diensten) deels uit eenmalige transitieprocessen die op enig moment zijn uitgewerkt. Dit parameterjaar legt vast tot
																												wanneer de verdunning realistisch geacht wordt.";
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Waarden die tot september 2026 als kaal getal in de lopende code stonden, hierheen verplaatst zonder de
	// waarde te veranderen.
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////

	parameter<Float32> Zeef_MinimumAandeelOud := 0.01f
	, Descr = "Onder welk aandeel van de bestaande werkstand in een cel die cel als praktisch leeg telt, waarna de zeef hem heropent voor werken. Alleen buiten plancapaciteit, zie Oud_weg in Templates/Beschikbaarheden/Zeef_T. Geldt uitsluitend voor de sector werken; wonen kent deze toets niet. Stond als kaal getal in de zeefexpressie.";

	container HalFractie
	: Descr = "Welk deel van het vloeroppervlak per gebruiksdoel fysiek een hal is, nodig om een distributiehal anders te beprijzen dan een winkel (#674). Gelezen in BaseData/Suitabilities/Verwervingskosten/Samenstelling, waar de zeven getallen tot september 2026 als kale factoren in een optelling van zeven termen stonden.

				De fracties zijn niet onderling vergelijkbaar met een aandeel in de stand: het gaat om de bouwkundige verschijningsvorm van het vastgoed binnen een gebruiksdoel, niet om hoeveel er van dat doel is. Logistiek is het meest hal-achtig, kantoor het minst.

				Een fractie hoort tussen 0 en 1 te liggen; elke waarde draagt daarvoor een eigen IntegrityCheck."
	{
		// De check staat inline op elke waarde en niet als aparte conclusie: een IntegrityCheck op een
		// parameter die zelf de check is geeft "Invalid Recursion in UpdateMetaInfo". Zie de skill
		// geodms-valkuilen. Zo vuurt de bewaking bovendien op de waarde die je opvraagt.
		parameter<Float32> industrie        := 0.557f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> Logistiek        := 0.662f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> utiliteit_combi  := 0.488f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> Kantoor          := 0.155f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> winkel           := 0.350f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> bijeenkomst      := 0.206f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> Gezondheidszorg  := 0.166f, IntegrityCheck = "this >= 0f && this <= 1f";
	}

}
