// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de ModelParameters: Parameters die voor elk scenario en elke Variant hetzelfde zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Werken
{
	parameter<Bool>            Use_AltLISA                                      := TRUE, Descr = "De LISA dataset is niet publiek beschikbaar, heb je hiertoe geen toegang kun je een benadering van deze set gebruiken. Zet deze dan op TRUE";
	parameter<String>          AltLISA_potential_Variant                        := 'Pot0m', Descr = "Afkapstraal in de potentiaalfunctie die wordt gebruikt bij de desaggregatie van gemeentelijke LISA Data (banen per sector) naar gridcellen";
	parameter<String>          AltLISA_cluster_Variant                          := 'AdminDomain', Descr = "Ruimtelijke aggregatie waarnaar LISA Data worden gedesaggregeerd";
	parameter<String>          PandFootprint_per_job_calc_yr                    := 'y'+string(LISA_StartYear), Descr = "Laat dit matchen aan het LISA jaar, kan iig niet later liggen dan het meest recente lisa jaar.";
	parameter<String>          Type_m2perBaan                                   := 'Smoothed', Descr = "PandFootprint per baan berekeken per regio of 'gesmooth'/uitgesmeerd per gridcel, o.b.v. potentiaalfunctie. De Smoothed optie geeft minder scherpe overgangen tussen regiogrenzen. Opties: 'Smoothed' 'PerRegio'"; 
	parameter<m2PandFootprint> PandFootprint_Ondergrens                         := 1000[m2PandFootprint], Descr = "Om de PandFootprint per baan te berekeken is een Ondergrens nodig om afwijkende waarden weg te filteren.";
	parameter<Job>             Job_Ondergrens                                   := 10[Job], Descr = "Om de PandFootprint per baan te berekeken is een Ondergrens nodig om afwijkende waarden weg te filteren.";
	parameter<Float32>         Grondproductie_significatie_threshold            := 0.11f, Descr = "Drempelwaarde voor de p-waarde waaronder een coëfficiënt in grondproductiekostenbepaling als significant wordt beschouwd. Indien de signifantie van een variabele in de OLS regressie lager is dan deze drempel, wordt de grondproductie component van die variabele op 0 gezet.";
	parameter<Float64>         BedrijfsterreinUitgegevenFractieAlsVolBeschouwen := 0.8d, Descr = "Vanaf deze uitgegeven fractie telt een IBIS-werklocatie als vol en sluit de zeef het hele terrein uit voor alle werksubsectoren, ook binnen harde plancapaciteit. Een binaire drempel per terrein: eronder geen enkele capaciteitsrem, erboven is ook het nog uitgeefbare deel dicht. Expert-keuze, niet gekalibreerd.";
	parameter<string>          MilieuCatDist_restrictief_anderesectoren_Nijverheid := 'Cat4', Descr = "Welke bufferafstand (categorie uit de VNG-tabel in ModelParameters/Wonen/MilieuCat) geldt rond nieuw gealloceerde nijverheid voor milieugevoelige sectoren (wonen, diensten, detailhandel, verblijfsrecreatie). Aanname: nieuw gemengd industrieterrein gemiddeld categorie 4 (300 m). Was Cat2; nijverheid omvat doorgaans de hogere categorieen, dus een grotere buffer dan logistiek.";
	parameter<string>          MilieuCatDist_restrictief_anderesectoren_Logistiek  := 'Cat3', Descr = "Welke bufferafstand (categorie uit de VNG-tabel in ModelParameters/Wonen/MilieuCat) geldt rond nieuw gealloceerde logistiek voor milieugevoelige sectoren. Aanname: distributiecentra vallen doorgaans in categorie 3 (100 m).";

	container OmgekeerdeMilieuzonering
	: Descr = "Instellingen voor de omgekeerde milieuzonering: nieuwe nijverheid en logistiek houden zelf afstand tot wonen. De heenrichting, waarin wonen en de andere milieugevoelige functies afstand houden tot nieuw gealloceerd vervuilend werk, staat hier los van en wordt geregeld met MilieuCatDist_restrictief_anderesectoren_*. Zie ObjectVision/RSopen#669."
	{
		parameter<String>  MilieuCatDist_Nijverheid  := MilieuCatDist_restrictief_anderesectoren_Nijverheid, Descr = "Bufferafstand die nieuwe nijverheid zelf tot wonen aanhoudt, als categorie uit de VNG-tabel in ModelParameters/Wonen/MilieuCat; standaard gelijk aan de heenrichting (Cat4, 300 meter). De
																																						knop voor twee VNG-nuances die het model niet kent: in gemengd gebied mag een stap terug, en de richtafstanden gelden per activiteit en niet per sector, terwijl de meeste SBI-codes onder
																																						nijverheid in categorie 2 of 3 vallen. De keuze ligt bij PBL.";
		parameter<String>  MilieuCatDist_Logistiek   := MilieuCatDist_restrictief_anderesectoren_Logistiek, Descr = "Idem voor logistiek, standaard gelijk aan de heenrichting, dus Cat3 oftewel 100 meter.";
		
		parameter<meter>   WoongebiedStraal          := 100[meter], Descr = "Straal waarbinnen het aandeel wooncellen bepaalt of een wooncel tot aaneengesloten woongebied hoort.";
		parameter<Float32> WoongebiedAandeel         := 0.2f, Descr = "Vanaf dit aandeel wooncellen binnen WoongebiedStraal telt een wooncel als aaneengesloten woongebied; cellen buiten het studiegebied tellen niet mee in de noemer, zodat een woonwijk aan de
																																						kust of de landsgrens niet afvalt. Expert-keuze: een hogere drempel sluit meer buitengebied voor nijverheid open maar laat meer woningen buiten het woongebied vallen (#669).";
		
	}

	container Groeifactor_CommercieelVastgoed 
	: Descr = "Groeifactor om 2017 WOZ prijzen naar 2023 niveau te halen. Bron eigen bewerking van kwartaalcijfers met 2015 als basisjaar, naar jaarcijfers met 2017 als basisjaar. Cijferbron: https://www.cbs.nl/nl-nl/maatwerk/2023/33/prijsindices-commercieel-Vastgoed, bewerkingsbron: %SourceDataDir%/Vastgoed/PRijstrends_commercieelVastgoed.xlsx"
	, URL = "https://www.cbs.nl/-/media/_excel/2023/33/prijsindex-commercieel-Vastgoed-200801202302.xlsx"
	{
		parameter<Float32> Kantoor   := 1.45f;
		parameter<Float32> industrie := 1.56f;
		parameter<Float32> winkel    := 1.15f;
	}
	
	parameter<m2BVO_job>        m2BVO_job_Kantoor_PreCORONA := 20[m2BVO_job], Descr = "De zgn. Kantoorcoefficioent voor corona (2020). Bron: Buitelaar et al., 2021 (https://www.pbl.nl/publicaties/thuiswerken-en-de-gevolgen-voor-wonen-werken-en-mobiliteit). Documentatiewaarde: de groeifactor rekent sinds #668 tegen m2BVO_job_Kantoor_Basisjaar en niet meer tegen dit jaartal.";
	parameter<m2BVO_job>        m2BVO_job_Kantoor_Basisjaar := 20[m2BVO_job], Descr = "De kantoorcoefficient in het basisjaar (LISA_StartYear), de noemer van m2BVO_job_Kantoor_groeifactor. De pandvoetafdruk per baan waarop die groeifactor aangrijpt is een waarneming uit het
				basisjaar, waar de tot dan gerealiseerde bureaudeling al in zit; alleen het verschil tussen VariantK/m2BVO_job_Kantoor en deze stand hoort het model nog door te voeren (#668). Staat
				voorlopig gelijk aan de pre-coronawaarde omdat er geen waarneming voor 2023 is vastgesteld; verlagen zodra die er is."
																										, IntegrityCheck = "m2BVO_job_Kantoor_Basisjaar > 0[m2BVO_job]";
	parameter<Float32>          KantoorDominantieDrempel := 0.90f, Descr = "Vanaf dit aandeel kantoorbanen in de werkstand van een cel telt de cel als dominante kantoorcel voor de verdikkingsingrepen van #668. Onder de 0,90 wordt de vloer onzuiver, want die rekent de
																																						hele werkstand van de cel tot kantoorcapaciteit; een vloer op alleen de kantoorstand zou pas boven aandeel 0,96 door de dichtheidsdrempel van 10 procent komen, daarom rekent de vloer met de
																																						totale werkstand.";
	parameter<Float32> VerzorgendInWoonOP_Factor  := 1.0f, Descr = "Bijstelfactor op de waargenomen verhouding banen per woning uit BaseData/StartState/VerzorgendBijWonen. Op 1 volgt het model de basisjaarverhouding in bestaand woongebied; lager als de landelijke stand boven de claim uitkomt, hoger als de waarneming een ondergrens blijkt, want de teller telt alleen banen op woongebiedcellen.", IntegrityCheck = "VerzorgendInWoonOP_Factor >= 0f";
	parameter<UInt32>  VerzorgendWoongebiedStraal := 250, Descr = "Straal in meters van de schijf rond bestaand woongebied die samen met het bebouwd gebied de voorrangstrede van de verzorgende werksubsectoren vormt (#710). Moet overeenkomen met een bestaande afstandsmatrix (Geography/Matrix), dus een van de daar gedefinieerde stralen.";

	parameter<Float32>          VerdikkingsFactor_Overheid := 1.30f, Descr = "Waarmee de werkstand van een dominante overheidscel wordt vermenigvuldigd om de potentieelvloer te krijgen. Anders dan bij kantoor is er geen coefficient om hem uit af te leiden; grondslag
				is de waargenomen verdikking van banen per hectare voorzieningenterrein uit de LISA-tijdreeks 2000 tot 2023, doorgetrokken naar 2060, waarvan dit de behoudende kant is. De vloer rekent met
				de totale werkstand van de cel, dus bij een dominantiedrempel van 0,90 is de effectieve vloer hoogstens 1,44 keer de eigen stand.", Source = "LISA-tijdreeks LISA2023_<jaar>_bas.csv gekruist met de CBS-modusrasters van het bodemgebruik (32,5 banen per ha in 2000, 43,2 in 2023)", IntegrityCheck = "VerdikkingsFactor_Overheid >= 1f";
	parameter<Float32>          VerdikkingsMinimumStand_Overheid := 10f, Descr = "Ondergrens op de werkstand van een cel voordat zij als verdikkingscel telt, in banen per cel van 25 meter. Zonder ondergrens maakt een eenmanszaak of een stichting op een huisadres die
				woning tot een dominante cel van deze subsector, want LISA registreert elke vestiging op haar inschrijfadres; bij tien banen kantelt de samenstelling naar voorzieningenterrein terwijl
				vrijwel alle capaciteit behouden blijft. Kantoor heeft een eigen, lagere ondergrens in VerdikkingsMinimumStand_Kantoor.", IntegrityCheck = "VerdikkingsMinimumStand_Overheid >= 0f";
	parameter<Float32>          VerdikkingsMinimumStand_Kantoor := 5f, Descr = "Dezelfde ondergrens voor het kantoormasker van #668, in banen per cel van 25 meter, om dezelfde reden als bij overheid: zonder ondergrens is bijna driekwart van de dominante kantoorcellen
				woonterrein met een eenmanszaak aan huis. Lager dan bij overheid omdat een kantoorvestiging kleiner is dan een instelling; de samenstelling kantelt tussen twee en drie banen en vijf is
				daarvan de behoudende kant. Het masker doet meer dan een vloer zetten: het schakelt op zijn cellen ook evident benut, de sloopleeftijd en de IBIS-vultoets uit.", IntegrityCheck = "VerdikkingsMinimumStand_Kantoor >= 0f";

	parameter<Float32>          DefaultFractieUitgeefbaar := Wonen/DefaultFractieUitgeefbaar;

	// Groeifactor  t.a.v. m2pandFootprint_baan werken
	// Aanpassing van werkdichtheid op:
	// -bestaand werkgebied: /VariantData/Allocatie/Zichtjaren/Y2030/StateVoorAllocatie/Werken
	// -nieuw werkgebied: /VariantData/Dichtheid/Per_AllocDomain/Y2030/Src/Werken/Job_Perm2PandFootprint/Subsectoren
	parameter<Bool> DienstverleningVolgtRapporttrend := TRUE, Descr = "Laat de drie dienstverlenende subsectoren de trendmatige daling in ruimtebeslag per baan volgen die Ruimte voor werken meet: min 0,8 procent per jaar bij zakelijke dienstverlening, min 0,6
				bij overheid en kwartaire diensten en min 1,1 bij overige consumentendiensten. Een schakelaar omdat de waarden uit de waarnemingsperiode 1996 tot 2019 komen en het rapport zelf waarschuwt
				dat verdere intensivering van publieke terreinen misschien niet reeel is; of de trend tot 2050 doorloopt is een keuze voor PBL. Met de demper Groeifactor_WanneerToepassen van 0,5 en de stop
				in 2050 komt min 0,6 procent per jaar over de reeks neer op ongeveer 8 procent meer dichtheid. Met FALSE staan de drie op nul.", Source = "Koomen en Claassens, Ruimte voor werken, 2022, sectie 3.2";

	container Groeifactor
	: Descr = "Aanpassing op de trendmatige verandering in m2 footprint per baan, op basis van Ruimte voor werken (2022). Industrie en logistiek staan bewust lager dan de rapportwaarden die in RSLight zijn
				toegepast (2 en 1 procent per jaar): met de toepassingsfactor 0,5 (#591) is de effectieve verdunning 0,5 en 0,25 procent per kalenderjaar, een factor 2,6 en 4,8 onder de recente waarneming
				van het rapport, dus een keuze en geen afleiding. De drie dienstverlenende subsectoren volgen de rapporttrend via DienstverleningVolgtRapporttrend.", Source = "Koomen en Claassens, Ruimte voor werken, 2022"
	{
		parameter<jaarlijks> Nijverheid             := 0.010[jaarlijks];
		parameter<jaarlijks> Logistiek              := 0.005[jaarlijks];
		parameter<jaarlijks> Detailhandel           := 0.000[jaarlijks], Descr = "Nul, en dat is de rapportwaarde: het ruimtebeslag per baan van detailhandel is over de hele waarnemingsperiode vrij stabiel.";
		parameter<jaarlijks> Ov_consumentendiensten := ModelParameters/Werken/DienstverleningVolgtRapporttrend ? -0.011[jaarlijks] : 0.000[jaarlijks], Descr = "Ruimte voor werken, sectie 3.2: het netto ruimtebeslag per baan van de overige consumentendiensten daalde sinds 1996 met 1,1 procent per jaar, de sterkste daling van de zes, vooral door de sterke banengroei in deze sector.";
		parameter<jaarlijks> Zak_dienstverlening    := ModelParameters/Werken/DienstverleningVolgtRapporttrend ? -0.008[jaarlijks] : 0.000[jaarlijks], Descr = "Ruimte voor werken, sectie 3.2: min 0,8 procent per jaar sinds 1996, in lijn met het nieuwe werken. Let op dat dit iets anders is dan m2BVO_job_Kantoor_groeifactor, die een eenmalige niveauverschuiving voor de bureaudeling regelt (#590, #668); deze parameter is de trendmatige daling en werkt per zichtjaar.";
		parameter<jaarlijks> Overheid_kw_diensten   := ModelParameters/Werken/DienstverleningVolgtRapporttrend ? -0.006[jaarlijks] : 0.000[jaarlijks], Descr = "Ruimte voor werken, sectie 3.2: min 0,6 procent per jaar sinds 1996. Eigen hermeting op de LISA-tijdreeks 1996 tot 2023 gekruist met de CBS-modusrasters gaf dezelfde richting: banen per hectare voorzieningenterrein van 32,5 in 2000 naar 43,2 in 2023, oftewel min 1,24 procent per jaar in ruimtebeslag per baan over de hele periode en min 0,55 procent sinds 2012.";
		
		parameter<float32>   Groeifactor_WanneerToepassen := 0.5f, Descr = "Wanneer in het zichtjaar moet het worden toegepast? 1= op zichtjaar, dus aantal jaren om toe te passen = Zichtjaar - prevZichtjaar. 0.5= halverwege tussen prev en zichtjaar.";
		parameter<YearRange> JaarVanafWaarGeenWerkdichtheidMeerAangepastWordt := 2050[YearRange], Descr = "Jaar vanaf wanneer de verdunning van banendichtheid in bestaande werkcellen (Groeifactor_XX) niet meer wordt toegepast. De verdunningsfactoren zijn 
																												gebaseerd op de empirische trend in m² ruimtebeslag per baan 1996-2019 (Koomen & Claassens, 2022), waarin de stijging sinds 2012 al sterk afvlakt. 
																												Lineaire doortrekking voorbij de waarnemingsperiode is daarmee niet onderbouwd. Bovendien komen de onderliggende mechanismen (verschuiving naar perifere 
																												logistiek, sectorshift van industrie naar diensten) deels uit eenmalige transitieprocessen die op enig moment zijn uitgewerkt. Dit parameterjaar legt vast tot
																												wanneer de verdunning realistisch geacht wordt.";
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Waarden die tot september 2026 als kaal getal in de lopende code stonden, hierheen verplaatst zonder de
	// waarde te veranderen.
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////

	container HalFractie
	: Descr = "Welk deel van het vloeroppervlak per gebruiksdoel fysiek een hal is, om een distributiehal anders te beprijzen dan een winkel (#674); gelezen in
				BaseData/Suitabilities/Verwervingskosten/Samenstelling. Het gaat om de bouwkundige verschijningsvorm binnen een gebruiksdoel en niet om hoeveel er van dat doel is: logistiek is het meest
				hal-achtig, kantoor het minst. Elke waarde draagt een IntegrityCheck op het bereik 0 tot 1."
	{
		// De check staat inline op elke waarde en niet als aparte conclusie: een IntegrityCheck op een
		// parameter die zelf de check is geeft "Invalid Recursion in UpdateMetaInfo". Zie de skill
		// geodms-valkuilen. Zo vuurt de bewaking bovendien op de waarde die je opvraagt.
		parameter<Float32> industrie        := 0.557f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> Logistiek        := 0.662f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> utiliteit_combi  := 0.488f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> Kantoor          := 0.155f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> winkel           := 0.350f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> bijeenkomst      := 0.206f, IntegrityCheck = "this >= 0f && this <= 1f";
		parameter<Float32> Gezondheidszorg  := 0.166f, IntegrityCheck = "this >= 0f && this <= 1f";
	}

	container UtiliteitCombi
	: Descr = "Wat er gebeurt met een verblijfsobject zonder woonfunctie en met meer dan een utiliteitsfunctie. De CBS-afleiding in SourceData/Vastgoed/BAG.dms eist per los gebruiksdoel Count_Utiliteiten
				== 1, dus zo'n object valt in de restklasse utiliteit_combi, die in Classifications/Vastgoed/BAG voluit naar Nijverheid gaat. Dat is een grote bak met een scheve inhoud, want naar
				samenstelling is maar een deel ervan industrie. De BAG kent geen oppervlak per gebruiksdoel binnen een object, alleen welke functies het heeft; verdelen is dus een modelkeuze, en die
				verdeelt hier over de eigen functies van het object en niet over een landelijk gemiddelde."
	{
		parameter<String> Verdeelsleutel := 'Omvang'
		, Descr = "Drie waarden. AllesNaarNijverheid is de terugvalstand en het gedrag van voor #667: de klasse blijft heel en gaat voluit naar Nijverheid. Omvang verdeelt het oppervlak van elk combi-object
					over zijn eigen functies naar rato van de typische omvang van die functie, het gemiddelde gebruiksoppervlak van objecten met alleen dat doel; een fabriekshal met een kantoortje wordt dan
					overwegend industrie. Gelijk verdeelt in gelijke delen. Een schatting per functie uit de combi-objecten zelf is geprobeerd en verworpen, want de spreiding binnen een klasse is te groot.
					Zolang BAG-nieuwbouw te veel volume oplevert (#703) verplaatst een uitsplitsing dat teveel alleen naar de subsectoren waar de claim boven de stand ligt; pas aanzetten als de volumekant
					klopt."
		, IntegrityCheck = "This == 'AllesNaarNijverheid' || This == 'Omvang' || This == 'Gelijk'";

		parameter<Bool> Splitsen := Verdeelsleutel != 'AllesNaarNijverheid'	, Descr = "Of de klasse wordt uitgesplitst. Op FALSE blijft elke kolom in SourceData/Vastgoed/BAG letterlijk zoals hij was.";

		container Gewicht := =Verdeelsleutel == 'Omvang' ? 'Omvang' : 'Gelijk'	, Descr = "De gewichten die gelden. Ze worden per verblijfsobject genormaliseerd over de functies die dat object heeft, dus alleen hun onderlinge verhouding telt.";

		container Omvang
		: Descr = "Het gemiddelde gebruiksoppervlak in m2 van verblijfsobjecten met precies dit ene doel, op de BAG-voorraad van het basisjaar binnen Nederland. Opnieuw te bepalen bij een nieuwe BAG-jaargang of een ander basisjaar.", Source = "BAG jaargang 20260710, voorraad 1-1-2023"
		{
			parameter<Float32> bijeenkomst      :=   478f;
			parameter<Float32> cel              := 13379f;
			parameter<Float32> Gezondheidszorg  :=   756f;
			parameter<Float32> industrie        :=  1021f;
			parameter<Float32> Kantoor          :=   621f;
			parameter<Float32> logies           :=   112f;
			parameter<Float32> onderwijs        :=  2332f;
			parameter<Float32> overige_gebruiks :=     0f, Descr = "Bewust nul. De klasse overige_gebruiks kent geen Jobs6-subsector, dus oppervlak dat daarheen gaat valt uit de werken-stand. Door het gewicht op nul te zetten wordt dat deel over de overige functies van hetzelfde object herverdeeld in plaats van te verdwijnen; zonder die uitzondering zou 4,6 procent van het combi-oppervlak weglekken.";
			parameter<Float32> sport            :=  1000f;
			parameter<Float32> winkel           :=   370f;
		}

		container Gelijk
		: Descr = "Gelijke delen over de gezette functies. Zelfde uitzondering voor overige_gebruiks als bij Omvang."
		{
			parameter<Float32> bijeenkomst      := 1f;
			parameter<Float32> cel              := 1f;
			parameter<Float32> Gezondheidszorg  := 1f;
			parameter<Float32> industrie        := 1f;
			parameter<Float32> Kantoor          := 1f;
			parameter<Float32> logies           := 1f;
			parameter<Float32> onderwijs        := 1f;
			parameter<Float32> overige_gebruiks := 0f;
			parameter<Float32> sport            := 1f;
			parameter<Float32> winkel           := 1f;
		}
	}

	parameter<Bool>      BAG_LogistiekDynamisch        :=  TRUE, Descr = "Vult de statische logistieke pandenset (stand 2021) aan met een LISA-afgeleide typering van nieuwbouw vanaf 2021, via het ontkoppelde bestand van WritePrivData/LogistiekAanvulling. Zonder
											aanvulling kan nieuwbouw nooit logistiek worden en telt zij als Nijverheid. Hergenereren na een BAG- of LISA-vintagewissel: tijdelijk op FALSE, WritePrivData/LogistiekAanvulling/Generate
											draaien en weer op TRUE, want met de parameter aan trekt het pand-domein het nog te schrijven bestand als supplier mee.";

	container LogistiekAanvulling
	: Descr = "De drempels van de LISA-afgeleide aanvulling op de statische logistieke pandenset, gelezen door WritePrivData/LogistiekAanvulling (#703); de aanvulling wordt eenmalig geschreven en met BAG_LogistiekDynamisch gelezen."
	{
		parameter<UInt32>  NefsPeiljaar      := 2021,  Descr = "Stand van de statische set; alleen panden met bouwjaar vanaf dit jaar komen voor aanvulling in aanmerking. Oudere panden zijn door de bronset beoordeeld; dat oordeel blijft leidend.";
		parameter<Float32> MinKernAandeel    := 0.3f,  Descr = "Minimaal aandeel kern-logistieke banen (groothandel zonder handelsbemiddeling, plus vervoer, opslag en post) in het pand";
		parameter<Float64> MinFootprint      := 500d,  Descr = "Ondergrens footprint in m2, gelijk aan de ondergrens van de bronset";
		parameter<Float64> MinFootprint_Leeg := 2500d, Descr = "Ondergrens footprint in m2 voor panden zonder eigen vestiging (de nabijheidsregel)";
		parameter<Float64> BufferAfstand     := 100d,  Descr = "Zoekafstand in meter vanaf de pandrand naar een kern-logistiek LISA-punt, voor panden zonder eigen vestiging. Vanaf de rand en niet vanaf de centroid: grote hallen hebben hun middelpunt ver van de rand. Op het nieuwbouwcohort van de replicatie-toets ruilt dit precisie voor recall (m2-precisie circa 0,75 bij m2-recall 0,75) en is de voorraadomvang vrijwel in balans, waar de centroid-variant de logistieke voorraad zo'n 19 procent onderschat.";
	}
}
