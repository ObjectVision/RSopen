// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Verdeling van de BAG-klasse utiliteit_combi over de gebruiksdoelen van het verblijfsobject zelf. Zie #667.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container UtiliteitCombi
: Descr = "Wat er gebeurt met een verblijfsobject dat geen woonfunctie heeft en meer dan een utiliteitsfunctie.

			De CBS-afleiding in SourceData/Vastgoed/BAG.dms eist voor elk los gebruiksdoel Count_Utiliteiten == 1, dus zo'n object telt in geen van zijn eigen doelen mee en valt in de restklasse utiliteit_combi. Die klasse gaat in Classifications/Vastgoed/BAG voluit naar de werksubsector Nijverheid.

			Dat is een grote bak met een scheve inhoud. In de voorraad van het basisjaar zitten er 55.649 verblijfsobjecten in met samen 86,9 miljoen m2 gebruiksoppervlak, en in de voetafdruk per gebruiksdoel is de klasse een kwart van wat Nijverheid in totaal heeft. Naar samenstelling is maar een deel ervan industrie: industrie plus kantoor is 41,6 procent van het combi-oppervlak, industrie plus winkel 11,9 procent, en de rest verdeelt zich over 228 andere combinaties.

			De BAG kent geen oppervlak per gebruiksdoel binnen een verblijfsobject, alleen een oppervlak per object. Verdelen is dus een modelkeuze en geen aflezing. Wat de BAG wel geeft is welke functies het object heeft, en die informatie wordt hier gebruikt: het oppervlak van elk combi-object wordt over zijn eigen functies verdeeld, niet over een landelijk gemiddelde."
{
	parameter<String> Verdeelsleutel := 'Omvang'
	, Descr = "Drie waarden.

				AllesNaarNijverheid is de terugvalstand en het gedrag van voor #667: de klasse blijft heel en gaat voluit naar Nijverheid.

				Omvang verdeelt het oppervlak van elk combi-object over zijn eigen functies naar rato van de typische omvang van die functie, gemeten als het gemiddelde gebruiksoppervlak van verblijfsobjecten die alleen dat doel hebben. Een fabriekshal met een kantoortje wordt dan overwegend industrie.

				Gelijk verdeelt in gelijke delen over de gezette functies. Dat veronderstelt niets over omvang, maar geeft de kleine functie in een groot pand evenveel gewicht als de grote.

				Een schatting van de bijdrage per functie uit de combi-objecten zelf, met niet-negatieve kleinste kwadraten, is geprobeerd en verworpen: R2 is 0,022 en winkel komt op nul uit. De spreiding binnen een klasse is te groot om er een verdeelsleutel uit te halen.

				Let op de volgorde met #703. Zolang BAG-nieuwbouw te veel volume oplevert verplaatst een uitsplitsing dat teveel alleen maar naar de subsectoren waar de claim boven de stand ligt; gemeten met de landelijke voorloper van deze sleutel ging het overschot in 2040 van 443.962 naar 547.355 banen. Zet deze schakelaar dus pas aan als de volumekant klopt."
	, IntegrityCheck = "This == 'AllesNaarNijverheid' || This == 'Omvang' || This == 'Gelijk'";

	parameter<Bool> Splitsen := Verdeelsleutel != 'AllesNaarNijverheid'
	, Descr = "Of de klasse wordt uitgesplitst. Op FALSE blijft elke kolom in SourceData/Vastgoed/BAG letterlijk zoals hij was.";

	container Gewicht := =Verdeelsleutel == 'Omvang' ? 'Omvang' : 'Gelijk'
	, Descr = "De gewichten die gelden. Ze worden per verblijfsobject genormaliseerd over de functies die dat object heeft, dus alleen hun onderlinge verhouding telt.";

	container Omvang
	: Descr = "Het gemiddelde gebruiksoppervlak in m2 van verblijfsobjecten met precies dit ene doel, gemeten op de BAG-voorraad van 1-1-2023 binnen Nederland, jaargang 20260710. Deze getallen horen opnieuw gemeten te worden bij een nieuwe BAG-jaargang of een ander basisjaar."
	{
		parameter<Float32> bijeenkomst      :=   478f;
		parameter<Float32> cel              := 13379f;
		parameter<Float32> Gezondheidszorg  :=   756f;
		parameter<Float32> industrie        :=  1021f;
		parameter<Float32> Kantoor          :=   621f;
		parameter<Float32> logies           :=   112f;
		parameter<Float32> onderwijs        :=  2332f;
		parameter<Float32> overige_gebruiks :=     0f, Descr = "Bewust nul. De klasse overige_gebruiks kent geen Jobs6-subsector, dus oppervlak dat daarheen gaat valt uit de werken-stand. Door het gewicht op nul te zetten wordt dat deel over de overige functies van hetzelfde object herverdeeld in plaats van te verdwijnen; zonder die uitzondering zou 4,6 procent van het combi-oppervlak weglekken.";
		parameter<Float32> sport            :=  1000f;
		parameter<Float32> winkel           :=   370f;
	}

	container Gelijk
	: Descr = "Gelijke delen over de gezette functies. Zelfde uitzondering voor overige_gebruiks als bij Omvang."
	{
		parameter<Float32> bijeenkomst      := 1f;
		parameter<Float32> cel              := 1f;
		parameter<Float32> Gezondheidszorg  := 1f;
		parameter<Float32> industrie        := 1f;
		parameter<Float32> Kantoor          := 1f;
		parameter<Float32> logies           := 1f;
		parameter<Float32> onderwijs        := 1f;
		parameter<Float32> overige_gebruiks := 0f;
		parameter<Float32> sport            := 1f;
		parameter<Float32> winkel           := 1f;
	}
}
