container Verblijfsrecreatie
{
	
	parameter<Float32>         Max_Objecten_β_Size := 300f;
	parameter<Float32>         Max_BrutoOpp_β_Size := 50f;
	
	parameter<Float32>         DefaultFractieUitgeefbaar       := Wonen/DefaultFractieUitgeefbaar;
	parameter<m2Pandfootprint> Pandfootprint_per_AlloceerdeCel := AdminDomain/NrMeter2PerCell * 0.043f, Descr = "Nationale bruto/netto verhouding in 2050 (=4.3%) uit Koomen, Claassens & Konig (2021) Ruimte voor verblijfsrecreatie - trends en mogelijke ontwikkelingen in ruimtebeslag verblijfsrecreatie";

	container Herschatting : Descr = "De instellingen van de herschatting van de geschiktheid voor verblijfsrecreatie (BaseData/Suitabilities/HerschattingLogit_Verblijfsrecreatie, #649); de drempel voor een groter pand en de bouwjaarmarge staan bij Werken/Herschatting."
	{
		parameter<Float32> Drempel  := 25f , Descr = "Vanaf hoeveel m2 groei van de logies in een verblijfsrecreatiegebied in een cel van 100 m de herschatting van de geschiktheid voor verblijfsrecreatie de cel als bouw telt (#649).";
		parameter<Float32> Trekking := 0.1f, Descr = "Welk deel van de cellen zonder bouw de herschatting van de geschiktheid voor verblijfsrecreatie in de steekproef neemt; de constante wordt daarvoor gecorrigeerd (#649).";
		parameter<UInt32>  Seed     := 649 , Descr = "Startgetal voor de trekking van Trekking, zodat de steekproef herhaalbaar is (#649).";
	}
}
