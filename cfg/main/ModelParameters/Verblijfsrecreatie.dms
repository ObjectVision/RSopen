container Verblijfsrecreatie
{
	parameter<Bool>            StandAlleenInCBSGebied := TRUE, Descr = "Telt de stand verblijfsrecreatie alleen de logies-objecten binnen de CBS-verblijfsrecreatiegebieden? De claim komt uit de trendanalyse in BaseData/StartState/Verblijfsrecreatie_Trends en die kijkt alleen naar logies binnen die gebieden. Telt de stand daarentegen alle logies mee, dus ook hotels midden in de stad, dan staat de stand structureel boven de claim voordat er iets is gealloceerd en meldt de claimrealisatie overrealisatie (#364). Op FALSE valt het model terug op de oude telling van alle logies.";
	
	parameter<Bool>            NieuweCellenOpMarginaleDichtheid := TRUE, Descr = "Rekent de allocatie nieuw gealloceerde verblijfsrecreatiecellen om naar objecten tegen de marginale trenddichtheid (Objecten_beta gedeeld door BrutoOpp_beta, landelijk circa 12,9 vbo per ha) in plaats van de gemiddelde voorraaddichtheid (Objecten gedeeld door BrutoOpp, circa 5,7 vbo per ha)? De trends zeggen dat nieuw terrein ongeveer twee keer zo dicht bebouwd raakt als de bestaande voorraad gemiddeld is; wie nieuwe cellen tegen het gemiddelde vult heeft bijna twee keer zoveel hectare nodig als de eigen BrutoOpp-trend, en die trend wordt nergens anders afgedwongen. Conform Koomen, Claassens en Konig (2021) hoofdstuk 4: kies de bruto/netto-verhouding zo dat het bruto areaal zijn eigen trend volgt. Op FALSE valt het model terug op de oude gemiddelde dichtheid.";
	
	parameter<Float32>         Max_Objecten_β_Size := 300f;
	parameter<Float32>         Max_BrutoOpp_β_Size := 50f;
	
	parameter<Float32>         DefaultFractieUitgeefbaar       := Wonen/DefaultFractieUitgeefbaar;
	parameter<m2Pandfootprint> Pandfootprint_per_AlloceerdeCel := AdminDomain/NrMeter2PerCell * 0.043f, Descr = "Nationale bruto/netto verhouding in 2050 (=4.3%) uit Koomen, Claassens & Konig (2021) Ruimte voor verblijfsrecreatie - trends en mogelijke ontwikkelingen in ruimtebeslag verblijfsrecreatie";
}
