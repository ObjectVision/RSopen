container Verblijfsrecreatie
{
	parameter<Bool>            StandAlleenInCBSGebied := TRUE, Descr = "Telt de stand verblijfsrecreatie alleen de logies-objecten binnen de CBS-verblijfsrecreatiegebieden? De claim komt uit de trendanalyse in BaseData/StartState/Verblijfsrecreatie_Trends, die
		alleen naar logies binnen die gebieden kijkt; telt de stand alle logies mee, ook hotels midden in de stad, dan staat zij structureel boven de claim en meldt de claimrealisatie overrealisatie
		(#364). Op FALSE de oude telling van alle logies.";
	
	parameter<Bool>            GebruikHerschatteLogitCoefficienten := TRUE, Descr = "Gebruikt de geschiktheid voor verblijfsrecreatie de in het model herschatte logit-coefficienten (BaseData/Suitabilities/Verblijfsrecreatie/Herschatting) in plaats van de csv-coefficienten
		uit 2021? De csv is geschat met 22 termen terwijl de toepassing er 15 gebruikt met de constante van het volledige model (#649); de herschatting gebruikt exact de toegepaste termen, zodat
		schatting en toepassing consistent zijn. Op FALSE de csv-coefficienten.";
	
	parameter<Bool>            NieuweCellenOpMarginaleDichtheid := TRUE, Descr = "Rekent de allocatie nieuw gealloceerde verblijfsrecreatiecellen om naar objecten tegen de marginale trenddichtheid (Objecten_beta gedeeld door BrutoOpp_beta) in plaats van de gemiddelde
		voorraaddichtheid (Objecten gedeeld door BrutoOpp)? De trends zeggen dat nieuw terrein ongeveer twee keer zo dicht bebouwd raakt als de bestaande voorraad; wie tegen het gemiddelde vult
		heeft bijna twee keer zoveel hectare nodig als de BrutoOpp-trend, en die wordt nergens anders afgedwongen. Op FALSE de gemiddelde dichtheid.", Source = "Koomen, Claassens en Konig (2021), hoofdstuk 4";
	
	parameter<Float32>         Max_Objecten_β_Size := 300f;
	parameter<Float32>         Max_BrutoOpp_β_Size := 50f;
	
	parameter<Float32>         DefaultFractieUitgeefbaar       := Wonen/DefaultFractieUitgeefbaar;
	parameter<m2Pandfootprint> Pandfootprint_per_AlloceerdeCel := AdminDomain/NrMeter2PerCell * 0.043f, Descr = "Nationale bruto/netto verhouding in 2050 (=4.3%) uit Koomen, Claassens & Konig (2021) Ruimte voor verblijfsrecreatie - trends en mogelijke ontwikkelingen in ruimtebeslag verblijfsrecreatie";
}
