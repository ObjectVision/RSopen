////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #605, verwijderen zodra de getallen in het issue staan.
//
// Hoeveel basisjaarlandbouw haalt de evident-benut-toets van de landbouw weg, en bij welke klassen?
// De toets loopt via VariantParameters/EvidentBenut/Landbouw/BinnenPlancapaciteit op de CBS-bodemgebruiks-
// klasse. Gemeten wordt op de basisjaarcellen die een landbouwklasse dragen, want de allocatie raakt sinds
// #605 alleen die cellen aan (Iter_Landbouw_T/Allocatie_Prep/MagLandbouwWorden).
//
// WAT DIT HARNAS HEEFT OPGELEVERD, gemeten 8 september 2026 op de OUDE lijst, voordat #605 haar versmalde:
//   basisjaarlandbouw 2.072.184 ha; de lijst dekte landelijk 1.988.181 ha maar raakte daarvan maar 114.431 ha
//   aan landbouwgrond, dus ruim 94 procent deed geen werk. Van die 114.431 ha was 61 procent open droog en
//   open nat natuurlijk terrein, met hoofdweg 14.054 en bos 10.632 erachter. Per klasse: Moerasbomen 96,4
//   procent van haar basisjaarareaal, Rietteelt 89,1, GG_vee_extensief 32,7 en GG_vee 4,6 procent.
//
//   Er was daarnaast een tweede, dode lijst op de LGN-klasse, aangewezen door een item in de zeef zonder
//   afnemer. Die sloot 89.265 ha landbouwgrond uit, met bloembollen 30.981 als grootste post, en overlapte
//   met de BBG-lijst op maar 16.257 ha. Zij zou 100 procent van het basisjaarareaal van Bollen, Boomkwekerij
//   en Moerasbomen wegzeven en 85,2 procent van Boomgaard. Beide zijn met #605 verwijderd, en daarmee ook
//   de LGN-helft van dit harnas.
//
// EN WAT DE VERSMALLING VAN #605 OPLEVERT, gemeten 8 september 2026 met dezelfde tabellen:
//   de lijst dekt landelijk nog 526.944 ha en raakt daarvan 25.196 ha aan landbouwgrond, dus 78 procent minder
//   dan de 114.431 hierboven. Geen enkele klasse verliest nog meer dan 2,01 procent van haar basisjaarareaal:
//   Rietteelt 2,01, GG_vee 1,67, Boomkwekerij 1,53, Boomgaard 1,11, GG_vee_extensief 0,87 en Moerasbomen 0,29
//   procent. Wat overblijft is hoofdweg 14.054 ha, woonterrein 3.298, bouwterrein 3.218, bedrijfsterrein 1.211,
//   semi-verhard 841, spoorterrein 512, detailhandel 415 en de rest onder de 350: allemaal posten die een
//   onomkeerbare verandering na de gewaskaart aanwijzen.
//
// Draai Tabel_Totalen, Tabel_BBG_PerKlasse en Tabel_PerLandbouwKlasse.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose605
: using = "Geography"
, Descr = "Tijdelijk meetharnas voor #605: hoeveel basisjaarlandbouw de evident-benut-toets wegzeeft, en bij welke klassen."
{
	parameter<Float32> CelHa := AdminDomain/NrHaPerCell[Float32];

	// ---- de basisjaarcellen die een landbouwklasse dragen ----

	attribute</Classifications/Actor/LandbouwKlasses> Klasse_Basisjaar (AdminDomain) :=
		/Classifications/Actor/LU_ModelType/LandbouwK_rel[/BaseData/StartState/Landgebruik/LU_Landbouw]
	, Descr = "De landbouwklasse van het basisjaar uit de landgebruikskaart, dezelfde bron als gg_LandbouwK in Templates/Landbouw.dms en als HuidigeKlasse_Basisjaar in Iter_Landbouw_T. Null waar de cel geen landbouwklasse draagt. Gebruikt in plaats van StateBasisjaar/State/Landbouw, want die tak bestaat alleen wanneer de landbouwsector in ModelParameters/SectorAllocRegio aanstaat.";

	attribute<Bool> IsLb (AdminDomain) := IsDefined(Klasse_Basisjaar);

	// ---- de lijst ----

	attribute</Classifications/Grondgebruik/CBSKlasse> gg_CBS (AdminDomain) := /BaseData/StartState/Bodemstatistiek/gg_CBS;

	attribute<Bool> EB_BBG (AdminDomain) := MakeDefined(/VariantParameters/EvidentBenut/Landbouw/BinnenPlancapaciteit/Default[gg_CBS], FALSE)
	, Descr = "Evident benut volgens de CBS-bodemgebruiksklasse. BinnenPlancapaciteit en BuitenPlancapaciteit zijn voor landbouw hetzelfde item, en BAU en WBS zijn per referentie gelijk aan Default, dus de variantkeuze doet hier niets.";

	// ---- de totalen ----

	parameter<Float32> ha_landbouw   := sum(IsLb ? CelHa : 0f);
	parameter<Float32> ha_bbg_totaal := sum(EB_BBG ? CelHa : 0f);
	parameter<Float32> ha_lb_bbg     := sum(IsLb && EB_BBG ? CelHa : 0f);
	parameter<Float32> ha_lb_over    := sum(IsLb && !EB_BBG ? CelHa : 0f);

	parameter<String> Tabel_Totalen :=
		  'grootheid;ha'
		+ '|basisjaarlandbouw (noemer);'        + string(ha_landbouw)
		+ '|lijst landelijk;'                   + string(ha_bbg_totaal)
		+ '|daarvan op basisjaarlandbouw;'      + string(ha_lb_bbg)
		+ '|basisjaarlandbouw dat overblijft;'  + string(ha_lb_over)
	, StorageName = "='%LocalDataProjDir%/Diagnose/605_evidentbenut_totalen.txt'", StorageType = "str"
	, Descr = "De eerste regel is de noemer: alles wat de allocatie nog kan aanraken. De tweede laat zien hoeveel van de lijst buiten dat areaal valt en dus geen werk doet. Voor de stand op de oude lijst, zie de kopregels van dit bestand.";

	// ---- waar de lijst op landbouwgrond ingrijpt ----

	unit<UInt8> BBG_PerKlasse := /Classifications/Grondgebruik/CBSKlasse
	{
		attribute<Float32> ha_uitgesloten := sum(IsLb && EB_BBG ? CelHa : 0f, gg_CBS);
		attribute<Float32> ha_landbouw    := sum(IsLb ? CelHa : 0f, gg_CBS);
	}

	parameter<String> Tabel_BBG_PerKlasse :=
		  'CBSklasse;ha basisjaarlandbouw;ha daarvan uitgesloten'
		+ AsList('|' + /Classifications/Grondgebruik/CBSKlasse/name + ';' + string(BBG_PerKlasse/ha_landbouw) + ';' + string(BBG_PerKlasse/ha_uitgesloten), '')
	, StorageName = "='%LocalDataProjDir%/Diagnose/605_evidentbenut_bbg.txt'", StorageType = "str"
	, Descr = "Per CBS-bodemgebruiksklasse hoeveel basisjaarlandbouw er ligt en hoeveel daarvan de lijst uitsluit. De klassen met veel landbouw maar zonder uitsluiting zijn de klassen die #605 uit de lijst heeft gehaald; daar spreekt het BBG de gewaskaart tegen in plaats van haar aan te vullen.";

	// ---- welke landbouwklassen de lijst wegzeeft ----

	unit<UInt8> PerLandbouwKlasse := /Classifications/Actor/LandbouwKlasses
	{
		attribute<Float32> ha_totaal  := sum(IsLb ? CelHa : 0f, Klasse_Basisjaar);
		attribute<Float32> ha_uit_bbg := sum(IsLb && EB_BBG ? CelHa : 0f, Klasse_Basisjaar);
	}

	parameter<String> Tabel_PerLandbouwKlasse :=
		  'landbouwklasse;ha basisjaar;ha uitgesloten'
		+ AsList('|' + /Classifications/Actor/LandbouwKlasses/name + ';' + string(PerLandbouwKlasse/ha_totaal) + ';' + string(PerLandbouwKlasse/ha_uit_bbg), '')
	, StorageName = "='%LocalDataProjDir%/Diagnose/605_evidentbenut_perklasse.txt'", StorageType = "str"
	, Descr = "De vraag die telt: welke landbouwklassen verliezen basisjaarareaal aan de evident-benut-toets? Een klasse die veel verliest kan haar eigen ondergrens niet halen, want die ondergrens staat in claims_conservatief op datzelfde ongezeefde basisjaarareaal en de restclaim moet haar dan terugknijpen met Krimp_Klasse.";
}
