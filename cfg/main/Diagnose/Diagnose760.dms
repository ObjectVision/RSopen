////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #760, verwijderen zodra de getallen in het issue staan.
//
// Meet de vier landschapsgebieden uit SourceData/Landschap/Landschapsgebieden: hun gerasterde areaal, hoeveel daarvan
// binnen het studiegebied valt, en de onderlinge overlap. Die laatste is de reden dat deze gebieden geen gedeelde
// indeling vormen maar elk een eigen eenheid van een regel zijn.
//
// De arealen zijn ook buiten het model bepaald, op de geleverde shapes met geopandas. Die twee wegen horen op de
// rastering na hetzelfde te geven; dat is de controle dat het inlezen klopt. Verwacht op de vector:
//   kust 1.836.437 ha, rivieren 351.655 ha, veen 354.173 ha voor de dichting, zand 1.668.981 ha.
//   overlap kust-veen 172.453, zand-veen 134.420, kust-zand 113.651, rivieren-veen 84.797, kust-rivieren en
//   zand-rivieren nul.
//
// Draai het item Tabel.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose760
: using = "Geography"
, Descr = "Tijdelijk meetharnas voor #760: arealen en overlap van de vier landschapsgebieden."
{
	container LG := /SourceData/Landschap/Landschapsgebieden;

	parameter<float32> CelHa := AdminDomain/NrHaPerCell[float32];

	attribute<bool> InNL (AdminDomain) := AdminDomain/IsCompactedDomain, Descr = "Het studiegebied, dus Nederland volgens de provinciegrenzen. Kust loopt ver daarbuiten, dus dit scheidt het deel op land van het deel op zee.";

	parameter<float64> ha_kust     := sum(float64(float32(LG/Impl/IsKust)     * CelHa));
	parameter<float64> ha_rivieren := sum(float64(float32(LG/Impl/IsRivieren) * CelHa));
	parameter<float64> ha_veen     := sum(float64(float32(LG/Impl/IsVeen)     * CelHa));
	parameter<float64> ha_zand     := sum(float64(float32(LG/Impl/IsZand)     * CelHa));

	parameter<float64> ha_kust_inNL     := sum(float64(float32(LG/Impl/IsKust     && InNL) * CelHa));
	parameter<float64> ha_rivieren_inNL := sum(float64(float32(LG/Impl/IsRivieren && InNL) * CelHa));
	parameter<float64> ha_veen_inNL     := sum(float64(float32(LG/Impl/IsVeen     && InNL) * CelHa));
	parameter<float64> ha_zand_inNL     := sum(float64(float32(LG/Impl/IsZand     && InNL) * CelHa));

	parameter<float64> ha_veen_ruw     := sum(float64(float32(LG/Impl/IsVeenRuw) * CelHa))
	, Descr = "Het veengebied zoals geleverd, met de gaten er nog in.";
	parameter<float64> ha_veen_gedicht := ha_veen - ha_veen_ruw
	, Descr = "Wat het dichten van de kleine gaten toevoegt. Buiten het model gemeten zou een drempel van 10 ha er 4.714 bijleggen, van de 30.238 ha die alle 2.459 gaten samen beslaan.";

	parameter<float64> ov_kust_rivieren := sum(float64(float32(LG/Impl/IsKust     && LG/Impl/IsRivieren) * CelHa));
	parameter<float64> ov_kust_veen     := sum(float64(float32(LG/Impl/IsKust     && LG/Impl/IsVeen)     * CelHa));
	parameter<float64> ov_kust_zand     := sum(float64(float32(LG/Impl/IsKust     && LG/Impl/IsZand)     * CelHa));
	parameter<float64> ov_riv_veen      := sum(float64(float32(LG/Impl/IsRivieren && LG/Impl/IsVeen)     * CelHa));
	parameter<float64> ov_riv_zand      := sum(float64(float32(LG/Impl/IsRivieren && LG/Impl/IsZand)     * CelHa));
	parameter<float64> ov_veen_zand     := sum(float64(float32(LG/Impl/IsVeen     && LG/Impl/IsZand)     * CelHa));

	parameter<float64> ha_geen_landschap_inNL := sum(float64(float32(InNL && !LG/Impl/IsKust && !LG/Impl/IsRivieren && !LG/Impl/IsVeen && !LG/Impl/IsZand) * CelHa))
	, Descr = "Hoeveel van Nederland buiten alle vier de landschappen valt. Anders dan bij #705 is dat geen restklasse maar gewoon gebied waarover geen enkel landschapsteam iets zegt; het komt in geen enkele landschapstabel terug, wel in de landelijke.";

	parameter<String> Tabel :=
		  'post;ha'
		+ '|kust;'                  + string(ha_kust)
		+ '|rivieren;'              + string(ha_rivieren)
		+ '|veen;'                  + string(ha_veen)
		+ '|zand;'                  + string(ha_zand)
		+ '|kust_in_nl;'            + string(ha_kust_inNL)
		+ '|rivieren_in_nl;'        + string(ha_rivieren_inNL)
		+ '|veen_in_nl;'            + string(ha_veen_inNL)
		+ '|zand_in_nl;'            + string(ha_zand_inNL)
		+ '|veen_ruw;'              + string(ha_veen_ruw)
		+ '|veen_gaten_gedicht;'    + string(ha_veen_gedicht)
		+ '|overlap_kust_rivieren;' + string(ov_kust_rivieren)
		+ '|overlap_kust_veen;'     + string(ov_kust_veen)
		+ '|overlap_kust_zand;'     + string(ov_kust_zand)
		+ '|overlap_riv_veen;'      + string(ov_riv_veen)
		+ '|overlap_riv_zand;'      + string(ov_riv_zand)
		+ '|overlap_veen_zand;'     + string(ov_veen_zand)
		+ '|nl_buiten_alle_vier;'   + string(ha_geen_landschap_inNL)
	, StorageName = "%LocalDataProjDir%/Diagnose/760_landschapsgebieden.txt"
	, StorageType = "str"
	, Descr = "Een regel per post, puntkomma-gescheiden, regels gescheiden door een liggend streepje.";
}
