////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #786, verwijderen zodra de tabel is opgeleverd en de getallen in het issue staan.
//
// Het areaal natuur in het basisjaar en in 2120, voor BAU en NbSGenuanceerd, landelijk en per landschapsgebied (#760).
//
// Waarom dit zonder allocatierun kan. Natuur is in deze toepassing geen gealloceerde sector: in
// ModelParameters/SectorAllocRegio staan alleen wonen, werken en waterberging. Nieuwe natuur komt uitsluitend uit
// VariantData/<variant>/ExogeenOpleggen, en die oplegging is variantdata, dus per zichtjaar gelijk. In de switch van
// Templates/Indicatoren/Landgebruikskaart/Make_Landgebruikskaart_Basisjaar_T staat de oplegging bovendien op de tweede
// case, meteen na geen data, en niets daaronder kan haar nog maskeren. De kaart van een zichtjaar is daarmee de
// basisjaarkaart met de oplegging eroverheen, op één ding na: wonen, werken en waterberging kunnen een cel die in het
// basisjaar natuur was overnemen. Dat is de enige post die hier ontbreekt, en die kant op wijst dit dus een bovengrens.
// Hoe groot die post is, is uit een eerdere ronde bekend (diagnosewaarde verdwenennatuur_ha, codestand met
// Landgebruik_Basis op BBG): in BAU ongeveer 2.100 ha en in NbSGenuanceerd ongeveer 21.800 ha, waarvan het NbSG-deel
// grotendeels de oplegging zelf is en niet de allocatie. Zie de kolom Verdwenen_natuur_*_ha hieronder, die telt wat de
// oplegging van de bestaande natuur afhaalt.
//
// Definitie van natuur: de klasse Natuur_Totaal van de landgebruikskaart, dus LU_ModelType/IsNatuur, dezelfde definitie
// als Templates/Indicatoren/Grondgebruik gebruikt voor NieuweNatuur en VerdwenenNatuur.
//
// De vier landschapsgebieden van #760 OVERLAPPEN elkaar en dekken samen niet heel Nederland, dus de kolommen tellen niet
// op tot de regel Nederland. De regel Geen_landschap maakt het verschil zichtbaar.
//
// Draai het item Tabel; dat schrijft de csv.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose786
: using = "Units;Geography"
, Descr = "Tijdelijk meetharnas voor #786: het areaal natuur in het basisjaar en in 2120, per variant en per landschapsgebied, langs de preprocessingroute."
{
	container LG    := /SourceData/Landschap/Landschapsgebieden;
	unit<uint8> LU_MT := /Classifications/Actor/LU_ModelType;

	parameter<float32> CelHa       := AdminDomain/NrHaPerCell[float32];
	attribute<bool>    InSA (AdminDomain) := rdc_meter/IsStudyArea_AdminDomain, Descr = "Het studiegebied. Kust loopt ver op zee door, dus zonder deze snede telt de kustregel de Noordzee mee.";

	unit<uint8> Gebieden : nrofrows = 6
	, Descr = "De rapportagegebieden. LET OP: de volgorde hier moet gelijk lopen met de volgorde van de argumenten in Aggr_T/Ha."
	{
		attribute<string> name  : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand', 'Geen_landschap'];
		attribute<string> Label := name;
	}

	container Maskers
	: Descr = "Per gebied de cellen die meetellen, alle vier binnen het studiegebied."
	{
		attribute<bool> Nederland      (AdminDomain) := InSA;
		attribute<bool> Kust           (AdminDomain) := InSA && LG/Impl/IsKust;
		attribute<bool> Rivieren       (AdminDomain) := InSA && LG/Impl/IsRivieren;
		attribute<bool> Veen           (AdminDomain) := InSA && LG/Impl/IsVeen;
		attribute<bool> Zand           (AdminDomain) := InSA && LG/Impl/IsZand;
		attribute<bool> Geen_landschap (AdminDomain) := InSA && !LG/Impl/IsKust && !LG/Impl/IsRivieren && !LG/Impl/IsVeen && !LG/Impl/IsZand;
	}

	container Kaarten
	: Descr = "De landgebruikskaart van het basisjaar per variant, en de kaart van 2120 langs de preprocessingroute: de oplegging over de basisjaarkaart heen."
	{
		attribute<LU_MT> Basisjaar_BAU  (AdminDomain) := /Indicatoren/WLO_hoog_BAU/Basisjaar/LandgebruikskaartNL2120/Result
		, Descr = "Met opzet Result en niet Result_SA: die laatste valt bij ModelParameters/LandUseMapOntkoppeld terug op het weggeschreven bestand, en schrijft het anders zelf weg. Het studiegebiedmasker zit hier in Maskers.";
		attribute<LU_MT> Basisjaar_NbSG (AdminDomain) := /Indicatoren/WLO_hoog_NbSGenuanceerd/Basisjaar/LandgebruikskaartNL2120/Result
		, Descr = "De basisjaarkaart is niet casusonafhankelijk, want hij loopt via Stand. Daarom staat hij hier per variant; de kolom Basisjaar_verschil_ha in Tabel laat zien of dat voor natuur iets uitmaakt.";

		attribute<LU_MT> Oplegging_BAU  (AdminDomain) := /VariantData/BAU/ExogeenOpleggen/Totaal;
		attribute<LU_MT> Oplegging_NbSG (AdminDomain) := /VariantData/NbSGenuanceerd/ExogeenOpleggen/Totaal;

		attribute<LU_MT> Y2120_BAU  (AdminDomain) := IsDefined(Basisjaar_BAU)  ? MakeDefined(Oplegging_BAU,  Basisjaar_BAU)  : null_b[LU_MT]
		, Descr = "De eerste twee cases van de switch in de landgebruikskaart: geen data blijft geen data, en daaronder wint de oplegging van alles wat er lag.";
		attribute<LU_MT> Y2120_NbSG (AdminDomain) := IsDefined(Basisjaar_NbSG) ? MakeDefined(Oplegging_NbSG, Basisjaar_NbSG) : null_b[LU_MT];

		attribute<LGT>  LGT_Basisjaar (AdminDomain) := /BaseData/StartState/Landgebruik/Type
		, Descr = "De stand-administratie van het landgebruik in het basisjaar: een beheertype waar de cel natuur of water is, een landbouwtype waar zij landbouw is, en anders de LGN-klasse zelf. Elke cel draagt precies een klasse, dus een tabel hierop telt per constructie op tot het oppervlak.";

		attribute<LGT>  LGT_2120_BAU  (AdminDomain) := MakeDefined(MakeDefined(LGT/Van_INL[/VariantData/BAU/ExogeenOpleggen/Beheertype],            LGT/Van_LandbouwType[/VariantData/BAU/ExogeenOpleggen/LandbouwType_rel]),            LGT_Basisjaar)
		, Descr = "Dezelfde stand in 2120. Dit is de regel die Templates/Allocatie/Zichtjaar_T gebruikt om de stand bij te werken (Impl/Landgebruik/Exo en Type): eerst het opgelegde beheertype, dan het opgelegde landbouwtype, en anders blijft staan wat er lag. Nagebouwd en niet gelezen, want lezen zou een allocatierun vragen.";
		attribute<LGT>  LGT_2120_NbSG (AdminDomain) := MakeDefined(MakeDefined(LGT/Van_INL[/VariantData/NbSGenuanceerd/ExogeenOpleggen/Beheertype], LGT/Van_LandbouwType[/VariantData/NbSGenuanceerd/ExogeenOpleggen/LandbouwType_rel]), LGT_Basisjaar);

		attribute<LGNK> LGN_Basisjaar (AdminDomain) := /BaseData/StartState/Landgebruik/LGN
		, Descr = "De fysieke bedekking volgens LGN in het basisjaar. LGN bestaat alleen voor het basisjaar; in de tabel per LGN-klasse is dit dus de herkomst en niet een toestand in 2120.";
	}

	unit<uint8> BT   := /Classifications/Grondgebruik/INL_Beheertype;
	unit<uint8> NT   := /Classifications/Grondgebruik/NatuurType;
	unit<uint8> LGNK := /Classifications/Grondgebruik/LGNKlasse;
	unit<uint8> LGT  := /Classifications/Grondgebruik/LandgebruikType;

	container Vlaggen
	: Descr = "De kaarten teruggebracht tot de vraag natuur ja of nee, en water ja of nee."
	{
		attribute<bool> Natuur_bas_BAU  (AdminDomain) := MakeDefined(LU_MT/IsNatuur[Kaarten/Basisjaar_BAU],  FALSE);
		attribute<bool> Natuur_bas_NbSG (AdminDomain) := MakeDefined(LU_MT/IsNatuur[Kaarten/Basisjaar_NbSG], FALSE);
		attribute<bool> Natuur_2120_BAU  (AdminDomain) := MakeDefined(LU_MT/IsNatuur[Kaarten/Y2120_BAU],  FALSE);
		attribute<bool> Natuur_2120_NbSG (AdminDomain) := MakeDefined(LU_MT/IsNatuur[Kaarten/Y2120_NbSG], FALSE);

		attribute<bool> Nieuw_BAU      (AdminDomain) := Natuur_2120_BAU  && !Natuur_bas_BAU;
		attribute<bool> Nieuw_NbSG     (AdminDomain) := Natuur_2120_NbSG && !Natuur_bas_NbSG;
		attribute<bool> Verdwenen_BAU  (AdminDomain) := Natuur_bas_BAU   && !Natuur_2120_BAU
		, Descr = "Bestaande natuur die de oplegging omzet in iets anders: open water uit de landschapsleveringen, of de landbouwstroom van de veenbouwstenen. De allocatie zit hier niet in; zie de kop van dit bestand.";
		attribute<bool> Verdwenen_NbSG (AdminDomain) := Natuur_bas_NbSG  && !Natuur_2120_NbSG;

		attribute<bool> Basisjaar_verschil (AdminDomain) := Natuur_bas_BAU != Natuur_bas_NbSG
		, Descr = "Zelftoets: wijkt de basisjaarkaart tussen de twee varianten af op de vraag of een cel natuur is? Hoort nul te zijn.";

		attribute<bool> Water_bas_BAU   (AdminDomain) := MakeDefined(Kaarten/Basisjaar_BAU == LU_MT/V/Water_Totaal, FALSE);
		attribute<bool> Water_2120_BAU  (AdminDomain) := MakeDefined(Kaarten/Y2120_BAU     == LU_MT/V/Water_Totaal, FALSE);
		attribute<bool> Water_2120_NbSG (AdminDomain) := MakeDefined(Kaarten/Y2120_NbSG    == LU_MT/V/Water_Totaal, FALSE);

		attribute<bool> Alles (AdminDomain) := const(TRUE, AdminDomain), Descr = "Voor de oppervlaktekolom; de snede op het studiegebied zit in Maskers.";

	}

	template Aggr_T
	: using = "Units;Geography"
	, Descr = "Aggregeert een booleaanse kaart naar de zes rapportagegebieden. De argumentvolgorde van union_data volgt Gebieden/name; wie daar een regel invoegt moet hier mee."
	{
		attribute<bool> Kaart (AdminDomain);

		parameter<float64> v_Nederland      := sum(float64(float32(Kaart && /Diagnose/PerIssue/Diagnose786/Maskers/Nederland)      * /Diagnose/PerIssue/Diagnose786/CelHa));
		parameter<float64> v_Kust           := sum(float64(float32(Kaart && /Diagnose/PerIssue/Diagnose786/Maskers/Kust)           * /Diagnose/PerIssue/Diagnose786/CelHa));
		parameter<float64> v_Rivieren       := sum(float64(float32(Kaart && /Diagnose/PerIssue/Diagnose786/Maskers/Rivieren)       * /Diagnose/PerIssue/Diagnose786/CelHa));
		parameter<float64> v_Veen           := sum(float64(float32(Kaart && /Diagnose/PerIssue/Diagnose786/Maskers/Veen)           * /Diagnose/PerIssue/Diagnose786/CelHa));
		parameter<float64> v_Zand           := sum(float64(float32(Kaart && /Diagnose/PerIssue/Diagnose786/Maskers/Zand)           * /Diagnose/PerIssue/Diagnose786/CelHa));
		parameter<float64> v_Geen_landschap := sum(float64(float32(Kaart && /Diagnose/PerIssue/Diagnose786/Maskers/Geen_landschap) * /Diagnose/PerIssue/Diagnose786/CelHa));

		attribute<float64> Ha (/Diagnose/PerIssue/Diagnose786/Gebieden) :=
			union_data(/Diagnose/PerIssue/Diagnose786/Gebieden, v_Nederland, v_Kust, v_Rivieren, v_Veen, v_Zand, v_Geen_landschap);
	}

	container Opp             := Aggr_T(Vlaggen/Alles);
	container Nat_bas_BAU     := Aggr_T(Vlaggen/Natuur_bas_BAU);
	container Nat_bas_NbSG    := Aggr_T(Vlaggen/Natuur_bas_NbSG);
	container Nat_2120_BAU    := Aggr_T(Vlaggen/Natuur_2120_BAU);
	container Nat_2120_NbSG   := Aggr_T(Vlaggen/Natuur_2120_NbSG);
	container Nat_nieuw_BAU   := Aggr_T(Vlaggen/Nieuw_BAU);
	container Nat_nieuw_NbSG  := Aggr_T(Vlaggen/Nieuw_NbSG);
	container Nat_weg_BAU     := Aggr_T(Vlaggen/Verdwenen_BAU);
	container Nat_weg_NbSG    := Aggr_T(Vlaggen/Verdwenen_NbSG);
	container Nat_bas_versch  := Aggr_T(Vlaggen/Basisjaar_verschil);
	container Wat_bas_BAU     := Aggr_T(Vlaggen/Water_bas_BAU);
	container Wat_2120_BAU    := Aggr_T(Vlaggen/Water_2120_BAU);
	container Wat_2120_NbSG   := Aggr_T(Vlaggen/Water_2120_NbSG);

	unit<uint8> Tabel := Gebieden
	,	StorageName = "%LocalDataProjDir%/Diagnose/786_arealen_natuur.csv"
	,	StorageType = "gdalwrite.vect"
	,	Descr = "De uitdraai van #786. Een regel per gebied, alle arealen in hectare binnen het studiegebied."
	{
		attribute<string>  Gebied                    := Gebieden/name;
		attribute<float64> Oppervlak_ha              := Opp/Ha,            Descr = "Het studiegebied binnen dit gebied. Controlegetal.";
		attribute<float64> Natuur_basisjaar_ha       := Nat_bas_BAU/Ha;
		attribute<float64> Natuur_2120_BAU_ha        := Nat_2120_BAU/Ha;
		attribute<float64> Natuur_2120_NbSG_ha       := Nat_2120_NbSG/Ha;
		attribute<float64> Verschil_NbSG_min_BAU_ha  := Nat_2120_NbSG/Ha - Nat_2120_BAU/Ha;
		attribute<float64> Nieuwe_natuur_BAU_ha      := Nat_nieuw_BAU/Ha;
		attribute<float64> Nieuwe_natuur_NbSG_ha     := Nat_nieuw_NbSG/Ha;
		attribute<float64> Verdwenen_natuur_BAU_ha   := Nat_weg_BAU/Ha;
		attribute<float64> Verdwenen_natuur_NbSG_ha  := Nat_weg_NbSG/Ha;
		attribute<float64> Water_basisjaar_ha        := Wat_bas_BAU/Ha;
		attribute<float64> Water_2120_BAU_ha         := Wat_2120_BAU/Ha;
		attribute<float64> Water_2120_NbSG_ha        := Wat_2120_NbSG/Ha;

		attribute<float64> Toets_basisjaar_ha := Nat_bas_versch/Ha,   Descr = "Zelftoets: waar de twee varianten in het basisjaar een andere natuurvlag geven. Hoort nul te zijn.";
		attribute<float64> Toets_sluit_BAU    := Nat_2120_BAU/Ha  - (Nat_bas_BAU/Ha  + Nat_nieuw_BAU/Ha  - Nat_weg_BAU/Ha),  Descr = "Zelftoets: 2120 is basisjaar plus nieuw min verdwenen. Hoort nul te zijn.";
		attribute<float64> Toets_sluit_NbSG   := Nat_2120_NbSG/Ha - (Nat_bas_NbSG/Ha + Nat_nieuw_NbSG/Ha - Nat_weg_NbSG/Ha), Descr = "Idem voor NbSGenuanceerd.";
	}

	container Kaarten_export
	: Descr = "Dezelfde natuurkaarten als tif, langs dezelfde opleggingsroute als de tabel hierboven en dus zonder allocatie. Vraag Generate op, dan gaan ze in een keer weg naar Indicatoren/Natuur_uit_oplegging.

				WAAROM DIT LOS STAAT VAN DE GEWONE INDICATORENEXPORT. Die leest de stand van de allocatie, en op 9 september 2026 klopt die stand aan twee kanten niet: het exploitatiesaldo stond met het verkeerde teken zodat de wonenclaim nergens werd gehaald (#672), en de landbouwstand valt vanaf het tweede zichtjaar weg (#797). Natuur komt uitsluitend uit ExogeenOpleggen, en die oplegging is variantdata, dus deze kaarten staan los van allebei die fouten en zijn wel te leveren.

				WAT ER NIET IN ZIT. Wonen, werken en waterberging kunnen in de allocatie een bestaande natuurcel overnemen, en die post kent deze route niet. Het jaar 2120 is hier dus een bovengrens. In de productieronde van 1 september ging het in BAU om ongeveer 2.100 ha op 872.000, dus onder een half procent. Noem dat voorbehoud bij elk gebruik van deze kaarten.

				Het studiegebiedmasker zit in elke kaart, zodat een aggregatie op deze tifs hetzelfde antwoord geeft als de tabel hierboven."
	{
		parameter<String> Map := '%LocalDataProjDir%/Indicatoren/Natuur_uit_oplegging/';

		attribute<LGT>  Natuurtype_Basisjaar            (AdminDomain) := InSA ? Kaarten/LGT_Basisjaar  : null_b[LGT], StorageName = "=Map+'Natuurtype_Basisjaar_Nederland.tif'",            StorageType = "gdalwrite.grid", Descr = "De stand-administratie van het landgebruik: een beheertype waar de cel natuur of water is, een landbouwtype waar zij landbouw is, en anders de LGN-klasse. Dit is de kaart die zegt WELKE natuur er ligt.";
		attribute<LGT>  Natuurtype_2120_BAU             (AdminDomain) := InSA ? Kaarten/LGT_2120_BAU   : null_b[LGT], StorageName = "=Map+'Natuurtype_2120_BAU_Nederland.tif'",             StorageType = "gdalwrite.grid";
		attribute<LGT>  Natuurtype_2120_NbSGenuanceerd  (AdminDomain) := InSA ? Kaarten/LGT_2120_NbSG  : null_b[LGT], StorageName = "=Map+'Natuurtype_2120_NbSGenuanceerd_Nederland.tif'",  StorageType = "gdalwrite.grid";

		attribute<Bool> Natuur_Basisjaar                (AdminDomain) := InSA && Vlaggen/Natuur_bas_BAU,   StorageName = "=Map+'Natuur_Basisjaar_Nederland.tif'",               StorageType = "tif", Descr = "Natuur ja of nee. Uit de BAU-kaart; de zelftoets Toets_basisjaar_ha in Tabel bewaakt dat NbSGenuanceerd in het basisjaar dezelfde vlag geeft.";
		attribute<Bool> Natuur_2120_BAU                 (AdminDomain) := InSA && Vlaggen/Natuur_2120_BAU,  StorageName = "=Map+'Natuur_2120_BAU_Nederland.tif'",                StorageType = "tif";
		attribute<Bool> Natuur_2120_NbSGenuanceerd      (AdminDomain) := InSA && Vlaggen/Natuur_2120_NbSG, StorageName = "=Map+'Natuur_2120_NbSGenuanceerd_Nederland.tif'",     StorageType = "tif";

		attribute<Bool> NieuweNatuur_BAU                (AdminDomain) := InSA && Vlaggen/Nieuw_BAU,        StorageName = "=Map+'NieuweNatuur_BAU_Nederland.tif'",               StorageType = "tif";
		attribute<Bool> NieuweNatuur_NbSGenuanceerd     (AdminDomain) := InSA && Vlaggen/Nieuw_NbSG,       StorageName = "=Map+'NieuweNatuur_NbSGenuanceerd_Nederland.tif'",    StorageType = "tif";
		attribute<Bool> VerdwenenNatuur_BAU             (AdminDomain) := InSA && Vlaggen/Verdwenen_BAU,    StorageName = "=Map+'VerdwenenNatuur_BAU_Nederland.tif'",            StorageType = "tif", Descr = "Bestaande natuur die de oplegging in iets anders omzet: open water uit de landschapsleveringen, of de landbouwstroom van de veenbouwstenen.";
		attribute<Bool> VerdwenenNatuur_NbSGenuanceerd  (AdminDomain) := InSA && Vlaggen/Verdwenen_NbSG,   StorageName = "=Map+'VerdwenenNatuur_NbSGenuanceerd_Nederland.tif'", StorageType = "tif";

		parameter<String> Generate := 'Ready'
		, ExplicitSuppliers = "Natuurtype_Basisjaar;Natuurtype_2120_BAU;Natuurtype_2120_NbSGenuanceerd;Natuur_Basisjaar;Natuur_2120_BAU;Natuur_2120_NbSGenuanceerd;NieuweNatuur_BAU;NieuweNatuur_NbSGenuanceerd;VerdwenenNatuur_BAU;VerdwenenNatuur_NbSGenuanceerd;../Tabel"
		, Descr = "Schrijft de tien kaarten plus de tabel in een aanroep. De tabel staat er bewust bij: kaart en tabel horen uit dezelfde run te komen, anders kan een lezer ze niet naast elkaar leggen.";
	}

	container Herkomst_BAU
	: Descr = "Waar de nieuwe natuur van BAU vandaan komt. De vraag die hierachter zit: team effectbepaling houdt het op ongeveer 46.000 ha nieuwe natuur in BAU, en dit model komt op ruim 279.000 ha. Nieuw is hier hetzelfde als in de tabel hierboven: de kaart van 2120 noemt de cel natuur en die van het basisjaar niet.

				Vier sneden op dezelfde verzameling cellen. Naar het beheertype dat de MNP-kaart erop legt, naar de klasse die de basisjaarkaart er had, naar de LGN-klasse eronder, en naar de vraag of het Natuurbeheerplan 2026 daar al een beheertype geeft.

				Die laatste is de beslissende. Het NBP is de officiele beheertypenkaart. Geeft het daar een type, dan ligt er natuur volgens de beheertypenkaart terwijl onze basisjaarkaart de cel geen natuur noemt, want die beslissing ligt bij LGN: BaseData/StartState/Landgebruik/Beheertype laat de beheertypenkaart alleen spreken waar LGN natuur of water ziet. Dat deel is nieuw in onze telling en niet in die van een teller die van de beheertypenkaart uitgaat. Het NBP wordt hier ONGEMASKEERD gelezen, dus ook buiten LGN-natuur; dat is precies het punt.

				Vraag de vier Tabel_-items op in een aanroep; die schrijven de tekstbestanden."
	{
		unit<uint8> BT   := /Classifications/Grondgebruik/INL_Beheertype;
		unit<uint8> NT   := /Classifications/Grondgebruik/NatuurType;
		unit<uint8> LGNK := /Classifications/Grondgebruik/LGNKlasse;

		attribute<BT>   Type_Opgelegd (AdminDomain) := /VariantData/BAU/ExogeenOpleggen/Beheertype_Kaart, Descr = "Het beheertype dat BAU op de cel legt, na het opleggingsmasker van #641.";
		attribute<BT>   Type_NBP      (AdminDomain) := /SourceData/Grondgebruik/NBP/INL_Beheertype_AD, Descr = "Het beheertype volgens het Natuurbeheerplan 2026, ongemaskeerd. Leest de ontkoppelde tif zolang de fingerprint klopt.";
		attribute<LGNK> LGN_Basisjaar (AdminDomain) := /BaseData/StartState/Landgebruik/LGN, Descr = "De fysieke bedekking volgens LGN, de bron die beslist of de basisjaarkaart hier natuur ziet.";

		attribute<bool>    Nieuw    (AdminDomain) := Vlaggen/Nieuw_BAU && InSA;
		attribute<float32> Opp      (AdminDomain) := float32(Nieuw) * CelHa, Descr = "Hectares per cel van de nieuwe natuur, nul elders, zodat elke som hieronder vanzelf op die verzameling snijdt.";
		attribute<float32> Opp_NBP  (AdminDomain) := float32(Nieuw &&  IsDefined(Type_NBP)) * CelHa, Descr = "Daarvan het deel waar het NBP al een beheertype geeft.";
		attribute<float32> Opp_Geen (AdminDomain) := float32(Nieuw && !IsDefined(Type_NBP)) * CelHa, Descr = "En het deel waar het NBP zwijgt: nieuw ten opzichte van beide kaarten.";

		container PerNT
		: Descr = "De nieuwe natuur van BAU naar het natuurtype dat de MNP-kaart erop legt."
		{
			attribute<float64> Nieuw      (NT) := sum(float64(Opp),      BT/NatuurType_rel[Type_Opgelegd]);
			attribute<float64> Met_NBP    (NT) := sum(float64(Opp_NBP),  BT/NatuurType_rel[Type_Opgelegd]);
			attribute<float64> Zonder_NBP (NT) := sum(float64(Opp_Geen), BT/NatuurType_rel[Type_Opgelegd]);
		}

		container PerBasisjaar
		: Descr = "Dezelfde cellen naar de klasse die de basisjaarkaart er had. Dit is wat er verdwijnt als BAU zijn natuur oplegt."
		{
			attribute<float64> Nieuw      (LU_MT) := sum(float64(Opp),      Kaarten/Basisjaar_BAU);
			attribute<float64> Met_NBP    (LU_MT) := sum(float64(Opp_NBP),  Kaarten/Basisjaar_BAU);
			attribute<float64> Zonder_NBP (LU_MT) := sum(float64(Opp_Geen), Kaarten/Basisjaar_BAU);
		}

		container PerLGN
		: Descr = "En naar de LGN-klasse eronder, de waarneming die bepaalt of de basisjaarkaart hier natuur ziet."
		{
			attribute<float64> Nieuw      (LGNK) := sum(float64(Opp),      LGN_Basisjaar);
			attribute<float64> Met_NBP    (LGNK) := sum(float64(Opp_NBP),  LGN_Basisjaar);
			attribute<float64> Zonder_NBP (LGNK) := sum(float64(Opp_Geen), LGN_Basisjaar);
		}

		container Totalen
		: Descr = "De headline-getallen, plus twee zelftoetsen."
		{
			parameter<float64> Nieuw_BAU_ha        := sum(float64(Opp)), Descr = "Hoort gelijk te zijn aan Nieuwe_natuur_BAU_ha op de regel Nederland van de tabel hierboven.";
			parameter<float64> Met_NBP_type_ha     := sum(float64(Opp_NBP));
			parameter<float64> Zonder_NBP_type_ha  := sum(float64(Opp_Geen));
			parameter<float64> Basisjaar_water_ha  := sum(float64(Nieuw && Vlaggen/Water_bas_BAU ? CelHa : 0f)), Descr = "Nieuwe natuur op een cel die de basisjaarkaart open water noemt. De categorietoets in Natuur_T/Landelijk hoort dit op nul te houden; dit is de vraag of de 279.000 ha zee of plas bevat.";
			parameter<float64> LGN_water_ha        := sum(float64(Nieuw && MakeDefined(LGNK/code[LGN_Basisjaar] == 16w || LGNK/code[LGN_Basisjaar] == 17w, FALSE) ? CelHa : 0f)), Descr = "Idem gemeten aan LGN zelf: klasse 16 zoet water en 17 zout water.";
			parameter<float64> NBP_binnen_SA_ha    := sum(float64(InSA && IsDefined(Type_NBP) ? CelHa : 0f)), Descr = "Het hele NBP-areaal met een beheertype binnen het studiegebied, als noemer bij Met_NBP_type_ha.";
			parameter<float64> Toets_zonder_type   := sum(float64(Nieuw && !IsDefined(Type_Opgelegd) ? CelHa : 0f)), Descr = "Zelftoets: nieuwe natuur zonder opgelegd beheertype. Hoort nul te zijn, anders meet PerNT iets anders dan Totalen.";
			parameter<float64> Toets_som_NT        := sum(float64(PerNT/Nieuw)) - Nieuw_BAU_ha, Descr = "Zelftoets: de natuurtypentabel telt op tot het totaal. Hoort nul te zijn.";
		}

		parameter<String> Tabel_NT :=
			  'code;natuurtype;nieuw_ha;met_nbp_ha;zonder_nbp_ha|'
			+ AsList(NT/code + ';' + NT/name
				+ ';' + string(PerNT/Nieuw)
				+ ';' + string(PerNT/Met_NBP)
				+ ';' + string(PerNT/Zonder_NBP), '|')
		,	StorageName = "%LocalDataProjDir%/Diagnose/786_bau_nieuw_per_natuurtype.txt"
		,	StorageType = "str";

		parameter<String> Tabel_Basisjaar :=
			  'basisjaarklasse;nieuw_ha;met_nbp_ha;zonder_nbp_ha|'
			+ AsList(LU_MT/name
				+ ';' + string(PerBasisjaar/Nieuw)
				+ ';' + string(PerBasisjaar/Met_NBP)
				+ ';' + string(PerBasisjaar/Zonder_NBP), '|')
		,	StorageName = "%LocalDataProjDir%/Diagnose/786_bau_nieuw_per_basisjaarklasse.txt"
		,	StorageType = "str";

		parameter<String> Tabel_LGN :=
			  'lgn_code;lgn_naam;nieuw_ha;met_nbp_ha;zonder_nbp_ha|'
			+ AsList(string(LGNK/code) + ';' + LGNK/naam
				+ ';' + string(PerLGN/Nieuw)
				+ ';' + string(PerLGN/Met_NBP)
				+ ';' + string(PerLGN/Zonder_NBP), '|')
		,	StorageName = "%LocalDataProjDir%/Diagnose/786_bau_nieuw_per_lgn.txt"
		,	StorageType = "str";

		parameter<String> Tabel_Totalen :=
			  'post;ha|'
			+ 'nieuw_bau;'          + string(Totalen/Nieuw_BAU_ha)
			+ '|met_nbp_type;'      + string(Totalen/Met_NBP_type_ha)
			+ '|zonder_nbp_type;'   + string(Totalen/Zonder_NBP_type_ha)
			+ '|basisjaar_water;'   + string(Totalen/Basisjaar_water_ha)
			+ '|lgn_water;'         + string(Totalen/LGN_water_ha)
			+ '|nbp_binnen_sa;'     + string(Totalen/NBP_binnen_SA_ha)
			+ '|toets_zonder_type;' + string(Totalen/Toets_zonder_type)
			+ '|toets_som_nt;'      + string(Totalen/Toets_som_NT)
		,	StorageName = "%LocalDataProjDir%/Diagnose/786_bau_nieuw_totalen.txt"
		,	StorageType = "str";

	}

	// -------------------------------------------------------------------------------------------------------------------
	// De levering aan team effectbepaling: arealen per landgebruikstype, per landschapsgebied, voor het basisjaar en voor
	// 2120 in beide varianten. Dezelfde route als hierboven en dus zonder allocatierun.
	//
	// Een tabel en niet twee. LandgebruikType is de unie van de vierentachtig natuurbeheertypen, de vijftien
	// landbouwtypen en de eenenvijftig LGN-klassen, en elke cel draagt er precies een van. De vraag naar arealen per
	// beheertype en per LGN-klasse wordt daarmee een tabel over een klassenset die per constructie optelt tot het
	// oppervlak. Split je hem alsnog naar twee klassensets, dan ontstaat er een gat tussen de natuurkolom en de
	// beheertypensom dat je met een derde tabel moet uitleggen: 2.461 ha cellen met een beheertype die de kaart natuur
	// noch water noemt (riet, moerasbos en natuurlijk beheerd grasland, LGN 42, 43 en 45) en 73 ha natuur zonder
	// beheertype, gemeten 8 september 2026. In deze tabel zijn dat gewoon rijen.
	//
	// Let er wel op dat dit de STAND is en de tabel hierboven de KAART. Die twee trekken de grens tussen natuur en
	// landbouw net anders: op de stand telt een cel met een beheertype als natuur, op de kaart beslist de
	// landgebruiksklasse. Landelijk scheelt dat 2.388 ha, precies de twee posten hierboven tegen elkaar weggestreept.
	//
	// De definitie van natuur verschilt bovendien tussen de partijen. Team effectbepaling telt N01 tot en met N04 niet
	// als natuur, en schor en kwelder (N09) wel. Dit model telt als natuur wat geen open water is, en dat sluit N01.01
	// zee en wad, N02.01 rivier, N03.01 beek en bron en de vier N04-typen al uit. Het verschil tussen de twee definities
	// is daarmee precies drie typen: N01.02 duin- en kwelderlandschap, N01.03 rivier- en moeraslandschap en N01.04 zand-
	// en kalklandschap, die hier land zijn. De kolom telt_mee_extern markeert de rijen die aan hun kant meetellen, zodat
	// beide partijen hun eigen totaal uit dezelfde tabel halen.
	//
	// Tabel_PerLGN staat er los naast en beantwoordt een andere vraag: niet wat er in 2120 ligt, maar welke bedekking
	// van het basisjaar wordt omgezet. LGN bestaat alleen voor het basisjaar, dus die tabel leest als herkomst.
	//
	// Draai Tabel_PerLandgebruikType, en Tabel_PerLGN als de herkomstvraag ook speelt.
	// -------------------------------------------------------------------------------------------------------------------

	template AggrLGT_T
	: using = "Units;Geography"
	, Descr = "Aggregeert een landgebruikskaart naar hectares per LandgebruikType, voor elk van de zes rapportagegebieden. De volgorde van de zes items volgt Gebieden/name, want de tabel zet ze met union_data achter elkaar."
	{
		attribute</Classifications/Grondgebruik/LandgebruikType> Kaart (AdminDomain);

		attribute<float64> v_Nederland      (/Classifications/Grondgebruik/LandgebruikType) := sum(float64(float32(/Diagnose/PerIssue/Diagnose786/Maskers/Nederland)      * /Diagnose/PerIssue/Diagnose786/CelHa), Kaart);
		attribute<float64> v_Kust           (/Classifications/Grondgebruik/LandgebruikType) := sum(float64(float32(/Diagnose/PerIssue/Diagnose786/Maskers/Kust)           * /Diagnose/PerIssue/Diagnose786/CelHa), Kaart);
		attribute<float64> v_Rivieren       (/Classifications/Grondgebruik/LandgebruikType) := sum(float64(float32(/Diagnose/PerIssue/Diagnose786/Maskers/Rivieren)       * /Diagnose/PerIssue/Diagnose786/CelHa), Kaart);
		attribute<float64> v_Veen           (/Classifications/Grondgebruik/LandgebruikType) := sum(float64(float32(/Diagnose/PerIssue/Diagnose786/Maskers/Veen)           * /Diagnose/PerIssue/Diagnose786/CelHa), Kaart);
		attribute<float64> v_Zand           (/Classifications/Grondgebruik/LandgebruikType) := sum(float64(float32(/Diagnose/PerIssue/Diagnose786/Maskers/Zand)           * /Diagnose/PerIssue/Diagnose786/CelHa), Kaart);
		attribute<float64> v_Geen_landschap (/Classifications/Grondgebruik/LandgebruikType) := sum(float64(float32(/Diagnose/PerIssue/Diagnose786/Maskers/Geen_landschap) * /Diagnose/PerIssue/Diagnose786/CelHa), Kaart);
	}

	template AggrLGN_T
	: using = "Units;Geography"
	, Descr = "Idem, maar dan naar LGN-klasse en met een vrij te kiezen teller. Waarde is hectares per cel, nul waar de cel niet meetelt; de partitie is altijd de LGN-klasse van het basisjaar."
	{
		attribute<float32> Waarde (AdminDomain);

		attribute<float64> v_Nederland      (/Classifications/Grondgebruik/LGNKlasse) := sum(float64(Waarde * float32(/Diagnose/PerIssue/Diagnose786/Maskers/Nederland)),      /Diagnose/PerIssue/Diagnose786/Kaarten/LGN_Basisjaar);
		attribute<float64> v_Kust           (/Classifications/Grondgebruik/LGNKlasse) := sum(float64(Waarde * float32(/Diagnose/PerIssue/Diagnose786/Maskers/Kust)),           /Diagnose/PerIssue/Diagnose786/Kaarten/LGN_Basisjaar);
		attribute<float64> v_Rivieren       (/Classifications/Grondgebruik/LGNKlasse) := sum(float64(Waarde * float32(/Diagnose/PerIssue/Diagnose786/Maskers/Rivieren)),       /Diagnose/PerIssue/Diagnose786/Kaarten/LGN_Basisjaar);
		attribute<float64> v_Veen           (/Classifications/Grondgebruik/LGNKlasse) := sum(float64(Waarde * float32(/Diagnose/PerIssue/Diagnose786/Maskers/Veen)),           /Diagnose/PerIssue/Diagnose786/Kaarten/LGN_Basisjaar);
		attribute<float64> v_Zand           (/Classifications/Grondgebruik/LGNKlasse) := sum(float64(Waarde * float32(/Diagnose/PerIssue/Diagnose786/Maskers/Zand)),           /Diagnose/PerIssue/Diagnose786/Kaarten/LGN_Basisjaar);
		attribute<float64> v_Geen_landschap (/Classifications/Grondgebruik/LGNKlasse) := sum(float64(Waarde * float32(/Diagnose/PerIssue/Diagnose786/Maskers/Geen_landschap)), /Diagnose/PerIssue/Diagnose786/Kaarten/LGN_Basisjaar);
	}

	container LGT_bas       := AggrLGT_T(Kaarten/LGT_Basisjaar);
	container LGT_2120_BAU  := AggrLGT_T(Kaarten/LGT_2120_BAU);
	container LGT_2120_NbSG := AggrLGT_T(Kaarten/LGT_2120_NbSG);

	container NBP
	: Descr = "Hoeveel van het Natuurbeheerplan onze basiskaart niet als natuur telt, en onder welke LGN-klasse dat zit. Dit is de kern van het verschil met de telling van team effectbepaling: zij gaan van de beheertypenkaart uit, wij laten LGN de categorie bepalen en de beheertypenkaart alleen erbinnen verbijzonderen. Een perceel met een SNL-beheertype dat LGN als agrarisch gras ziet, telt bij ons dus als landbouw."
	{
		attribute<BT>   Type_NBP  (AdminDomain) := /SourceData/Grondgebruik/NBP/INL_Beheertype_AD, Descr = "Het beheertype volgens het Natuurbeheerplan 2026, ONGEMASKEERD; dat is het punt van deze container.";
		attribute<bool> HeeftNBP  (AdminDomain) := IsDefined(Type_NBP);
		attribute<bool> IsNatuurNu(AdminDomain) := MakeDefined(LGT/IsNatuur[Kaarten/LGT_Basisjaar], FALSE), Descr = "Wat onze basiskaart natuur noemt, op de stand-administratie.";
		attribute<bool> IsWaterNu (AdminDomain) := MakeDefined(LGT/IsWater[Kaarten/LGT_Basisjaar],  FALSE);

		attribute<bool> IsGrasklasse (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/LGNKlasse/code[Kaarten/LGN_Basisjaar] == 1w || /Classifications/Grondgebruik/LGNKlasse/code[Kaarten/LGN_Basisjaar] == 47w, FALSE)
		, Descr = "De twee graslandklassen die op 8 september 2026 aan LGN_VerbijzonderMetBeheertype zijn toegevoegd: 1 agrarisch gras en 47 overig gras.";

		parameter<float64> Gras_Natuur_ha     := sum(float64(IsGrasklasse && IsNatuurNu && InSA ? CelHa : 0f)), Descr = "Hoeveel van die twee klassen nu als natuur telt.";
		parameter<float64> Gras_Natuur_NBP_ha := sum(float64(IsGrasklasse && IsNatuurNu && InSA &&  HeeftNBP ? CelHa : 0f)), Descr = "Waarvan het Natuurbeheerplan het type geeft. Dit is het deel dat de verruiming beoogde.";
		parameter<float64> Gras_Natuur_MNP_ha := sum(float64(IsGrasklasse && IsNatuurNu && InSA && !HeeftNBP ? CelHa : 0f)), Descr = "En waarvan niet. Die cellen krijgen hun type van de MNP-planpotentieelkaart, de tweede kaart in Beheertype_Aangevuld. Dat is PLAN en geen huidige natuur, dus dit hoort nul te zijn; is het dat niet, dan lekt het planpotentieel het basisjaar in en moet de verruiming tot de NBP-bron beperkt worden.";

		parameter<string> Tabel_Gras :=
			  'post;ha'
			+ '\ngras_natuur;'     + string(Gras_Natuur_ha)
			+ '\nwaarvan_uit_nbp;' + string(Gras_Natuur_NBP_ha)
			+ '\nwaarvan_uit_mnp;' + string(Gras_Natuur_MNP_ha)
		, StorageName = "='%LocalDataProjDir%/Diagnose/786_grasklassen_bron.txt'", StorageType = "str";
	}

	container LGN_nbp      := AggrLGN_T(float32(NBP/HeeftNBP)                                              * CelHa);
	container LGN_nbp_nat  := AggrLGN_T(float32(NBP/HeeftNBP &&   NBP/IsNatuurNu)                          * CelHa);
	container LGN_nbp_wat  := AggrLGN_T(float32(NBP/HeeftNBP &&   NBP/IsWaterNu)                           * CelHa);
	container LGN_nbp_geen := AggrLGN_T(float32(NBP/HeeftNBP && !(NBP/IsNatuurNu || NBP/IsWaterNu))         * CelHa);

	container LGN_opp      := AggrLGN_T(float32(Vlaggen/Alles)            * CelHa);
	container LGN_nat_bas  := AggrLGN_T(float32(Vlaggen/Natuur_bas_BAU)   * CelHa);
	container LGN_nat_BAU  := AggrLGN_T(float32(Vlaggen/Natuur_2120_BAU)  * CelHa);
	container LGN_nat_NbSG := AggrLGN_T(float32(Vlaggen/Natuur_2120_NbSG) * CelHa);

	attribute<string> NatuurType_code (LGT) := MakeDefined(BT/NatuurType_code[LGT/INL_Beheertype_rel], '')
	, Descr = "De N-hoofdklasse van de rij, leeg voor de landbouwtypen en de LGN-klassen.";

	attribute<bool> TeltMeeExtern (LGT) :=
		LGT/IsNatuur && NatuurType_code != 'N00' && NatuurType_code != 'N01' && NatuurType_code != 'N02' && NatuurType_code != 'N03' && NatuurType_code != 'N04'
	, Descr = "Telt deze klasse mee als natuur in de definitie van team effectbepaling? Daar valt alles met klasse 0,5 en hoger onder, inclusief schor en kwelder (N09); N01 grootschalige natuur, N02 rivieren, N03 beken en bronnen en N04 zoete plas vallen erbuiten. N00 nog om te vormen naar natuur staat hier ook op FALSE. De LGN-natuurklassen zonder beheertype tellen wel mee, want die dragen geen N-code en zijn geen open water.";

	unit<uint32> Tabel_PerLandgebruikType := combine(Gebieden, LGT)
	,	StorageName = "%LocalDataProjDir%/Diagnose/786_arealen_per_landgebruikstype.csv"
	,	StorageType = "gdalwrite.vect"
	,	Descr = "Een regel per gebied maal landgebruikstype. In combine varieert het eerste argument het langzaamst, dus de eerste honderdvijftig regels zijn Nederland; dat is precies de volgorde waarin union_data hieronder de zes gebiedsarrays achter elkaar zet.

				Dit is de hele tabel. LandgebruikType is de unie van de vierentachtig natuurbeheertypen, de vijftien landbouwtypen en de eenenvijftig LGN-klassen, en elke cel draagt er precies een van. De natuurkant is dus de beheertypentabel en de rest is de bedekking, in een klassenset die per constructie optelt tot het oppervlak."
	{
		attribute<string>  gebied            := Gebieden/name[first_rel];
		attribute<string>  klasse            := LGT/name[second_rel];
		attribute<string>  label             := LGT/Label[second_rel];
		attribute<string>  deel              := /Classifications/Grondgebruik/LandgebruikType/Deel/name[LGT/Deel_rel[second_rel]], Descr = "Uit welk van de drie delen van de unie de rij komt: Beheertype, Landbouw of LGN.";
		attribute<string>  natuurtype        := NatuurType_code[second_rel];
		attribute<string>  is_natuur_model   := string(LGT/IsNatuur[second_rel]),  Descr = "Telt deze klasse als natuur in dit model: een terrestrisch beheertype of een LGN-natuurklasse.";
		attribute<string>  is_water_model    := string(LGT/IsWater[second_rel]);
		attribute<string>  is_landbouw_model := string(LGT/IsLandbouw[second_rel]), Descr = "De landbouwtypen, plus de LGN-klassen die een landbouwtype dragen (riet, moerasbos en natuurlijk beheerd grasland waar geen beheertype op ligt).";
		attribute<string>  is_bebouwd_model  := string(LGT/IsBebouwd[second_rel]),  Descr = "De LGN-klassen die bebouwd gebied zijn. LET OP dat dit de stand van het BASISJAAR volgt: verstedelijking in 2120 komt uit de allocatie en zit niet in deze tabel, want die is langs de opleggingsroute gemaakt.";
		attribute<string>  telt_mee_extern   := string(TeltMeeExtern[second_rel]);
		attribute<float64> basisjaar_ha      := union_data(., LGT_bas/v_Nederland,       LGT_bas/v_Kust,       LGT_bas/v_Rivieren,       LGT_bas/v_Veen,       LGT_bas/v_Zand,       LGT_bas/v_Geen_landschap);
		attribute<float64> bau_2120_ha       := union_data(., LGT_2120_BAU/v_Nederland,  LGT_2120_BAU/v_Kust,  LGT_2120_BAU/v_Rivieren,  LGT_2120_BAU/v_Veen,  LGT_2120_BAU/v_Zand,  LGT_2120_BAU/v_Geen_landschap);
		attribute<float64> nbsg_2120_ha      := union_data(., LGT_2120_NbSG/v_Nederland, LGT_2120_NbSG/v_Kust, LGT_2120_NbSG/v_Rivieren, LGT_2120_NbSG/v_Veen, LGT_2120_NbSG/v_Zand, LGT_2120_NbSG/v_Geen_landschap);
	}

	container Aansluiting
	: Descr = "De posten die nodig zijn om de arealen van team effectbepaling en die van dit model naast elkaar te kunnen lezen. Elke regel beantwoordt een vraag die in de vergelijking van 9 september 2026 op tafel lag. Draai Tabel_Aansluiting."
	{
		container LG := /SourceData/Landschap/Landschapsgebieden;

		attribute<string> NT_van_LGT (LGT) := MakeDefined(BT/NatuurType_code[LGT/INL_Beheertype_rel], ''), Descr = "De N-hoofdklasse per rij van de unie, leeg buiten het beheertypedeel.";

		attribute<bool> Bas_IsDuin   (AdminDomain) := MakeDefined(NT_van_LGT[Kaarten/LGT_Basisjaar] == 'N08', FALSE);
		attribute<bool> Bas_IsNatuur (AdminDomain) := MakeDefined(LGT/IsNatuur[Kaarten/LGT_Basisjaar], FALSE);
		attribute<bool> BAU_IsWater  (AdminDomain) := MakeDefined(LGT/IsWater[Kaarten/LGT_2120_BAU],   FALSE);

		parameter<float64> Kust_Buiten_SA  := float64(LG/Kust/Gebied/Areaal     / 1[Ha]) - sum(Maskers/Kust     ? float64(CelHa) : 0d), Descr = "Hoeveel van het kustlandschap buiten het studiegebied valt. Het studiegebied is land: Waddenzee, IJsselmeer, afgesloten zeearmen en de Noordzeekustzone horen er niet bij, en juist daar liggen de slikken en platen die team effectbepaling als natuur telt.";
		parameter<float64> Veen_Buiten_SA  := float64(LG/Veen/Gebied/Areaal     / 1[Ha]) - sum(Maskers/Veen     ? float64(CelHa) : 0d);
		parameter<float64> Zand_Buiten_SA  := float64(LG/Zand/Gebied/Areaal     / 1[Ha]) - sum(Maskers/Zand     ? float64(CelHa) : 0d);
		parameter<float64> Riv_Buiten_SA   := float64(LG/Rivieren/Gebied/Areaal / 1[Ha]) - sum(Maskers/Rivieren ? float64(CelHa) : 0d);

		parameter<float64> Kust_NatuurNaarWater_BAU := sum(Maskers/Kust && Bas_IsNatuur && BAU_IsWater ? float64(CelHa) : 0d), Descr = "Bestaande natuur aan de kust die in BAU een watertype krijgt. Dit is de post achter de afname van open duin die in de vergelijking opviel: de MNP-planpotentieelkaart legt daar een watertype neer, en de categorietoets in Natuur_T/Landelijk laat dat sinds 8 september toe.";
		parameter<float64> Kust_DuinNaarWater_BAU   := sum(Maskers/Kust && Bas_IsDuin   && BAU_IsWater ? float64(CelHa) : 0d), Descr = "Daarvan het deel dat in het basisjaar open duin is (N08).";
		parameter<float64> NL_NatuurNaarWater_BAU   := sum(Maskers/Nederland && Bas_IsNatuur && BAU_IsWater ? float64(CelHa) : 0d);

		attribute<BT> Veen_Water_Sector (AdminDomain) := /VariantData/NbSGenuanceerd/NatuurLevering/Veen_Water_Sector;
		parameter<float64> Veen_WaterNaarSector := sum(Maskers/Veen      && IsDefined(Veen_Water_Sector) ? float64(CelHa) : 0d), Descr = "Het open water van veenbouwsteen 9a en 9b dat NIET in de natuurstroom zit maar naar de sector Waterberging gaat (#664). Team effectbepaling telt dat water in haar NbS-opgave wel als natuur mee, dit model niet.";
		parameter<float64> NL_WaterNaarSector   := sum(Maskers/Nederland && IsDefined(Veen_Water_Sector) ? float64(CelHa) : 0d);

		attribute<BT>     NBP_Type (AdminDomain) := /SourceData/Grondgebruik/NBP/INL_Beheertype_AD, Descr = "Het Natuurbeheerplan ongemaskeerd, dus ook buiten het studiegebied.";
		attribute<string> NBP_NT   (AdminDomain) := MakeDefined(BT/NatuurType_code[NBP_Type], '');

		parameter<float64> NBP_Kwelder_InSA    := sum( InSA && NBP_NT == 'N09' ? float64(CelHa) : 0d), Descr = "Schor en kwelder volgens het Natuurbeheerplan binnen het studiegebied.";
		parameter<float64> NBP_Kwelder_BuitenSA := sum(!InSA && NBP_NT == 'N09' ? float64(CelHa) : 0d), Descr = "En daarbuiten. Dat is de kwelder op de wadrand en in de zeearmen, die team effectbepaling wel meetelt en dit model niet.";
		parameter<float64> NBP_ZeeEnWad_BuitenSA := sum(!InSA && NBP_NT == 'N01' ? float64(CelHa) : 0d), Descr = "En de grootschalige natuur buiten het studiegebied: de Waddenzee zelf met haar slikken en platen.";

		// Waar de levering van NbSGenuanceerd heen gaat. De vraag hierachter: team effectbepaling telt het open water
		// van de veenbouwstenen als natuur en dit model niet, en dan lijkt dat areaal weg. Het is niet weg, het staat
		// onder een andere noemer. Deze regels maken de boekhouding van de levering sluitend.
		attribute<BT>     Lev          (AdminDomain) := /VariantData/NbSGenuanceerd/NatuurLevering/Levering;
		attribute<bool>   Lev_IsWater  (AdminDomain) := /VariantData/NbSGenuanceerd/NatuurLevering/IsWater;
		attribute<LU_MT>  Lev_Landbouw (AdminDomain) := /VariantData/NbSGenuanceerd/NatuurLevering/Landbouw_Levering;

		parameter<float64> Veen_Lev_Natuur    := sum(Maskers/Veen && IsDefined(Lev) && !Lev_IsWater      ? float64(CelHa) : 0d), Descr = "De veenlevering die als natuur in de stroom zit.";
		parameter<float64> Veen_Lev_Water     := sum(Maskers/Veen && IsDefined(Lev) &&  Lev_IsWater      ? float64(CelHa) : 0d), Descr = "En het water dat wel in de natuurstroom zit, dus niet 9a en 9b.";
		parameter<float64> Veen_Lev_Landbouw  := sum(Maskers/Veen && IsDefined(Lev_Landbouw)             ? float64(CelHa) : 0d), Descr = "De landbouwstroom: natte teelt en vernat grasland.";

		parameter<string> Tabel_Aansluiting :=
			  'post;ha'
			+ '\nveen_levering_natuur;'                 + string(Veen_Lev_Natuur)
			+ '\nveen_levering_water_in_natuurstroom;'   + string(Veen_Lev_Water)
			+ '\nveen_levering_landbouw_vernatting;'     + string(Veen_Lev_Landbouw)
			+ '\nkust_landschap_buiten_studiegebied;'   + string(Kust_Buiten_SA)
			+ '\nnbp_kwelder_binnen_studiegebied;'      + string(NBP_Kwelder_InSA)
			+ '\nnbp_kwelder_buiten_studiegebied;'      + string(NBP_Kwelder_BuitenSA)
			+ '\nnbp_n01_buiten_studiegebied;'          + string(NBP_ZeeEnWad_BuitenSA)
			+ '\nveen_landschap_buiten_studiegebied;'   + string(Veen_Buiten_SA)
			+ '\nzand_landschap_buiten_studiegebied;'   + string(Zand_Buiten_SA)
			+ '\nrivieren_landschap_buiten_studiegebied;' + string(Riv_Buiten_SA)
			+ '\nkust_bestaande_natuur_naar_water_bau;' + string(Kust_NatuurNaarWater_BAU)
			+ '\nkust_open_duin_naar_water_bau;'        + string(Kust_DuinNaarWater_BAU)
			+ '\nnl_bestaande_natuur_naar_water_bau;'   + string(NL_NatuurNaarWater_BAU)
			+ '\nveen_9a9b_water_naar_waterberging;'    + string(Veen_WaterNaarSector)
			+ '\nnl_9a9b_water_naar_waterberging;'      + string(NL_WaterNaarSector)
		, StorageName = "='%LocalDataProjDir%/Diagnose/786_aansluiting.txt'", StorageType = "str";
	}

	unit<uint32> Tabel_PerLGN := combine(Gebieden, LGNK)
	,	StorageName = "%LocalDataProjDir%/Diagnose/786_arealen_per_lgn.csv"
	,	StorageType = "gdalwrite.vect"
	,	Descr = "Een regel per gebied maal LGN-klasse. LGN is de bedekking in het basisjaar; de drie natuurkolommen zeggen hoeveel van die klasse in het basisjaar en in 2120 natuur is, dus dit leest als herkomst."
	{
		attribute<string>  gebied              := Gebieden/name[first_rel];
		attribute<string>  lgn_code            := string(LGNK/code[second_rel]);
		attribute<string>  lgn_naam            := LGNK/naam[second_rel];
		attribute<float64> areaal_ha           := union_data(., LGN_opp/v_Nederland,      LGN_opp/v_Kust,      LGN_opp/v_Rivieren,      LGN_opp/v_Veen,      LGN_opp/v_Zand,      LGN_opp/v_Geen_landschap);
		attribute<float64> natuur_basisjaar_ha := union_data(., LGN_nat_bas/v_Nederland,  LGN_nat_bas/v_Kust,  LGN_nat_bas/v_Rivieren,  LGN_nat_bas/v_Veen,  LGN_nat_bas/v_Zand,  LGN_nat_bas/v_Geen_landschap);
		attribute<float64> natuur_2120_bau_ha  := union_data(., LGN_nat_BAU/v_Nederland,  LGN_nat_BAU/v_Kust,  LGN_nat_BAU/v_Rivieren,  LGN_nat_BAU/v_Veen,  LGN_nat_BAU/v_Zand,  LGN_nat_BAU/v_Geen_landschap);
		attribute<float64> natuur_2120_nbsg_ha := union_data(., LGN_nat_NbSG/v_Nederland, LGN_nat_NbSG/v_Kust, LGN_nat_NbSG/v_Rivieren, LGN_nat_NbSG/v_Veen, LGN_nat_NbSG/v_Zand, LGN_nat_NbSG/v_Geen_landschap);
		attribute<float64> nbp_type_ha         := union_data(., LGN_nbp/v_Nederland,      LGN_nbp/v_Kust,      LGN_nbp/v_Rivieren,      LGN_nbp/v_Veen,      LGN_nbp/v_Zand,      LGN_nbp/v_Geen_landschap),      Descr = "Waarvan het Natuurbeheerplan 2026 een beheertype geeft, ongemaskeerd.";
		attribute<float64> nbp_en_natuur_ha    := union_data(., LGN_nbp_nat/v_Nederland,  LGN_nbp_nat/v_Kust,  LGN_nbp_nat/v_Rivieren,  LGN_nbp_nat/v_Veen,  LGN_nbp_nat/v_Zand,  LGN_nbp_nat/v_Geen_landschap),  Descr = "En waarvan onze basiskaart het ook natuur noemt.";
		attribute<float64> nbp_en_water_ha     := union_data(., LGN_nbp_wat/v_Nederland,  LGN_nbp_wat/v_Kust,  LGN_nbp_wat/v_Rivieren,  LGN_nbp_wat/v_Veen,  LGN_nbp_wat/v_Zand,  LGN_nbp_wat/v_Geen_landschap),  Descr = "Idem, maar dan open water.";
		attribute<float64> nbp_geen_natuur_ha  := union_data(., LGN_nbp_geen/v_Nederland, LGN_nbp_geen/v_Kust, LGN_nbp_geen/v_Rivieren, LGN_nbp_geen/v_Veen, LGN_nbp_geen/v_Zand, LGN_nbp_geen/v_Geen_landschap), Descr = "En waarvan onze basiskaart natuur noch water zegt. Dit is het areaal waar de twee tellingen uiteenlopen.";
	}
}
