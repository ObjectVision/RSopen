////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #777, verwijderen zodra de getallen in het issue staan.
//
// #777 legt de arealentabel van team effectbepaling naast de RSopen-keten. Het bestaande comment in dat issue meet die
// keten op codestand 2043d5c0, met ModelParameters/Landgebruik_Basis nog op BBG en de NVK-kaart als beheertypenkaart van
// het basisjaar. Sinds 5 september staat de basis op LGN en is het Natuurbeheerplan 2026 de beheertypenkaart (#776), dus
// die getallen moeten opnieuw.
//
// Twee uitdraaien, allebei voor NbSGenuanceerd; BAU heeft geen landschapsleveringen maar de landelijke
// MNP-planpotentieelkaart en staat daarom alleen als controlegetal in Controle.
//
//   Tabel_NatuurType  de levering per landschap, uitgesplitst naar natuurtype N01 tot en met N17. Dit is de tabel die
//                     regel voor regel naast het tabblad "totaal natuur" van team effectbepaling gelegd kan worden.
//   Tabel_Keten       per levering de stappen van levering naar kaart: ruw, na de voorrangsregel, na aftrek van wat de
//                     kaart in het basisjaar al natuur of water noemde, en na het opleggingsmasker van #641.
//
// De voorrang in Natuur_T is kust, zand nat, veen, rivieren, zand droog; Winnaar hieronder legt die volgorde vast.
//
// LET OP de uitdraaivorm. Een eerste opzet schreef deze tabellen met gdalwrite.vect rechtstreeks naar csv. Dat viel om
// met "Cannot start ValidationAndCommit while doing ValidationAndCommit" op precies de twee kolommen die aan de
// zandallocatie hangen: die allocatie start tijdens het schrijven zelf een commit, en dat mag niet genest. De kolommen
// verdwenen daarbij stil uit de csv terwijl de andere gewoon werden weggeschreven. Vandaar het str-patroon dat de andere
// harnassen ook gebruiken: puntkomma tussen de velden, liggend streepje tussen de regels.
//
// Draai de drie tabelitems.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose777
: using = "Units;Geography"
, Descr = "Tijdelijk meetharnas voor #777: de natuurlevering van NbSGenuanceerd per landschap en per natuurtype, en de keten van levering naar kaart."
{
	container Src := /VariantData/NbSGenuanceerd/NatuurLevering;
	container Opl := /VariantData/NbSGenuanceerd/ExogeenOpleggen;

	unit<uint8> BT := /Classifications/Grondgebruik/INL_Beheertype;
	unit<uint8> NT := /Classifications/Grondgebruik/NatuurType;

	parameter<float32> CelHa            := AdminDomain/NrHaPerCell[float32];
	attribute<bool>    InSA (AdminDomain) := rdc_meter/IsStudyArea_AdminDomain;
	attribute<float32> Opp  (AdminDomain) := float32(InSA) * CelHa, Descr = "Hectares per cel, nul buiten het studiegebied, zodat elke som hieronder vanzelf op het studiegebied snijdt.";

	container Kaart
	: Descr = "De vijf leveringen zoals de landschapsketens ze aanleveren, voor de voorrangsregel. Ze overlappen elkaar, dus de kolommen in Tabel_NatuurType tellen niet op tot de kolom na_voorrang."
	{
		attribute<BT> Kust        (AdminDomain) := Src/Kust/Type;
		attribute<BT> Zand_nat    (AdminDomain) := Src/Zand/Type_Nat;
		attribute<BT> Zand_droog  (AdminDomain) := Src/Zand/Type_Droog;
		attribute<BT> Veen        (AdminDomain) := Src/Veen/Type;
		attribute<BT> Rivieren    (AdminDomain) := Src/Rivieren/Type;
		attribute<BT> Na_voorrang (AdminDomain) := Src/Levering, Descr = "Wat er per cel overblijft nadat de voorrangsregel een van de vijf heeft gekozen.";
	}

	unit<uint8> Herkomst : nrofrows = 5
	, Descr = "Welke levering de cel wint. De volgorde is die van MakeDefined in Natuur_T/Levering."
	{
		attribute<string> name  : ['Kust', 'Zand_nat', 'Veen', 'Rivieren', 'Zand_droog'];
		attribute<string> Label := name;
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	attribute<Herkomst> Winnaar (AdminDomain) :=
		  IsDefined(Kaart/Kust)       ? Herkomst/V/Kust
		: IsDefined(Kaart/Zand_nat)   ? Herkomst/V/Zand_nat
		: IsDefined(Kaart/Veen)       ? Herkomst/V/Veen
		: IsDefined(Kaart/Rivieren)   ? Herkomst/V/Rivieren
		: IsDefined(Kaart/Zand_droog) ? Herkomst/V/Zand_droog
		: null_b[Herkomst];

	container PerNT
	: Descr = "De levering per natuurtype, in hectare binnen het studiegebied."
	{
		attribute<float64> Kust        (NT) := sum(float64(Opp), BT/NatuurType_rel[Kaart/Kust]);
		attribute<float64> Rivieren    (NT) := sum(float64(Opp), BT/NatuurType_rel[Kaart/Rivieren]);
		attribute<float64> Veen        (NT) := sum(float64(Opp), BT/NatuurType_rel[Kaart/Veen]);
		attribute<float64> Zand_nat    (NT) := sum(float64(Opp), BT/NatuurType_rel[Kaart/Zand_nat]);
		attribute<float64> Zand_droog  (NT) := sum(float64(Opp), BT/NatuurType_rel[Kaart/Zand_droog]);
		attribute<float64> Zand        (NT) := Zand_nat + Zand_droog;
		attribute<float64> Na_voorrang (NT) := sum(float64(Opp), BT/NatuurType_rel[Kaart/Na_voorrang]), Descr = "De vijf leveringen samen nadat de voorrangsregel de overlap heeft weggenomen.";
		attribute<float64> Na_masker   (NT) := sum(float64(Opp), BT/NatuurType_rel[Opl/Beheertype_Kaart]), Descr = "Wat er na aftrek van het basisjaar en na het opleggingsmasker van #641 werkelijk op de landgebruikskaart wordt gezet.";
	}

	parameter<String> Tabel_NatuurType :=
		  'code;natuurtype;kust;rivieren;veen;zand_nat;zand_droog;zand;na_voorrang;na_masker|'
		+ AsList(
			  NT/code + ';' + NT/name
			+ ';' + string(PerNT/Kust)
			+ ';' + string(PerNT/Rivieren)
			+ ';' + string(PerNT/Veen)
			+ ';' + string(PerNT/Zand_nat)
			+ ';' + string(PerNT/Zand_droog)
			+ ';' + string(PerNT/Zand)
			+ ';' + string(PerNT/Na_voorrang)
			+ ';' + string(PerNT/Na_masker)
			, '|')
	,	StorageName = "%LocalDataProjDir%/Diagnose/777_levering_per_natuurtype.txt"
	,	StorageType = "str";

	container PerHerkomst
	: Descr = "De keten van levering naar kaart, per levering, in hectare binnen het studiegebied."
	{
		attribute<float64> Ruw (Herkomst) := union_data(Herkomst
			, sum(float64(IsDefined(Kaart/Kust)       ? Opp : 0f))
			, sum(float64(IsDefined(Kaart/Zand_nat)   ? Opp : 0f))
			, sum(float64(IsDefined(Kaart/Veen)       ? Opp : 0f))
			, sum(float64(IsDefined(Kaart/Rivieren)   ? Opp : 0f))
			, sum(float64(IsDefined(Kaart/Zand_droog) ? Opp : 0f))
		), Descr = "De levering zoals aangeleverd. De vijf overlappen elkaar, dus deze kolom telt niet op tot na_voorrang.";

		attribute<float64> Na_voorrang      (Herkomst) := sum(float64(Opp), Winnaar), Descr = "Na de voorrangsregel: elke cel telt nog maar bij een levering.";
		attribute<float64> Na_aftrek_basis  (Herkomst) := sum(float64(Src/IsNieuw_Kaart ? Opp : 0f), Winnaar), Descr = "Na aftrek van wat de landgebruikskaart in het basisjaar al natuur of water noemde. In het veen valt hier niets af, want de bouwstenen beschrijven een eindtoestand (#660).";
		attribute<float64> Na_masker        (Herkomst) := sum(float64(IsDefined(Opl/Beheertype_Kaart) ? Opp : 0f), Winnaar), Descr = "Na het opleggingsmasker: binnen bestaand bebouwd gebied en op exogeen grondgebruik legt het model niets op (#641).";
		attribute<float64> Na_masker_natuur (Herkomst) := sum(float64(IsDefined(Opl/Beheertype_Kaart) && !Src/IsWater ? Opp : 0f), Winnaar), Descr = "Het terrestrische deel daarvan, dus zonder het open water dat de leveringen meebrengen. Dit is de nieuwe natuur op de kaart. Las tot 8 september ExogeenOpleggen/Natuur_BT; dat item is met de controlecontainer van #751 verwijderd, dus de splitsing staat nu hier.";
		attribute<float64> Na_masker_water  (Herkomst) := Na_masker - Na_masker_natuur;
	}

	parameter<String> Tabel_Keten :=
		  'levering;ruw;na_voorrang;na_aftrek_basisjaar;na_masker;na_masker_natuur;na_masker_water|'
		+ AsList(
			  Herkomst/name
			+ ';' + string(PerHerkomst/Ruw)
			+ ';' + string(PerHerkomst/Na_voorrang)
			+ ';' + string(PerHerkomst/Na_aftrek_basis)
			+ ';' + string(PerHerkomst/Na_masker)
			+ ';' + string(PerHerkomst/Na_masker_natuur)
			+ ';' + string(PerHerkomst/Na_masker_water)
			, '|')
	,	StorageName = "%LocalDataProjDir%/Diagnose/777_keten_per_levering.txt"
	,	StorageType = "str";

	container Controle
	: Descr = "Losse controlegetallen naast de twee tabellen."
	{
		parameter<float64> BAU_levering_ha := sum(float64(IsDefined(/VariantData/BAU/NatuurLevering/Levering) ? Opp : 0f))
		, Descr = "De landelijke MNP-planpotentieelkaart die BAU aanlevert, na de categorietoets in Natuur_T/Landelijk.";
		parameter<float64> BAU_natuur_op_kaart_ha := sum(float64(IsDefined(/VariantData/BAU/ExogeenOpleggen/Beheertype_Kaart) && !/VariantData/BAU/NatuurLevering/IsWater ? Opp : 0f));
		parameter<float64> BAU_water_op_kaart_ha  := sum(float64(IsDefined(/VariantData/BAU/ExogeenOpleggen/Beheertype_Kaart) &&  /VariantData/BAU/NatuurLevering/IsWater ? Opp : 0f))
		, Descr = "Nieuw open water dat BAU oplegt. Was tot 8 september 2026 per constructie nul door de tweezijdige categorietoets in Natuur_T/Landelijk; sinds die toets eenzijdig is mag BAU wel nieuw water maken.";
		parameter<float64> NbSG_natuur_op_kaart_ha := sum(float64(IsDefined(Opl/Beheertype_Kaart) && !Src/IsWater ? Opp : 0f));
		parameter<float64> NbSG_water_op_kaart_ha  := sum(float64(IsDefined(Opl/Beheertype_Kaart) &&  Src/IsWater ? Opp : 0f));
		parameter<float64> NbSG_veenwater_sector_ha := sum(float64(IsDefined(Src/Veen_Water_Sector) ? Opp : 0f))
		, Descr = "Het open water van veenbouwsteen 9a en 9b. Dat gaat niet de exogene stroom in maar naar de sector Waterberging (#664), en landt dus niet als natuur op de kaart.";
		parameter<float64> NbSG_landbouwstroom_ha := sum(float64(IsDefined(Src/Landbouw_Levering) ? Opp : 0f))
		, Descr = "Natte teelt en vernat grasland uit de veenbouwstenen (#684). Bij ons landbouw en geen natuur; in de tabel van team effectbepaling staat vernat grasland apart onder de veenkolom.";

		// Drie toetsen op de implementatie zelf, niet op de aansluiting met de tabel.

		attribute<bool> VeenVerliest (AdminDomain) := IsDefined(Kaart/Veen) && Winnaar != Herkomst/V/Veen
		, Descr = "Cel waar de veenlevering iets aanlevert maar de voorrangsregel kust of zand nat kiest.";

		attribute<bool> VeenUitzondering_OpVreemdType (AdminDomain) := VeenVerliest && !Src/IsWater && Src/Kaart_IsNatuur
		, Descr = "Hier bijt het. Natuur_T/IsVeen leest IsDefined(Veen/Type) en niet of veen de voorrangsregel wint, dus de eindtoestandsuitzondering van #660 zet ook op deze cellen de oplegging door over bestaande natuur, terwijl het opgelegde type van kust of zand komt. Zonder die uitzondering zou IsNieuw_Kaart hier FALSE zijn en bleef de bestaande natuur staan.";

		parameter<float64> Veen_verliest_ha         := sum(float64(VeenVerliest ? Opp : 0f));
		parameter<float64> Veen_uitz_vreemdtype_ha  := sum(float64(VeenUitzondering_OpVreemdType ? Opp : 0f));

		parameter<float64> Beheertype_buiten_SA_ha := sum(float64(IsDefined(Opl/Beheertype_Kaart) && !InSA ? CelHa : 0f))
		, Descr = "Beheertype_Kaart draagt het studiegebiedmasker niet, Totaal wel. Zolang elke lezer zelf op SA snijdt maakt dat niets uit; deze twee regels laten zien dat het verschil er wel is.";
		parameter<float64> Totaal_buiten_SA_ha   := sum(float64(IsDefined(Opl/Totaal)    && !InSA ? CelHa : 0f))
		, Descr = "Hoort nul te zijn; Totaal draagt het masker wel.";

		parameter<float64> Veen_uitz_via_kust    := sum(float64(VeenUitzondering_OpVreemdType && IsDefined(Kaart/Kust) ? Opp : 0f));
		parameter<float64> Veen_uitz_via_zandnat := sum(float64(VeenUitzondering_OpVreemdType && !IsDefined(Kaart/Kust) && IsDefined(Kaart/Zand_nat) ? Opp : 0f));

		// De twee basisjaartoetsen naast elkaar. De oplegging toetst op het type in de stand-administratie
		// (Natuur_T/Kaart_IsNatuur valt onder LGN terug op Stand_IsNatuur), de landgebruikskaart bouwt op
		// LU_Basisjaar. Beide staan in /BaseData/StartState/Landgebruik, maar het zijn twee afleidingen.
		attribute<bool> Basis_Natuur_Stand (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/IsNatuur[/BaseData/StartState/Landgebruik/Type], FALSE);
		attribute<bool> Basis_Natuur_LU    (AdminDomain) := MakeDefined(/Classifications/Actor/LU_ModelType/IsNatuur[/BaseData/StartState/Landgebruik/LU_Basisjaar], FALSE);
		parameter<float64> Basis_alleen_stand_ha := sum(float64(Basis_Natuur_Stand && !Basis_Natuur_LU ? Opp : 0f));
		parameter<float64> Basis_alleen_lu_ha    := sum(float64(!Basis_Natuur_Stand && Basis_Natuur_LU ? Opp : 0f));

		parameter<String> Tabel :=
			  'post;ha'
			+ '|bau_levering;'            + string(BAU_levering_ha)
			+ '|bau_natuur_op_kaart;'     + string(BAU_natuur_op_kaart_ha)
			+ '|bau_water_op_kaart;'      + string(BAU_water_op_kaart_ha)
			+ '|nbsg_natuur_op_kaart;'    + string(NbSG_natuur_op_kaart_ha)
			+ '|nbsg_water_op_kaart;'     + string(NbSG_water_op_kaart_ha)
			+ '|nbsg_veenwater_sector;'   + string(NbSG_veenwater_sector_ha)
			+ '|nbsg_landbouwstroom;'     + string(NbSG_landbouwstroom_ha)
			+ '|veen_verliest_voorrang;'  + string(Veen_verliest_ha)
			+ '|veen_uitz_op_vreemd_type;'+ string(Veen_uitz_vreemdtype_ha)
			+ '|beheertype_buiten_sa;'    + string(Beheertype_buiten_SA_ha)
			+ '|totaal_buiten_sa;'        + string(Totaal_buiten_SA_ha)
			+ '|veen_uitz_via_kust;'      + string(Veen_uitz_via_kust)
			+ '|veen_uitz_via_zandnat;'   + string(Veen_uitz_via_zandnat)
			+ '|basisjaar_alleen_stand;'  + string(Basis_alleen_stand_ha)
			+ '|basisjaar_alleen_lu;'     + string(Basis_alleen_lu_ha)
		, StorageName = "%LocalDataProjDir%/Diagnose/777_controle.txt", StorageType = "str";
	}

	container BAU_Landelijk
	: Descr = "Wat de categorietoets in Natuur_T/Landelijk uit de MNP-planpotentieelkaart houdt, en welke kant op. Dit is de vraag of de BAU-waterstroom terecht leeg is."
	{
		container Bron := /VariantData/BAU/NatuurLevering;

		attribute<BT>   Kaart      (AdminDomain) := Bron/Landelijk/Type_Kaart;
		attribute<bool> IsWaterT   (AdminDomain) := MakeDefined(BT/IsWater[Kaart], FALSE);
		attribute<bool> Afgekeurd  (AdminDomain) := IsDefined(Bron/Landelijk/Type_Kaart) && !IsDefined(Bron/Landelijk/Type);

		attribute<bool> WaterOpLand (AdminDomain) := IsDefined(Kaart) &&  IsWaterT && !Bron/Stand_IsWater, Descr = "De kaart wil hier open water op een cel die de stand als land kent: beekherstel en nieuwe plassen. Tot 8 september 2026 keurde de toets dit af en was de waterstroom van BAU daardoor per constructie leeg; sindsdien komt het erdoor. Bewust op de rauwe kaart en niet op Afgekeurd, zodat deze maat na die wijziging nog steeds de omvang toont.";
		attribute<bool> LandOpWater (AdminDomain) := IsDefined(Kaart) && !IsWaterT &&  Bron/Stand_IsWater, Descr = "De kaart wil hier een terrestrisch beheertype op bestaand open water: een reservaatvlak dat over een plas of over de Waddenzee is getekend. Dit is wat de toets tegenhoudt, en het hoort gelijk te zijn aan Afgekeurd_ha.";

		parameter<float64> Kaart_ha       := sum(float64(IsDefined(Kaart) ? Opp : 0f));
		parameter<float64> Afgekeurd_ha   := sum(float64(Afgekeurd ? Opp : 0f));
		parameter<float64> WaterOpLand_ha := sum(float64(WaterOpLand ? Opp : 0f));
		parameter<float64> LandOpWater_ha := sum(float64(LandOpWater ? Opp : 0f));

		attribute<float64> WaterOpLand_perNT (NT) := sum(float64(WaterOpLand ? Opp : 0f), BT/NatuurType_rel[Kaart]);
		attribute<float64> LandOpWater_perNT (NT) := sum(float64(LandOpWater ? Opp : 0f), BT/NatuurType_rel[Kaart]);

		parameter<String> Tabel :=
			  'post;ha'
			+ '|kaart_totaal;'  + string(Kaart_ha)
			+ '|afgekeurd;'     + string(Afgekeurd_ha)
			+ '|water_op_land;' + string(WaterOpLand_ha)
			+ '|land_op_water;' + string(LandOpWater_ha)
			+ '||natuurtype;water_op_land;land_op_water|'
			+ AsList(NT/code + ' ' + NT/name + ';' + string(WaterOpLand_perNT) + ';' + string(LandOpWater_perNT), '|')
		, StorageName = "%LocalDataProjDir%/Diagnose/777_bau_categorietoets.txt", StorageType = "str";
	}
}
