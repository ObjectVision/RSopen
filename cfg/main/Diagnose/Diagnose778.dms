////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #778, verwijderen zodra de getallen in het issue staan.
//
// De vraag komt uit #758: schrijf de verschillende bronnen en typen oxidatie los weg plus een totaal, en let erop
// dat ze niet dubbeltellen. Die uitsplitsing staat sinds deze ronde in de indicator zelf, als
// Zichtjaar/Carbon/Herkomst en Zichtjaar/CO2/PerBron. Dit harnas leest die containers uit en zet de posten van twee
// varianten naast elkaar, zodat de getallen in het issue kunnen zonder de hele exporttabel te trekken; die tabel
// trekt elke indicator die erin staat en kost daarmee een veelvoud.
//
// Wat het meet, per variant, in Mton CO2 over de periode van het gekozen zichtjaar:
//   - de vijf posten die samen het saldo van die periode zijn: vastlegging, afboeking bij een bodemingreep, en de
//     verwerkte veenoxidatie uit SOMERS, uit de emissiefactor en uit het kental van team Veen;
//   - hun som, naast het saldo dat de indicator zelf rapporteert, als sluitcontrole;
//   - de ongedekte oxidatie per bron, die er nadrukkelijk NIET bij opgeteld hoort te worden (#733);
//   - het areaal per bron, zodat een post van nul te onderscheiden is van een post die nergens landt.
//
// Twee varianten en niet vier. BAU2 leent de stand van BAU, en NbSMax volgt dezelfde tak als NbSGenuanceerd; de twee
// hier zijn de twee takken van VeenKentalGeldt, en dat is de schakelaar waarop de uitsplitsing vertakt.
//
// De sluitcontrole zit ook als IntegrityCheck op Herkomst/Totaal_ha, dus een gefaalde toets geeft exit 1 zonder dit
// harnas. Dit harnas is er voor de waarden, niet voor de toets.
//
// Draai het item Tabel.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose778
: Descr = "Tijdelijk meetharnas voor #778: het koolstofsaldo per veroorzakende post, per variant, met de sluitcontrole erbij."
{
	parameter<String> Jaar_str := 'Y2040'
	, Descr = "Het zichtjaar waarover gemeten wordt. Op het eerste allocatiezichtjaar wijst PrevZichtjaar naar het basisjaar en is de keten kort; een later zichtjaar trekt alle voorgaande zichtjaren mee en daarmee ook hun schrijfstappen.";

	unit<uint32> VariantK : NrOfRows = 2
	{
		attribute<String> Casus : ['WLO_hoog_BAU', 'WLO_hoog_NbSGenuanceerd'];
		attribute<String> Kort  : ['BAU', 'NbSGenuanceerd'];
	}

	container Meting := for_each_ne(VariantK/Kort, 'Per_T(' + quote(VariantK/Casus) + ')');

	Template Per_T
	{
		parameter<String> Casus_str;

		container H  := = '/Indicatoren/' + Casus_str + '/Zichtjaren/' + Jaar_str + '/CarbonStorageSequestration/Zichtjaar/Carbon/Herkomst';
		container CS := = '/Indicatoren/' + Casus_str + '/Zichtjaren/' + Jaar_str + '/CarbonStorageSequestration';

		// Van Mton C naar Mton CO2, en van een metrieke parameter naar een kaal getal zodat string() leesbaar blijft.
		parameter<Float32> Vastlegging         := H/Vastlegging_StGebied         / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Afboeking           := H/Afboeking_StGebied           / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Oxidatie_SOMERS     := H/Oxidatie_SOMERS_StGebied     / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Oxidatie_EF         := H/Oxidatie_EF_StGebied         / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Oxidatie_Veenkental := H/Oxidatie_Veenkental_StGebied / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Totaal              := H/Totaal_StGebied              / 1[/Units/mton] * (44f / 12f);

		parameter<Float32> Ongedekt_SOMERS     := H/Ongedekt_SOMERS_StGebied     / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Ongedekt_EF         := H/Ongedekt_EF_StGebied         / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Ongedekt_Veenkental := H/Ongedekt_Veenkental_StGebied / 1[/Units/mton] * (44f / 12f);

		// De sluitcontrole met eigen ogen: de vijf posten tegen het saldo dat de indicator zelf rapporteert.
		// Over het hele raster en niet gemaskeerd op het studiegebied, net als de StGebied-parameters hierboven; de
		// exportkolommen dragen dat masker wel. Op een landelijke run valt dat samen, op een provincierun niet.
		parameter<Float32> Saldo_Indicator := sum(CS/Zichtjaar/Carbon/Flow/Result)[/Units/mton] / 1[/Units/mton] * (44f / 12f);
		parameter<Float32> Sluitverschil   := Totaal - Saldo_Indicator;

		parameter<Float32> Ha_SOMERS     := sum(H/DoorSOMERS     ? /Geography/AdminDomain/NrHaPerCell : 0[/Units/ha]) / 1[/Units/ha];
		parameter<Float32> Ha_EF         := sum(H/DoorEF         ? /Geography/AdminDomain/NrHaPerCell : 0[/Units/ha]) / 1[/Units/ha];
		parameter<Float32> Ha_Veenkental := sum(H/DoorVeenkental ? /Geography/AdminDomain/NrHaPerCell : 0[/Units/ha]) / 1[/Units/ha];

		// Bevinding 6 van #778: hoeveel hectare gealloceerde waterberging krijgt sinds deze ronde een waterklasse, en
		// hoeveel daarvan ligt op veenbodem. Die tweede is de hectares waar het methaankental van 10 ton CO2-equivalent
		// per hectare per jaar nu werkelijk gaat boeken; buiten de veenbodem doet de klasse voor methaan niets.
		parameter<Float32> Ha_Waterberging      := sum(CS/Zichtjaar/Grondgebruik/IsWaterberging ? /Geography/AdminDomain/NrHaPerCell : 0[/Units/ha]) / 1[/Units/ha];
		parameter<Float32> Ha_Waterberging_Veen := sum(CS/Zichtjaar/Grondgebruik/IsWaterberging && CS/OpVeenbodem ? /Geography/AdminDomain/NrHaPerCell : 0[/Units/ha]) / 1[/Units/ha];

		parameter<String> Regel :=
			  'vastlegging='         + string(Vastlegging)
			+ ' afboeking='          + string(Afboeking)
			+ ' ox_somers='          + string(Oxidatie_SOMERS)
			+ ' ox_ef='              + string(Oxidatie_EF)
			+ ' ox_veenkental='      + string(Oxidatie_Veenkental)
			+ ' || totaal='          + string(Totaal)
			+ ' saldo_indicator='    + string(Saldo_Indicator)
			+ ' sluitverschil='      + string(Sluitverschil)
			+ ' || ongedekt_somers=' + string(Ongedekt_SOMERS)
			+ ' ongedekt_ef='        + string(Ongedekt_EF)
			+ ' ongedekt_kental='    + string(Ongedekt_Veenkental)
			+ ' || ha_somers='       + string(Ha_SOMERS)
			+ ' ha_ef='              + string(Ha_EF)
			+ ' ha_kental='          + string(Ha_Veenkental)
			+ ' || ha_waterberging=' + string(Ha_Waterberging)
			+ ' waarvan_op_veen='    + string(Ha_Waterberging_Veen);
	}

	parameter<String> Tabel :=
		= quote('zichtjaar ' + Jaar_str + ', in Mton CO2 over de periode van dit zichtjaar, positief is toename van de voorraad')
		+ AsList(' + ' + quote(' || ' + VariantK/Kort + ': ') + ' + Meting/' + VariantK/Kort + '/Regel', '')
	, StorageName = "='%LocalDataProjDir%/Diagnose/meting778_perbron_' + Jaar_str + '.txt'"
	, StorageType = "str"
	, Descr = "De uitsplitsing per variant als een regel per variant. Sluitverschil hoort nul te zijn; staat er iets anders, dan is er een term in de voorraadbalans die niet in de uitsplitsing zit.";
}
