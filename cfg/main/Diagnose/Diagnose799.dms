////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #799, verwijderen zodra de grex-kolommen in een gewone tabelrun zijn meegekomen.
//
// De twee grex-kolommen en de vijf landbouwkolommen van de indicatorentabellen, los van de tabel.
//
// Waarom dit bestaat. Een indicatorentabel is een csv die als geheel wordt geschreven, en elke kolom trekt de hele
// indicatorenketen van het zichtjaar mee. Een paar kolommen toevoegen aan een tabel die er al staat kost daardoor een
// volledige tabelrun van ruim veertig minuten per variant. Dit harnas rekent dezelfde kolommen uit met precies
// dezelfde expressies als in Templates/Indicatoren_T/Export.dms, per landschap en landsdekkend, en schrijft ze
// als een klein bestand. De waarden zijn dan met een script in de bestaande tabel te zetten; op 11 september 2026
// is dat getoetst tegen een tabel die GeoDMS zelf volledig schreef. De landbouwkolommen staan erbij omdat de
// productierun van die dag ze miste (#794) en de nationale tabel van NbSGenuanceerd daarna niet meer heel is
// overgeschreven.
//
// Een instantie per casus, zichtjaar Y2120 vast: dat is het zichtjaar van de tabellen in de levering. Draai per casus
// het item <casus>/Alles; meerdere casussen kunnen in een aanroep, en dat is ook de bedoeling: elke aanroep die een
// tabel of dit harnas schrijft rekent na de eerste csv de WP5-pandtypering opnieuw uit en wacht dan 34 minuten op een
// schrijfhandle op de mmd (zie #799), en dat gebeurt per proces maar een keer.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose799
: using = "Units;Geography"
, Descr = "Tijdelijk meetharnas voor #799: de kolommen Grondexploitatie_Saldo en Grondexploitatie_Saldo_perHa, en de vijf landbouwkolommen van #794, per landschap en landsdekkend, buiten de tabel om. Een instantie per casus."
{
	container BAU              := T_799('WLO_hoog_BAU');
	container BAU2             := T_799('WLO_hoog_BAU2');
	container NbSGenuanceerd   := T_799('WLO_hoog_NbSGenuanceerd');
	container NbSGenuanceerder := T_799('WLO_hoog_NbSGenuanceerder');
}

template T_799
: using = "Units;Geography"
{
	parameter<String> Casus;
	parameter<String> Pad   := '/Indicatoren/' + Casus + '/Zichtjaren/Y2120/Grondexploitatie/';
	parameter<String> PadL  := '/Indicatoren/' + Casus + '/Zichtjaren/Export/Impl/', Descr = "De landbouwbron van de tabel; Export/Impl staat op ExportZichtjaar, dus draai dit met ExportZichtjaar op Y2120.";

	unit<uint32> Regio := /SourceData/Landschap/LandschapsRegio;

	unit<uint32> PerLandschap := Regio
	, StorageName = "='%LocalDataProjDir%/Diagnose/Grex799_' + Casus + '_Landschap.csv'"
	, StorageType = "gdalwrite.vect"
	, Descr = "Dezelfde regels en dezelfde expressies als de kolommen in Tabellen/PerIndeling/Tabel op de landschapsindeling."
	{
		attribute<String> Regio_name                   := Regio/name;
		attribute<Eur>    Grondexploitatie_Saldo       := ='sum(' + Pad + 'Saldo, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur_ha> Grondexploitatie_Saldo_perHa := ='sum(' + Pad + 'Saldo, Regio/Per_AdminDomain_Fijn) / sum(' + Pad + 'Nieuwbouw_Ha, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>    Landbouw_NettoOpbrengst       := ='sum(' + PadL + 'Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur_ha> Landbouw_NettoOpbrengst_perHa := ='sum(' + PadL + 'Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal, Regio/Per_AdminDomain_Fijn) / sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>    Landbouw_NPV                  := ='sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Totaal, Regio/Per_AdminDomain_Fijn)';
		attribute<Ha>     Landbouw_Areaal               := ='sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur_ha> Landbouw_NPV_perHa            := ='sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Totaal, Regio/Per_AdminDomain_Fijn) / sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, Regio/Per_AdminDomain_Fijn)';
	}

	unit<uint32> NL := /SourceData/RegioIndelingen/NL
	, StorageName = "='%LocalDataProjDir%/Diagnose/Grex799_' + Casus + '_NL.csv'"
	, StorageType = "gdalwrite.vect"
	, Descr = "Dezelfde twee kolommen zoals Tabellen/PerNederland/Tabel ze rekent: ook daar sommeren deze kolommen zelf over Regio/Per_AdminDomain_Fijn, dus op de NL-indeling."
	{
		attribute<String> Regio_name                   := NL/name;
		attribute<Eur>    Grondexploitatie_Saldo       := ='sum(' + Pad + 'Saldo, NL/Per_AdminDomain_Fijn)';
		attribute<Eur_ha> Grondexploitatie_Saldo_perHa := ='sum(' + Pad + 'Saldo, NL/Per_AdminDomain_Fijn) / sum(' + Pad + 'Nieuwbouw_Ha, NL/Per_AdminDomain_Fijn)';
		attribute<Eur>    Landbouw_NettoOpbrengst       := ='sum(' + PadL + 'Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal, NL/Per_AdminDomain_Fijn)';
		attribute<Eur_ha> Landbouw_NettoOpbrengst_perHa := ='sum(' + PadL + 'Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal, NL/Per_AdminDomain_Fijn) / sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, NL/Per_AdminDomain_Fijn)';
		attribute<Eur>    Landbouw_NPV                  := ='sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Totaal, NL/Per_AdminDomain_Fijn)';
		attribute<Ha>     Landbouw_Areaal               := ='sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, NL/Per_AdminDomain_Fijn)';
		attribute<Eur_ha> Landbouw_NPV_perHa            := ='sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Totaal, NL/Per_AdminDomain_Fijn) / sum(' + PadL + 'Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, NL/Per_AdminDomain_Fijn)';
	}

	parameter<String> Alles := 'Ready', ExplicitSuppliers = "PerLandschap;NL";
}
