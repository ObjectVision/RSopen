////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #202 en #258, verwijderen zodra de getallen in de issues staan.
//
// #202 vraagt om transitiekosten VANAF een systeem naast de investering NAARTOE. Dit harnas legt vier dingen vast,
// zodat de matrix voor en na de herbouw naast elkaar te leggen is:
//
//   1. De matrix zelf, als leesbare tabel: per herkomst een regel met het bedrag naar elke bestemming, plus de rij
//      Overigen. Leest /ModelParameters/Landbouw/Transitiekosten (herkomst in rijen, bestemming in kolommen) en de
//      parameters Transitiekosten_src/Overigen__<klasse>. Beide bestaan in de oude en in de nieuwe opzet, dus deze
//      tabel is voor en na te draaien.
//   2. Hetzelfde gedeeld door de kapitalisatiefactor van de boervariant: het SALDOVERSCHIL per ha per jaar dat een
//      omschakeling minstens moet opleveren voordat zij loont. Dat is de maat waarop een transitiekostenmatrix te
//      beoordelen is, en niet het bedrag zelf.
//   3. Per klasse de gemiddelde netto-opbrengst, de gemiddelde transitiekosten en de gemiddelde geschiktheid, ALLEEN
//      op cellen die in het basisjaar landbouw dragen en een bodemcode hebben. Het rastergemiddelde uit @statistics
//      gaat ook over steden en water en is daardoor niet te lezen.
//   4. Voor #258 de gewasparameters van riet en lisdodde naast hun saldo per bodemtak, zodat de bron in het issue
//      tegen het getal in het model te leggen is.
//
// De maat voor landbouwgrond is dezelfde als in Diagnose780: de stand van het basisjaar, de kaart waar ook de claims
// op rusten. De bodemtoets erbij omdat Akkerbouw_T en Dairy_T de netto-opbrengst op cellen zonder bodemcode op nul
// zetten; zonder die toets meet je die nullen mee.
//
// Alle bedragen gaan met een cast naar float32 naar de tekst. Diagnose heeft geen using op de eenheidscontainer, dus
// een eenheidsliteraal geeft hier Unknown identifier, en dat blijkt pas als je het item opvraagt.
//
// Draai de items Tabel_Matrix, Tabel_BreakEven, Tabel_PerKlasse en NatteTeelt/Tabel_NatteTeelt.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose202
: using = "Geography"
, Descr = "Tijdelijk meetharnas voor #202 (transitiekosten vanaf een systeem) en #258 (saldo van de natte teelt). AdminDomain is een alias van rdc_25m, dus de stand en de geschiktheid liggen op hetzelfde domein en er is geen _rel nodig."
{
	parameter<String> Casus_str := 'BAU';
	parameter<String> Jaar_str  := 'Y2040';

	container Suit := ='/VariantData/'+Casus_str+'/Suitability/'+Jaar_str+'/Landbouw';

	// ---------------------------------------------------------------------------------------------------------------
	// 1. De matrix als tabel
	// ---------------------------------------------------------------------------------------------------------------

	parameter<String> Kop := 'herkomst naar ' + AsList(/Classifications/Actor/LandbouwKlasses/name, ' / ')
	, Descr = "De kolomvolgorde van de regels hieronder: de vijftien landbouwklassen in de volgorde van Classifications/Actor/LandbouwKlasses.";

	container Rij :=
		for_each_nedv(
			 /Classifications/Actor/LandbouwKlasses/name
			, replace(
				  quote('@H@: ') + ' + ' + AsList('string(/ModelParameters/Landbouw/Transitiekosten/'+/Classifications/Actor/LandbouwKlasses/name+'[/Classifications/Actor/LandbouwKlasses/V/@H@][float32])', ' + '+quote(' / ')+' + ')
				, '@H@', /Classifications/Actor/LandbouwKlasses/name)
			, void
			, String
		)
	, Descr = "Per herkomst een regel met de transitiekosten in euro per ha naar elk van de vijftien bestemmingen, in de volgorde van Kop.";

	parameter<String> Rij_Overigen :=
		= quote('Overigen: ') + ' + ' + AsList('string(/ModelParameters/Landbouw/Transitiekosten_src/Overigen__'+/Classifications/Actor/LandbouwKlasses/name+'[float32])', ' + '+quote(' / ')+' + ')
	, Descr = "De rij Overigen, die geldt voor een cel zonder landbouwklasse in de herkomstkaart. Zij staat niet in de unit Transitiekosten en komt daarom uit de losse parameters Overigen__<klasse>.";

	parameter<String> Tabel_Matrix :=
		= quote('transitiekosten Eur/ha, ') + ' + Kop + ' + quote(' || ') + ' + ' + AsList('Rij/'+/Classifications/Actor/LandbouwKlasses/name, ' + '+quote(' || ')+' + ') + ' + ' + quote(' || ') + ' + Rij_Overigen'
	, StorageName = "='%LocalDataProjDir%/Diagnose/meting202_matrix.txt'"
	, StorageType = "str"
	, Descr = "De volledige matrix als een regel per herkomst. Bewaar een kopie voordat je de matrix wijzigt, want dit bestand draagt geen tijdstempel in zijn naam.";

	// ---------------------------------------------------------------------------------------------------------------
	// 2. Het break-even saldoverschil
	// ---------------------------------------------------------------------------------------------------------------

	parameter<Float32> Kapitalisatiefactor := Suit/per_LandbouwKlasse/GG_vee/Kapitalisatie/factor[float32]
	, Descr = "De som van de contantewaardefactoren over de afschrijvingsperiode, bij de rentevoet van de boervariant: 11,95 bij 5,5 procent en twintig jaar. Uit het model gelezen en niet overgetypt, zodat deze meting meebeweegt met de boervariant.";

	parameter<Float32> Premie := = '1f + /ModelParameters/Landbouw/ConversionCostPremium_'+/ModelParameters/Landbouw/Boervariant_name
	, Descr = "Een plus de opslag van de boervariant, die Akkerbouw_T en Dairy_T over de matrix heen leggen. Tabel_Matrix toont de kale matrix; het break-even saldoverschil rekent de opslag wel mee, want dat is wat de boer ziet.";

	container Rij_BE :=
		for_each_nedv(
			 /Classifications/Actor/LandbouwKlasses/name
			, replace(
				  quote('@H@: ') + ' + ' + AsList('string(round(/ModelParameters/Landbouw/Transitiekosten/'+/Classifications/Actor/LandbouwKlasses/name+'[/Classifications/Actor/LandbouwKlasses/V/@H@][float32] * Premie / Kapitalisatiefactor))', ' + '+quote(' / ')+' + ')
				, '@H@', /Classifications/Actor/LandbouwKlasses/name)
			, void
			, String
		)
	, Descr = "Per herkomst het saldoverschil per ha per jaar dat de bestemming minstens moet opleveren voordat de omschakeling loont, afgerond op hele euro's.";

	parameter<String> Tabel_BreakEven :=
		= quote('break-even saldoverschil Eur/ha/jaar bij factor ') + ' + string(Kapitalisatiefactor) + ' + quote(' en premie ') + ' + string(Premie) + ' + quote(', ') + ' + Kop + ' + quote(' || ') + ' + ' + AsList('Rij_BE/'+/Classifications/Actor/LandbouwKlasses/name, ' + '+quote(' || ')+' + ')
	, StorageName = "='%LocalDataProjDir%/Diagnose/meting202_breakeven.txt'"
	, StorageType = "str"
	, Descr = "Dezelfde matrix, gedeeld door de kapitalisatiefactor en maal de boervariantopslag. Een omschakeling loont pas als het saldoverschil boven dit getal ligt.";

	// ---------------------------------------------------------------------------------------------------------------
	// 3. Per klasse op landbouwgrond
	// ---------------------------------------------------------------------------------------------------------------

	container Stand := /BaseData/StartState/StateBasisjaar/State/Landbouw;

	attribute<Float32> LandbouwHa (AdminDomain) := ='add('+AsItemList('MakeDefined(float32(Stand/'+/Classifications/Actor/LandbouwKlasses/name+'), 0f)')+')'
	, Descr = "Hectares landbouw per cel in het basisjaar, over alle vijftien klassen opgeteld; dezelfde maat als in Diagnose780.";

	attribute<Bool> IsLbBodem (AdminDomain) := LandbouwHa > 0f && /SourceData/Landbouw/HELP/HeeftBodem
	, Descr = "Landbouw in het basisjaar EN een bodemcode. De bodemtoets hoort erbij omdat beide sjablonen de netto-opbrengst op cellen zonder bodemcode op nul zetten.";

	parameter<Float32> N_lb := sum(float32(IsLbBodem));

	container Mean_NetRevenue :=
		for_each_nedv(
			 /Classifications/Actor/LandbouwKlasses/name
			, 'sum(IsLbBodem ? Suit/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/name+'/NetRevenue[float32] * 10000f : 0f) / N_lb'
			, void
			, Float32
		)
	, Descr = "Gemiddelde netto-opbrengst per klasse in euro per ha per jaar, over de landbouwcellen met bodem. Verandert NIET door een wijziging in de transitiekosten; staat hier als controle dat de meting voor en na op dezelfde economie rust.";

	container Mean_Conversie :=
		for_each_nedv(
			 /Classifications/Actor/LandbouwKlasses/name
			, 'sum(IsLbBodem ? Suit/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/name+'/Economic_performance/Conversion_costs[float32] * 10000f : 0f) / N_lb'
			, void
			, Float32
		)
	, Descr = "Gemiddelde transitiekosten per klasse in euro per ha, over dezelfde cellen, inclusief de opslag van de boervariant. Dit is het getal dat door #202 verandert.";

	container Mean_Suitability :=
		for_each_nedv(
			 /Classifications/Actor/LandbouwKlasses/name
			, 'sum(IsLbBodem ? Suit/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/name+'/Suitability * 10000f : 0f) / N_lb'
			, void
			, Float32
		)
	, Descr = "Gemiddelde geschiktheid per klasse in euro per ha contante waarde, over dezelfde cellen: netto-opbrengst maal de kapitalisatiefactor min de transitiekosten.";

	container Regel :=
		for_each_nedv(
			 /Classifications/Actor/LandbouwKlasses/name
			, quote(/Classifications/Actor/LandbouwKlasses/name)+' + '+quote(': saldo=')+' + string(round(Mean_NetRevenue/'+/Classifications/Actor/LandbouwKlasses/name+')) + '+quote(' transitie=')+' + string(round(Mean_Conversie/'+/Classifications/Actor/LandbouwKlasses/name+')) + '+quote(' suit=')+' + string(round(Mean_Suitability/'+/Classifications/Actor/LandbouwKlasses/name+')) + '+quote(' | ')
			, void
			, String
		);

	parameter<String> Tabel_PerKlasse :=
		= quote('per klasse op landbouwgrond met bodem, Eur/ha (saldo per jaar, transitie eenmalig, suit contant), N=') + ' + string(N_lb) + ' + quote(' cellen || ') + ' + ' + AsList('Regel/'+/Classifications/Actor/LandbouwKlasses/name, ' + ')
	, StorageName = "='%LocalDataProjDir%/Diagnose/meting202_perklasse_'+Casus_str+'_'+Jaar_str+'.txt'"
	, StorageType = "str";

	// ---------------------------------------------------------------------------------------------------------------
	// 4. De natte teelt (#258)
	// ---------------------------------------------------------------------------------------------------------------

	container NatteTeelt
	: Descr = "De gewasparameters van riet en lisdodde naast hun saldo per bodemtak, voor #258. De bodemtak is Classifications/Landbouw/Bodemtak in de volgorde Geen, Klei, Zand, Veen; de kolom Geen is per definitie nul."
	{
		container P := /ModelParameters/Landbouw/per_Gewas/Rietteelt;

		parameter<String> Regel_Riet     := 'riet: opbrengst_ton=' + AsList(string(P/Riet/Opbrengst[float32]), '/') + ' prijs=' + string(P/Riet/Prijs[float32]) + ' geld=' + AsList(string(P/Riet/Geldopbrengst[float32]), '/') + ' toegerekend=' + AsList(string(P/Riet/Toegerekend[float32]), '/');
		parameter<String> Regel_Lisdodde := 'lisdodde: opbrengst_ton=' + AsList(string(P/Lisdodde/Opbrengst[float32]), '/') + ' prijs=' + string(P/Lisdodde/Prijs[float32]) + ' geld=' + AsList(string(P/Lisdodde/Geldopbrengst[float32]), '/') + ' toegerekend=' + AsList(string(P/Lisdodde/Toegerekend[float32]), '/');

		attribute</Classifications/Landbouw/Bodemtak> Tak (AdminDomain) := /SourceData/Landbouw/HELP/Bodemtak_rel;
		attribute<Float32> N_tak   (/Classifications/Landbouw/Bodemtak) := sum(float32(IsLbBodem), Tak);
		attribute<Float32> Mean_NR (/Classifications/Landbouw/Bodemtak) := sum(IsLbBodem ? Suit/per_LandbouwKlasse/Rietteelt/NetRevenue_ha[float32] : 0f, Tak) / N_tak;

		parameter<Float32> N_lisdodde := sum(float32(IsLbBodem && uint8(Suit/per_LandbouwKlasse/Rietteelt/DominantGewas) == 1b))
		, Descr = "Op hoeveel landbouwcellen lisdodde het van riet wint. Rietteelt is de enige klasse met twee gewassen en Akkerbouw_T kiest per cel de beste.";

		parameter<String> Tabel_NatteTeelt := Regel_Riet + ' || ' + Regel_Lisdodde + ' || saldo Rietteelt per bodemtak: ' + AsList(/Classifications/Landbouw/Bodemtak/name + '=' + string(round(MakeDefined(Mean_NR, -1f))), ' / ') + ' || lisdodde wint op ' + string(N_lisdodde) + ' van ' + string(N_lb) + ' cellen'
		, StorageName = "='%LocalDataProjDir%/Diagnose/meting202_natteteelt_'+Casus_str+'_'+Jaar_str+'.txt'"
		, StorageType = "str";
	}
}
