////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #783, verwijderen zodra de getallen in het issue staan.
//
// Meet de twee nieuwe landgebruikskaarten: de dekking (telt alles op tot het studiegebied), het verschil tussen de
// kaart en de stand, en het areaal per klasse voor allebei de indelingen. Draai Tabel_Dekking, Tabel_Detail en
// Tabel_Hoofdklasse. Het zichtjaar komt uit DiagJaar, de casus uit DiagCasus; met DiagJaar op 'Basisjaar' meet je
// zonder allocatie.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose783
: using = "Geography"
, Descr = "Tijdelijk meetharnas voor #783: dekking en areaal per klasse van de detail- en de hoofdklassenkaart."
{
	parameter<String> Casus_783 := replace_value(expand(., '%env:DiagCasus%'), 'env:DiagCasus', 'WLO_hoog_NbSGenuanceerd');
	parameter<String> Jaar_783  := replace_value(expand(., '%env:DiagJaar%'),  'env:DiagJaar',  'Basisjaar')
	, Descr = "Basisjaar of een zichtjaarnaam. Anders dan bij het hoofdharnas is dit een gewone parameter en geen meta-expressie, dus de waarde hoeft geen aanhalingstekens te dragen.";

	parameter<String> Pad := =Jaar_783 == 'Basisjaar'
		? quote('/Indicatoren/' + Casus_783 + '/Basisjaar/LandgebruikskaartNL2120')
		: quote('/Indicatoren/' + Casus_783 + '/Zichtjaren/' + Jaar_783 + '/LandgebruikskaartNL2120')
	, Descr = "Het basisjaar hangt onder Basisjaar en de zichtjaren onder Zichtjaren; de kaart heet in beide gevallen hetzelfde.";

	container K := =Pad;

	parameter<Float32> CelHa := AdminDomain/NrHaPerCell[Float32];

	// ---- dekking ----

	parameter<Float32> ha_studiegebied  := Float32(K/Areaal_Totaal);
	parameter<Float32> ha_sector        := Float32(K/Areaal_Sector);
	parameter<Float32> ha_zonder_type   := Float32(K/Areaal_ZonderType);
	parameter<Float32> ha_zonder_kaart  := Float32(K/Areaal_ZonderKaart);
	parameter<Float32> ha_kaart_detail  := sum(IsDefined(K/Write_Result_SA)             ? CelHa : 0f), Descr = "Wat de detailkaart daadwerkelijk vult. Studiegebied min de cellen zonder type.";
	parameter<Float32> ha_kaart_hoofd   := sum(IsDefined(K/Write_Result_Hoofdklasse_SA) ? CelHa : 0f), Descr = "Wat de hoofdklassenkaart vult. Hoort gelijk te zijn aan het studiegebied, want de cellen zonder type vallen daar op Overig.";
	parameter<Float32> ha_verschil_landbouw := Float32(K/Toets_KaartTegenStand_Landbouw);
	parameter<Float32> ha_verschil_natuur   := Float32(K/Toets_KaartTegenStand_Natuur);

	parameter<String> Tabel_Dekking :=
		  'post;ha'
		+ '|studiegebied;'                + string(ha_studiegebied)
		+ '|sectoren_op_de_kaart;'        + string(ha_sector)
		+ '|kaart_detail_gevuld;'         + string(ha_kaart_detail)
		+ '|kaart_hoofdklasse_gevuld;'    + string(ha_kaart_hoofd)
		+ '|kaart_wel_stand_geen_type;'   + string(ha_zonder_type)
		+ '|buiten_de_landgebruikskaart;' + string(ha_zonder_kaart)
		+ '|kaart_en_stand_oneens_landbouw;' + string(ha_verschil_landbouw)
		+ '|kaart_en_stand_oneens_natuur;'   + string(ha_verschil_natuur)
	, StorageName = "='%LocalDataProjDir%/Diagnose/783_dekking_'+Casus_783+'_'+Jaar_783+'.txt'", StorageType = "str"
	, Descr = "De sluitcontrole. kaart_hoofdklasse_gevuld hoort gelijk te zijn aan studiegebied, en kaart_detail_gevuld daar precies kaart_wel_stand_geen_type onder te liggen.";

	// ---- areaal per klasse ----

	unit<UInt8> Detail := /Classifications/Grondgebruik/LU_NL2120
	{
		attribute<Float32> ha_nl := pcount(TRUE ? K/Write_Result_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_kust := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? K/Write_Result_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_riv := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? K/Write_Result_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_veen := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? K/Write_Result_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_zand := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? K/Write_Result_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_geen := pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? K/Write_Result_SA : null_b)[Float32] * CelHa;
	}

	unit<UInt8> Hoofd := /Classifications/Grondgebruik/LU_Hoofdklasse
	{
		attribute<Float32> ha_nl := pcount(TRUE ? K/Write_Result_Hoofdklasse_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_kust := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? K/Write_Result_Hoofdklasse_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_riv := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? K/Write_Result_Hoofdklasse_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_veen := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? K/Write_Result_Hoofdklasse_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_zand := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? K/Write_Result_Hoofdklasse_SA : null_b)[Float32] * CelHa;
		attribute<Float32> ha_geen := pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? K/Write_Result_Hoofdklasse_SA : null_b)[Float32] * CelHa;
	}

	parameter<String> Kop := 'klasse;Nederland;Kust;Rivieren;Veen;Zand;Geen_landschap';

	parameter<String> Tabel_Detail := Kop + AsList('|' + /Classifications/Grondgebruik/LU_NL2120/Label + ';' + string(Detail/ha_nl) + ';' + string(Detail/ha_kust) + ';' + string(Detail/ha_riv) + ';' + string(Detail/ha_veen) + ';' + string(Detail/ha_zand) + ';' + string(Detail/ha_geen), '')
	, StorageName = "='%LocalDataProjDir%/Diagnose/783_areaal_detail_'+Casus_783+'_'+Jaar_783+'.txt'", StorageType = "str";

	parameter<String> Tabel_Hoofdklasse := Kop + AsList('|' + /Classifications/Grondgebruik/LU_Hoofdklasse/Label + ';' + string(Hoofd/ha_nl) + ';' + string(Hoofd/ha_kust) + ';' + string(Hoofd/ha_riv) + ';' + string(Hoofd/ha_veen) + ';' + string(Hoofd/ha_zand) + ';' + string(Hoofd/ha_geen), '')
	, StorageName = "='%LocalDataProjDir%/Diagnose/783_areaal_hoofdklasse_'+Casus_783+'_'+Jaar_783+'.txt'", StorageType = "str"
	, Descr = "De vier landschappen overlappen elkaar en dekken samen niet heel Nederland, dus de kolommen tellen niet op tot Nederland. Geen_landschap maakt het verschil zichtbaar.";

	// ---- herijking van de verhardingsgrenzen op de huidige basis ----

	attribute<Float32> Verharding_Wonen  (AdminDomain) := K/LU == /Classifications/Actor/LU_ModelType/V/Wonen_Totaal  ? K/Verharding : null_f;
	attribute<Float32> Verharding_Werken (AdminDomain) := K/LU == /Classifications/Actor/LU_ModelType/V/Werken_Totaal ? K/Verharding : null_f;

	unit<UInt8> Grenzen_Wonen  := /Classifications/Grondgebruik/VerhardingK { attribute<Float32> ClassBreaks := ClassifyEqualCount(Verharding_Wonen,  .); }
	unit<UInt8> Grenzen_Werken := /Classifications/Grondgebruik/VerhardingK { attribute<Float32> ClassBreaks := ClassifyEqualCount(Verharding_Werken, .); }

	parameter<String> Tabel_Grenzen :=
		  'sector;g1;g2;g3;g4;g5'
		+ '|wonen;'  + AsList(string(Grenzen_Wonen/ClassBreaks),  ';')
		+ '|werken;' + AsList(string(Grenzen_Werken/ClassBreaks), ';')
	, StorageName = "='%LocalDataProjDir%/Diagnose/783_grenzen_'+Casus_783+'_'+Jaar_783+'.txt'", StorageType = "str"
	, Descr = "Klassegrenzen met gelijke aantallen op de huidige basis, om de hardgecodeerde reeksen in VerhardingK tegenaan te houden. Bart noemde gelijke aantallen als aanvaardbaar alternatief voor jenks.";

	// ---- omvang van het exogeen-schild, voor #781 ----

	unit<UInt8> ExogeenKlassen := /Classifications/Grondgebruik/CBSKlasse
	{
		attribute<Float32> ha := pcount(/Classifications/Grondgebruik/CBSKlasse/IsExogeen[/BaseData/StartState/Landgebruik/gg_CBS] ? /BaseData/StartState/Landgebruik/gg_CBS : null_b)[Float32] * CelHa;
	}

	parameter<Float32> ha_schild_totaal := sum(MakeDefined(/Classifications/Grondgebruik/CBSKlasse/IsExogeen[/BaseData/StartState/Landgebruik/gg_CBS], FALSE) ? CelHa : 0f);

	parameter<String> Tabel_Exogeen :=
		  'klasse;ha'
		+ AsList('|' + /Classifications/Grondgebruik/CBSKlasse/name + ';' + string(ExogeenKlassen/ha), '')
		+ '|TOTAAL;' + string(ha_schild_totaal)
	, StorageName = "='%LocalDataProjDir%/Diagnose/783_exogeenschild.txt'", StorageType = "str"
	, Descr = "Hoeveel hectare het BBG-schild CBSKlasse2020/IsExogeen dekt, per klasse. Voor #781: dit is wat een vervanging op BRT en BGT moet reproduceren.";

	// ---- waar ligt het semi-verharde deel van het schild ----

	attribute<Bool> IsSemiVerhard (AdminDomain) := MakeDefined(
		lowercase(/Classifications/Grondgebruik/CBSKlasse/name[/BaseData/StartState/Landgebruik/gg_CBS]) == lowercase('Semi_verhard_overig_terrein'), FALSE);

	unit<UInt32> SemiPerGemeente := /SourceData/RegioIndelingen/Gemeente
	{
		attribute<Float32> ha := sum(IsSemiVerhard ? CelHa : 0f, /SourceData/RegioIndelingen/Gemeente/Per_AdminDomain_Fijn);
	}

	parameter<String> Tabel_SemiVerhard := 'gemeente;ha'
		+ AsList('|' + /SourceData/RegioIndelingen/Gemeente/name + ';' + string(SemiPerGemeente/ha), '')
	, StorageName = "='%LocalDataProjDir%/Diagnose/783_semiverhard_per_gemeente.txt'", StorageType = "str"
	, Descr = "Waar de 3.893 ha semi-verhard overig terrein van het exogeen-schild ligt. Toets op het vermoeden dat dit vooral de banenzones van de luchthavens zijn (#781).";
}
