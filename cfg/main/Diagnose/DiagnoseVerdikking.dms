////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas bij het doortrekken van de verdikkingsingreep van #668 naar overheid en kwartaire diensten.
// Verwijderen zodra de getallen in het issue staan, samen met de regel in Diagnose.dms/PerIssue.
//
// Meet wat de ingreep aan de aanbodkant doet, zonder te alloceren. Drie vragen:
//   1. Hoe groot is het dominantiemasker, en waar ligt het? Het risico van deze ingreep is dat de vrijstelling op
//      evident benut cellen opent die in werkelijkheid in gebruik zijn. LISA schrijft elke vestiging op haar
//      inschrijfadres, dus zonder ondergrens op de celstand maakt een praktijk aan huis die woning tot een
//      dominante cel. VerdikkingsMinimumStand_Overheid is de rem daarop; deze meting laat zien wat hij doet.
//   2. Hoeveel van die cellen laat de zeef door, voor en na de vrijstelling?
//   3. Hoeveel capaciteit levert de potentieelvloer op, oftewel hoeveel banen kunnen in situ terecht?
//
// Draai het item Tabel. Casus, zichtjaar en tag komen uit omgevingsvariabelen, zodat de uitdraai van de schakelaar
// uit en aan naast elkaar te leggen is:
//   $env:DiagVerdVariant = 'BAU'; $env:DiagVerdJaar = 'Y2040'; $env:DiagVerdTag = 'uit'
//
// Schrijft in %LocalDataProjDir%/Diagnose en hoort dus alleen in een werkkopie met een eigen LocalDataProjDir te
// draaien.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container DiagnoseVerdikking
: using = "Units;Geography;Classifications/Actor"
, Descr = "Tijdelijk meetharnas bij de verdikkingsingreep voor overheid en kwartaire diensten: de omvang en de ligging van het dominantiemasker, wat de zeef ervan doorlaat, en hoeveel capaciteit de potentieelvloer oplevert."
{
	parameter<String> Variant   := replace_value(expand(., '%env:DiagVerdVariant%'), 'env:DiagVerdVariant', 'BAU'), Descr = "Welke variant. Let op dat dit de variantnaam is en niet de casusnaam.";
	parameter<String> Zichtjaar := replace_value(expand(., '%env:DiagVerdJaar%'), 'env:DiagVerdJaar', 'Y2040'), Descr = "Welk zichtjaar van de zeef en de potentiele state.";
	parameter<String> Tag       := replace_value(expand(., '%env:DiagVerdTag%'), 'env:DiagVerdTag', 'uit'), Descr = "Onderscheidt de uitdraai met de schakelaar uit van die met de schakelaar aan.";

	unit<UInt32> Set : NrOfRows = 2
	, Descr = "De twee subsectoren met een verdikkingsingreep. Kantoor staat erbij als ijkpunt: die ingreep bestaat al en zijn getallen horen tussen de twee uitdraaien niet te bewegen."
	{
		attribute<String> Subsector      : ['Overheid_kw_diensten', 'Zak_dienstverlening'];
		attribute<String> DominantiePad  : ['/BaseData/Omgeving/OverheidDominantie/IsOverheidDominant'
		                                  , '/BaseData/Omgeving/KantoorDominantie/IsKantoorDominant'];
		attribute<String> name           := Subsector;
	}

	container PerSubsector := for_each_ne(Set/name, 'Meting_T('+quote(Set/Subsector)+','+quote(Set/DominantiePad)+')');

	Template Meting_T
	{
		parameter<String> Subsector;
		parameter<String> DominantiePad;
		//

		parameter<String> PadZeefBasis  := '/VariantData/'+Variant+'/Zeef/Basisjaar/Werken/'+Subsector;
		parameter<String> PadZeefJaar   := '/VariantData/'+Variant+'/Zeef/'+Zichtjaar+'/SectorxSubsectoren/Werken/'+Subsector;
		parameter<String> PadPotentieel := '/VariantData/'+Variant+'/PotentieleState/'+Zichtjaar+'/Per_SectorxSubsectoren/Werken/'+Subsector;

		attribute<Bool>    Dominant             (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, '+DominantiePad+')', Descr = "Het masker zelf, gelezen bij de bron en niet bij de zeef, zodat het ook meetbaar is met de schakelaar uit.";
		attribute<Float32> Werkstand            (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/KantoorDominantie/WerkBanen)', Descr = "De totale werkstand van de cel in het basisjaar, de grondslag van de vloer.";
		attribute<Bool>    BeschikbaarBasisjaar (CompactedAdminDomain) := = PadZeefBasis+'/IsBeschikbaar';
		attribute<Bool>    BeschikbaarZichtjaar (CompactedAdminDomain) := = PadZeefJaar+'/IsBeschikbaar';
		attribute<Bool>    EvidentBenutBinnen   (CompactedAdminDomain) := = PadZeefBasis+'/Impl/IsEvidentBenutBinnenPlancapaciteit';
		attribute<Bool>    EvidentBenutBuiten   (CompactedAdminDomain) := = PadZeefBasis+'/Impl/IsEvidentBenutBuitenPlancapaciteit';
		attribute<Float32> Potentieel           (CompactedAdminDomain) := = PadPotentieel+'/Potentieel[float32]';
		attribute<Float32> Vloer                (CompactedAdminDomain) := = PadPotentieel+'/Vloer[float32]';
		attribute<Float32> PotentieelMetVloer   (CompactedAdminDomain) := = PadPotentieel+'/PotentieelMetVloer[float32]';

		attribute<Bool>    DominantEnBeschikbaar (CompactedAdminDomain) := Dominant && BeschikbaarZichtjaar;

		attribute<UInt8>   Write_Masker (AdminDomain) := uint8(MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, Dominant), FALSE))
			+ uint8(MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, DominantEnBeschikbaar), FALSE))
		, StorageName = "='%LocalDataProjDir%/Diagnose/verdikking_masker_'+Subsector+'_'+Variant+'_'+Zichtjaar+'_'+Tag+'.tif'"
		, StorageType = "gdalwrite.grid"
		, Descr = "0 = niet dominant, 1 = dominant maar door de zeef tegengehouden, 2 = dominant en beschikbaar. Buiten GeoDMS te kruisen met het bodemgebruik, om te zien of de vrijstelling realistische plekken opent.";

		parameter<Float32> HaPerCel := AdminDomain/NrHaPerCell[float32];

		parameter<String> Regel :=
			  Subsector
			+ ';' + string(sum(uint32(Dominant)))
			+ ';' + string(float32(sum(uint32(Dominant))) * HaPerCel)
			+ ';' + string(sum(Dominant ? Werkstand : 0f))
			+ ';' + string(sum(uint32(Dominant && BeschikbaarBasisjaar)))
			+ ';' + string(sum(uint32(Dominant && BeschikbaarZichtjaar)))
			+ ';' + string(float32(sum(uint32(DominantEnBeschikbaar))) * HaPerCel)
			+ ';' + string(sum(uint32(Dominant && (EvidentBenutBinnen || EvidentBenutBuiten))))
			+ ';' + string(sum(DominantEnBeschikbaar ? Werkstand : 0f))
			+ ';' + string(sum(DominantEnBeschikbaar ? Vloer : 0f))
			+ ';' + string(sum(DominantEnBeschikbaar ? Potentieel : 0f))
			+ ';' + string(sum(DominantEnBeschikbaar ? PotentieelMetVloer : 0f))
			+ ';' + string(sum(DominantEnBeschikbaar ? max_elem(PotentieelMetVloer - Werkstand, 0f) : 0f))
		, Descr = "Een regel voor de tabel. De laatste kolom is de netto capaciteit die de vloer bovenop de bestaande stand zet, en dat is het getal dat zegt hoeveel banen in situ terechtkunnen in plaats van op nieuwe grond.";
	}

	container Kalibratie
	: Descr = "Twee kaarten om buiten GeoDMS de kalibratie van evident benut na te lopen: op welke bodemgebruiksklasse bouwt het model, en ligt dat binnen of buiten de plancapaciteit voor wonen. Bewust de kaart die het model zelf toetst, dus de BBG-jaargang uit ModelParameters/BBG_Year en niet een los modusraster van een ander jaar."
	{
		attribute<UInt8> Write_ggCBS (AdminDomain) := uint8(/BaseData/StartState/Landgebruik/gg_CBS)
		, StorageName = "='%LocalDataProjDir%/Diagnose/kalibratie_ggCBS_'+/ModelParameters/StudyArea+'.tif'"
		, StorageType = "gdalwrite.grid"
		, Descr = "De CBS-bodemgebruiksklasse van het basisjaar zoals de zeef hem leest.";

		parameter<String> Write_Klassen := AsList(/Classifications/Grondgebruik/CBSKlasse/name, ';')
		, StorageName = "='%LocalDataProjDir%/Diagnose/kalibratie_ggCBS_klassen.txt'"
		, StorageType = "str"
		, Descr = "De klassenamen op volgorde van index, zodat de tif zonder gokwerk te lezen is.";

		attribute<UInt8> Write_Plancapaciteit (AdminDomain) :=
			  uint8(/SourceData/Plancapaciteit/Read/Wonen/Hard/Per_AdminDomain)
			+ uint8(/SourceData/Plancapaciteit/Read/Wonen/Zacht/Per_AdminDomain) * 2b
		, StorageName = "='%LocalDataProjDir%/Diagnose/kalibratie_plancapaciteit_wonen_'+/ModelParameters/StudyArea+'.tif'"
		, StorageType = "gdalwrite.grid"
		, Descr = "1 = harde plancapaciteit wonen, 2 = zachte, 3 = beide, 0 = geen.";
	}

	parameter<String> Tabel :=
		  'subsector;cellen_dominant;ha_dominant;banen_dominant;dominant_door_basisjaarzeef;dominant_door_zichtjaarzeef;ha_dominant_beschikbaar;dominant_evident_benut;banen_op_beschikbaar;vloer_som;potentieel_som;potentieel_met_vloer_som;netto_capaciteit
'
		+ PerSubsector/Overheid_kw_diensten/Regel + '
'
		+ PerSubsector/Zak_dienstverlening/Regel
	, StorageName = "='%LocalDataProjDir%/Diagnose/verdikking_'+Variant+'_'+Zichtjaar+'_'+Tag+'.txt'"
	, StorageType = "str"
	, Descr = "Puntkomma-gescheiden, een regel per subsector. Draai hem met de schakelaar uit en aan en leg de twee naast elkaar; de regel van kantoor hoort niet te bewegen.";
}
