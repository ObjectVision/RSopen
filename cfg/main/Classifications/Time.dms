// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Specificeert de container 'Time'.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Time
{
	unit<Int16> TigrisJaar: NrOfRows = 5
	, Descr = "De jaren waarvoor de TIGRIS-levering wordt ingelezen. Naast de vier geleverde zichtjaren staat hier sinds #667 ook het claimbasisjaar 2023.

				Dat basisjaar is nodig om de claim als groei te kunnen uitdrukken in plaats van als niveau. De levering van run 32 begint bij 2021 en dat basisjaar is aantoonbaar LISA 2021: landelijk 9.105.412 tegen 9.101.308 banen, en per TIGRIS-klasse binnen 0,2 procent, bij detailhandel zelfs op 48 banen na. In 2023 lopen de twee uiteen, want TIGRIS staat dan op 9.323.816 en LISA op 9.605.667. Zonder het basisjaar in het model is dat verschil niet te zien en al helemaal niet te corrigeren.

				Het jaartal moet gelijk zijn aan ModelParameters/Model_StartYear, want de stand waar de claim tegen wordt afgezet komt uit datzelfde jaar. De bronbestanden staan in %PrivDataDir%/Claims/TXL_<datum>/<scenario>_LMS/2023."
	{
		attribute<YearRange> Jaar: [2023, 2030, 2040, 2050, 2060];
		attribute<String> name := 'Y' + string(Jaar), DialogType = "LabelText";
		attribute<Bool>   IsClaimBasisjaar := Jaar == ModelParameters/Model_StartYear
		, Descr = "Welke rij het claimbasisjaar is. Precies een rij hoort dat te zijn.";
		
		parameter<UInt32> AantalBasisjaren := sum(uint32(IsClaimBasisjaar))
		, IntegrityCheck = "this == 1"
		, Descr = "Zonder een rij die met Model_StartYear samenvalt kan de claim niet op het basisjaar geankerd worden, en dan valt de indexatie stil terug op het TIGRIS-niveau. De check staat op de telling en niet op de conclusie, zodat hij geen kring maakt.";
	}
	
	
	unit<UInt8> ModelJaar_StartPlusSecond: NrOfRows = 2
	{
		attribute<YearRange> YearRange_rel := union_data(., ModelParameters/Model_StartYear, ModelParameters/Model_FirstZichtjaar);
		attribute<String>    name          := 'Y' + string(YearRange_rel);
	}
	
	parameter<UInt32> NumberOfMiddleModelDecades := (UInt32(ModelParameters/Model_FinalYear) - UInt32(ModelParameters/Model_FirstZichtjaar)) / 10 - 1;
	
	unit<UInt8> ModelJaar_DynamicMiddle := cat_range(0b, uint8(NumberOfMiddleModelDecades))
	{
		attribute<YearRange> YearRange_rel := (UInt32(ModelParameters/Model_FirstZichtjaar) + (uint32(id(.))+1)*10)[YearRange];
		attribute<String>    name          := 'Y' + string(YearRange_rel);
	}
	
	unit<UInt8> ModelJaar_FinalYear := cat_range(0b, 1b)
	{
		attribute<YearRange> YearRange_rel := union_data(., ModelParameters/Model_FinalYear);
		attribute<String>    name          := 'Y' + string(YearRange_rel);
	}
	
	unit<UInt8> ModelJaar := union_unit_uint8(ModelJaar_StartPlusSecond, ModelJaar_DynamicMiddle, ModelJaar_FinalYear)
	{
		attribute<YearRange> YearRange_rel := union_data(., ModelJaar_StartPlusSecond/YearRange_rel, ModelJaar_DynamicMiddle/YearRange_rel, ModelJaar_FinalYear/YearRange_rel);
		attribute<String>    name          := 'Y' + string(YearRange_rel);
		attribute<Bool>      IsFirst       := id(.) == 0b;
		attribute<Bool>      IsLast        := id(.) == last(id(.));
		attribute<String>    PrevName      := IsFirst ? first(name) : name[id(.) - min_elem( id(.), 1b)];
		attribute<YearRange> PrevYear      := rjoin(lowercase(PrevName), lowercase(name), YearRange_rel);
	}
	
	unit<UInt8> Zichtjaar := = ModelParameters/AlleenEindjaar ? 'select_with_org_rel(ModelJaar/IsLast)' : 'select_with_org_rel(not(ModelJaar/IsFirst))'
	{
		attribute<ModelJaar> ModelJaar_rel     := org_rel;
		attribute<YearRange> YearRange_rel     := ModelJaar/YearRange_rel[ModelJaar_rel];
		attribute<YearRange> PrevYearRange_rel := rjoin(lowercase(PrevName), lowercase(ModelJaar/name), ModelJaar/YearRange_rel);
		
		attribute<String> name          := ModelJaar/name[ModelJaar_rel];
		attribute<String> Label         := name, DialogType = "LabelText";
		attribute<String> PrevName_triv := lowercase(PrevName) == lowercase('Y'+string(ModelParameters/Model_StartYear)) ? 'Basisjaar' : PrevName;
		
		attribute<Bool>   IsFirstZichtjaar := id(.) == 0b;
		attribute<String> PrevName   := IsFirstZichtjaar ? first(ModelJaar/name) : name[id(.) - min_elem( id(.), 1b)];
		attribute<String> PrevState  := IsFirstZichtjaar ? 'StartState_metBAGnieuwbouw' : PrevName+'/StateNaAllocatie';
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt8> ClaimJaar := ModelJaar
	, Descr = "De jaren waarvoor de TIGRIS-claims naar de allocatieregio's worden geaggregeerd: alle modeljaren, dus de zichtjaren plus het basisjaar Model_StartYear.

				Dit stond tot #667 op Zichtjaar, waardoor het basisjaar er buiten viel. Zonder dat jaar is de claim alleen als niveau te lezen en niet als groei vanaf een gemeenschappelijk vertrekpunt, en is het niet na te gaan of een verschil tussen stand en claim uit het scenario komt of uit een verschil in vertrekniveau.

				Het kost een extra aggregatieslag per scenario en variant. De uitvoermappen heten naar het jaar, dus er komt een Y-map van het basisjaar naast die van de zichtjaren.";

	unit<UInt32> jaren96_11 := range(uint32, 1996, 2012)
	{
		attribute<String> Label   := name , DialogType = "LabelText";
		attribute<String> name    := 'Y' + string(id(.));
		attribute<UInt32> value   := id(.);
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
}