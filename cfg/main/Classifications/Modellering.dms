	// 	attribute<String> value_Type           := union_data(., Sector/xSubsector/StandVar_valueType, Sector/xSubsectoren/Werken/Subsector/StandVar_PF_valueType, WindK/StandVar_Jaar_valueType, WindK/StandVar_Ashoogte_valueType, WindK/StandVar_Rotordiameter_valueType, WindK/StandVar_MaxWerpafstandNom_valueType, LandgebruikK/StandVar_valueType);
		
