	// 	attribute<String> path                 := union_data(., Sector/xSubsector/StandVar_path     , WindK/StandVar_Jaar_path     , WindK/StandVar_Ashoogte_path     , WindK/StandVar_Rotordiameter_path     , WindK/StandVar_MaxWerpafstandNom_path, LandgebruikK/StandVar_path);
	// 	attribute<String> Sector_name          := union_data(., Sector/xSubsector/Sector_name       , WindK/Sector_name            , WindK/Sector_name                , WindK/Sector_name                     , WindK/Sector_name, LandgebruikK/Sector_name);
	// 	attribute<String> unit_name            := union_data(., Sector/xSubsector/ValUnit_ref       , WindK/StandVar_Jaar_unit     , WindK/StandVar_Ashoogte_unit     , WindK/StandVar_Rotordiameter_unit     , WindK/StandVar_MaxWerpafstandNom_unit, LandgebruikK/StandVar_unit);
	// 	attribute<String> value_Type           := union_data(., Sector/xSubsector/StandVar_valueType, WindK/StandVar_Jaar_valueType, WindK/StandVar_Ashoogte_valueType, WindK/StandVar_Rotordiameter_valueType, WindK/StandVar_MaxWerpafstandNom_valueType, LandgebruikK/StandVar_valueType);
		
	// 	attribute<Bool>   HasClaims            := union_data(., Sector/xSubsector/HasClaims          , const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, LandgebruikK));
	// 	attribute<Bool>   HasAlloc             := union_data(., Sector/xSubsector/HasAlloc           , const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, LandgebruikK));
	// 	attribute<Bool>   IsVastgoed           := union_data(., Sector/xSubsector/IsVastgoed         , const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, LandgebruikK));
	// 	attribute<Bool>   UseForLeegstandCorr  := union_data(., Sector/xSubsector/UseForLeegstandCorr, const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, LandgebruikK));
	// }
	
	unit<UInt8> StandVar_Prep := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector && /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector
										? 'StandVar_Prep_wWerken_wWind' 
										: /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector && NOT(/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector)
											? 'StandVar_Prep_wWerken_woWind'
											: NOT(/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector) && /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector
												? 'StandVar_Prep_woWerken_wWind'
												: 'StandVar_Prep_woWerken_woWind'
	{
		unit<Float32> Woning          := Units/Woning;
		unit<Float32> Job             := Units/Job;
		unit<Float32> meter2          := Units/meter2;
		unit<UInt8>   LandgebruikType := Classifications/Grondgebruik/LandgebruikType;
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		attribute<Bool> DeltaVar_Prep_cond := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'id(.) <> V/jaartal_ingebruikname_Wind && id(.) <> V/Landgebruik_Type && id(.) <> V/Landgebruik_JaarVerandering' : 'id(.) <> V/Landgebruik_Type && id(.) <> V/Landgebruik_JaarVerandering';
		attribute<Bool> IsLandbouw         := lowercase(Sector_name) == lowercase('Landbouw');
		attribute<Bool> IsWaterberging     := lowercase(Sector_name) == lowercase('Waterberging');
	}
	
	unit<UInt8> DeltaVar_Prep := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector 
										? 'select_with_org_rel(id(StandVar_Prep) <> StandVar_Prep/V/jaartal_ingebruikname_Wind && id(StandVar_Prep) <> StandVar_Prep/V/Landgebruik_Type && id(StandVar_Prep) <> StandVar_Prep/V/Landgebruik_JaarVerandering)'
										: 'select_with_org_rel(id(StandVar_Prep) <> StandVar_Prep/V/Landgebruik_Type && id(StandVar_Prep) <> StandVar_Prep/V/Landgebruik_JaarVerandering)'
	{
		attribute<String> name := StandVar_Prep/name[org_rel];
		attribute<String> path := StandVar_Prep/path[org_rel];
		attribute<String> Sector_name := StandVar_Prep/Sector_name[org_rel];
		attribute<String> unit_name := StandVar_Prep/unit_name[org_rel];
		attribute<String> value_Type := StandVar_Prep/value_Type[org_rel];
		
		unit<Float32> Woning          := Units/Woning;
		unit<Float32> Job             := Units/Job;
		unit<Float32> meter2          := Units/meter2;
		unit<UInt8>   LandgebruikType := Classifications/Grondgebruik/LandgebruikType;
	}
	
	unit<UInt32> AllCases := combine(ScenarioK, VariantParameters/VariantK)
	{
		attribute<String> Scenario_name := ScenarioK/name[first_rel];
		attribute<String> Variant_name  := VariantParameters/VariantK/name[second_rel];
		attribute<String> name          := Scenario_name+'/'+Variant_name;
		attribute<String> Label         := Scenario_name+'_'+Variant_name;
		attribute<Bool>   IsBAU         := lowercase(Variant_name) == lowercase('BAU');
		attribute<ScenarioK>                  scenario_rel := first_rel;
		attribute<VariantParameters/VariantK> variant_rel  := second_rel;
		unit<UInt32> NotBAU := select_with_attr_by_cond(., !IsBAU);
	}
	
	unit<UInt8> DomainK: NrOfRows = 2
	{
		attribute<String> name := union_data(., 'AllocDomain', 'AdminDomain');
	}
	
	unit<UInt8> AllocRegiosK: NrOfRows = 6
	{
		attribute<String> name: ['NVM', 'Waterbergingsregio', 'COROP', 'Provincie', 'NL', 'Energy_Regions'];
		attribute<String> Label := name, DialogType = "LabelText";
		attribute<String> ref := name;
		// attribute<String> path_src : ['','CBS/Gekozen/','CBS/Gekozen/',''];
		// attribute<String> path     := 'RegioIndelingen/'+path_src+name;
		attribute<String> path     := 'RegioIndelingen/'+name;
		
		attribute<Bool>   IsTigrisRegio: [TRUE, FALSE, TRUE, TRUE, TRUE, FALSE]
		, Descr = "Wordt deze indeling gebruikt om de TIGRIS-claims voor wonen en werken naar toe te aggregeren? De waterbergingsregio's zijn alleen bedoeld voor de sector Waterberging en de energieregio's alleen voor zon en wind;
					wonen en werken naar die indelingen wegschrijven levert geen bruikbare claims op en kost per scenario, variant en zichtjaar een volledige aggregatieslag.";
		
		unit<UInt8> TigrisRegios := select_with_attr_by_cond(., IsTigrisRegio)
		, Descr = "De AllocRegio's waarvoor PrivData/Claims TIGRIS-aggregaties schrijft, zie IsTigrisRegio.";
		
		attribute<AllocRegiosK> Parent_rel := union_data(AllocRegiosK
		,	V/Provincie 
		,	V/NL 
		,	V/Provincie
		,	V/NL
		,	uint8(0/0)
		,	V/NL
		), Descr = "De waterbergingsregio's en de energieregio's kruisen provinciegrenzen en vallen daarom rechtstreeks onder NL.";
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt8> OrdeningsCriterium: NrOfRows = 2
	{
		attribute<String> name: ['Geschiktheid', 'Dichtheid'];
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt8> ScenarioK: NrOfRows = 1
	{
		// attribute<String> name : ['WLO_laag', 'WLO_hoog'];
		// attribute<String> TableRef : ['laag', 'hoog'];
		// attribute<Bool> IsVoorExport: [FALSE, TRUE];
		// .
		attribute<String> name : ['WLO_hoog'];
		attribute<String> TableRef : ['hoog'];
		attribute<Bool> IsVoorExport: [TRUE];
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt8> VergelijkRegiosK: NrOfRows = 5
	{
		attribute<String> name: ['LMSSubzone', 'Gemeente', 'NVM', 'COROP', 'Provincie'];
		attribute<String> SrcRef:
		[
			'/Geography/RegioIndelingen/LMSSubzone',
			'/Geography/RegioIndelingen/Gemeente',
			'/Geography/RegioIndelingen/NVM',
			'/Geography/RegioIndelingen/COROP',
			'/Geography/RegioIndelingen/Provincie'
		];
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt32> UrbanContourK: NrOfRows = 2
	{
		attribute<String> name: ['BinnenUrbanContour', 'BuitenUrbanContour'];
		attribute<String> Label := name, DialogType = "LabelText";
		container V := for_each_nedv(name, string(id(.)) + '[..]', void, .);
	}
	
	unit<UInt8> DichtheidRegio: NrOfRows = 6
	{
		attribute<String> name: ['Buurt', 'Wijk', 'Gemeente', 'NVM', 'COROP', 'Provincie'];
		attribute<String> SrcRef := 'RegioIndelingen/'+ union_data(., 'Buurt/Src_2019', 'Wijk/Src_2019', 'Gemeente', 'NVM_2011', 'COROP', 'Provincie');
	}
	
	unit<UInt8> HardheidK: NrOfRows = 2
	{
		attribute<String> name: ['Hard', 'Zacht'];
	}
	
	unit<UInt32> HardheidXDomainK := combine(HardheidK, domainK)
	{
		attribute<String> HardheidK_name := HardheidK/name[first_rel];
		attribute<String> domainK_name := domainK/name[second_rel];
		attribute<String> name := HardheidK_name+'/'+domainK_name;
	}
	
