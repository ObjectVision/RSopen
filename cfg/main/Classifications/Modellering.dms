	// 	attribute<Bool>   HasAlloc             := union_data(., Sector/xSubsector/HasAlloc,            Sector/xSubsectoren/Werken/Subsector/HasAlloc_PF           , const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, WindK), const(FALSE, LandgebruikK));
