	unit<uint8> NL2120_Varianten := cat_range(0b, 2b)
	{
		attribute<string> label : ['BAU', 'BAU2'];
	}
	unit<uint8> WWL_BeregeningsK := cat_range(0b, 2b)
	{
		attribute<string> label : ['GeenBeregening', 'WelBeregening'];
		container V := for_each_nedv(label, string(id(.))+'[..]', void, .);
	}
	unit<uint8> WWL_Zichtjaren := cat_range(0b, 3b)
	{
		attribute<string>    name  : ['2017', '2050', '2085'];
		attribute<string>    label := 'Y'+name;
		attribute<YearRange> jaar  := value(name, YearRange);
	}
	unit<uint8> WWL_Klimaatscenarios := cat_range(0b, 2b)
	{
		attribute<string> name  : ['Referentie', 'WarmHoog'];
		attribute<string> periode  : ['1991-2020', '2036-2065'];
		attribute<string> label := name + ' ' + periode;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	
	unit<UInt8> HELP_GewasSoort : NrOfRows = 14
	{	
		unit<Uint32> Elements:= range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text: [ 
			// name                 
			 'Gras_zonder_herinzaai'
			,'Gras_met_herinzaai'   
			,'consumptieaardappelen'
			,'suikerbieten'         
			,'Granen'               
			,'Grove_zomergroenten'  
			,'Wintergroenten'       
			,'Bladgroenten'         
			,'snijmais'             
			,'Bloembollen'          
			,'Groot_fruit'          
			,'Klein_fruit'          
			,'boomteelt'            
			,'Overig_boomteelt'     
			];
		}
		attribute<String>   HELP_Code            := string(id(.)+1b);
		attribute<String>   Label                := HELP_Code + ';' + name, DialogType = "LabelText";
		attribute<String>   name                 := Elements/Text[value(Uint32(id(.))* nrAttr +  0, Elements)];
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
		
		parameter<UInt32> nrAttr := 1;
	}
	
	unit<UInt8> PeilK: NrOfRows = 2
	, Descr = "tbv HELP yield reduction berekening"
	{
		attribute<String> name  : ['GHG','GLG'];
		attribute<String> Label : ['Gemiddeld Hoogste Grondwaterstand','Gemiddeld Laagste Grondwaterstand'], DialogType = "LabelText";
	}

	unit<uint32> WaterschapK: nrofrows = 10
	{
		attribute<String> name: [ 'Friesland', 'HDSR', 'AGV', 'HHNK', 'HHSK', 'Rijnland', 'WSRL', 'WDODELTA', 'HEA' , 'NZV'];
		attribute<String> lhmname: [ '_MIPWA', '_HYDROMEDAH', '', '', '', '', '_MORIA','_MIPWA','_MIPWA', ''];
		attribute<string> label := name;
	
		attribute<String> dir_name               : [ 'WaterschapFriesland', 'HDSR', 'AGV', 'HHNK'                       , 'HHSK'                       , 'Rijnland', 'WSRL', 'WDODELTA', 'HEA', 'NZV'];
		attribute<string> grid_subdir            : ['/v2'                 , ''    , ''   , '/v2'                        , '/v2'                        , '', '' , '', '', ''];
		attribute<string> grid_suffix            : [''                    , ''    , ''   , '_zonder_onderbemalingen_mca', '_zonder_onderbemalingen_mca', '', '' , '', '', ''];
		attribute<string> gdb_Peilgebieden_suffix: ['_vastgesteld'        , ''    , ''   , '_zonder_onderbemalingen'    , '_zonder_onderbemalingen'    , '', '' , '', '', ''];
		attribute<string> gdb_name               : [ 'waterschapfriesland_v6', 'HDSR_v4', 'AGV_v3', 'HHNK_v2', 'HHSK_v4', 'Rijnland_v3', 'WSRL_v3' , 'WDODelta', 'HEA', 'NZV_v2']; 
		
		attribute<string> label_ext: [
			'beheersgebied Waterschap Friesland (WF)',
			'beheersgebied Hoogheemraadschap De Stichtse Rijnlanden (HDSR)',
			'beheersgebied Hoogheemraadschap Amstel, Gooi en Vecht (AGV)',
			'beheersgebied Hoogheemraadschap Hollands Noorderkwartier  (HHNK)',
			'beheersgebied Hoogheemraadschap van Schieland en de Krimpenerwaard  (HHSK)',
			'beheersgebied Hoogheemraadschap van Rijnland',
			'beheersgebied Waterschap Rivierenland (WSRL)',
			'beheersgebied Drents Overijsselse Delta (WDODELTA)',
			'beheersgebied Waterschap Hunze en Aa''s',
			'beheersgebied Waterschap Noorderzijlvest'
		];
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt16> BRPGewasType
	: NrOfRows = 370
	, Descr = "De volledige gewascodelijst van de BRP, en welke code op welke landbouwklasse van het model valt. Zie #751.

				Alle 370 codes die in het gpkg van BRP_Year voorkomen staan erin, ook de codes waar het model niets
				mee doet. Dat is bewust: de kolom LandbouwK laat dan zien wat er niet vertaald wordt, en dat is nu
				juist wat je wilt weten als je je afvraagt waar een gewas blijft. Een lege LandbouwK geeft null in
				LU_ModelType_rel, en die cellen vallen in BaseData/Grondgebruik door naar LGN, precies zoals de
				voedergewassenkaart deed voor de categorieen die zij niet kon plaatsen. Wat daar aan bloembollen,
				boomkwekerij, fruitkwekerij en glastuinbouw doorheen valt komt uiteindelijk in Overig terecht; dat is
				een gat in de klassenindeling van Actor/LandbouwKlasses en niet in deze tabel, en het dichten ervan
				verschuift de nummers van LU_ModelType en daarmee de legenda van elke weggeschreven tif.

				41 van de 370 codes hebben een klasse. De 27 codes met BRP-categorie Landschapselement kunnen er per
				definitie geen krijgen: de SqlString in SourceData/Landbouw filtert die percelen weg voordat er
				gerasterd wordt. Ze staan hier wel, want zonder die rijen lijkt het alsof 7134 Riet in water en 7135
				Riet in een subsidiabele sloot over het hoofd zijn gezien.

				Vier keuzes die niet vanzelf spreken.

				Mais, luzerne, voederbieten, soedangras en maiskolvensilage gaan naar GG_vee en niet naar een eigen
				klasse. Dat is hoe het model voedergewas altijd al behandelde: LGN-klasse 2 mais staat in
				LGNKlasse/LU_ModelType_rel eveneens op een gg_vee-klasse.

				Grasland blijvend en tijdelijk gaan naar GG_vee, natuurlijk grasland en agrarisch natuurmengsel naar
				GG_vee_extensief. GG_vee_intensief blijft leeg: die klasse berustte op melkkoeien per hectare uit de
				landbouwtelling 2014 en de BRP kent geen veedichtheid.

				Rietzwenkgras, de codes 3805, 6782 en 6783, blijft leeg. Dat is een grassoort en geen riet, dus onder
				Rietteelt zou het de rietteeltarealen opblazen. Met de namen in de tabel is dat te zien in plaats van
				alleen hier te lezen.

				Natuurterreinen inclusief heide, code 335, blijft ook leeg, met 30.624 percelen de grootste
				ongekoppelde post. Die cellen bereiken deze tabel alleen waar CBS het terrein agrarisch noemt, en er
				natuur van maken is een uitspraak over de natuurkant die in #774 thuishoort en niet hier."
	{
		unit<Uint32> Elements := range(uint32, 0, nrAttr * #.)
		{
			attribute<String> Text: [
				// code , LandbouwK        , gewas , LandbouwType
				'174' , ''                , 'Bloemzaden open grond', 'Bouwland',
				'233' , 'Granen'          , 'Tarwe, winter-', 'Bouwland',
				'234' , 'Granen'          , 'Tarwe, zomer-', 'Bouwland',
				'235' , 'Granen'          , 'Gerst, winter-', 'Bouwland',
				'236' , 'Granen'          , 'Gerst, zomer-', 'Bouwland',
				'238' , 'Granen'          , 'Haver', 'Bouwland',
				'241' , ''                , 'Kapucijners (en grauwe erwten)', 'Bouwland',
				'242' , ''                , 'Bonen, bruine-', 'Bouwland',
				'244' , ''                , 'Erwten, groene/gele (groen te oogsten)', 'Bouwland',
				'246' , ''                , 'Karwijzaad', 'Bouwland',
				'247' , ''                , 'Blauwmaanzaad', 'Bouwland',
				'256' , 'Bieten'          , 'Bieten, suiker-', 'Bouwland',
				'257' , 'GG_vee'          , 'Bieten, voeder-', 'Bouwland',
				'258' , 'GG_vee'          , 'Luzerne', 'Grasland_tijdelijk',
				'259' , 'GG_vee'          , 'Mais, snij-', 'Mais',
				'263' , ''                , 'Uien, zilver-', 'Bouwland',
				'265' , 'GG_vee'          , 'Grasland, blijvend', 'Grasland_blijvend',
				'266' , 'GG_vee'          , 'Grasland, tijdelijk', 'Grasland_tijdelijk',
				'308' , ''                , 'Erwten (droog te oogsten)', 'Bouwland',
				'311' , ''                , 'Bonen, veld- (onder andere duiven-, paarden-, wierbonen)', 'Bouwland',
				'314' , 'Granen'          , 'Triticale', 'Bouwland',
				'316' , 'GG_vee'          , 'Mais, korrel-', 'Mais',
				'317' , 'GG_vee'          , 'Mais, corncob mix', 'Mais',
				'331' , 'GG_vee_extensief', 'Grasland, natuurlijk. Met landbouwactiviteiten.', 'Grasland_natuurlijk',
				'332' , 'GG_vee_extensief', 'Grasland, natuurlijk. Hoofdfunctie natuur.', 'Grasland_natuurlijk',
				'335' , ''                , 'Natuurterreinen (incl. heide)', '',
				'338' , ''                , 'Rand, liggend op bouwland en direct grenzend aan bos. Geen landbouwproductie.', 'Grasland_natuurlijk',
