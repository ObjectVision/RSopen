//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landbouw : using = "Classifications/Actor"
{
	unit<UInt8> GewasSoortYR : NrOfRows = 15
	, Descr = "De gewassen waarvoor een opbrengstderving wordt berekend, met de landbouwklasse waar zij bij horen en de bron van de derving (WWL_dyn of Exotisch). De kolom bron param wordt door niets gelezen en staat er als documentatie."
	{
		unit<Uint32> Elements:= range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text: [
			// name                     , LandbouwK    , YR bron       , bron param, AantastingdoorVerzilting
			 'Riet'                     ,'Rietteelt'   , 'Exotisch'    , 'Kuhlmann', 'TRUE'  // input WUR
			,'Lisdodde'                 ,'Rietteelt'   , 'Exotisch'    , ''        , 'TRUE'  // input WUR
			,'Aardappelen'              ,'Aardappelen' , 'WWL_dyn'     , 'Diogo'   , 'TRUE'
			,'Bieten'                   ,'Bieten'      , 'WWL_dyn'     , 'Diogo'   , 'FALSE'
			,'Granen'                   ,'Granen'      , 'WWL_dyn'     , 'Diogo'   , 'FALSE'
			,'Rijst'                    ,'Rijst'       , 'Exotisch'    , ''        , 'FALSE' // input WUR
			,'Yacon'                    ,'Yacon'       , 'Exotisch'    , ''        , 'FALSE' // input WUR
			,'Cranberry'                ,'Cranberry'   , 'Exotisch'    , ''        , 'FALSE' // input WUR
			,'Boomgaard'                ,'Boomgaard'   , 'WWL_dyn'     , 'Diogo'   , 'TRUE'  // tree fruit
			,'Moerasbomen'              ,'Moerasbomen' , 'Exotisch'    , ''        , 'FALSE'
			,'Gras'                     ,'gg_vee'      , 'WWL_dyn'     , 'Diogo'   , 'FALSE' // check in expert sessie
			,'Mais'                     ,'gg_vee'      , 'WWL_dyn'     , 'Diogo'   , 'TRUE'
			,'Uien'                     ,'Akkerbouw'   , 'WWL_dyn'     , 'Diogo'   , 'TRUE'  // #751: draagt de restklasse Akkerbouw. Zaai-uien is in dit model al de vertegenwoordiger van overige akkerbouw: LGN-klasse 6, overige Landbouwgewassen, staat in de LGN-tabel op WWL_ID 13 met de aantekening dat die veelal als default overig wordt gebruikt.
			,'Tulpen'                   ,'Bollen'      , 'WWL_dyn'     , 'Diogo'   , 'TRUE'  // Toegevoegd 5 september 2026. De naam moet gelijk zijn aan de GeneriekeNaam van WWL-gewas 20 in Classifications/Grondgebruik/WWLKlasse, want container WWL_dyn wordt over die kolom gegenereerd en Result zoekt WWL_dyn/<naam>.
			,'Laanbomen'                ,'Boomkwekerij', 'WWL_dyn'     , 'Diogo'   , 'TRUE'  // Idem voor WWL-gewas 23. Dat gewas had tot deze datum een lege GeneriekeNaam, waardoor zijn dervingskaart wel werd berekend maar door niemand kon worden opgevraagd.
			];
		}
		attribute<String>          Label                 := name, DialogType = "LabelText";
		attribute<String>          name                  := Elements/Text[value(Uint32(id(.))* nrAttr +  0, Elements)];
		attribute<String>          LandbouwK             := Elements/Text[value(Uint32(id(.))* nrAttr +  1, Elements)];
		attribute<String>          YR_bron               := Elements/Text[value(Uint32(id(.))* nrAttr +  2, Elements)];
		attribute<Bool>            AantastingDoorVerzilt := Elements/Text[value(Uint32(id(.))* nrAttr +  4, Elements)][bool];
		attribute<LandbouwKlasses> LandbouwK_rel         := ='union_data(., '+asItemList(LandbouwK != '' ? 'Actor/LandbouwKlasses/V/'+LandbouwK : 'null_b')+')';
		container                  V                     := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);

		parameter<UInt32> nrAttr := 5;

		container perLandbouwK_domain :=
			for_each_nex(
				Actor/LandbouwKlasses/name
				, 'select_with_attr_by_cond(GewasSoortYR, LandbouwK_rel == Actor/LandbouwKlasses/v/'+Actor/LandbouwKlasses/name+')'
				, uint8
			);
	}

	unit<UInt8> Bodemtak : NrOfRows = 4
	, Descr = "De drie bouwplantakken van Dairy_T en Akkerbouw_T plus Geen voor cellen zonder bodemcode (#780, #785). Klei is BodemKlasse14k K1 tot en met K5; Zand is Z30 tot en met Grind30, dus ook loss
				en Z30 op tertiaire klei, die met zandkentallen rekenen en voor akkerbouw op loss een onderschatting geven; Veen is V_W, veen en moerig, dus het veenweidegebied en de moerige en dalgronden.
				De toewijzing per cel staat in SourceData/Landbouw/HELP/Bodemtak_rel. Geen krijgt geen terugval op een andere tak, want het is een verwaarloosbaar areaal; de geschiktheid zet daar nul."
	{
		attribute<String> Label : ['Geen', 'Klei', 'Zand', 'Veen'];
		attribute<String> name := Label;
		container         V    := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}


	unit<UInt8> BeregeningsScenarioGewassen : NrOfRows = 9, Descr = "tbv Opbrengstdervingskaarten Deltares"
	{
		unit<Uint32> Elements:= range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text: [ 
			// name
			  '1','Gras'
			, '2','Mais'
			, '3','Aardappelen'
			, '4','Bieten'
			, '5','Granen'
			, '6','Overige landbouwgewassen'
			, '7','Boomteelt'
			// , '8','Glastuinbouw'
			, '9','Boomgaard'
			,'10','Bollen'
			];
		}
		attribute<String>   Code                 := Elements/Text[value(Uint32(id(.))* nrAttr +  0, Elements)];
		attribute<String>   name                 := AsItemName(label);
		attribute<String>   Label                := Elements/Text[value(Uint32(id(.))* nrAttr +  1, Elements)];

		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
		
		parameter<UInt32> nrAttr := 2;
	}
	
	unit<UInt8> Exotische_GewasSoort : NrOfRows = 10
	, Descr = "tbv kansenkaarten van WUR"
	{	
		unit<Uint32> Elements:= range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text: [ 
			// name                 
			 'Suikerbieten'
			,'Cranberry'   
			,'Granen'
			,'Gras'         
			,'Lisdodde'               
			,'Moerasbomen'  
			,'Riet'       
			,'Rijst'         
			,'Snijmais'             
			,'Yacon'          
			];
		}
		// attribute<String>   Code                 := string(id(.)+1b);
		attribute<String>   Label                := name, DialogType = "LabelText";
		attribute<String>   name                 := Elements/Text[value(Uint32(id(.))* nrAttr +  0, Elements)];

		attribute<Bool>     IsNatteTeelt         := lowercase(rjoin(lowercase(name), lowercase(GewasSoortYR/name), GewasSoortYR/LandbouwK)) == lowercase('Rietteelt')
		, Descr = "Hoort dit gewas bij de klasse Rietteelt, dus is het riet of lisdodde? Afgeleid uit GewasSoortYR en niet als tweede lijst opgeschreven, zodat een gewas dat daar van klasse wisselt vanzelf meegaat. Gelezen door Templates/Landbouw, container Exotisch, om de opbrengstderving van de natte teelt op nul te kunnen zetten.";

		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
		
		parameter<UInt32> nrAttr := 1;
	}
	
	unit<UInt8> WWL_GewasSoort : NrOfRows = 11
	, Descr = "uit Water Wijzer Landbouw"
	{	
		unit<Uint32> Elements:= range(uint32, 0, nrAttr*#.)
		{
			attribute<String> Text: [ 
			// name                 
			 'Appelbomen'
			,'consumptieaardappelen'   
			,'gras_beweiden'
			,'gras_maai'         
			,'laanbomen'               
			,'snijmais'  
			,'suikerbieten'       
			,'tulp'         
			,'wintertarwe'             
			,'zaaiuien'          
			,'zetmeelaardappelen'          
			];
		}
		// attribute<String>   Code                 := string(id(.)+1b);
		attribute<String>   Label                := name, DialogType = "LabelText";
		attribute<String>   name                 := Elements/Text[value(Uint32(id(.))* nrAttr +  0, Elements)];

		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
		
		parameter<UInt32> nrAttr := 1;
	}

	unit<uint8> NL2120_Varianten := cat_range(0b, 3b)
	, Descr = "De hydrologische leveringen waarover SourceData/Landbouw/Yield_Reduction de opbrengstdervingskaarten maakt. Geen variantenlijst: welke variant welke levering leest staat in
				VariantParameters/VariantK/Hydrologie_Levering, en meer varianten mogen dezelfde levering aanwijzen. BAU en BAU2 zijn de twee leveringen van Deltares (W2050BP18 en R2050BP18 in
				SourceData/Water/Grondwaterstanden); NbSGenuanceerd is de BAU-stand met daaroverheen de grondwaterstand die de veenbouwsteen per cel oplegt (#782)."
	{
		attribute<string> label : ['BAU', 'BAU2', 'NbSGenuanceerd'];
	}
	unit<uint8> WWL_BeregeningsK := cat_range(0b, 2b)
	{
		attribute<string> label : ['GeenBeregening', 'WelBeregening'];
		container V := for_each_nedv(label, string(id(.))+'[..]', void, .);
	}
	unit<uint8> WWL_Zichtjaren := cat_range(0b, 3b)
	{
		attribute<string>    name  : ['2017', '2050', '2085'];
		attribute<string>    label := 'Y'+name;
		attribute<YearRange> jaar  := value(name, YearRange);
	}
	unit<uint8> WWL_Klimaatscenarios := cat_range(0b, 2b)
	{
		attribute<string> name  : ['Referentie', 'WarmHoog'];
		attribute<string> periode  : ['1991-2020', '2036-2065'];
		attribute<string> label := name + ' ' + periode;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	
	unit<UInt8> PeilK: NrOfRows = 2
	, Descr = "tbv HELP yield reduction berekening"
	{
		attribute<String> name  : ['GHG','GLG'];
		attribute<String> Label : ['Gemiddeld Hoogste Grondwaterstand','Gemiddeld Laagste Grondwaterstand'], DialogType = "LabelText";
	}

	unit<uint32> WaterschapK: nrofrows = 10
	{
		attribute<String> name: [ 'Friesland', 'HDSR', 'AGV', 'HHNK', 'HHSK', 'Rijnland', 'WSRL', 'WDODELTA', 'HEA' , 'NZV'];
		attribute<String> lhmname: [ '_MIPWA', '_HYDROMEDAH', '', '', '', '', '_MORIA','_MIPWA','_MIPWA', ''];
		attribute<string> label := name;
	
		attribute<String> dir_name               : [ 'WaterschapFriesland', 'HDSR', 'AGV', 'HHNK'                       , 'HHSK'                       , 'Rijnland', 'WSRL', 'WDODELTA', 'HEA', 'NZV'];
		attribute<string> grid_subdir            : ['/v2'                 , ''    , ''   , '/v2'                        , '/v2'                        , '', '' , '', '', ''];
		attribute<string> grid_suffix            : [''                    , ''    , ''   , '_zonder_onderbemalingen_mca', '_zonder_onderbemalingen_mca', '', '' , '', '', ''];
		attribute<string> gdb_Peilgebieden_suffix: ['_vastgesteld'        , ''    , ''   , '_zonder_onderbemalingen'    , '_zonder_onderbemalingen'    , '', '' , '', '', ''];
		attribute<string> gdb_name               : [ 'waterschapfriesland_v6', 'HDSR_v4', 'AGV_v3', 'HHNK_v2', 'HHSK_v4', 'Rijnland_v3', 'WSRL_v3' , 'WDODelta', 'HEA', 'NZV_v2']; 
		
		attribute<string> label_ext: [
			'beheersgebied Waterschap Friesland (WF)',
			'beheersgebied Hoogheemraadschap De Stichtse Rijnlanden (HDSR)',
			'beheersgebied Hoogheemraadschap Amstel, Gooi en Vecht (AGV)',
			'beheersgebied Hoogheemraadschap Hollands Noorderkwartier  (HHNK)',
			'beheersgebied Hoogheemraadschap van Schieland en de Krimpenerwaard  (HHSK)',
			'beheersgebied Hoogheemraadschap van Rijnland',
			'beheersgebied Waterschap Rivierenland (WSRL)',
			'beheersgebied Drents Overijsselse Delta (WDODELTA)',
			'beheersgebied Waterschap Hunze en Aa''s',
			'beheersgebied Waterschap Noorderzijlvest'
		];
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt16> BRPGewasType
	: NrOfRows = 370
	, Descr = "De volledige gewascodelijst van de BRP en welke code op welke landbouwklasse van het model valt (#751). Alle codes uit het gpkg van BRP_Year staan erin, ook waar het model niets mee doet,
				zodat de kolom LandbouwK laat zien wat niet vertaald wordt; een lege LandbouwK geeft null in LandbouwType_rel en die cellen vallen in BaseData/Grondgebruik door naar LGN. De
				landschapselementen kunnen geen klasse krijgen, want de SqlString in SourceData/Landbouw filtert ze weg voordat er gerasterd wordt. Vier keuzes: mais, luzerne, voederbieten, soedangras en
				maiskolvensilage gaan naar GG_vee, zoals het model voedergewas altijd behandelde; grasland blijvend en tijdelijk naar GG_vee en natuurlijk grasland en agrarisch natuurmengsel naar
				GG_vee_extensief, met GG_vee_intensief leeg omdat de BRP geen veedichtheid kent; rietzwenkgras blijft leeg, want dat is een grassoort en geen riet; en de vollegrondstuinbouw (blok 2700 tot
				en met 2802, aardbeien op stellingen uitgezonderd) gaat naar het LandbouwType Tuinbouw_open zonder LandbouwK, dus alleen de stand-administratie en de kaarten merken dat (#783).
				Natuurterreinen inclusief heide (335) blijft leeg, want daar natuur van maken is een uitspraak over de natuurkant (#774)."
	{
		unit<Uint32> Elements := range(uint32, 0, nrAttr * #.)
		{
			attribute<String> Text: [
				// code , LandbouwK        , gewas , LandbouwType
				'174' , ''                , 'Bloemzaden open grond', 'Bouwland',
				'233' , 'Granen'          , 'Tarwe, winter-', 'Bouwland',
