			,'Yacon'                    ,'Yacon'       , 'Exotisch' , ''        , ''                           , 'FALSE' // input Marc Ravesloot, WUR
			,'Cranberry'                ,'Cranberry'   , 'Exotisch' , ''        , ''                           , 'FALSE' // input Marc Ravesloot, WUR
