	unit<UInt32> DeepDrainageK: NrOfRows = 2
	, Descr = "De twee standen van onderwaterdrainage voor grasland in Dairy_T: zonder en met. Welke stand een variant krijgt volgt uit VariantParameters/VariantK/InfiltratieMaatregelK_ref, zie
				Templates/Landbouw/Suitability_T/DeepDrainageVariant. De twee kentallen zijn een aanname zonder bron, meegekomen met de landbouwgeschiktheid uit PeatyMeadows. Werken alleen op de cellen waar
				SourceData/Landbouw/HELP/DDPossible waar is en alleen op productiegrasland (#780)."
	{
		attribute<String> Label: DialogType = "LabelText", ['NoDD', 'DD'];
		attribute<String> name :=  Label;
		attribute<ton_ha_jaarlijks> DDGrassYield: [0, 0.25], Descr = "Extra grasopbrengst door deep drainage, 250 kg droge stof per ha per jaar. Aanname, geen bron.";
		attribute<Eur_Ha_jaarlijks> DD_costs:     [0, 117], Descr = "Jaarkosten van deep drainage per ha. Aanname, geen bron.";
	
		container V: = for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
