				'7130', 'Granen'          , 'Rogge, korrelgewas', 'Bouwland',
				'7131', 'Granen'          , 'Rogge, groenbemesting, vanggewas', 'Bouwland',
				'7134', ''                , 'Riet in water, anders dan een subsidiabele sloot', '',
				'7135', ''                , 'Riet in een subsidiabele sloot', '',
				'7137', ''                , 'Bonen, overig', 'Bouwland',
				'7138', ''                , 'Palmkool', 'Bouwland'
			];
		}

		attribute<Int32>  code      := Int32(Elements/Text[value(uint32(id(.)) * nrAttr + 0, Elements)])
		, Descr = "De gewascode zoals de BRP hem levert. Int32 en niet uint, want de kolom gewascode komt als MEDIUMINT binnen en GeoDMS leest die als int32; vergelijken met een ander type geeft een operatorfout.";
		attribute<String> LandbouwK := Elements/Text[value(uint32(id(.)) * nrAttr + 1, Elements)];
		attribute<String> gewas     := Elements/Text[value(uint32(id(.)) * nrAttr + 2, Elements)], DialogType = "LabelText"
		, Descr = "De omschrijving zoals de BRP hem in de kolom gewas levert. Draagt niets bij aan de berekening en staat er om de tabel leesbaar te houden en om in de GUI het label te zijn.";
		attribute<String>                                     LandbouwType_name := Elements/Text[value(uint32(id(.)) * nrAttr + 3, Elements)];
		attribute</Classifications/Grondgebruik/LandbouwType> LandbouwType_rel  := rlookup(lowercase(LandbouwType_name), lowercase(/Classifications/Grondgebruik/LandbouwType/name))
		, IntegrityCheck = "all(LandbouwType_name == '' || IsDefined(LandbouwType_rel))"
		, Descr = "Het landbouwtype van de stand-administratie (#751): de gewascode geaggregeerd naar een klasse die op dezelfde plek blijft liggen, zie Classifications/Grondgebruik/LandbouwType. Leeg voor de
				landschapselementen, die de SqlString wegfiltert, en voor 335 Natuurterreinen, 662 Bos onder de SBL-regeling en 1936 Bos blijvend met herplantplicht: die zijn geen landbouw meer en krijgen
				hun type van de natuurkant.";
		attribute<string>                label         := gewas;
		attribute<Actor/LandbouwKlasses> LandbouwK_rel := rlookup(lowercase(LandbouwK), lowercase(Actor/LandbouwKlasses/name))
		, IntegrityCheck = "all(LandbouwK == '' || IsDefined(LandbouwK_rel))"
		, Descr = "Faalt zodra een ingevulde klassenaam hierboven niet meer in Actor/LandbouwKlasses voorkomt. Een lege naam is geen fout maar de normale toestand van de 329 codes die het model niet kan uitdrukken.";


		parameter<UInt32> nrAttr := 4;
	}
	
	unit<UInt8> LandbouwBodemKlasse: NrOfRows = 6
	{
		attribute<UInt8> id: [0,1,2,3,4,5];
		attribute<String> Label: DialogType = "LabelText",
		['dekzandgrond','kleigrond','natveen','zandgrond','zavelgrond','overig (ongeschikt)'];
		attribute<String> name :=  Label;
		attribute <UInt32> Palette: DialogType = "BrushColor",
		[
			rgb(255,255,  0),
			rgb(  0,128,128),
			rgb(128,  0,128),
			rgb(172, 89, 89),
			rgb(255, 94, 94),
			rgb(192,192,192)
		];
		
		parameter<UInt8> dekzandgrond:         = value(0, .);
		parameter<UInt8> kleigrond:            = value(1, .);
		parameter<UInt8> natveen:              = value(2, .);
		parameter<UInt8> zandgrond:            = value(3, .);
		parameter<UInt8> zavelgrond:           = value(4, .);
		parameter<UInt8> overig_ongeschikt:    = value(5, .);
	}
	
	unit<UInt32> BodemkaartKlasse: NrOfRows = 316
	{
		container Src:= Per_uint32('%RS_Lb_DataDir%/Landgebruik/bodemkaart_1_50000_2006.csv', BodemkaartKlasse, ';');
		
		attribute<UInt32> id:            = id(BodemkaartKlasse);
		attribute<String> Label:         = value(Src/Data/bodemcode_veld_eerste_bod, string), DialogType = "LabelText";
		attribute<String> Landbouwnaam :=  value(Src/Data/Landbouwnaam, string);
		attribute<LandbouwBodemKlasse> Landbouwid :=  value(Src/Data/Landbouwid, LandbouwBodemKlasse);
		
		Template Per_uint32
		{
			// Start template Parameters
			parameter<String> Src;
			unit <UInt32>     Unit;
			parameter<String> FieldSeparator;
			// End template Parameters
						
			parameter<String> Filename:    = Src;
			parameter<String> FileData:
				StorageType = "str"
			,	StorageName = "=Filename";
			
			parameter<String> HeaderLine :=  ReadLines(FileData, void, 0);
			parameter<Bool>   HeaderOK:    = regex_match(HeaderLine, '\"[^\"]*+\"(;\"[^\"]*+\")*+');
			
			unit<Uint32> Field :=  Range(Uint32, 0, strcount(HeaderLine, FieldSeparator)+1)
			{
				attribute<String> name :=  ReadArray(HeaderLine, Field, string, 0);
			}
			attribute<String> BodyLines(Unit) :=  ReadLines(FileData, Unit, HeaderLine/ReadPos); //, IntegrityCheck = "HeaderOK";
			attribute<Bool> LinesAreSignedIntegerstringOrEmpy (Unit) :=  regex_match(BodyLines, '(-?+[0-9]++|\"[^\"]*+\")?+(;(-?+[0-9]++|\"[^\"]*+\")?+)*+');
			
			container Data := 
				for_each_nedv(
					 Field/name
					,'ReadElems(
						 BodyLines
						,string
						,'+MakeDefined(
							 Field/name[sub_or_null(id(Field),1)]+'/ReadPos'
							,'const(0, Unit)'
						)+'
					)'
					,Unit
					,string
				);
		}
	}
	
