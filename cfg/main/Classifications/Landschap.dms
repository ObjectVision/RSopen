//
// Specificeert de container 'Landschap'.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landschap
{
	unit<UInt8> BasiskaartNatuurlijkSysteemNederlandK : NrOfRows = 11
	{
		attribute<UInt32> code  : ['1000','2000','3000','4000','5000','6000','7000','8000','9000','10000','11000'];
		attribute<String> label :
		[
			'Strandwallen en binnenduinrand',		//1
			'Zeekleipolders',						//2
			'Laagveen',								//3
			'Droogmakerijen en IJsselmeerpolders',	//4
			'Rivierengebied',						//5
			'Rivierterrassen',						//6
			'Stuwwallen',							//7
			'Kleileemgebied',						//8
			'Dekzandgebied',						//9
			'Voormalige hoogvenen',					//10
			'Heuvelland en lossgbied'				//11
		];
		
		attribute<UInt32> BrushColor     : [rgb(255,255,0),
											rgb(0,168,132),
											rgb(223,115,255),
											rgb(0,77,168),
											rgb(0,197,255),
											rgb(115,223,255),
											rgb(230,0,0),
											rgb(255,170,0),
											rgb(205,137,102),
											rgb(132,0,168),
											rgb(111,143,117)];
		
		attribute<Bool> IsHoogNederland : [FALSE,FALSE,FALSE,FALSE,FALSE,TRUE,TRUE,TRUE,TRUE,TRUE,TRUE]
		, Descr = "Welke hoofdklassen samen hoog Nederland vormen: de zes pleistocene klassen, van Rivierterrassen tot en met Heuvelland. De vijf holocene klassen daarvoor vormen laag Nederland.

					Dit is de tabel achter BaseData/Omgeving/HoogNederland_FG, de fysisch-geografische lezing van hoge grond. Ze staat hier als kolom en niet als een vergelijking op de klassenummers, zodat te zien en te wijzigen is welke klasse aan welke kant valt.

					Een klasse is discutabel. Strandwallen en binnenduinrand staat op FALSE omdat hij holoceen is en tot laag Nederland wordt gerekend, maar de duinen zijn goed doorlatend zand met een diepe grondwaterstand en gedragen zich voor infiltratie als hoge grond. Het gaat om 116.651 ha, waarvan de huidige dieptelezing er 52.616 ha al als hoge grond telt. Zie #698.";

		attribute<String> name := AsItemName(label);
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt8> Huidig_GO_BNS_reclass_ZWD: NrOfRows = 8
	{
		attribute<UInt16> code: ['1','222','1000','2000','3000','5000','9000','11000'];
		attribute<String> label:
		[
			'Zuidwestelijke delta',		//1
			'Gebouwde omgeving',		//2
			'Kust',						//3
			'Kleigronden',				//4
			'Veenweide',				//5
			'Rivierengebied',			//6
			'Hoge zandgronden',			//7
			'Lossgebied'				//8

		];
		
		attribute<UInt32> BrushColor     : [rgb(225,113,114),
											rgb(255,0,0),
											rgb(249,225,19),
											rgb(67,112,79),
											rgb(148,227,54),
											rgb(65,105,242),
											rgb(230,230,56),
											rgb(191,213,158)];
		
		attribute<String> name := AsItemName(label);
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
}
