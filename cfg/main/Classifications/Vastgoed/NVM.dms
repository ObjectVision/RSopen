unit<UInt8> HouseCharacteristics : NrOfRows = 5
{
	attribute<String> name :
	[
		'size',
		'lotsize',
		'nrooms',
		'd_maintgood',
		'd_highrise'
	];
	
	attribute<String> ValueType :
	[
		'float32_t',
		'float32_t',
		'float32_t',
		'float32_t',
		'float32_t'
	];
	
	attribute<String> name2 := 'char_' + name;
	attribute<String> Label := name;
}

