	unit<uint8> HoofdklasseK: NrOfRows = 4
	{
		attribute<string> name: ['Verhard','Water','Groen','Bruin'];
		attribute<string> Label := name;
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<uint8> OPSubklasseK: NrOfRows = 7
	{
		attribute<string> name:                               ['Gebouwvoetafdruk','Verhard','Water','Bruin','Gras'      ,'Boom'      ,'Struik'      ];
		attribute<string> SrcRef:                             ['Gebouwvoetafdruk','Verhard','Water','Bruin','Groen/Gras','Groen/Boom','Groen/Struik'];
		attribute<CarbonClass> CarbonClass_rel_Hoog_NL:       [                0,         0,     16,     12,          13,           8,            47];
		attribute<CarbonClass> CarbonClass_rel_Laag_NL:       [                0,         0,     16,     12,          13,           9,            47];
		attribute<CarbonClass> CarbonClass_rel_NbSOP_Hoog_NL: [                0,         0,     17,     12,          13,           8,            47];
		attribute<CarbonClass> CarbonClass_rel_NbSOP_Laag_NL: [                0,         0,     17,     12,          13,           9,            47];
		
		attribute<float32> NDVI_min:                          [             0.00,      0.00,   0.00,   0.00,        0.20,        0.45,          0.25];
		attribute<float32> NDVI_max:                          [             0.00,      0.00,   0.00,   0.00,        0.45,        0.75,          0.25];
		attribute<float32> NDVI_NbSOP_min:                    [             0.00,      0.00,   0.05,   0.00,        0.25,        0.45,          0.50];
		attribute<float32> NDVI_NbSOP_max:                    [             0.00,      0.00,   0.30,   0.00,        0.50,        0.75,          0.50];
		
		attribute<string> Label := name;
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt8> IBIS: NrOfRows = 9
	{
		attribute<String> code: ['X','A','B','C','C1','C2','C3','C4','C5'];
		attribute<String> name:
		[
			'Onbekend',
			'Zeehaventerrein',
			'Bedrijventerrein',
			'Economische_zone',
			'EZ_retail_meubelboulevards',
			'EZ_onderwijslocaties',
			'EZ_Zorglocaties',
			'EZ_platform_gebonden_bedrijvigheid',
			'EZ_agribusiness_complexen'
		];
		
		attribute<String> Label:= name, DialogType = "LabelText";
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	#include <CBSKlasse.dms>
	#include <CBSKlasse2020.dms>
	unit<UInt8> CBSKlasse := = uint32(ModelParameters/BBG_Year) >= 2020 ? 'CBS2020Klasse' : 'CBS2010Klasse';
	unit<UInt8> ReeksJaren_1996_2017: NrOfRows = 9 // 9
	{
		attribute<String> jaar: ['1996', '2000', '2003', '2006', '2008', '2010', '2012', '2015', '2017'];
		attribute<String> naam  :='Y'+jaar;
		attribute<UInt32> value := uint32(jaar);
		attribute<String> Label := naam, DialogType = "LabelText";
		attribute<String> name  := naam;
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	unit<UInt8> ReeksJaren_ge2020 : NrOfRows = 2
	{
		attribute<String> jaar: ['2020', '2022'];
		attribute<String> naam  :='Y'+jaar;
		attribute<UInt32> value := uint32(jaar);
		attribute<String> Label := naam, DialogType = "LabelText";
		attribute<String> name  := naam;
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	unit<UInt8> ReeksJaren := union_unit_uint8(ReeksJaren_1996_2017, ReeksJaren_ge2020)
	{
		attribute<String> jaar  := union_data(., ReeksJaren_1996_2017/jaar, ReeksJaren_ge2020/jaar);
		attribute<String> naam  :='Y'+jaar;
		attribute<UInt32> value := uint32(jaar);
		attribute<String> Label := naam;
		attribute<String> name  := naam;
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt8> CBS2010KlasseEK := range(uint8,uint8(0),uint8(84))
	{
		attribute<String>    Label       := CBS2010Klasse/Label[CBSKlasseNr];
		attribute<CBS2010Klasse> CBSKlasseNr := invert(CBS2010Klasse/EK2010);
		
		container V := for_each_nedv(AsItemName(Label), string(id(.))+'[..]', void, .);
	}
	unit<UInt8> CBS2020KlasseEK := range(uint8,uint8(0),uint8(84))
	{
		attribute<String>    Label       := CBS2020Klasse/Label[CBSKlasseNr];
		attribute<CBS2020Klasse> CBSKlasseNr := invert(CBS2020Klasse/EK2020);
		
		container V := for_each_nedv(AsItemName(Label), string(id(.))+'[..]', void, .);
	}
	#include<BGT.dms>
	#include<BRT.dms>
	
