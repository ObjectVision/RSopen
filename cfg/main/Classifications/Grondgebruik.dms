				'35','Wortel- en knolgewassen'                     ,'0'   ,'50' ,'33' ,'6'  ,
				'36','Industriele akkerbouwgewassen'               ,'0'   ,'50' ,'39' ,'6'  ,
				'37','Vollegrondsgroenten'                         ,'0'   ,'50' ,'41' ,'6'  ,
				'38','Overige akkerbouwgewassen'                   ,'0'   ,'50' ,'39' ,'6'  ,
				'39','Bloembollen'                                 ,'0'   ,'50' ,'28' ,'10' ,
				'40','Boomkwekerij / sierbomen'                    ,'0.92','125','128','61' ,
				'41','Fruitbomen / boomgaarden'                    ,'0.92','125','117','9'  ,
				'42','Overige tuinbouw'                            ,'0'   ,'50' ,'59' ,'6'  ,
				'43','Kale landbouwgrond / braak'                  ,'0'   ,'0'  ,'15' ,'27' ,
				'44','Loofbos (natuur/produktiebos)'               ,'1.8' ,'200','275','11' ,
				'45','Naaldbos'                                    ,'0.5' ,'200','238','12' ,
