		attribute<String>             LU_ModelType     := elem/values[value(id * nrAttr + 6, elem)];
		attribute<Actor/LU_ModelType> LU_ModelType_rel := ='union_data(., '+asItemList(LU_ModelType != '' ? 'Actor/LU_ModelType/V/'+LU_ModelType : 'null_b')+')';
