		attribute<UInt32>           id              := uint32(id(.));
		attribute<UInt8>            code            := UInt8(elem/values[value(id * nrAttr + 0, elem)]);
		attribute<String>           Label           := elem/values[value(id * nrAttr + 1, elem)];
		attribute<ton_ha_jaarlijks> Cseq_ha         := Float32(elem/values[value(id * nrAttr + 2, elem)])[ton_ha_jaarlijks];
		attribute<ton_ha>           Cmax_ha         := Float32(elem/values[value(id * nrAttr + 3, elem)])[ton_ha];
		attribute<ton_ha>           Cmax_ha_invest  := Float32(elem/values[value(id * nrAttr + 4, elem)])[ton_ha];
		attribute<UInt16>           LGN_code        := UInt16(elem/values[value(id * nrAttr + 5, elem)]);
		
		attribute<LGNKlasse>        LGN_rel         := rlookup(LGN_code, LGNKlasse/code);
		attribute<String>           name            := AsItemName(Label);
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		parameter<UInt32>           nrAttr := 6;
	}
 }