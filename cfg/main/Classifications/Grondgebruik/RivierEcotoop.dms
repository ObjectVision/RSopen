
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De ecotooptypologie van het toekomstbeeld Rivieren en de vertaling daarvan naar natuurbeheertypen, voor de
// variant NbSGenuanceerd. Zie #621.
//
// De levering bestaat uit drie delen die hier samenkomen:
//   1. Een geopackage met 59 gebieden (23 buitendijkse riviertrajecten en 36 binnendijkse gebieden), met per
//      gebied het aandeel van elk van de vijftien ecotooptypen. Die aandelen tellen per gebied op tot 1.
//   2. Een typologietabel die per ecotooptype de categorie geeft: natuurlijk terrestrisch, agrarisch, water of
//      antropogeen. Die staat hieronder in Categorie.
//   3. Een conversietabel die elk ecotooptype aan een natuurbeheertype uit de Index Natuur en Landschap koppelt.
//      Die staat hieronder in Beheertypecode. Drie ecotopen hebben geen beheertype: agrarisch grasland,
//      agrarisch gebruik en bebouwd. In de levering vormen die samen de kolom "ha zonder beheertype".
//
// Let op dat een beheertype meer dan een categorie kan omvatten. N01.03 Rivier- en moeraslandschap verzamelt
// zes ecotopen, waarvan vier terrestrisch en twee water. Het onderscheid natuur/water is dus alleen op het
// niveau van het ecotoop scherp, en niet op dat van het beheertype. Daarom loopt de keuze tussen ExoNatuur en
// ExoWater in SourceData/Grondgebruik/Natuur over Categorie en niet over NatuurType/IsExogeenOpTeLeggen_*.
//


container NbSRivieren
{
	unit<uint8> RivierEcotoop : NrOfRows = 15
	, Descr = "De vijftien ecotooptypen van het toekomstbeeld Rivieren, in de volgorde van de kolommen in de levering. Die volgorde bepaalt de trekking in Natuur/NbSGenuanceerd_Rivieren en mag dus niet veranderen zonder dat de controlegetallen opnieuw worden gemeten."
	{
		attribute<string> name       : [ 'NatuurlijkGrasland'
		                               , 'Stroomdalgrasland'
		                               , 'AgrarischGrasland'
		                               , 'AgrarischGebruik'
		                               , 'HardhoutOoibos'
		                               , 'ZachthoutOoibos'
		                               , 'Struweel'
		                               , 'Moeras'
		                               , 'OnbegroeidPionier'
		                               , 'RuigteNat'
		                               , 'RuigteDroog'
		                               , 'ZomerbedRivier'
		                               , 'StromendWater'
		                               , 'StagnantWater'
		                               , 'BebouwdVerhard'
		                               ];
		attribute<string> BronKolom  : [ '% Natuurlijk grasland'
		                               , '% Stroomdalgrasland'
		                               , '% Agrarisch grasland'
		                               , '% Agrarisch gebruik'
		                               , '% Hardhout ooibos'
		                               , '% Zachthout ooibos'
		                               , '% Struweel (houtig)'
		                               , '% Moeras'
		                               , '% Onbegroeid & pionier (natuurlijk)'
		                               , '% Ruigte nat'
		                               , '% Ruigte droog'
		                               , '% Zomerbed rivier'
		                               , '% Stromend water'
		                               , '% Stagnant water'
		                               , '% Bebouwd/verhard/antropogeen'
		                               ], Descr = "De kolomnaam in de geopackage. Die begint met een procentteken en een spatie en is dus geen geldige DMS-itemnaam; de SqlString hernoemt hem naar Fr_ plus name. Deze kolom staat hier zodat de vertaling controleerbaar blijft.";
		attribute<string> omschrijving : [ 'Natuurlijk grasland (nat tot vochtig), incl. moerassig overstromingsgrasland'
		                                 , 'Droog, schraal stroomdalgrasland op zand of zavel; hoogdynamische standplaats'
		                                 , 'Productiegrasland'
		                                 , 'Akker, boomgaard, kwekerij'
		                                 , 'Eiken-essen-iepenbos op hoge, zelden overstroomde delen'
		                                 , 'Wilgen-, populieren- en elzenbos op regelmatig overstroomde delen'
		                                 , 'Zachthoutstruweel en griend'
		                                 , 'Riet en overige helofyten, biezengors'
		                                 , 'Zand- en grindbanken, slikkige oever, vegetatie met lage bedekking'
		                                 , 'Moerasruigte op natte standplaats'
		                                 , 'Ruigte op hogere, drogere delen van de uiterwaard'
		                                 , 'Permanent stromend hoofdgeul-oppervlak'
		                                 , 'Neven- en eenzijdig aangetakte geulen, getijdenkreken'
		                                 , 'Rivierbegeleidend water, strangen, plassen, ondiep water'
		                                 , 'Bebouwing, verharding, hard substraat, onbegroeid antropogeen'
		                                 ];
		attribute<string> Categorie  : [ 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Agrarisch'
		                               , 'Agrarisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Natuurlijk terrestrisch'
		                               , 'Water'
		                               , 'Water'
		                               , 'Water'
		                               , 'Antropogeen'
		                               ], Descr = "Overgenomen uit de typologietabel. Bepaalt of een cel via ExoNatuur of via ExoWater wordt opgelegd, of helemaal niet.";
		attribute<string> Beheertypecode : [ 'N01.03'
		                                   , 'N11.01'
		                                   , ''
		                                   , ''
		                                   , 'N14.01'
		                                   , 'N14.01'
		                                   , 'N01.03'
		                                   , 'N05.01'
		                                   , 'N05.01.14'
		                                   , 'N01.03'
		                                   , 'N01.03'
		                                   , 'N02.01'
		                                   , 'N01.03'
		                                   , 'N01.03'
		                                   , ''
		                                   ], Descr = "Natuurbeheertype volgens de kolom rivierecotoop uit de conversietabel. Leeg voor agrarisch grasland, agrarisch gebruik en bebouwd: die worden geen natuur.";

		attribute<string>         Label              := name + ' (' + Categorie + ')', DialogType = "LabelText";
		attribute<bool>           HeeftBeheertype    := Beheertypecode != '';
		attribute<INL_Beheertype> INL_Beheertype_rel := rlookup(Beheertypecode, INL_Beheertype/code)
		, IntegrityCheck = "all(!HeeftBeheertype || IsDefined(INL_Beheertype_rel))"
		, Descr = "Faalt als een code uit de conversietabel niet in INL_Beheertype voorkomt.";
		attribute<string>         Beheertype_name    := MakeDefined(replace(Beheertypecode, '.', '_'), ''), Descr = "De code als geldige itemnaam, voor de koppeling met RivierNatuurtype.";

		attribute<bool> IsNatuurlijkTerrestrisch := Categorie == 'Natuurlijk terrestrisch', Descr = "Deze cellen gaan naar ExoNatuur.";
		attribute<bool> IsWater                  := Categorie == 'Water',                   Descr = "Deze cellen gaan naar ExoWater.";
		attribute<bool> IsAgrarisch              := Categorie == 'Agrarisch',               Descr = "Deze cellen blijven landbouw; er wordt niets opgelegd. Ze gaan wel op slot voor nieuwbouw, want ze liggen in het ruimtebeslag van het toekomstbeeld.";

		attribute<bool>   IsEerste    := id(.) == 0b, Descr = "Alleen voor de opbouw van de cumulatieve fracties in Natuur/NbSGenuanceerd_Rivieren.";
		attribute<string> VorigeName  := name[value(max_elem(uint8(id(.)), 1b) - 1b, .)], Descr = "De naam van het vorige ecotoop in de rij. Voor het eerste ecotoop staat hier zijn eigen naam; dat wordt door IsEerste afgevangen.";

		container V := for_each_nedv(AsItemName(name), 'value('+string(id(.))+', ..)', void, .);
	}

	unit<uint8> RivierNatuurtype : NrOfRows = 6
	, Descr = "De zes natuurbeheertypen waar de ecotopen in uitkomen. Gelijk aan de kolommen 'ha N..' in de levering."
	{
		attribute<string>         code               : ['N01.03', 'N02.01', 'N05.01', 'N05.01.14', 'N11.01', 'N14.01'];
		attribute<string>         name               := replace(code, '.', '_');
		attribute<INL_Beheertype> INL_Beheertype_rel := rlookup(code, INL_Beheertype/code), IntegrityCheck = "all(IsDefined(INL_Beheertype_rel))";
		attribute<string>         Label              := INL_Beheertype/Label[INL_Beheertype_rel], DialogType = "LabelText";

		container V := for_each_nedv(AsItemName(name), 'value('+string(id(.))+', ..)', void, .);
	}
}
