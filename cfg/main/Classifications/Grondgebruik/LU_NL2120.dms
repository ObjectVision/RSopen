// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Klassenindeling van de tweede landgebruikskaart, naast die in LU_ModelType. Zie #633.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

unit<UInt8> LandbouwTotaalK : NrOfRows = 1
, Descr = "De ene landbouwklasse van LU_NL2120, in de plaats van de klassen van LandbouwKlasses."
{
	attribute<String> Label      : ['Landbouw'];
	attribute<String> name       := AsItemName(Label);
	attribute<UInt32> BrushColor : [rgb(178,255,102)], DialogType = "BrushColor";
}

unit<UInt8> NatuurOnbekendK : NrOfRows = 1
, Descr = "Restklasse van LU_NL2120: de cel is natuur volgens de landgebruikskaart, maar er is geen beheertype voor bekend. Zie de Descr bij LandgebruikskaartNL2120/BT voor waar het beheertype vandaan komt."
{
	attribute<String> Label      : ['Natuur, beheertype onbekend'];
	attribute<String> name       : ['Natuur_Onbekend'];
	attribute<UInt32> BrushColor : [rgb(160,190,160)], DialogType = "BrushColor";
}

unit<UInt8> LU_NL2120 := union_unit_uint8(Actor/LU_ModelType/wo_Landbouw_wo_Natuur, LandbouwTotaalK, INL_Beheertype, NatuurOnbekendK)
, Descr = "Klassenindeling van de tweede landgebruikskaart, gevraagd vanuit Deltares in #633. Verschilt op twee punten van LU_ModelType: de twaalf landbouwklassen worden een klasse, en de ene natuurklasse wordt uitgesplitst naar de beheertypen van INL_Beheertype, met een restklasse voor natuur zonder bekend beheertype.

			De volgorde van de vier bouwstenen ligt vast; wie er een tussenvoegt verschuift alle klassenummers en daarmee de betekenis van eerder weggeschreven tif-bestanden. De eerste bouwsteen hangt bovendien aan de actieve sectorenset in ModelParameters/SectorAllocRegio, dus ook het aan- of uitzetten van een sector verschuift de nummering."
{
	unit<UInt8> MT_rest := Actor/LU_ModelType/wo_Landbouw_wo_Natuur;

	attribute<String> Label := union_data(
		 .
		, Actor/LU_ModelType/Label[MT_rest/org_rel]
		, LandbouwTotaalK/Label
		, 'Natuur: ' + INL_Beheertype/code + ' ' + INL_Beheertype/naam
		, NatuurOnbekendK/Label
	), DialogType = "LabelText";

	attribute<String> name := union_data(
		 .
		, Actor/LU_ModelType/name[MT_rest/org_rel]
		, LandbouwTotaalK/name
		, 'Natuur_' + AsItemName(INL_Beheertype/code)
		, NatuurOnbekendK/name
	), Descr = "Itemnaam, niet de legendatekst. Voor de beheertypen is dat de code, want de namen bevatten tekens die geen itemnaam kunnen zijn.";

	attribute<UInt32> BrushColor := union_data(
		 .
		, Actor/LU_ModelType/BrushColor[MT_rest/org_rel]
		, LandbouwTotaalK/BrushColor
		, INL_Beheertype/BrushColor
		, NatuurOnbekendK/BrushColor
	), DialogType = "BrushColor";

	attribute<Actor/LU_ModelType> LU_ModelType_rel := union_data(
		 .
		, MT_rest/org_rel
		, const(null_b, LandbouwTotaalK, Actor/LU_ModelType)
		, const(null_b, INL_Beheertype , Actor/LU_ModelType)
		, const(null_b, NatuurOnbekendK, Actor/LU_ModelType)
	), Descr = "Alleen gevuld voor de klassen die een op een uit LU_ModelType overkomen. Juist doordat de landbouw- en natuurklassen hier leeg blijven, is de rlookup vanuit LU_ModelType naar deze eenheid eenduidig.";

	attribute<INL_Beheertype> INL_Beheertype_rel := union_data(
		 .
		, const(null_b, MT_rest        , INL_Beheertype)
		, const(null_b, LandbouwTotaalK, INL_Beheertype)
		, id(INL_Beheertype)
		, const(null_b, NatuurOnbekendK, INL_Beheertype)
	), Descr = "Alleen gevuld voor de natuurklassen. Gebruikt om vanuit een beheertype de bijbehorende klasse van deze eenheid op te zoeken.";

	attribute<NatuurType> NatuurType_rel := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel], Descr = "De achttien hoofdgroepen boven de beheertypen, voor wie de kaart op een grovere natuurindeling wil samenvatten.";

	attribute<Bool> IsLandbouw := id(.) == V/Landbouw;
	attribute<Bool> IsNatuur   := IsDefined(INL_Beheertype_rel) || id(.) == V/Natuur_Onbekend;

	container V := for_each_nedv(name, string(id(.))+'[..]', void, .);

}
