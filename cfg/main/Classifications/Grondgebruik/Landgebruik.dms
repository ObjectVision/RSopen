// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De classificaties van de stand-administratie landgebruik (#751): LandbouwType, de stabiele landbouwtypologie, en
// LandgebruikType, de unie van natuurbeheertypen, landbouwtypen en LGN-klassen waarin de toestand per cel wordt
// bijgehouden. De kaart zelf staat in BaseData/StartState/Landgebruik.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

unit<UInt8> LandbouwType : NrOfRows = 12
, Descr = "De landbouwtypologie van de stand-administratie: wat een landbouwcel is, in klassen die decennia op dezelfde plek blijven liggen. Zie #751.

			Waarom niet de gewascode. De BRP registreert het gewas van dit jaar, en op bouwland is dat volgend jaar een
			ander gewas: rotatie zit in de bron. Een cel die tot 2120 'aardappelen' blijft heten suggereert een precisie
			die er niet is. Wat wel stabiel is: blijvend grasland tegenover tijdelijk grasland tegenover bouwland, want
			dat is het onderscheid dat de bodemkoolstof en de veenoxidatie sturen; de houtige teelten, want boomgaard,
			boomkwekerij en bos op landbouwgrond dragen biomassa; en de teelten die aan een streek vastzitten, bollen en
			glas. De gewascode blijft aan de bronkant staan, in Classifications/Landbouw/BRPGewasType, en aggregeert bij
			binnenkomst in de state naar deze twaalf.

			Waarom niet de allocatieklassen van Actor/LandbouwKlasses. Die zijn gewassen (aardappelen, bieten, granen)
			omdat de landbouwallocatie op gewaseconomie draait, en die detaillering hoort in de landbouwstand thuis, die
			de allocatie zelf per zichtjaar bijhoudt. LU_ModelType_rel hier is de terugval voor een lezer die van deze
			typologie naar de landgebruikskaart wil; in het basisjaar komt de gewasklasse rechtstreeks uit de BRP en
			niet via deze tabel.

			Elke klasse is uit de BRP en uit LGN te vullen, op de uitzonderingen na die maar een van beide kent:
			Glastuinbouw kent alleen LGN, want de BRP registreert geen kassen; Grasland_tijdelijk en Bos_agrarisch
			kent alleen de BRP, want LGN ziet het verschil met blijvend grasland en met bos niet. Bos_agrarisch is
			bovendien alleen bereikbaar waar LGN zelf geen bos ziet, want dan wint de natuurkant; het is de klasse voor
			jonge aanplant, hakhout en meerjarige biomassateelt die LGN nog als gewas of gras leest. Braak komt uit
			beide: de BRP-braakcodes en LGN 27 overig grondgebruik in buitengebied.

			LGN_proxy is de LGN-klasse die het dichtst bij dit type ligt, en die draagt via LGNKlasse de NDVI-band, op
			dezelfde manier als INL_Beheertype/LGN_code dat voor de natuur doet. De koolstofklasse staat apart in CC, want
			die maakt onderscheid dat LGN niet kent."
{
	unit<UInt32> Elements := range(uint32, 0, nrAttr * #.)
	{
		attribute<String> Text: [
		// name                  , Label                          , LU_ModelType                , LGN_proxy , CC   , r    , g    , b
			'Grasland_blijvend'  , 'Grasland, blijvend'           , 'Landbouw_gg_vee'           , '1'       , '25', '114', '227', ' 32',
			'Grasland_tijdelijk' , 'Grasland, tijdelijk'          , 'Landbouw_gg_vee'           , '1'       , '24', '170', '240', ' 90',
			'Grasland_natuurlijk', 'Grasland, natuurlijk'         , 'Landbouw_gg_vee_extensief' , '45'      , '26', '180', '185', ' 59',
			'Mais'               , 'Mais'                         , 'Landbouw_gg_vee'           , '2'       , '27', '229', '157', ' 32',
			'Bouwland'           , 'Bouwland'                     , 'Landbouw_Akkerbouw'        , '6'       , '38', '254', '  0', '197',
			'Bollen_bloemen'     , 'Bollen en bloemen'            , 'Landbouw_Akkerbouw'        , '10'      , '39', '172', '127', '168',
			'Boomkwekerij'       , 'Boomkwekerij'                 , 'Landbouw_Akkerbouw'        , '61'      , '40', '253', '180', '169',
			'Boomgaard_fruit'    , 'Boomgaard en fruit'           , 'Landbouw_Boomgaard'        , '9'       , '41', ' 60', '243', ' 69',
			'Glastuinbouw'       , 'Glastuinbouw'                 , ''                          , '8'       , ' 4', ' 78', '255', '206',
			'Riet_paludicultuur' , 'Riet en paludicultuur'        , 'Landbouw_Rietteelt'        , '42'      , '18', '252', '169', ' 18',
			'Braak'              , 'Braak'                        , 'Landbouw_Akkerbouw'        , '6'       , '43', '220', '210', '180',
			'Bos_agrarisch'      , 'Bos op landbouwgrond'         , 'Natuur_Totaal'             , '11'      , '44', ' 50', '204', '  1'
		];
	}

	attribute<String>             name             := Elements/Text[value(uint32(id(.)) * nrAttr + 0, Elements)];
	attribute<String>             Label            := Elements/Text[value(uint32(id(.)) * nrAttr + 1, Elements)], DialogType = "LabelText";
	attribute<String>             LU_ModelType     := Elements/Text[value(uint32(id(.)) * nrAttr + 2, Elements)];
	attribute<Actor/LU_ModelType> LU_ModelType_rel := ='union_data(., '+asItemList(LU_ModelType != '' ? 'Actor/LU_ModelType/V/'+LU_ModelType : 'null_b')+')'
	, Descr = "Terugval naar de landgebruikskaart. Leeg voor Glastuinbouw, want die kent LU_ModelType niet; die cellen vallen in de kaart op Overig, zoals ze bij LGN-klasse 8 altijd al deden.";
	attribute<UInt16>             LGN_code         := uint16(Elements/Text[value(uint32(id(.)) * nrAttr + 3, Elements)]);
	attribute<LGNKlasse>          LGNKlasse_rel    := rlookup(LGN_code, LGNKlasse/code), IntegrityCheck = "all(IsDefined(LGNKlasse_rel))";
	attribute<UInt8>              CC_code          := uint8(Elements/Text[value(uint32(id(.)) * nrAttr + 4, Elements)]);
	attribute<CarbonClass>        CarbonClass_rel  := rlookup(CC_code, CarbonClass/code), IntegrityCheck = "all(IsDefined(CarbonClass_rel))"
	, Descr = "De koolstofklasse per landbouwtype, rechtstreeks uit de kolom CC en niet via de LGN-proxy, want de koolstoftabel maakt onderscheid dat LGN niet ziet: 24 tijdelijk tegenover 25 permanent agrarisch grasland, 43 braak, 44 loofbos voor bos op landbouwgrond. Bouwland staat op 38 overige akkerbouwgewassen; de tabel kent per gewas klassen 28 tot 37 met Cmax_invest tussen 28 en 46, en die differentiatie gaat hier bewust verloren, want het gewas wisselt per jaar.";
	attribute<UInt32>             r                := uint32(Elements/Text[value(uint32(id(.)) * nrAttr + 5, Elements)]);
	attribute<UInt32>             g                := uint32(Elements/Text[value(uint32(id(.)) * nrAttr + 6, Elements)]);
	attribute<UInt32>             b                := uint32(Elements/Text[value(uint32(id(.)) * nrAttr + 7, Elements)]);
	attribute<UInt32>             BrushColor       := rgb(r, g, b), DialogType = "BrushColor";

	container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);

	parameter<UInt32> nrAttr := 8;
}

unit<UInt8> LandgebruikType := union_unit_uint8(INL_Beheertype, LandbouwType, LGNKlasse)
, Descr = "De classificatie van de stand-administratie landgebruik: een type per cel, zo gedetailleerd als de bronnen toelaten. Zie #751.

			Drie delen, in volgorde van voorrang. Een natuurbeheertype uit INL_Beheertype waar de cel natuur of water is
			en de beheertypenkaart een type geeft; een landbouwtype uit LandbouwType waar de cel landbouw is; en anders
			de LGN-klasse zelf, dus bebouwing, infrastructuur, en de natuur en het water waar geen beheertype voor
			bekend is. Zo heeft elke cel precies een toestand, en niets hoeft ergens anders met een tweede laag te
			worden samengevoegd.

			Waarom LGN het derde deel is en niet een eigen restlijst: LGN is de fysieke basis van de kaart en dekt het
			hele land. Een eigen restlijst was een vertaaltabel meer, en het uitfaseren van vertaaltabellen is precies
			het doel. Verandert de LGN-indeling bij een nieuwe jaargang, dan verschuiven de nummers van dit derde deel,
			net zoals LU_ModelType verschuift bij een nieuwe landbouwklasse; de standtifs horen daarom de legenda mee
			te dragen.

			Wat er bewust NIET in staat: wie de cel bezet. Dat is Sector/xSubsector via SubSector_rel in dezelfde
			stand, en die wordt niet gewist als een cel wordt gebouwd. Het type blijft dus staan naast de bezetting,
			zodat de koolstofindicator kan zien wat er lag voordat het wonen werd. LU_ModelType_rel hier geeft de
			landgebruikskaart-klasse van het type zelf; de dominantieregel van de kaart legt de bebouwing daar overheen.

			Kolommen per deel: INL_Beheertype_rel, LandbouwType_rel en LGNKlasse_rel zijn de eigen identiteit van een
			rij en leeg voor de andere twee delen, zodat invert() ze omkeert. LGNKlasse_proxy is voor elke rij gevuld en
			draagt de koolstofklasse en de NDVI-band."
{
	attribute<String>             name              := union_data(., 'Natuur_' + AsItemName(INL_Beheertype/code), 'Landbouw_' + LandbouwType/name, 'LGN_' + LGNKlasse/name);
	attribute<String>             Label             := union_data(., INL_Beheertype/Label, 'Landbouw: ' + LandbouwType/Label, 'LGN: ' + LGNKlasse/Label), DialogType = "LabelText";
	attribute<Deel>               Deel_rel          := union_data(., const(Deel/V/Beheertype, INL_Beheertype), const(Deel/V/Landbouw, LandbouwType), const(Deel/V/LGN, LGNKlasse));

	attribute<INL_Beheertype>     INL_Beheertype_rel := union_data(., id(INL_Beheertype), const(null_b, LandbouwType, INL_Beheertype), const(null_b, LGNKlasse, INL_Beheertype));
	attribute<LandbouwType>       LandbouwType_rel   := union_data(., const(null_b, INL_Beheertype, LandbouwType), id(LandbouwType), const(null_b, LGNKlasse, LandbouwType));
	attribute<LGNKlasse>          LGNKlasse_rel      := union_data(., const(null_b, INL_Beheertype, LGNKlasse), const(null_b, LandbouwType, LGNKlasse), id(LGNKlasse));

	attribute<LandbouwType>       LandbouwType_afgeleid := union_data(., const(null_b, INL_Beheertype, LandbouwType), id(LandbouwType), LGNKlasse/LandbouwType_rel)
	, Descr = "Het landbouwtype, ook voor de LGN-rijen die er een hebben. Voor de vraag welk soort landbouw het is; LandbouwType_rel is voor de vraag uit welk deel de rij komt.";
	attribute<LGNKlasse>          LGNKlasse_proxy    := union_data(., INL_Beheertype/LGNKlasse_rel, LandbouwType/LGNKlasse_rel, id(LGNKlasse));

	attribute<Bool>               IsWater           := union_data(., INL_Beheertype/IsWater, const(FALSE, LandbouwType), LGNKlasse/LU_ModelType_rel == Actor/LU_ModelType/V/Water_Totaal);
	attribute<Bool>               IsNatuur          := union_data(., !INL_Beheertype/IsWater, const(FALSE, LandbouwType), LGNKlasse/LU_ModelType_rel == Actor/LU_ModelType/V/Natuur_Totaal)
	, Descr = "Natuur en water op de kolom LU_ModelType van de LGN-tabel, niet op de hedonische vlaggen: riet, moerasbos en natuurlijk beheerd agrarisch grasland zijn hier landbouw, zoals het model ze kent.";
	attribute<Bool>               IsLandbouw        := union_data(., const(FALSE, INL_Beheertype), const(TRUE, LandbouwType), IsDefined(LGNKlasse/LandbouwType_rel));
	attribute<Bool>               IsBebouwd         := union_data(., const(FALSE, INL_Beheertype), const(FALSE, LandbouwType), LGNKlasse/isBebouwd);

	attribute<Actor/LU_ModelType> LU_ModelType_rel  := union_data(., INL_Beheertype/LU_ModelType_rel, LandbouwType/LU_ModelType_rel, LGNKlasse/LU_ModelType_rel);
	attribute<CarbonClass>        CarbonClass_rel   := union_data(., INL_Beheertype/CarbonClass_rel, LandbouwType/CarbonClass_rel, /Classifications/Grondgebruik/CarbonClass_rel);
	attribute<UInt32>             BrushColor        := union_data(., INL_Beheertype/BrushColor, LandbouwType/BrushColor, LGNKlasse/BrushColor), DialogType = "BrushColor";

	attribute<LandgebruikType> Van_INL          (INL_Beheertype) := invert(INL_Beheertype_rel), Descr = "Van beheertype naar rij in de unie.";
	attribute<LandgebruikType> Van_LandbouwType (LandbouwType)   := invert(LandbouwType_rel),   Descr = "Van landbouwtype naar rij in de unie.";
	attribute<LandgebruikType> Van_LGN          (LGNKlasse)      := invert(LGNKlasse_rel),      Descr = "Van LGN-klasse naar rij in de unie.";

	container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);

	unit<UInt8> Deel : NrOfRows = 3
	{
		attribute<String> name  : ['Beheertype', 'Landbouw', 'LGN'];
		attribute<String> Label := name, DialogType = "LabelText";
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
}

container BeheertypeHeuristiek
: Descr = "Een natuurbeheertype voor de natuur en het water waar geen beheertypenkaart iets over zegt (#751). Twee tabellen: het water uit de functieklassen van de bodemstatistiek, want die zeggen of het zee, afgesloten zeearm, rivier of plas is; de begroeiing uit de LGN-klasse, met een droge en een natte lezing die BOFEK (veen of moerig) kiest. Dit is een heuristiek en geen waarneming: bos zonder beheertype wordt productiebos, heide op veen wordt vochtige heide, en dat is de meest waarschijnlijke lezing, niet de gemeten. Geldt alleen waar LGN zelf natuur of water ziet; de drie grensklassen 42 rietvegetatie, 43 bos in moerasgebied en 45 natuurlijk beheerd agrarisch grasland krijgen alleen een beheertype als een kaart het geeft, en blijven anders natte teelt en extensieve landbouw. Gebruikt in BaseData/StartState/Landgebruik/Beheertype_Heuristiek achter ModelParameters/Beheertype_GatenVullen."
{
	unit<UInt8> LGN : NrOfRows = 24
	{
		unit<UInt32> Elements := range(uint32, 0, nrAttr * #.)
		{
			attribute<String> Text: [
			// lgn , droog       , nat           // LGN-klasse
				'11' , 'N16.03.02' , 'N14.02',     // loofbos: droog bos met productie, op veen hoog- en laagveenbos
				'12' , 'N16.03.03' , 'N16.04.03',  // naaldbos: droog of vochtig bos met productie
				'22' , 'N17.03'    , 'N17.03',     // bos in secundair bebouwd gebied: park- en stinzenbos
				'40' , 'N14.02'    , 'N14.02',     // bos in hoogveengebied
				'30' , 'N09.01'    , 'N09.01',     // kwelders
				'31' , 'N08.01'    , 'N08.01',     // open zand in kustgebied: strand en embryonaal duin
				'32' , 'N08.02'    , 'N08.02',     // duinen met lage vegetatie: open duin
				'33' , 'N08.02.11' , 'N08.02.11',  // duinen met hoge vegetatie: duinstruweel
				'34' , 'N08.04'    , 'N08.04',     // duinheide
				'35' , 'N07.02'    , 'N07.02',     // open stuifzand en rivierzand: zandverstuiving
				'36' , 'N07.01'    , 'N06.04',     // heide: droge heide, op veen vochtige heide
				'37' , 'N07.01'    , 'N06.04',     // matig vergraste heide
				'38' , 'N07.01'    , 'N06.04',     // sterk vergraste heide
				'39' , 'N06.03'    , 'N06.03',     // hoogveen
				'41' , 'N05.04'    , 'N05.04',     // overige moerasvegetatie: dynamisch moeras
				'46' , 'N08.02.15' , 'N08.02.15',  // gras in het kustgebied: duingrasland
				'321', 'N06.03'    , 'N06.03',     // struikvegetatie in hoogveengebied (laag)
				'331', 'N06.03'    , 'N06.03',     // struikvegetatie in hoogveengebied (hoog)
				'322', 'N05.01.06' , 'N05.01.06',  // struikvegetatie in moerasgebied (laag): moerasstruweel
				'332', 'N05.01.06' , 'N05.01.06',  // struikvegetatie in moerasgebied (hoog)
				'323', 'N12.06'    , 'N05.01.06',  // overige struikvegetatie (laag): ruigteveld, op veen moerasstruweel
				'333', 'N12.06'    , 'N05.01.06',  // overige struikvegetatie (hoog)
				'16' , 'N04.02'    , 'N04.02',     // zoet water zonder functieklasse: zoete plas
				'17' , 'N01.01'    , 'N01.01'      // zout water: zee en wad
			];
		}
		attribute<UInt16>         lgn_code      := uint16(Elements/Text[value(uint32(id(.)) * nrAttr + 0, Elements)]);
		attribute<LGNKlasse>      LGNKlasse_rel := rlookup(lgn_code, LGNKlasse/code), IntegrityCheck = "all(IsDefined(LGNKlasse_rel))";
		attribute<String>         code_droog    := Elements/Text[value(uint32(id(.)) * nrAttr + 1, Elements)];
		attribute<String>         code_nat      := Elements/Text[value(uint32(id(.)) * nrAttr + 2, Elements)];
		attribute<INL_Beheertype> Droog_rel     := rlookup(code_droog, INL_Beheertype/code), IntegrityCheck = "all(IsDefined(Droog_rel))";
		attribute<INL_Beheertype> Nat_rel       := rlookup(code_nat,   INL_Beheertype/code), IntegrityCheck = "all(IsDefined(Nat_rel))";
		parameter<UInt32> nrAttr := 3;
	}

	unit<UInt8> CBSWater : NrOfRows = 13
	{
		unit<UInt32> Elements := range(uint32, 0, nrAttr * #.)
		{
			attribute<String> Text: [
			// CBS-klasse                         , beheertype
				'Noordzee'                          , 'N01.01',
				'Waddenzee_Eems_Dollard'            , 'N01.01',
				'Oosterschelde'                     , 'N01.01',
				'Westerschelde'                     , 'N01.01',
				'IJsselmeer_Markermeer'             , 'N04.04',
				'afgesloten_zeearm'                 , 'N04.04',
				'Rijn_en_Maas'                      , 'N02.01',
				'Randmeer'                          , 'N04.02',
				'spaarbekkens'                      , 'N04.02',
				'water_met_een_recreatieve_functie' , 'N04.02',
				'water_met_delfstofwinningsfunctie' , 'N04.02',
				'vloei_en_of_slibveld'              , 'N04.02',
				'overig_binnenwater'                , 'N04.02'
			];
		}
		attribute<String>         cbs_name      := Elements/Text[value(uint32(id(.)) * nrAttr + 0, Elements)];
		attribute<CBSKlasse>      CBSKlasse_rel := rlookup(lowercase(cbs_name), lowercase(CBSKlasse/name)), IntegrityCheck = "all(IsDefined(CBSKlasse_rel))";
		attribute<String>         code          := Elements/Text[value(uint32(id(.)) * nrAttr + 1, Elements)];
		attribute<INL_Beheertype> INL_rel       := rlookup(code, INL_Beheertype/code), IntegrityCheck = "all(IsDefined(INL_rel))";
		parameter<UInt32> nrAttr := 2;
	}

	attribute<INL_Beheertype> PerLGN_Droog (LGNKlasse) := LGN/Droog_rel[rlookup(LGNKlasse/code, LGN/lgn_code)], Descr = "De droge lezing per LGN-klasse, null voor klassen zonder rij.";
	attribute<INL_Beheertype> PerLGN_Nat   (LGNKlasse) := LGN/Nat_rel[rlookup(LGNKlasse/code, LGN/lgn_code)],   Descr = "De natte lezing per LGN-klasse, voor cellen op veen of moerige grond.";
	attribute<INL_Beheertype> PerCBS_Water (CBSKlasse) := CBSWater/INL_rel[rlookup(lowercase(CBSKlasse/name), lowercase(CBSWater/cbs_name))], Descr = "Het watertype per functieklasse van de bodemstatistiek, null voor alles wat geen water is.";
}

unit<UInt8> LandbouwType_vanLU_Tabel : NrOfRows = 13
, Descr = "Van een landbouwklasse van LU_ModelType terug naar het landbouwtype van de stand-administratie, voor de landbouwstroom van de exogene oplegging (natte teelt en vernat grasland uit de veenbouwstenen) en voor wie een oude kaart wil terugleggen. Gewassen worden Bouwland, want de rotatie is niet in de klasse te zien."
{
	unit<UInt32> Elements := range(uint32, 0, nrAttr * #.)
	{
		attribute<String> Text: [
		// LU_ModelType                , LandbouwType
			'Landbouw_Rietteelt'        , 'Riet_paludicultuur',
			'Landbouw_Cranberry'        , 'Riet_paludicultuur',
			'Landbouw_Moerasbomen'      , 'Riet_paludicultuur',
			'Landbouw_GG_vee_extensief' , 'Grasland_natuurlijk',
			'Landbouw_GG_vee'           , 'Grasland_blijvend',
			'Landbouw_GG_vee_intensief' , 'Grasland_blijvend',
			'Landbouw_Akkerbouw'        , 'Bouwland',
			'Landbouw_Aardappelen'      , 'Bouwland',
			'Landbouw_Bieten'           , 'Bouwland',
			'Landbouw_Granen'           , 'Bouwland',
			'Landbouw_Rijst'            , 'Bouwland',
			'Landbouw_Yacon'            , 'Bouwland',
			'Landbouw_Boomgaard'        , 'Boomgaard_fruit'
		];
	}
	attribute<String>             lu_name          := Elements/Text[value(uint32(id(.)) * nrAttr + 0, Elements)];
	attribute<Actor/LU_ModelType> LU_ModelType_rel := rlookup(lowercase(lu_name), lowercase(Actor/LU_ModelType/name)), IntegrityCheck = "all(IsDefined(LU_ModelType_rel))";
	attribute<String>             type_name        := Elements/Text[value(uint32(id(.)) * nrAttr + 1, Elements)];
	attribute<LandbouwType>       LandbouwType_rel := rlookup(lowercase(type_name), lowercase(LandbouwType/name)), IntegrityCheck = "all(IsDefined(LandbouwType_rel))";
	parameter<UInt32> nrAttr := 2;
}
attribute<LandbouwType> LandbouwType_vanLU (Actor/LU_ModelType) := LandbouwType_vanLU_Tabel/LandbouwType_rel[rlookup(lowercase(Actor/LU_ModelType/name), lowercase(LandbouwType_vanLU_Tabel/lu_name))], Descr = "Zie LandbouwType_vanLU_Tabel; null voor alles wat geen landbouwklasse is.";
