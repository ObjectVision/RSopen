	container Controle
	: Descr = "Bewaking op de overgetypte brontabel. Faalt zodra de aangeleverde Excel intern niet meer sluit of zodra er een nieuwe versie met andere getallen wordt overgenomen."
	{
		attribute<float32> Som_Landgebruik (NbSBouwsteen) :=
			add(NbSBouwsteen/Fr_NietVernatGrasland, NbSBouwsteen/Fr_VernatGrasland_Productie, NbSBouwsteen/Fr_VernatGrasland_Kruidenrijk, NbSBouwsteen/Fr_NatteTeelt, NbSBouwsteen/Fr_OppervlakteWater, NbSBouwsteen/Fr_Bebouwd, NbSBouwsteen/Fr_NTypen)
		, IntegrityCheck = "all(abs(this - 1f) < 0.001f)"
		, Descr = "Kolommen X:AC plus AZ moeten per bouwsteen tot 1 sommeren, zoals kolom BA.";

		attribute<float32> Som_NTypen (NbSBouwsteen) := ='add('+AsItemList('Fracties_vd_Bouwsteen/'+NbSNatuurtype/name)+')'
		, IntegrityCheck = "all(abs(this - NbSBouwsteen/Fr_NTypen) < 0.001f)"
		, Descr = "De natuurbeheertypen uit AD:AY moeten samen precies kolom AZ opleveren. In de vorige versie van de tabel klopte dit niet voor bouwsteen 3b en 4b; die staan nu op 100 procent natte teelt zonder natuurbeheertype.";

		attribute<float32> Som_Relatief (NbSBouwsteen) := ='add('+AsItemList('Fracties_Relatief/'+NbSNatuurtype/name)+')'
		, IntegrityCheck = "all(NbSBouwsteen/Fr_NTypen == 0f || abs(this - 1f) < 0.001f)"
		, Descr = "Kolommen BC:BX moeten tot 1 sommeren waar de bouwsteen natuurbeheertypen heeft, zoals kolom BY.";

		attribute<float32> Verschil_AbsRel (NbSBouwsteen) := ='add('+AsItemList('abs(Fracties_vd_Bouwsteen/'+NbSNatuurtype/name+' - Fracties_Relatief/'+NbSNatuurtype/name+' * NbSBouwsteen/Fr_NTypen)')+')'
		, IntegrityCheck = "all(this < 0.001f)"
		, Descr = "De twee blokken uit de brontabel moeten in elkaar om te rekenen zijn: het relatieve blok maal het aandeel N-typen is het absolute blok.";
	}

	container Vergelijking
	: Descr = "#657: de CO2-kentallen van team Veen naast wat de koolstofklassentabel van RSopen op dezelfde samenstelling boekt.

				Team Veen geeft per bouwsteen een netto CO2-stroom voor de eindtoestand 2120. RSopen kent geen bouwstenen in
				zijn koolstofboekhouding maar landgebruiks- en natuurbeheertypen, elk met een vastlegging per hectare per jaar
				in Classifications/Grondgebruik/CarbonClass. Omdat de bouwstenentabel per bouwsteen precies zegt uit welke
				fracties landgebruik en natuurbeheertype hij bestaat, is die tweede kant hier uit te rekenen en naast de eerste
				te zetten. Draai het item Tabel.

				Twee dingen bij het lezen. De RS-kolom is wat de klassentabel toekent, niet wat er in een run uitkomt: de
				vastlegging wordt in de indicator begrensd op het klassemaximum en bevroren waar SOMERS oxidatie meldt, en op
				de veenbodem ligt de voorraad ver boven het maximum van de rietklassen. De RS-kolom is dus een bovengrens. En
				de twee grootheden zijn niet hetzelfde: team Veen geeft de netto bodemstroom inclusief de oxidatie die in
				RSopen via SOMERS loopt, RSopen geeft alleen de vastlegging. Voor de veenvormende bouwstenen 5 tot en met 8,
				waar SOMERS in de eindtoestand nauwelijks nog uitstoot, zijn ze wel vergelijkbaar."
	{
		attribute<float32> Cseq_LG (NbSLandgebruik) := CarbonClass/Cseq_ha[NbSLandgebruik/CarbonClass_rel][float32], Descr = "Vastlegging per hoofdtype landgebruik in ton C per hectare per jaar, zonder metriek zodat er met kale getallen gerekend kan worden.";
		attribute<float32> Cseq_NT (NbSNatuurtype)  := CarbonClass/Cseq_ha[INL_Beheertype/CarbonClass_rel[NbSNatuurtype/INL_Beheertype_rel]][float32], Descr = "Idem per natuurbeheertype, via de koppeling die INL_Beheertype al legt.";

		attribute<float32> RS_Cseq_tonC_ha_jaar (NbSBouwsteen) :=
			= 'add(' + AsItemList('NbSBouwsteen/Fr_'+NbSLandgebruik/name+' * Cseq_LG[value('+string(id(NbSLandgebruik))+', NbSLandgebruik)]')
			  + ', '  + AsItemList('Fracties_vd_Bouwsteen/'+NbSNatuurtype/name+' * Cseq_NT[value('+string(id(NbSNatuurtype))+', NbSNatuurtype)]') + ')'
		, Descr = "De met de fracties gewogen vastlegging van de bouwsteen volgens de koolstofklassentabel, in ton C per hectare per jaar.";

		attribute<float32> RS_CO2_ton_ha_jaar   (NbSBouwsteen) := -RS_Cseq_tonC_ha_jaar * 44f / 12f, Descr = "Dezelfde stroom in ton CO2 per hectare per jaar en met het teken van team Veen: positief is uitstoot, dus de vastlegging staat negatief.";
		attribute<float32> Verschil_ton_ha_jaar (NbSBouwsteen) := NbSBouwsteen/CO2_ton_ha_jaar - RS_CO2_ton_ha_jaar, Descr = "Team Veen min RSopen. Positief betekent dat team Veen meer uitstoot of minder vastlegging opvoert dan de klassentabel.";

		attribute<float32> TeamVeen_kton_jaar (NbSBouwsteen) := NbSBouwsteen/CO2_ton_ha_jaar * NbSBouwsteen/Areaal_NbSGenuanceerd_ha / 1000f;
		attribute<float32> RS_kton_jaar       (NbSBouwsteen) := RS_CO2_ton_ha_jaar          * NbSBouwsteen/Areaal_NbSGenuanceerd_ha / 1000f;
		attribute<float32> CH4_kton_jaar      (NbSBouwsteen) := NbSBouwsteen/CH4_ton_CO2eq_ha_jaar * NbSBouwsteen/Areaal_NbSGenuanceerd_ha / 1000f;

		parameter<float32> Totaal_TeamVeen_kton_jaar := sum(TeamVeen_kton_jaar), Descr = "Landelijke CO2-balans van het veengebied in de eindtoestand volgens team Veen, in kton per jaar. Let op: de brontabel komt hier zelf op 11,99 kton uit omdat de formule op de rij van bouwsteen 4a het areaal van 3a leest. Met het eigen areaal van 4a hoort er 17,24 te staan.";
		parameter<float32> Totaal_RS_kton_jaar       := sum(RS_kton_jaar);
		parameter<float32> Totaal_CH4_kton_jaar      := sum(CH4_kton_jaar), Descr = "Methaan over hetzelfde areaal, in kton CO2-equivalent per jaar. Dit is de post die het model nergens telt.";
		parameter<float32> Totaal_Areaal_ha          := sum(NbSBouwsteen/Areaal_NbSGenuanceerd_ha)
		, IntegrityCheck = "abs(Totaal_Areaal_ha - 671504f) < 5f"
		, Descr = "Bewaakt de overgetypte areaalkolom tegen het totaal uit de brontabel.";

		attribute<String> Regel (NbSBouwsteen) :=
			  NbSBouwsteen/code
			+ ';' + string(NbSBouwsteen/Areaal_NbSGenuanceerd_ha)
			+ ';' + string(NbSBouwsteen/CO2_ton_ha_jaar)
			+ ';' + string(RS_CO2_ton_ha_jaar)
			+ ';' + string(Verschil_ton_ha_jaar)
			+ ';' + string(NbSBouwsteen/CH4_ton_CO2eq_ha_jaar)
			+ ';' + string(TeamVeen_kton_jaar)
			+ ';' + string(RS_kton_jaar)
			+ ';' + string(CH4_kton_jaar);

		parameter<String> Tabel :=
			  'bouwsteen;ha;teamveen_co2_ton_ha_jr;rs_co2_ton_ha_jr;verschil_ton_ha_jr;teamveen_ch4_ton_ha_jr;teamveen_kton_jr;rs_kton_jr;ch4_kton_jr'
			+ '|' + AsList(Regel, '|')
			+ '|TOTAAL;' + string(Totaal_Areaal_ha) + ';;;;;' + string(Totaal_TeamVeen_kton_jaar) + ';' + string(Totaal_RS_kton_jaar) + ';' + string(Totaal_CH4_kton_jaar)
		, StorageName = "='%LocalDataProjDir%/Diagnose/657_bouwstenen_kentallen.txt'"
		, StorageType = "str"
		, Descr = "Rijen gescheiden door een verticale streep. De kolommen kton_jr zijn het kental maal het areaal uit de brontabel, dus wat de eindtoestand landelijk zou opleveren als het model precies dat areaal alloceert.";
	}
}
