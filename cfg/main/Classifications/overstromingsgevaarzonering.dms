//
// Specificeert de container 'Overstromingsgevaarzonering'.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Overstromingsgevaarzonering : using = "Units"
{
	unit<UInt8> zoneringK: NrOfRows = 6
	{
		attribute<String> name       : ['Nihil','Gering_20','Gering_200','Enigszins_gevaarlijk','Gevaarlijk','Zeer_gevaarlijk'];
		attribute<String> Label      := name, DialogType = "LabelText";

		attribute<Bool>   VraagtAangepastBouwen : [FALSE, FALSE, TRUE, TRUE, TRUE, TRUE]
		, IntegrityCheck = "all(this == (lowercase(name) == 'gering_200' || lowercase(name) == 'enigszins_gevaarlijk' || lowercase(name) == 'gevaarlijk' || lowercase(name) == 'zeer_gevaarlijk'))" //bindt de vlag aan de namen, zodat de lijst niet stil meeschuift als er een zone bij komt
		, Descr = "Vraagt deze gevaarzone dat er aangepast wordt gebouwd? Zone 2 tot en met 5, dus alles vanaf Gering_200.

					Let op dat dit geen tweede waarheid naast VariantParameters/VariantK/GevaarRegimeZone0 tot en met 5 wil zijn. Die kolommen bepalen per variant welk bouwregime een zone krijgt en blijven leidend voor de zeef. Deze vlag zegt alleen waar de kostenkant een ophoging tegen overstroming moet inrekenen, en die kant staat in BaseData en kent de variant niet. Vandaag vallen de twee samen: NbSMax en NbSGenuanceerd zetten zone 2 tot en met 5 op BouwenMetMaatregelen, en dat zijn ook precies de varianten waar VariantK/BodemdalingkostenInSaldo aanstaat en de kostenketen dus meedoet. Verzet iemand een GevaarRegimeZone, zet deze vlag dan mee.

					Dat die twee uit elkaar kunnen lopen is een gevolg van de plek en niet van de bedoeling. Zodra de bouwwijze van de ontwikkelpakketten is losgekoppeld en per cel uit de benodigde ophoging volgt, komt de eis aan de variantkant te staan en kan deze vlag weg. Zie #681 en #505.";
		attribute<UInt32> BrushColor : DialogType = "BrushColor",
		[
			rgb(127,127,127), rgb(218,218,235), rgb(188,184,217), rgb(158,154,200), rgb(106, 81,163), rgb( 63,  0,125)
		];
		
		container V := for_each_nedv(name, string(id(.)) + '[..]', void, .);
	}
}

// Zone Gevaar	Overstromingskarakteristieken
// 0	Nihil	Niet-overstroombaar
// 1	Gering(schadegevaar < 20 €/jr)	Overstroombaar,onbekende (zeer kleine) kans
// 2	Gering(schadegevaar < 200 €/jr)	Overstroombaar,onbekende (zeer kleine) kans
// 3	Enigszins gevaarlijk (schadegevaar 200- 2000 €/jr)	Overstroombaar, kleine kans en/of beperkte waterdiepte
// 4	Gevaarlijk(schadegevaar 2000- 20.000 €/jr)	Overstroombaar, middelgrote kans en middelgrote waterdiepte
// 5	Zeer gevaarlijk(schadegevaar > 20.000 €/jr)	Overstroombaar, grote kans en grote waterdiepte
