//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Welke CBS Gebiedsindelingen jaren zijn er Of er alleen een gegeneraliseerde versie van de gebiedsindelingen
// aanwezig is Lees de CBS Gebiedsindelingen van het betreffende jaar uit de geopackages. Laadt via #include:
// Impl.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container RegioIndelingen
{ 
	#include<Impl.dms>
	
	unit<UInt32> CBS_Gebiedsindelingen_jaren := range(uint32, 2015, 2025)
	, Descr = "Welke CBS Gebiedsindelingen jaren zijn er"
	{
		attribute<UInt32> jaar            := id(.);
		attribute<String> name            := 'Y'+string(jaar);
		attribute<Bool>   IsGeneraliseerd := jaar < 2019, Descr = "Of er alleen een gegeneraliseerde versie van de gebiedsindelingen aanwezig is";
	}
	container CBS :=
		for_each_ne(
			CBS_Gebiedsindelingen_jaren/name
			, 'Read_Gebiedsindelingen_gpkg_T('+quote(string(CBS_Gebiedsindelingen_jaren/jaar))+')'
		), Descr = "Lees de CBS Gebiedsindelingen van het betreffende jaar uit de geopackages."
	{
		container Gekozen := ='Y'+/ModelParameters/RegioIndelingen_CBSjaar
		, Descr = "De jaargang van de CBS-gebiedsindelingen waarop het model rekent, gezet in ModelParameters/RegioIndelingen_CBSjaar. Hier stond last(CBS_Gebiedsindelingen_jaren), waardoor een gebiedsindelingenjaar erbij de regiogrenzen verzette als bijvangst van een brondata-update. Dat is stil voor alles wat op rijvolgorde aan een regio-eenheid hangt, en de TIGRIS-claim-csv's doen dat (#691). Elke andere bron in ModelParameters draagt zijn jaargang als parameter; deze week daarvan af en doet dat nu niet meer.";
	}

	Template Read_Gebiedsindelingen_gpkg_T
	{
		parameter<String> jaar;
		//
		parameter<Bool>   IsGeneraliseerd     := rjoin('Y'+jaar, CBS_Gebiedsindelingen_jaren/name, CBS_Gebiedsindelingen_jaren/IsGeneraliseerd);
		parameter<String> gegeneraliseerd_str := IsGeneraliseerd ? '_gegeneraliseerd' : '_niet_gegeneraliseerd', Descr = "Of de gegeneraliseerde versie van de gebiedsindelingen gebruikt moet worden, als het kan liever de niet-gegeneraliseerde versie gebruiken.";
		
		container gpkg
		:	StorageName     = "='%RSo_DataDir%/RegioIndelingen/cbsgebiedsindelingen'+jaar+'.gpkg'"
		, 	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	SyncMode        = "AllTables"
		,	DialogData      = "rdc_meter_base"
		,	URL             = "https://www.cbs.nl/nl-nl/dossier/nederland-regionaal/geografische-Data/cbs-gebiedsindelingen"
		,	KeepData        = "TRUE"
		{
			unit<UInt32> Provincie_gegeneraliseerd
			{
				attribute<String>    Label := statnaam;	
			}
		}
		
		unit<UInt32> Buurt     := ='gpkg/buurt'+gegeneraliseerd_str
		, Descr = "CBS Buurtindeling"
		{
			attribute<rdc_meter> geometry                                 (poly) := ='gpkg/buurt'+gegeneraliseerd_str+'/geometry[rdc_meter]';
			attribute<String>    Label                                           := statnaam;
			attribute<String>    name                                            := AsItemName(statnaam);
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			// container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		}
		unit<UInt32> Wijk      := ='gpkg/wijk'+gegeneraliseerd_str
		, Descr = "CBS Wijkindeling"
		{
			attribute<rdc_meter> geometry                                 (poly) := ='gpkg/wijk'+gegeneraliseerd_str+'/geometry[rdc_meter]';
			attribute<String>    Label                                           := statnaam;
			attribute<String>    name                                            := AsItemName(statnaam);
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			
			attribute<Bool>      IsSintOedenrode := LowerCase(name) == 'sint_oedenrode';
		}
		unit<UInt32> Gemeente  := ='gpkg/gemeente'+gegeneraliseerd_str
		, Descr = "CBS Gemeenteindeling"
		{
			attribute<rdc_meter>      geometry_org                             (poly) := ='gpkg/gemeente'+gegeneraliseerd_str+'/geometry[rdc_meter]';
			attribute<rdc_meter_base> geometry_base                            (poly) := ='gpkg/gemeente'+gegeneraliseerd_str+'/geometry';
			attribute<rdc_meter>      geometry                                 (poly) := geos_union_polygon(metIJburg/geometry, metIJburg/Gemeente_rel), Descr = "Gemeentegrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren. Deze provincie grenzen bepalen namelijk het grid domain.";
			attribute<String>         Label                                           := statnaam;
			attribute<String>         name                                            := AsItemName(statnaam);
			attribute<UInt32>         gem_nr                                          := uint32(right(statcode, 4));
			attribute<.>              Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<.>              Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<.>              Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
			attribute<.>              Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
			
			attribute<Impl/Read_NVM_2011_COROP2022Begrenzing_shp/ZonderBuitengebied>  NVM_2011_rel := point_in_polygon(centroid_or_mid(geometry), Impl/Read_NVM_2011_COROP2022Begrenzing_shp/ZonderBuitengebied/geometry);
			attribute<Provincie>  Provincie_rel := point_in_polygon(centroid_or_mid(geometry), Provincie/geometry);
			
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
			
			unit<UInt32> metIJburg := union_unit(., RegioIndelingen/LMSSubzone/IJburg) 
			, Descr = "Gemeentegrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren."
			{
				attribute<rdc_meter>      geometry       (poly) := union_data(., ../geometry_org, RegioIndelingen/LMSSubzone/IJburg/geometry);
				attribute<String>         Label                 := union_data(., ../statnaam, const('Amsterdam', RegioIndelingen/LMSSubzone/IJburg));
				attribute<..>             Gemeente_rel          := rlookup(lowercase(Label), lowercase(../Label));
			}
		}
		
		unit<UInt32> Gemeente_Gegeneraliseerd  := gpkg/gemeente_gegeneraliseerd
		, Descr = "CBS Gemeenteindeling"
		{
			attribute<rdc_meter>      geometry_org                             (poly) := ='gpkg/gemeente_gegeneraliseerd/geometry[rdc_meter]';
			attribute<rdc_meter>      geometry                                 (poly) := geos_union_polygon(metIJburg/geometry, metIJburg/Gemeente_rel), Descr = "Gemeentegrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren. Deze provincie grenzen bepalen namelijk het grid domain.";
			
			unit<UInt32> metIJburg := union_unit(., RegioIndelingen/LMSSubzone/IJburg) 
			, Descr = "Gemeentegrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren."
			{
				attribute<rdc_meter>      geometry       (poly) := union_data(., ../geometry_org, RegioIndelingen/LMSSubzone/IJburg/geometry);
				attribute<String>         Label                 := union_data(., ../statnaam, const('Amsterdam', RegioIndelingen/LMSSubzone/IJburg));
				attribute<..>             Gemeente_rel          := rlookup(lowercase(Label), lowercase(../statnaam));
			}
		}

		unit<UInt32> COROP     := gpkg/coropgebied_gegeneraliseerd
		, Descr = "CBS COROP indeling"
		{
			attribute<rdc_meter> geometry_org                             (poly) := gpkg/coropgebied_gegeneraliseerd/geometry[rdc_meter];
			attribute<rdc_meter> geometry                                 (poly) := geos_union_polygon(metIJburg/geometry, metIJburg/COROP_rel), Descr = "COROPgrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren. Deze provincie grenzen bepalen namelijk het grid domain.";
			attribute<String>    Label                                           := statnaam;
			attribute<String>    name                                            := AsItemName(statnaam);
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
			attribute<.>         Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
			parameter<Bool>      HeeftBuitengebied                               : [FALSE];
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
			
			unit<UInt32> metIJburg := union_unit(., RegioIndelingen/LMSSubzone/IJburg) 
			, Descr = "COROPgrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren."
			{
				attribute<rdc_meter>      geometry       (poly) := union_data(., ../geometry_org, RegioIndelingen/LMSSubzone/IJburg/geometry);
				attribute<String>         Label                 := union_data(., ../statnaam, const('Groot-Amsterdam', RegioIndelingen/LMSSubzone/IJburg));
				attribute<..>             COROP_rel             := rlookup(lowercase(Label), lowercase(../Label));
			}
		}

		unit<UInt32> Provincie := gpkg/Provincie_gegeneraliseerd
		, Descr = "CBS Provincie indeling"
		{
			attribute<rdc_meter_base> geometry_org_base                        (poly) := gpkg/Provincie_gegeneraliseerd/geometry[rdc_meter_base];
			attribute<rdc_meter_base> geometry_base                            (poly) := geos_union_polygon(metIJburg/geometry_base, metIJburg/Provincie_rel), Descr = "Provinciegrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren. Deze provincie grenzen bepalen namelijk het grid domain.";
			attribute<rdc_meter>      geometry                                 (poly) := geometry_base[rdc_meter];
		
			attribute<String>    Label                                           := statnaam;
			attribute<String>    name                                            := replace(AsItemName(statnaam), 'Fryslân', 'Friesland');
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
			attribute<.>         Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
			attribute<NL>        NL_rel                                          := const(NL/V/Nederland, .);
			
			parameter<Bool>      HeeftBuitengebied                               : [FALSE];
			
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
			
			unit<UInt32> StudyArea := select_with_org_rel_with_attr_by_cond(., lowercase(ModelParameters/StudyArea) == lowercase('Nederland') ? const(TRUE,.) : name == ModelParameters/StudyArea)
			{
				attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
				attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
				attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
				attribute<.>         Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
				
				container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
			}

			unit<UInt32> metIJburg := union_unit(., RegioIndelingen/LMSSubzone/IJburg) //Provincie_metIJburg
			, Descr = "Provinciegrenzen met IJburg geunioned. Zoals we in het water wel woningen kunnen alloceren."
			{
				attribute<rdc_meter_base> geometry_base  (poly) := union_data(., ../geometry_org_base, RegioIndelingen/LMSSubzone/IJburg/geometry_base);
				attribute<String>         Label                 := union_data(., ../statnaam, const('Noord-Holland', RegioIndelingen/LMSSubzone/IJburg));
				attribute<..>             Provincie_rel         := rlookup(lowercase(Label), lowercase(../Label));
			}
		}
	}
	
	unit<UInt32> Provincie := CBS/Gekozen/Provincie
	, Descr = "CBS Provincie indeling in de jaargang van ModelParameters/RegioIndelingen_CBSjaar"
	{
		attribute<rdc_meter_base> geometry_base (poly) := CBS/Gekozen/Provincie/geometry_base;
		attribute<String>         name                 := CBS/Gekozen/Provincie/name;
		
		attribute<Landsdelen> Landsdelen_rel := switch(
													case(id(.) == v/Groningen || id(.) == v/Drenthe || id(.) == v/Zeeland || id(.) == v/Limburg || id(.) == v/Friesland || id(.) == v/Overijssel, Landsdelen/v/Perifeer)
													, case(id(.) == v/Gelderland  || id(.) == v/Noord_Brabant || id(.) == v/Flevoland, Landsdelen/v/Intermediate)
													, case(id(.) == v/Noord_Holland || id(.) == v/Zuid_Holland || id(.) == v/Utrecht, Landsdelen/v/Randstad)
													, null_b
												);
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		container Per_Prov :=
			for_each_nex(
				Provincie/name
				, 'select_with_attr_by_cond(Provincie, name == '+quote(Provincie/name)+')'
				, uint32
			);
		
		unit<uint32> StudyArea := select_with_org_rel_with_attr_by_cond(., IsDefined(point_in_polygon(centroid_or_mid(geometry), Geography/rdc_meter/geometry)) || name == 'nw_Friesland')
		{
			attribute<rdc_meter> geometry                                 (poly) := ../geometry[org_rel];
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<.>         Per_AdminDomain_Fijn              (AdminDomain) := poly2grid(geometry, AdminDomain), Descr = "Dezelfde toewijzing, maar rechtstreeks op AdminDomain gerasterd in plaats van via AllocDomain (#748). De indicatorentabellen lezen deze en niet Per_AdminDomain hierboven, omdat de weggeschreven kaarten op IsStudyArea_AdminDomain zijn gemaskeerd en dat ook een rasterisering op 25 meter is. Met de omweg over 100 meter vielen de studiegebiedcellen waarvan de bovenliggende cel van 100 meter geen regio kreeg stil uit elke kolom. Per_AdminDomain zelf blijft ongewijzigd, want die voedt via Per_CompactedAdminDomain ook de allocatie.";
			attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<.>         per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, per_AdminDomain);
			attribute<.>         per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, per_AllocDomain);
		}	
	}
	
	unit<UInt8> Landsdelen : NrOfRows = 3
	{
		attribute<rdc_meter> geometry (poly) := geos_union_polygon(Provincie/geometry, Provincie/Landsdelen_rel);
		attribute<String>    name            : ['Randstad', 'Intermediate', 'Perifeer'];
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt32> Buurt := CBS/Gekozen/Buurt
	, Descr = "CBS Buurt indeling in de jaargang van ModelParameters/RegioIndelingen_CBSjaar"
	{
		attribute<rdc_meter> geometry (poly) := SourceData/RegioIndelingen/CBS/Gekozen/Buurt/geometry[rdc_meter];
		attribute<String>    name            := CBS/Gekozen/Buurt/name;
		
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
	}
	
	unit<UInt32> Gemeente := CBS/Gekozen/Gemeente
	, Descr = "CBS Gemeente indeling in de jaargang van ModelParameters/RegioIndelingen_CBSjaar"
	{
		attribute<rdc_meter> geometry (poly) := SourceData/RegioIndelingen/CBS/Gekozen/Gemeente/geometry[rdc_meter];
		attribute<String>    name            := CBS/Gekozen/gemeente/name;
		
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AdminDomain_Fijn              (AdminDomain) := poly2grid(geometry, AdminDomain), Descr = "Dezelfde toewijzing, maar rechtstreeks op AdminDomain gerasterd in plaats van via AllocDomain (#748). De indicatorentabellen lezen deze en niet Per_AdminDomain hierboven, omdat de weggeschreven kaarten op IsStudyArea_AdminDomain zijn gemaskeerd en dat ook een rasterisering op 25 meter is. Met de omweg over 100 meter vielen de studiegebiedcellen waarvan de bovenliggende cel van 100 meter geen regio kreeg stil uit elke kolom. Per_AdminDomain zelf blijft ongewijzigd, want die voedt via Per_CompactedAdminDomain ook de allocatie.";
		attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		
		// unit<UInt32> Selectie := select_with_attr_by_cond(Gemeente, name == 'Baarn');
	}
	
	unit<UInt32> COROP := CBS/Gekozen/COROP
	, Descr = "CBS COROP indeling in de jaargang van ModelParameters/RegioIndelingen_CBSjaar"
	{
		attribute<rdc_meter> geometry (poly) := SourceData/RegioIndelingen/CBS/Gekozen/COROP/geometry[rdc_meter];
		attribute<String>    name            := CBS/Gekozen/COROP/name;
		
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		
		unit<uint32> StudyArea := select_with_org_rel_with_attr_by_cond(., IsDefined(point_in_polygon(centroid_or_mid(geometry), Geography/rdc_meter/geometry)) || name == 'nw_Friesland')
		{
			attribute<.>         per_AdminDomain                   (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<.>         Per_AdminDomain_Fijn              (AdminDomain) := poly2grid(geometry, AdminDomain), Descr = "Hetzelfde als per_AdminDomain hierboven, onder de naam die de indicatorensjablonen sinds #748 lezen. Deze indeling rasterde als enige polygoonindeling al op AdminDomain en verliest dus geen studiegebied; hij is de controle waarmee in #748 is vastgesteld dat het de omweg over AllocDomain is die de andere indelingen cellen kost.";
			attribute<.>         per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<.>         per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, per_AdminDomain);
			attribute<.>         per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, per_AllocDomain);
		}	
	}
	
	unit<UInt32> NL : NrOfRows = 1
	, Descr = "Nederland als geheel op basis van provincie grenzen. Dit bepaald het grid domain."
	{
		attribute<rdc_meter_base>  geometry_base (poly)                       := union_data(., geos_union_polygon(SourceData/RegioIndelingen/CBS/Gekozen/Provincie/geometry_base))
		, Descr = "De landsgrens als unie van de provincies uit de gekozen CBS-jaargang. Dit is niet alleen een kaartje: via Geography/StudyAreas en IsStudyArea bepaalt deze geometrie welke cellen in CompactedAllocDomain en CompactedAdminDomain zitten, en dus de omvang en de rijvolgorde van de domeinen waarop de hele allocatie rekent. Tussen de jaargangen 2024 en 2026 scheelt de unie 132,8 ha langs de kust; het bezwaar tegen meebewegen is niet de omvang maar dat de definitie van het allocatiedomein geen bijvangst van een brondata-update hoort te zijn (#691).";
		attribute<rdc_meter>       geometry (poly)                            := geometry_base[rdc_meter];
		attribute<String>          name                                       := const('Nederland',.);
		
		attribute<.>          per_rdc_25m                       (rdc_25m)     := poly2grid(geometry, rdc_25m);
		attribute<.>          per_rdc_250m                      (rdc_250m)    := poly2grid(geometry, rdc_250m);
		attribute<.>          Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AdminDomain_Fijn              (AdminDomain) := poly2grid(geometry, AdminDomain), Descr = "Dezelfde toewijzing, maar rechtstreeks op AdminDomain gerasterd in plaats van via AllocDomain (#748). De indicatorentabellen lezen deze en niet Per_AdminDomain hierboven, omdat de weggeschreven kaarten op IsStudyArea_AdminDomain zijn gemaskeerd en dat ook een rasterisering op 25 meter is. Met de omweg over 100 meter vielen de studiegebiedcellen waarvan de bovenliggende cel van 100 meter geen regio kreeg stil uit elke kolom. Per_AdminDomain zelf blijft ongewijzigd, want die voedt via Per_CompactedAdminDomain ook de allocatie.";
		attribute<.>          Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>          Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		attribute<.>          Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
		attribute<Bool>       IsNederland_25m                       (rdc_25m) := per_rdc_25m == 0;
		attribute<Bool>       IsNederland_250m                     (rdc_250m) := per_rdc_250m == 0;
		attribute<Bool>       IsNederland_AllocDomain           (AllocDomain) := Per_AllocDomain == 0;
		attribute<Bool>       IsNederland_AdminDomain           (AdminDomain) := Per_AdminDomain == 0;
		attribute<Bool>       IsRegio                           (AllocDomain) := IsNederland_AllocDomain;
		
		parameter<Bool> HeeftBuitengebied: [FALSE];
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		unit<UInt32> NL_BoundingBox : NrOfRows = 1
		{
			parameter<rdc_meter>  union_NL            (poly) := geos_union_polygon(NVM/geometry);
			parameter<rdc_meter>  BoudingBox_minus_NL (poly) := geos_difference(union_polygon,union_NL);
			
			unit<UInt32> OutsideNL : NrOfRows = 1
			{
				attribute<rdc_meter> geometry (poly) := union_data(.,BoudingBox_minus_NL[rdc_meter]);
			}
			
			// meter_f64 en niet meter: rdc_meter is een DPoint, en point_xy heeft dan float64-argumenten
			// nodig. Met float32 vindt hij alleen de fpoint-variant en faalt de operatorkeuze. Zie de
			// gelijke constructie in Geography/CreateTiles.dms, die daar wel al op float64 rekent.
			parameter<meter_f64> x_min  := 0[meter_f64];
			parameter<meter_f64> x_max  := 280000[meter_f64];
			parameter<meter_f64> y_min  := 300000[meter_f64];
			parameter<meter_f64> y_max  := 625000[meter_f64];
			
			parameter<rdc_meter> top_left     := point_xy(x_min,y_max, rdc_meter);
			parameter<rdc_meter> top_right    := point_xy(x_max,y_max, rdc_meter);
			parameter<rdc_meter> bottom_left  := point_xy(x_min,y_min, rdc_meter);
			parameter<rdc_meter> bottom_right := point_xy(x_max,y_min, rdc_meter);
			
			unit<UInt32> point_set    : NrOfRows = 5
			{
				attribute<rdc_meter>      point        := union_data(., top_left, top_right, bottom_right, bottom_left, top_left);
				attribute<NL_BoundingBox> Sequence_rel := const(0, .);
				attribute<.>              ordinal      := id(.);
			}
			
			attribute<rdc_meter>    polygon       (poly) := points2sequence(point_set/point, point_set/Sequence_rel, point_set/ordinal);
			parameter<rdc_meter>    union_polygon (poly) := geos_union_polygon(polygon);
		}
		
		unit<UInt32> StudyArea := select_with_org_rel(IsDefined(point_in_polygon(centroid_or_mid(geometry), Geography/rdc_meter/geometry)))
		{
			attribute<rdc_meter>         geometry                                 (poly) := ../geometry[org_rel];
			attribute<.>                 Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<StudyArea>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<StudyArea>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
			attribute<StudyArea>         Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
		}
	}
	
	container Impl_BegrenzingBebouwdGebied
	:	StorageName     = "='%RSo_DataDir%/RegioIndelingen/BegrenzingBebouwdGebied_'+ModelParameters/BegrenzingBebouwdGebied_jaar+'.gpkg'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	SyncMode        = "AllTables"
	,	DialogData      = "rdc_meter_base"
	,	KeepData        = "TRUE"
	,	Descr           = "Begrenzing bebouwd gebied, eigen afleiding in het project BegrenzingBebouwdGebied. Vervangt het VROM-raster uit 2003 op 100 meter als afbakening van bestaand bebouwd gebied.";

	unit<UInt32>  BegrenzingBebouwdGebied := Impl_BegrenzingBebouwdGebied/Export_gpkg
	, Descr = "Bebouwd gebied per peiljaar, als vlakken op volle resolutie. Het peiljaar staat in ModelParameters/BegrenzingBebouwdGebied_jaar."
	{
		attribute<rdc_meter> geometry        (poly)        := Impl_BegrenzingBebouwdGebied/Export_gpkg/geometry[rdc_meter];
		attribute<float64>   area_ha                       := Impl_BegrenzingBebouwdGebied/Export_gpkg/area_ha;
		attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain), Descr = "Rechtstreeks op AdminDomain, niet via AllocDomain, zodat de resolutie van de begrenzing behouden blijft.";
		attribute<Bool>      Is_BebouwdGebied(AdminDomain) := IsDefined(Per_AdminDomain);

		attribute<.>         Per_rdc_100m    (rdc_100m)    := poly2grid(geometry, rdc_100m), Descr = "Hetzelfde op 100 meter, alleen om het inwonertal hieronder te kunnen optellen: de CBS-vierkanten liggen op dat raster.";

		attribute<float32>   Populatie                     := sum(float32(SourceData/Bevolking/CBS_vierkanten/aantal_inwoners/Y2023), Per_rdc_100m)
		, Descr = "Inwoners per bebouwd gebied, opgeteld uit de CBS-vierkanten van 100 meter (#749). Vervangt het inwonertal dat tot dan alleen als BEV11TOT bij de bevolkingskernen van 2011 hing.

					De combinatie is consistenter dan wat er stond: de begrenzing komt uit peiljaar 2022 en het inwonertal uit 2023, terwijl kern en inwonertal daarvoor allebei uit 2011 kwamen. En het is dezelfde begrenzing die de zeef, de trede en de buitenstedelijkheidsindicator sinds #749 gebruiken, dus er is nog maar een definitie van bebouwd gebied in het model.

					Twee dingen om te weten bij het gebruik. De CBS-vierkanten zijn afgerond op vijftallen en alleen gepubliceerd waar er inwoners zijn, zodat het landelijk totaal op 17,18 miljoen komt tegen ongeveer 17,8 miljoen werkelijk, een onderschatting van enkele procenten die vrijwel geheel uit die afronding komt. Voor de grootteklassen hieronder maakt dat weinig uit: van de 3.106 gebieden liggen er binnen een marge van vier procent maar twee net boven en vier net onder de 20.000, en een net boven en een net onder de 100.000. Een systematische onderschatting van die orde verzet dus hooguit een handvol gebieden. En een vierkant dat op de grens van twee gebieden ligt gaat via poly2grid in zijn geheel naar een van beide.";

		attribute<Bool>      isMeerdan20Kinw               := Populatie >= 20000f;
		attribute<Bool>      isMeerdan100Kinw              := Populatie >= 100000f;
		attribute<Bool>      isMinderdan20Kinw             := Populatie <  20000f;
	}
	
	unit<UInt32>  NVM := Impl/Read_NVM_2011_COROP2022Begrenzing_shp/ZonderBuitengebied
	, Descr = "NVM 2011 gebieden, waar de grenzen geharmoniseerd zijn met de COROP2022 begrenzing zonder buitengebied"
	{
		attribute<rdc_meter>    geometry_old             (poly)                 := Impl/Read_NVM_2011_COROP2022Begrenzing_shp/ZonderBuitengebied/geometry;
		attribute<rdc_meter>    geometry                 (poly)                 := bg_outer_multi_polygon(geos_union_polygon(CBS/Gekozen/Gemeente_Gegeneraliseerd/geometry[rdc_meter], point_in_polygon(centroid_or_mid(CBS/Gekozen/Gemeente_Gegeneraliseerd/geometry[rdc_meter]), geometry_old)))
		, Descr = "De NVM-regio is niet de shapefile zelf maar een herbouw daaruit: elke gemeente uit de gekozen CBS-jaargang gaat in haar geheel naar het oude NVM-2011-vlak waarin haar zwaartepunt valt. De 76 rijen en hun volgorde komen wel uit de shapefile en bewegen dus niet mee; alleen de geometrie doet dat, en daarmee welke LMS-subzones bij het aggregeren van de TIGRIS-claims aan welke regio worden toegerekend (#691).

								Let op wat die regel bij een herindeling doet: de hele nieuwe gemeente verspringt naar de regio van het nieuwe zwaartepunt, ook als het grootste deel van de oude gemeenten in de andere regio lag. Tussen de jaargangen 2019 en 2024 wisselde zo 29.891 ha van regio. Het duidelijkste geval is Uden, dat via de vorming van gemeente Maashorst van de regio Uden_eo naar Oss_eo is gegaan; de regio Uden_eo bevat Uden dus niet meer. Dat is een bestuurlijke herindeling die de woningmarktafbakening uit 2011 verzet, en het is een open vraag of dat de bedoeling is.";

		attribute<.>            Per_AdminDomain          (AdminDomain)          := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AdminDomain_Fijn              (AdminDomain) := poly2grid(geometry, AdminDomain), Descr = "Dezelfde toewijzing, maar rechtstreeks op AdminDomain gerasterd in plaats van via AllocDomain (#748). De indicatorentabellen lezen deze en niet Per_AdminDomain hierboven, omdat de weggeschreven kaarten op IsStudyArea_AdminDomain zijn gemaskeerd en dat ook een rasterisering op 25 meter is. Met de omweg over 100 meter vielen de studiegebiedcellen waarvan de bovenliggende cel van 100 meter geen regio kreeg stil uit elke kolom. Per_AdminDomain zelf blijft ongewijzigd, want die voedt via Per_CompactedAdminDomain ook de allocatie.";
		attribute<.>            Per_AllocDomain          (AllocDomain)          := poly2grid(geometry, AllocDomain);
		attribute<.>            Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		attribute<.>            Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
		parameter<Bool>         HeeftBuitengebied                               : [FALSE];
		attribute<rdc_meter>    Centroid := centroid_or_mid(geometry);
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		unit<uint32> StudyArea := select_with_org_rel_with_attr_by_cond(., IsDefined(point_in_polygon(centroid_or_mid(geometry), Geography/rdc_meter/geometry)) || name == 'nw_Friesland')
		{
			attribute<.>         per_AdminDomain                   (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<.>         per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<.>         per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, per_AdminDomain);
			attribute<.>         per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, per_AllocDomain);
		}	
	}
	
	unit<UInt32> RES := unique(Impl/Read_GemeenteRES_2018_gdb/RESnaam)
	{
		attribute<String>    Label                                           := values;
		attribute<rdc_meter> geometry                                 (poly) := geos_union_polygon(Impl/Read_GemeenteRES_2018_gdb/geometry, rlookup(lowercase(Impl/Read_GemeenteRES_2018_gdb/RESnaam), lowercase(values)));
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		parameter<Bool>      HeeftBuitengebied                               := FALSE;
		attribute<String>    name                                            := AsItemName(Label);
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt32> LMSSubzone := Impl/Read_LMSSubzone_shp
	, Descr = "LMS Subzones, zoals gebruikt in de woningmarktmodellen van Amsterdam, Rotterdam en Den Haag"
	{
		attribute<rdc_meter_base>    geometry_base                           (poly) := Impl/Read_LMSSubzone_shp/geometry_base;
		attribute<rdc_meter>         geometry_rd                             (poly) := geometry_base[rdc_meter];
		attribute<rdc_meter>         Centroid                                       := centroid_or_mid(geometry_rd);
		attribute<UInt32>            code                                           := uint32(ZONE_id);
		attribute<String>            name0                                          := CBS/Y2024/Gemeente/statnaam[Relaties/Gemeente2024] + '_' + string(ZONE_id);
		attribute<String>            name                                           := !IsDefined(name0) ? 'Amsterdam_'+string(ZONE_id) : AsItemName(name0); //replace(name0, '/', '_', '-', '_', ' ', '_','(','',')','','\''','','â','a','ú','u',',','','.','');
		
		//IJburg-hack om ervoor te zorgen dat IJburg niet water is.
		parameter<.>                 IJburg1_proxy                                  := V/Amsterdam_622;
		parameter<.>                 IJburg2_proxy                                  := V/Amsterdam_621;
		attribute<Bool>              IsIjburg1                                      := id(.) == IJburg1_proxy;
		attribute<Bool>              IsIjburg2                                      := id(.) == IJburg2_proxy;
		attribute<Bool>              IsIJburg2_AdminDomain             (AdminDomain) := IsIjburg2[Per_AdminDomain];
		attribute<Bool>              IsIJburg2_AllocDomain             (AllocDomain) := IsIjburg2[Per_AllocDomain];
		
		attribute<Bool>              InNl                                            := LAND == 1[uint8];
		attribute<UInt32>            LmsSubF                                         := LmsSub;
		attribute<.>                 per_rdc_100m                         (rdc_100m) := poly2grid(geometry_rd, rdc_100m);
		attribute<.>                 per_rdc_10m                           (rdc_10m) := poly2grid(geometry_rd, rdc_10m);
		attribute<.>                 Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>                 Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		attribute<.>                 Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<String>            Label                                           := name, DialogType = "LabelText";
		
		unit<UInt32> IJburg := select_with_org_rel(IsIjburg1 || IsIjburg2)
		{
			attribute<rdc_meter_base> geometry_base (poly) := ../geometry_base[org_rel];
			attribute<rdc_meter>      geometry      (poly) := geometry_base[rdc_meter];
		}
		
		container Relaties
		{
			attribute<..>                              LMSSubzone   (..) := id(..);
			attribute<CBS/Y2024/Gemeente>              Gemeente2024 (..) := point_in_polygon(centroid_or_mid(../geometry), CBS/Y2024/Gemeente/geometry_base);
			attribute<RegioIndelingen/NVM>             NVM          (..) := point_in_polygon(centroid_or_mid(../geometry_rd), RegioIndelingen/NVM/geometry);
			attribute<CBS/Gekozen/corop>                  COROP        (..) := point_in_polygon(centroid_or_mid(../geometry_rd), CBS/Gekozen/corop/geometry);
			attribute<RegioIndelingen/NL>              NL           (..) := point_in_polygon(centroid_or_mid(../geometry_rd), RegioIndelingen/NL/geometry);
		}
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt32> Grootstedelijke_agglomeraties := Impl/Read_Grootstedelijke_agglomeraties_shp
	, Descr = "Grootstedelijke agglomeraties zoals gebruikt in de Structuurvisie Infrastructuur en Ruimte (SVIR)"
	{
		attribute<String>       name                          := AsItemName(statnaam);
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>            Per_AllocDomain (AllocDomain) := poly2grid(geometry, AllocDomain);
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	} 
	
	unit<UInt32> Bevolkingskern_2011 := Impl/Read_Bevolkingskern_2011_shp
	, Descr = "Bevolkingskernen zoals gedefinieerd door het CBS in 2011.

				Alleen nog in gebruik voor het inwonertal, dus voor de buffers rond kernen boven of onder een drempel in BaseData/Omgeving/RondBevolkingskern en voor de regioklassen van de claims. De rol als bestaand bebouwd gebied is bij #749 overgegaan op SourceData/RegioIndelingen/BegrenzingBebouwdGebied, de eigen afleiding met peiljaar 2022; de twee helpers Is_BBG_AdminDomain en Is_BBG_AllocDomain zijn daarbij verwijderd omdat ze geen afnemer meer hadden.

				Deze kaart kan niet ook door de 2022-begrenzing worden vervangen zolang die geen inwonertal draagt. Zie #749."
	{
		attribute<Bool>         isMeerdan5Kinw    := Populatie >= 5000[float64];
		attribute<Bool>         isMeerdan10Kinw   := Populatie >= 10000[float64];
		attribute<Bool>         isMeerdan15Kinw   := Populatie >= 15000[float64];
		attribute<Bool>         isMeerdan20Kinw   := Populatie >= 20000[float64];
		attribute<Bool>         isMeerdan25Kinw   := Populatie >= 25000[float64];
		attribute<Bool>         isMeerdan50Kinw   := Populatie >= 50000[float64];
		attribute<Bool>         isMeerdan75Kinw   := Populatie >= 75000[float64];
		attribute<Bool>         isMeerdan100Kinw  := Populatie >= 100000[float64];
		attribute<Bool>         isMeerdan300Kinw  := Populatie >= 300000[float64];
		attribute<Bool>         isMinderdan20Kinw := Populatie < 20000[float64];
		attribute<Bool>         isMinderdan50Kinw := Populatie < 50000[float64];
		
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>            Per_AllocDomain    (AllocDomain) := poly2grid(geometry, AllocDomain);
		
		unit<UInt8> PopK : NrOfRows = 3
		, Descr = "Populatie klassen"
		{
			attribute<String> name : ['isMeerdan20Kinw','isMeerdan100Kinw','isMinderdan20Kinw'];
		}
		
		container Maak_PopK_Buffers :=
			for_each_ne(
				PopK/name
				, 'Maak_PopK_Buffers_T('+quote(PopK/name)+')'
			), Descr = "Maak voor elke bevolkingskern populatie klasse een buffer van 1km rondom de kernen"
		{
			parameter<String> Generate := 'Ready', ExplicitSuppliers = "=asList(PopK/name+'/select/split_geometry/MetBuffer/Write_Is_Buffer', ';')";
		}
		
		Template Maak_PopK_Buffers_T
		{
			parameter<String> PopK_name;
			///
			unit<UInt32> select := ='select_with_org_rel('+PopK_name+')'
			{
				attribute<rdc_meter> geometry (poly) := org_rel -> geometry;
				
				unit<UInt32> split_geometry := geos_split_polygon(geometry)
				{
					attribute<rdc_meter> Buffer1000m     (poly) := geos_buffer_multi_polygon(geometry[rdc_meter], 1000d, 4b);
					attribute<rdc_meter> MetBuffer       (poly) := Buffer1000m
					{
						attribute<..>    Per_AllocDomain (AllocDomain) := poly2grid(MetBuffer, AllocDomain);
						attribute<Bool>  Write_Is_Buffer (AllocDomain) := IsDefined(Per_AllocDomain), StorageName = "='%LocalDataProjDir%/BaseData/PopBuffers/'+PopK_name+'_'+/ModelParameters/StudyArea+'.tif'", StorageType = "tif";
						attribute<Bool>  Is_Buffer       (AllocDomain) : StorageName = "='%LocalDataProjDir%/BaseData/PopBuffers/'+PopK_name+'_'+/ModelParameters/StudyArea+'.tif'", StorageReadOnly = "TRUE", StorageType = "tif";
					}
				}
			}
		}
	}
	
	unit<uint32> Waterschap :=  impl/Read_Waterschappen_gpkg/Waterschap
	{
		attribute<rdc_meter> geometry (poly) := impl/Read_Waterschappen_gpkg/Waterschap/geometry;
		attribute<string>    label           := impl/Read_Waterschappen_gpkg/Waterschap/label;
		attribute<string>    name            := AsItemName(label);
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}

	unit<UInt32> Waterbergingsregio := union_unit(impl/Waterbergingsregios/Read_Deelgebieden_shp, impl/Waterbergingsregios/RestVanNederland)
	, Descr = "Allocatie-indeling voor de sector Waterberging: de acht veen-deelgebieden waarvoor Deltares een waterbergingsopgave levert, plus een restregio die de rest van Nederland dekt en claim 0 krijgt (ObjectVision/RSopen#575). De restregio maakt de indeling landsdekkend; zonder die regio zouden cellen buiten het veen geen allocatieregio hebben."
	, DialogData = "geometry"
	{
		attribute<rdc_meter> geometry                      (poly) := union_data(., impl/Waterbergingsregios/Read_Deelgebieden_shp/geometry, impl/Waterbergingsregios/RestVanNederland/geometry);
		attribute<string>    label                                := union_data(., impl/Waterbergingsregios/Read_Deelgebieden_shp/label,    impl/Waterbergingsregios/RestVanNederland/label), DialogType = "LabelText";
		attribute<string>    name                                 := AsItemName(label);
		attribute<bool>      IsRestRegio                          := id(.) == RestRegio_rel;
		
		parameter<.>         RestRegio_rel                        := value(#impl/Waterbergingsregios/Read_Deelgebieden_shp, .), Descr = "Index van de restregio: die staat achter de deelgebieden in de union_unit.";
		
		attribute<UInt32>    Deelgebied_rel  (AllocDomain) := poly2grid(impl/Waterbergingsregios/Read_Deelgebieden_shp/geometry, AllocDomain)[UInt32], Descr = "Alleen de acht deelgebieden gerasterd; cellen daarbuiten zijn null.";
		attribute<.>         Deelgebied_regio_rel (AllocDomain) := value(Deelgebied_rel, .), Descr = "Deelgebied_rel omgezet naar deze unit; buiten de deelgebieden nog steeds null.";
		
		attribute<.>         Per_AllocDomain                   (AllocDomain) :=
			IsDefined(NL/Per_AllocDomain)
			?	MakeDefined(Deelgebied_regio_rel, const(RestRegio_rel, AllocDomain))
			:	Deelgebied_regio_rel
		, Descr = "Cellen binnen een deelgebied krijgen dat deelgebied, de overige Nederlandse cellen de restregio. Buiten Nederland blijft de toewijzing null, net als bij de andere regio-indelingen. Zo opgebouwd in plaats van poly2grid over de restgeometrie, omdat die geometrie een groot vlak met acht gaten is en de toewijzing op de randen dan van de precisie van geos afhangt.";
		attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
		attribute<.>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		attribute<.>         Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		unit<UInt32> StudyArea := select_with_org_rel(IsDefined(point_in_polygon(centroid_or_mid(geometry), Geography/rdc_meter/geometry)))
		{
			attribute<rdc_meter> geometry                                 (poly) := ../geometry[org_rel];
			attribute<.>         Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
			attribute<StudyArea> Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<StudyArea> Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
			attribute<StudyArea> Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
		}
	}

	container Landschappen
	{
		unit<UInt32> Laagveen
		:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Begrenzing laagveengebied.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = "Grove omhullende van het laagveenlandschap: twee polygonen van 25 en 21 punten, samen ruim 1,5 miljoen ha. Overlapt de omhullenden van de andere landschappen fors, dus niet geschikt als exclusieve indeling."
		,	DialogData      = "rdc_meter"
		{
			attribute<.>    Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<bool> IsGebied        (AdminDomain) := IsDefined(Per_AdminDomain);
		}
		unit<UInt32> Rivierengebied
		:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Begrenzing rivierengebied.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = "Grove omhullende van het rivierenlandschap: een polygoon van 275 punten en ruim 344.000 ha. Zie Rivierengebied_500m_buffer voor de fijnere studiegebiedbegrenzing."
		,	DialogData      = "rdc_meter"
		{
			attribute<.>    Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<bool> IsGebied        (AdminDomain) := IsDefined(Per_AdminDomain);
		}
		unit<UInt32> Zandgebied
		:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Begrenzing zandgebied.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = "Grove omhullende van het zandlandschap: een polygoon van 47 punten en ruim 3 miljoen ha. Bedoeld om landschappen ruwweg uit elkaar te houden, niet als scherpe grens."
		,	DialogData      = "rdc_meter"
		{
			attribute<.>    Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<bool> IsGebied        (AdminDomain) := IsDefined(Per_AdminDomain);
		}
		
		unit<UInt32> Kustgebied
		:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/grid_full_1500m.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = ""
		,	DialogData      = "rdc_meter"
		{
		
		}
		
		unit<UInt32> Rivierengebied_500m_buffer
		:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Studiegebied_Rivieren_20260629.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = ""
		,	DialogData      = "rdc_meter"
		{
			unit<UInt32> StudyArea := select_with_org_rel(IsDefined(point_in_polygon(centroid_or_mid(geometry), Geography/rdc_meter/geometry)))
			{
				attribute<rdc_meter>         geometry                                 (poly) := ../geometry[org_rel];
				attribute<.>                 Per_AdminDomain                   (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
				attribute<StudyArea>         Per_AllocDomain                   (AllocDomain) := poly2grid(geometry, AllocDomain);
				attribute<StudyArea>         Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
				attribute<StudyArea>         Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
			}
		}
		
	}
}
