////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bodemkundige gegevens zoals de bodemfysische eenhedenkaart, draagkracht en kwelgevoeligheid en bodemdaling.
// Bodemfysische Eenhedenkaart Bepalen van de draagkracht en kwelgevoeligheid van de bodem en op basis daarvan of
// er anders gebouwd moet worden of dat er met maatregelen gebouwd kan worden.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bodem : using = "Classifications/Grondgebruik/Bodem"
, Descr = "Bodemkundige gegevens zoals de bodemfysische eenhedenkaart, draagkracht en kwelgevoeligheid en bodemdaling."
{

	// #657: dit stond op rdc_100m, maar het bestand is een raster van 11.200 bij 13.000 cellen van 25 bij 25 meter met
	// tiepunt (0, 625000), dus het ligt gewoon op rdc_25m. GeoDMS leest een raster op georeferentie en pakt de dichtstbijzijnde
	// cel, dus op rdc_100m werd een op de zestien pixels gelezen en de rest weggegooid. Zie de sectie over rasters die niet op
	// het modelraster liggen in .claude/skills/geodms-valkuilen. Het gevolg was zichtbaar in de koolstofindicator: elke 100
	// meter blok kreeg de waarde van een willekeurige pixel erbinnen, en cellen die op een nulpixel vielen begonnen op nul.
	attribute<ton_ha> BodemKoolstofvoorraad_src (rdc_25m)
	:	Label           = "Bodemkoolstofvoorraad bovenste 30 cm bodem"
	,	Source          = "Atlas Natuurlijk Kapitaal, bronhouder Alterra (Wageningen UR). Aangeleverd vanuit Deltares in RSopen-issue #483. Onderliggende metadata: nationaalgeoregister, dataset c207ab90-f6a0-4f70-85ca-1eb1961080d5."
	,	URL             = "https://www.atlasnatuurlijkkapitaal.nl/natuurlijk-kapitaal/koolstofvastlegging"
	,	Descr           = "Koolstofvoorraad in de bovenste 30 cm van de bodem voor heel Nederland, in ton C per hectare. "
					      "De kaart is gemaakt door de landgebruikskaart (Basiskaart Natuur 2004) te combineren met de bodemkaart 1:50.000 (elf hoofdbodemgroepen), zie de Groot et al. (2005). "
					      "Per combinatie van hoofdbodemgroep en landgebruikstype is een gemiddelde koolstofvoorraad bepaald op basis van de Landelijke Steekproef Kaarteenheden (LSK), waarin op circa 1.500 locaties bodemprofielen zijn bemonsterd en geanalyseerd, zie Lesschen et al. (2012). "
					      "De hoogste voorraden liggen in veengebieden, de laagste in zandgebieden. "
					      "Toelichting op het achterliggende model: https://www.atlasnatuurlijkkapitaal.nl/documenten/carbon-sequestration. "
					      "Bedoeld gebruik in RSopen: startvoorraad koolstof in het basisjaar voor de indicator koolstofopslag en -vastlegging, zie https://github.com/ObjectVision/RSopen/wiki/Carbon-Storage-and-Sequestration."
	,	StorageName     = "%RSo_DataDir%/Omgeving/Bodem/altr_a04_20141201_gi_bodemC.tif"
	,	StorageType     = "gdal.grid"
	,	StorageReadOnly = "True";

	attribute<ton_ha> BodemKoolstofvoorraad (rdc_25m) := BodemKoolstofvoorraad_src < -1e38[ton_ha] ? null_f[ton_ha] : BodemKoolstofvoorraad_src
	,	Label = "Bodemkoolstofvoorraad bovenste 30 cm bodem, zonder vulwaarden"
	,	Descr = "Zelfde kaart als BodemKoolstofvoorraad_src, met de vulwaarde voor ontbrekende gegevens (-3,402823e+38, de minimale float32) op missing gezet. "
			  "De kaart wordt sinds #657 op de eigen resolutie van 25 meter gelezen; daarvoor stond hij op rdc_100m en werd een op de zestien pixels gebruikt. "
			  "Het gemiddelde en het maximum staan in de diagnose-items hieronder, zodat ze niet in een Descr verouderen.";

	parameter<uint32>  NrCellenMetWaarde := sum(uint32(IsDefined(BodemKoolstofvoorraad))), Descr = "Controlegetal: aantal cellen van rdc_25m waar de bron een waarde geeft.";
	parameter<ton_ha>  GemiddeldeVoorraad := mean(BodemKoolstofvoorraad), Descr = "Controlegetal: gemiddelde koolstofvoorraad over de cellen met een waarde.";
	parameter<ton_ha>  MaximaleVoorraad   := max(BodemKoolstofvoorraad), Descr = "Controlegetal: hoogste koolstofvoorraad in de kaart.";

	unit<UInt32> BOFEK 
	: 	StorageName = "%RS_Lb_DataDir%/Landgebruik/BOFEK_2020.shp"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogData      = "rdc_meter"
	,	Descr = "Bodemfysische Eenhedenkaart"
	{
		attribute<BOFEK_K> BOFEK_rel := rlookup(uint32(BOFEK2020), BOFEK_K/EK);
		attribute<bool>    IsVeen    :=  BOFEK_K/IsVeen[BOFEK_rel];
		attribute<.>       per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<bool>    IsVeen_grid     (AdminDomain) := IsVeen[per_AdminDomain];
		attribute<uint32>  BOFEK_CODE      (AdminDomain) := uint32(BOFEK2020)[per_AdminDomain];


	}

	container DraagkrachtKwel
	: Descr = "Bepalen van de draagkracht en kwelgevoeligheid van de bodem en op basis daarvan of er anders gebouwd moet worden of dat er met maatregelen gebouwd kan worden."
	, Source = "Expert judgement Gilbert Maas, WUR, via Arjen Koekoek, stichting CAS, voorjaar 2019"
	{
		parameter<String> SrcRef := '%RSo_DataDir%/Omgeving/Bodem/risico_draagkracht_openformat';
		
		attribute<meter> DraagkrachtSrc (rdc_100m)
		:	StorageName     = "= SrcRef + '/DANK024a_draagkracht_totale_zetting1.tif'"
		,	StorageType     = "gdal.grid"
		,	StorageReadOnly = "True";
		
		attribute<meter> Draagkracht (rdc_100m) := DraagkrachtSrc = -9999[meter] ? (0/0)[meter] : DraagkrachtSrc;
		
		attribute<Float32> KwelSrc (rdc_100m)
		:	StorageName     = "= SrcRef + '/PKS_Klimaateffecten_Wateroverlast_Kwel_en_infiltratie_Huidig_v15_t0_uit1.tif'"
		,	StorageType     = "gdal.grid"
		,	StorageReadOnly = "True";
		
		attribute<Float32> Kwel (rdc_100m) := KwelSrc > -50f ? KwelSrc : (0/0)[float32];
		
		attribute<Float32> RisicoklasseDikteVeenlaagFlevoland0 (rdc_100m)
		:	StorageName     = "= SrcRef + '/DikteVeenlaag1.tif'"
		,	StorageType     = "gdal.grid"
		,	StorageReadOnly = "True";
		attribute<Float32> RisicoklasseDikteVeenlaagFlevoland (rdc_100m) := RisicoklasseDikteVeenlaagFlevoland0 < 0.01f ? null_f : RisicoklasseDikteVeenlaagFlevoland0;
		
		attribute<Float32> RisicoklassePleistoceenFlevoland0 (rdc_100m)
		:	StorageName     = "= SrcRef + '/TopPleistoceen.tif'"
		,	StorageType     = "gdal.grid"
		,	StorageReadOnly = "True";
		attribute<Float32> RisicoklassePleistoceenFlevoland (rdc_100m) := RisicoklassePleistoceenFlevoland0 < -1000f ? null_f : RisicoklassePleistoceenFlevoland0;

		attribute<Bool> AndersBouwen (rdc_100m) := 
			Draagkracht >= 0.5[meter] ||
			Kwel <= -2f ||
			(RisicoklassePleistoceenFlevoland <= -10f ||
			RisicoklasseDikteVeenlaagFlevoland > 180f);
		
		attribute<Bool> BouwenMetMaatregelen (rdc_100m) :=
			(Draagkracht >= 0.1[meter] && Draagkracht < 0.5[meter]) ||
			(Kwel > -2f && Kwel <= -0.5f) &&
			!AndersBouwen;
	}
	
	container Bodemdaling
	{
		container Bron
		: Descr = "De aangeleverde tif. Ligt wel op het RD-100m-raster, maar begint 13 km ten oosten en 5 km ten zuiden van de domeinhoek en heeft tegels van 128x128, dus GeoDMS waarschuwt over de offset. De nodatawaarde -3,40282E+38 leest GeoDMS als gewone waarde. Alleen nog nodig om met Maak de tif te genereren."
		{
			attribute<cm> Bodemdaling_2016_2050_cm_1_org (rdc_100m)
			: StorageName     = "%RSo_DataDir%/Omgeving/Bodem/Bodemdaling/Bodemdaling 2016-2050 (cm)1.tif"
			, StorageReadOnly = "TRUE"
			, StorageType     = "gdal.grid"
			, Source          = "Bodemdalingsvoorspellingskaart 2020-2050 (Bron3)"
			, Descr           = "Bodemdaling in cm tussen 2016 en 2050, gebaseerd op de Bodemdalingsvoorspellingskaart 2020-2050 (Bron3) van het KNMI.";
		}

		container Maak
		: Descr = "Zet de bron eenmalig om naar een getegelde, LZW-gecomprimeerde tif op het modelraster, met -3,40282E+38 als null. Draai dit met StudyArea = Nederland, want de tif beslaat het hele land."
		{
			parameter<Bool> IsNederland := lowercase(/ModelParameters/StudyArea) == 'nederland', Descr = "Bewaakt dat de tif niet per ongeluk met een provincie als studiegebied wordt weggeschreven.";

			attribute<cm> Bodemdaling_2016_2050_cm_1 (rdc_100m) := (Bron/Bodemdaling_2016_2050_cm_1_org <= -3.40282E+38f ? null_f : Bron/Bodemdaling_2016_2050_cm_1_org)[cm]
			, StorageName = "%RSo_DataDir%/Omgeving/Bodem/Bodemdaling/Bodemdaling_2016_2050_cm_100m_NL_rdc.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";

			parameter<String> Generate := 'Ready', ExplicitSuppliers = "Bodemdaling_2016_2050_cm_1";
		}

		attribute<cm> Bodemdaling_2016_2050_cm_1       (rdc_100m)
		: StorageName     = "%RSo_DataDir%/Omgeving/Bodem/Bodemdaling/Bodemdaling_2016_2050_cm_100m_NL_rdc.tif"
		, StorageReadOnly = "true"
		, Source          = "Bodemdalingsvoorspellingskaart 2020-2050 (Bron3)"
		, Descr           = "Bodemdaling in cm tussen 2016 en 2050, gebaseerd op de Bodemdalingsvoorspellingskaart 2020-2050 (Bron3) van het KNMI. Cellen zonder voorspelling zijn null; in de bron stonden die op -3,40282E+38.";

		attribute<cm> Bodemdaling_2016_2050_cm_1_25mtr  (rdc_25m) := Bodemdaling_2016_2050_cm_1[Geography/rdc_25m/rdc_100m_rel], Descr = "Bodemdaling in cm tussen 2016 en 2050, gebaseerd op de Bodemdalingsvoorspellingskaart 2020-2050 (Bron3) van het KNMI, geresampled naar 25m.";
	}
}