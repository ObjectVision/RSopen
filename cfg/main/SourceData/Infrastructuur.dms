// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het voetgangersnet van OpenStreetMap, dat de afleiding van de winkelcentra (BaseData/Afleiding_Winkelcentra) nodig heeft.
// Het Nationaal Wegenbestand staat in SourceData/Grondgebruik/NWB.
//


container Infrastructuur
: Descr = "Het voetgangersnet van OpenStreetMap, dat de afleiding van de winkelcentra nodig heeft om winkelpanden die over straat dicht bij elkaar liggen tot een centrum te groeperen."
{
	container osm
	: Descr = "Het wegennet van OpenStreetMap zoals het netwerkmodel van PBL het opschoont: opgeknipt in segmenten, met de ontbrekende verbindingen en veerponten erbij, en alleen het grootste samenhangende deel."
	{
		unit<UInt32> Wegen
		: StorageName     = "='%RSo_DataDir%/Infrastructuur/OSM/OSM_NL_'+ModelParameters/OSM_file_date+'.parquet'"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "True"
		, Source          = "OpenStreetMap via Geofabrik, opgeschoond en geëxporteerd door het netwerkmodel van PBL (ObjectVision/NetworkModel_PBL, Output/PostAnalysis/Network_RuimteScanner), levering OSM_file_date"
		, Descr           = "De segmenten van het net in Nederland en tot 10 km over de grens; het bestand heeft per segment ook het OSM-id, de autosnelheid, de rijrichting en of het bij het auto- en fietsnet hoort."
		{
			attribute<rdc_meter> geometry (arc);
			attribute<String>    roadType_label : Descr ="Het wegtype volgens OpenStreetMap, zoals residential, footway of primary.";
			attribute<Bool>      InWalkingNetwork;
		}
		unit<UInt32> Read_Final_Network := select_with_org_rel(Wegen/InWalkingNetwork)
		, Descr = "Het voetgangersnet: alle segmenten behalve snelwegen, autowegen en wegen die dicht of in aanbouw zijn."
		{
			attribute<rdc_meter> geometry (arc) := Wegen/geometry[org_rel];
		}
	}
}
