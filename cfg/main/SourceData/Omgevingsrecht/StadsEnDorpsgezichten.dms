// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De rijksbeschermde stads- en dorpsgezichten van de Rijksdienst voor het Cultureel Erfgoed, voor de herontwikkelingskans van wonen (#869)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container StadsEnDorpsgezichten
: Descr = "De rijksbeschermde stads- en dorpsgezichten van de Rijksdienst voor het Cultureel Erfgoed (#869): de download die pbl-nl/model-RS-RuimtelijkeRestricties op zijn peildatum van de WFS-dienst
			van de RCE haalt (Templates/Beleid/OmgRecht/Overigen/Monumenten in die repo), als GeoParquet op de RSopen-share, want het model leest alleen zijn eigen share (#583). De
			herontwikkelingskans van wonen leest per cel of zij in een gezicht ligt, dezelfde laag als de schatting van het EconLogic-paper gebruikte; in de restricties zit de laag ook, als onderdeel van het regime Hard voor wonen."
, Source = "RCE, WFS rce:Townscapes (services.rce.geovoorziening.nl), download van ModelParameters/Wonen/Herontwikkelingskans/Erfgoed_Peildatum door pbl-nl/model-RS-RuimtelijkeRestricties (stads_en_dorpsgezichten_<peildatum>.json, 472 gezichten), met geopandas omgezet naar GeoParquet"
, url = "https://www.cultureelerfgoed.nl/onderwerpen/bronnen-en-kaarten/overzicht/kaart-van-beschermde-stads--en-dorpsgezichten"
{
	unit<UInt32> Gezicht
	:	StorageName     = "='%RSo_DataDir%/Omgeving/Erfgoed/stads_en_dorpsgezichten_'+/ModelParameters/Wonen/Herontwikkelingskans/Erfgoed_Peildatum+'.parquet'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	Descr           = "De gezichten als vlakken, met hun naam, juridische status en aanwijzingsdatum, zoals de dienst ze levert; GeoParquet leest GeoDMS via de Parquet-driver van GDAL, zoals de tabellen van EP-online en LISA."
	{
		parameter<String> GDAL_ConfigurationOptions := 'OGR_PARQUET_COMPUTE_GEOMETRY_TYPE=NO', Descr = "Een GeoParquet die niet door GDAL is geschreven draagt geen geometrietype in zijn metadata; zonder deze optie leest GDAL bij elke opening alle vlakken door om het type te bepalen. Bij 472 vlakken onmerkbaar, bij miljoenen seconden per opening.";
		attribute<rdc_meter> geometry (poly);
		attribute<String>    NAAM;
		attribute<String>    JURSTATUS;
		attribute<Bool>      IsRijksbeschermd := JURSTATUS == 'rijksbeschermd stads- of dorpsgezicht', IntegrityCheck = "any(this)"
		, Descr = "Alleen de rijksbeschermde gezichten tellen, zoals in de schatting; de dienst levert alleen die status, en de check vangt een bron die de status anders is gaan schrijven.";
	}

	attribute<Gezicht> Gezicht_rel (AdminDomain) := poly2grid(Gezicht/geometry, AdminDomain), Descr = "Het gezicht waarin het midden van de cel ligt, null daarbuiten.";
	attribute<Bool>    IsInGezicht (AdminDomain) := IsDefined(Gezicht_rel) && Gezicht/IsRijksbeschermd[Gezicht_rel], Descr = "Ligt de cel in een rijksbeschermd stads- of dorpsgezicht?";
}
