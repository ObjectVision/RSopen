// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De rijksmonumenten uit het register van de Rijksdienst voor het Cultureel Erfgoed, voor de herontwikkelingskans van wonen (#869)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Rijksmonumenten
: Descr = "De rijksmonumenten uit het rijksmonumentenregister van de Rijksdienst voor het Cultureel Erfgoed (#869): de download die pbl-nl/model-RS-RuimtelijkeRestricties op zijn peildatum van de WFS-dienst
			van de RCE haalt (Templates/Beleid/OmgRecht/Overigen/Monumenten in die repo), als GeoParquet op de RSopen-share, want het model leest alleen zijn eigen share (#583). Een perceel met een
			rijksmonument komt in de herontwikkelingskans van wonen niet beschikbaar: sloop van een rijksmonument vraagt een omgevingsvergunning die vrijwel nooit wordt verleend. Beide lagen van
			het register tellen: de punten (een per monument, bij een gebouw meestal het BAG-pand) en de contouren (de vlakken van de besluiten, vooral terreinen en complexen), omdat een terrein of
			complex als punt maar een perceel raakt. Ook de archeologische monumenten en de voorbeschermde tellen mee, want ook daar geldt de
			vergunningplicht."
, Source = "RCE, WFS openbaar (data.geo.cultureelerfgoed.nl), lagen rijksmonumentpunten (63.127 punten) en rijksmonumentcontouren (4.258 vlakken), download van ModelParameters/Wonen/Herontwikkelingskans/Erfgoed_Peildatum door pbl-nl/model-RS-RuimtelijkeRestricties, met geopandas omgezet naar GeoParquet"
, url = "https://www.cultureelerfgoed.nl/onderwerpen/rijksmonumentenregister/rijksmonumenten-kaartlagen"
{
	unit<UInt32> Punt
	:	StorageName     = "='%RSo_DataDir%/Omgeving/Erfgoed/rijksmonumentpunten_'+/ModelParameters/Wonen/Herontwikkelingskans/Erfgoed_Peildatum+'.parquet'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	Descr           = "Een punt per rijksmonument, met het monumentnummer, de juridische status (rijksmonument of voorbeschermd) en de aard (gebouwd of archeologisch), zoals de dienst ze levert."
	{
		parameter<String> GDAL_ConfigurationOptions := 'OGR_PARQUET_COMPUTE_GEOMETRY_TYPE=NO', Descr = "Een GeoParquet die niet door GDAL is geschreven draagt geen geometrietype in zijn metadata; zonder deze optie leest GDAL bij elke opening alle geometrieen door om het type te bepalen.";
		attribute<rdc_meter>   geometry;
		attribute<String>      juridische_status;
		attribute<String>      aard_monument;
		attribute</SourceData/Vastgoed/BRK/Perceel> Perceel_rel := point_in_polygon(geometry, /SourceData/Vastgoed/BRK/Perceel/geometry), Descr = "Het kadastrale perceel onder het punt.";
		parameter<Bool>        Gelezen := TRUE, IntegrityCheck = "#Punt > 10000", Descr = "Vangt een lege of afgekapte bron: het register telt ruim zestigduizend rijksmonumenten.";
	}
	unit<UInt32> Contour
	:	StorageName     = "='%RSo_DataDir%/Omgeving/Erfgoed/rijksmonumentcontouren_'+/ModelParameters/Wonen/Herontwikkelingskans/Erfgoed_Peildatum+'.parquet'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	Descr           = "De contouren van de besluiten als vlakken, voor de monumenten waarvan de RCE een vlak heeft vastgelegd: terreinen, complexen en een deel van de gebouwen."
	{
		parameter<String> GDAL_ConfigurationOptions := 'OGR_PARQUET_COMPUTE_GEOMETRY_TYPE=NO';
		attribute<rdc_meter> geometry (poly);
		attribute<String>    juridische_status;
		attribute<String>    aard_monument;
		parameter<Bool>      Gelezen := TRUE, IntegrityCheck = "#Contour > 1000", Descr = "Vangt een lege of afgekapte bron.";
	}

	attribute<UInt32>  PuntenPerPerceel  (/SourceData/Vastgoed/BRK/Perceel) := uint32(pcount(Punt/Perceel_rel)), Descr = "Het aantal monumentpunten op het perceel.";
	attribute<Contour> ContourVanPerceel (/SourceData/Vastgoed/BRK/Perceel) := point_in_polygon(centroid_or_mid(/SourceData/Vastgoed/BRK/Perceel/geometry), Contour/geometry), Descr = "De monumentcontour waarin het midden van het perceel ligt, null daarbuiten.";
	attribute<Bool>    IsRijksmonumentPerceel (/SourceData/Vastgoed/BRK/Perceel) := (PuntenPerPerceel > 0 || IsDefined(ContourVanPerceel)) && Punt/Gelezen && Contour/Gelezen
	, Descr = "Ligt er een monumentpunt op het kadastrale perceel, of ligt het midden van het perceel in een monumentcontour? Op de punten en niet via de cellen, want een cel van 25 meter raakt vaak meer percelen en zou een straat of gracht met een monument erlangs als geheel beschermen. Het perceel is de eenheid die het model sloopt en herontwikkelt (#861), dus een monument beschermt zijn hele
				perceel: de herontwikkelingskans laat het nooit vrij, de vervanging slaat de woningen erop over en de andere sectoren mogen er geen woningen slopen (#869). De drie lezers delen deze vlag.";
	parameter<String>  Regel_Versie := '869', Descr = "Versiesleutel van IsRijksmonumentPerceel in de fingerprint van de bestanden die de vlag lezen; verander hem mee met de regel.";
	attribute<Bool>    IsRijksmonumentPerceel_AdminDomain (AdminDomain) := IsDefined(/SourceData/Vastgoed/BRK/Perceel_rel) ? IsRijksmonumentPerceel[/SourceData/Vastgoed/BRK/Perceel_rel] : FALSE
	, Descr = "Dezelfde vlag per cel: ligt de cel op een perceel met een rijksmonument? Een cel zonder perceel valt erbuiten.";
}
