// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// hack om de Stichtse Rotondo nabij Amersfoort te identificeren. Zodat daarop niet gealloceerd mag worden.
// Buffer, dan dissolve, dan negatieve buffer. Relevant tiles gecombineerd in QGIS, en dan gewarped naar RDC, en
// dan studiegebied NL genomen en naar uint8 gecast. Laadt via #include: BGT, BRT, LGN, IBIS, BBG, NVK.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Grondgebruik: using  = "Units;Geography;Classifications;Classifications/Grondgebruik"
{
	#include<BGT.dms>
	#include<BRT.dms>
	#include<LGN.dms>
	#include<IBIS.dms>
	#include<BBG.dms>
	#include<NVK.dms>
	
	container NWB 
	: StorageName = "%RSo_DataDir%/Grondgebruik/NWB/20251101/Wegvakken/Wegvakken.gpkg"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "true"
	, DialogData = "rdc_meter"
	{
	
		unit<uint32> Stichtse_Rotonde := select_with_attr_by_cond(NWB/Wegvakken, NWB/Wegvakken/STT_NAAM == 'Stichtse Rotonde')
		, Descr = "hack om de Stichtse Rotondo nabij Amersfoort te identificeren. Zodat daarop niet gealloceerd mag worden. Buffer, dan dissolve, dan negatieve buffer."
		{
			attribute<rdc_meter> geometry_buff0           (poly) := bg_buffer_linestring(geometry, 100d, 8b);
			unit<uint32>         union                           := geos_split_union_polygon(geometry_buff0);
			attribute<rdc_meter> geometry_buff1    (poly, union) := geos_buffer_multi_polygon(union/geometry, -100d, 4b);
			
			attribute<bool>      Calc_Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry_buff1, AdminDomain));

			parameter<String> FileName_Per_AdminDomain := '%LocalDataProjDir%/BaseData/Grondgebruik/NWB/StichtseRotonde_NWB20251101_'+/ModelParameters/StudyArea+'.tif'
			, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft.";
			parameter<String> Fingerprint_Per_AdminDomain :=
				  'nwb_date=20251101'
				+ ';street_name=Stichtse Rotonde'
				+ ';buffer_out_m=100;buffer_in_m=100'
				+ ';admin_grid='  + /ModelParameters/Advanced/AdminDomain_ref
				+ ';study_area='  + /ModelParameters/StudyArea
			, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. nwb_date staat als vaste waarde omdat de datum hard in het pad van de NWB-container zit; komt daar een nieuwe levering, pas dan ook deze sleutel aan. street_name is de selectievoorwaarde van deze unit, de twee bufferwaarden zijn de vaste getallen in geometry_buff0 en geometry_buff1. admin_grid vangt dat 25m tegenover 100m een ander bestand onder dezelfde naam oplevert.";
			container Decoupling_Per_AdminDomain := /Templates/DecoupledFile_T(FileName_Per_AdminDomain, Fingerprint_Per_AdminDomain);
			attribute<bool>      Make_Per_AdminDomain (AdminDomain) := Calc_Per_AdminDomain, StorageName = "=FileName_Per_AdminDomain", StorageType = "tif", StorageReadOnly = "False", ExplicitSuppliers = "Decoupling_Per_AdminDomain/Write_Fingerprint", Descr = "Schrijft de rotondekaart eenmalig weg. StorageReadOnly staat hier expliciet op False omdat de omvattende NWB-container die eigenschap op true heeft staan en hij anders mee zou kunnen erven. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
			attribute<bool>      Read_Per_AdminDomain (AdminDomain) : StorageName = "=FileName_Per_AdminDomain", StorageType = "tif", StorageReadOnly = "TRUE";
			attribute<bool>      Per_AdminDomain   (AdminDomain) := = Decoupling_Per_AdminDomain/MayReuse ? 'Read_Per_AdminDomain' : 'Make_Per_AdminDomain', Descr = "Ligt de cel op de Stichtse Rotonde, ontkoppeld. Met een geldige fingerprint wordt de tif gelezen; anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_Per_AdminDomain/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		}
	}
	
	container Imperviousness_Map
	{
		attribute<uint16>  Y2024_5m (rdc_5m)
		:	StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2024_010m_NL_rdc.tif"
		,	Source          = "Copernicus Land Monitoring Service, high resolution imperviousness map 2018"
		, 	URL             = "https://land.copernicus.eu/en/products/high-resolution-layer-imperviousness/imperviousness-density-2024"
		, 	Descr           = "Relevant tiles gecombineerd, en dan gewarped naar RDC"
		, 	LazyCalculated  = "true";

		attribute<uint8>        Y2024_25m_write   (rdc_25m) :=/SourceData/RegioIndelingen/NL/IsNederland_25m ? mean(Y2024_5m <= 100w ? Y2024_5m[uint8] : null_b, rdc_5m/rdc_25m_rel) : null_b,	StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2024_025m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid";
		attribute<uint8>        Y2024_25m         (rdc_25m) : StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2024_025m_NL_rdc_uint8.tif", StorageReadOnly = "true";

		attribute<uint8>  Y2021_5m (rdc_5m)
		:	StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2021_010m_NL_rdc_uint8.tif"
		,	Source          = "Copernicus Land Monitoring Service, high resolution imperviousness map 2018"
		, 	URL             = "https://land.copernicus.eu/en/products/high-resolution-layer-imperviousness/imperviousness-density-2021"
		, 	Descr           = "Relevant tiles gecombineerd in QGIS, en dan gewarped naar RDC, en dan studiegebied NL genomen en naar uint8 gecast."
		, 	LazyCalculated  = "true";

		attribute<uint8>        Y2021_25m_write   (rdc_25m) := mean(Y2021_5m <= 100b ? Y2021_5m : null_b, rdc_5m/rdc_25m_rel),	StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2021_025m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid";
		attribute<uint8>        Y2021_25m         (rdc_25m) : StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2021_025m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		
		attribute<Percent>       InProcent         (rdc_25m) := ='rdc_25m/IsStudyArea ? value('+ModelParameters/Advanced/ImperviousnessMapYear+'_25m, percent) : null_f';
		attribute<Percent>       InProcent_5m       (rdc_5m) := ='rdc_5m/IsStudyArea ? value('+ModelParameters/Advanced/ImperviousnessMapYear+'_5m, percent) : null_f';
	}
	
	container ABCD
	{
		unit<uint8> ABCD_K : nrofrows = 8
		{
			attribute<string> name   : ['Agroparken','Beleving','Drinkwater','Droogte','Natuurherstel','Productiviteit','Uitspoeling','Veen'];
			attribute<string> Label  := name;
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .); 
		}
		
		unit<uint8> ABCD_subK : nrofrows = 3
		{
			attribute<string> name   : ['A','B_C1', 'Overig'];
			attribute<string> Label  := name;
			attribute<UInt32> BrushColor :  [rgb(118, 159, 255),rgb(255, 180, 0),rgb(230, 230, 230)], DialogType = "BrushColor";
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .); 
		}
	
		container Bron
		: Descr = "De aangeleverde ASCII-grids. Hun oorsprong ligt niet op het RD-100m-raster: xllcorner eindigt op 65,4 en yllcorner op 46,198. GeoDMS rondt die celoffset af naar de dichtstbijzijnde cel, waarschuwt daarover, en leest -9999 als gewone waarde in plaats van als null. Alleen nog nodig om met Maak de tifs te genereren."
		{
			attribute<int32> Agroparken        (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/agroparken.txt", StorageType = "gdal.grid";
			attribute<int32> Beleving          (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Beleving.txt", StorageType = "gdal.grid";
			attribute<int32> Drinkwater        (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Drinkwater.txt", StorageType = "gdal.grid";
			attribute<int32> Droogte           (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Droogte.txt", StorageType = "gdal.grid";
			attribute<int32> Natuurherstel     (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Natuurherstel.txt", StorageType = "gdal.grid";
			attribute<int32> Overlay           (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay.txt", StorageType = "gdal.grid";
			attribute<int32> Overlay_gefilterd (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay_gefilterd.txt", StorageType = "gdal.grid";
			attribute<int32> Productiviteit    (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Productiviteit.txt", StorageType = "gdal.grid";
			attribute<int32> Uitspoeling       (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Uitspoeling.txt", StorageType = "gdal.grid";
			attribute<int32> Veen              (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Veen.txt", StorageType = "gdal.grid";
		}

		container Maak
		: Descr = "Zet de bronrasters eenmalig om naar getegelde, LZW-gecomprimeerde GeoTIFFs op het modelraster, met -9999 als null. Draai dit met StudyArea = Nederland, want de tifs beslaan het hele land; voor een provincierun leest GeoDMS er vanzelf het juiste stuk uit."
		{
			parameter<Bool> IsNederland := lowercase(/ModelParameters/StudyArea) == 'nederland', Descr = "Bewaakt dat de tifs niet per ongeluk met een provincie als studiegebied worden weggeschreven.";

			attribute<uint8> Agroparken        (rdc_100m) := Bron/Agroparken == -9999i ? null_b : uint8(Bron/Agroparken), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Agroparken_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Beleving          (rdc_100m) := Bron/Beleving == -9999i ? null_b : uint8(Bron/Beleving), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Beleving_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Drinkwater        (rdc_100m) := Bron/Drinkwater == -9999i ? null_b : uint8(Bron/Drinkwater), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Drinkwater_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Droogte           (rdc_100m) := Bron/Droogte == -9999i ? null_b : uint8(Bron/Droogte), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Droogte_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Natuurherstel     (rdc_100m) := Bron/Natuurherstel == -9999i ? null_b : uint8(Bron/Natuurherstel), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Natuurherstel_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Overlay           (rdc_100m) := Bron/Overlay == -9999i ? null_b : uint8(Bron/Overlay), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Overlay_gefilterd (rdc_100m) := Bron/Overlay_gefilterd == -9999i ? null_b : uint8(Bron/Overlay_gefilterd), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay_gefilterd_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Productiviteit    (rdc_100m) := Bron/Productiviteit == -9999i ? null_b : uint8(Bron/Productiviteit), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Productiviteit_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Uitspoeling       (rdc_100m) := Bron/Uitspoeling == -9999i ? null_b : uint8(Bron/Uitspoeling), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Uitspoeling_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";
			attribute<uint8> Veen              (rdc_100m) := Bron/Veen == -9999i ? null_b : uint8(Bron/Veen), StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Veen_100m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid", IntegrityCheck = "IsNederland";

			parameter<String> Generate := 'Ready', ExplicitSuppliers = "Agroparken;Beleving;Drinkwater;Droogte;Natuurherstel;Overlay;Overlay_gefilterd;Productiviteit;Uitspoeling;Veen";
		}

		attribute<uint8> Agroparken        (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Agroparken_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Beleving          (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Beleving_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Drinkwater        (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Drinkwater_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Droogte           (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Droogte_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Natuurherstel     (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Natuurherstel_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Overlay           (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Overlay_gefilterd (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay_gefilterd_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Productiviteit    (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Productiviteit_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Uitspoeling       (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Uitspoeling_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		attribute<uint8> Veen              (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Veen_100m_NL_rdc_uint8.tif", StorageReadOnly = "true";
	
		attribute<ABCD_K> Combi            (rdc_100m) := switch(
															 case(Agroparken == 3b, ABCD_K/v/Agroparken)
															,case(Beleving == 1b, ABCD_K/v/Beleving)
															,case(Drinkwater == 1b, ABCD_K/v/Drinkwater)
															,case(Droogte == 2b, ABCD_K/v/Droogte)
															,case(Natuurherstel == 1b, ABCD_K/v/Natuurherstel)
															,case(Productiviteit == 2b, ABCD_K/v/Productiviteit)
															,case(Uitspoeling == 1b, ABCD_K/v/Uitspoeling)
															,case(Veen == 1b, ABCD_K/v/Veen)
															,null_b
														);
														
		attribute<ABCD_subK> ABCD_sub_rel (rdc_100m) :=  switch(
															 case(Overlay_gefilterd == 1b, ABCD_subK/v/a)
															,case(Overlay_gefilterd == 2b, ABCD_subK/v/B_C1)
															, ABCD_subK/v/Overig
														);
														
		attribute<ABCD_subK> ABCD_sub_rel_25m (rdc_25m) := ABCD_sub_rel[rdc_25m/rdc_100m_rel];
	}

	#include<Natuur.dms>
}