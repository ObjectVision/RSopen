// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// hack om de Stichtse Rotondo nabij Amersfoort te identificeren. Zodat daarop niet gealloceerd mag worden.
// Buffer, dan dissolve, dan negatieve buffer. Relevant tiles gecombineerd in QGIS, en dan gewarped naar RDC, en
// dan studiegebied NL genomen en naar uint8 gecast. Laadt via #include: BGT, BRT, LGN, IBIS, BBG, NVK.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Grondgebruik: using  = "Units;Geography;Classifications;Classifications/Grondgebruik"
{
	#include<BGT.dms>
	#include<BRT.dms>
	#include<LGN.dms>
	#include<IBIS.dms>
	#include<BBG.dms>
	#include<NVK.dms>
	
	container NWB 
	: StorageName = "%RSo_DataDir%/Grondgebruik/NWB/20251101/Wegvakken/Wegvakken.gpkg"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "true"
	, DialogData = "rdc_meter"
	{
	
		unit<uint32> Stichtse_Rotonde := select_with_attr_by_cond(NWB/Wegvakken, NWB/Wegvakken/STT_NAAM == 'Stichtse Rotonde')
		, Descr = "hack om de Stichtse Rotondo nabij Amersfoort te identificeren. Zodat daarop niet gealloceerd mag worden. Buffer, dan dissolve, dan negatieve buffer."
		{
			attribute<rdc_meter> geometry_buff0           (poly) := bg_buffer_linestring(geometry, 100d, 8b);
			unit<uint32>         union                           := geos_split_union_polygon(geometry_buff0);
			attribute<rdc_meter> geometry_buff1    (poly, union) := geos_buffer_multi_polygon(union/geometry, -100d, 4b);
			
			attribute<bool>      Per_AdminDomain   (AdminDomain) := IsDefined(poly2grid(geometry_buff1, AdminDomain));
		}
	}
	
	container Imperviousness_Map
	{
		attribute<uint8>  Y2021_5m (rdc_5m)
		:	StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2021_010m_NL_rdc_uint8.tif"
		,	Source          = "Copernicus Land Monitoring Service, high resolution imperviousness map 2018"
		, 	URL             = "https://land.copernicus.eu/en/products/high-resolution-layer-imperviousness/imperviousness-density-2021"
		, 	Descr           = "Relevant tiles gecombineerd in QGIS, en dan gewarped naar RDC, en dan studiegebied NL genomen en naar uint8 gecast."
		, 	LazyCalculated  = "true";

		attribute<uint8>        Y2021_25m_write   (rdc_25m) := mean(Y2021_5m <= 100b ? Y2021_5m : null_b, rdc_5m/rdc_25m_rel),	StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2021_025m_NL_rdc_uint8.tif", StorageType = "gdalwrite.grid";
		attribute<uint8>        Y2021_25m         (rdc_25m) : StorageName     = "%RSo_DataDir%/Grondgebruik/Imperviousness_Density_2021_025m_NL_rdc_uint8.tif", StorageReadOnly = "true";
		
		attribute<Percent>       InProcent         (rdc_25m) := rdc_25m/IsStudyArea ? value(Y2021_25m, percent) : null_f;
		attribute<Percent>       InProcent_5m       (rdc_5m) := rdc_5m/IsStudyArea ? value(Y2021_5m, percent) : null_f;
	}
	
	container ABCD
	{
		unit<uint8> ABCD_K : nrofrows = 8
		{
			attribute<string> name   : ['Agroparken','Beleving','Drinkwater','Droogte','Natuurherstel','Productiviteit','Uitspoeling','Veen'];
			attribute<string> Label  := name;
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .); 
		}
		
		unit<uint8> ABCD_subK : nrofrows = 3
		{
			attribute<string> name   : ['A','B_C1', 'Overig'];
			attribute<string> Label  := name;
			attribute<UInt32> BrushColor :  [rgb(118, 159, 255),rgb(255, 180, 0),rgb(230, 230, 230)], DialogType = "BrushColor";
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .); 
		}
	
		attribute<int32> Agroparken        (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/agroparken.txt", StorageType = "gdal.grid";
		attribute<int32> Beleving          (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Beleving.txt", StorageType = "gdal.grid";
		attribute<int32> Drinkwater        (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Drinkwater.txt", StorageType = "gdal.grid";
		attribute<int32> Droogte           (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Droogte.txt", StorageType = "gdal.grid";
		attribute<int32> Natuurherstel     (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Natuurherstel.txt", StorageType = "gdal.grid";
		attribute<int32> Overlay           (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay.txt", StorageType = "gdal.grid";
		attribute<int32> Overlay_gefilterd (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Overlay_gefilterd.txt", StorageType = "gdal.grid";
		attribute<int32> Productiviteit    (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Productiviteit.txt", StorageType = "gdal.grid";
		attribute<int32> Uitspoeling       (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Uitspoeling.txt", StorageType = "gdal.grid";
		attribute<int32> Veen              (rdc_100m) : StorageName = "%RSo_DataDir%/Grondgebruik/ABCD/Veen.txt", StorageType = "gdal.grid";
	
		attribute<ABCD_K> Combi            (rdc_100m) := switch(
															 case(Agroparken == 3i, ABCD_K/v/Agroparken)
															,case(Beleving == 1i, ABCD_K/v/Beleving)
															,case(Drinkwater == 1i, ABCD_K/v/Drinkwater)
															,case(Droogte == 2i, ABCD_K/v/Droogte)
															,case(Natuurherstel == 1i, ABCD_K/v/Natuurherstel)
															,case(Productiviteit == 2i, ABCD_K/v/Productiviteit)
															,case(Uitspoeling == 1i, ABCD_K/v/Uitspoeling)
															,case(Veen == 1i, ABCD_K/v/Veen)
															,null_b
														);
														
		attribute<ABCD_subK> ABCD_sub_rel (rdc_100m) :=  switch(
															 case(Overlay_gefilterd == 1i, ABCD_subK/v/a)
															,case(Overlay_gefilterd == 2i, ABCD_subK/v/B_C1)
															, ABCD_subK/v/Overig
														);
														
		attribute<ABCD_subK> ABCD_sub_rel_25m (rdc_25m) := ABCD_sub_rel[rdc_25m/rdc_100m_rel];
	}

	container Natuur
	{
		container MNP_BAU 
		{
			attribute<uint8> NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel0 (rdc_2_5m)
			:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel_20250925_110353.tif"
			,	Source          = "WUR"
			, 	Descr           = "Dit bestand dient als de ruimtelijke mal voor de natuurvlakken binnen de visie NL2120. Het representeert de geografische afbakening van waar natuur aanwezig is of gepland is binnen de vigerende beleidskaders."
			, 	LazyCalculated  = "true";
			
			attribute<INL_Beheertype>  NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel (rdc_2_5m) := rlookup(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel0, INL_Beheertype/MNP_BeheertypenKaart_val);
			attribute<INL_Beheertype>  Write_NL2120_MNP_BAU_INL_beheertypen_25m (rdc_25m) := modus(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel, rdc_2_5m/rdc_25m_rel)
			,	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel_20250925_110353_25m.tif"
			, 	StorageType     = "gdalwrite.grid"
			;
			attribute<INL_Beheertype>  INL_Beheertype_rel_AD (AdminDomain)
			:	StorageName     = "=PropValue(Write_NL2120_MNP_BAU_INL_beheertypen_25m, 'StorageName')"
			, 	StorageType     = "gdal.grid"
			, 	StorageReadOnly = "true";
			attribute<NatuurType>     NatuurTypen_rel_AD   (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
		}

		// unit<uint32> Rivierengebied_BAU_geojson
		// :	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/BAU-Natuur.geojson"
		// , 	StorageType     = "gdal.vect"
		// ,	Source          = "Ontvangen van Deltares op 20260611"
		// , 	Descr           = "Natuur_Y2120_Rivierengebied_BAU"
		// , 	DialogData      = "rdc_meter";

		// unit<uint32> Write_Rivierengebied_BAU := Rivierengebied_BAU_geojson
		// ,	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/BAU-Natuur.mmd"
		// {
		// 	attribute<rdc_meter> geometry (poly) := Rivierengebied_BAU_geojson/geometry;
		// 	attribute<string>    hydrologie      := Rivierengebied_BAU_geojson/hydrologie;
		// 	attribute<string>    NL_2120         := Rivierengebied_BAU_geojson/NL_2120;
		// 	attribute<string>    zonering        := Rivierengebied_BAU_geojson/zonering;
		// }

		unit<uint32> Rivierengebied_BAU
		:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/BAU-Natuur.mmd"
		, 	StorageReadOnly = "true"
		,	Source          = "Ontvangen van Deltares op 20260611"
		, 	Descr           = "Natuur_Y2120_Rivierengebied_BAU"
		{
			attribute<HydrologieK>    Hydrologie_rel    := rlookup(hydrologie, HydrologieK/label);
			attribute<EcotoopK>       Ecotoop_rel       := rlookup(NL_2120, EcotoopK/label);
			attribute<GeomorfologieK> Geomorfologie_rel := rlookup(zonering, GeomorfologieK/label);
			attribute<bool>           IsNat              := HydrologieK/IsOever[Hydrologie_rel] || Geomorfologie_rel == GeomorfologieK/V/Oevers; // Nat = oeverzone (HydrologieK/IsOever) of geomorfologische zone 'Oevers'. 'Oeverwal/hoge uiterwaard' is droog.

			unit<uint8> HydrologieK := unique_uint8(hydrologie)
			{
				attribute<string> label := values;
				attribute<bool>   IsOever := substr(label, 0, 5) == 'Oever', Descr = "Natte oeverzone: alle 'Oever - ...'-klassen. Onderscheidt nat/droog t.b.v. de beheertype-keuze.";
				container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			}
			unit<uint8> EcotoopK := unique_uint8(NL_2120)
			{
				attribute<string> label := values;
				container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			}
			unit<uint8> GeomorfologieK := unique_uint8(zonering)
			{
				attribute<string> label := values;
				container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			}			

			attribute<INL_Beheertype> INL_Beheertype_rel := 
				switch(
					 case(Ecotoop_rel == EcotoopK/V/Moeras                                 , INL_Beheertype/V_obvCode/N05_04) // dynamisch moeras
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_bos && IsNat                , INL_Beheertype/V_obvCode/N14_01) // rivier-/beekbegeleidend bos (zachthoutooibos)
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_bos                         , INL_Beheertype/V_obvCode/N14_03) // haagbeuken-/essenbos (hardhoutooibos)
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_grasland && IsNat           , INL_Beheertype/V_obvCode/N10_02) // vochtig hooiland
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_grasland                    , INL_Beheertype/V_obvCode/N12_02) // kruiden-/faunarijk grasland
					,case(Ecotoop_rel == EcotoopK/V/Onbegroeid_pionier_natuurlijk_ && IsNat, INL_Beheertype/V_obvCode/N05_01_14 ) // slikkige rivieroever
					,case(Ecotoop_rel == EcotoopK/V/Onbegroeid_pionier_natuurlijk_         , INL_Beheertype/V_obvCode/N05_01_13) // open zand
					,case(Ecotoop_rel == EcotoopK/V/Ruigte                                 , INL_Beheertype/V_obvCode/N12_06) // ruigteveld
					,case(Ecotoop_rel == EcotoopK/V/Struweel_houtig_                       , INL_Beheertype/V_obvCode/N05_01_06) // moerasstruweel (wilg)
					,case(Ecotoop_rel == EcotoopK/V/Stagnant_water                         , INL_Beheertype/V_obvCode/N04_02) // zoete plas
					,case(Ecotoop_rel == EcotoopK/V/Zomerbed                               , INL_Beheertype/V_obvCode/N02_01) // rivier
					, null_b // agrarisch gebruik/grasland en bebouwd = geen natuur -> geen beheertype
				);

			attribute<.>              Per_AdminDomain       (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
			attribute<NatuurType>     NatuurTypen_rel_AD    (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
		}

		unit<uint32> Rivierengebied_NbSMax 
		:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbS/Natuur_Y2120_Rivierengebied_NbSMax_20260528.shp"
		, 	StorageType     = "gdal.vect"
		,	Source          = "Ontvangen van Deltares op 20260528"
		, 	Descr           = "In de bijlage de kaartlaag voor NbS Max. Voor BaU nemen we de bestaande riviertranches (zie ook bestand) en de verdere veranderingen in het 
									BaU ruimtescanner scenario. Het GIS bestand heeft 3 lagen 'nieuwe uiterwaarden, moerasgebieden en water'. 
									In deze gebieden moet de bestaande bebouwing verdwijnen (uitkoop) en zijn er toekomstige bouwrestricties. 
									De moerasgebieden zijn ook tevens waterberginggebieden. Ook de landbouwfunctie verdwijnt in deze gebieden. 
									Ze moeten nog aangeven welk percentage welk type natuur wordt. Ga er vanuit dat dit een combinatie wordt van 
									open zand/grindvlakte, ruigte, grasland, zachthoutooibos, hardhoutooibos, zomerbed (water) en uiterwaardwater. 
									Volgens mij is het voor de meeste indicatoren nu niet relevant welk natuurtype het precies wordt. 
									Met uitzondering van koolstofvastlegging."
		, DialogData = "rdc_meter"
		{
			attribute<.>      Per_AdminDomain   (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<INL_Beheertype> INL_Beheertype_rel := switch(
																 case(lowercase(type) == 'moeras',              rlookup('N05.04',    INL_Beheertype/code)) // moerasgebied -> dynamisch moeras
																,case(lowercase(type) == 'uiterwaarden',        rlookup('N12.02',    INL_Beheertype/code)) // nieuwe uiterwaard (mix) -> kruiden-/faunarijk grasland als representatieve klasse
																,case(lowercase(type) == 'water (beek bypass)', rlookup('N03.01',    INL_Beheertype/code)) // nevengeul -> beek en bron
																, null_b
															);
			attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
			attribute<NatuurType>     NatuurTypen_rel_AD    (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
		}

		
		attribute<INL_Beheertype> ExoNatuur_MNP_BAU                (rdc_25m) := NatuurType/IsExogeenOpTeLeggen_Natuur[MNP_BAU/NatuurTypen_rel_AD] ? MNP_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		attribute<INL_Beheertype> ExoNatuur_Rivier_BAU             (rdc_25m) := NatuurType/IsExogeenOpTeLeggen_Natuur[Rivierengebied_BAU/NatuurTypen_rel_AD] ? Rivierengebied_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		// attribute<INL_Beheertype> ExoNatuur_BAU                    (rdc_25m) := MakeDefined(ExoNatuur_MNP_BAU, ExoNatuur_Rivier_BAU);
		attribute<INL_Beheertype> ExoNatuur_BAU1                    (rdc_25m) := ExoNatuur_MNP_BAU;
		attribute<INL_Beheertype> ExoNatuur_BAU2                    (rdc_25m) := ExoNatuur_MNP_BAU;
		
		attribute<INL_Beheertype> ExoNatuur_Rivier_NbSMax          (rdc_25m) := NatuurType/IsExogeenOpTeLeggen_Natuur[Rivierengebied_NbSMax/NatuurTypen_rel_AD] ? Rivierengebied_NbSMax/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		attribute<INL_Beheertype> ExoNatuur_NbSMax                 (rdc_25m) := MakeDefined(ExoNatuur_Rivier_NbSMax, ExoNatuur_Rivier_NbSMax);

		attribute<INL_Beheertype> ExoWater_MNP_BAU                 (rdc_25m) := NatuurType/IsExogeenOpTeLeggen_Water[MNP_BAU/NatuurTypen_rel_AD] ? MNP_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		attribute<INL_Beheertype> ExoWater_Rivier_BAU              (rdc_25m) := NatuurType/IsExogeenOpTeLeggen_Water[Rivierengebied_BAU/NatuurTypen_rel_AD] ? Rivierengebied_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		// attribute<INL_Beheertype> ExoWater_BAU                     (rdc_25m) := MakeDefined(ExoNatuur_MNP_BAU, ExoNatuur_Rivier_BAU);
		attribute<INL_Beheertype> ExoWater_BAU1                     (rdc_25m) := ExoNatuur_MNP_BAU;
		attribute<INL_Beheertype> ExoWater_BAU2                     (rdc_25m) := ExoNatuur_MNP_BAU;
	}
}