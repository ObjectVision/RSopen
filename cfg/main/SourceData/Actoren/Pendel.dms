// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De pendel van woon- naar werkgemeente uit de CBS-tabel 85481NED, voor de indeling in pendelregio's en stadregio's (#392).
//
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Pendel
{
	unit<UInt32> Read_CBS_85481NED
	:	StorageName     = "='%RSo_DataDir%/Actoren/Pendel/cbs_85481NED_woon_werk_gemeente_'+/ModelParameters/PendelregioIndeling/Pendel_filedate+'.csv'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	URL             = "https://opendata.cbs.nl/statline/#/CBS/nl/dataset/85481NED"
	,	Source          = "CBS-tabel 85481NED, Banen van werknemers in december; woon- en werkregio's, in de kolomnamen van de onbewerkte dataset, met alleen de gemeenten in 2023 en 2024 (levering 20261123)."
	,	Descr           = "De onbewerkte CBS-tabel: per woonregio, werkregio en periode het aantal banen van werknemers in duizendtallen. Een nieuwe download van de onbewerkte dataset mag ook andere regio's en jaren bevatten; Banen kiest de gemeenten en de jaren."
	{
		attribute<String> WoonregioS;
		attribute<String> WerkregioS;
		attribute<String> Perioden;
		attribute<String> BanenVanWerknemers_1;
	}

	unit<UInt32> Banen := select_with_org_rel(
			left(trim(Read_CBS_85481NED/WoonregioS), 2) == 'GM' && trim(Read_CBS_85481NED/WoonregioS) != 'GM0000'
		&&	left(trim(Read_CBS_85481NED/WerkregioS), 2) == 'GM' && trim(Read_CBS_85481NED/WerkregioS) != 'GM0000'
		&&	right(trim(Read_CBS_85481NED/Perioden), 4) == 'MM12'
		&&	uint32(left(trim(Read_CBS_85481NED/Perioden), 4)) >= /ModelParameters/PendelregioIndeling/Pendel_EersteJaar
		&&	uint32(left(trim(Read_CBS_85481NED/Perioden), 4)) <= /ModelParameters/PendelregioIndeling/Pendel_LaatsteJaar
		&&	IsDefined(float64(Read_CBS_85481NED/BanenVanWerknemers_1))
		)
	, Descr = "De banen van werknemers tussen twee gemeenten in december van de gekozen jaren. GM0000 is een niet in te delen gemeente en valt weg, net als een lege waarde."
	{
		attribute<String>  Woon_code := trim(org_rel -> WoonregioS);
		attribute<String>  Werk_code := trim(org_rel -> WerkregioS);
		attribute<UInt32>  Jaar      := uint32(left(trim(org_rel -> Perioden), 4));
		attribute<Float64> Aantal    := float64(org_rel -> BanenVanWerknemers_1) * 1000d
		, IntegrityCheck = "#Jaren == /ModelParameters/PendelregioIndeling/Pendel_LaatsteJaar - /ModelParameters/PendelregioIndeling/Pendel_EersteJaar + 1"
		, Descr = "Banen van werknemers; CBS geeft duizendtallen. De controle eist dat elk jaar tussen het eerste en het laatste in de levering zit, anders wordt het gemiddelde over de jaren te laag.";

		unit<UInt32> Jaren := unique(Jaar), Descr = "De jaren in de levering; de indeling middelt de pendel erover.";
	}
}
