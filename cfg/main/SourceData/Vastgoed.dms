// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Brondata voor vastgoed, zoals de BAG, logistieke panden, energielabels, eigendom en WOZ-waardes Bag panden
// geklassificeerd in logistiek functies door Merten Nefs (Nefs, M. (2022). Dutch Distribution Centres 2021
// Geodata. Rotterdam: 4TU. ResearchData. DOI, 10(19361018), v1). Ontvangen van Eric Koomen op 28 maart 2022 Alle
// energielabels van woningen en utiliteitsgebouwen in Nederland Laadt via #include: BAG, WOZ, EigendomStaat.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Vastgoed: using  = "Units;Geography;Classifications;RegioIndelingen"
, Descr = "Brondata voor vastgoed, zoals de BAG, logistieke panden, energielabels, eigendom en WOZ-waardes"
{
	#include<BAG.dms>
	#include<WOZ.dms>
	#include<EigendomStaat.dms>
	
	unit<UInt32> Logistiek_panden
	:	StorageName     = "%RSo_DataDir%/Vastgoed/LogistiekBuildings/buildings2021NL_rdc.shp"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogData      = "rdc_meter"
	,	url             = "%RSo_DataDir%/Vastgoed/LogistiekBuildings/buildings2021NL_meta.txt"
	,	SyncMode        = "none"
	, 	Descr           = "Bag panden geklassificeerd in logistiek functies door Merten Nefs (Nefs, M. (2022). Dutch Distribution Centres 2021 Geodata. Rotterdam: 4TU. ResearchData. DOI, 10(19361018), v1). Ontvangen van Eric Koomen op 28 maart 2022"
	{
		attribute<rdc_meter> geometry (poly);
		attribute<UInt32>    function_n;
		attribute<String>    function;
		attribute<String>    bag_id;
		attribute<uint64>    pand_bag_nr := uint64(bag_id);
		attribute<UInt32>    constr_yea;
		
		unit<UInt32> Logistics := select_with_attr_by_cond(., function_n != 3)
		{
		}
	}
	
	unit<UInt32> Energielabels
	:	StorageName     = "%RSo_DataDir%/Vastgoed/Energielabel/VestaStartanalyse2020/RVOtot.fss"
	,	StorageReadOnly = "True"
	,	DialogType      = "Map"
	,	DialogData      = "locatie"
	,	Source          = "export uit https://pbl.sliksvn.com/vesta/PD/branch/VestaStartanalyse2020_To_RSL rev 566, GeoDMS 7.239, open S1a_B_LuchtWP.dms activate /Invoer/RuimtelijkeData/energieLabel/RVOtot --> fss in LD, ongegeveer 300000 records bleken niet koppelbaar (voor vastgesteld en voorlopig dms geocoding (zijn niet opgenomen in fss bestand)"
	,	Descr           = "Alle energielabels van woningen en utiliteitsgebouwen in Nederland"
	{
		attribute<String>                                vbo_id;
		attribute<rdc_meter>                             locatie;
		attribute<UInt8>                                 SchilLabel_rel;
		attribute<String>                                pand_id;
		attribute<UInt32>                                Bron                : Descr = "Bron van het energielabel: 1=vastgesteld,2=voorlopig,3=utiliteit (is volledig)";
		attribute<Classifications/Vastgoed/Energielabel> Energielabel_rel    := SchilLabel_rel[Classifications/Vastgoed/Energielabel];
		attribute<AllocDomain>                           AllocDomain_rel     := locatie[AllocDomain];
		attribute<AdminDomain>                           AdminDomain_rel     := locatie[AdminDomain];
		attribute<Classifications/Vastgoed/Energielabel> Modus (AdminDomain) := Modus(Energielabel_rel, locatie[AdminDomain]); //, StorageName = "%LocalDataProjDir%/BaseData/Vastgoed/Energielabels.tif", IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))";
	}
	
	container Rudifun_src
	// container Rudifun
	:	StorageName     = "%RSo_DataDir%/Vastgoed/Rudifun_2024_nl.gdb"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogData      = "rdc_meter"
	,	Descr           = "De Ruimtelijke Dichtheden en Functiemenging in Nederland (RUDIFUN) dataset geeft een indicatie van de dichtheid en morfologie van bebouwd gebied."
	, 	URL             = "https://dataportaal.pbl.nl/RUDIFUN"
	,	SyncMode        = "AllTables"
	{
		
	}
	
	container Write_Rudifun
	:	StorageName     = "%RSo_DataDir%/Vastgoed/Rudifun_2024.mmd"
	,	Descr           = "De Ruimtelijke Dichtheden en Functiemenging in Nederland (RUDIFUN) dataset geeft een indicatie van de dichtheid en morfologie van bebouwd gebied."
	, 	URL             = "https://dataportaal.pbl.nl/RUDIFUN"
	{
		unit<uint32> Netto_Buurt := Rudifun_src/nl2_04_Netto_Buurt
		{
			attribute<rdc_meter> geometry (poly) := Rudifun_src/nl2_04_Netto_Buurt/geometry;
			attribute<string>    BU_CODE         := Rudifun_src/nl2_04_Netto_Buurt/BU_CODE;
		}
		unit<uint32> Bruto_Buurt := Rudifun_src/nl2_05_Bruto_Buurt
		{
			attribute<rdc_meter> geometry (poly) := Rudifun_src/nl2_05_Bruto_Buurt/geometry;
			attribute<string>    BU_CODE         := Rudifun_src/nl2_05_Bruto_Buurt/BU_CODE;
			attribute<string>    PV_CODE         := Rudifun_src/nl2_05_Bruto_Buurt/PV_CODE;
		}
	}
	
	container Rudifun
	:	StorageName     = "%RSo_DataDir%/Vastgoed/Rudifun_2024.mmd"
	,	StorageReadOnly = "True"
	,	Descr           = "De Ruimtelijke Dichtheden en Functiemenging in Nederland (RUDIFUN) dataset geeft een indicatie van de dichtheid en morfologie van bebouwd gebied."
	, 	URL             = "https://dataportaal.pbl.nl/RUDIFUN"
	{
		// parameter<float32> BrutoTovNettoBuurt := sum(BaseData/Omgeving/Fractie_VerhardGroen_PerBuurtType/BrutoBuurt/Opp_geom) / sum(BaseData/Omgeving/Fractie_VerhardGroen_PerBuurtType/NettoBuurt/Opp_geom);
		parameter<Float32> BrutoTovNettoBuurt := 1.0519642f; //resultaat van hierboven, maar ontkoppeld.
	
	}
	
	container Funderingsschade
	{
		unit<uint32> per_Buurt
		:	StorageName     = "%RSo_DataDir%/Vastgoed/funderingskosten_buurten2020.csv"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = "Funderingsschade ontvangen van Deltares d.d. 15-12-2025"
		{
			unit<uint32> Buurt := RegioIndelingen/CBS/Y2020/Buurt;
			
			attribute<Buurt>     Buurt_rel       := rlookup(buurtcode, Buurt/statcode);
			attribute<rdc_meter> geometry (poly) := Buurt/geometry[buurt_rel];
			attribute<uint32>    no_building     := num_buildings_buurt[uint32];
			attribute<float32>   cost_timber     := cost_timber_buurt[float32];
			attribute<float32>   cost_shallow    := cost_shallow_buurt[float32];
			attribute<float32>   total_cost      := total_cost_buurt[float32];
		}
		
		container Read_per_Object
		:	StorageName     = "%PrivDataDir%/Funderingsschade/buildings_pts_with_timber_shallow_costs.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	Descr           = "Funderingsschade ontvangen van Deltares d.d. 15-12-2025"
		,	DialogData      = "rdc_meter"
		{
			unit<uint32> strong_climate_change
			{
				// attribute<rdc_meter> geometry (arc);
				unit<uint32> s2p := sequence2points(geometry); //pointset in deze gkpg is een multipoint (terwijl alles maar 1 punt heeft), dat is vervelend dus zorgen we voor een normale pointset.
			}
		}
		
		unit<uint32> per_Object := Read_per_Object/strong_climate_change/s2p
		{
			attribute<rdc_meter>       geometry             := point;
			// attribute<float32>         p_hout_fundering     := Read_per_Object/strong_climate_change/p_timber_pile[float32], Descr = "";
			// attribute<float32>         p_staal_fundering    := Read_per_Object/strong_climate_change/p_shallow_found[float32], Descr = "";
			// attribute<float32>         p_beton_fundering    := Read_per_Object/strong_climate_change/p_beton[float32], Descr = "";
			
			// attribute<float32>         cost_hout_fundering  := Read_per_Object/strong_climate_change/cost_timber_piles[float32], Descr = "";
			// attribute<float32>         cost_staal_fundering := Read_per_Object/strong_climate_change/cost_shallow_found[float32], Descr = "";
		
			attribute<float32>         p_hout_fundering     := Read_per_Object/strong_climate_change/p_timber_pile[Read_per_Object/strong_climate_change/s2p/sequence_rel][float32], Descr = "";
			attribute<float32>         p_staal_fundering    := Read_per_Object/strong_climate_change/p_shallow_found[Read_per_Object/strong_climate_change/s2p/sequence_rel][float32], Descr = "";
			attribute<float32>         p_beton_fundering    := Read_per_Object/strong_climate_change/p_beton[Read_per_Object/strong_climate_change/s2p/sequence_rel][float32], Descr = "";
			attribute<float32>         cost_hout_fundering  := Read_per_Object/strong_climate_change/cost_timber_piles[Read_per_Object/strong_climate_change/s2p/sequence_rel][float32], Descr = "";
			attribute<float32>         cost_staal_fundering := Read_per_Object/strong_climate_change/cost_shallow_found[Read_per_Object/strong_climate_change/s2p/sequence_rel][float32], Descr = "";
			
			attribute<yr>              Bouwjaar             := per_Pand/bouwjaar_trunc[pand_rel], Descr = "";
			attribute<WP5>             t_i                  := per_Pand/WP5_rel[pand_rel], Descr = "Woningtype van pand i (bijvoorbeeld: rijwoning, hoekwoning, vrijstaand, appartement).";
			
			attribute<per_Pand>        pand_rel             := point_in_polygon(geometry, per_Pand/geometry), Descr = "";
			attribute<BouwjaarKlassen> c_i                  := Classify(Bouwjaar, BouwjaarKlassen/ClassBreaks), Descr = "Bouwjaarklasse van pand i (bijvoorbeeld: vóór 1940, 1940–1969, 1970–1989, ≥1990).";
			
			attribute<float32>         y_hout_i             := p_hout_fundering  * cost_hout_fundering,  Descr = "Verwachte funderingsschade per pand uit de houten-palen-component (kans x herstelkosten).";
			attribute<float32>         y_staal_i            := p_staal_fundering * cost_staal_fundering, Descr = "Verwachte funderingsschade per pand uit de op-staal-component (kans x herstelkosten).";
			attribute<float32>         y_i                  := y_hout_i + y_staal_i, Descr = "Verwachte funderingsschade per pand, afgeleid uit private gegevens over funderingstype en herstelkosten.";
			attribute<float32>         s_i                  := per_Pand/Counts/woon_VBOs[pand_rel][float32], Descr = "Schaalfactor voor pand i: aantal woningen in het pand";
			attribute<float32>         y_perWoning          := s_i > 0f ? y_i       / s_i : null_f, Descr = "Verwachte schade per woning. Basis voor de per-woning-cap (voorkomt dubbeltelling van pandgrootte).";
			attribute<float32>         yh_perWoning         := s_i > 0f ? y_hout_i  / s_i : null_f, Descr = "Houten-palen-schade per woning; basis voor het r_hout-kental.";
			attribute<float32>         ys_perWoning         := s_i > 0f ? y_staal_i / s_i : null_f, Descr = "Op-staal-schade per woning; basis voor het r_staal-kental.";
			attribute<WP_x_BJ>         WP_x_BJ_rel          := combine_data(WP_x_BJ, t_i, c_i), Descr = "Klasse-combinatie woningtype x bouwjaarklasse van pand i (index in de WP_x_BJ-kruistabel; niet de gridcel).";
			attribute<per_Buurt>       buurt_rel            := point_in_polygon(geometry, per_Buurt/geometry), Descr = "Buurt van pand i; t.b.v. de fit-diagnose.";
			attribute<AdminDomain>     AdminDomain_rel      := geometry[AdminDomain], Descr = "25m-cel van pand i; t.b.v. de fit-diagnose op celniveau.";

			attribute<float32>         w_i                  := WP_x_BJ/r_totaal[WP_x_BJ_rel]   * s_i, Descr = "Totaalgewicht (klassekental op totale schade per woning x s_i); alleen nog t.b.v. de fit-vergelijking met de gesplitste variant.";
			attribute<float32>         w_hout_i             := WP_x_BJ/r_hout[WP_x_BJ_rel]  * s_i, Descr = "Publiek herleidbaar verdeelgewicht voor de houten-palen-kosten.";
			attribute<float32>         w_staal_i            := WP_x_BJ/r_staal[WP_x_BJ_rel] * s_i, Descr = "Publiek herleidbaar verdeelgewicht voor de op-staal-kosten.";
		}
		
		container Write_Kentallen
		:	StorageName = "%RSo_DataDir%/Vastgoed/funderingskosten_kentallen.mmd"
		,	Descr       = "Geaggregeerde, publiceerbare kentallen uit de private set: relatieve risicofactor per cel woningtype x bouwjaarklasse (geschat op schade per woning, genormaliseerd op gemiddelde 1), plus het landelijk gemiddelde en het 95e percentiel van de schade per woning. Vervangt de marginale r_jaar/r_type-kentallen: celgemiddelden vangen de interactie tussen bouwjaar en woningtype, en de per-woning-basis voorkomt dubbeltelling van pandgrootte met de schaalterm s_i."
		{
			parameter<float32> mean_y_perWoning := mean(per_Object/y_perWoning), Descr = "Landelijk gemiddelde verwachte schade per woning (private set).";
			parameter<float32> P95_perWoning    := rth_element(per_Object/y_perWoning, 0.95f), Descr = "95e percentiel van de verwachte schade per woning (private set); ter rapportage.";
			parameter<float32> P99_perWoning    := rth_element(per_Object/y_perWoning, 0.99f), Descr = "99e percentiel van de verwachte schade per woning (private set); capbasis: k_i <= s_i * P99_perWoning. P95 bleek samen te vallen met het standaard-herstelbedrag voor houten palen en kapte daardoor reguliere schade af.";

			container r_totaal :=
				for_each_nedv(
					WP_x_BJ/name
					, 'mean(per_Object/WP_x_BJ_rel == '+string(id(WP_x_BJ))+'[WP_x_BJ] ? per_Object/y_perWoning : null_f) / mean(per_Object/y_perWoning)'
					, void
					, float32
				), Descr = "Relatieve risicofactor per cel (woningtype x bouwjaarklasse), geschat op totale schade per woning; t.b.v. vergelijking met de gesplitste kentallen.";

			container r_hout :=
				for_each_nedv(
					WP_x_BJ/name
					, 'mean(per_Object/WP_x_BJ_rel == '+string(id(WP_x_BJ))+'[WP_x_BJ] ? per_Object/yh_perWoning : null_f) / mean(per_Object/yh_perWoning)'
					, void
					, float32
				), Descr = "Relatieve risicofactor per cel voor de houten-palen-component, geschat op houtschade per woning; verdeelt de openbare cost_timber-buurtkosten.";

			container r_staal :=
				for_each_nedv(
					WP_x_BJ/name
					, 'mean(per_Object/WP_x_BJ_rel == '+string(id(WP_x_BJ))+'[WP_x_BJ] ? per_Object/ys_perWoning : null_f) / mean(per_Object/ys_perWoning)'
					, void
					, float32
				), Descr = "Relatieve risicofactor per cel voor de op-staal-component, geschat op staalschade per woning; verdeelt de openbare cost_shallow-buurtkosten.";
		}

		container Kentallen : StorageName = "%RSo_DataDir%/Vastgoed/funderingskosten_kentallen.mmd", StorageReadOnly = "true", Descr = "Ontkoppelde kentallen; zie Write_Kentallen. Publicatie behoeft akkoord Deltares.";

		// Verouderd (marginale ratio's op y per pand; vervangen door Write_Kentallen/Kentallen): behouden ter vergelijking.
		container Write_r_jaar :=
			for_each_nedv(
				BouwjaarKlassen/name
				, 'mean(per_Object/c_i == '+string(id(BouwjaarKlassen))+'[BouwjaarKlassen] ? per_Object/y_i : null_f) / mean(per_Object/y_i)'
				, void
				, float32
			), StorageName = "%RSo_DataDir%/Vastgoed/funderingskosten_r_jaar.mmd", Descr = "Relatieve risicofactor voor funderingsschade voor bouwjaarklasse c. Afgeleid uit een private kalibratieset, maar gepubliceerd als geaggregeerd kental. Genormaliseerd zodat de gemiddelde of mediane waarde gelijk is aan 1.";
			
		container Write_r_type := 
			for_each_nedv(
				WP5/name
				, 'mean(per_Object/t_i == '+string(id(WP5))+'[WP5] ? per_Object/y_i : null_f) / mean(per_Object/y_i)'
				, void
				, float32
			), StorageName = "%RSo_DataDir%/Vastgoed/funderingskosten_r_type.mmd", Descr = "Relatieve risicofactor voor funderingsschade voor woningtype t. Afgeleid uit een private kalibratieset, maar gepubliceerd als geaggregeerd kental. Genormaliseerd zodat de gemiddelde of mediane waarde gelijk is aan 1.";
		
		container r_jaar : StorageName = "%RSo_DataDir%/Vastgoed/funderingskosten_r_jaar.mmd", StorageReadOnly = "true", Descr = "Relatieve risicofactor voor funderingsschade voor bouwjaarklasse c. Afgeleid uit een private kalibratieset, maar gepubliceerd als geaggregeerd kental. Genormaliseerd zodat de gemiddelde of mediane waarde gelijk is aan 1.";
		container r_type : StorageName = "%RSo_DataDir%/Vastgoed/funderingskosten_r_type.mmd", StorageReadOnly = "true", Descr = "Relatieve risicofactor voor funderingsschade voor woningtype t. Afgeleid uit een private kalibratieset, maar gepubliceerd als geaggregeerd kental. Genormaliseerd zodat de gemiddelde of mediane waarde gelijk is aan 1.";
		
		unit<uint32> per_Pand := ='/SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/BAG_RecentYear)+'/pand'
		{
			attribute<WP5>             t_i                       := WP5_rel, Descr = "Woningtype van pand i (bijvoorbeeld: rijwoning, hoekwoning, vrijstaand, appartement).";
			attribute<BouwjaarKlassen> c_i                       := Classify(Bouwjaar_trunc, BouwjaarKlassen/ClassBreaks), Descr = "Bouwjaarklasse van pand i (bijvoorbeeld: vóór 1940, 1940–1969, 1970–1989, ≥1990).";
			attribute<float32>         s_i                       := Counts/woon_VBOs[float32], Descr = "Schaalfactor voor pand i: aantal woningen in het pand";
			
			attribute<WP_x_BJ>         WP_x_BJ_rel                   := combine_data(WP_x_BJ, t_i, c_i), Descr = "Klasse-combinatie woningtype x bouwjaarklasse van pand i (index in de WP_x_BJ-kruistabel; niet de gridcel).";
			attribute<float32>         w_hout_i                  := WP_x_BJ/r_hout[WP_x_BJ_rel]  * s_i, Descr = "Publiek herleidbaar verdeelgewicht voor de houten-palen-kosten: klassekental maal aantal woningen; niet zelf een eurobedrag.";
			attribute<float32>         w_staal_i                 := WP_x_BJ/r_staal[WP_x_BJ_rel] * s_i, Descr = "Publiek herleidbaar verdeelgewicht voor de op-staal-kosten: klassekental maal aantal woningen; niet zelf een eurobedrag.";

			attribute<Eur_pand>        k_hout_i                  := (C_b_hout[buurt_rel]  * (w_hout_i  / sum(w_hout_i,  buurt_rel)[buurt_rel]))[Eur_pand], Descr = "Toegerekend deel van de houten-palen-buurtkosten aan pand i.";
			attribute<Eur_pand>        k_staal_i                 := (C_b_staal[buurt_rel] * (w_staal_i / sum(w_staal_i, buurt_rel)[buurt_rel]))[Eur_pand], Descr = "Toegerekend deel van de op-staal-buurtkosten aan pand i.";
			attribute<Eur_pand>        k_i                       := IsDefined(w_hout_i) || IsDefined(w_staal_i)
																	? MakeDefined(k_hout_i, 0[Eur_pand]) + MakeDefined(k_staal_i, 0[Eur_pand])
																	: null_f[Eur_pand], Descr = "Toegerekend deel van de buurtkosten aan pand i: som van de per component (hout/staal) verdeelde openbare buurtkosten. Panden zonder enig toerekenbaar gewicht blijven null.";

			attribute<per_Buurt>       buurt_rel                 := point_in_polygon(centroid_or_mid(geometry), per_Buurt/geometry), Descr = "";
			attribute<float32>         C_b           (per_Buurt) := per_Buurt/total_cost,   Descr = "Totale geschatte funderingsschade (euro) in buurt b.";
			attribute<float32>         C_b_hout      (per_Buurt) := per_Buurt/cost_timber,  Descr = "Houten-palen-component van de buurtkosten.";
			attribute<float32>         C_b_staal     (per_Buurt) := per_Buurt/cost_shallow, Descr = "Op-staal-component van de buurtkosten.";

			attribute<Eur_pand>        cap_i                           := (s_i * Kentallen/P99_perWoning)[Eur_pand], Descr = "Per-woning-cap: aantal woningen maal P99 van de schade per woning. Grote (appartementen)panden houden zo hun legitieme schade; alleen echte uitschieters worden afgekapt.";

			// Cap + herverdeling binnen de buurt, exact in een pass: het boven de cap afgekapte surplus wordt
			// naar rato van de resterende capruimte over de overige panden in de buurt verdeeld. Omdat de
			// aanvulling per pand nooit groter is dan de eigen capruimte, blijft iedereen onder de cap.
			// Wat boven de gezamenlijke buurtcap uitkomt is per definitie onvermijdbaar verlies.
			// N.b. alles in zuivere unit-algebra (Eur_pand x pand = Eur); casts tussen metrics staat GeoDMS niet toe.
			attribute<Eur_pand>        kcap0_i                          := IsDefined(k_i) ? min_elem(k_i, cap_i) : null_f[Eur_pand]; // guard: min_elem(null, cap) geeft cap; panden zonder toerekenbaar gewicht moeten null blijven
			attribute<Eur_pand>        surplus_i                        := k_i - kcap0_i,   Descr = "Boven de cap afgekapt deel van pand i.";
			attribute<Eur_pand>        head_i                           := cap_i - kcap0_i, Descr = "Resterende capruimte van pand i.";
			attribute<Eur>             surplus_b             (per_Buurt) := sum(surplus_i * 1[PandUnit], buurt_rel), Descr = "Afgekapt surplus per buurt.";
			attribute<Eur>             head_b                (per_Buurt) := sum(head_i    * 1[PandUnit], buurt_rel), Descr = "Totale resterende capruimte per buurt.";
			attribute<Eur_pand>        extra_i                          := min_elem(surplus_b[buurt_rel], head_b[buurt_rel]) * head_i / max_elem(head_b[buurt_rel], 0.001[Eur]), Descr = "Herverdeeld surplus naar pand i, naar rato van de resterende capruimte; 0 zodra de buurt geen capruimte meer heeft (epsilon-noemer voorkomt 0/0).";

			attribute<Eur_pand>        k_i_censored                     := kcap0_i + extra_i, Descr = "Pandbedrag na cap en herverdeling binnen de buurt; null voor panden zonder toerekening.";
			attribute<Eur>             k        (CompactedAdminDomain) := sum(k_i_censored[ToedelingsMatrix/Pand_rel] * ToedelingsMatrix/ToedelingPand * 1[PandUnit], ToedelingsMatrix/CompactedAdminDomain_rel); // eindresultaat: Eur/pand x pand-fractie x pand -> Eur per cel
			attribute<Eur_pand>        Verschil                        := k_i - k_i_censored, Descr = "Netto mutatie per pand door cap en herverdeling (negatief voor ontvangers); de som over alle panden is het onvermijdbare verlies.";
		}
		
		container Validatie
		: Descr = "Controlegrootheden: de pandtoerekening hoort exact op te tellen naar de openbare buurttotalen (C_b); afwijkingen komen door de per-woning-cap (na herverdeling alleen het onvermijdbare deel) en door buurten zonder geldige gewichten (w null)."
		{
			parameter<Eur>     Som_Buurtkosten          := sum(per_Buurt/total_cost)[Eur],       Descr = "Som van de openbare buurtkosten C_b.";
			parameter<Eur>     Som_k_i                  := sum(per_Pand/k_i          * 1[PandUnit]), Descr = "Som van de toegerekende pandbedragen voor cap/herverdeling; hoort gelijk te zijn aan Som_Buurtkosten, op niet-toerekenbare buurten na.";
			parameter<Eur>     Som_k_i_censored         := sum(per_Pand/k_i_censored * 1[PandUnit]), Descr = "Som van de pandbedragen na cap en herverdeling.";
			parameter<Eur>     CensoringVerlies         := sum(per_Pand/Verschil     * 1[PandUnit]), Descr = "Netto verlies door de cap na herverdeling binnen de buurt; hoort samen te vallen met OnvermijdbaarVerlies.";
			parameter<float32> CensoringVerlies_fractie := (CensoringVerlies / Som_k_i)[float32],    Descr = "Cap-verlies als fractie van het toegerekende totaal.";
			parameter<Eur>     NietToegerekend          := Som_Buurtkosten - Som_k_i,            Descr = "Buurtkosten die niet aan panden zijn toegerekend (buurten zonder panden of waar alle gewichten null zijn).";
			parameter<Eur>     Som_k_grid               := sum(per_Pand/k),                      Descr = "Som van het eindresultaat op het 25m-grid; hoort gelijk te zijn aan Som_k_i_censored, op toedelingsranden na.";

			parameter<Eur>     Som_Buurtkosten_componenten := sum(per_Buurt/cost_timber + per_Buurt/cost_shallow)[Eur], Descr = "Som van de hout- en staalcomponenten; check tegen Som_Buurtkosten (total_cost).";

			attribute<Eur>     Som_k_b   (per_Buurt)    := sum(per_Pand/k_i * 1[PandUnit], per_Pand/buurt_rel), Descr = "Toegerekende kosten per buurt.";
			attribute<Eur>     Som_cap_b (per_Buurt)    := sum(IsDefined(per_Pand/k_i) ? per_Pand/cap_i * 1[PandUnit] : null_f[Eur], per_Pand/buurt_rel), Descr = "Maximaal draagbare kosten per buurt onder de per-woning-cap (som van de caps van panden met toerekening).";
			parameter<Eur>     OnvermijdbaarVerlies     := sum(max_elem(Som_k_b - Som_cap_b, 0[Eur])), Descr = "Deel van de toegerekende buurtkosten dat zelfs bij volledige herverdeling binnen de buurt boven de gezamenlijke cap uitkomt; ondergrens voor elk censoring-verlies bij deze caphoogte.";

			unit<uint8> Export : NrOfRows = 9
			,	StorageName = "%LocalDataProjDir%/Indicatoren/Funderingsschade_Validatie.csv"
			,	StorageType = "gdalwrite.vect"
			{
				attribute<string> naam   : ['Som_Buurtkosten','Som_Buurtkosten_componenten','Som_k_i','Som_k_i_censored','CensoringVerlies','CensoringVerlies_fractie','OnvermijdbaarVerlies','NietToegerekend','Som_k_grid'];
				attribute<string> waarde := union_data(., string(Som_Buurtkosten), string(Som_Buurtkosten_componenten), string(Som_k_i), string(Som_k_i_censored), string(CensoringVerlies), string(CensoringVerlies_fractie), string(OnvermijdbaarVerlies), string(NietToegerekend), string(Som_k_grid));
			}
		}

		container Fit
		: Descr = "Diagnose op de private set: (1) hoe goed benaderen de publieke verdeelgewichten de private schadeverdeling binnen buurten (R2, op pand- en 25m-celniveau, voor het totaalgewicht en de hout/staal-splitsing); (2) sporen de private pandtotalen per buurt met de openbare buurttotalen (scenario-check). Alleen geaggregeerde uitkomsten."
		{
			attribute<float32> y_hat_totaal (per_Object) := sum(per_Object/y_i, per_Object/buurt_rel)[per_Object/buurt_rel] * (per_Object/w_i / sum(per_Object/w_i, per_Object/buurt_rel)[per_Object/buurt_rel]), Descr = "Voorspelde schade per pand o.b.v. het ongesplitste totaalgewicht (r_totaal).";

			attribute<float32> y_hat_hout   (per_Object) := sum(per_Object/y_hout_i,  per_Object/buurt_rel)[per_Object/buurt_rel] * (per_Object/w_hout_i  / sum(per_Object/w_hout_i,  per_Object/buurt_rel)[per_Object/buurt_rel]), Descr = "Voorspelde houten-palen-schade per pand o.b.v. r_hout.";
			attribute<float32> y_hat_staal  (per_Object) := sum(per_Object/y_staal_i, per_Object/buurt_rel)[per_Object/buurt_rel] * (per_Object/w_staal_i / sum(per_Object/w_staal_i, per_Object/buurt_rel)[per_Object/buurt_rel]), Descr = "Voorspelde op-staal-schade per pand o.b.v. r_staal.";
			attribute<float32> y_hat_split  (per_Object) := IsDefined(per_Object/w_hout_i) || IsDefined(per_Object/w_staal_i)
															? MakeDefined(y_hat_hout, 0f) + MakeDefined(y_hat_staal, 0f)
															: null_f, Descr = "Voorspelde schade per pand o.b.v. de hout/staal-splitsing.";

			attribute<float32> y_obs_t (per_Object) := IsDefined(y_hat_totaal) ? per_Object/y_i : null_f, Descr = "Waargenomen schade, beperkt tot panden met een totaalgewicht-voorspelling.";
			attribute<float32> y_obs_s (per_Object) := IsDefined(y_hat_split)  ? per_Object/y_i : null_f, Descr = "Waargenomen schade, beperkt tot panden met een splitsing-voorspelling.";

			parameter<float32> R2_pand_totaal := 1f - sum(sqr(y_obs_t - y_hat_totaal)) / sum(sqr(y_obs_t - mean(y_obs_t))), Descr = "R2 op pandniveau, ongesplitst totaalgewicht.";
			parameter<float32> R2_pand_split  := 1f - sum(sqr(y_obs_s - y_hat_split))  / sum(sqr(y_obs_s - mean(y_obs_s))), Descr = "R2 op pandniveau, hout/staal-splitsing.";

			attribute<float32> Y_cel  (AdminDomain) := sum(y_obs_s,     per_Object/AdminDomain_rel), Descr = "Waargenomen schade per 25m-cel.";
			attribute<float32> Yh_cel (AdminDomain) := sum(y_hat_split, per_Object/AdminDomain_rel), Descr = "Voorspelde schade per 25m-cel (splitsing).";
			attribute<float32> Y_celm (AdminDomain) := IsDefined(Yh_cel) ? Y_cel : null_f;

			parameter<float32> R2_cel25m_split := 1f - sum(sqr(Y_celm - Yh_cel)) / sum(sqr(Y_celm - mean(Y_celm))), Descr = "R2 op 25m-celniveau (splitsing); het relevante kwaliteitscijfer voor RS, dat op celniveau rekent.";

			attribute<float32> Som_y_buurt (per_Buurt) := sum(per_Object/y_i, per_Object/buurt_rel), Descr = "Som van de private pandschades per buurt.";
			attribute<float32> x_b         (per_Buurt) := IsDefined(Som_y_buurt) ? per_Buurt/total_cost : null_f, Descr = "Openbare buurtkosten, beperkt tot buurten met private panden.";
			attribute<float32> y_b         (per_Buurt) := IsDefined(x_b) ? Som_y_buurt : null_f;

			parameter<float32> Ratio_publiek_privaat := sum(x_b) / sum(y_b), Descr = "Verhouding openbare buurtkosten / private pandtotalen; 1 = zelfde schaal (zelfde scenario/vintage).";
			parameter<float32> Corr_buurt            := (mean(x_b * y_b) - mean(x_b) * mean(y_b)) / (sqrt(mean(x_b * x_b) - sqr(mean(x_b))) * sqrt(mean(y_b * y_b) - sqr(mean(y_b)))), Descr = "Correlatie tussen openbare buurtkosten en private buurttotalen.";

			unit<uint8> Export : NrOfRows = 9
			,	StorageName = "%LocalDataProjDir%/Indicatoren/Funderingsschade_Fit.csv"
			,	StorageType = "gdalwrite.vect"
			{
				attribute<string> naam   : ['R2_pand_totaal','R2_pand_split','R2_cel25m_split','Ratio_publiek_privaat','Corr_buurt','P95_perWoning','P99_perWoning','mean_y_perWoning','Som_y_privaat'];
				attribute<string> waarde := union_data(., string(R2_pand_totaal), string(R2_pand_split), string(R2_cel25m_split), string(Ratio_publiek_privaat), string(Corr_buurt), string(Kentallen/P95_perWoning), string(Kentallen/P99_perWoning), string(Kentallen/mean_y_perWoning), string(sum(y_b)));
			}
		}

		unit<uint8> WP_x_BJ := combine_uint8(WP5, BouwjaarKlassen)
		{
			attribute<string>  WP_name := WP5/name[first_rel];
			attribute<string>  BJ_name := BouwjaarKlassen/name[second_rel];
			attribute<string>  name    := WP_name + '_x_' + BJ_name;
			attribute<float32> r_totaal   := ='union_data(., '+AsList('Kentallen/r_totaal/'+name,   ',')+')', Descr = "Ontkoppelde relatieve risicofactor per cel (totale schade; t.b.v. fit-vergelijking).";
			attribute<float32> r_hout  := ='union_data(., '+AsList('Kentallen/r_hout/'+name,  ',')+')', Descr = "Ontkoppelde relatieve risicofactor per cel, houten-palen-component.";
			attribute<float32> r_staal := ='union_data(., '+AsList('Kentallen/r_staal/'+name, ',')+')', Descr = "Ontkoppelde relatieve risicofactor per cel, op-staal-component.";
		}
		
		unit<uint8> BouwjaarKlassen := cat_range(0b, 4b)
		{
			attribute<string> label          : ['<1940', '1940-1969', '1970-1989', '>=1990'];
			attribute<string> name           := AsItemName(label);
			attribute<yr>     ClassBreaks   : [0, 1940, 1970, 1990], DialogType = "Classification";
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		}
	}	
}