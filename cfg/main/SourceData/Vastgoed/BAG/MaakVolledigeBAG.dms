////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Maakt de VolledigeTabel uit de mmd-stores van BAG20_Xml2MMD uit de BAG-tools: per objecttype een tabel met
// alle voorkomens, dus de volledige historie van statussen en geldigheid. RSopen leest alleen pand, vbo en
// nummeraanduiding. De tabellen zijn compact, zoals in Hestia: identificaties als uint64, de status als code
// met per tabel een labeltabel, de registratiedatums als getal, de coordinaten in millimeters en alleen de
// velden die SourceData/Vastgoed/BAG leest (#839).
//


container MaakVolledigeBAG : using = "Classifications/Vastgoed"
, Descr = "Maakt de VolledigeTabel uit de mmd-stores van BAG20_Xml2MMD uit de BAG-tools: voor pand, vbo en nummeraanduiding een tabel met alle voorkomens. Compact, zoals in Hestia: identificaties als uint64, de status als code met een labeltabel, de registratiedatums als jjjjmmdd, de coordinaten als millimeters en alleen de velden die SourceData/Vastgoed/BAG leest; bij elke relatie vbo-pand de rij van het vbo-voorkomen (#839). Schrijft niets als de map van deze levering al bestaat, want die staat op de share."
{
	parameter<String>  Snapshot_Date_Input := ModelParameters/BAG_file_date;
	parameter<String>  SrcFileDir          := '%BAG_DataDir%/' + Snapshot_Date_Input + '/mmd', Descr = "De StoreDir van BAG20_Xml2MMD voor deze levering.";
	parameter<String>  ResultDir           := '%RSo_DataDir%/Vastgoed/' + ModelParameters/BAG_VolledigeTabel;
	parameter<String>  FileNeeded          := expand(., SrcFileDir) + '/pand/nr_stores.csv';
	parameter<Bool>    isValidSrcFileDir   := ExistingFile('missing', FileNeeded) == FileNeeded;
	parameter<String>  ResultFile          := expand(., ResultDir) + '/vbo.mmd/0Dictionary.dms';
	parameter<Bool>    ResultBestaatAl     := ExistingFile('missing', ResultFile) == ResultFile
	, Descr = "De VolledigeTabel van deze levering bestaat al. De map staat op de share, die schrijf-eenmaal is, dus dan schrijft MaakVolledigeBAGTabel niets; een nieuwe levering krijgt een nieuwe ModelParameters/BAG_file_date.";

	parameter<String> SuppliersExprAll := isValidSrcFileDir && !ResultBestaatAl
		? 'object/pand/write_result;object/vbo/write_result;object/nummeraanduiding/write_result;Metadata'
		: '';

	parameter<String> MaakVolledigeBAGTabel :=
		ResultBestaatAl     ? 'Map ' + expand(., ResultDir) + ' bestaat al' :
		isValidSrcFileDir   ? 'Ready'
							: 'Map ' + expand(., SrcFileDir) + ' bevat geen volledige set mmd-stores van BAG20_Xml2MMD'
	, ExplicitSuppliers = "= SuppliersExprAll"
	, Descr = "Schrijft de VolledigeTabel als de SrcFileDir de stores van BAG20_Xml2MMD bevat en de map van deze levering nog niet bestaat.";

	unit<IPoint> rdc_mm_rond := gridset(/Geography/rdc_meter, point_yx(0.001, 0.001), point_yx(-0.0005, -0.0005), ipoint)
	, Descr = "Millimeters, een halve millimeter verschoven. De omzetting van meters naar een gridset kapt af, en bij coordinaten met precies millimeters valt het product met duizend soms net onder het gehele getal; via deze gridset wordt dat afronden. De getallen zijn daarna de millimeters van Geography/rdc_mm.";

	container Object
	{
		container pand
		{
			parameter<String> nr_stores : StorageName = "= SrcFileDir + '/pand/nr_stores.csv'", StorageType = "str";
			unit<UInt32> fileset := range(uint32, 1, uint32(nr_stores) + 1);
			container Filesets := for_each_ne(
				  'nr_' + string(id(fileset))
				, 'per_fileset(' + string(id(fileset)) + '[fileset])'
				), Descr = "Per fileset (deelbestand) de store en de afronding van de vlakken.";

			template per_fileset
			{
				parameter<fileset> nr_fileseset;
				// end case Parameters

				unit<UInt32> file
				: StorageName     = "= SrcFileDir + '/pand/fs_' + string(nr_fileseset) + '.mmd'"
				, StorageReadOnly = "True";

				unit<UInt32> punten := sequence2points(file/geometry)
				, Descr = "De punten van de pandvlakken, om ze een voor een op millimeters af te ronden."
				{
					attribute<rdc_mm_rond>      rond := point[rdc_mm_rond];
					attribute<Geography/rdc_mm> mm   := point_yx(PointRow(rond), PointCol(rond), Geography/rdc_mm);
				}
				attribute<Geography/rdc_mm> geometry_mm (file, polygon) := points2polygon(punten/mm, punten/sequence_rel, punten/ordinal), Descr = "Het pandvlak in millimeters, per punt afgerond.";
			}

			unit<UInt32> src := = 'union_unit(' + asList('Filesets/nr_' + string(id(fileset)) + '/File', ',') + ')'
			, Descr = "Alle filesets samen."
			{
				attribute<Geography/rdc_mm> geometry_mm (polygon)  := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/geometry_mm', ',') + ')';
				attribute<String>           identificatie          := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/identificatie', ',') + ')';
				attribute<Int16>            oorspronkelijkBouwjaar := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/oorspronkelijkBouwjaar', ',') + ')';
				attribute<pand_status>      status_rel             := rlookup(LowerCase(meta/STATUS), LowerCase(pand_status/Label));

				container meta
				{
					attribute<String> STATUS              (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/STATUS', ',') + ')';
					attribute<Int32>  BEGINDATUM          (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/BEGINDATUM', ',') + ')';
					attribute<Int32>  EINDDATUM           (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/EINDDATUM', ',') + ')';
					attribute<String> TIJDSTIPREGISTRATIE (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/TIJDSTIPREGISTRATIE', ',') + ')';
					attribute<String> EINDREGISTRATIE     (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/EINDREGISTRATIE', ',') + ')';
				}
			}

			unit<UInt32> write_result := src
			, StorageName = "= ResultDir + '/pand.mmd'"
			, DialogType  = "Map"
			, DialogData  = "geometry_mm"
			, Descr       = "Per voorkomen: identificatie, vlak, oorspronkelijk bouwjaar, de vlaggen van de vaste studiegebieden, status, geldigheid en registratie."
			{
				attribute<uint64>           identificatie      := uint64(src/identificatie);
				attribute<Geography/rdc_mm> geometry_mm (poly) := bg_simplify_polygon(src/geometry_mm, 0.1);
				attribute<uint16>           Bouwjaar           := uint16(src/oorspronkelijkBouwjaar);

				attribute<Bool>             IsNederland        := IsDefined(point_in_polygon(centroid_or_mid(geometry_mm[rdc_meter]), /Geography/StudyAreas/rdc_Nederland/geometry));
				attribute<Bool>             IsFriesland        := IsDefined(point_in_polygon(centroid_or_mid(geometry_mm[rdc_meter]), /Geography/StudyAreas/PerProv/Friesland/rdc_prov/geometry));
				attribute<Bool>             IsUtrecht          := IsDefined(point_in_polygon(centroid_or_mid(geometry_mm[rdc_meter]), /Geography/StudyAreas/PerProv/Utrecht/rdc_prov/geometry));
				attribute<Bool>             IsNoord_Holland    := IsDefined(point_in_polygon(centroid_or_mid(geometry_mm[rdc_meter]), /Geography/StudyAreas/PerProv/Noord_Holland/rdc_prov/geometry));

				container meta
				{
					attribute<uint8> status_code         (write_result) := uint8(src/status_rel), Descr = "Index in status/Label.";
					attribute<Int32> Begindatum          (write_result) := src/meta/BEGINDATUM;
					attribute<Int32> Einddatum           (write_result) := src/meta/EINDDATUM;
					attribute<Int32> TIJDSTIPREGISTRATIE (write_result) := int32(replace(substr(src/meta/TIJDSTIPREGISTRATIE, 0, 10), '-', '')), Descr = "De registratiedatum van het voorkomen als jjjjmmdd; SourceData/Vastgoed/BAG neemt hem als begindatum waar die voor 1960 ligt.";
					attribute<Int32> EINDREGISTRATIE     (write_result) := int32(replace(substr(src/meta/EINDREGISTRATIE, 0, 10), '-', '')), Descr = "De datum van de eindregistratie als jjjjmmdd; idem voor de einddatum.";
				}

				unit<UInt8> status := pand_status
				, Descr = "De labels bij status_code; de lezer koppelt de code via de tekst en niet via de volgorde."
				{
					attribute<String> Label := pand_status/Label;
				}
			}
		}

		container vbo
		{
			parameter<String> nr_stores : StorageName = "= SrcFileDir + '/vbo/nr_stores.csv'", StorageType = "str";
			unit<UInt32> fileset := range(uint32, 1, uint32(nr_stores) + 1)
			{
				attribute<UInt32> nr_voorkomens := pcount(src/fileset_rel);
				attribute<UInt32> eerste_rij    := cumulate(nr_voorkomens) - nr_voorkomens, Descr = "De rij in src van het eerste voorkomen van deze fileset; mutatie_rel in gerelateerdPand telt binnen de fileset.";
			}
			container Filesets := for_each_ne(
				  'nr_' + string(id(fileset))
				, 'per_fileset(' + string(id(fileset)) + '[fileset])'
				), Descr = "Per fileset (deelbestand) de store.";

			template per_fileset
			{
				parameter<fileset> nr_fileseset;
				// end case Parameters

				unit<UInt32> file
				: StorageName     = "= SrcFileDir + '/vbo/fs_' + string(nr_fileseset) + '.mmd'"
				, StorageReadOnly = "True";
			}

			unit<UInt32> src := = 'union_unit(' + asList('Filesets/nr_' + string(id(fileset)) + '/File', ',') + ')'
			, Descr = "Alle filesets samen."
			{
				attribute<Geography/rdc_meter> geometry      := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/geometry', ',') + ')';
				attribute<rdc_mm_rond>         geometry_rond := geometry[rdc_mm_rond];
				attribute<Geography/rdc_mm>    geometry_mm   := point_yx(PointRow(geometry_rond), PointCol(geometry_rond), Geography/rdc_mm), Descr = "Het BAG-punt in millimeters, afgerond.";
				attribute<String>              identificatie       := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/identificatie', ',') + ')';
				attribute<String>              nummeraanduiding_id := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/nummeraanduiding_id', ',') + ')';
				attribute<Int32>               oppervlakte         := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/oppervlakte', ',') + ')';
				attribute<fileset>             fileset_rel         := = 'union_data(., ' + asList('const(' + string(id(fileset)) + '[fileset], Filesets/nr_' + string(id(fileset)) + '/File)', ',') + ')';
				attribute<vbo_status>          status_rel          := rlookup(LowerCase(meta/STATUS), LowerCase(vbo_status/Label));

				parameter<String> gebruiksdoelen_Expr         := 'union_data(src, ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/gebruiksdoelen/@@@', ',') + ')';
				parameter<String> gebruiksdoelen_tobereplaced := '@@@';

				container gebruiksdoelen :=
					for_each_nedv(
						  vbo_gebruiksdoel/name
						, '= replace(gebruiksdoelen_Expr, ' + quote(gebruiksdoelen_tobereplaced) + ' ,' + quote(vbo_gebruiksdoel/name) + ')'
						, src
						, bool
					);

				unit<UInt32> zonder_punt := select_with_org_rel(!IsDefined(geometry))
				, Descr = "De voorkomens met een vlak in plaats van een punt; BAG20_Xml2MMD laat het punt dan leeg en zet het vlak in polygon.";

				unit<UInt32> polygon := = 'union_unit(' + asList('Filesets/nr_' + string(id(fileset)) + '/File/polygon', ',') + ')'
				{
					attribute<Geography/rdc_meter> geometry (polygon) := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/polygon/geometry', ',') + ')';
					attribute<String>              identificatie      := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/polygon/identificatie', ',') + ')';
					attribute<src>                 vbo_rel            := zonder_punt/org_rel[value(id(.), zonder_punt)], Descr = "Het voorkomen waar het vlak bij hoort: het k-de vlak hoort bij het k-de voorkomen zonder punt; Controle/vlak_koppeling_fout toetst dat op de identificatie.";
					attribute<rdc_mm_rond>         punt_rond          := centroid_or_mid(geometry)[rdc_mm_rond];
					attribute<Geography/rdc_mm>    punt               := point_yx(PointRow(punt_rond), PointCol(punt_rond), Geography/rdc_mm), Descr = "Het zwaartepunt als dat in het vlak ligt, anders een punt midden in het vlak, in millimeters.";
				}

				attribute<Geography/rdc_mm> punt := MakeDefined(geometry_mm, polygon/punt[invert(polygon/vbo_rel)]), Descr = "Het BAG-punt, of bij een vlak een punt binnen dat vlak.";

				unit<UInt32> gerelateerdPand := = 'union_unit(' + asList('Filesets/nr_' + string(id(fileset)) + '/File/gerelateerdPand', ',') + ')'
				{
					attribute<String>  pand_id     := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/gerelateerdPand/pand_id', ',') + ')';
					attribute<UInt32>  mutatie_rel := = 'union_data(., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/gerelateerdPand/mutatie_rel', ',') + ')';
					attribute<fileset> fileset_rel := = 'union_data(., ' + asList('const(' + string(id(fileset)) + '[fileset], Filesets/nr_' + string(id(fileset)) + '/File/gerelateerdPand)', ',') + ')';
					attribute<src>     vbo_rel     := value(fileset/eerste_rij[fileset_rel] + mutatie_rel, src), Descr = "Het vbo-voorkomen waar deze relatie bij hoort (#839).";
				}

				container meta
				{
					attribute<String> STATUS     (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/STATUS', ',') + ')';
					attribute<Int32>  BEGINDATUM (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/BEGINDATUM', ',') + ')';
					attribute<Int32>  EINDDATUM  (src) := = 'union_data(.., ' + asList('Filesets/nr_' + string(id(fileset)) + '/File/meta/EINDDATUM', ',') + ')';
				}
			}

			unit<UInt32> write_result := src
			, StorageName = "= ResultDir + '/vbo.mmd'"
			, DialogType  = "Map"
			, DialogData  = "geometry_mm"
			, Descr       = "Per voorkomen: identificatie, hoofdadres, punt, oppervlakte, gebruiksdoelen, de vlaggen van de vaste studiegebieden, status en geldigheid; in gerelateerdPand per relatie het vbo-voorkomen en het pand."
			{
				attribute<uint64>           identificatie       := uint64(src/identificatie);
				attribute<uint64>           nummeraanduiding_id := uint64(src/nummeraanduiding_id), Descr = "Het hoofdadres.";
				attribute<Geography/rdc_mm> geometry_mm         := src/punt, Descr = "Het BAG-punt, of bij een vbo met een vlak een punt binnen dat vlak.";
				attribute<Int32>            oppervlakte         := src/oppervlakte;

				attribute<Bool>             IsNederland         := IsDefined(point_in_polygon(geometry_mm[rdc_meter], /Geography/StudyAreas/rdc_Nederland/geometry));
				attribute<Bool>             IsFriesland         := IsDefined(point_in_polygon(geometry_mm[rdc_meter], /Geography/StudyAreas/PerProv/Friesland/rdc_prov/geometry));
				attribute<Bool>             IsUtrecht           := IsDefined(point_in_polygon(geometry_mm[rdc_meter], /Geography/StudyAreas/PerProv/Utrecht/rdc_prov/geometry));
				attribute<Bool>             IsNoord_Holland     := IsDefined(point_in_polygon(geometry_mm[rdc_meter], /Geography/StudyAreas/PerProv/Noord_Holland/rdc_prov/geometry));

				container gebruiksdoelen :=
					for_each_nedv(
						  vbo_gebruiksdoel/name
						, 'src/gebruiksdoelen/' + vbo_gebruiksdoel/name
						, write_result
						, bool
					);

				container meta
				{
					attribute<uint8> status_code (write_result) := uint8(src/status_rel), Descr = "Index in status/Label.";
					attribute<Int32> Begindatum  (write_result) := src/meta/BEGINDATUM;
					attribute<Int32> Einddatum   (write_result) := src/meta/EINDDATUM;
				}

				unit<UInt8> status := vbo_status
				, Descr = "De labels bij status_code; de lezer koppelt de code via de tekst en niet via de volgorde."
				{
					attribute<String> Label := vbo_status/Label;
				}

				unit<UInt32> gerelateerdPand := src/gerelateerdPand
				{
					attribute<UInt32>              vbo_rij := uint32(src/gerelateerdPand/vbo_rel), Descr = "De rij van het vbo-voorkomen in deze tabel waarbij de relatie hoort (#839). Zonder die verwijzing kan de leeskant een relatie alleen op vbo-nummer koppelen, en dan hangt een vbo dat ooit aan een ander pand hing ook aan dat oude pand.";
					attribute<uint64>              pand_id := uint64(src/gerelateerdPand/pand_id);
				}
			}
		}

		container nummeraanduiding
		: Descr = "Het adres; SourceData/Vastgoed/BAG leest er de postcode van het hoofdadres uit."
		{
			unit<UInt32> src
			: StorageName     = "= SrcFileDir + '/nummeraanduiding.mmd'"
			, StorageReadOnly = "True";

			attribute<nummeraanduiding_status> status_rel (src) := rlookup(LowerCase(src/meta/STATUS), LowerCase(nummeraanduiding_status/Label));

			unit<UInt32> write_result := src
			, StorageName = "= ResultDir + '/nummeraanduiding.mmd'"
			, Descr       = "Per voorkomen: identificatie, huisnummer, huisletter, toevoeging, postcode, status en geldigheid."
			{
				attribute<uint64> identificatie := uint64(src/identificatie);
				attribute<Int32>  huisnummer    := src/huisnummer;
				attribute<String> huisletter    := src/huisletter;
				attribute<String> toevoeging    := src/toevoeging;
				attribute<String> postcode      := src/postcode;

				container meta
				{
					attribute<uint8> status_code (write_result) := uint8(status_rel), Descr = "Index in status/Label.";
					attribute<Int32> Begindatum  (write_result) := src/meta/BEGINDATUM;
					attribute<Int32> Einddatum   (write_result) := src/meta/EINDDATUM;
				}

				unit<UInt8> status := nummeraanduiding_status
				, Descr = "De labels bij status_code; de lezer koppelt de code via de tekst en niet via de volgorde."
				{
					attribute<String> Label := nummeraanduiding_status/Label;
				}
			}
		}
	}

	container Controle
	: Descr = "Tellingen en toetsen die in metadata.txt naast de tabel komen."
	{
		parameter<UInt32> n_vbo                            := #Object/vbo/src;
		parameter<UInt32> n_gerelateerdPand                := #Object/vbo/src/gerelateerdPand;
		parameter<UInt32> n_pand                           := #Object/pand/src;
		parameter<UInt32> n_nummeraanduiding               := #Object/nummeraanduiding/src;
		parameter<UInt32> vbo_status_onbekend              := sum_uint32(!IsDefined(Object/vbo/src/status_rel));
		parameter<UInt32> pand_status_onbekend             := sum_uint32(!IsDefined(Object/pand/src/status_rel));
		parameter<UInt32> nummeraanduiding_status_onbekend := sum_uint32(!IsDefined(Object/nummeraanduiding/status_rel));
		parameter<UInt32> vbo_met_vlak                     := sum_uint32(!IsDefined(Object/vbo/src/geometry));
		parameter<UInt32> n_vlak                           := #Object/vbo/src/polygon;
		parameter<UInt32> vlak_koppeling_fout              := sum_uint32(!IsDefined(Object/vbo/src/polygon/vbo_rel) || Object/vbo/src/polygon/identificatie != Object/vbo/src/identificatie[Object/vbo/src/polygon/vbo_rel]), Descr = "Vlakken die niet bij een voorkomen met dezelfde identificatie terechtkomen; hoort 0 te zijn.";
		parameter<UInt32> vbo_zonder_locatie               := sum_uint32(!IsDefined(Object/vbo/src/punt));
		parameter<UInt32> relatie_zonder_voorkomen         := sum_uint32(!IsDefined(Object/vbo/src/gerelateerdPand/vbo_rel)), Descr = "Relaties vbo-pand die bij geen voorkomen terechtkomen; hoort 0 te zijn.";
	}

	parameter<String> Metadata :=
		  'VolledigeTabel voor RSopen'
		+ '; BAG-levering: '                + Snapshot_Date_Input
		+ '; bron: '                        + expand(., SrcFileDir)
		+ '; gemaakt met: cfg/main/SourceData/Vastgoed/BAG/MaakVolledigeBAG.dms'
		+ '; GeoDMS: '                      + string(GeoDmsMajorVersionNumber()) + '.' + string(GeoDmsMinorVersionNumber()) + '.' + string(GeoDmsPatchNumber())
		+ '; vbo-voorkomens: '              + string(Controle/n_vbo)
		+ '; gerelateerdPand-rijen: '       + string(Controle/n_gerelateerdPand) + ' (zonder voorkomen: ' + string(Controle/relatie_zonder_voorkomen) + ')'
		+ '; pand-voorkomens: '             + string(Controle/n_pand)
		+ '; nummeraanduiding-voorkomens: ' + string(Controle/n_nummeraanduiding)
		+ '; vbo met vlak als geometrie: '  + string(Controle/vbo_met_vlak) + ' (vlakken: ' + string(Controle/n_vlak) + ', koppelfouten: ' + string(Controle/vlak_koppeling_fout) + ')'
		+ '; vbo zonder locatie: '          + string(Controle/vbo_zonder_locatie)
		+ '; onbekende status vbo/pand/nummeraanduiding: ' + string(Controle/vbo_status_onbekend) + '/' + string(Controle/pand_status_onbekend) + '/' + string(Controle/nummeraanduiding_status_onbekend)
	, StorageName = "= ResultDir + '/metadata.txt'"
	, StorageType = "str";
}
