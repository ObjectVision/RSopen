////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De kadastrale percelen uit de Digitale Kadastrale Kaart en het perceel per cel van de administratie: het
// perceel waarover de woongeschiktheid de opstalkosten (verwerving en sloop) van de bestaande bebouwing
// uitsmeert (#861, BaseData/Suitabilities/Wonen/Opstalkosten).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BRK
: Descr = "De kadastrale percelen en hun koppeling aan de cellen van de administratie: per cel met woningen het perceel waarop die woningen staan, elders het perceel onder het celmidden. Het perceel is de
			eenheid waarover wonen de opstalkosten uitsmeert (#861, BaseData/Suitabilities/Wonen/Opstalkosten): wie een pand koopt om te slopen koopt het perceel, met de tuin, het erf of het groen eromheen.
			Een cel zonder woningen waarvan het midden in geen perceel ligt, zoals het buitenwater en een deel van de wegen, heeft geen perceel."
, Source = "Kadaster, BRK Kadastrale Kaart via PDOK, perceellaag zonder historie, de download van ModelParameters/BRK_file_date; als mmd-store gemaakt door pbl-nl/model-RS-PlanCapaciteit en gekopieerd naar de
			RSopen-share, %RSo_DataDir%/Vastgoed/BRK/BRK_<datum>/perceel_<datum>.mmd, zodat het model alleen zijn eigen share leest (#583)."
{
	unit<UInt32> Perceel
	:	StorageName     = "='%RSo_DataDir%/Vastgoed/BRK/BRK_'+/ModelParameters/BRK_file_date+'/perceel_'+/ModelParameters/BRK_file_date+'.mmd'"
	,	StorageReadOnly = "True"
	,	Descr           = "De percelen van heel Nederland met hun geometrie, identificatie, kadastrale aanduiding en grootte, in de rijvolgorde van de perceellaag van de download. De store noemt zijn
							eenheden zelf, de geometrie op /Geography/rdc_meter."
	{
	}

	container BAG_Basisjaar := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(/ModelParameters/Model_StartYear), Descr = "De BAG op 1 januari van het basisjaar.";
	unit<UInt32> WoonVBO := BAG_Basisjaar/VBO/per_Gebruiksdoel/woon/Select
	, Descr = "De woon-vbo's van het basisjaar, dezelfde set als de verwervingskosten, de vervanging en de herontwikkelingskans."
	{
		attribute<Perceel> Perceel_rel := point_in_polygon(geometry, Perceel/geometry), Descr = "Het perceel onder het punt van het vbo. Dat punt ligt in het pand, dus dit is het perceel van het pand.";
	}
	attribute<Perceel> PerceelVanCelmidden (AdminDomain) := poly2grid(Perceel/geometry, AdminDomain), Descr = "Het perceel waarin het midden van de cel ligt, null waar dat geen perceel is.";
	attribute<Perceel> PerceelVanWoningen  (AdminDomain) := modus(WoonVBO/Perceel_rel, WoonVBO/AdminDomain_rel), Descr = "Het perceel waarop de meeste woon-vbo's van de cel liggen, null in een cel zonder woon-vbo.";
	attribute<Perceel> Perceel_rel (AdminDomain) := IsDefined(PerceelVanWoningen) ? PerceelVanWoningen : PerceelVanCelmidden
	, Descr = "Het perceel per cel: in een cel met woningen het perceel waarop de meeste woon-vbo's liggen, elders het perceel onder het midden van de cel, null waar dat geen perceel is. Een cel
				van 25 meter raakt vaak meer percelen; via het celmidden tellen de woningen in de cel anders bij de straat, de gracht of een buurerf (#869). De lezers gebruiken dit. Niet ontkoppeld, want
				de koppeling uit de store is goedkoop.";
	parameter<String> Koppeling_Versie := '869', Descr = "Versiesleutel van de koppeling van cel en perceel in de fingerprint van de bestanden die op het perceel rekenen; verander hem mee met de koppeling.";
}
