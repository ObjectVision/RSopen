// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De kadastrale percelen uit de Digitale Kadastrale Kaart en het perceel per cel van de administratie: de
// herontwikkeleenheid waarover de woongeschiktheid de verwervings- en sloopkosten van de bestaande bebouwing
// uitsmeert (#861, BaseData/Suitabilities/Wonen/Herontwikkeleenheid).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BRK
: Descr = "De kadastrale percelen en hun vergridding naar de administratie: per cel het perceel waarin het celmidden ligt. Het perceel is de
			herontwikkeleenheid van wonen (#861, BaseData/Suitabilities/Wonen/Herontwikkeleenheid): wie een pand koopt om te slopen koopt het perceel, met de tuin, het erf of het groen eromheen.
			Een cel waarvan het midden in geen perceel ligt, zoals het buitenwater en een deel van de wegen, heeft geen perceel."
, Source = "Kadaster, BRK Kadastrale Kaart via PDOK, perceellaag zonder historie, de download van ModelParameters/BRK_file_date; als mmd-store gemaakt door pbl-nl/model-RS-PlanCapaciteit,
			%SourceDataDir%/PlanCapaciteit/BRK_<datum>/perceel_<datum>.mmd."
{
	unit<UInt32> Perceel
	:	StorageName     = "='%SourceDataDir%/PlanCapaciteit/BRK_'+/ModelParameters/BRK_file_date+'/perceel_'+/ModelParameters/BRK_file_date+'.mmd'"
	,	StorageReadOnly = "True"
	,	Descr           = "De percelen van heel Nederland met hun geometrie, identificatie, kadastrale aanduiding en grootte, in de rijvolgorde van de perceellaag van de download. De store noemt zijn
							eenheden zelf, de geometrie op /Geography/rdc_meter."
	{
	}

	attribute<Perceel> Perceel_rel (AdminDomain) := poly2grid(Perceel/geometry, AdminDomain)
	, Descr = "Het perceel per cel: het perceel waarin het midden van de cel ligt, null waar dat geen perceel is. De lezers gebruiken dit. Niet ontkoppeld, want de vergridding uit de store is
				goedkoop.";
}
