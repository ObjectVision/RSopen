container Water : Source = "Bron19, 2 september 2021, via filesender.surf, GIS Data van de kaarten uit het essay Op Waterbasis"
{
	container Grondwaterstanden
	{
		container Referentie //basisjaar
		{
			attribute<float32> GHG_2017_TR29_11 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GHG_REF2017BP18_tijdreeks1929-2011.tif" 
			,	StorageType = "gdal.grid";
			attribute<float32> GLG_2017_TR29_11 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GLG_REF2017BP18_tijdreeks1929-2011.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GHG_2017_TR74_03 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GHG_REF2017BP18_tijdreeks1974-2003.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GLG_2017_TR74_03 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GLG_REF2017BP18_tijdreeks1974-2003.tif"
			,	StorageType = "gdal.grid";
		}
		container BAU
		{
			attribute<float32> GHG_2017 (rdc_25m) := Referentie/GHG_2017_TR29_11;
			attribute<float32> GLG_2017 (rdc_25m) := Referentie/GLG_2017_TR29_11;
			
			attribute<float32> GHG_2050 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GHG_W2050BP18_tijdreeks1929-2011.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GLG_2050 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GLG_W2050BP18_tijdreeks1929-2011.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GHG_2085 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GHG_W2085BP18_tijdreeks1974-2003.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GLG_2085 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GLG_W2085BP18_tijdreeks1974-2003.tif"
			,	StorageType = "gdal.grid";
		}
		container BAU2
		{
			attribute<float32> GHG_2017 (rdc_25m) := Referentie/GHG_2017_TR29_11;
			attribute<float32> GLG_2017 (rdc_25m) := Referentie/GLG_2017_TR29_11;
			
			attribute<float32> GHG_2050 (rdc_25m) 
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GHG_R2050BP18_tijdreeks1929-2011.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GLG_2050 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GLG_R2050BP18_tijdreeks1929-2011.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GHG_2085 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GHG_R2085BP18_tijdreeks1974-2003.tif"
			,	StorageType = "gdal.grid";
			attribute<float32> GLG_2085 (rdc_25m)
			:	StorageName = "%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GLG_R2085BP18_tijdreeks1974-2003.tif"
			,	StorageType = "gdal.grid";
		}
	}

	#include<WBS.dms>
	
	#include<dijkring.dms>
	#include<TeDroog.dms>
	#include<TeNat.dms>
	#include<TeZout.dms>
	#include<TeSlap.dms>
	#include<TeGevaarlijk.dms>
	#include<RuimteVoorRivierafvoer.dms>
	
	container Risicozonering
	: Descr = "De overstromingsgevaarzonering zoals aangeleverd, en de omzetting daarvan naar het modelraster."
	{
		container Bron
		: Descr = "De aangeleverde tif. Ligt 5 m naast het RD-25m-raster (celoffset -22,2 en -160,2) en heeft tegels van 128x128, dus GeoDMS schuift hem naar de dichtstbijzijnde cel en waarschuwt daarover. Alleen nog nodig om met Maak de tif te genereren."
		{
			attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (rdc_25m)
			:	StorageType = "gdal.grid"
			,	Source      = "Bron20, 3 juli 2022 per email"
			,	url         = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Overstromingsgevaarzonering_beleidsregimes_en_constraints_voor_ruimtescanner_ks.pdf"
			,	StorageName = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Risicozonering_010722.tif";
		}

		container Maak
		: Descr = "Zet de bron eenmalig om naar een getegelde, LZW-gecomprimeerde tif op het modelraster, met dezelfde afronding die GeoDMS nu bij het inlezen maakt. Draai dit met StudyArea = Nederland, want de tif beslaat het hele land."
		{
			parameter<Bool> IsNederland := lowercase(/ModelParameters/StudyArea) == 'nederland', Descr = "Bewaakt dat de tif niet per ongeluk met een provincie als studiegebied wordt weggeschreven.";

			attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (rdc_25m) := Bron/Overstromingsgevaarzonering
			,	StorageName = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Risicozonering_010722_025m_NL_rdc_uint8.tif"
			,	StorageType = "gdalwrite.grid"
			,	IntegrityCheck = "IsNederland";

			parameter<String> Generate := 'Ready', ExplicitSuppliers = "/SourceData/Water/Risicozonering/Maak/Overstromingsgevaarzonering", Descr = "Volledig gekwalificeerd pad met opzet: op ouderniveau staat een gelijknamig leesitem, en een ongekwalificeerde naam zou daar stil naartoe oplossen zodra dit schrijfitem verdwijnt of wordt hernoemd.";
		}
	}

	attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (rdc_25m)
	:	Source          = "Bron20, 3 juli 2022 per email"
	,	url             = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Overstromingsgevaarzonering_beleidsregimes_en_constraints_voor_ruimtescanner_ks.pdf"
	,	StorageName     = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Risicozonering_010722_025m_NL_rdc_uint8.tif"
	,	StorageReadOnly = "true";
	
	attribute<Bool> PrimaireWaterkeringen (rdc_100m)
	:	Label       = "Ontkoppeld bestand Primaire waterkeringen"
	,	Source      = "berekening van item result 5 februari 2019 GeoDMS 7.188 https://pbl.sliksvn.com/ruimtescanner/PBL/ProjDir/branches/RSL17 5513 https://pbl.sliksvn.com/ruimtescanner/PBLSourceData/Trunk/LUMOS 5508"
	,	StorageName = "%RSo_DataDir%/Omgeving/Water/Primaire_waterkeringen_ontkoppeld.tif";
	
	attribute<meter> MaximaleWaterdiepteNederland_Kaart4 (rdc_25m) // Dit is de diepte vanaf kleine kans (= 1/1000 jaar of hoger). Zie: https://www.klimaateffectatlas.nl/nl/overstromingsdiepte
	: StorageName     = "%RSo_DataDir%/Omgeving/Water/Schade/MaximaleWaterdiepteNederland_Kaart4.tif"
	, StorageReadOnly = "TRUE"
	, Source          = "item /LIWO_Basis/MaximaleWaterdiepteNederland_Kaart4.tif. Ontvangen van Karin de Bruin op 30 augustus 2022"
	, Descr          = "MaximaleWaterdiepteNederland Kaart";
	
	attribute<Meter> Waterdiepte_A_PrimairOnbeschermd_src (rdc_5m)
	: StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_A_PrimairOnbeschermd_Kaart5_masked.tif"
	, StorageReadOnly = "TRUE"
	, Descr           = "Het gaat om de overstromingsdieptekaarten genoemd in tabel 2-1 op blz 12 van bijgesloten rapport. 
							Het kaartnummer (4 of 5) heeft betrekking op de overstromingskansen.  Het cijfer (A, B of C) heeft betrekking op het type overstroming: a) 
							vanuit hoofdwatersysteem, buitendijks/ombeschermd; B) vanuit hoofdwatersysteem, binnendijks/beschermd; C) vanuit regionaal watersysteem, binnendijks/beschermd."
	, Source          = "Ontvangen van Deltares 2026-01-29";
	
	attribute<Meter> Waterdiepte_B_PrimairBeschermd_src (rdc_5m)
	: StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_B_PrimairBeschermd_Kaart5_masked.tif"
	, StorageReadOnly = "TRUE"
	, Descr           = "Het gaat om de overstromingsdieptekaarten genoemd in tabel 2-1 op blz 12 van bijgesloten rapport. 
							Het kaartnummer (4 of 5) heeft betrekking op de overstromingskansen.  Het cijfer (A, B of C) heeft betrekking op het type overstroming: a) 
							vanuit hoofdwatersysteem, buitendijks/ombeschermd; B) vanuit hoofdwatersysteem, binnendijks/beschermd; C) vanuit regionaal watersysteem, binnendijks/beschermd."
	, Source          = "Ontvangen van Deltares 2026-01-29";
	
	attribute<Meter> Waterdiepte_C_RegionaalBeschermd_src (rdc_5m)
	: StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_C_RegionaalBeschermd_Kaart4_masked.tif"
	, StorageReadOnly = "TRUE"
	, Descr           = "Het gaat om de overstromingsdieptekaarten genoemd in tabel 2-1 op blz 12 van bijgesloten rapport. 
							Het kaartnummer (4 of 5) heeft betrekking op de overstromingskansen.  Het cijfer (A, B of C) heeft betrekking op het type overstroming: a) 
							vanuit hoofdwatersysteem, buitendijks/ombeschermd; B) vanuit hoofdwatersysteem, binnendijks/beschermd; C) vanuit regionaal watersysteem, binnendijks/beschermd."
	, Source          = "Ontvangen van Deltares 2026-01-29";
	
	attribute<Meter> Write_Waterdiepte_A_PrimairOnbeschermd (AdminDomain) := mean(Waterdiepte_A_PrimairOnbeschermd_src == -9999f ? null_f : Waterdiepte_A_PrimairOnbeschermd_src, rdc_5m/AdminDomain_rel), StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_A_RegionaalBeschermd_Kaart4_25m.tif", StorageType = "gdalwrite.grid";
	attribute<Meter> Write_Waterdiepte_B_PrimairBeschermd   (AdminDomain) := mean(Waterdiepte_B_PrimairBeschermd_src == -9999f ? null_f : Waterdiepte_B_PrimairBeschermd_src, rdc_5m/AdminDomain_rel), StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_B_PrimairBeschermd_Kaart5_25m.tif", StorageType = "gdalwrite.grid";
	attribute<Meter> Write_Waterdiepte_C_RegionaalBeschermd (AdminDomain) := mean(Waterdiepte_C_RegionaalBeschermd_src == -9999f ? null_f : Waterdiepte_C_RegionaalBeschermd_src, rdc_5m/AdminDomain_rel), StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_C_RegionaalBeschermd_Kaart4_25m.tif", StorageType = "gdalwrite.grid";

	attribute<Meter> Waterdiepte_A_PrimairOnbeschermd (AdminDomain) : StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_A_RegionaalBeschermd_Kaart4_25m.tif", StorageType = "gdal.grid";
	attribute<Meter> Waterdiepte_B_PrimairBeschermd   (AdminDomain) : StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_B_PrimairBeschermd_Kaart5_25m.tif", StorageType = "gdal.grid";
	attribute<Meter> Waterdiepte_C_RegionaalBeschermd (AdminDomain) : StorageName     = "%RSo_DataDir%/Omgeving/Water/Waterdiepte_LIWO/MaximaleWaterdiepte_C_RegionaalBeschermd_Kaart4_25m.tif", StorageType = "gdal.grid";
	
	attribute<Meter> Waterdiepte_A_PrimairOnbeschermd_Plausibel (AdminDomain) := IsDefined(Waterdiepte_A_PrimairOnbeschermd) && Waterdiepte_A_PrimairOnbeschermd > MaxPlausibeleOverstromingsdiepte ? null_f : Waterdiepte_A_PrimairOnbeschermd;
	attribute<Meter> Waterdiepte_B_PrimairBeschermd_Plausibel   (AdminDomain) := IsDefined(Waterdiepte_B_PrimairBeschermd)   && Waterdiepte_B_PrimairBeschermd   > MaxPlausibeleOverstromingsdiepte ? null_f : Waterdiepte_B_PrimairBeschermd;
	attribute<Meter> Waterdiepte_C_RegionaalBeschermd_Plausibel (AdminDomain) := IsDefined(Waterdiepte_C_RegionaalBeschermd) && Waterdiepte_C_RegionaalBeschermd > MaxPlausibeleOverstromingsdiepte ? null_f : Waterdiepte_C_RegionaalBeschermd
	, Descr = "De drie LIWO-kaarten ontdaan van de onzinwaarden, met dezelfde grens als Dieptekaart hieronder. Dit zijn de kaarten waar de overstromingsschade uit leest, in Templates/Indicatoren/SSM2017_Overstromingsschades/Parameters.dms.

				Tot 27 augustus 2026 las de schade de drie kaarten hierboven rechtstreeks, terwijl de zeef en BaseData/Omgeving/Overstromingsdiepte al langs Dieptekaart gingen en dus wel gefilterd waren. Alleen de C-kaart heeft vandaag onzinwaarden, 381 cellen van 998 tot 147.501.568 meter, en die klemmen in de schadefunctie gewoon op het tabelmaximum en leveren dus de maximale schadefactor op akker, grasland en woonterrein. Gemeten in zichtjaar 2040 ging het om 7,4 miljoen euro in NbSGenuanceerd en 8,6 miljoen in BAU, op een regionaal totaal van ruim 52 miljard.

				A en B krijgen dezelfde behandeling terwijl daar niets misgaat, zodat de regel dat de schade met plausibele dieptes rekent per constructie geldt en niet afhangt van welke levering toevallig schoon is.";

	// attribute<Meter> Waterdiepte_A_PrimairOnbeschermd (AdminDomain) := mean(Waterdiepte_A_PrimairOnbeschermd_src == -9999f ? null_f : Waterdiepte_A_PrimairOnbeschermd_src, rdc_5m/AdminDomain_rel);
	// attribute<Meter> Waterdiepte_B_PrimairBeschermd   (AdminDomain) := mean(Waterdiepte_B_PrimairBeschermd_src == -9999f ? null_f : Waterdiepte_B_PrimairBeschermd_src, rdc_5m/AdminDomain_rel);
	// attribute<Meter> Waterdiepte_C_RegionaalBeschermd (AdminDomain) := mean(Waterdiepte_C_RegionaalBeschermd_src == -9999f ? null_f : Waterdiepte_C_RegionaalBeschermd_src, rdc_5m/AdminDomain_rel);
	
	parameter<Meter> MaxPlausibeleOverstromingsdiepte := /ModelParameters/Advanced/MaxPlausibeleOverstromingsdiepte
	, Descr = "De waarde staat in ModelParameters/Advanced. Bovengrens waarboven een waarde in deze kaarten geen overstromingsdiepte meer kan zijn, maar corrupte brondata.
				De C-kaart bevat 381 cellen met waarden van 998 meter tot 147.501.568 meter, verspreid over gewoon land
				(akker, grasland, woonterrein). De diepste waarde die wel plausibel is staat op 93,3 meter in de B-kaart,
				de A-kaart komt niet boven 43,9 meter. Honderd meter ligt daar net boven en drie ordes onder de laagste
				onzinwaarde, dus de precieze grens maakt niet uit. Vervalt zodra Deltares een gecorrigeerde C-kaart levert.";

	attribute<Meter> Dieptekaart0 (AdminDomain) := max_elem(Waterdiepte_A_PrimairOnbeschermd, Waterdiepte_B_PrimairBeschermd, Waterdiepte_C_RegionaalBeschermd)
	, Descr = "Het elementgewijze maximum van de drie LIWO-kaarten, ongefilterd. Lees dit item niet rechtstreeks: het bevat
				de onzinwaarden uit de C-kaart. Gebruik Dieptekaart.";

	attribute<Meter> Dieptekaart (AdminDomain) := IsDefined(Dieptekaart0) && Dieptekaart0 > MaxPlausibeleOverstromingsdiepte ? null_f : Dieptekaart0
	, Descr = "De overstromingsdiepte zoals de zeef en de overstromingsschade hem lezen: het maximum van de drie kaarten,
				alleen ontdaan van de onzinwaarden.

				Hier stond tot #665 een grens van tien meter met null erboven. Die grens hoorde bij de waterberging, waar
				diepte de maat is voor het bergbare volume: boven de tien meter gaat het niet meer om een bergingsschijf
				maar om het waterlichaam dat er al ligt. Van de 5.972 cellen tussen tien en honderd meter is 41 procent
				water volgens BBG 2022 en de mediane diepte is 11,4 meter. Zie #394, waar Deltares een waterschijf van
				1 tot 2 meter noemde en de bovengrens voorlopig is blijven liggen.

				De klem stond alleen op het verkeerde item. Tot #394 las alleen BaseData/Omgeving/Overstromingsdiepte deze
				kaart, dus de zeef en de schade, en daar betekent null iets anders dan een grote diepte: de zeeftoets
				diepte > MaxOverstromingsdiepte geeft op null FALSE, waardoor op de diepste bebouwing van het land geen
				enkel ontwikkelpakket afviel, terwijl de schade-indicator diezelfde cellen als schadevrij boekte. De
				bergingsgrens staat nu waar hij hoort, als ModelParameters/Waterberging/Maximum_Waterschijf.";
	
	attribute<Float32> DieptekaartOud (AdminDomain) // Dit is de diepte vanaf kleine kans (= 1/1000 jaar of hoger). Zie: https://www.klimaateffectatlas.nl/nl/overstromingsdiepte
	: StorageName     = "%RSo_DataDir%/Omgeving/Water/Schade/MaximaleWaterdiepteNederland_Kaart4.tif"
	, StorageReadOnly = "TRUE"
	, Source          = "item /LIWO_Basis/MaximaleWaterdiepteNederland_Kaart4.tif. Ontvangen van Karin de Bruin op 30 augustus 2022"
	, Descr          = "MaximaleWaterdiepteNederland Kaart";
	
	unit<UInt32> Waterberging
	: StorageName     = "%RS_Lb_DataDir%/water/reservoirs_12.shp"
	, StorageType     = "gdal.vect"
	, StorageReadOnly = "TRUE"
	, Source          = "Ontvangen van Bron13 op 16 juli 2024"
	, DialogData      = "rdc_meter"
	{
		attribute<Bool> IsReservoir     (AdminDomain) := (reservoir == 'ja' ? TRUE : FALSE)[Per_AdminDomain];
		attribute<.>    Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
	}
	
	// unit<UInt32> Grondwaterbeschermingsgebieden
	// : StorageName     = "%RSo_DataDir%/Omgeving/water/rivm_grondwaterbeschermingsgebied_2025.shp"
	// , StorageType     = "gdal.vect"
	// , StorageReadOnly = "TRUE"
	// , URL             = "https://www.atlasleefomgeving.nl/kaarten?config=3ef897de-127f-471a-959b-93b7597de188&gm-x=143840.99258028742&gm-y=490734.57135725924&gm-z=4&gm-b=1544180834512,true,1;1555317816612,true,0.8;&activateOnStart=info&deactivateOnStart=layercollection"
	// , DialogData      = "rdc_meter"
	// , Descr           = "Grondwaterbeschermingsgebieden rondom bronnen voor drinkwater, bron RIVM, 2025"
	// {
		// attribute<Bool> IsGrondwaterbeschermingsgebied     (AdminDomain) := (Type == 'Grondwaterbeschermingsgebied' ? TRUE : FALSE)[Per_AdminDomain];
		// attribute<Bool> IsGrondwaterbeschermingsgebiedRuim (AdminDomain) := IsGrondwaterbeschermingsgebied || IsWaterwingebied;
		// attribute<Bool> IsWaterwingebied                   (AdminDomain) := (Type == 'Waterwingebied' ? TRUE : FALSE)[Per_AdminDomain];
		// attribute<Bool> IsIntrekgebied                     (AdminDomain) := (intrek == 'Intrekgebied' ? TRUE : FALSE)[Per_AdminDomain];
		// attribute<.>    Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
