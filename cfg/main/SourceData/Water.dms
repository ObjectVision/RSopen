////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// MaximaleWaterdiepteNederland Kaart Grondwaterbeschermingsgebieden rondom bronnen voor drinkwater, bron RIVM,
// 2025. Waterdiepte bij kortdurende hevige neerslag in twee kaarten: 70 mm in 2 uur (1:100 jaar) en 140 mm in
// 2 uur (1:1000 jaar); zie BuiAannames. Laadt via #include: WBS, dijkring,
// TeDroog, TeNat, TeZout, TeSlap, TeGevaarlijk, RuimteVoorRivierafvoer.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Water : Source = "Deltares-4, 2 september 2021, via filesender.surf, GIS Data van de kaarten uit het essay Op Waterbasis"
{
	container Grondwaterstanden
	: Descr = "De GHG- en GLG-kaarten van Deltares per variant en klimaatanker, elk gelezen op het eigen grid van 250 meter en aangevuld waar de levering geen waarde geeft (#837). Wie de kale levering
				nodig heeft leest Referentie/<kaart>_Bron; de kaarten zonder achtervoegsel zijn aangevuld en zijn wat de opbrengstderving van de landbouw leest."
	{
		Template Kaart_T
		: Descr = "Een GxG-tif van Deltares op zijn eigen grid van 250 meter, met de cellen zonder waarde gevuld met de waarde van de dichtstbijzijnde cel die er wel een heeft. De
					levering dekt de Waddeneilanden niet en mist aan de randen; zonder vulling krijgt een landbouwcel daar geen sleutel in de WWL-relatiedatabase en dus een derving van 100 procent, en dat is
					geen uitspraak over de grondwaterstand. De vulling over zee heen, van de Kop van Noord-Holland naar Texel en van de Friese kust naar de andere eilanden, is een tussenoplossing totdat de
					levering de eilanden dekt; welke cellen gevuld zijn staat in IsAangevuld en de afstand tot de bron in Zonder/afstand (#837)."
		{
			parameter<String> Bestand;
			//

			attribute<float32> Bron (rdc_250m) : StorageName = "=Bestand", StorageType = "gdal.grid", StorageReadOnly = "True"
			, Descr = "De levering op haar eigen grid; null waar zij niets geeft. De tifs van Deltares liggen op de oorsprong en de celmaat van rdc_250m, dus dit is een lezing zonder herbemonstering.";

			unit<uint64> MetWaarde := select_with_org_rel(IsDefined(Bron))
			{
				attribute<rdc_meter> geometry := rdc_250m/point[org_rel];
				attribute<float32>   waarde   := Bron[org_rel];
			}
			unit<uint64> Zonder := select_with_org_rel(!IsDefined(Bron))
			, Descr = "De cellen zonder waarde, met de dichtstbijzijnde gevulde cel als bron. Ook buiten het studiegebied, want de randcellen van 250 meter vallen deels buiten de begrenzing terwijl er op 25 meter nog landbouw in ligt."
			{
				attribute<rdc_meter> geometry := rdc_250m/point[org_rel];
				attribute<MetWaarde> naaste   := connect(MetWaarde/geometry, geometry);
				attribute<float32>   waarde   := MetWaarde/waarde[naaste];
				attribute<meter>     afstand  := value(dist(MetWaarde/geometry[naaste], geometry), meter);
			}
			attribute<float32> Gevuld_250m  (rdc_250m) := MakeDefined(Bron, recollect_by_cond(!IsDefined(Bron), Zonder/waarde));
			attribute<float32> Result       (rdc_25m)  := Gevuld_250m[rdc_25m/rdc_250m_rel], Descr = "De aangevulde kaart op 25 meter, zoals de rest van het model haar leest.";
			attribute<bool>    IsAangevuld  (rdc_25m)  := !IsDefined(Bron[rdc_25m/rdc_250m_rel]) && IsDefined(Result), Descr = "Waar de waarde uit de vulling komt en niet uit de levering.";
			parameter<uint64>  n_aangevuld_250m := #Zonder, Descr = "Controlegetal: het aantal cellen van 250 meter dat gevuld is.";
			parameter<meter>   afstand_max      := max(Zonder/afstand), Descr = "Controlegetal: de grootste afstand waarover een waarde is overgenomen.";
		}

		parameter<String> Vulling_Versie := '837'
		, Descr = "Sleutel voor de vulling in Kaart_T in de fingerprint van de opbrengstdervingskaarten (#837). Een andere waarde dan in het zijbestand maakt die kaarten opnieuw, dus de waarde verandert mee met
					de vulling.";

		container Referentie //basisjaar
		{
			container GHG_2017_TR29_11_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GHG_REF2017BP18_tijdreeks1929-2011.tif');
			container GLG_2017_TR29_11_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GLG_REF2017BP18_tijdreeks1929-2011.tif');
			container GHG_2017_TR74_03_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GHG_REF2017BP18_tijdreeks1974-2003.tif');
			container GLG_2017_TR74_03_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/Huidig/GLG_REF2017BP18_tijdreeks1974-2003.tif');

			attribute<float32> GHG_2017_TR29_11 (rdc_25m) := GHG_2017_TR29_11_src/Result;
			attribute<float32> GLG_2017_TR29_11 (rdc_25m) := GLG_2017_TR29_11_src/Result;
			attribute<float32> GHG_2017_TR74_03 (rdc_25m) := GHG_2017_TR74_03_src/Result;
			attribute<float32> GLG_2017_TR74_03 (rdc_25m) := GLG_2017_TR74_03_src/Result;

			parameter<String> Herkomst_TR29_11 := 'ghg=' + GHG_2017_TR29_11_src/Bestand + ';glg=' + GLG_2017_TR29_11_src/Bestand + ';gxg_fill=' + Vulling_Versie
			, Descr = "De bestanden achter GHG_2017_TR29_11 en GLG_2017_TR29_11 met hun vulling, in de vorm van de fingerprint van de opbrengstdervingskaarten; de leveringen hieronder nemen hem over voor het anker 2017.";

			attribute<float32> GLG_2017_TR29_11_Bron (rdc_25m) := GLG_2017_TR29_11_src/Bron[rdc_25m/rdc_250m_rel]
			, Descr = "De kale levering zonder vulling, voor lezers die null als ontbrekende kennis willen zien, zoals de veenreserve in de koolstofboekhouding.";
		}
		container BAU
		{
			container GHG_2050_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GHG_W2050BP18_tijdreeks1929-2011.tif');
			container GLG_2050_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GLG_W2050BP18_tijdreeks1929-2011.tif');
			container GHG_2085_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GHG_W2085BP18_tijdreeks1974-2003.tif');
			container GLG_2085_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU1/GLG_W2085BP18_tijdreeks1974-2003.tif');

			attribute<float32> GHG_2017 (rdc_25m) := Referentie/GHG_2017_TR29_11;
			attribute<float32> GLG_2017 (rdc_25m) := Referentie/GLG_2017_TR29_11;
			attribute<float32> GHG_2050 (rdc_25m) := GHG_2050_src/Result;
			attribute<float32> GLG_2050 (rdc_25m) := GLG_2050_src/Result;
			attribute<float32> GHG_2085 (rdc_25m) := GHG_2085_src/Result;
			attribute<float32> GLG_2085 (rdc_25m) := GLG_2085_src/Result;

			parameter<String> Herkomst_2017 := Referentie/Herkomst_TR29_11
			, Descr = "Waar de GHG- en GLG-kaart van elk anker vandaan komen, als deel van de fingerprint van de opbrengstdervingskaarten (SourceData/Landbouw/Yield_Reduction/OpbrengstenDerving_T). De drie
						volgen de bronnen van de kaarten hierboven: wijst een kaart naar een andere bron, dan hoort zijn herkomst mee te veranderen.";
			parameter<String> Herkomst_2050 := 'ghg=' + GHG_2050_src/Bestand + ';glg=' + GLG_2050_src/Bestand + ';gxg_fill=' + Vulling_Versie;
			parameter<String> Herkomst_2085 := 'ghg=' + GHG_2085_src/Bestand + ';glg=' + GLG_2085_src/Bestand + ';gxg_fill=' + Vulling_Versie;
		}
		container BAU2
		{
			container GHG_2050_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GHG_R2050BP18_tijdreeks1929-2011.tif');
			container GLG_2050_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GLG_R2050BP18_tijdreeks1929-2011.tif');
			container GHG_2085_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GHG_R2085BP18_tijdreeks1974-2003.tif');
			container GLG_2085_src := Kaart_T('%RS_Lb_DataDir%/Water/Grondwaterstanden/BAU2/GLG_R2085BP18_tijdreeks1974-2003.tif');

			attribute<float32> GHG_2017 (rdc_25m) := Referentie/GHG_2017_TR29_11;
			attribute<float32> GLG_2017 (rdc_25m) := Referentie/GLG_2017_TR29_11;
			attribute<float32> GHG_2050 (rdc_25m) := GHG_2050_src/Result;
			attribute<float32> GLG_2050 (rdc_25m) := GLG_2050_src/Result;
			attribute<float32> GHG_2085 (rdc_25m) := GHG_2085_src/Result;
			attribute<float32> GLG_2085 (rdc_25m) := GLG_2085_src/Result;

			parameter<String> Herkomst_2017 := Referentie/Herkomst_TR29_11, Descr = "Zie BAU/Herkomst_2017.";
			parameter<String> Herkomst_2050 := 'ghg=' + GHG_2050_src/Bestand + ';glg=' + GLG_2050_src/Bestand + ';gxg_fill=' + Vulling_Versie;
			parameter<String> Herkomst_2085 := 'ghg=' + GHG_2085_src/Bestand + ';glg=' + GLG_2085_src/Bestand + ';gxg_fill=' + Vulling_Versie;
		}
		container NbSGenuanceerd
		: Descr = "De grondwaterstanden waarmee het gewasmodel in NbSGenuanceerd rekent (#263, #782): geen eigen levering van Deltares maar de BAU-stand met daaroverheen de stand die de veenbouwsteen per cel
					oplegt, want de vernatting die het punt van die variant is hoort in de opbrengstderving terug te komen. De bron geeft twee getallen per bouwsteen, kolom M en N van de bouwstenentabel,
					overgenomen in Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/GLG_cm en GHG_cm; kolom N is maar half gevuld, dus op de bouwstenen met een geleverde GHG neemt de cel die over (een vast
					peil zonder seizoensgang) en op de andere schuift de GHG met de GLG mee, zodat de plaatselijke afstand tussen hoogste en laagste stand overeind blijft; of dat de bedoelde toestand is staat
					als vraag in #782. Alle drie de kaarten, ook die van 2017, want het zijn klimaatankers en geen beleidsjaren, en de vernatting geldt direct en volledig vanaf het eerste zichtjaar. De
					bouwsteen per cel komt rechtstreeks uit VariantData/NbSGenuanceerd, dus de fingerprint van de dervingskaarten van deze levering draagt een controlesom over die kaart (Oplegging_Herkomst)."
		{
			// parameter<string> Bouwsteenkaart_Pad := '%LocalDataProjDir%/VariantData/Veenbouwstenen_NbSGenuanceerd_' + /ModelParameters/StudyArea + '.tif'
			// , Descr = "Waar de gealloceerde veenbouwsteen per cel staat: letterlijk hetzelfde pad als Bouwsteenkaart_Pad in Templates/VariantData/Natuur/Veen_T, dat het bestand schrijft, als tekst herhaald omdat
						// PropValue op een StorageName de expressietekst teruggeeft. Dit bestand ontstaat niet vanzelf: Write_Bouwsteenkaart staat in geen Generate-lijst, dus vraag er expliciet om (GeoDmsRun ...
						// /VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Veen/Write_Bouwsteenkaart). Ontbreekt het, dan meldt GeoDMS geen leesfout maar Unknown identifier op een subitem hier beneden. Verandert
						// de veenlevering of de zeef, dan hoort de kaart opnieuw gemaakt te worden en daarna de opbrengstdervingskaarten; er is geen fingerprint die dat bewaakt.";

			attribute</Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata> Bouwsteen (rdc_25m) := /VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Veen/Bouwsteen_rel
			// :	StorageName = "=Bouwsteenkaart_Pad"
			// ,	StorageType = "gdal.grid"
			// ,	StorageReadOnly = "True"
			, Descr = "De gealloceerde bouwsteen per cel, null buiten het veengebied en op de cellen die in het type Rest vallen. De klassewaarden zijn de rijnummers van MetBrondata, precies zoals Veen_T ze wegschrijft.";

			attribute<bool>    Opgelegd (rdc_25m) := /Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata/HeeftGLG[Bouwsteen]
			, Descr = "Legt de bouwsteen op deze cel een grondwaterstand op? Onwaar buiten het veengebied, en ook binnen het veengebied bij open water en bij de twee bebouwde bouwstenen, want daar geeft de bron geen stand. Die cellen houden de BAU-stand.";

			attribute<bool>    GHG_Geleverd (rdc_25m) := /Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata/HeeftGHG[Bouwsteen]
			, Descr = "Geeft de bron voor de bouwsteen op deze cel een GHG? Waar op de bouwstenen 1, 2, 3a en 4a, onwaar op alle andere, ook op de cellen die wel een GLG opgelegd krijgen. Waar dit onwaar is schuift de GHG mee met de GLG.";

			attribute<float32> GHG_Opgelegd (rdc_25m) := /Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata/GHG_cm[Bouwsteen] / 100f
			, Descr = "De opgelegde gemiddeld hoogste grondwaterstand in meters onder maaiveld, positief naar beneden. Alleen betekenisvol waar GHG_Geleverd waar is.";

			attribute<float32> GLG_Opgelegd (rdc_25m) := /Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata/GLG_cm[Bouwsteen] / 100f
			, IntegrityCheck = "/ModelParameters/Advanced/AdminDomain_ref == '25m'"
			, Descr = "De opgelegde stand in meters onder maaiveld, positief naar beneden, in dezelfde eenheid en met hetzelfde teken als de tifs van Deltares hierboven, zoals
						SourceData/Landbouw/Yield_Reduction/OpbrengstenDerving_T met gxg_scale en gxg_sign verwacht. De IntegrityCheck hangt hier zodat hij in de rekengraaf zit, want dit item is leverancier van de
						vier standen hieronder; hij bewaakt dat het AdminDomain 25 meter is, omdat de bouwsteenkaart op AdminDomain wordt weggeschreven en hier op rdc_25m op georeferentie wordt teruggelezen.";

			attribute<float32> Verschuiving_2017 (rdc_25m) := Referentie/GLG_2017_TR29_11 - GLG_Opgelegd;
			attribute<float32> Verschuiving_2050 (rdc_25m) := BAU/GLG_2050 - GLG_Opgelegd, Descr = "Hoeveel meter de stand omhoog moet ten opzichte van de BAU-levering om op de opgelegde GLG uit te komen. Positief is natter.";
			attribute<float32> Verschuiving_2085 (rdc_25m) := BAU/GLG_2085 - GLG_Opgelegd;

			attribute<float32> GLG_2017 (rdc_25m) := Opgelegd ? GLG_Opgelegd : Referentie/GLG_2017_TR29_11;
			attribute<float32> GHG_2017 (rdc_25m) := Opgelegd ? (GHG_Geleverd ? GHG_Opgelegd : max_elem(0f, Referentie/GHG_2017_TR29_11 - Verschuiving_2017)) : Referentie/GHG_2017_TR29_11
			, Descr = "De 2017-kaart draagt dezelfde opgelegde standen als die van 2050 en 2085, want de drie kaarten zijn klimaatankers en geen beleidsjaren: Templates/Landbouw/Suitability_T interpoleert tussen
						de twee ankers die het zichtjaar omsluiten, en met kale referentiestanden op dit anker zou de vernatting in 2040 voor een deel worden weggemengd, terwijl zij direct en volledig vanaf het
						eerste zichtjaar geldt. Geen enkel zichtjaar leest deze kaart als enige, dus zij is nooit een basisjaarbeeld.";

			attribute<float32> GLG_2050 (rdc_25m) := Opgelegd ? GLG_Opgelegd : BAU/GLG_2050;
			attribute<float32> GHG_2050 (rdc_25m) := Opgelegd ? (GHG_Geleverd ? GHG_Opgelegd : max_elem(0f, BAU/GHG_2050 - Verschuiving_2050)) : BAU/GHG_2050
			, Descr = "Twee regels op een opgelegde cel: geeft de bron een GHG (bouwstenen 1, 2, 3a en 4a), dan staat die er; geeft zij er geen, dan schuift de GHG mee met de GLG en wordt hij geklemd op maaiveld,
						wat de afstand tussen GHG en GLG kleiner kan maken maar de volgorde nooit omdraait. Het null-gedrag verschilt: de geleverde GHG staat er ook waar de BAU-levering niets geeft, net als bij
						GLG_Opgelegd, terwijl de meeschuifregel daar null blijft en de opbrengstderving terugvalt op de tak zonder treffer.";

			attribute<float32> GLG_2085 (rdc_25m) := Opgelegd ? GLG_Opgelegd : BAU/GLG_2085;
			attribute<float32> GHG_2085 (rdc_25m) := Opgelegd ? (GHG_Geleverd ? GHG_Opgelegd : max_elem(0f, BAU/GHG_2085 - Verschuiving_2085)) : BAU/GHG_2085;

			parameter<String> Regel_Versie := '782'
			, Descr = "Sleutel voor de regels in dit blok in de fingerprint van de opbrengstdervingskaarten: waar de opgelegde stand de BAU-stand vervangt en hoe de GHG meeschuift (#782). Een andere waarde dan in
						het zijbestand maakt de kaarten van deze levering opnieuw, dus de waarde verandert mee met die regels.";

			unit<uint8> Tabel := /Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata;

			unit<uint64> MetBouwsteen := select_with_org_rel(IsDefined(Bouwsteen))
			, Descr = "De cellen met een bouwsteen, met de bouwsteen en de plek van de cel als getal; de basis van de controlesom in Oplegging_Herkomst."
			{
				attribute<uint64> code    := uint64(Bouwsteen[org_rel]) + 1u64;
				attribute<uint64> positie := uint64(rdc_25m/id_rel[org_rel]);
			}

			parameter<String> Oplegging_Herkomst :=
				  'veen_rule='      + Regel_Versie
				+ ';veen_table='    + AsList(Tabel/code + ':' + (Tabel/HeeftGLG ? string(Tabel/GLG_cm) : '-') + '/' + (Tabel/HeeftGHG ? string(Tabel/GHG_cm) : '-'), ',')
				+ ';veen_cells='    + string(#MetBouwsteen)
				+ ';veen_checksum=' + string(sum(MetBouwsteen/code * MetBouwsteen/positie)) + '-' + string(sum(MetBouwsteen/code * ((MetBouwsteen/positie * MetBouwsteen/positie + 1u64) % 4294967291u64)))
			, Descr = "De veenoplegging in de fingerprint van de opbrengstdervingskaarten: de regels, de opgelegde standen per bouwsteen en een controlesom over de bouwsteenkaart, met elke cel gewogen naar
						haar plek. Die controlesom vraagt de veenallocatie van VariantData/NbSGenuanceerd, dus wie de fingerprint van een dervingskaart van deze levering opvraagt, rekent die allocatie door.";

			parameter<String> Herkomst_2017 := Referentie/Herkomst_TR29_11 + ';' + Oplegging_Herkomst, Descr = "Zie BAU/Herkomst_2017; hier komt op elk anker de veenoplegging erbij.";
			parameter<String> Herkomst_2050 := BAU/Herkomst_2050 + ';' + Oplegging_Herkomst;
			parameter<String> Herkomst_2085 := BAU/Herkomst_2085 + ';' + Oplegging_Herkomst;
		}
	}

	#include<WBS.dms>
	
	#include<dijkring.dms>
	#include<TeDroog.dms>
	#include<TeNat.dms>
	#include<TeZout.dms>
	#include<TeSlap.dms>
	#include<TeGevaarlijk.dms>
	#include<RuimteVoorRivierafvoer.dms>
	
	container Risicozonering
	: Descr = "De overstromingsgevaarzonering zoals aangeleverd, en de omzetting daarvan naar het modelraster."
	{
		container Bron
		: Descr = "De aangeleverde tif. Ligt 5 m naast het RD-25m-raster (celoffset -22,2 en -160,2) en heeft tegels van 128x128, dus GeoDMS schuift hem naar de dichtstbijzijnde cel en waarschuwt daarover. Alleen nog nodig om met Maak de tif te genereren."
		{
			attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (rdc_25m)
			:	StorageType = "gdal.grid"
			,	Source      = "Deltares-5, 3 juli 2022 per email"
			,	url         = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Overstromingsgevaarzonering_beleidsregimes_en_constraints_voor_ruimtescanner_ks.pdf"
			,	StorageName = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Risicozonering_010722.tif";
		}

		container Maak
		: Descr = "Zet de bron eenmalig om naar een getegelde, LZW-gecomprimeerde tif op het modelraster, met dezelfde afronding die GeoDMS nu bij het inlezen maakt. Draai dit met StudyArea = Nederland, want de tif beslaat het hele land."
		{
			parameter<Bool> IsNederland := lowercase(/ModelParameters/StudyArea) == 'nederland', Descr = "Bewaakt dat de tif niet per ongeluk met een provincie als studiegebied wordt weggeschreven.";

			attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (rdc_25m) := Bron/Overstromingsgevaarzonering
			,	StorageName = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Risicozonering_010722_025m_NL_rdc_uint8.tif"
			,	StorageType = "gdalwrite.grid"
			,	IntegrityCheck = "IsNederland";

			parameter<String> Generate := 'Ready', ExplicitSuppliers = "/SourceData/Water/Risicozonering/Maak/Overstromingsgevaarzonering", Descr = "Volledig gekwalificeerd pad met opzet: op ouderniveau staat een gelijknamig leesitem, en een ongekwalificeerde naam zou daar stil naartoe oplossen zodra dit schrijfitem verdwijnt of wordt hernoemd.";
		}
	}

	attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (rdc_25m)
	:	Source          = "Deltares-5, 3 juli 2022 per email"
	,	url             = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Overstromingsgevaarzonering_beleidsregimes_en_constraints_voor_ruimtescanner_ks.pdf"
	,	StorageName     = "%RSo_DataDir%/Omgeving/Water/Overstromingsgevaarzonering/Risicozonering_010722_025m_NL_rdc_uint8.tif"
	,	StorageReadOnly = "true";
	
