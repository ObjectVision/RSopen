////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Is Deep Draining possible in this scenario? De dikte van het veenpakket is in meter en is afkomstig van het
// ondergrond bestand dat met het Atlantis model gemaakt is. Dit ondergrond bestand is voor een heel groot deel
// (excl Flevoland) gebaseerd op geotop. 0: Kleiner risico, 1: Nagenoeg gelijk risico, 2: Enig groter risico, 3:
// Matig groter risico, 4: Aanzienlijk groter risico
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landbouw : using = "Classifications/Landbouw"
{
	attribute<Meter> Peat_thickness (rdc_25m)
	:	Descr       = "De dikte van het veenpakket is in meter en is afkomstig van het ondergrond bestand dat met het Atlantis model gemaakt is. Dit ondergrond bestand is voor een heel groot deel (excl Flevoland) gebaseerd op geotop."
	,	Source      = "Ontvangen van Deltares op 25 November 2025."
	,	url         = "https://basisregistratieondergrond.nl/inhoud-bro/registratieobjecten/modellen/geotop-gtm/"
	,	StorageName = "%RS_Lb_DataDir%/landgebruik/peat_thickness_regridded.tif";
	
	container BRP
	: Descr = "De Basisregistratie Gewaspercelen, het gewas per perceel zoals de teler het opgeeft. Vervangt sinds #751 de voedergewassenkaart uit 2014.

				Waarom die eruit ging. Dat was een aanlevering van LEI van 10 april 2015 op basis van de BRP en de
				landbouwtelling van 2014, opgeslagen als voedergew2014_categorie.tif, en zij bepaalde de klasse op
				740.798 ha. Op een vijfde daarvan, 148.918 ha, registreert de BRP 2025 bouwland waar die kaart
				grasland zegt. De herkomst van het bestand lag bovendien niet vast; alleen de zes categorien en het
				jaartal waren bekend.

				Wat ervoor in de plaats komt en wat niet. De BRP geeft het gewas per perceel, jaarlijks, met een
				bekende herkomst. Wat zij niet geeft is de melkveedichtheid, en dat was precies wat de oude kaart als
				enige leverde. De driedeling extensief, standaard en intensief is daarom losgelaten; zie
				Classifications/Landbouw/BRPGewas voor de koppeling en voor wat er met GG_vee_intensief gebeurt.

				De BRP is geen vlakdekkende kaart: zij bevat alleen percelen die voor subsidie zijn opgegeven, op 25
				meter gerasterd 1.853.847 ha van de 3.509.101 ha studiegebied. Zij vervangt CBS dus niet als
				poortwachter en LGN niet als achtervang. De volgorde in BaseData/Grondgebruik blijft CBS, dan deze
				bron, dan LGN.

				Het bestand staat in de wortel van %sourceDataDir% en niet onder %RS_Lb_DataDir%/Landgebruik, waar
				het thuis zou horen. Verplaatsen kan niet zomaar: die schijf synchroniseert met Nextcloud en is
				schrijf-eenmaal, dus een verhuizing is een bewuste actie van de beheerder en geen opruimwerk."
	{
		container Bron
		:	StorageName     = "='%sourceDataDir%/brpgewaspercelen_definitief_'+/ModelParameters/BRP_Year+'.gpkg'"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "TRUE"
		,	Source          = "RVO, Basisregistratie Gewaspercelen, definitieve versie"
		,	url             = "https://www.rvo.nl/onderwerpen/basisregistratie-gewaspercelen-brp"
		,	DialogData      = "rdc_meter"
		{
			unit<uint32> perceel
			:	SqlString = "select gewascode, geom from brp_gewas where category <> 'Landschapselement' order by ST_Area(geom) desc"
			,	Descr = "De percelen, zonder de landschapselementen en op volgorde van groot naar klein.

						De landschapselementen, ruim een miljoen van de 2,33 miljoen records, zijn houtwallen,
						bomenrijen en slootkanten. Ze liggen als kleine polygonen binnen de percelen en zijn op 25
						meter niet zinvol te rasteren, dus ze vallen hier weg; er blijven 1.329.752 percelen over.

						De volgorde is er tegen de nesting: poly2grid laat de polygoon winnen die als laatste aan de
						beurt is, dus met groot naar klein wint een klein perceel binnen een groter. Zie de skill
						geodms-valkuilen.

						LET OP: deze string moet letterlijk blijven en mag geen =-expressie worden. De fingerprint van
						de tif leest zijn tekst met PropValue, en PropValue geeft de expressietekst en niet de
						uitkomst. Interpoleert de string ooit een parameter of een %placeholder%, dan blijft die tekst
						gelijk terwijl de werkelijke query verandert, en beweegt de fingerprint niet mee. Moet er toch
						iets variabels in, zet die waarde dan als eigen sleutel in Fingerprint_Gewascode.";
		}

		attribute<Int32> Calc_Gewascode (rdc_25m) := Bron/perceel/gewascode[poly2grid(Bron/perceel/geometry, rdc_25m)]
		, Descr = "De gewascode per cel, null waar geen perceel ligt. Int32 omdat de kolom als MEDIUMINT binnenkomt.";

		parameter<String> FileName_Gewascode := '%LocalDataProjDir%/BaseData/Landbouw/BRP_Gewascode_25m_'+/ModelParameters/BRP_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft.";

		parameter<String> Fingerprint_Gewascode :=
			  'brp_year='          + /ModelParameters/BRP_Year
			+ ';sql='              + PropValue(Bron/perceel, 'SqlString')
			+ ';study_area='       + /ModelParameters/StudyArea
			+ ';grid_size='        + string(rdc_25m/gridsize)
		, Descr = "De volledige lijst invoeren die de tif bepaalt. brp_year bepaalt via de bestandsnaam welk gpkg wordt gelezen.

					De sleutel sql draagt de letterlijke tekst van de SqlString, en dat is geen franje. Die string
					bepaalt welke percelen meedoen en in welke volgorde ze worden gerasterd, en dat laatste beslist bij
					overlap wie wint. Zou hij er niet in staan, dan verandert een aanpassing eraan de uitkomst zonder
					dat de fingerprint meebeweegt, wordt de tif dus niet opnieuw gemaakt, en zwijgt ook de areaaltoets
					hieronder, want die hangt aan de maakkant. Precies dat stille geval is bij #613 misgegaan, waar een
					gewijzigde window function 1.500 van de 12.233 ha wegnam met exitcode 0.

					De koppeling naar LU_ModelType staat er bewust niet in: de tif draagt de rauwe gewascode en de
					vertaling gebeurt na het lezen, dus een wijziging in BRPGewas werkt meteen door zonder dat de tif
					opnieuw hoeft. Verplaatst iemand die vertaling ooit naar de schrijfkant, dan hoort de tabel wel in
					deze lijst.";

		container Decoupling_Gewascode := /Templates/DecoupledFile_T(FileName_Gewascode, Fingerprint_Gewascode);

		attribute<Int32> Make_Gewascode (rdc_25m) := Calc_Gewascode, StorageName = "=FileName_Gewascode", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_Gewascode/Write_Fingerprint;Controle/Ratio"
		, Descr = "Schrijft de gerasterde gewascode eenmalig weg. Het rasteren kost ongeveer een minuut en leest 2,9 GB van de gesynchroniseerde schijf; ontkoppelen scheelt dat bij elke volgende aanroep.";

		attribute<Int32> Read_Gewascode (rdc_25m) : StorageName = "=FileName_Gewascode", StorageType = "gdal.grid", StorageReadOnly = "TRUE";

		attribute<BRPGewasType> BRPGewasType_rel (rdc_25m) := = Decoupling_Gewascode/MayReuse ? 'rlookup(Read_Gewascode, BRPGewasType/code)' : 'rlookup(Make_Gewascode, BRPGewasType/code)'
		, Descr = "Vraag Decoupling_Gewascode/Explanation op als je wilt weten waarom de tif wel of niet opnieuw wordt gemaakt.";

		// attribute<Classifications/Actor/LU_ModelType> LU_ModelType_rel (rdc_25m) :=
		// 	/Classifications/Landbouw/BRPGewas/LU_ModelType_rel[rlookup(Gewascode, /Classifications/Landbouw/BRPGewas/code)]
		// , Descr = "De landbouwklasse van het model per cel, null waar geen perceel ligt en null waar de gewascode geen tegenhanger heeft in de klassen van Actor/LandbouwKlasses.

		// 			De vertaling gebeurt hier, na het lezen, en niet in de tif. Dat is bewust: de tif draagt de rauwe
		// 			gewascode, dus een wijziging in BRPGewas werkt meteen door en hoeft niet in de fingerprint. Zou de
		// 			tif de vertaalde klasse dragen, dan was die koppeling wel een determinant en leverde een wijziging
		// 			aan de tabel stil een verouderd bestand.";

		container Controle
		: Descr = "Areaaltoets op het rasteren, naast de fingerprint. Een fingerprintsleutel vangt een gewijzigde SqlString niet: verandert daar de sorteervolgorde of een filter, dan blijft de sleutel gelijk terwijl het raster verschuift. Bij #613 verdween zo 1.500 van de 12.233 ha met exitcode 0. Deze toets legt het gerasterde areaal naast het polygoonareaal en valt om zodra die twee uit elkaar lopen."
		{
			parameter<Ha> Areaal_Vector := sum(area(Bron/perceel/geometry, meter2_f64)[Ha])
			, Descr = "Het areaal van alle percelen samen, rechtstreeks uit de polygonen.";

			parameter<Ha> Areaal_Raster := sum(IsDefined(Calc_Gewascode) ? rdc_25m/NrHaPerCell : 0[Ha])
			, Descr = "Hetzelfde areaal zoals het model het op 25 meter gerasterd heeft.";

			parameter<float32> Ratio := Areaal_Raster / Areaal_Vector
			, IntegrityCheck = "abs(this - 1f) < 0.01f"
			, Descr = "De verhouding tussen die twee, gemeten op 2026-09-04 op 0,99994. Het rasteren kost dus 0,006 procent, want percelen zijn groot ten opzichte van een cel van 25 meter en wat aan de ene rand afvalt komt er aan de andere bij. De marge van een procent is daarmee ruim, en toch scherp genoeg voor het soort fout dat hij moet vangen: bij #613 verdween twaalf procent.

						Deze toets hangt via ExplicitSuppliers aan Make_Gewascode en vuurt dus alleen wanneer de tif werkelijk wordt gemaakt. Dat is bewust, want aan de leeskant zou hij het gpkg bij elke run opnieuw openen en daarmee het ontkoppelen zinloos maken. Het betekent wel dat hij de fingerprint niet vervangt maar aanvult: wat de sleutel niet ziet leidt niet tot een remake, en dan zwijgt deze toets ook. Daarom staat de SqlString in de sleutel.";
		}
	}


	container WUR_Kansenkaarten
	{
		container PerVariant :=
			for_each_ne(
				VariantParameters/VariantK/name
				, 'Kansenkaarten_T('+quote(VariantParameters/VariantK/name)+')'
			);
			
		Template Kansenkaarten_T
		{
			parameter<string> variant_name;
			///
			container Kansenkaarten := 
				for_each_nedv(
					Exotische_GewasSoort/name
					, 'Read_gpkg/'+Exotische_GewasSoort/name+'/Kansenkaart/Totaalscore_value_25m'
					, rdc_25m
					, float32
				)
			{
				attribute<Exotische_GewasSoort> ArgMax (rdc_25m) := ='ArgMax_ifdefined('+asItemList(Exotische_GewasSoort/name)+')[Exotische_GewasSoort]';
			}
			
			container Read_gpkg := 
				for_each_ne(
					Exotische_GewasSoort/name
					, 'Read_gpkg_T('+quote(Exotische_GewasSoort/name)+',Variant_name)'
				);
		}
		
		Template Read_gpkg_T
		{
			parameter<String> Gewas_name;
			parameter<String> Variant;
			
			unit<UInt32> Kansenkaart 
			: StorageName = "='%RS_Lb_DataDir%/Gewassen/WUR_Kansenkaarten/'+Variant_name+' 2050/'+gewas_name+'.gpkg'"
			, StorageType = "gdal.vect"
			, StorageReadOnly = "TRUE"
			, DialogData = "rdc_meter"
			{
				attribute<Float32> Bodemscore_value                   := float32(replace(Bodemscore, '#VALUE!', ''));
				attribute<Float32> Totaalscore_value                  := float32(replace(Totaalscore, '#VALUE!', ''));
				
				attribute<Float32> Totaalscore_value_250m  (rdc_250m) := Totaalscore_value[rdc_250m_rel];
				attribute<Float32> Totaalscore_value_25m    (rdc_25m) := Totaalscore_value[rdc_25m_rel];
				attribute<Float32> Totaalscore_value_100m  (rdc_100m) := mean(Totaalscore_value_25m, rdc_25m/rdc_100m_rel);
				
				attribute<.>       rdc_25m_rel              (rdc_25m) := poly2grid(geometry, rdc_25m);
				attribute<.>       rdc_250m_rel            (rdc_250m) := poly2grid(geometry, rdc_250m);
			}
		}
	}
	
	container Yield_Reduction
	{
		container WWL_relatie_database
		{
			unit<spoint> dmgwet
			: StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgwet"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";
			unit<spoint> dmgdry
			: StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgdry"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";
			unit<spoint> dmgind
			: StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgind"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";
			unit<spoint> dmgdir
			: StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgdir"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";

			unit<spoint> dmgtot
			: StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgtot"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";

			unit<uint32> banden := cat_range(0, 2844)
			{
				attribute<uint32> bandnr := id(.) + 1;
				attribute<string> name := 'b'+string(bandnr);
			}

			container dmgtot_bands := 
				for_each_ndvs(
					banden/name
					, dmgtot
					, float32
					, "BANDS=" + string(id(banden))
				) 
				, StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgtot"
				, StorageType     = "gdal.grid"
				, StorageReadOnly = "True";

			container dmgwet_bands := 
				for_each_ndvs(
					banden/name
					, dmgwet
					, float32
					, "BANDS=" + string(id(banden))
				) 
				, StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgwet"
				, StorageType     = "gdal.grid"
				, StorageReadOnly = "True";

			container dmgdry_bands := 
				for_each_ndvs(
					banden/name
					, dmgdry
					, float32
					, "BANDS=" + string(id(banden))
				) 
				, StorageName = "NETCDF:%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc:dmgdry"
				, StorageType     = "gdal.grid"
				, StorageReadOnly = "True";
			
			container codes
			{
				unit<uint32> bodem := union_unit_uint32(Classifications/Grondgebruik/Bodem/BOFEK_K)
				{ 
					attribute<uint32> code  := union_data(., Classifications/Grondgebruik/Bodem/BOFEK_K/EK);
					attribute<string> label := union_data(., Classifications/Grondgebruik/Bodem/BOFEK_K/label);
				}
			}

			unit<uint32> combo := range(uint32, 0, 2844)
			{
				attribute<uint32>      band       :=  id(combo) + 1;
				attribute<uint32>      klimaat    :=  id(combo)        % 2;
				attribute<uint32>      beregening := (id(combo) /  2)  % 2;
				attribute<WWL_Gewassen> gewas_rel  := value((id(combo) /  4)  % 9, WWL_Gewassen);
				attribute<codes/bodem> bodem_rel  := value(id(combo) / 36, codes/bodem);
				attribute<uint32>      gewas_code := WWL_Gewassen/code[gewas_rel];
				attribute<uint32>      bodem_code := codes/bodem/code[bodem_rel];
			}

			unit<spoint> wwl_grid := WWL_relatie_database/dmgtot;   // 301 x 301

			// alleen de 9 gewassen die in de netcdf-dimensie zitten
			unit<uint32> WWL_Gewassen := cat_range(0, 9)
			{
				attribute<uint32> code  : [1, 6, 7, 9, 12, 13, 20, 22, 23];
				attribute<string> label := Classifications/Grondgebruik/WWLKlasse/label[rlookup(code, uint32(Classifications/Grondgebruik/WWLKlasse/EK))];
				attribute<string> name  := AsItemName(label);
				attribute<string> GeneriekeNaam  := Classifications/Grondgebruik/WWLKlasse/GeneriekeNaam[rlookup(code, uint32(Classifications/Grondgebruik/WWLKlasse/EK))];
			}				
		}

		attribute<uint32> Beregeningskaart_Basisprognoses_2018 (AdminDomain)
		: StorageName = "%RS_Lb_DataDir%/Gewassen/Beregeningskaart_Basisprognoses_2018.asc"
		, StorageType = "gdal.grid"
		, DialogData = "rdc_meter"
		{
			attribute<WWL_BeregeningsK> WWL_Beregenings_rel (AdminDomain) := . == 1 || . == 2 ? WWL_BeregeningsK/v/WelBeregening : WWL_BeregeningsK/v/GeenBeregening;
		}
		

		container OpbrengstenDerving_Dynamisch :=
			for_each_ne(
				OpbrengstendervingsVarianten/name
				, 'OpbrengstenDerving_T('+string(id(OpbrengstendervingsVarianten))+'[OpbrengstendervingsVarianten])'
			)
		{
			parameter<String> generate := 'Ready', explicitsuppliers = "=AsList(OpbrengstendervingsVarianten/name+'/opbrengstderving', ';')";
		}

		unit<uint8> OpbrengstendervingsVarianten := combine_uint8(NL2120_Varianten, WWL_Zichtjaren, WWL_relatie_database/WWL_Gewassen)
		{
			attribute<NL2120_Varianten> NL2120_Varianten_rel := first_rel;
			attribute<WWL_Zichtjaren>   WWL_Zichtjaren_rel   := second_rel;
			attribute<WWL_relatie_database/WWL_Gewassen>     WWL_Gewassen_rel     := third_rel;

			attribute<string> name := NL2120_Varianten/label[NL2120_Varianten_rel]+'/'+WWL_Zichtjaren/label[WWL_Zichtjaren_rel]+'/'+WWL_relatie_database/WWL_Gewassen/name[WWL_Gewassen_rel];
		}		

	
		Template OpbrengstenDerving_T
		{
			parameter<OpbrengstendervingsVarianten> OpbrengstendervingsVarianten_rel;

			parameter<string>  NL2120_Varianten_name := NL2120_Varianten/label[OpbrengstendervingsVarianten/NL2120_Varianten_rel[OpbrengstendervingsVarianten_rel]];
			parameter<string>  WWL_Zichtjaar         := WWL_Zichtjaren/name[OpbrengstendervingsVarianten/WWL_Zichtjaren_rel[OpbrengstendervingsVarianten_rel]];
			parameter<uint32>  Zichtjaar_klimaat     := uint32(WWL_Klimaatscenarios/v/WarmHoog);
			parameter<uint32>  Gewas_code            := WWL_relatie_database/WWL_Gewassen/code[OpbrengstendervingsVarianten/WWL_Gewassen_rel[OpbrengstendervingsVarianten_rel]];
			parameter<string>  Gewas_name            := WWL_relatie_database/WWL_Gewassen/label[OpbrengstendervingsVarianten/WWL_Gewassen_rel[OpbrengstendervingsVarianten_rel]];

			parameter<float32> gxg_sign  := 1f;      // positief = diepte onder maaiveld
			parameter<float32> gxg_scale := 100f;    // op 100 zetten als de kaart in meters staat

			unit<uint32> combo_sel := select_with_org_rel(WWL_relatie_database/combo/klimaat    == Zichtjaar_klimaat
															&& WWL_relatie_database/combo/gewas_code == Gewas_code)
			{
				attribute<uint32> bodem_code := org_rel -> bodem_code;
				attribute<uint32> gewas_code := org_rel -> combo/gewas_code;
				attribute<uint32> beregening := org_rel -> combo/beregening;
				attribute<uint32> band       := org_rel -> combo/band;
			}

			unit<uint32> LUT := combine(combo_sel, WWL_relatie_database/wwl_grid)   //lookup table
			{
				attribute<spoint>  wwl_lin    := second_rel;         
				attribute<uint32>  wwl_row    := uint32(PointRow(wwl_lin));
				attribute<uint32>  wwl_col    := uint32(PointCol(wwl_lin));

				attribute<uint32>  ghg        := 300 - wwl_row;   // rij   = ghg, cm = 300 - index
				attribute<uint32>  glg        := 300 - wwl_col;   // kolom = glg, cm = 300 - index			
				attribute<uint32>  bodem_code := combo_sel/bodem_code[first_rel];
				attribute<uint32>  gewas_code := combo_sel/gewas_code[first_rel];
				attribute<uint32>  beregening := combo_sel/beregening[first_rel];

				// mixed-radix sleutel; slots: beregening<2, bodem_code<8192 (BOFEK EK max 5007), gewas_code<32, ghg<512, glg<512. Zelfde formule per-cel (zie key hieronder).
				attribute<uint64>  key		  := (((uint64(beregening)*8192u64 + uint64(bodem_code))*32u64 + uint64(gewas_code))*512u64 + uint64(ghg))*512u64 + uint64(glg);

				attribute<float32> dmgtot_stack  := ='union_data(., ' + AsItemList('WWL_relatie_database/dmgtot_bands/b' + string(combo_sel/band)) + ')';
			}

			container Input
			{
				attribute<uint32>  bodem_code   (AdminDomain) := SourceData/Bodem/BOFEK/BOFEK_CODE;
				attribute<uint32>  gewas_code   (AdminDomain) := const(../Gewas_code, AdminDomain);
				attribute<uint32>  beregenings_code (AdminDomain)  := uint32(Beregeningskaart_Basisprognoses_2018/WWL_Beregenings_rel);
				attribute<float32> ghg_cm       (AdminDomain) := ='gxg_scale * gxg_sign * SourceData/Water/Grondwaterstanden/'+NL2120_Varianten_name+'/GHG_'+WWL_Zichtjaar+'';
				attribute<float32> glg_cm       (AdminDomain) := ='gxg_scale * gxg_sign * SourceData/Water/Grondwaterstanden/'+NL2120_Varianten_name+'/GLG_'+WWL_Zichtjaar+'';

				attribute<int32>   ghg_index    (AdminDomain) := IsDefined(ghg_cm) ? int32(max_elem(0f, min_elem(300f, ghg_cm)) + 0.5f) : null_i;
				attribute<int32>   glg_index    (AdminDomain) := IsDefined(glg_cm) ? int32(max_elem(0f, min_elem(300f, glg_cm)) + 0.5f) : null_i;
			}

			attribute<uint64>  key              (AdminDomain) := (((uint64(input/beregenings_code)*8192u64 + uint64(input/bodem_code))*32u64 + uint64(input/gewas_code))*512u64 + uint64(input/ghg_index))*512u64 + uint64(input/glg_index);
			attribute<uint32>  match            (AdminDomain) := rlookup(key, lut/key);

			// ----- RESULT
			attribute<float32> Opbrengstderving (AdminDomain) := lut/dmgtot_stack[match] / 100f, StorageName = "='%RS_Lb_DataDir%/Gewassen/WWL_Opbrengstderving/'+NL2120_Varianten_name+'_'+WWL_Zichtjaar+'_'+Gewas_name+'.tif'", StorageType = "gdalwrite.grid";
		}

		// ================================================================================================================================================================

		unit<uint8> BeregeningScenarios := cat_range(0b, 3b)
		{
			attribute<string> VariantName : ['GeenBeregening','Beregening_allepercelen_ongelim','Beregening_percelenmetinstal_ongelim'];
			attribute<string> Code        : ['A','B1','B2'];
			attribute<string> name        := Code+'_'+VariantName;
		}
		
		container BeregeningScenario_Regionaal := 
			for_each_ne(
				BeregeningScenarios/name
				, 'Read_BeregeningScenarios_T('+quote(BeregeningScenarios/name)+','+quote(BeregeningScenarios/code)+',''Regionaal'', ''drystress_1976_@SC@_gewas@GWNR@_simpel'')'
			), Descr = "Yield reduction per beregening scenario, volgens methode 'Regionaal'.";
			
		container BeregeningScenario_Lokaal_WWL
		{
			container BAU := 
				for_each_ne(
					BeregeningScenarios/name
					, 'Read_BeregeningScenarios_T('+quote(BeregeningScenarios/name)+','+quote(BeregeningScenarios/code)+',''Lokaal_WWL'', '+quote('BAU/dmgdry-Wh-2036-2065_gewas@GWNR@_Variant@SC@_droogteschade')+')'
				), Descr = "Yield reduction per beregening scenario, volgens methode 'Lokaal WWL'.";
				
			container WBS := 
				for_each_ne(
					BeregeningScenarios/name
					, 'Read_BeregeningScenarios_T('+quote(BeregeningScenarios/name)+','+quote(BeregeningScenarios/code)+',''Lokaal_WWL'', '+quote('WBS/dmgdry-Wh-2036-2065_gewas@GWNR@_Variant@SC@_droogteschade')+')'
				), Descr = "Yield reduction per beregening scenario, volgens methode 'Lokaal WWL'.";
		}
		
		Template Read_BeregeningScenarios_T
		{
			parameter<string> scenario_name;
			parameter<string> scenario_code;
			parameter<string> methode;
			parameter<string> filename0;
			//
			
			parameter<string> filename := '%RS_Lb_DataDir%/Gewassen/Opbrengstderving_Beregening_'+methode+'/'+filename0+'.tif';
			
			
			container Read := 
				for_each_ndvat(
					BeregeningsScenarioGewassen/name
					, rdc_25m
					, float32
					, replace(filename, '@GWNR@', BeregeningsScenarioGewassen/code, '@SC@', scenario_code)
					, 'tif'
				);
		}
		
		container WWL_WBS := 
			for_each_ndvat(
				WWL_GewasSoort/name
				, rdc_25m
				, float32
				, '%RS_Lb_DataDir%/Gewassen/WWL_opbrengstderving/WBS/'+WWL_GewasSoort/name+'/dmgtot-Wh-2036-2065.tif'
				, 'tif'
			);
		container WWL_BAU :=  
			for_each_ndva(
				WWL_GewasSoort/name
				, rdc_25m
				, float32
				, '%RS_Lb_DataDir%/Gewassen/WWL_opbrengstderving/BAU/'+WWL_GewasSoort/name+'/dmgtot-Wh-2036-2065.tif'
			);
	}

