// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Is Deep Draining possible in this scenario? De dikte van het veenpakket is in meter en is afkomstig van het
// ondergrond bestand dat met het Atlantis model gemaakt is. Dit ondergrond bestand is voor een heel groot deel
// (excl Flevoland) gebaseerd op geotop. 0: Kleiner risico, 1: Nagenoeg gelijk risico, 2: Enig groter risico, 3:
// Matig groter risico, 4: Aanzienlijk groter risico
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landbouw : using = "Classifications/Landbouw"
{
	attribute<Meter> Peat_thickness (rdc_25m)
	:	Descr       = "De dikte van het veenpakket is in meter en is afkomstig van het ondergrond bestand dat met het Atlantis model gemaakt is. Dit ondergrond bestand is voor een heel groot deel (excl Flevoland) gebaseerd op geotop."
	,	Source      = "Ontvangen van Deltares op 25 November 2025."
	,	url         = "https://basisregistratieondergrond.nl/inhoud-bro/registratieobjecten/modellen/geotop-gtm/"
	,	StorageName = "%RS_Lb_DataDir%/landgebruik/peat_thickness_regridded.tif";
	
	container BRP
	: Descr = "De Basisregistratie Gewaspercelen, het gewas per perceel zoals de teler het opgeeft; vervangt sinds #751 de voedergewassenkaart uit 2014, een LEI-aanlevering op basis van de BRP en de
				landbouwtelling van 2014 waarvan de herkomst niet vastlag en die op een vijfde van haar areaal grasland zei waar de BRP bouwland registreert. De BRP geeft het gewas per perceel, jaarlijks,
				met een bekende herkomst, maar niet de melkveedichtheid; de driedeling extensief, standaard en intensief is daarom losgelaten, zie Classifications/Landbouw/BRPGewas. Geen vlakdekkende kaart,
				want alleen percelen die voor subsidie zijn opgegeven, dus zij vervangt CBS niet als poortwachter en LGN niet als achtervang: de volgorde in BaseData/Grondgebruik blijft CBS, dan deze bron,
				dan LGN. Het bestand staat in de wortel van %sourceDataDir%; verplaatsen naar %RS_Lb_DataDir%/Landgebruik is een bewuste actie van de beheerder, want die schijf is schrijf-eenmaal. De gerasterde gewascode staat in BaseData/Landbouw/BRP (#440)."
	{
		container Bron
		:	StorageName     = "='%RSo_DataDir%/Grondgebruik/BRP/brpgewaspercelen_definitief_'+/ModelParameters/BRP_Year+'.gpkg'"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "TRUE"
		,	Source          = "RVO, Basisregistratie Gewaspercelen, definitieve versie"
		,	url             = "https://www.rvo.nl/onderwerpen/basisregistratie-gewaspercelen-brp"
		,	DialogData      = "rdc_meter"
		{
			unit<uint32> perceel
			:	SqlString = "select gewascode, geom from brp_gewas where category <> 'Landschapselement' order by ST_Area(geom) desc"
			,	Descr = "De percelen, zonder de landschapselementen en op volgorde van groot naar klein. De landschapselementen (houtwallen, bomenrijen, slootkanten, bijna de helft van de records) liggen als kleine
						polygonen binnen de percelen en zijn op 25 meter niet zinvol te rasteren. De volgorde is er tegen de nesting: poly2grid laat de laatst getekende polygoon winnen, dus met groot naar klein
						wint een klein perceel binnen een groter (skill geodms-valkuilen). Deze string moet letterlijk blijven en mag geen =-expressie worden: de fingerprint van de tif leest zijn tekst met
						PropValue, en die geeft de expressietekst en niet de uitkomst; moet er iets variabels in, zet die waarde dan als eigen sleutel in Fingerprint_Gewascode.";
		}
	}


	container WUR_Kansenkaarten
	{
		container PerVariant :=
			for_each_ne(
				VariantParameters/VariantK/name
				, 'Kansenkaarten_T('+quote(VariantParameters/VariantK/name)+')'
			);
			
		Template Kansenkaarten_T
		{
			parameter<string> variant_name;
			///
			container Kansenkaarten := 
				for_each_nedv(
					Exotische_GewasSoort/name
					, 'Read_gpkg/'+Exotische_GewasSoort/name+'/Kansenkaart/Totaalscore_value_25m'
					, rdc_25m
					, float32
				)
			{
				attribute<Exotische_GewasSoort> ArgMax (rdc_25m) := ='ArgMax_ifdefined('+asItemList(Exotische_GewasSoort/name)+')[Exotische_GewasSoort]';
			}
			
			container Read_gpkg := 
				for_each_ne(
					Exotische_GewasSoort/name
					, 'Read_gpkg_T('+quote(Exotische_GewasSoort/name)+',Variant_name)'
				);
		}
		
		Template Read_gpkg_T
		{
			parameter<String> Gewas_name;
			parameter<String> Variant;
			
			unit<UInt32> Kansenkaart 
			: StorageName = "='%RS_Lb_DataDir%/Gewassen/WUR_Kansenkaarten/'+/VariantParameters/VariantK/Kansenkaart_Levering[rlookup(Variant_name, /VariantParameters/VariantK/name)]+' 2050/'+gewas_name+'.gpkg'"
			, StorageType = "gdal.vect"
			, StorageReadOnly = "TRUE"
			, DialogData = "rdc_meter"
			{
				attribute<Float32> Bodemscore_value                   := float32(replace(Bodemscore, '#VALUE!', ''));
				attribute<Float32> Totaalscore_value                  := float32(replace(Totaalscore, '#VALUE!', ''));
				
				attribute<Float32> Totaalscore_value_250m  (rdc_250m) := Totaalscore_value[rdc_250m_rel];
				attribute<Float32> Totaalscore_value_25m    (rdc_25m) := Totaalscore_value[rdc_25m_rel];
				attribute<Float32> Totaalscore_value_100m  (rdc_100m) := mean(Totaalscore_value_25m, rdc_25m/rdc_100m_rel);
				
				attribute<.>       rdc_25m_rel              (rdc_25m) := poly2grid(geometry, rdc_25m);
				attribute<.>       rdc_250m_rel            (rdc_250m) := poly2grid(geometry, rdc_250m);
			}
		}
	}
	
	container Yield_Reduction
	{
		container WWL_relatie_database
		{
			parameter<String> Bestand := '%RS_Lb_DataDir%/Gewassen/WWL_relatie_database_20260610.nc'
			, Descr = "De netcdf met de WWL-schaderelaties. Het pad staat als eigen parameter en niet alleen in de StorageNames hieronder, omdat de fingerprint van de dervingskaarten het als gegeven nodig heeft.";

			unit<spoint> dmgwet
			: StorageName = "='NETCDF:'+Bestand+':dmgwet'"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";
			unit<spoint> dmgdry
			: StorageName = "='NETCDF:'+Bestand+':dmgdry'"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";
			unit<spoint> dmgind
			: StorageName = "='NETCDF:'+Bestand+':dmgind'"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";
			unit<spoint> dmgdir
			: StorageName = "='NETCDF:'+Bestand+':dmgdir'"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";

			unit<spoint> dmgtot
			: StorageName = "='NETCDF:'+Bestand+':dmgtot'"
			, StorageType = "gdal.grid"
			, StorageReadOnly = "TRUE";

			unit<uint32> banden := cat_range(0, 2844)
			, Descr = "De 2844 banden van de netcdf, een per rij van combo. Het item bN leest GDAL-band N; de GDAL-optie BANDS is eengebaseerd, dus combo/band is id plus 1 en het geldige bereik loopt van 1 tot en
						met 2844 (skill geodms-valkuilen). De twee andere banden-containers, dmgwet_bands en dmgdry_bands, hebben dezelfde opbouw en worden op dit moment door niets gelezen."
			{
				attribute<uint32> bandnr := id(.) + 1;
				attribute<string> name := 'b'+string(bandnr);
			}

			container dmgtot_bands := 
				for_each_ndvs(
					banden/name
					, dmgtot
					, float32
					, "BANDS=" + string(banden/bandnr)
				) 
				, StorageName = "='NETCDF:'+Bestand+':dmgtot'"
				, StorageType     = "gdal.grid"
				, StorageReadOnly = "True";

			container dmgwet_bands := 
				for_each_ndvs(
					banden/name
					, dmgwet
					, float32
					, "BANDS=" + string(banden/bandnr)
				) 
				, StorageName = "='NETCDF:'+Bestand+':dmgwet'"
				, StorageType     = "gdal.grid"
				, StorageReadOnly = "True";

			container dmgdry_bands := 
				for_each_ndvs(
					banden/name
					, dmgdry
					, float32
					, "BANDS=" + string(banden/bandnr)
				) 
				, StorageName = "='NETCDF:'+Bestand+':dmgdry'"
				, StorageType     = "gdal.grid"
				, StorageReadOnly = "True";
			
			container codes
			{
				unit<uint32> bodem := union_unit_uint32(Classifications/Grondgebruik/Bodem/BOFEK_K)
				{ 
					attribute<uint32> code  := union_data(., Classifications/Grondgebruik/Bodem/BOFEK_K/EK);
					attribute<string> label := union_data(., Classifications/Grondgebruik/Bodem/BOFEK_K/label);
				}
			}

			unit<uint32> combo := range(uint32, 0, 2844)
			{
				attribute<uint32>      band       :=  id(combo) + 1;
				attribute<uint32>      klimaat    :=  id(combo)        % 2;
				attribute<uint32>      beregening := (id(combo) /  2)  % 2;
				attribute<WWL_Gewassen> gewas_rel  := value((id(combo) /  4)  % 9, WWL_Gewassen);
				attribute<codes/bodem> bodem_rel  := value(id(combo) / 36, codes/bodem);
				attribute<uint32>      gewas_code := WWL_Gewassen/code[gewas_rel];
				attribute<uint32>      bodem_code := codes/bodem/code[bodem_rel];
			}

			unit<uint32> wwl_k := range(uint32, 0, 90601)
			, Descr = "De relatiegrid van 301 bij 301 als platte reeks in rijvolgorde: element k is rij k div 301 en kolom k mod 301. Een union_data over de grid-eenheid levert de banden in de
						tegelvolgorde van de opslag en niet in rijvolgorde; perm zegt per punt waar zijn waarde in die opslagvolgorde staat, zodat de LUT de waarde bij het juiste punt legt. Zonder die
						permutatie hoorde de gestapelde waarde bij een ander punt dan de sleutel zei, en kreeg een deel van de cellen de null van de onmogelijke helft (#837)."
			{
				attribute<uint32>                   rij := id(.) / 301;
				attribute<uint32>                   kol := id(.) % 301;
				attribute<dmgtot> pnt            := point_yx(int16(rij), int16(kol), dmgtot);
				attribute<dmgtot> opgeslagen_pnt := union_data(., id(dmgtot)), Descr = "Het punt waarvan de waarde op deze positie in de opslagvolgorde staat.";
				attribute<.>      perm           := rlookup(pnt, opgeslagen_pnt), Descr = "De positie in de opslagvolgorde van het punt op deze rij-major positie.";
			}

			// alleen de 9 gewassen die in de netcdf-dimensie zitten
			unit<uint32> WWL_Gewassen := cat_range(0, 9)
			{
				attribute<uint32> code  : [1, 6, 7, 9, 12, 13, 20, 22, 23];
				attribute<string> label := Classifications/Grondgebruik/WWLKlasse/label[rlookup(code, uint32(Classifications/Grondgebruik/WWLKlasse/EK))];
				attribute<string> name  := AsItemName(label);
				attribute<string> Zoutgevoeligheid_name : ['Gras', 'Akkerbouw', 'Akkerbouw', 'Akkerbouw', 'Akkerbouw', 'Hoogwaardig', 'Hoogwaardig', 'Hoogwaardig', 'Hoogwaardig']
				, Descr = "De gewasgroep voor de grens van de zoutconcentratie van het beregeningswater (#616): gras maaien is gras; snijmais, wintertarwe, consumptieaardappel en suikerbieten zijn akkerbouw; zaai-uien, tulp, appelbomen en laanbomen zijn de hoogwaardige teelten.";
				attribute</Classifications/Landbouw/ZoutgevoeligheidK> Zoutgevoeligheid_rel := rlookup(Zoutgevoeligheid_name, /Classifications/Landbouw/ZoutgevoeligheidK/name);
				attribute<string> GeneriekeNaam  := Classifications/Grondgebruik/WWLKlasse/GeneriekeNaam[rlookup(code, uint32(Classifications/Grondgebruik/WWLKlasse/EK))];
			}				
		}

		parameter<String> Beregeningskaart_Bestand := '%RS_Lb_DataDir%/Gewassen/Beregeningskaart_Basisprognoses_2018.asc'
		, Descr = "De beregeningskaart Basisprognoses 2018, als eigen parameter om dezelfde reden als WWL_relatie_database/Bestand: de fingerprint van de dervingskaarten noemt haar.";

		attribute<uint32> Beregeningskaart_Basisprognoses_2018 (AdminDomain)
		: StorageName = "=Beregeningskaart_Bestand"
		, StorageType = "gdal.grid"
		, DialogData = "rdc_meter"
		{
			attribute<WWL_BeregeningsK> WWL_Beregenings_rel (AdminDomain) := . == 1 || . == 2 ? WWL_BeregeningsK/v/WelBeregening : WWL_BeregeningsK/v/GeenBeregening;
		}
		
		// ================================================================================================================================================================

		unit<uint8> BeregeningScenarios := cat_range(0b, 3b)
		{
			attribute<string> VariantName : ['GeenBeregening','Beregening_allepercelen_ongelim','Beregening_percelenmetinstal_ongelim'];
			attribute<string> Code        : ['A','B1','B2'];
			attribute<string> name        := Code+'_'+VariantName;
		}
		
		container BeregeningScenario_Regionaal := 
			for_each_ne(
				BeregeningScenarios/name
				, 'Read_BeregeningScenarios_T('+quote(BeregeningScenarios/name)+','+quote(BeregeningScenarios/code)+',''Regionaal'', ''drystress_1976_@SC@_gewas@GWNR@_simpel'')'
			), Descr = "Yield reduction per beregening scenario, volgens methode 'Regionaal'.";
			
		container BeregeningScenario_Lokaal_WWL
		{
			container BAU := 
				for_each_ne(
					BeregeningScenarios/name
					, 'Read_BeregeningScenarios_T('+quote(BeregeningScenarios/name)+','+quote(BeregeningScenarios/code)+',''Lokaal_WWL'', '+quote('BAU/dmgdry-Wh-2036-2065_gewas@GWNR@_Variant@SC@_droogteschade')+')'
				), Descr = "Yield reduction per beregening scenario, volgens methode 'Lokaal WWL'.";
				
			container WBS := 
				for_each_ne(
					BeregeningScenarios/name
					, 'Read_BeregeningScenarios_T('+quote(BeregeningScenarios/name)+','+quote(BeregeningScenarios/code)+',''Lokaal_WWL'', '+quote('WBS/dmgdry-Wh-2036-2065_gewas@GWNR@_Variant@SC@_droogteschade')+')'
				), Descr = "Yield reduction per beregening scenario, volgens methode 'Lokaal WWL'.";
		}
		
		Template Read_BeregeningScenarios_T
		{
			parameter<string> scenario_name;
			parameter<string> scenario_code;
			parameter<string> methode;
			parameter<string> filename0;
			//
			
			parameter<string> filename := '%RS_Lb_DataDir%/Gewassen/Opbrengstderving_Beregening_'+methode+'/'+filename0+'.tif';
			
			
			container Read := 
				for_each_ndvat(
					BeregeningsScenarioGewassen/name
					, rdc_25m
					, float32
					, replace(filename, '@GWNR@', BeregeningsScenarioGewassen/code, '@SC@', scenario_code)
					, 'tif'
				);
		}
		
		container WWL_WBS := 
			for_each_ndvat(
				WWL_GewasSoort/name
				, rdc_25m
				, float32
				, '%RS_Lb_DataDir%/Gewassen/WWL_opbrengstderving/WBS/'+WWL_GewasSoort/name+'/dmgtot-Wh-2036-2065.tif'
				, 'tif'
			);
		container WWL_BAU :=  
			for_each_ndva(
				WWL_GewasSoort/name
				, rdc_25m
				, float32
				, '%RS_Lb_DataDir%/Gewassen/WWL_opbrengstderving/BAU/'+WWL_GewasSoort/name+'/dmgtot-Wh-2036-2065.tif'
			);
	}

