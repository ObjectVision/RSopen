////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Is Deep Draining possible in this scenario? De dikte van het veenpakket is in meter en is afkomstig van het
// ondergrond bestand dat met het Atlantis model gemaakt is. Dit ondergrond bestand is voor een heel groot deel
// (excl Flevoland) gebaseerd op geotop. 0: Kleiner risico, 1: Nagenoeg gelijk risico, 2: Enig groter risico, 3:
// Matig groter risico, 4: Aanzienlijk groter risico
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container HELP
{
	attribute<Float32> DDPossible (rdc_25m) := float32(DD30_uit_droogleggingzomer_00), Descr = "Is Deep Draining possible in this scenario?"; 
	
	attribute<Bool> DD30_uit_droogleggingzomer_00 (rdc_25m)
	:	Label       = "DD30_uit_droogleggingzomer_00"
	,	Source      = "export van resultaat /BronDataSource/Phoenix/ModelResults/AnalysePeilgebieden/DroogleggingZomer_DD_deel/Nl/PINoDD/J000_ en verwerking in ArcGIS tot boolean-tif"
					  "https://pbl.sliksvn.com/ruimtescanner/PBL/SourceData/Trunk/LUMOS revison 5012"
					  "https://pbl.sliksvn.com/ruimtescanner/PBL/ProjDir/branches/PeatyMeadows_Stripped revision 5010"
					  "geodms 7177x64"
	,	url         = ""
	,	StorageName = "%RS_Lb_DataDir%/water/DD30_uit_droogleggingzomer_00.tif";

	attribute<Classifications/Landbouw/BodemKlasse14k> Bodem_HELP1 (rdc_25m):
		Label = "Soil map used to create yield reduction maps",
		Source = "WUR-4, 2010",
		StorageName = "%RS_Lb_DataDir%/landgebruik/bodem_help.tif";

	attribute<Classifications/Landbouw/BodemKlasse14k> Bodem_HELP             (rdc_25m) := MakeDefined(Bodem_HELP1, 0b), Descr = "De HELP-bodemklasse per cel, met 0 (water, verhard, geen gegevens) waar de kaart niets zegt; daardoor bevatten de afgeleiden hieronder geen nulls.";
	attribute<bool>                                    Bodem_HELP_veen        (rdc_25m) := Bodem_HELP == BodemKlasse14k/V/V_W, Descr = "Veen en moerig, de klasse V_W (label V+W): het veenweidegebied en de moerige en dalgronden in Drenthe, Overijssel en de Veenkolonien. Sinds #785 een eigen bodemtak in Dairy_T en Akkerbouw_T; daarvoor viel V_W onder Bodem_HELP_kleiig en rekende de landbouwgeschiktheid op veen met de kleikentallen.";
	attribute<bool>                                    Bodem_HELP_kleiig      (rdc_25m) := Bodem_HELP >= BodemKlasse14k/V/K1 && Bodem_HELP <= BodemKlasse14k/V/K5, Descr = "K1 tot en met K5, sinds #785 zonder V_W.";
	attribute<bool>                                    Bodem_HELP_zandig      (rdc_25m) := Bodem_HELP >= BodemKlasse14k/V/Z30 && Bodem_HELP <= BodemKlasse14k/V/Grind30, Descr = "Z30 tot en met Grind30, dus ook L (loss) en Z30 op tertiaire klei.";
	attribute</Classifications/Landbouw/Bodemtak>      Bodemtak_rel           (rdc_25m) := switch(
																							 case(Bodem_HELP_veen,   /Classifications/Landbouw/Bodemtak/V/Veen)
																							,case(Bodem_HELP_kleiig, /Classifications/Landbouw/Bodemtak/V/Klei)
																							,case(Bodem_HELP_zandig, /Classifications/Landbouw/Bodemtak/V/Zand)
																							,/Classifications/Landbouw/Bodemtak/V/Geen)
	, Descr = "De bouwplantak van Dairy_T en Akkerbouw_T per cel (#780, #785): Veen, Klei, Zand of Geen. Alle bodemafhankelijke landbouwparameters zijn attributen op Classifications/Landbouw/Bodemtak en
		worden hiermee gelezen, zodat er geen geneste switches per parameter in de sjablonen staan. Bodem_HELP is MakeDefined, dus dit item bevat geen nulls. De WWL-opbrengstderving staat op de
		BOFEK-bodemcode en niet op deze HELP-indeling, een bekend verschil (#785).";
	attribute<Bool>                                    HeeftBodem             (rdc_25m) := Bodemtak_rel != /Classifications/Landbouw/Bodemtak/V/Geen, Descr = "Onwaar op water, verhard en geen gegevens; daar zet de landbouwgeschiktheid de netto-opbrengst op nul. Een verwaarloosbaar deel van de basisjaarlandbouw.";

}
