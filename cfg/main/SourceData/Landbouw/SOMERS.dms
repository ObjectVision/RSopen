////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Is Deep Draining possible in this scenario? De dikte van het veenpakket is in meter en is afkomstig van het
// ondergrond bestand dat met het Atlantis model gemaakt is. Dit ondergrond bestand is voor een heel groot deel
// (excl Flevoland) gebaseerd op geotop. 0: Kleiner risico, 1: Nagenoeg gelijk risico, 2: Enig groter risico, 3:
// Matig groter risico, 4: Aanzienlijk groter risico
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container SOMERS 
{
	unit<UInt32> Datasheet
	: StorageName = "%ProjDir%/Data/SOMERS/SOMERS 2.0 Datasheet.csv"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "TRUE"
	{ 
		attribute<BodemK>                 BodemK_rel                 := rlookup(lowercase(BodemType), lowercase(BodemK/Label));
		attribute<PerceelsbreedteK>       PerceelsbreedteK_rel       := rlookup(lowercase(Perceelsbreedte_m_), lowercase(PerceelsbreedteK/values));
		attribute<WinterdroogleggingK>    WinterdroogleggingK_rel    := rlookup(lowercase(Winterdrooglegging_m_tov_zomerdrooglegging_), lowercase(WinterdroogleggingK/values));
		attribute<ZomerdroogleggingK>     ZomerdroogleggingK_rel     := rlookup(lowercase(Zomerdrooglegging_m_mv_), lowercase(ZomerdroogleggingK/values));
		attribute<WeerregioK>             WeerregioK_rel             := rlookup(lowercase(Weerregio), lowercase(WeerregioK/values));
		attribute<KwelsituatieK>          KwelsituatieK_rel          := rlookup(lowercase(Kwelsituatie_mm_d_), lowercase(KwelsituatieK/values));
		attribute<InfiltratieMaatregelK>  InfiltratieMaatregelK_rel  := rlookup(lowercase(InfiltratieMaatregel), lowercase(InfiltratieMaatregelK/values));
		
		attribute<BasiscombinatieK>       BasiscombinatieK_rel       := rlookup(uint32(Basiscombinatie), BasiscombinatieK/values);

		attribute<CombinatieTabel>        CombinatieTabel_rel        := combine_Data(CombinatieTabel, BasiscombinatieK_rel, InfiltratieMaatregelK_rel, WinterdroogleggingK_rel, ZomerdroogleggingK_rel);
		attribute<BasiscombinatieXMaatregelK> BasiscombinatieXMaatregelK_rel := combine_Data(BasiscombinatieXMaatregelK, BasiscombinatieK_rel, InfiltratieMaatregelK_rel);
	}
	
	unit<UInt32> Peilvakken 
	: StorageName = "%RS_Lb_DataDir%/Water/Peilvakken_mv_drooglegging.shp"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "TRUE"
	, DialogData = "rdc_meter"
	{
		attribute<float32>                      dlz_med_clean                  := float32(dlz_med) < -500f ? null_f : float32(dlz_med);
		attribute<float32>                      dlw_med_clean                  := float32(dlw_med) < -500f ? null_f : float32(dlw_med);

		attribute<float32>                      drooglegging_zomer             := -dlz_med_clean, Descr = "zomerdrooglegging obv mediane maaiveldniveau";
		attribute<float32>                      drooglegging_winter            := -dlw_med_clean, Descr = "winterdrooglegging obv mediane maaiveldniveau";
		attribute<float32>                      winter_tov_zomer               := drooglegging_zomer - drooglegging_winter;

		// Issue #619: Classify geeft null voor waarden onder de laagste klassegrens. Zonder ondergrens viel een peilvak dat natter
		// is dan de natste SOMERS-rekenregel volledig uit de lookup (null in combine_Data maakt de hele combinatie null), en dus
		// uit de emissiekaart. Begrenzen op de laagste klassegrens kent zo'n peilvak de natste rekenregel toe in plaats van geen.
		// De grenzen worden uit de klassificatie afgeleid, zodat ze meebewegen als de SOMERS-datasheet wordt uitgebreid.
		parameter<float32>                      ZomerdroogleggingK_LaagsteLB   := min(ZomerdroogleggingK/ClassBreaks);
		parameter<float32>                      WinterdroogleggingK_LaagsteLB  := min(WinterdroogleggingK/ClassBreaks);

		// De IsDefined-guard houdt peilvakken zonder droogleggingsdata expliciet null; die worden in SOMERS_CO2_T opgevangen
		// door de variant-fallback. Zonder guard zouden ze hier stilzwijgend de natste klasse krijgen.
		attribute<float32>                      drooglegging_zomer_begrensd     := IsDefined(drooglegging_zomer) ? max_elem(drooglegging_zomer, ZomerdroogleggingK_LaagsteLB)  : null_f;
		attribute<float32>                      winter_tov_zomer_begrensd       := IsDefined(winter_tov_zomer)   ? max_elem(winter_tov_zomer,   WinterdroogleggingK_LaagsteLB) : null_f;

		attribute<ZomerdroogleggingK>           ZomerdroogleggingK_rel         := Classify(drooglegging_zomer_begrensd, ZomerdroogleggingK/ClassBreaks);
		attribute<WinterdroogleggingK>          WinterdroogleggingK_rel        := Classify(winter_tov_zomer_begrensd, WinterdroogleggingK/ClassBreaks);
	}

	unit<UInt32> InfiltratieMaatregelK := unique(Datasheet/InfiltratieMaatregel)
	{
		attribute<String> name := AsItemName(values);
		attribute<String> Label := name;
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	unit<UInt32> KwelsituatieK := unique(Datasheet/Kwelsituatie_mm_d_)
	{
		attribute<String> name := AsItemName(replace(values, '<', 'lt', '>', 'gt', ' - ', '_','-0','min0'));
		attribute<String> Label := name;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		// Issue #619: de laagste klasse had null_f als ondergrens. Classify slaat een undefined klassegrens over, waardoor elk
		// perceel met wegzijging sterker dan 0.8 mm/d geen kwelklasse kreeg en daarmee uit de emissiekaart viel, in alle
		// varianten. De ondergrens is nu een echt getal, ruim onder elke voorkomende kwelwaarde.
		attribute<Float32> LB := switch(
									 case(values == '< -0.8 mm/d', -1000000f)
									,case(values == '-0.8 - -0.3 mm/d', -0.8f)
									,case(values == '-0.3 - 0.3 mm/d', -0.3f)
									,case(values == '0.3 - 0.8 mm/d', 0.3f)
									,case(values == '> 0.8 mm/d', 0.8f)
									, null_f);
		attribute<Float32> ClassBreaks := LB, DialogType = "Classification";
	}
	
	unit<UInt32> WeerregioK := unique(Datasheet/Weerregio)
	{
		attribute<String> name      := AsItemName(values);
		attribute<String> name_engl := replace(name, 'Zuidwest', 'southwest', 'Noordoost', 'northeast');
		attribute<String> Label := name;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt32> ZomerdroogleggingK := unique(Datasheet/Zomerdrooglegging_m_mv_)
	{
		attribute<String> name := AsItemName(replace(values, ' - ', '_','-0','min0'));
		attribute<String> Label := name;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);

		attribute<Float32> LB          := float32(values);
		attribute<Float32> ClassBreaks := LB, DialogType = "Classification";
	}
	
	unit<UInt32> WinterdroogleggingK := unique(Datasheet/Winterdrooglegging_m_tov_zomerdrooglegging_)
	{
		attribute<String> name := AsItemName(replace(values, ' - ', '_','-0','min0'));
		attribute<String> Label := name;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);

		attribute<Float32> LB          := float32(values);
		attribute<Float32> ClassBreaks := LB, DialogType = "Classification";
	}
	
	unit<UInt32> PerceelsbreedteK := unique(Datasheet/Perceelsbreedte_m_)
	{
		attribute<String> name := AsItemName(replace(values, ' - ', '_','-0','min0'));
		attribute<String> Label := name;
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		
		attribute<Float32> LB := switch(
									 case(values == '0-30', 0f)
									,case(values == '30-50', 30f)
									,case(values == '50-75', 50f)
									,case(values == '75-140', 75f)
									,case(values == '140-200', 140f)
									, null_f);
		attribute<Float32> ClassBreaks := LB, DialogType = "Classification";
	}
	
	unit<UInt32> BodemK := BodemkaartKlasse
	{
		attribute<String> name := AsItemName(Label);
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	// Issue #619: de datasheet kent 290 basiscombinaties van bodemtype, perceelsbreedte, kwel en weerregio. Die dekken 95% van
	// het areaal; de overige 5% is door Deltares zelf aan een van die 290 toegewezen, in volgorde van de minst invloedrijke
	// parameter (weerregio) naar de meest invloedrijke (perceelsbreedte). Die toewijzing staat per perceel in de kolom
	// Basiscomb. Door daarop te koppelen in plaats van de vier kenmerken zelf opnieuw te klassificeren, krijgt elk perceel de
	// rekenregel die Deltares ervoor bedoeld heeft, en is er geen eigen substituut of gemiddelde meer nodig.
	unit<UInt32> BasiscombinatieK := unique(uint32(Datasheet/Basiscombinatie))
	{
		attribute<String> name  := 'Basiscombinatie_'+string(values);
		attribute<String> Label := name;
	}

	unit<UInt32> CombinatieTabel := combine(BasiscombinatieK, InfiltratieMaatregelK, WinterdroogleggingK, ZomerdroogleggingK);

	// #619: voor 86 van de 290 basiscombinaties bevat de datasheet geen enkele rekenregel met een infiltratiemaatregel. Dat zijn
	// precies de vijf moerige bodemtypen vWz, Wo, zWp, kWp en iWp; de 204 met AWIS en PWIS zijn de veengronden. Deze eenheid legt
	// per combinatie van basiscombinatie en maatregel vast of de datasheet er rekenregels voor heeft, los van de drooglegging.
	unit<UInt32> BasiscombinatieXMaatregelK := combine(BasiscombinatieK, InfiltratieMaatregelK)
	{
		attribute<UInt32> NrRegels        := sum(const(1u, Datasheet), Datasheet/BasiscombinatieXMaatregelK_rel);
		attribute<Bool>   HeeftRekenregel := MakeDefined(NrRegels, 0u) > 0u;
	}
	
	unit<UInt32> Veenweide_percelen 
	: StorageName = "%RS_Lb_DataDir%/SOMERS/parcels_rekenregels_nobv_website.shp"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "TRUE"
	, DialogData = "rdc_meter"
	{
		// Issue #619: de basiscombinatie komt uit de brondata zelf en wordt niet meer afgeleid uit bodem, breedte, kwel en
		// weerregio. Voor 11.346 percelen (Koppeling = indirect) heeft Deltares een naburige combinatie toegewezen omdat de
		// eigen combinatie te weinig meetdata had; die toewijzing volgen we nu in plaats van hem zelf over te doen.
		attribute<BasiscombinatieK>        BasiscombinatieK_rel      := rlookup(uint32(Basiscomb), BasiscombinatieK/values);
		attribute<Bool>                    IsIndirectGekoppeld       := lowercase(Koppeling) == 'indirect';


		attribute<ZomerdroogleggingK>      ZomerdroogleggingK_rel    := Peilvakken/ZomerdroogleggingK_rel[Peilvakken_rel];
		attribute<WinterdroogleggingK>     WinterdroogleggingK_rel   := Peilvakken/WinterdroogleggingK_rel[Peilvakken_rel];


		attribute<Peilvakken>              Peilvakken_rel                := point_in_polygon(centroid_or_mid(geometry), Peilvakken/geometry);
		attribute<.>                       AdminDomain_rel (AdminDomain) := poly2grid(geometry, AdminDomain);
	}
}
