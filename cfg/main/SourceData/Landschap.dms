container Landschap : using = "Classifications"
{
	unit<UInt32> BasiskaartNatuurlijkSysteemNederland
	:	StorageName     = "%RSo_DataDir%/Omgeving/BasiskaartNatuurlijkSysteem/Basiskaart Natuurlijk Systeem Nederland Hoofdklasse.gpkg"
	, 	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogData      = "rdc_meter"
	,	Source          = "email met download-links Stichting CAS 20250908 Creative Commons licentie (CC BY 4.0)"
						  "https://www.klimaateffectatlas.nl/nl/data-opvragen"
						  "https://www.klimaateffectatlas.nl/nl/kaartviewer --> GebiedsKenmerken --> Basiskaart natuurlijk systeem hoofdtypen"
	,	URL             = "https://www.klimaateffectatlas.nl/nl/basiskaart-natuurlijk-systeem-nederland"
	//,	sqlstring       = "SELECT * FROM 'Basiskaart Natuurlijk Systeem Nederland Hoofdklasse' WHERE gridcode = 5000"//quoten bij spaties in laagnaam
	{
		attribute<BasiskaartNatuurlijkSysteemNederlandK> gridcode_rel := rlookup(uint32(gridcode), BasiskaartNatuurlijkSysteemNederlandK/code);
	}
	
	attribute<UInt16> Huidig_GO_BNS_reclass_ZWD (AdminDomain)
	:	StorageName     = "%RSo_DataDir%/Omgeving/BasiskaartNatuurlijkSysteem/Huidig_GO_BNS_reclass_ZWD.tif"
	, 	StorageType     = "gdal.grid"
	,	StorageReadOnly = "True"
	,	DialogData      = "rdc_meter"
	,	Source          = "X:\\User\\bouwmana\\AGP\\RV_Gebiedstypen\\aggregated_gebiedstypen.gdb Arno Bouwman PBL 20250908 aggregated_gebiedstypen.gdb:" 
						  "conversie Huidig_GO_BNS_reclass_ZWD naar tif in ArcMap 10.8.1 Export Data, tif, LZW"
	{
		attribute<Landschap/Huidig_GO_BNS_reclass_ZWD> gridcode_rel (AdminDomain) := rlookup(., Landschap/Huidig_GO_BNS_reclass_ZWD/code);
	}
	
	unit<uint8> BasiskaartNatuurlijkSysteemNederlandK := Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK
	{
		attribute<rdc_meter>   geometry                    (poly) := geos_union_polygon(BasiskaartNatuurlijkSysteemNederland/geometry, BasiskaartNatuurlijkSysteemNederland/gridcode_rel);
		attribute<.>           BNSN_rel                           := id(.);
		attribute<string>      name                               := Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/name;

		attribute<.>           per_AdminDomain      (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<.>           per_AllocDomain      (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<.>           BNSN_rel_AdminDomain (AdminDomain) := id(.)[per_AdminDomain];
		attribute<.>           BNSN_rel_AllocDomain (AllocDomain) := id(.)[per_AllocDomain];
	}

	unit<UInt32> LandschapsRegio : NrOfRows = 5
	, Descr = "De landsdekkende, niet-overlappende regio-indeling voor de landschappen uit #705: kust, rivieren, veen, zand en overig.
				Deze versie volgt de reactie vanuit Deltares van 31 augustus 2026. Daarin is de opzet omgedraaid: de
				regio's worden niet meer door de fysische kaart bepaald met de leveringen als correctie, maar door de
				gebieden van de vier landschapsteams zelf, met de fysische kaart hooguit als vulling. Wat buiten alle
				vier valt is Overig, en dat is bewust een grote klasse geworden.
				De schakelaars staan op de gekozen lezing; ze blijven bestaan om het alternatief te kunnen meten en niet
				omdat de keuze nog open is. Basis_ref bepaalt of de fysische kaart nog meedoet, ZandBegrenzing_ref en
				VeenBegrenzing_ref welk item de buitengrens van die twee landschappen is. De afweging per schakelaar
				staat in zijn eigen Descr. VeenGaatVoorZand is de enige die bewust open blijft: de reactie vraagt daar
				expliciet twee kaarten van, zodat de projectgroep kan kiezen.
				De vereenvoudiging is de vertaling van het verzoek om de grenzen niet strak om de grillige
				leveringspolygonen te leggen maar door de oogharen te tekenen. Zie Vereenvoudiging_Straal_m.
				De indeling staat los van de variant: de leveringen tellen als gebiedsafbakening mee ongeacht welke
				variant draait, zodat alle varianten in dezelfde tabelregels optellen. Diagnose705 meet de arealen;
				dit is een van de opties van ModelParameters/Advanced/IndicatorRegio_ref."
	{
		attribute<String> label      : ['Kust','Rivieren','Veen','Zand','Overig'];
		attribute<String> name       := AsItemName(label);
		attribute<UInt32> BrushColor : [rgb(249,225,19), rgb(65,105,242), rgb(148,227,54), rgb(205,137,102), rgb(200,200,200)];

		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);

		// ---------------- schakelaars ----------------

		parameter<String> Basis_ref := 'Leveringen'
		, Descr = "Bepalen de teamgebieden de regio's, of vult de fysische kaart aan waar geen team levert?

					Leveringen: alleen de teamgebieden, al het overige is Overig. Dit is de lezing van de reactie, die
					elk landschap aan de buitenkant op een geleverd item begrenst en er expliciet bij zegt dat Overig
					daarmee aanzienlijk groter wordt, vooral klei maar ook zand op het land bij de kust.

					FysischPlusLeveringen: het gedrag van voor deze herziening, waarbij het gebiedstypenraster
					Huidig_GO_BNS_reclass_ZWD de basis legt en de teamgebieden daar overheen komen. Staat er nog in om
					de twee kaarten tegen elkaar te kunnen zetten; Diagnose705 meet ze allebei.";

		parameter<String> ZandBegrenzing_ref := 'Levering'
		, Descr = "Welk item is de buitengrens van het zandlandschap?

					Levering, de gekozen stand: Bron/Zand_NbSGenuanceerd/Beekdalherstel, de beekdal- en droogdallevering
					van #630, samen 220.746 ha verspreide dalpolygonen. Dit is het item dat de reactie noemt, via het
					pad Varianten/NbSGenuanceerd/Landschap/Zand/IsGebied.

					Dat leek eerst in tegenspraak met de rest van die reactie, want losse dalpolygonen zijn geen
					landschap en zouden de rivieren juist meer ruimte geven in plaats van minder. Met de vereenvoudiging
					erbij klopt het wel, en dan klopt het precies. De dalen liggen verspreid over de hele hoge
					zandgronden, dus zodra de grenzen door de oogharen worden getrokken lopen ze in elkaar over tot een
					aaneengesloten zandlandschap. De hoogveenkoppen daartussen worden dan als enclave opgeslokt, en dat
					is exact wat de reactie voorspelt en accepteert. Bij welke straal dat omslaat is een kaartvraag; de
					reeks in Diagnose705 laat het zien.

					Landschapsbegrenzing: RegioIndelingen/Landschappen/Zandgebied, de grove omhullende van ruim 3
					miljoen ha. Afgevallen, want die beslaat bijna heel Nederland en zou na kust en veen alsnog alles
					opslokken wat volgens de reactie juist Overig moet worden. Staat er nog in om het verschil te kunnen
					laten zien.";

		parameter<String> VeenBegrenzing_ref := 'AlleenPeilvakken'
		, Descr = "Welk item is de buitengrens van het veenlandschap?

					AlleenPeilvakken, de gekozen stand: Bron/Veen_NbSGenuanceerd/Bron_PerPeilvak, het item dat de
					reactie noemt. De veenlevering bestaat uit twee lagen, en dat de reactie er een van aanwijst is hier
					geen vergissing maar de juiste keuze voor een landschapskaart. De laag zonder peilvak dekt de
					deelgebieden 3.1 en 3.2, Veluwe en Utrechtse Heuvelrug; dat is hoge zandgrond zonder polderpeil, en
					die hoort in deze indeling bij zand en niet bij veen. De peilvakkenlaag is juist het veen dat door
					een peilbeheer wordt bepaald.

					BeideLagen: met Bron_ZonderPeilvak erbij, zoals de rest van het model de levering leest. Natuur.dms
					neemt IsVeengebied als de vereniging van beide en de claimregio-unit Peilvak zet ze in een
					union_unit. Voor de allocatie is dat juist, want daar gaat het om waar de opgave landt; voor de
					landschapsindeling zou het de heuvelrug bij veen leggen. Staat er nog in om het verschil te meten.

					Stedelijk gebied binnen de veengrens telt hoe dan ook als veen, conform de reactie. Dat gaat vanzelf
					goed, want de leveringspolygonen dekken de bebouwing binnen hun grens gewoon mee.";

		parameter<Bool> ZandVultUitBNSN := TRUE
		, Descr = "Vult het zandlandschap zich aan met vier hoofdklassen uit de Basiskaart Natuurlijk Systeem: Stuwwallen, Kleileemgebied, Dekzandgebied en Voormalige hoogvenen?

					Op verzoek vanuit Deltares bij #705. De beekdallevering begrenst het zandlandschap, maar op droge kernen liggen geen beekdalen; het hart van de Veluwe bleef daardoor Overig, ook op een straal van vijf kilometer. Meer straal loste dat niet op, want daar valt niets uit te smeren. Deze vier klassen leveren het materiaal om die enclaves te vullen.

					De vier zijn genoemd in de reactie; welke klassen het precies zijn staat als IsZandvulling in Classifications/Landschap. Let op dat dit niet alleen enclaves vult maar ook de rand van het zandgebied verruimt, want de klassen houden bij de landsgrens niet op. Diagnose705 meet hoeveel er in totaal bijkomt, zodat te zien is of die verruiming acceptabel is.

					De volgorde blijft gelden: waar kust of veen al een gebied claimen winnen die, want zand komt daarna.";

		parameter<Bool> VeenGaatVoorZand := TRUE
		, Descr = "Wie wint waar het veen- en het zandgebied elkaar overlappen? Op TRUE veen, op FALSE zand. De reactie vraagt hier expliciet twee versies van, zodat de projectgroep kan kiezen; dit is die schakelaar. In de indeling van voor deze herziening ging het om 224.861 ha.";

		parameter<Bool> Vereenvoudigen := TRUE
		, Descr = "Staat de vereenvoudiging aan? Op FALSE liggen de grenzen exact op de leveringspolygonen, op de 25 meter van het AdminDomain.";

		parameter<UInt32> Vereenvoudiging_Straal_m := /ModelParameters/Advanced/Landschap_Vereenvoudiging_Straal_m
		, Descr = "De waarde staat in ModelParameters/Advanced; hier staat wat hij doet. De straal in meters waarmee de grenzen door de oogharen worden getekend. De reactie vraagt om grenzen die niet strak om de grillige leveringspolygonen liggen, en staat toe kleine enclaves en exclaves aan het omliggende landschap toe te kennen.

					Hoe het werkt: per cel wordt van elk van de vier landschappen het aandeel binnen deze straal bepaald, en de cel gaat naar het landschap met het hoogste aandeel, mits dat boven Vereenvoudiging_Drempel ligt. Met een grotere straal lopen verspreide leveringspolygonen in elkaar over tot een aaneengesloten landschap en verdwijnen enclaves; met straal nul blijft de kaart op de leveringen zelf liggen, alleen op 100 in plaats van 25 meter.

					Toegestane waarden zijn de stralen uit Geography/Matrix: 0, 17, 25, 50, 100, 150, 200, 250, 300, 400, 500, 600, 625, 700, 1000, 1250, 1500, 2000, 2250, 2500, 3250, 5000 en verder. Een reeks van tien oplopende varianten, zoals de reactie vraagt, is bijvoorbeeld 0, 250, 500, 700, 1000, 1500, 2000, 2500, 3250 en 5000. Diagnose705 draait die reeks en zet de arealen naast elkaar.

					De berekening staat op 100 meter en niet op 25, omdat een straal van een kilometer op 25 meter een kern van 81 bij 81 cellen over negen miljoen cellen vraagt. Dat is dezelfde afweging als bij de afstandsringen rond het Natuurnetwerk in Natuur.dms.";

		parameter<Float32> Vereenvoudiging_Drempel := /ModelParameters/Advanced/Landschap_Vereenvoudiging_Drempel
		, Descr = "De waarde staat in ModelParameters/Advanced. Hoeveel van de omgeving moet minstens bij een landschap horen voordat de cel dat landschap krijgt. Onder deze drempel wordt de cel Overig. Op nul zou elk landschap zich over de volle straal uitsmeren, ook waar maar een enkele polygoon ligt.";

		// ---------------- de bouwstenen ----------------

		container Impl
		: Descr = "De bouwstenen van de toedeling. De Grens-vlaggen mogen elkaar overlappen; de prioriteitsvolgorde in Ruw hakt de knoop door."
		{
			container BronKust := /SourceData/Grondgebruik/Natuur/Bron/Kust_NbSGenuanceerd;
			container BronRiv  := /SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd;
			container BronVeen := /SourceData/Grondgebruik/Natuur/Bron/Veen_NbSGenuanceerd;
			container BronZand := /SourceData/Grondgebruik/Natuur/Bron/Zand_NbSGenuanceerd;

			// -- buitengrenzen per landschap, zoals gevraagd in de reactie --

			attribute<Bool> Grens_Kust (AdminDomain) :=
				   IsDefined(BronKust/Duinen/Per_AdminDomain)
				|| IsDefined(BronKust/Wadden/Per_AdminDomain)
				|| IsDefined(BronKust/ZWD/Per_AdminDomain)
			, Descr = "De drie kustleveringen van #654, samen 50.388 ha. Alleen het bereik telt, dus de volgorde waarin poly2grid de polygonen afloopt doet er hier niet toe.";

			attribute<Bool> Grens_Rivieren (AdminDomain) :=
				   IsDefined(poly2grid(BronRiv/Levering/gebied/geometry, AdminDomain))
				|| IsDefined(BronRiv/DijkenBehouden/Per_AdminDomain)
			, Descr = "De ecotopenlevering van #621 plus de behouden dijken van #620, samen 88.480 ha. Dit is de begrenzing waar de reactie om vraagt: het rivierengebied liep in het westen veel verder dan de levering.";

			attribute<Bool> Grens_Veen (AdminDomain) := = VeenBegrenzing_ref == 'AlleenPeilvakken'
				? 'IsDefined(poly2grid(BronVeen/Bron_PerPeilvak/gebied/geometry, AdminDomain))'
				: 'IsDefined(poly2grid(BronVeen/Bron_PerPeilvak/gebied/geometry, AdminDomain)) || IsDefined(poly2grid(BronVeen/Bron_ZonderPeilvak/gebied/geometry, AdminDomain))'
			, Descr = "De veenlevering, met of zonder de tweede laag; zie VeenBegrenzing_ref.";

			attribute<Bool> Grens_Zand_Levering (AdminDomain) := = ZandBegrenzing_ref == 'Levering'
				? 'IsDefined(BronZand/Beekdalherstel/Per_AdminDomain)'
				: '/SourceData/RegioIndelingen/Landschappen/Zandgebied/IsGebied'
			, Descr = "De zandbegrenzing zoals die uit de aanlevering volgt, de dalenlevering of de landschapsomhullende; zie ZandBegrenzing_ref.";

			attribute<Bool> Grens_Zand_Vulling (AdminDomain) := MakeDefined(Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/IsZandvulling[BasiskaartNatuurlijkSysteemNederlandK/per_AdminDomain], FALSE)
			, Descr = "De vier aanvullende hoofdklassen uit de Basiskaart Natuurlijk Systeem; zie ZandVultUitBNSN. Buiten de basiskaart FALSE, zodat een cel zonder klasse niet stil zand wordt.";

			attribute<Bool> Grens_Zand (AdminDomain) := = ZandVultUitBNSN ? 'Grens_Zand_Levering || Grens_Zand_Vulling' : 'Grens_Zand_Levering'
			, Descr = "De buitengrens van het zandlandschap: de aanlevering, eventueel aangevuld met de vier hoofdklassen.";

			// -- de fysische kaart, alleen in gebruik als Basis_ref daarom vraagt --

			attribute<..> Regio_perGebiedstype (Classifications/Landschap/Huidig_GO_BNS_reclass_ZWD) := rlookup(Classifications/Landschap/Huidig_GO_BNS_reclass_ZWD/LandschapsRegio_name, ../name);
			attribute<..> Regio_perBNSN        (Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK) := rlookup(Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/LandschapsRegio_name, ../name);

			attribute<..> Basis_Gebiedstype (AdminDomain) := Regio_perGebiedstype[Huidig_GO_BNS_reclass_ZWD/gridcode_rel];
			attribute<..> Basis_BNSN        (AdminDomain) := Regio_perBNSN[BasiskaartNatuurlijkSysteemNederlandK/per_AdminDomain];
			attribute<..> Basis             (AdminDomain) := = Basis_ref == 'Leveringen'
				? 'const(null_u, AdminDomain, ..)'
				: 'MakeDefined(Basis_Gebiedstype, Basis_BNSN)'
			, Descr = "De fysische vulling onder de teamgebieden. Overal leeg in de leveringslezing, want daar bepalen de teamgebieden alles.";

			// -- groot water en het indelingsgebied --

			attribute<Bool> IsGrootWater (AdminDomain) := MakeDefined(/BaseData/StartState/Grondgebruik/Per_AdminDomain/IsGrootWater, TRUE)
			, Descr = "Groot water volgens de CBS-kaart. Buiten die kaart geldt de cel ook als groot water, zodat een randcel zonder klasse niet stil als Overig meetelt.";

			attribute<Bool> IsIndelingsgebied (AdminDomain) := (AdminDomain/IsCompactedDomain && !IsGrootWater) || Grens_Kust || Grens_Rivieren || Grens_Veen || Grens_Zand
			, Descr = "Waar de indeling een regio geeft: heel Nederland behalve de grote wateren, plus de cellen daarbuiten waar een team iets doet, zoals de buitendijkse stroken langs de Westerschelde.";

			// -- de ruwe toedeling, met de volgorde uit de reactie --

			attribute<Bool> Is_Kust     (AdminDomain) := Grens_Kust     || Basis == V/Kust;
			attribute<Bool> Is_Rivieren (AdminDomain) := Grens_Rivieren || Basis == V/Rivieren;
			attribute<Bool> Is_Veen     (AdminDomain) := Grens_Veen     || Basis == V/Veen;
			attribute<Bool> Is_Zand     (AdminDomain) := Grens_Zand     || Basis == V/Zand;

			attribute<..> Ruw (AdminDomain) := = VeenGaatVoorZand
				? 'switch(case(Is_Kust, V/Kust), case(Is_Veen, V/Veen), case(Is_Zand, V/Zand), case(Is_Rivieren, V/Rivieren), null_u[..])'
				: 'switch(case(Is_Kust, V/Kust), case(Is_Zand, V/Zand), case(Is_Veen, V/Veen), case(Is_Rivieren, V/Rivieren), null_u[..])'
			, Descr = "De toedeling voor de vereenvoudiging, met de volgorde uit de reactie: kust eerst, dan veen en zand in de volgorde die VeenGaatVoorZand kiest, en rivieren als laatste. Rivieren staat achteraan omdat de reactie zowel veen als zand voorrang geeft. Null waar geen enkel landschap iets claimt; dat wordt Overig.";

			// -- de vereenvoudiging, op 100 meter --

			parameter<String> KernelPad := '/Geography/Distmatrices_100m/pot'+string(Vereenvoudiging_Straal_m)+'m';

			attribute<Float32> Aandeel_Kust_100m     (rdc_100m) := sum(float32(Ruw == V/Kust),     AdminDomain/rdc_100m_rel) / 16f;
			attribute<Float32> Aandeel_Rivieren_100m (rdc_100m) := sum(float32(Ruw == V/Rivieren), AdminDomain/rdc_100m_rel) / 16f;
			attribute<Float32> Aandeel_Veen_100m     (rdc_100m) := sum(float32(Ruw == V/Veen),     AdminDomain/rdc_100m_rel) / 16f;
			attribute<Float32> Aandeel_Zand_100m     (rdc_100m) := sum(float32(Ruw == V/Zand),     AdminDomain/rdc_100m_rel) / 16f;

			attribute<Float32> Glad_Kust     (rdc_100m) := ='potential(Aandeel_Kust_100m, '    +KernelPad+'/Flat2) / '+KernelPad+'/oppervlakte';
			attribute<Float32> Glad_Rivieren (rdc_100m) := ='potential(Aandeel_Rivieren_100m, '+KernelPad+'/Flat2) / '+KernelPad+'/oppervlakte';
			attribute<Float32> Glad_Veen     (rdc_100m) := ='potential(Aandeel_Veen_100m, '    +KernelPad+'/Flat2) / '+KernelPad+'/oppervlakte';
			attribute<Float32> Glad_Zand     (rdc_100m) := ='potential(Aandeel_Zand_100m, '    +KernelPad+'/Flat2) / '+KernelPad+'/oppervlakte';

			attribute<Float32> Glad_Max (rdc_100m) := max_elem(Glad_Kust, Glad_Rivieren, Glad_Veen, Glad_Zand);

			attribute<..> Vereenvoudigd_100m (rdc_100m) := = VeenGaatVoorZand
				? 'Glad_Max < Vereenvoudiging_Drempel ? null_u[..] : Glad_Kust == Glad_Max ? V/Kust : Glad_Veen == Glad_Max ? V/Veen : Glad_Zand == Glad_Max ? V/Zand : V/Rivieren'
				: 'Glad_Max < Vereenvoudiging_Drempel ? null_u[..] : Glad_Kust == Glad_Max ? V/Kust : Glad_Zand == Glad_Max ? V/Zand : Glad_Veen == Glad_Max ? V/Veen : V/Rivieren'
			, Descr = "Het landschap met het hoogste aandeel in de omgeving, mits dat boven de drempel ligt. Bij een gelijke stand wint dezelfde volgorde als in Ruw.";

			attribute<..> Vereenvoudigd (AdminDomain) := Vereenvoudigd_100m[AdminDomain/rdc_100m_rel];

			attribute<..> Toegedeeld (AdminDomain) := = Vereenvoudigen ? 'Vereenvoudigd' : 'Ruw';
		}

		attribute<.> Per_AdminDomain (AdminDomain) := Impl/IsIndelingsgebied ? MakeDefined(Impl/Toegedeeld, V/Overig) : null_u[.]
		, Descr = "De regio van de cel. Binnen het indelingsgebied altijd gevuld: wat geen landschap claimt wordt Overig. Null op de grote wateren zonder ingreep en buiten Nederland.";

		attribute<.> Per_AdminDomain_Fijn     (AdminDomain)          := Per_AdminDomain
		, Descr = "De naam die de indicatorensjablonen sinds #748 lezen. Deze indeling rekent al op AdminDomain, dus hij is gelijk aan Per_AdminDomain hierboven en er gaat bij het aggregeren geen resolutie verloren.

					Wel telt hij 15.394,56 hectare studiegebied niet mee, en dat is hier bewust: de grote wateren zonder ingreep vallen buiten het indelingsgebied. Wie een landelijk totaal uit een tabel op deze indeling leest, leest dus Nederland zonder die wateren.";

		attribute<.> Per_AllocDomain          (AllocDomain)          := modus(Per_AdminDomain, AdminDomain/AllocDomain_rel)
		, Descr = "Meest voorkomende regio van de onderliggende cellen. Met modus en niet met een eigen poly2grid, want deze indeling heeft geen vectorgeometrie.";
		attribute<.> Per_CompactedAdminDomain (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain);
		attribute<.> Per_CompactedAllocDomain (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Per_AllocDomain);
	}

	container Landschapsgebieden
	: Descr = "De vier landschapsgebieden zoals de landschapsteams ze zelf aanleveren, voor de export van de indicatoren (#760).

				Dit vervangt LandschapsRegio hierboven als rapportage-indeling. Het verschil is fundamenteel: LandschapsRegio
				is een partitie, elke cel hoort bij precies een landschap. Deze gebieden overlappen elkaar wel, en dat is
				volgens #760 geen bezwaar zolang er niet over de regio's wordt opgeteld. De reden om ze toch aan te houden
				is dat de teams hun eigen berekeningen op deze grenzen hebben geaggregeerd en het model daarop moet aansluiten.

				Gemeten overlap: kust met veen 172.453 ha, zand met veen 134.420 ha, kust met zand 113.651 ha en rivieren
				met veen 84.797 ha. De vier tellen samen op tot 4.589.095 ha terwijl hun vereniging 4.136.268 ha is. Kust
				loopt bovendien tot ver op zee.

				Daarom staat elk landschap hier als een eigen eenheid van een regel met alleen een masker, en niet als een
				klasse in een gedeelde indeling. Zo kan de indicatorentabel per landschap worden uitgedraaid met precies
				dezelfde machinerie als voor Nederland, en is optellen over de landschappen per constructie onmogelijk.
				Kiezen doe je met ModelParameters/Advanced/IndicatorRegio_ref; zie de opties Landschap_Kust en verder."
	{
		parameter<ha> Veen_GatenDrempel := 10[ha]
		, Descr = "Tot welke omvang een gat in de veenbegrenzing wordt dichtgelegd.

					De veenlevering is de peilvakkenlaag geknipt op de deelgebieden, en die heeft 2.459 gaten, samen 30.238 ha
					oftewel 8,5 procent van het gebied. De aanleverende partij noemt die gaatjes zelf en stelt voor ze in de
					RuimteScanner op te lossen. Blind alles dichten is te grof: er zitten echte uitsparingen tussen tot 3.072 ha,
					en 74 gaten zijn groter dan 50 ha.

					Op 10 ha worden 2.150 van de 2.459 gaten gedicht en komt er 4.714 ha bij, 1,3 procent. Dat haalt de slivers
					tussen aangrenzende peilvakken weg en laat de echte uitsparingen, zoals steden en plassen, open. Op 0 blijft
					de levering zoals hij is; alles dichten kan met een zeer hoge waarde.";

		container Bron
		: Descr = "De vier aangeleverde begrenzingen. Zand wijst naar het bestand dat al op de share stond: de levering van #760 is daar geometrisch identiek aan, tot op de hectare en zelfs dezelfde bestandsgrootte, dus een tweede kopie zou alleen maar uit elkaar kunnen gaan lopen."
		{
			unit<uint32> Kust
			:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Landschap_Kust_20260903.shp"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "True"
			,	DialogType      = "Map"
			,	DialogData      = "geometry"
			,	Source          = "Deltares, kernteam NL2120. Oorspronkelijke bestandsnaam Begrenzing kustgebied.shp, geleverd op 2026-09-03 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Synthese RuimteScanner."
			,	Descr           = "Een polygoon van 1.836.437 ha. Loopt van x 5.255 tot 291.064 en beslaat dus de Noordzee en de Waddenzee mee; het is een begrenzing van het kustsysteem en niet van de kustzone op land."
			{
				attribute<rdc_meter> geometry (poly);
			}

			unit<uint32> Rivieren
			:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Landschap_Rivieren_20260903.shp"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "True"
			,	DialogType      = "Map"
			,	DialogData      = "geometry"
			,	Source          = "Deltares, team Rivieren NL2120. Oorspronkelijke bestandsnaam rivieren2120_afbakening.shp, geleverd op 2026-09-03 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Synthese RuimteScanner."
			,	Descr           = "Een polygoon van 351.655 ha. Overlapt het veengebied met 84.797 ha; volgens #760 mag veen daar bovenop, maar omdat elk landschap hier zijn eigen tabel krijgt hoeft die knoop niet doorgehakt te worden en telt het overlappende deel in beide."
			{
				attribute<rdc_meter> geometry (poly);
			}

			unit<uint32> Veen
			:	StorageName     = "%RSo_DataDir%/RegioIndelingen/Landschapsindelingen/Landschap_Veen_Peilvakken_20260903.gpkg"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "True"
			,	DialogType      = "Map"
			,	DialogData      = "geometry"
			,	Source          = "Deltares, team Veen NL2120. Oorspronkelijke bestandsnaam dg_clip_veen.gpkg, geleverd op 2026-09-03 via SURFdrive."
			,	Descr           = "Acht multipolygonen van samen 354.173 ha: de peilvakken geknipt op de acht deelgebieden.

								Let op dat dit niet de deelgebiedenshape is. Die zit in dezelfde levering als deelgebieden_veen_repared.shp, is 732.079 ha en is geometrisch identiek aan shapes_deelgebieden_veen.shp die de waterbergingsregio al leest. Deze peilvakversie is wat het veenteam voor zijn eigen aggregaties gebruikt, en is dus de begrenzing waarop het model moet aansluiten. Zij zit volledig binnen de deelgebieden.

								De 2.459 gaten in deze laag worden deels gedicht; zie Veen_GatenDrempel."
			{
				attribute<rdc_meter> geometry (poly);
			}

			unit<UInt32> Zand := /SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Claimregios_shp
			, Descr = "259 polygonen van samen 1.668.981 ha. De levering begrenzing_zand.zip van #760 is hieraan geometrisch identiek, dus hier staat geen tweede kopie.";
		}

		container Impl
		: Descr = "Het rasteren, en het dichten van de kleine gaten in de veenbegrenzing."
		{
			attribute<Bool> IsKust     (AdminDomain) := IsDefined(poly2grid(Bron/Kust/geometry,     AdminDomain));
			attribute<Bool> IsRivieren (AdminDomain) := IsDefined(poly2grid(Bron/Rivieren/geometry, AdminDomain));
			attribute<Bool> IsZand     (AdminDomain) := IsDefined(poly2grid(Bron/Zand/geometry,     AdminDomain));

			attribute<Bool> IsVeenRuw  (AdminDomain) := IsDefined(poly2grid(Bron/Veen/geometry,     AdminDomain))
			, Descr = "De veenbegrenzing zoals geleverd, met de gaten er nog in.";

			unit<uint32> VeenGat := district_8(!IsVeenRuw)
			, Descr = "De aaneengesloten stukken buiten de veenbegrenzing. Het grootste district is de rest van Nederland en de zee; alle kleine districten zijn de gaten in de laag. Dezelfde district_8-methode als de allocatie gebruikt voor haar clusters."
			{
				attribute<Float32> Oppervlakte_ha (AdminDomain) := (pcount(Districts)[Float32] * Float32(AdminDomain/NrHaPerCell))[Districts];
			}

			attribute<Bool> IsVeen (AdminDomain) := IsVeenRuw || VeenGat/Oppervlakte_ha <= Float32(Veen_GatenDrempel)
			, Descr = "De veenbegrenzing met de kleine gaten dichtgelegd. Een cel buiten de levering telt mee als het aaneengesloten stuk waar hij in ligt kleiner is dan de drempel; de rest van Nederland is een district van miljoenen hectares en valt daar nooit onder.";
		}

		template Gebied_T
		: Descr = "Zet een masker neer als regio-indeling van een regel, met de twee dingen die de indicatorensjablonen nodig hebben: een naam en een toewijzing per cel. Alle cellen binnen het masker wijzen naar regel 0, de rest naar null."
		{
			parameter<String> Naam;
			attribute<Bool>   IsGebied (AdminDomain);

			unit<uint32> Gebied : NrOfRows = 1
			{
				attribute<String> name := const(Naam, .);

				attribute<.> Per_AdminDomain_Fijn (AdminDomain) := IsGebied ? const(0, AdminDomain, .) : const(null_u, AdminDomain, .)
				, Descr = "De toewijzing die de indicatorentabellen sinds #748 lezen, rechtstreeks op 25 meter.";

				attribute<.> Per_AdminDomain     (AdminDomain) := Per_AdminDomain_Fijn;
				attribute<.> Per_AllocDomain     (AllocDomain) := modus(Per_AdminDomain_Fijn, AdminDomain/AllocDomain_rel);

				parameter<ha> Areaal := sum(IsGebied ? AdminDomain/NrHaPerCell : 0[ha]), Descr = "Controlegetal: het gerasterde oppervlak van dit landschap.";
			}
		}

		container Kust     := Gebied_T('Kust',     Impl/IsKust);
		container Rivieren := Gebied_T('Rivieren', Impl/IsRivieren);
		container Veen     := Gebied_T('Veen',     Impl/IsVeen);
		container Zand     := Gebied_T('Zand',     Impl/IsZand);
	}
}
