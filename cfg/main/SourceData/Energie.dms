container Energie : using = "Units"
{
	container RES10_concept
	{
		#include<zoekgebieden.dms>  //bestuurlijk
		#include<analysekaarten.dms>//technisch
	}
	
	#include<Zon.dms>
	#include<Wind.dms>
	
	container EnergieKnooppunten
	: Descr = "De energieknooppunten van de provincie Noord-Holland, voor de trede-as EnergieKnooppuntK van de werkladder HA (RS_paper): nijverheid en logistiek gaan in de High-Ambition-varianten eerst naar de knooppunten die de provincie voor die subsector aanwijst, zoals in de provinciale runs van december 2025. Buiten Noord-Holland is er geen knooppunt."
	{
		unit<uint32> Noord_Holland
		: StorageName     = "%RSo_DataDir%/Energie/Energieknooppunten_NoordHolland.shp"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "true"
		, Source          = "Provincie Noord-Holland, energieknooppunten, aanlevering oktober 2025"
		, DialogData      = "rdc_meter"
		{
			attribute<String> name := naam;
			attribute<Bool>   IsRelevantVoorNijverheid := name == 'Den Helder' || name == 'Agriport' || name == 'Alkmaar' || name == 'IJmond & NZKG' || name == 'De Liede'
			, IntegrityCheck = "sum(uint32(this)) == 5"
			, Descr = "De vijf knooppunten die in de provinciale runs voor nijverheid golden; de IntegrityCheck vangt een naam die in een nieuwe levering anders gespeld is.";
			attribute<Bool>   IsRelevantVoorLogistiek  := name == 'Den Helder' || name == 'Hoorn' || name == 'Grootslag' || name == 'Greenport Aalsmeer' || name == 'Alkmaar' || name == 'IJmond & NZKG' || name == 'Schiphol' || name == 'De Liede'
			, IntegrityCheck = "sum(uint32(this)) == 8"
			, Descr = "De acht knooppunten die in de provinciale runs voor logistiek golden.";
			attribute<.>      Per_AdminDomain               (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<Bool>   IsRelevantVoorNijverheid_grid (AdminDomain) := MakeDefined(IsRelevantVoorNijverheid[Per_AdminDomain], FALSE);
			attribute<Bool>   IsRelevantVoorLogistiek_grid  (AdminDomain) := MakeDefined(IsRelevantVoorLogistiek[Per_AdminDomain], FALSE);
		}
	}
	
	unit<int8> Netcongestie_K := cat_range(-1c, 4c)
	{
		attribute<string> label       : ['Geen beschikbare informatie','Transportcapaciteit beschikbaar zonder wachtrij', 'Transportcapaciteit beperkt beschikbaar zonder wachtrij', 'Gebied is in onderzoek met wachtrij', 'Tekort aan transportcapaciteit met wachtrij'];
		attribute<UInt32> SymbolColor : [rgb(200,200,200),rgb(245,245,245),rgb(255,235,0),rgb(255,165,0),rgb(220,0,0)], DialogType = "SymbolColor";
		attribute<string> name        := AsItemName(label);
	}
	
	unit<uint32> netcongestie_capaciteitskaart_pc6
	: StorageName = "%RSo_DataDir%/Energie/netcongestie_capaciteitskaart_pc6.csv"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "true"
	{
		attribute<rdc_meter>      geometry := rjoin(postcode, /SourceData/Vastgoed/BAG/PerJaar/Y2026/vbo/PC6_centroids/pc6, /SourceData/Vastgoed/BAG/PerJaar/Y2026/vbo/PC6_centroids/geometry);
		attribute<Netcongestie_K> afname_k := int8(afname)[Netcongestie_K];
		attribute<Netcongestie_K> opwek_k  := int8(opwek)[Netcongestie_K];
	}
}
