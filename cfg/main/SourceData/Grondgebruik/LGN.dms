// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: PerKlasse.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container LGN
{
	attribute<UInt16>     m5_src     (rdc_5m)  : StorageName = "='%RSo_DataDir%/Grondgebruik/lgn/LGN'+ModelParameters/LGN_Year+'.tif'", StorageReadOnly = "True", LazyCalculated  = "True", URL = "https://lgn.nl/bestanden";
	attribute<LGNKlasse>  m5         (rdc_5m)  := rlookup(m5_src, LGNKlasse/code);
	attribute<LGNKlasse>  Write_m25  (rdc_25m) := Modus(m5, rdc_5m/rdc_25m_rel), StorageName = "='%RSo_DataDir%/Grondgebruik/lgn/LGN'+ModelParameters/LGN_Year+'_m25.tif'", StorageType = "gdalwrite.grid";
	attribute<LGNKlasse>  m25        (rdc_25m) : StorageName = "='%RSo_DataDir%/Grondgebruik/lgn/LGN'+ModelParameters/LGN_Year+'_m25.tif'", StorageReadOnly = "True", LazyCalculated  = "True";
	
	container PerKlasse := for_each_nedv(LGNKlasse/name, 'm25 == LGNKlasse/V/'+LGNKlasse/name, rdc_25m, bool);

	container Groenfracties
	: Descr = "Basisjaar-groenfracties voor de rs_groen-prijsindexset (RSopen #566/#481): aandeel natuur in de schijf 0-2500m en aandeel water in de schijf 0-500m, fracties 0-1. Spiegelt exact de meting in PriceIndices/main/SourceData/LGN.dms (zelfde m25-bron, zelfde Flat2-potentials, zelfde randcorrectie), zodat de coefficienten fr_natuur_tot2500m/fr_water_500m hier 1-op-1 toepasbaar zijn. De natuurschijf wordt op het 100m-grid gerekend (kernel 51x51; op 25m zou dat 201x201 zijn) en per 25m-cel opgezocht, exact zoals in de schatting."
	{
		attribute<float32> IsGedekt             (rdc_25m) := float32(MakeDefined(m25 != LGNKlasse/V/onbekend, FALSE)), Descr = "1 waar LGN dekking heeft; noemer-basis voor de randcorrectie (tif heeft geen nodata: buitenland is klasse 'onbekend').";

		attribute<float32> natuur                   (rdc_25m) := MakeDefined(float32(LGNKlasse/IsNatuur_hedonisch[m25]), 0f);
		attribute<float32> water                    (rdc_25m) := MakeDefined(float32(LGNKlasse/IsWater_hedonisch[m25]),  0f);
		attribute<float32> Calc_n_gedekt_500m       (rdc_25m) := max_elem(potential(IsGedekt, /Geography/Distmatrices_25m/pot500m/Flat2), 0.0001f), Descr = "De levende berekening achter n_gedekt_500m; de kanonieke schakel onderaan deze container kiest tussen rekenen, lezen en schrijven.";
		attribute<float32> Calc_fr_water_500m       (rdc_25m) := potential(water, /Geography/Distmatrices_25m/pot500m/Flat2) / Calc_n_gedekt_500m, Descr = "De levende berekening achter fr_water_500m. Deelt bewust door Calc_n_gedekt_500m en niet door de kanonieke schakel, zodat een Make nooit een tif leest die in dezelfde run herschreven wordt; de gedeelde fingerprint houdt teller en noemer toch in de pas.";
		attribute<float32> natuur_100m             (rdc_100m) := mean(natuur, rdc_25m/rdc_100m_rel);
		attribute<float32> IsGedekt_100m           (rdc_100m) := mean(IsGedekt, rdc_25m/rdc_100m_rel);
		attribute<float32> Calc_n_gedekt_2500m_100m     (rdc_100m) := max_elem(potential(IsGedekt_100m, /Geography/Distmatrices_100m/pot2500m/Flat2), 0.0001f), Descr = "De levende berekening achter n_gedekt_2500m_100m; de kanonieke schakel onderaan deze container kiest tussen rekenen, lezen en schrijven.";
		attribute<float32> Calc_fr_natuur_tot2500m_100m (rdc_100m) := potential(natuur_100m, /Geography/Distmatrices_100m/pot2500m/Flat2)	/ Calc_n_gedekt_2500m_100m, Descr = "De levende berekening achter fr_natuur_tot2500m_100m. Deelt bewust door Calc_n_gedekt_2500m_100m en niet door de kanonieke schakel, zodat een Make nooit een tif leest die in dezelfde run herschreven wordt; de gedeelde fingerprint houdt teller en noemer toch in de pas.";
		attribute<float32> fr_natuur_tot2500m       (rdc_25m) := fr_natuur_tot2500m_100m[rdc_25m/rdc_100m_rel];

		// Ontkoppeling van de vier zware kernel-items (huispatroon, zie Templates/DecoupledFile_T). Ze zijn jaar- en
		// variantinvariant maar rekenen fors: potential met kernel 41x41 op het 25m-grid en 51x51 op het 100m-grid.
		// WriteBasedata (Generate_Run1) schrijft ze eenmalig weg naar %LocalDataProjDir%/BaseData; elk zichtjaarproces
		// leest ze daarna alleen terug. De kanonieke namen blijven staan, dus de lezers (Groenfracties_T voor allocatie
		// en indicator, PerDomainT, Diagnose677) hoeven nergens aangepast te worden.

		parameter<String> FileName_n_gedekt_500m           := '%LocalDataProjDir%/BaseData/Grondgebruik/LGN/n_gedekt_500m_LGN'+/ModelParameters/LGN_Year+'_'+/ModelParameters/StudyArea+'.tif';
		parameter<String> FileName_fr_water_500m           := '%LocalDataProjDir%/BaseData/Grondgebruik/LGN/fr_water_500m_LGN'+/ModelParameters/LGN_Year+'_'+/ModelParameters/StudyArea+'.tif';
		parameter<String> FileName_n_gedekt_2500m_100m     := '%LocalDataProjDir%/BaseData/Grondgebruik/LGN/n_gedekt_2500m_100m_LGN'+/ModelParameters/LGN_Year+'_'+/ModelParameters/StudyArea+'.tif';
		parameter<String> FileName_fr_natuur_tot2500m_100m := '%LocalDataProjDir%/BaseData/Grondgebruik/LGN/fr_natuur_tot2500m_100m_LGN'+/ModelParameters/LGN_Year+'_'+/ModelParameters/StudyArea+'.tif';

		parameter<String> Fingerprint_Groenfracties :=
			  'lgn_year='             + /ModelParameters/LGN_Year
			+ ';kernel_water_m='      + string(/Geography/Distmatrices/Impl_25m/pot500m/afkapstraal)
			+ ';grid_water_m='        + string(rdc_25m/gridsize)
			+ ';kernel_nature_m='     + string(/Geography/Distmatrices/Impl_100m/pot2500m/afkapstraal)
			+ ';grid_nature_m='       + string(rdc_100m/gridsize)
			+ ';denominator_floor=0.0001'
			+ ';covered=not_onbekend'
			+ ';class_count='         + string(#Classifications/Grondgebruik/LGNKlasse)
			+ ';lgn_class_codes='     + asList(string(/Classifications/Grondgebruik/LGNKlasse/code), ',')
			+ ';natural_class_flags=' + asList(string(uint8(/Classifications/Grondgebruik/LGNKlasse/IsNatuur_hedonisch)), '')
			+ ';water_class_flags='   + asList(string(uint8(/Classifications/Grondgebruik/LGNKlasse/IsWater_hedonisch)), '')
			+ ';study_area='          + /ModelParameters/StudyArea
		, Descr = "Een gedeelde fingerprint voor alle vier de bestanden, met alle bepalende invoeren, ook wat al in de bestandsnaam zit. Zo verversen de fracties en hun noemers altijd samen en stammen ze nooit uit verschillende vintages; dat borgt de eis uit #566/#637 dat allocatie en indicator exact dezelfde noemers houden. lgn_year kiest de LGN-tif en de daarvan afgeleide m25. De kernel- en gridsleutels leggen de twee schijven vast (500m op het 25m-grid, 2500m op het 100m-grid); de straal zit ook in de itemnamen pot500m en pot2500m in de expressies, dus wie die expressies wijzigt moet deze sleutels laten meebewegen. denominator_floor is de max_elem-ondergrens in de noemers, covered de definitie van gedekt gebied (alles behalve klasse onbekend). De class-sleutels zijn de nullen-en-enen-reeksen van de hedonische natuur- en waterdefinitie per LGN-klasse, zodat een wijziging binnen de set wordt opgemerkt terwijl de bestandsnaam niet meebeweegt.";

		container Decoupling_n_gedekt_500m           := Templates/DecoupledFile_T(FileName_n_gedekt_500m,           Fingerprint_Groenfracties);
		container Decoupling_fr_water_500m           := Templates/DecoupledFile_T(FileName_fr_water_500m,           Fingerprint_Groenfracties);
		container Decoupling_n_gedekt_2500m_100m     := Templates/DecoupledFile_T(FileName_n_gedekt_2500m_100m,     Fingerprint_Groenfracties);
		container Decoupling_fr_natuur_tot2500m_100m := Templates/DecoupledFile_T(FileName_fr_natuur_tot2500m_100m, Fingerprint_Groenfracties);

		attribute<float32> Make_n_gedekt_500m           (rdc_25m)  := Calc_n_gedekt_500m,           StorageName = "=FileName_n_gedekt_500m",           StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_n_gedekt_500m/Write_Fingerprint";
		attribute<float32> Make_fr_water_500m           (rdc_25m)  := Calc_fr_water_500m,           StorageName = "=FileName_fr_water_500m",           StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_fr_water_500m/Write_Fingerprint",           IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))";
		attribute<float32> Make_n_gedekt_2500m_100m     (rdc_100m) := Calc_n_gedekt_2500m_100m,     StorageName = "=FileName_n_gedekt_2500m_100m",     StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_n_gedekt_2500m_100m/Write_Fingerprint";
		attribute<float32> Make_fr_natuur_tot2500m_100m (rdc_100m) := Calc_fr_natuur_tot2500m_100m, StorageName = "=FileName_fr_natuur_tot2500m_100m", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_fr_natuur_tot2500m_100m/Write_Fingerprint", IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))";

		attribute<float32> Read_n_gedekt_500m           (rdc_25m)  : StorageName = "=FileName_n_gedekt_500m",           StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<float32> Read_fr_water_500m           (rdc_25m)  : StorageName = "=FileName_fr_water_500m",           StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<float32> Read_n_gedekt_2500m_100m     (rdc_100m) : StorageName = "=FileName_n_gedekt_2500m_100m",     StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<float32> Read_fr_natuur_tot2500m_100m (rdc_100m) : StorageName = "=FileName_fr_natuur_tot2500m_100m", StorageType = "gdal.grid", StorageReadOnly = "TRUE";

		attribute<float32> n_gedekt_500m           (rdc_25m)  := = !ModelParameters/BaseDataOntkoppeld ? 'Calc_n_gedekt_500m'           : Decoupling_n_gedekt_500m/MayReuse           ? 'Read_n_gedekt_500m'           : 'Make_n_gedekt_500m'
		, Descr = "Noemer 500m-schijf: gedekt oppervlak (in cellen); ook door de indicator gebruikt voor de zichtjaar-fracties. Kanonieke schakel in drie standen: niet ontkoppeld rekent live, ontkoppeld met geldige fingerprint leest de tif, en anders wordt hij gemaakt en geschreven inclusief het zijbestand; vraag Decoupling_n_gedekt_500m/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		attribute<float32> fr_water_500m           (rdc_25m)  := = !ModelParameters/BaseDataOntkoppeld ? 'Calc_fr_water_500m'           : Decoupling_fr_water_500m/MayReuse           ? 'Read_fr_water_500m'           : 'Make_fr_water_500m'
		, Descr = "Aandeel water (LGN 16/17) in de schijf 0-500m. Kanonieke schakel in drie standen, zie n_gedekt_500m. De allocatie (Zichtjaar_T) en de indicator WaardeNabijheidGroen lezen de fracties en de noemers allebei via het gedeelde sjabloon Templates/Suitabilities/Groenfracties_T en dus via deze kanonieke items, zodat de eis uit #566/#637 dat beide kanten exact dezelfde noemers houden ook ontkoppeld per constructie geborgd blijft.";
		attribute<float32> n_gedekt_2500m_100m     (rdc_100m) := = !ModelParameters/BaseDataOntkoppeld ? 'Calc_n_gedekt_2500m_100m'     : Decoupling_n_gedekt_2500m_100m/MayReuse     ? 'Read_n_gedekt_2500m_100m'     : 'Make_n_gedekt_2500m_100m'
		, Descr = "Noemer 2500m-schijf op het 100m-grid; ook door de indicator gebruikt voor de zichtjaar-fracties. Kanonieke schakel in drie standen, zie n_gedekt_500m.";
		attribute<float32> fr_natuur_tot2500m_100m (rdc_100m) := = !ModelParameters/BaseDataOntkoppeld ? 'Calc_fr_natuur_tot2500m_100m' : Decoupling_fr_natuur_tot2500m_100m/MayReuse ? 'Read_fr_natuur_tot2500m_100m' : 'Make_fr_natuur_tot2500m_100m'
		, Descr = "Aandeel natuur (hedonische definitie) in de schijf 0-2500m, op het 100m-grid. Kanonieke schakel in drie standen, zie n_gedekt_500m; fr_natuur_tot2500m op het 25m-grid blijft de goedkope opzoeking hiervan en leest dus automatisch mee uit de tif. Zelfde borging van #566/#637 als bij fr_water_500m.";
	}
}