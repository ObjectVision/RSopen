// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Download from PDOK
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BRT
{
	parameter<String> filedate := ModelParameters/BRT_file_date;
	
	unit<UInt32> IsZee := select_with_org_rel(lowercase(Compleet/top10nl_waterdeel_vlak/Label) == lowercase('Water vlak - droogvallend') || lowercase(Compleet/top10nl_waterdeel_vlak/Label) == lowercase('Water vlak - zee'))
	{
		attribute<rdc_meter> geometry (poly) := Compleet/top10nl_waterdeel_vlak/geometry[org_rel];
		attribute<rdc_meter> geometry_simpl (poly) := geos_buffer_multi_polygon(geometry, 1d, 4b);
	}
	unit<UInt32> IsWaterweg := select_with_org_rel(lowercase(Compleet/top10nl_waterdeel_vlak/Label) == lowercase('Water vlak - waterloop hoofd') && lowercase(Compleet/top10nl_waterdeel_vlak/hoofdafwatering) == lowercase('ja'))
	{
		attribute<rdc_meter> geometry (poly) := Compleet/top10nl_waterdeel_vlak/geometry[org_rel];
		attribute<rdc_meter> geometry_simpl (poly) := geos_buffer_multi_polygon(geometry, 1d, 4b);
	}
	
	unit<UInt32> IsHoofdweg := select_with_org_rel(Compleet/top10nl_wegdeel_vlak/awegnummer != '' || Compleet/top10nl_wegdeel_vlak/ewegnummer != '' || Compleet/top10nl_wegdeel_vlak/nwegnummer != '' || Compleet/top10nl_wegdeel_vlak/swegnummer != '')
	{
		attribute<rdc_meter> geometry (poly) := Compleet/top10nl_wegdeel_vlak/geometry[org_rel];
		attribute<rdc_meter> geometry_simpl (poly) := geos_buffer_multi_polygon(geometry, 1d, 4b);
	}
	unit<UInt32> IsSpoor := select_with_org_rel(lowercase(Compleet/top10nl_spoorbaandeel_lijn/typespoorbaan) == lowercase('trein'))
	{
		attribute<rdc_meter> geometry (arc) := Compleet/top10nl_spoorbaandeel_lijn/geometry[org_rel];
		attribute<Bool>      IsElectrisch   := (lowercase(Compleet/top10nl_spoorbaandeel_lijn/elektrificatie) == lowercase('ja'))[org_rel];
	}
	
	unit<UInt32> IsDierentuinOpenluchtMuseum := union_unit(
													Compleet/MaakLosseCat_functioneel_gebied/Terrein_vlakken_dierentuin_safaripark/combined_vlak
													,Compleet/MaakLosseCat_functioneel_gebied/Terrein_vlakken_openluchtmuseum/combined_vlak
												)
	{
		attribute<rdc_meter> geometry (poly)                 := union_data(., Compleet/MaakLosseCat_functioneel_gebied/Terrein_vlakken_dierentuin_safaripark/combined_vlak/geometry
																				,Compleet/MaakLosseCat_functioneel_gebied/Terrein_vlakken_openluchtmuseum/combined_vlak/geometry);
		attribute<bool>      Calc_Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain)), Descr = "De vergridding zelf, met dezelfde expressie als voor de ontkoppeling: elke cel die door een dierentuinvlak of openluchtmuseumvlak wordt geraakt.";

		parameter<String> FileName_Per_AdminDomain := '%LocalDataProjDir%/BaseData/Grondgebruik/BRT/IsDierentuinOpenluchtMuseum_'+/ModelParameters/BRT_file_date+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst.";

		unit<UInt32> SelectieCodes := select_with_org_rel(
				   lowercase(/SourceData/Grondgebruik/BRT/BRT_Classifications/Label) == 'terrein vlakken - dierentuin, safaripark'
				|| lowercase(/SourceData/Grondgebruik/BRT/BRT_Classifications/Label) == 'terrein vlakken - openluchtmuseum'
			)
		, Descr = "De visualisatiecodes die een van beide labels dragen. Deze set zit in de fingerprint omdat een gewijzigde toewijzing van codes aan deze labels de selectie verandert zonder de bestandsnaam te raken."
		{
			attribute<Int32> code := /SourceData/Grondgebruik/BRT/BRT_Classifications/code[org_rel];
		}

		parameter<String> Fingerprint_Per_AdminDomain :=
			  'brt_date='         + /ModelParameters/BRT_file_date
			+ ';study_area='      + /ModelParameters/StudyArea
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';source_layers=functioneel_gebied_vlak,functioneel_gebied_multivlak'
			+ ';selection_labels=terrein vlakken - dierentuin, safaripark|terrein vlakken - openluchtmuseum'
			+ ';selection_codes=' + asList(string(SelectieCodes/code), ',')
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. brt_date is de vintage van de gpkg waar de vlakken uit komen. admin_grid en grid_size vangen dat een andere rasterresolutie een ander bestand onder dezelfde naam zou opleveren. source_layers en selection_labels liggen vast in de configuratie en staan hier als leesbaar verslag; selection_codes komt uit de klassentabel en beweegt mee wanneer die toewijzing wijzigt.";

		container Decoupling_Per_AdminDomain := /Templates/DecoupledFile_T(FileName_Per_AdminDomain, Fingerprint_Per_AdminDomain);

		attribute<bool>      Make_Per_AdminDomain (AdminDomain) := Calc_Per_AdminDomain, StorageName = "=FileName_Per_AdminDomain", StorageType = "tif", ExplicitSuppliers = "Decoupling_Per_AdminDomain/Write_Fingerprint", Descr = "Schrijft de vergridding eenmalig als tif. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<bool>      Read_Per_AdminDomain (AdminDomain) : StorageName = "=FileName_Per_AdminDomain", StorageType = "tif", StorageReadOnly = "TRUE", Descr = "Leest de eerder weggeschreven tif terug. Domein en waardetype zijn gelijk aan die van Calc_Per_AdminDomain.";
		attribute<bool>      Per_AdminDomain      (AdminDomain) := = Decoupling_Per_AdminDomain/MayReuse ? 'Read_Per_AdminDomain' : 'Make_Per_AdminDomain'
		, Descr = "De schakel met de oorspronkelijke naam, zodat de lezers elders in de configuratie ongemoeid blijven. Klopt de fingerprint dan wordt de tif gelezen, anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_Per_AdminDomain/Explanation op om te zien waarom een bestand wel of niet opnieuw gemaakt wordt.";
	}
	
	unit<UInt32> IsWoonkern := Compleet/MaakLosseCat_plaats/Plaats_woonkern/combined_vlak
	{
		attribute<rdc_meter> geometry       (poly) := Compleet/MaakLosseCat_plaats/Plaats_woonkern/combined_vlak/geometry;
		attribute<bool>      Calc_Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain)), Descr = "De vergridding zelf, met dezelfde expressie als voor de ontkoppeling: elke cel die door een woonkernvlak van de BRT wordt geraakt.";

		parameter<String> FileName_Per_AdminDomain := '%LocalDataProjDir%/BaseData/Grondgebruik/BRT/IsWoonkern_'+/ModelParameters/BRT_file_date+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst.";

		unit<UInt32> SelectieCodes := select_with_org_rel(lowercase(/SourceData/Grondgebruik/BRT/BRT_Classifications/Label) == 'plaats - woonkern')
		, Descr = "De visualisatiecodes die het woonkernlabel dragen. Deze set zit in de fingerprint omdat een gewijzigde toewijzing van codes aan dit label de selectie verandert zonder de bestandsnaam te raken."
		{
			attribute<Int32> code := /SourceData/Grondgebruik/BRT/BRT_Classifications/code[org_rel];
		}

		parameter<String> Fingerprint_Per_AdminDomain :=
			  'brt_date='         + /ModelParameters/BRT_file_date
			+ ';study_area='      + /ModelParameters/StudyArea
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';source_layers=plaats_vlak,plaats_multivlak'
			+ ';selection_label=plaats - woonkern'
			+ ';selection_codes=' + asList(string(SelectieCodes/code), ',')
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. brt_date is de vintage van de gpkg waar de vlakken uit komen. admin_grid en grid_size vangen dat een andere rasterresolutie een ander bestand onder dezelfde naam zou opleveren. source_layers en selection_label liggen vast in de configuratie en staan hier als leesbaar verslag; selection_codes komt uit de klassentabel en beweegt mee wanneer die toewijzing wijzigt.";

		container Decoupling_Per_AdminDomain := /Templates/DecoupledFile_T(FileName_Per_AdminDomain, Fingerprint_Per_AdminDomain);

		attribute<bool>      Make_Per_AdminDomain (AdminDomain) := Calc_Per_AdminDomain, StorageName = "=FileName_Per_AdminDomain", StorageType = "tif", ExplicitSuppliers = "Decoupling_Per_AdminDomain/Write_Fingerprint", Descr = "Schrijft de vergridding eenmalig als tif. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<bool>      Read_Per_AdminDomain (AdminDomain) : StorageName = "=FileName_Per_AdminDomain", StorageType = "tif", StorageReadOnly = "TRUE", Descr = "Leest de eerder weggeschreven tif terug. Domein en waardetype zijn gelijk aan die van Calc_Per_AdminDomain.";
		attribute<bool>      Per_AdminDomain      (AdminDomain) := = Decoupling_Per_AdminDomain/MayReuse ? 'Read_Per_AdminDomain' : 'Make_Per_AdminDomain'
		, Descr = "De schakel met de oorspronkelijke naam, zodat de lezers elders in de configuratie ongemoeid blijven. Klopt de fingerprint dan wordt de tif gelezen, anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_Per_AdminDomain/Explanation op om te zien waarom een bestand wel of niet opnieuw gemaakt wordt.";
	}
	
	
	container Compleet
	:	StorageName     = "='%RSo_DataDir%/Grondgebruik/BRT/top10nl_Compleet-'+filedate+'.gpkg'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	, 	DialogData      = "rdc_meter"
	// , 	SyncMode        = "AllTables"
	, 	Descr           = "Download from PDOK"
	{
		unit<UInt32> top10nl_Wegdeel_vlak
		{
			attribute<String>                       Label                := BRT_Classifications/Label[visualisatiecode_rel];
			attribute<BRT_Classifications>          visualisatiecode_rel := rlookup(int32(visualisatiecode), BRT_Classifications/code);
			attribute<BRT_Classifications/Label_uq> Label_uq_rel         := rlookup(lowercase(Label), lowercase(BRT_Classifications/Label_uq/values));
			attribute<Bool>                         IsStudyArea           := IsDefined(point_in_polygon(centroid_or_mid(geometry_simpl), rdc_meter/BoundingBoxPlus/polygon));
		}
		
		unit<UInt32> top10nl_Waterdeel_vlak
		{
			attribute<String>                       Label                := BRT_Classifications/Label[visualisatiecode_rel];
			attribute<BRT_Classifications>          visualisatiecode_rel := rlookup(int32(visualisatiecode), BRT_Classifications/code);
			attribute<BRT_Classifications/Label_uq> Label_uq_rel         := rlookup(lowercase(Label), lowercase(BRT_Classifications/Label_uq/values));
			attribute<Bool>                         IsStudyArea           := IsDefined(point_in_polygon(centroid_or_mid(geometry_simpl), rdc_meter/BoundingBoxPlus/polygon));
		}
		
		unit<UInt32> top10nl_terrein_vlak
		{
			attribute<String>                       Label                 := BRT_Classifications/Label[visualisatiecode_rel];
			attribute<BRT_Classifications>          visualisatiecode_rel  := rlookup(int32(visualisatiecode), BRT_Classifications/code);
			attribute<BRT_Classifications/Label_uq> Label_uq_rel          := rlookup(lowercase(Label), lowercase(BRT_Classifications/Label_uq/values));
			attribute<rdc_meter>                    geometry_simpl (poly) := geos_buffer_multi_polygon(geometry, 1d, 4b);
			attribute<Bool>                         IsStudyArea           := IsDefined(point_in_polygon(centroid_or_mid(geometry_simpl), rdc_meter/BoundingBoxPlus/polygon));
		}
		container MaakLosseCat_functioneel_gebied :=
			for_each_ne(
				BRT_Classifications/Label_uq/name
				, 'BRT_groepen_T(' +string(id(BRT_Classifications/Label_uq))+ ',''functioneel_gebied'')'
			);
		container MaakLosseCat_plaats :=
			for_each_ne(
				BRT_Classifications/Label_uq/name
				, 'BRT_groepen_T(' +string(id(BRT_Classifications/Label_uq))+ ',''plaats'')'
			);
		container MaakLosseCat_gebouw :=
			for_each_ne(
				BRT_Classifications/Label_uq/name
				, 'BRT_groepen_T(' +string(id(BRT_Classifications/Label_uq))+ ',''gebouw'')'
			);
		container MaakLosseCat_geografisch_gebied :=
			for_each_ne(
				BRT_Classifications/Label_uq/name
				, 'BRT_groepen_T(' +string(id(BRT_Classifications/Label_uq))+ ',''geografisch_gebied'')'
			);
	}

	unit<UInt32> BRT_Classifications := Classifications/Grondgebruik/BRT/visualisatiecodes;
	
	Template BRT_groepen_T
	{
		parameter<BRT_Classifications/Label_uq> Label_rel;
		parameter<String> Type;
		//
		
	
		unit<UInt32> vlak := ='select_with_org_rel(rlookup(lowercase(BRT_Classifications/Label)[rlookup(int32(top10nl_'+Type+'_vlak/visualisatiecode), BRT_Classifications/code)], lowercase(BRT_Classifications/Label_uq/values)) == Label_rel)'
		{
			attribute<rdc_meter> geometry (poly) := ='top10nl_'+Type+'_vlak/geometry[org_rel]';
			// attribute<UInt32>    aantal_inwoners := ='top10nl_'+Type+'_vlak/aantalinwoners[uint32][org_rel]';
			// attribute<String>    plaatsnaam      := ='top10nl_'+Type+'_vlak/naamnl[org_rel]';
		} 
		unit<UInt32> multi_vlak := ='select_with_org_rel(rlookup(lowercase(BRT_Classifications/Label)[rlookup(int32(top10nl_'+Type+'_multivlak/visualisatiecode), BRT_Classifications/code)], lowercase(BRT_Classifications/Label_uq/values)) == Label_rel)'
		{
			attribute<rdc_meter> geometry (poly) := ='top10nl_'+Type+'_multivlak/geometry[org_rel]';
			// attribute<UInt32>    aantal_inwoners := ='top10nl_'+Type+'_multivlak/aantalinwoners[uint32][org_rel]';
			// attribute<String>    plaatsnaam      := ='top10nl_'+Type+'_multivlak/naamnl[org_rel]';
		} 
		
		unit<UInt32> combined_vlak := union_unit(vlak, multi_vlak)
		{
			attribute<rdc_meter> geometry (poly) := union_data(., vlak/geometry, multi_vlak/geometry);
			// attribute<UInt32>    aantal_inwoners := union_data(., vlak/aantal_inwoners, multi_vlak/aantal_inwoners);
			// attribute<String>    plaatsnaam      := union_data(., vlak/plaatsnaam, multi_vlak/plaatsnaam);
		} 
	}
}