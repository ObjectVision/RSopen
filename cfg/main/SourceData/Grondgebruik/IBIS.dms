	unit<UInt32> Y2021
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2021.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "PBL-3, 14 februari 2023 bestandslokatie per email"
	,  URL             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  DialogType      = "Map"
	,  DialogData      = "geometry"
	,  URL     = "https://Provincies.pleio.nl/groups/view/86a606a7-5989-429c-af9c-bd36404a2f7a/ibis-openbare-bestanden-groep/files/eb108365-1193-4c98-8936-9666c591f8d2"
	{
		attribute<rdc_meter> geometry            (poly);
		
		attribute<Bool> Transformatie := (HA_TRANSF + HA_HERPROF + HA_ZREVIT) / HA_NETTO > 0.5[float64]
		{
			attribute<Bool> Per_AdminDomain (AdminDomain) := .[../Per_AdminDomain];
		}
		
		attribute<Bool> Nieuwbouw := HA_UITGEG / HA_NETTO < 0.5[float64] && Verouderd == 'NEE'
		{
			attribute<Bool> Per_AdminDomain (AdminDomain) := .[../Per_AdminDomain];
		}
		
		attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain)
		{
			attribute<Bool> IsPlan (AdminDomain) := IsDefined(.);
		}
		
		attribute<Bool>      IsNieuwBouwOfTransformatie := Nieuwbouw || Transformatie;
		
		attribute<String>    WLOC_TYPE;
		unit<UInt32>         uq                         := unique(WLOC_TYPE);
		attribute<String>    WLOC_TYPE_code             := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	unit<UInt32>                                 Y2022
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2022.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "PBL-3, 22 februari 2024 toegevoegd op Y schijf"
	,  URL             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  URL             = "https://Provincies.pleio.nl/groups/view/86a606a7-5989-429c-af9c-bd36404a2f7a/ibis-openbare-bestanden-groep/files/eb108365-1193-4c98-8936-9666c591f8d2"
	//,  SqlString = "SELECT * FROM ibis_openbaar WHERE RIN_NUMMER = 170076"
	{
		attribute<rdc_meter> geometry                (poly);
		attribute<ha>        oppervlak                      := area(geometry, meter2)[ha];
		
		attribute<.>         IBIS22Grid       (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<Bool>      IBIS22GridResult (AdminDomain) := IBIS22Grid >= 0;
		
		unit<UInt32>         Zeehavens                      := select_with_attr_by_cond(., Type_rel == Classifications/Grondgebruik/IBIS/V/Zeehaventerrein
		                                                       &&
		                                                       (KERN_NAAM == 'VLISSINGEN'
		                                                           || KERN_NAAM == 'TERNEUZEN'
		                                                           || KERN_NAAM == 'BORSSELE'
		                                                           || KERN_NAAM == 'SLUISKIL'
		                                                           || KERN_NAAM == 'WESTDORPE'
		                                                           || KERN_NAAM == 'MOERDIJK'
		                                                           || KERN_NAAM == 'SCHIEDAM'
		                                                           || KERN_NAAM == 'VLAARDINGEN'
		                                                           || KERN_NAAM == 'ROTTERDAM'
		                                                           || KERN_NAAM == 'HOEK VAN HOLLAND'
		                                                           || KERN_NAAM == 'VELSEN-NOORD'
		                                                           || KERN_NAAM == 'ZAANSTAD'
		                                                           || KERN_NAAM == 'ROODESCHOOL'
		                                                           || KERN_NAAM == 'DELFZIJL'
		                                                       )
		                                                       || (KERN_NAAM == 'AMSTERDAM' &&  Type_rel == Classifications/Grondgebruik/IBIS/V/onbekend && !PLAN_NAAM == 'IJBURGLAAN')

			)
		{
		
		}
		
		attribute<String>    WLOC_TYPE;
		unit<UInt32>         uq                             := unique(WLOC_TYPE);
		attribute<String>    WLOC_TYPE_code                 := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
		
		attribute<Float64>   NogUitgeefbaarHa               := HA_NETTO-HA_UITGEG-HA_UIT_HJR+HA_TKPGEM; //Netto hectaren verminderd met Uitgegeven t/m vorig peiljaar en de Uitgifte in het huidige peiljaar en vermeerderd met Terugkoop in het huidige peiljaar en eventuele wijzigingen als gevolg van een wijziging in de omvang van het bedrijventerrein
		attribute<Bool>      NogUitgeefbaar                 := NogUitgeefbaarHa > 0[float64];
		attribute<Bool>      Nog50Uitgeefbaar               := div(NogUitgeefbaarHa, HA_NETTO) > 0.5; //True als nog meer dan fractie 0.5 [dus meer dan 50%] van de oppervlakte nog uitgeefbaar is, anders FALSE. We willen niet dat er gealloceerd wordt op plekken waar eigenlijk nog maar heel weinig ruimte is.
		attribute<Bool>      Uitgegeven                     := !NogUitgeefbaar;
			
		attribute<Bool>      IsVol                          := lowercase(vol) == lowercase('ja'); //case-insensitief via lowercase; null of leeg telt als niet vol
		attribute<Bool>      UitgegevenVol0_0               := !Uitgegeven && !IsVol;
		attribute<Bool>      UitgegevenVol0_1               := !Uitgegeven && IsVol;
		attribute<Bool>      UitgegevenVol1_0               := Uitgegeven && !IsVol;
		attribute<Bool>      UitgegevenVol1_1               := Uitgegeven && IsVol;
		
		attribute<String>    UitgegevenVol                  := switch(
		case(UitgegevenVol0_0 == True, '1')
	  , case(UitgegevenVol0_1 == True, '2')
	  , case(UitgegevenVol1_0 == True, '3')
	  , case(UitgegevenVol1_1 == True, '4')
	  , 'Missing'
		);
			
	}
	
	unit<UInt32> Y2023
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_werklocaties_2023.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "PBL-3, 19 februari 2025 bestandslocatie per email"
						 "attribuut data uit Excel-bestand - ibis_nl_2023_publiek.xlsx (3738 record), koppelen op RIN-nummer in het GIS-bestand 3713 records" 
	,  url             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  URL             = "https://provincies.pleio.nl/files/view/b210541b-824c-45f6-bea0-8f926cee0eb5/ibis_nl_2023_publiek.xlsx"
						 "https://provincies.pleio.nl/files/view/4311f433-f5e1-4492-935e-d079a8a977fc/ibis_nl_2023.zip"
	,  sqlstring       = "SELECT * FROM IBIS_werklocaties_2023"
	{
		attribute<rdc_meter> geometry      (poly);
		attribute<String>    WLOC_TYPE            := werklocatie_type;
		attribute<Float64>   NogUitgeefbaarHa     := max_elem(netto_oppervlakte - (uitgifte_voor_2022 + MakeDefined(uitgifte_in_2022, 0d)), 0d), Descr = "Netto min wat voor en in het peiljaar is uitgegeven, niet onder nul. Een lege uitgifte in het peiljaar telt als geen uitgifte; zonder MakeDefined werd het verschil null, gaf max_elem daarvoor 0d en telde het terrein als helemaal uitgegeven en dus vol (zie Y2024).";
		attribute<Float64>   Uitgegeven           := netto_oppervlakte - NogUitgeefbaarHa;
		attribute<Bool>      NogUitgeefbaar       := NogUitgeefbaarHa > 0[float64];
		attribute<Bool>      Nog50Uitgeefbaar     := div(NogUitgeefbaarHa, netto_oppervlakte) > 0.5;
		attribute<uint8>     Milieucategorie_x10  := MakeDefined(uint8(round(float64(maximale_milieucategorie) * 10d)), MilieuCat_Aanvulling), Descr = "De milieucategorie maal tien, zodat 3.1 en 3.2 als geheel getal uit elkaar te houden zijn; de bufferafstand per sleutel staat in ModelParameters/Wonen/MilieuCat. Het bronveld
					maximale_milieucategorie is tekst en de provincies schrijven het verschillend (een kaal getal, 3.1, 2=licht, X voor onbekend); float64 leest de voorloopwaarde en geeft null voor X,
					X=onbekend en leeg, waar uint8 bij het eerste niet-cijfer afkapte en 3.1 als 3 binnenbracht (#694). Wat null blijft krijgt MilieuCat_Aanvulling hieronder.";
		attribute<uint8>     MilieuCat_Aanvulling := /ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend
		                                             ? switch( case(lowercase(left(WLOC_TYPE, 1)) == 'a', /ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven)
		                                                     , case(lowercase(left(WLOC_TYPE, 1)) == 'b', /ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
		                                                     , 0b )
		                                             : 0b
		, Descr = "De aangenomen Categorie_x10 voor een werklocatie waarvan IBIS de milieucategorie niet levert (#694); de twee waarden en de schakelaar staan in ModelParameters/Wonen/MilieuCat. De toets kijkt
					naar het eerste teken van werklocatie_type en niet naar Type_rel, want de jaargang 2024 zet in dat veld ook vrije tekst waarvoor Type_rel null is, en op het eerste teken vallen die goed: a
					is zeehaventerrein, b is bedrijventerrein, c is economische zone, die bewust geen aanvulling krijgt. De uitkomst 0b is de rij Cat0 met een bufferafstand van nul.";
		attribute<Bool>      IsVol                := lowercase(vol) == lowercase('ja'); //case-insensitief via lowercase; null of leeg telt als niet vol
		attribute<String>    WLOC_TYPE_code       := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	unit<UInt32> Y2024
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2024_extern.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "PBL-3, 19 februari 2025 bestandslocatie per email"
						 "attribuut data uit Excel-bestand - ibis_nl_2023_publiek.xlsx (3738 record), koppelen op RIN-nummer in het GIS-bestand 3713 records" 
	,  url             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  URL             = "https://provincies.pleio.nl/files/view/abf6cd92-cbab-4e3e-bdd2-7ef2a3e44e97/ibis_nl_2024.zip"
	,	DialogData = "rdc_meter" 
	{
		attribute<String>    WLOC_TYPE            := werklocatie_type;
		attribute<Float64>   NogUitgeefbaarHa     := max_elem(netto_oppervlakte - (uitgifte_voor_2023 + MakeDefined(uitgifte_in_2023, 0d)), 0d), Descr = "Netto min wat voor en in het peiljaar is uitgegeven, niet onder nul. Een lege uitgifte in het peiljaar telt als geen uitgifte. Zonder MakeDefined werd het verschil null en gaf max_elem
					daarvoor 0d, zodat zo'n terrein als helemaal uitgegeven en dus vol telde: 406 terreinen in deze jaargang, waarvan er 18 met samen 112 ha nog uitgeefbaar ten onrechte dicht zaten.";
		attribute<Float64>   Uitgegeven           := netto_oppervlakte - NogUitgeefbaarHa;
		attribute<Bool>      NogUitgeefbaar       := NogUitgeefbaarHa > 0[float64];
		attribute<Bool>      Nog50Uitgeefbaar     := div(NogUitgeefbaarHa, netto_oppervlakte) > 0.5;
		attribute<uint8>     Milieucategorie_x10  := MakeDefined(uint8(round(float64(maximale_milieucategorie) * 10d)), MilieuCat_Aanvulling), Descr = "De milieucategorie maal tien, zodat 3.1 en 3.2 als geheel getal uit elkaar te houden zijn; de bufferafstand per sleutel staat in ModelParameters/Wonen/MilieuCat. Het bronveld
					maximale_milieucategorie is tekst en de provincies schrijven het verschillend (een kaal getal, 3.1, 2=licht, X voor onbekend); float64 leest de voorloopwaarde en geeft null voor X,
					X=onbekend en leeg, waar uint8 bij het eerste niet-cijfer afkapte en 3.1 als 3 binnenbracht (#694). Wat null blijft krijgt MilieuCat_Aanvulling hieronder.";
		attribute<uint8>     MilieuCat_Aanvulling := /ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend
		                                             ? switch( case(lowercase(left(WLOC_TYPE, 1)) == 'a', /ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven)
		                                                     , case(lowercase(left(WLOC_TYPE, 1)) == 'b', /ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
		                                                     , 0b )
		                                             : 0b
		, Descr = "De aangenomen Categorie_x10 voor een werklocatie waarvan IBIS de milieucategorie niet levert (#694); de twee waarden en de schakelaar staan in ModelParameters/Wonen/MilieuCat. De toets kijkt
					naar het eerste teken van werklocatie_type en niet naar Type_rel, want de jaargang 2024 zet in dat veld ook vrije tekst waarvoor Type_rel null is, en op het eerste teken vallen die goed: a
					is zeehaventerrein, b is bedrijventerrein, c is economische zone, die bewust geen aanvulling krijgt. De uitkomst 0b is de rij Cat0 met een bufferafstand van nul.";
		attribute<Bool>      IsVol                := lowercase(vol) == lowercase('ja'); //case-insensitief via lowercase; null of leeg telt als niet vol
		attribute<String>    WLOC_TYPE_code       := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	unit<UInt32> Y2026
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2026_20261012.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "IBIS 2024 bijgewerkt met de werklocatielagen van Noord-Holland, Zuid-Holland, Overijssel en Limburg zoals de provincies die op 12 oktober 2026 als WFS publiceerden, per terrein op"
						 " RIN-nummer; gemaakt door GetResults/IBIS_Bijgewerkt in pbl-nl/model-RS-PlanCapaciteit, waar docs/Levering_woningaantallen.md de regel beschrijft. De velden volgen IBIS 2024; bronlaag"
						 " en peildatum zeggen per terrein waar het vandaan komt."
	,  url             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,	DialogData = "rdc_meter"
	{
		attribute<String>    WLOC_TYPE            := werklocatie_type;
		attribute<Float64>   NogUitgeefbaarHa     := max_elem(netto_oppervlakte - uitgegeven_oppervlakte, 0d), Descr = "Netto min uitgegeven, niet onder nul. uitgegeven_oppervlakte is in dit bestand al de uitgifte voor en in het peiljaar samen, met een lege uitgifte in het peiljaar als nul, zoals Y2024 rekent. Een terrein zonder uitgegeven oppervlak telt net als in Y2024 als helemaal uitgegeven.";
		attribute<Float64>   Uitgegeven           := netto_oppervlakte - NogUitgeefbaarHa;
		attribute<Bool>      NogUitgeefbaar       := NogUitgeefbaarHa > 0[float64];
		attribute<Bool>      Nog50Uitgeefbaar     := div(NogUitgeefbaarHa, netto_oppervlakte) > 0.5;
		attribute<uint8>     Milieucategorie_x10  := MakeDefined(uint8(round(float64(maximale_milieucategorie) * 10d)), MilieuCat_Aanvulling), Descr = "Als in Y2024: de milieucategorie maal tien, met MilieuCat_Aanvulling waar het veld leeg of X is. Limburg schrijft 0 voor onbekend; dat staat in dit bestand al als X.";
		attribute<uint8>     MilieuCat_Aanvulling := /ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend
		                                             ? switch( case(lowercase(left(WLOC_TYPE, 1)) == 'a', /ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven)
		                                                     , case(lowercase(left(WLOC_TYPE, 1)) == 'b', /ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
		                                                     , 0b )
		                                             : 0b
		, Descr = "Als in Y2024: de aangenomen Categorie_x10 voor een werklocatie zonder milieucategorie (#694), op het eerste teken van werklocatie_type.";
		attribute<Bool>      IsVol                := lowercase(vol) == lowercase('ja'), Descr = "Het vol-veld staat in dit bestand al op ja, nee of onbekend; onbekend telt als niet vol.";
		attribute<String>    WLOC_TYPE_code       := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null. Noord-Holland heeft geen typeveld; zijn terreinen krijgen het type op RIN-nummer uit IBIS 2024, en de terreinen zonder RIN-genoot vallen op x.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein; zie Y2024.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	
