	unit<UInt32> Y2021
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2021.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "Bron9, 14 februari 2023 bestandslokatie per email"
	,  URL             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  DialogType      = "Map"
	,  DialogData      = "geometry"
	,  URL     = "https://Provincies.pleio.nl/groups/view/86a606a7-5989-429c-af9c-bd36404a2f7a/ibis-openbare-bestanden-groep/files/eb108365-1193-4c98-8936-9666c591f8d2"
	{
		attribute<rdc_meter> geometry (poly);
		
		attribute<Bool> Transformatie := (HA_TRANSF + HA_HERPROF + HA_ZREVIT) / HA_NETTO > 0.5[float64]
		{
			attribute<Bool> Per_AdminDomain (AdminDomain) := .[../Per_AdminDomain];
		}
		
		attribute<Bool> Nieuwbouw := HA_UITGEG / HA_NETTO < 0.5[float64] && Verouderd == 'NEE'
		{
			attribute<Bool> Per_AdminDomain (AdminDomain) := .[../Per_AdminDomain];
		}
		
		attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain)
		{
			attribute<Bool> IsPlan (AdminDomain) := IsDefined(.);
		}
		
		attribute<Bool> IsNieuwBouwOfTransformatie := Nieuwbouw || Transformatie;
		
		attribute<String> WLOC_TYPE;
		unit<UInt32> uq := unique(WLOC_TYPE);
		attribute<String>    WLOC_TYPE_code                                        := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel                           := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	unit<UInt32> Y2022
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2022.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "Bron9, 22 februari 2024 toegevoegd op Y schijf"
	,  URL             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  URL             = "https://Provincies.pleio.nl/groups/view/86a606a7-5989-429c-af9c-bd36404a2f7a/ibis-openbare-bestanden-groep/files/eb108365-1193-4c98-8936-9666c591f8d2"
	//,  SqlString = "SELECT * FROM ibis_openbaar WHERE RIN_NUMMER = 170076"
	{
		attribute<rdc_meter>	geometry (poly);
		attribute<ha> 			oppervlak := area(geometry, meter2)[ha];
		
		attribute<.> 			IBIS22Grid (AdminDomain) 			:= poly2grid(geometry, AdminDomain);
		attribute<Bool> 		IBIS22GridResult (AdminDomain)		:= IBIS22Grid >= 0;
		
		unit<UInt32> Zeehavens := select_with_attr_by_cond(., Type_rel == Classifications/Grondgebruik/IBIS/V/Zeehaventerrein
			&& 
			(KERN_NAAM == 'VLISSINGEN'
				|| KERN_NAAM == 'TERNEUZEN'
				|| KERN_NAAM == 'BORSSELE'
				|| KERN_NAAM == 'SLUISKIL'
				|| KERN_NAAM == 'WESTDORPE'
				|| KERN_NAAM == 'MOERDIJK'
				|| KERN_NAAM == 'SCHIEDAM'
				|| KERN_NAAM == 'VLAARDINGEN'
				|| KERN_NAAM == 'ROTTERDAM'
				|| KERN_NAAM == 'HOEK VAN HOLLAND'
				|| KERN_NAAM == 'VELSEN-NOORD'
				|| KERN_NAAM == 'ZAANSTAD'
				|| KERN_NAAM == 'ROODESCHOOL'
				|| KERN_NAAM == 'DELFZIJL'
			)
			|| (KERN_NAAM == 'AMSTERDAM' &&  Type_rel == Classifications/Grondgebruik/IBIS/V/onbekend && !PLAN_NAAM == 'IJBURGLAAN')

			)
		{
		
		}
		
		attribute<String> WLOC_TYPE;
		unit<UInt32> uq := unique(WLOC_TYPE);
		attribute<String>    WLOC_TYPE_code                                        := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel                           := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
		
		attribute<Float64> NogUitgeefbaarHa		:= HA_NETTO-HA_UITGEG-HA_UIT_HJR+HA_TKPGEM; //Netto hectaren verminderd met Uitgegeven t/m vorig peiljaar en de Uitgifte in het huidige peiljaar en vermeerderd met Terugkoop in het huidige peiljaar en eventuele wijzigingen als gevolg van een wijziging in de omvang van het bedrijventerrein
		attribute<Bool>    NogUitgeefbaar 		:= NogUitgeefbaarHa > 0[float64]; 
		attribute<Bool>	   Nog50Uitgeefbaar		:= div(NogUitgeefbaarHa, HA_NETTO) > 0.5; //True als nog meer dan fractie 0.5 [dus meer dan 50%] van de oppervlakte nog uitgeefbaar is, anders FALSE. We willen niet dat er gealloceerd wordt op plekken waar eigenlijk nog maar heel weinig ruimte is. 
		attribute<Bool>    Uitgegeven 			:= !NogUitgeefbaar;
			
		attribute<Bool>    IsVol				:= lowercase(vol) == lowercase('ja'); //case-insensitief via lowercase; null of leeg telt als niet vol
		attribute<Bool>	   UitgegevenVol0_0		:= !Uitgegeven && !IsVol;
		attribute<Bool>	   UitgegevenVol0_1 	:= !Uitgegeven && IsVol;
		attribute<Bool>	   UitgegevenVol1_0		:= Uitgegeven && !IsVol;
		attribute<Bool>	   UitgegevenVol1_1 	:= Uitgegeven && IsVol;
		
		attribute<String>  UitgegevenVol    := switch(
		case(UitgegevenVol0_0 == True, '1')
	  , case(UitgegevenVol0_1 == True, '2')
	  , case(UitgegevenVol1_0 == True, '3')
	  , case(UitgegevenVol1_1 == True, '4')
	  , 'Missing'
		);
			
	}
	
	unit<UInt32> Y2023
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_werklocaties_2023.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "Hans van Amsterdam - PBL 19 februari 2025 per emai bestandslocatie"
						 "attribuut data uit Excel-bestand - ibis_nl_2023_publiek.xlsx (3738 record), koppelen op RIN-nummer in het GIS-bestand 3713 records" 
	,  url             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  URL             = "https://provincies.pleio.nl/files/view/b210541b-824c-45f6-bea0-8f926cee0eb5/ibis_nl_2023_publiek.xlsx"
						 "https://provincies.pleio.nl/files/view/4311f433-f5e1-4492-935e-d079a8a977fc/ibis_nl_2023.zip"
	,  sqlstring       = "SELECT * FROM IBIS_werklocaties_2023"
	{
		attribute<rdc_meter> geometry (poly);
		attribute<String>    WLOC_TYPE              := werklocatie_type;
		attribute<Float64>   NogUitgeefbaarHa       := max_elem(netto_oppervlakte - (uitgifte_voor_2022 + uitgifte_in_2022), 0d);
		attribute<Float64>   Uitgegeven             := netto_oppervlakte - NogUitgeefbaarHa;
		attribute<Bool>      NogUitgeefbaar         := NogUitgeefbaarHa > 0[float64]; 
		attribute<Bool>	     Nog50Uitgeefbaar       := div(NogUitgeefbaarHa, netto_oppervlakte) > 0.5; 
		attribute<uint8>     Milieucategorie_x10    := MakeDefined(uint8(round(float64(maximale_milieucategorie) * 10d)), MilieuCat_Aanvulling), Descr = "De milieucategorie maal tien, zodat 3.1 en 3.2 als geheel getal uit elkaar te houden zijn; de bufferafstand per sleutel staat in ModelParameters/Wonen/MilieuCat.

				Het bronveld maximale_milieucategorie is tekst en de provincies schrijven het verschillend: een kaal getal, een subcategorie als 3.1, een toelichting als 2=licht, of X voor onbekend. float64 leest de voorloopwaarde en geeft null voor X, X=onbekend en leeg. Tot #694 stond hier uint8, en dat leest ook de voorloopcijfers maar kapt bij het eerste niet-cijfer af, zodat 3.1 als 3 binnenkwam en de terreinen met een subcategorie de grootste richtafstand van hun hoofdcategorie kregen.

				Wat null blijft, dus 448 records met 6.301 hectare netto in de jaargang 2024, krijgt MilieuCat_Aanvulling hieronder.";
		attribute<uint8>     MilieuCat_Aanvulling   := /ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend
															? switch( case(lowercase(left(WLOC_TYPE, 1)) == 'a', /ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven)
																	, case(lowercase(left(WLOC_TYPE, 1)) == 'b', /ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
																	, 0b )
															: 0b
		, Descr = "De aangenomen Categorie_x10 voor een werklocatie waarvan IBIS de milieucategorie niet levert (#694). De twee waarden en de schakelaar staan in ModelParameters/Wonen/MilieuCat.

				De toets kijkt naar het eerste teken van werklocatie_type en niet naar Type_rel, met opzet. De jaargang 2024 is de ruwe provinciale levering en zet in dat veld ook teksten als B1 Gemengde terreinen en B=bedrijventerrein, die in Classifications/Grondgebruik/IBIS niet voorkomen en waarvoor Type_rel dus null is. Op het eerste teken vallen die allemaal goed: a is zeehaventerrein, b is bedrijventerrein, c is economische zone. Voor de economische zones is er bewust geen aanvulling, want retail, onderwijs, zorg en agribusiness zijn geen vervuilende bedrijvigheid.

				De uitkomst 0b betekent sleutel 0, oftewel de rij Cat0 met een bufferafstand van nul; zo'n terrein blokkeert wonen dus nergens, net als voor #694.";
		attribute<Bool>      IsVol                  := lowercase(vol) == lowercase('ja'); //case-insensitief via lowercase; null of leeg telt als niet vol
		attribute<String>    WLOC_TYPE_code                                        := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel                           := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	unit<UInt32> Y2024
	:  StorageName     = "%RSo_DataDir%/Grondgebruik/IBIS/IBIS_NL_2024_extern.gpkg"
	,  StorageType     = "gdal.vect"
	,  StorageReadOnly = "True"
	,  Source          = "Hans van Amsterdam - PBL 19 februari 2025 per emai bestandslocatie"
						 "attribuut data uit Excel-bestand - ibis_nl_2023_publiek.xlsx (3738 record), koppelen op RIN-nummer in het GIS-bestand 3713 records" 
	,  url             = "%RSo_DataDir%/Grondgebruik/IBIS/Definities_IBIS_2021.pdf"
	,  URL             = "https://provincies.pleio.nl/files/view/abf6cd92-cbab-4e3e-bdd2-7ef2a3e44e97/ibis_nl_2024.zip"
	,	DialogData = "rdc_meter" 
	{
		attribute<String>    WLOC_TYPE              := werklocatie_type;
		attribute<Float64>   NogUitgeefbaarHa       := max_elem(netto_oppervlakte - (uitgifte_voor_2023 + uitgifte_in_2023), 0d);
		attribute<Float64>   Uitgegeven             := netto_oppervlakte - NogUitgeefbaarHa;
		attribute<Bool>      NogUitgeefbaar         := NogUitgeefbaarHa > 0[float64]; 
		attribute<Bool>	     Nog50Uitgeefbaar       := div(NogUitgeefbaarHa, netto_oppervlakte) > 0.5; 
		attribute<uint8>     Milieucategorie_x10    := MakeDefined(uint8(round(float64(maximale_milieucategorie) * 10d)), MilieuCat_Aanvulling), Descr = "De milieucategorie maal tien, zodat 3.1 en 3.2 als geheel getal uit elkaar te houden zijn; de bufferafstand per sleutel staat in ModelParameters/Wonen/MilieuCat.

				Het bronveld maximale_milieucategorie is tekst en de provincies schrijven het verschillend: een kaal getal, een subcategorie als 3.1, een toelichting als 2=licht, of X voor onbekend. float64 leest de voorloopwaarde en geeft null voor X, X=onbekend en leeg. Tot #694 stond hier uint8, en dat leest ook de voorloopcijfers maar kapt bij het eerste niet-cijfer af, zodat 3.1 als 3 binnenkwam en de terreinen met een subcategorie de grootste richtafstand van hun hoofdcategorie kregen.

				Wat null blijft, dus 448 records met 6.301 hectare netto in de jaargang 2024, krijgt MilieuCat_Aanvulling hieronder.";
		attribute<uint8>     MilieuCat_Aanvulling   := /ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend
															? switch( case(lowercase(left(WLOC_TYPE, 1)) == 'a', /ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven)
																	, case(lowercase(left(WLOC_TYPE, 1)) == 'b', /ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
																	, 0b )
															: 0b
		, Descr = "De aangenomen Categorie_x10 voor een werklocatie waarvan IBIS de milieucategorie niet levert (#694). De twee waarden en de schakelaar staan in ModelParameters/Wonen/MilieuCat.

				De toets kijkt naar het eerste teken van werklocatie_type en niet naar Type_rel, met opzet. De jaargang 2024 is de ruwe provinciale levering en zet in dat veld ook teksten als B1 Gemengde terreinen en B=bedrijventerrein, die in Classifications/Grondgebruik/IBIS niet voorkomen en waarvoor Type_rel dus null is. Op het eerste teken vallen die allemaal goed: a is zeehaventerrein, b is bedrijventerrein, c is economische zone. Voor de economische zones is er bewust geen aanvulling, want retail, onderwijs, zorg en agribusiness zijn geen vervuilende bedrijvigheid.

				De uitkomst 0b betekent sleutel 0, oftewel de rij Cat0 met een bufferafstand van nul; zo'n terrein blokkeert wonen dus nergens, net als voor #694.";
		attribute<Bool>      IsVol                  := lowercase(vol) == lowercase('ja'); //case-insensitief via lowercase; null of leeg telt als niet vol
		attribute<String>    WLOC_TYPE_code                                        := switch(case(lowercase(left(WLOC_TYPE, 2)) == 'c1', 'c1'), case(lowercase(left(WLOC_TYPE, 2)) == 'c2', 'c2'), case(lowercase(left(WLOC_TYPE, 2)) == 'c3', 'c3'), case(lowercase(left(WLOC_TYPE, 2)) == 'c4', 'c4'), case(lowercase(left(WLOC_TYPE, 2)) == 'c5', 'c5'), case(lowercase(left(WLOC_TYPE, 1)) == 'a', 'a'), case(lowercase(left(WLOC_TYPE, 1)) == 'b', 'b'), case(lowercase(left(WLOC_TYPE, 1)) == 'c', 'c'), 'x'), Descr = "Het ruwe werklocatietype teruggebracht tot een van de negen codes van Classifications/Grondgebruik/IBIS; de regel en de aanleiding staan in de Descr van die classificatie (#738). Wat niet herkend wordt valt op x, de klasse Onbekend, en niet op null.";
		attribute<Classifications/Grondgebruik/IBIS> Type_rel                           := rlookup(WLOC_TYPE_code, lowercase(Classifications/Grondgebruik/IBIS/code)), IntegrityCheck = "all(IsDefined(this))", Descr = "De IBIS-klasse van dit terrein. De IntegrityCheck kan sinds #738 niet meer op ontbrekende brondata vallen, want WLOC_TYPE_code levert altijd een van de negen codes; hij vuurt dus alleen nog als iemand een code in de classificatie hernoemt of weghaalt.";
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AdminDomain (AdminDomain) := Type_rel[poly2grid(geometry, AdminDomain)];
		attribute<Classifications/Grondgebruik/IBIS> Type_Per_AllocDomain (AllocDomain) := Type_rel[poly2grid(geometry, AllocDomain)];
	}
	
	
	attribute<Classifications/Grondgebruik/IBIS> Y2016_src_AllocDomain  (AllocDomain) := Y2016/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2017_edit_AllocDomain (AllocDomain) := Y2017/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend 
																							? Y2016_src_AllocDomain 
																							: Y2017/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2018_edit_AllocDomain (AllocDomain) := Y2018/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2017_edit_AllocDomain 
																							: Y2018/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2019_edit_AllocDomain (AllocDomain) := Y2019/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2018_edit_AllocDomain 
																							: Y2019/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2021_edit_AllocDomain (AllocDomain) := Y2021/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2019_edit_AllocDomain 
																							: Y2021/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2022_edit_AllocDomain (AllocDomain) := Y2022/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2021_edit_AllocDomain 
																							: Y2022/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2023_edit_AllocDomain (AllocDomain) := Y2023/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2022_edit_AllocDomain 
																							: Y2023/Type_Per_AllocDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2024_edit_AllocDomain (AllocDomain) := Y2024/Type_Per_AllocDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2023_edit_AllocDomain 
																							: Y2024/Type_Per_AllocDomain;
																							
	attribute<Classifications/Grondgebruik/IBIS> Y2016_src_AdminDomain  (AdminDomain) := Y2016/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2017_edit_AdminDomain (AdminDomain) := Y2017/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend 
																							? Y2016_src_AdminDomain 
																							: Y2017/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2018_edit_AdminDomain (AdminDomain) := Y2018/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2017_edit_AdminDomain 
																							: Y2018/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2019_edit_AdminDomain (AdminDomain) := Y2019/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2018_edit_AdminDomain 
																							: Y2019/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2021_edit_AdminDomain (AdminDomain) := Y2021/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2019_edit_AdminDomain 
																							: Y2021/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2022_edit_AdminDomain (AdminDomain) := Y2022/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2021_edit_AdminDomain 
																							: Y2022/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2023_edit_AdminDomain (AdminDomain) := Y2023/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2022_edit_AdminDomain 
																							: Y2023/Type_Per_AdminDomain;
	attribute<Classifications/Grondgebruik/IBIS> Y2024_edit_AdminDomain (AdminDomain) := Y2024/Type_Per_AdminDomain == Classifications/Grondgebruik/IBIS/V/onbekend  
																							? Y2023_edit_AdminDomain 
																							: Y2024/Type_Per_AdminDomain;
	
	attribute<Bool> IsZeehaven_AdminDomain  (AdminDomain) := ='Y'+ModelParameters/IBIS_Year+'_edit_AdminDomain == Classifications/Grondgebruik/IBIS/V/Zeehaventerrein';
	attribute<Bool> IsZeehaven_AllocDomain  (AllocDomain) := ='Y'+ModelParameters/IBIS_Year+'_edit_AllocDomain == Classifications/Grondgebruik/IBIS/V/Zeehaventerrein';
	
	unit<uint32> Result := ='Y'+ModelParameters/IBIS_Year
	{
		attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<.>         Per_AllocDomain (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<MilieuCat> MilieuCat_rel                  := rlookup(Milieucategorie_x10, MilieuCat/Categorie_x10)
		, IntegrityCheck = "all(IsDefined(this))"
		, Descr = "De rij in ModelParameters/Wonen/MilieuCat die bij dit terrein hoort. De IntegrityCheck vangt de stille fout waar #694 over ging: levert een volgende IBIS-jaargang een schrijfwijze die de tabel niet kent, bijvoorbeeld 1.1 of 6.1, dan geeft de rlookup null, valt de bufferafstand via MakeDefined terug op nul en verdwijnt de milieuzonering van dat terrein zonder foutmelding. Omdat Milieucategorie_x10 zelf nooit null is, is een null hier altijd een ontbrekende rij en nooit ontbrekende brondata.";
		attribute<Meter>     Buffer_Dist                    := MakeDefined(MilieuCat/Buffer_wonen[MilieuCat_rel], 0[Meter]);

		//Alleen terreinen met een bufferafstand > 0 (milieucategorie 2 en hoger) blokkeren wonen. Voorheen kregen ook cat-1-terreinen, economische zones en terreinen zonder categorie via geos_buffer(0) hun eigen polygoon als buffer, waardoor wonen op elke IBIS-werklocatie restrictief was; dat was alleen als rem op hoge categorieen bedoeld.
		unit<uint32> MetWoonbuffer := select_with_org_rel(Buffer_Dist > 0[Meter])
		{
			attribute<rdc_meter> geometrie    (poly) := geometry[org_rel]; //lexicaal indexeren: org_rel -> Buffer_Dist zoekt in de onderliggende Y-unit, waar de afgeleide attributen niet bestaan
			attribute<Meter>     BufferAfstand      := Buffer_Dist[org_rel];
			attribute<rdc_meter> Buffer_wonen (poly) := geos_buffer_multi_polygon(geometrie, float64(BufferAfstand), 4b);
		}

		attribute<bool>      Calc_RestrictiefWonen (AdminDomain) := IsDefined(poly2grid(MetWoonbuffer/Buffer_wonen, AdminDomain)), Descr = "Binnen de milieucat-buffer (inclusief het terrein zelf) van een werklocatie met categorie 2 of hoger; daar is wonen in de basisjaar-zeef restrictief.";

		parameter<String> FileName_RestrictiefWonen := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/RestrictiefWonen_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

		parameter<String> Fingerprint_RestrictiefWonen :=
			  'ibis_year='        + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024'
			+ ';buffer_wonen_m='  + asList(string(/ModelParameters/Wonen/MilieuCat/Buffer_wonen), ',')
			+ ';milieucat_count=' + string(#/ModelParameters/Wonen/MilieuCat)
			+ ';milieucat_aanvulling=' + string(/ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend) + ':' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven) + ',' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';study_area='      + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. De bufferafstanden per milieucategorie komen uit de VNG-tabel in ModelParameters/Wonen/MilieuCat; elk terrein met een afstand boven nul buffert, dus een gewijzigde tabel verandert de kaart zonder de bestandsnaam te raken. ibis_sources benoemt de brondata per bruikbare jaargang en moet met de hand mee veranderen bij een nieuwe IBIS-levering. stacked_years is de jaargangenstapeling in dit bestand; Result leest alleen de gekozen jaargang, de sleutel staat er voor het volledige verslag.";

		container Decoupling_RestrictiefWonen := /Templates/DecoupledFile_T(FileName_RestrictiefWonen, Fingerprint_RestrictiefWonen);

		attribute<bool>      Make_RestrictiefWonen (AdminDomain) := Calc_RestrictiefWonen, StorageName = "=FileName_RestrictiefWonen", StorageType = "tif", ExplicitSuppliers = "Decoupling_RestrictiefWonen/Write_Fingerprint", Descr = "Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<bool>      Read_RestrictiefWonen (AdminDomain) : StorageName = "=FileName_RestrictiefWonen", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      RestrictiefWonen      (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld ? 'Calc_RestrictiefWonen'
			:	Decoupling_RestrictiefWonen/MayReuse ? 'Read_RestrictiefWonen'
			:	                                       'Make_RestrictiefWonen'
		, Descr = "Binnen de milieucat-buffer (inclusief het terrein zelf) van een werklocatie met categorie 2 of hoger; daar is wonen in de basisjaar-zeef restrictief. Drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. Vraag Decoupling_RestrictiefWonen/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";

		//Milieugevoelige niet-woonfuncties (diensten, detailhandel, verblijfsrecreatie) worden alleen rond zware terreinen (categorie 4 en hoger) geweerd, met dezelfde VNG-buffer. Voorheen mochten die functies wel direct naast bestaand categorie-6-terrein, terwijl ze rond nieuw gealloceerde nijverheid juist gebufferd werden.
		unit<uint32> MetGevoeligBuffer := select_with_org_rel(MakeDefined(Milieucategorie_x10, 0b) >= 40b)
		{
			attribute<rdc_meter> geometrie    (poly) := geometry[org_rel];
			attribute<Meter>     BufferAfstand      := Buffer_Dist[org_rel];
			attribute<rdc_meter> Buffer_poly  (poly) := geos_buffer_multi_polygon(geometrie, float64(BufferAfstand), 4b);
		}
		attribute<bool>      Calc_RestrictiefGevoeligeWerkfuncties (AdminDomain) := IsDefined(poly2grid(MetGevoeligBuffer/Buffer_poly, AdminDomain)), Descr = "Binnen de milieucat-buffer van een werklocatie met categorie 4 of hoger; daar zijn milieugevoelige werkfuncties en verblijfsrecreatie in de basisjaar-zeef restrictief.";

		parameter<String> FileName_RestrictiefGevoeligeWerkfuncties := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/RestrictiefGevoeligeWerkfuncties_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

		parameter<String> Fingerprint_RestrictiefGevoeligeWerkfuncties :=
			  'ibis_year='        + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024'
			+ ';buffer_wonen_m='  + asList(string(/ModelParameters/Wonen/MilieuCat/Buffer_wonen), ',')
			+ ';milieucat_count=' + string(#/ModelParameters/Wonen/MilieuCat)
			+ ';milieucat_aanvulling=' + string(/ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend) + ':' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven) + ',' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
			+ ';min_cat=40'
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';study_area='      + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. min_cat is de hardgecodeerde drempel 4b in de selectie MetGevoeligBuffer; verandert die drempel in de code, pas dan ook deze sleutel aan. De bufferafstanden komen uit dezelfde VNG-tabel als bij RestrictiefWonen. ibis_sources benoemt de brondata per bruikbare jaargang en moet met de hand mee veranderen bij een nieuwe IBIS-levering.";

		container Decoupling_RestrictiefGevoeligeWerkfuncties := /Templates/DecoupledFile_T(FileName_RestrictiefGevoeligeWerkfuncties, Fingerprint_RestrictiefGevoeligeWerkfuncties);

		attribute<bool>      Make_RestrictiefGevoeligeWerkfuncties (AdminDomain) := Calc_RestrictiefGevoeligeWerkfuncties, StorageName = "=FileName_RestrictiefGevoeligeWerkfuncties", StorageType = "tif", ExplicitSuppliers = "Decoupling_RestrictiefGevoeligeWerkfuncties/Write_Fingerprint", Descr = "Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<bool>      Read_RestrictiefGevoeligeWerkfuncties (AdminDomain) : StorageName = "=FileName_RestrictiefGevoeligeWerkfuncties", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      RestrictiefGevoeligeWerkfuncties      (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld                 ? 'Calc_RestrictiefGevoeligeWerkfuncties'
			:	Decoupling_RestrictiefGevoeligeWerkfuncties/MayReuse ? 'Read_RestrictiefGevoeligeWerkfuncties'
			:	                                                       'Make_RestrictiefGevoeligeWerkfuncties'
		, Descr = "Binnen de milieucat-buffer van een werklocatie met categorie 4 of hoger; daar zijn milieugevoelige werkfuncties en verblijfsrecreatie in de basisjaar-zeef restrictief. Drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. Vraag Decoupling_RestrictiefGevoeligeWerkfuncties/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		attribute<float64>   Fractie_Uitgegeven             := Uitgegeven / netto_oppervlakte;
		attribute<bool>      IsVol_obvFractie               := Fractie_Uitgegeven >= ModelParameters/Werken/BedrijfsterreinUitgegevenFractieAlsVolBeschouwen;
		// attribute<bool>      IsVol                          := NOT(IsNietVol);
		// attribute<bool>      IsNietVol_grid   (AllocDomain) := IsNietVol[Per_AllocDomain];
		attribute<bool>      Calc_IsVol_grid  (AllocDomain) := (IsVol_obvFractie || IsVol)[Per_AllocDomain];

		parameter<String> FileName_IsVol_grid := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/IsVol_grid_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

		parameter<String> Fingerprint_IsVol_grid :=
			  'ibis_year='     + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024'
			+ ';vol_fraction=' + string(/ModelParameters/Werken/BedrijfsterreinUitgegevenFractieAlsVolBeschouwen)
			+ ';alloc_grid='   + /ModelParameters/Advanced/AllocDomain_ref
			+ ';grid_size='    + string(AllocDomain/gridsize)
			+ ';study_area='   + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. vol_fraction is de drempel waarboven een terrein op basis van de uitgegeven fractie als vol telt; het vol-veld uit IBIS zelf telt daarnaast altijd mee. De uitgiftekolommen waarop de fractie rust verschillen per jaargang en zitten via ibis_year en ibis_sources in de fingerprint. alloc_grid vangt dat een andere allocatieresolutie een ander bestand onder dezelfde naam zou opleveren.";

		container Decoupling_IsVol_grid := /Templates/DecoupledFile_T(FileName_IsVol_grid, Fingerprint_IsVol_grid);

		attribute<bool>      Make_IsVol_grid  (AllocDomain) := Calc_IsVol_grid, StorageName = "=FileName_IsVol_grid", StorageType = "tif", ExplicitSuppliers = "Decoupling_IsVol_grid/Write_Fingerprint", Descr = "Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<bool>      Read_IsVol_grid  (AllocDomain) : StorageName = "=FileName_IsVol_grid", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      IsVol_grid       (AllocDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld ? 'Calc_IsVol_grid'
			:	Decoupling_IsVol_grid/MayReuse       ? 'Read_IsVol_grid'
			:	                                       'Make_IsVol_grid'
		, Descr = "Ligt de allocatiecel op een IBIS-werklocatie die als vol telt, op het vol-veld of op de uitgegeven fractie boven de drempel. Drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. Vraag Decoupling_IsVol_grid/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		
		//Bestaande vergunde bedrijvigheid: de terreintypen waar nieuwe nijverheid of logistiek verdichting van bestaand gebruik is en geen nieuw milieuconflict oplevert. Retail-, onderwijs- en zorglocaties tellen hier bewust niet mee, en een cel buiten elk terrein is null en dus FALSE.
		attribute<bool>      Calc_IsBedrijfsmatigTerrein (AdminDomain) := MakeDefined(Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/Bedrijventerrein
																	|| Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/Zeehaventerrein
																	|| Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/EZ_platform_gebonden_bedrijvigheid
																	|| Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/EZ_agribusiness_complexen, FALSE)
													, Descr = "Ligt de cel op een bestaand werkterrein waar nijverheid en logistiek thuishoren. Gebruikt in de omgekeerde milieuzonering (#669), die daar vervalt omdat de VNG-richtafstanden niet gelden tegen bestaande vergunde bedrijvigheid.";

		parameter<String> FileName_IsBedrijfsmatigTerrein := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/IsBedrijfsmatigTerrein_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

		parameter<String> Fingerprint_IsBedrijfsmatigTerrein :=
			  'ibis_year='          + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024'
			+ ';bedrijfsmatig_types=Bedrijventerrein,Zeehaventerrein,EZ_platform_gebonden_bedrijvigheid,EZ_agribusiness_complexen'
			+ ';ibis_class_codes='  + asList(/Classifications/Grondgebruik/IBIS/code, ',')
			+ ';wloc_type_norm=v2_eerste_teken'
			+ ';admin_grid='        + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='         + string(AdminDomain/gridsize)
			+ ';study_area='        + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. bedrijfsmatig_types is de hardgecodeerde lijst terreintypen in de expressie; verandert die lijst, pas dan ook deze sleutel aan. ibis_class_codes is de codeset waarop Type_rel via rlookup wordt bepaald; een gewijzigde klassenindeling verandert de kaart zonder de bestandsnaam te raken. ibis_sources benoemt de brondata per bruikbare jaargang en moet met de hand mee veranderen bij een nieuwe IBIS-levering. wloc_type_norm is de versie van de normalisatieregel in WLOC_TYPE_code (#738); die regel bepaalt welke terreinen een klasse krijgen en dus welke cellen bedrijfsmatig heten, terwijl noch de codelijst noch de typenamen ervan veranderen. Wijzigt de regel, hoog dan het versienummer op, anders blijft een verouderde tif geldig ogen.";

		container Decoupling_IsBedrijfsmatigTerrein := /Templates/DecoupledFile_T(FileName_IsBedrijfsmatigTerrein, Fingerprint_IsBedrijfsmatigTerrein);

		attribute<bool>      Make_IsBedrijfsmatigTerrein (AdminDomain) := Calc_IsBedrijfsmatigTerrein, StorageName = "=FileName_IsBedrijfsmatigTerrein", StorageType = "tif", ExplicitSuppliers = "Decoupling_IsBedrijfsmatigTerrein/Write_Fingerprint", Descr = "Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<bool>      Read_IsBedrijfsmatigTerrein (AdminDomain) : StorageName = "=FileName_IsBedrijfsmatigTerrein", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      IsBedrijfsmatigTerrein      (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld       ? 'Calc_IsBedrijfsmatigTerrein'
			:	Decoupling_IsBedrijfsmatigTerrein/MayReuse ? 'Read_IsBedrijfsmatigTerrein'
			:	                                             'Make_IsBedrijfsmatigTerrein'
		, Descr = "Ligt de cel op een bestaand werkterrein waar nijverheid en logistiek thuishoren; de omgekeerde milieuzonering (#669) vervalt daar. Drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. Vraag Decoupling_IsBedrijfsmatigTerrein/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		
		unit<uint8> MilieuCat := ModelParameters/Wonen/MilieuCat;
	}
}