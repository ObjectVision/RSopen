container Natuur
{
	container Bron
	: Descr = "De leveringen per landschap: het inlezen van de kaarten en tabellen, de vertaling naar natuurbeheertypen, en de variant-onafhankelijke voorbereiding die daarbij hoort (de rangschikking van de rivierencellen, de zeven en de geschiktheid van zand, de kustvertaling). Hier wordt niets per variant gekozen: wat een variant ermee doet staat in Templates/VariantData/Natuur, geinstantieerd als VariantData/<variant>/NatuurLevering (#751).

				Water is een eigenschap van het beheertype (INL_Beheertype/IsWater), behalve bij rivieren: daar loopt die keuze over de categorie van het ecotoop, omdat het beheertype N01.03 Rivier- en moeraslandschap zowel terrestrische als waterecotopen verzamelt. Zie #621."
	{
		container Landelijk_BAU
		: Descr = "De MNP-planpotentieelkaart van de WUR: huidige natuur plus de volledige realisatie van alle geplande maatregelen, per beheertype. De levering van BAU en BAU2, de achtervang van NbSMax, en de tweede beheertypenkaart van het basisjaar naast het NBP (#776).

					De bron ligt op 2,5 meter en het model rekent op 25 meter, dus honderd broncellen per modelcel. Die samenvatting gebeurt in twee stappen die elk hun eigen vraag beantwoorden: Modus_25m kiest WELK beheertype de cel krijgt, Dekking_25m beslist OF de cel natuur is. Tot #795 deed modus() beide tegelijk, en dat ging mis omdat modus() nulls negeert: een cel waarvan een van de honderd broncellen gevuld was werd volledig natuur. De kaart won daar 212.188 ha mee, ruim vijftien procent, en kreeg het spikkelbeeld dat in Friesland het duidelijkst was, want daar liggen de akkerranden en de graslandpercelen van het agrarisch natuurbeheer als smalle stroken in de bron. De drempel staat als MinimumDekking in ModelParameters/Natuur/MNP_Kaart; daar staan ook de gemeten arealen.

					De kaart op 25 meter is sinds #795 een ontkoppeld bestand met een fingerprint, in LocalDataProjDir en niet meer naast de bron op de share. Twee redenen: de uitkomst hangt nu van een modelparameter af, en de tif draagt rijnummers van INL_Beheertype, dus een rij erbij in die classificatie maakte het oude bestand stil verkeerd. De fingerprint vangt allebei."
		{
			parameter<UInt32> MinimumDekking := /ModelParameters/Natuur/MNP_Kaart/MinimumDekking;

			attribute<uint8> NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel0 (rdc_2_5m)
			:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel_20250925_110353.tif"
			,	Source          = "WUR"
			, 	Descr           = "Dit bestand dient als de ruimtelijke mal voor de natuurvlakken binnen de visie NL2120. Het representeert de geografische afbakening van waar natuur aanwezig is of gepland is binnen de vigerende beleidskaders."
			, 	LazyCalculated  = "true";

			attribute<INL_Beheertype>  NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel (rdc_2_5m) := rlookup(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel0, INL_Beheertype/MNP_BeheertypenKaart_val);

			attribute<UInt32> Dekking_25m (rdc_25m) := sum(uint32(IsDefined(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel)), rdc_2_5m/rdc_25m_rel)
			, Descr = "Hoeveel van de honderd broncellen binnen deze modelcel een beheertype dragen. Nul waar de bron zwijgt, want een som over een lege groep is nul en geen null.";

			attribute<INL_Beheertype> Modus_25m (rdc_25m) := modus(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel, rdc_2_5m/rdc_25m_rel)
			, Descr = "Welk beheertype de meeste broncellen binnen deze modelcel dragen. Nulls tellen daarbij niet mee, dus dit is de meerderheid BINNEN het natuurdeel van de cel. Dat is precies wat je van een typekeuze wilt; de vraag of de cel uberhaupt natuur is beantwoordt Dekking_25m.";

			attribute<INL_Beheertype> Calc_INL_beheertypen_25m (rdc_25m) := Dekking_25m >= MinimumDekking ? Modus_25m : null_b[INL_Beheertype]
			, Descr = "De kaart op 25 meter: het meerderheidstype, maar alleen op cellen die genoeg gevuld zijn. Dit is het rekenwerk dat de ontkoppelde tif hieronder eenmalig vastlegt; het kost ongeveer drie minuten, want de bron telt ruim veertien miljard cellen.";

			parameter<String> FileName_INL_beheertypen_25m := '%LocalDataProjDir%/BaseData/Grondgebruik/MNP/mnp_bau_INL_Beheertype_25m_dekking' + string(MinimumDekking) + '_' + /ModelParameters/StudyArea + '.tif'
			, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. De drempel staat in de naam, zodat twee instellingen naast elkaar kunnen blijven staan.";

			parameter<String> Fingerprint_INL_beheertypen_25m :=
				  'bron='             + PropValue(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel0, 'StorageName')
				+ ';minimum_dekking=' + string(MinimumDekking)
				+ ';mnp_val='         + AsList(MakeDefined(string(INL_Beheertype/MNP_BeheertypenKaart_val), 'null'), ',')
				+ ';beheertypen='     + AsList(INL_Beheertype/code, ',')
				+ ';study_area='      + /ModelParameters/StudyArea
			, Descr = "Wat de tif bepaalt: het bronbestand, de dekkingsdrempel, de koppelkolom van de rasterwaarden naar de beheertypen, de nummering van INL_Beheertype (de tif draagt rijnummers) en het studiegebied. Een rij erbij in die classificatie maakt de tif dus ongeldig in plaats van stil verkeerd.";

			container Decoupling_INL_beheertypen_25m := /Templates/DecoupledFile_T(FileName_INL_beheertypen_25m, Fingerprint_INL_beheertypen_25m);

			attribute<INL_Beheertype> Make_INL_beheertypen_25m (rdc_25m) := Calc_INL_beheertypen_25m, StorageName = "=FileName_INL_beheertypen_25m", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_INL_beheertypen_25m/Write_Fingerprint"
			, Descr = "Schrijft de kaart eenmalig weg. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
			attribute<INL_Beheertype> Read_INL_beheertypen_25m (rdc_25m) : StorageName = "=FileName_INL_beheertypen_25m", StorageType = "gdal.grid", StorageReadOnly = "true";
			attribute<INL_Beheertype> INL_beheertypen_25m      (rdc_25m) := = Decoupling_INL_beheertypen_25m/MayReuse ? 'Read_INL_beheertypen_25m' : 'Make_INL_beheertypen_25m'
			, Descr = "De kaart zoals het model haar gebruikt, ontkoppeld. Vraag Decoupling_INL_beheertypen_25m/Explanation op als je wilt weten waarom de tif wel of niet opnieuw wordt gemaakt.";

			attribute<INL_Beheertype>  INL_Beheertype_rel_AD (AdminDomain) := INL_beheertypen_25m[AdminDomain/rdc_25m_rel]
			, Descr = "Dezelfde kaart op het administratiedomein. Staat AdminDomain op 25 meter, dan is dat een een-op-een-koppeling; op 100 meter pakt hij de 25-metercel waar de grovere cel op valt, net als de storage-read die hier tot #795 stond.";

			container Controle
			: Descr = "Wat de dekkingsdrempel met het areaal doet, over de hele kaart en dus zonder het studiegebiedmasker. Twee tabellen, met opzet gescheiden naar wat ze kosten. Vraag Tabel op voor de goedkope kant: die leest alleen de ontkoppelde kaart en kost seconden, en hij toetst meteen of de leeskant naar het administratiedomein werkt. Vraag Tabel_Bron op voor de vergelijking met de bron zelf; die leest ruim veertien miljard cellen op 2,5 meter en kost enkele minuten."
			{
				parameter<Float64> Kaart_ha   := sum(IsDefined(INL_beheertypen_25m)   ? 0.0625d : 0d), Descr = "Het areaal met een beheertype in de kaart zoals het model haar gebruikt. Gemeten 8 september 2026 bij drempel 50: 1.402.011 ha.";
				parameter<Float64> KaartAD_ha := sum(IsDefined(INL_Beheertype_rel_AD) ? float64(AdminDomain/NrHaPerCell / 1[Ha]) : 0d), Descr = "Hetzelfde op het administratiedomein, dus na de stap die de lezers van deze container zetten. Zolang AdminDomain op 25 meter staat hoort dit exact gelijk te zijn aan Kaart_ha; wijkt het af, dan doet de domeinkoppeling iets anders dan bedoeld.";

				parameter<String> Tabel :=
					  'grootheid;waarde'
					+ '\nminimum_dekking;' + string(MinimumDekking)
					+ '\nkaart_ha_25m;'    + string(Kaart_ha)
					+ '\nkaart_ha_ad;'     + string(KaartAD_ha)
				, StorageName = "='%LocalDataProjDir%/Diagnose/795_mnp_kaart.txt'", StorageType = "str";

				container Bron
				: Descr = "De vergelijking met de bron op 2,5 meter: wat de drempel wegneemt en of wat overblijft nog op het bronareaal uitkomt."
				{
					parameter<Float64> Bron_ha          := sum(float64(IsDefined(NL2120_MNP_BAU_beheertypen_alle_maatregelen_planpotentieel))) * 0.000625d, Descr = "Het areaal met een beheertype in de bron zelf. Gemeten 8 september 2026: 1.400.397 ha.";
					parameter<Float64> ZonderDrempel_ha := sum(Dekking_25m > 0 ? 0.0625d : 0d), Descr = "Wat de kaart op 25 meter zou worden zonder drempel, dus zoals hij tot #795 was. Gemeten: 1.612.584 ha, ruim vijftien procent te veel.";
					parameter<Float64> MetDrempel_ha    := sum(Dekking_25m >= MinimumDekking ? 0.0625d : 0d), Descr = "En met de drempel die nu geldt. Gemeten bij 50: 1.402.011 ha.";

					parameter<String> Tabel_Bron :=
						  'grootheid;waarde'
						+ '\nminimum_dekking;'   + string(MinimumDekking)
						+ '\nbron_ha_op_2_5m;'   + string(Bron_ha)
						+ '\nzonder_drempel_ha;' + string(ZonderDrempel_ha)
						+ '\nmet_drempel_ha;'    + string(MetDrempel_ha)
						+ '\nafwijking_ha;'      + string(MetDrempel_ha - Bron_ha)
					, StorageName = "='%LocalDataProjDir%/Diagnose/795_mnp_dekking.txt'", StorageType = "str";
				}
			}
		}

		unit<uint32> Rivieren_BAU_mmd
		:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/BAU-Natuur.mmd"
		, 	StorageReadOnly = "true"
		,	Source          = "Ontvangen van Deltares op 20260611"
		, 	Descr           = "Natuur_Y2120_Rivierengebied_BAU";
		unit<uint32> Rivieren_BAU := Rivieren_BAU_mmd
		{
			attribute<HydrologieK>    Hydrologie_rel    := rlookup(hydrologie, HydrologieK/label);
			attribute<EcotoopK>       Ecotoop_rel       := rlookup(NL_2120, EcotoopK/label);
			attribute<GeomorfologieK> Geomorfologie_rel := rlookup(zonering, GeomorfologieK/label);
			attribute<bool>           IsNat              := HydrologieK/IsOever[Hydrologie_rel] || Geomorfologie_rel == GeomorfologieK/V/Oevers; // Nat = oeverzone (HydrologieK/IsOever) of geomorfologische zone 'Oevers'. 'Oeverwal/hoge uiterwaard' is droog.
		
			unit<uint8> HydrologieK := unique_uint8(hydrologie)
			{
				attribute<string> label := values;
				attribute<bool>   IsOever := substr(label, 0, 5) == 'Oever', Descr = "Natte oeverzone: alle 'Oever - ...'-klassen. Onderscheidt nat/droog t.b.v. de beheertype-keuze.";
				container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			}
			unit<uint8> EcotoopK := unique_uint8(NL_2120)
			{
				attribute<string> label := values;
				container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			}
			unit<uint8> GeomorfologieK := unique_uint8(zonering)
			{
				attribute<string> label := values;
				container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
			}
		
			attribute<INL_Beheertype> INL_Beheertype_rel := 
				switch(
						case(Ecotoop_rel == EcotoopK/V/Moeras                                 , INL_Beheertype/V_obvCode/N05_04) // dynamisch moeras
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_bos && IsNat                , INL_Beheertype/V_obvCode/N14_01) // rivier-/beekbegeleidend bos (zachthoutooibos)
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_bos                         , INL_Beheertype/V_obvCode/N14_03) // haagbeuken-/essenbos (hardhoutooibos)
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_grasland && IsNat           , INL_Beheertype/V_obvCode/N10_02) // vochtig hooiland
					,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_grasland                    , INL_Beheertype/V_obvCode/N12_02) // kruiden-/faunarijk grasland
					,case(Ecotoop_rel == EcotoopK/V/Onbegroeid_pionier_natuurlijk_ && IsNat, INL_Beheertype/V_obvCode/N05_01_14 ) // slikkige rivieroever
					,case(Ecotoop_rel == EcotoopK/V/Onbegroeid_pionier_natuurlijk_         , INL_Beheertype/V_obvCode/N05_01_13) // open zand
					,case(Ecotoop_rel == EcotoopK/V/Ruigte                                 , INL_Beheertype/V_obvCode/N12_06) // ruigteveld
					,case(Ecotoop_rel == EcotoopK/V/Struweel_houtig_                       , INL_Beheertype/V_obvCode/N05_01_06) // moerasstruweel (wilg)
					,case(Ecotoop_rel == EcotoopK/V/Stagnant_water                         , INL_Beheertype/V_obvCode/N04_02) // zoete plas
					,case(Ecotoop_rel == EcotoopK/V/Zomerbed                               , INL_Beheertype/V_obvCode/N02_01) // rivier
					, null_b // agrarisch gebruik/grasland en bebouwd = geen natuur -> geen beheertype
				);
		
			attribute<.>              Per_AdminDomain       (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
		}
	
		unit<uint32> Rivieren_NbSMax 
		:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbS/Natuur_Y2120_Rivierengebied_NbSMax_20260629.shp"
		, 	StorageType     = "gdal.vect"
		,	Source          = "Ontvangen van Deltares op 20260528"
		, 	Descr           = "In de bijlage de kaartlaag voor NbS Max. Voor BaU nemen we de bestaande riviertranches (zie ook bestand) en de verdere veranderingen in het 
									BaU ruimtescanner scenario. Het GIS bestand heeft 3 lagen 'nieuwe uiterwaarden, moerasgebieden en water'. 
									In deze gebieden moet de bestaande bebouwing verdwijnen (uitkoop) en zijn er toekomstige bouwrestricties. 
									De moerasgebieden zijn ook tevens waterberginggebieden. Ook de landbouwfunctie verdwijnt in deze gebieden. 
									Ze moeten nog aangeven welk percentage welk type natuur wordt. Ga er vanuit dat dit een combinatie wordt van 
									open zand/grindvlakte, ruigte, grasland, zachthoutooibos, hardhoutooibos, zomerbed (water) en uiterwaardwater. 
									Volgens mij is het voor de meeste indicatoren nu niet relevant welk natuurtype het precies wordt. 
									Met uitzondering van koolstofvastlegging."
		, DialogData = "rdc_meter"
		{
			attribute<.>      Per_AdminDomain   (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<INL_Beheertype> INL_Beheertype_rel := switch(
																	case(lowercase(type) == 'moeras',              rlookup('N05.04',    INL_Beheertype/code)) // moerasgebied -> dynamisch moeras
																,case(lowercase(type) == 'uiterwaarden',        rlookup('N12.02',    INL_Beheertype/code)) // nieuwe uiterwaard (mix) -> kruiden-/faunarijk grasland als representatieve klasse
																,case(lowercase(type) == 'water (beek bypass)', rlookup('N03.01',    INL_Beheertype/code)) // nevengeul -> beek en bron
																, null_b
															);
			attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
		}
	

		// De SqlString doet drie dingen die niet vanzelf spreken, zie #613.
		// 1. Hernoemen. De kolomnamen in de bron beginnen met een cijfer en zijn dus geen geldige DMS-itemnamen. Ze gaan naar
		//    BS2, BS3a en verder, gelijk aan NbSVeen/NbSBouwsteen/name, en meteen van percentage naar fractie. Kolommen die in
		//    een van beide lagen ontbreken komen als 0.0 mee, zodat beide lagen dezelfde twaalf bouwstenen kennen.
		// 2. Ontdubbelen. In de peilvakkenlaag komen 201 geometrieen meer dan een keer voor, bij 104 daarvan met verschillende
		//    percentages. Deltares laat weten dat de middelste rij de juiste is; dat is wat rn = (cnt + 1) / 2 selecteert.
		//    8439 rijen worden zo 7666. Gemeten scheelt de keuze tussen eerste, middelste en laatste minder dan een half
		//    procent per bouwsteen, dus dit is vooral een kwestie van reproduceerbaar vastleggen.
		// 3. Sorteren op oppervlak, groot eerst. De bron bevat geneste polygonen: een groot peilvak zonder bouwsteen 9a met
		//    daarbinnen kleine waterpolygonen die volledig 9a zijn. poly2grid laat de laatste polygoon winnen, dus zonder
		//    deze ordening wist het grote peilvak de kleine eronder uit en verdween er 1.500 ha bouwsteen 9a. Klein moet dus
		//    als laatste komen. Het gaat in totaal om 2.252 ha overlappend oppervlak.
		
		container Rivieren_NbSGenuanceerd
		: Descr = "De levering van team Rivieren voor NbSGenuanceerd: 59 gebieden met per gebied een verdeling over vijftien ecotopen. Zie #621.

				Naast het inlezen staat hier sinds #751 ook wat er variant-onafhankelijk mee gebeurt: de cellen binnen elk gebied op natheid rangschikken en de cumulatieve aandelen erop leggen (Ecotoop_rel_AD), het sloopgebied uit #620 en de controles. Wat de variant ermee doet, het type per cel en de watervlag, staat in Templates/VariantData/Natuur/Rivieren_T.

				De levering geeft per gebied geen kaart maar een verdeling: het aandeel van elk van de vijftien ecotooptypen, samen 100 procent. Het model werkt per cel met een klasse en niet met een mengsel, dus die verdeling moet naar een kaart. Dat gebeurt door de cellen binnen elk gebied te rangschikken op natheid en de cumulatieve aandelen op die volgorde te leggen: de natste cellen krijgen het zomerbed, de droogste het bebouwde en agrarische deel, en daartussen de reeks van NbSRivieren/Gradient. Omdat er geteld wordt en niet gedrempeld, kloppen de arealen per gebied tot op een cel na, en omdat er op natheid geordend wordt ontstaat een zonering in plaats van ruis. Tot 26 augustus 2026 stond hier een trekking; de arealen klopten, maar het kaartbeeld was onbruikbaar, met ooibos als losse vlekken van 25 bij 25 meter tussen het grasland."
		{
				container Levering
				: StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Rivieren_Ecotopen_Beheertypen_NbSgenuanceerd_20260825.gpkg"
				, StorageType     = "gdal.vect"
				, StorageReadOnly = "TRUE"
				, Source          = "Deltares, team Rivieren NL2120. Oorspronkelijke bestandsnaam riviertraces_en_binnendijks_zonder_altena_ecotopen_beheertypen.gpkg, geleverd op 2026-08-25 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/NiewueNatuurRiviertenNbSGenuanceerd. Naast de geopackage horen bij dezelfde levering drie tabellen, die in dezelfde map staan: Rivieren_Ecotoopoppervlakten_NbSgenuanceerd_20260825.xlsx met de arealen, Rivieren_Ecotooptypen_typologie_NbSgenuanceerd_20260825.xlsx met de typologie en Rivieren_Natuurbeheertypen_naar_ecotopen_20260825.xlsx met de conversietabel. De inhoud van die laatste twee staat in Classifications/Grondgebruik/RivierEcotoop.dms."
				, DialogData      = "rdc_meter"
				{
					unit<uint32> gebied
					: SqlString = "select coalesce(\"% Natuurlijk grasland\", 0) as Fr_NatuurlijkGrasland, coalesce(\"% Stroomdalgrasland\", 0) as Fr_Stroomdalgrasland, coalesce(\"% Agrarisch grasland\", 0) as Fr_AgrarischGrasland, coalesce(\"% Agrarisch gebruik\", 0) as Fr_AgrarischGebruik, coalesce(\"% Hardhout ooibos\", 0) as Fr_HardhoutOoibos, coalesce(\"% Zachthout ooibos\", 0) as Fr_ZachthoutOoibos, coalesce(\"% Struweel (houtig)\", 0) as Fr_Struweel, coalesce(\"% Moeras\", 0) as Fr_Moeras, coalesce(\"% Onbegroeid & pionier (natuurlijk)\", 0) as Fr_OnbegroeidPionier, coalesce(\"% Ruigte nat\", 0) as Fr_RuigteNat, coalesce(\"% Ruigte droog\", 0) as Fr_RuigteDroog, coalesce(\"% Zomerbed rivier\", 0) as Fr_ZomerbedRivier, coalesce(\"% Stromend water\", 0) as Fr_StromendWater, coalesce(\"% Stagnant water\", 0) as Fr_StagnantWater, coalesce(\"% Bebouwd/verhard/antropogeen\", 0) as Fr_BebouwdVerhard, \"type\" as gebiedtype, join_id, geom from riviertraces_binnendijks_ecotopen_beheertypen order by ST_Area(geom) desc"
					, Descr = "De 59 gebieden met hun ecotoopverdeling. De SqlString doet twee dingen. Ten eerste hernoemen: de kolomnamen in de bron beginnen met een procentteken en zijn dus geen geldige DMS-itemnamen; ze gaan naar Fr_ plus de naam uit RivierEcotoop. Ten tweede sorteren op oppervlak, groot eerst, zodat een klein gebied dat binnen een groot ligt bij het rasteren wint. In deze levering overlappen de gebieden elkaar niet, maar dezelfde valkuil kostte bij het veengebied 1.500 ha, zie #613. Controle/PerEcotoop bewaakt dat.";
				}

				unit<uint32> DijkenBehouden
				:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Rivieren_DijkenBehouden_NbSgenuanceerd_20260826.shp"
				,  StorageType     = "gdal.vect"
				,  StorageReadOnly = "True"
				,  DialogType      = "Map"
				,  DialogData      = "geometry"
				,  Source          = "Deltares, team Rivieren NL2120. Oorspronkelijke bestandsnaam dijken_behouden.shp, geleverd op 2026-08-28 in dijken_behouden2.zip via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf."
				,  Descr           = "De dijken die behouden blijven, 31 polygonen en samen 566 ha. Overwegend langgerekte stroken van dertig tot vijftig meter breed en enkele kilometers lang, plus twee compactere vlakken van 110 en 30 ha. Ze liggen op de grens tussen de nieuwe uiterwaarden en de riviertrajecten: 231 ha valt binnen de 36 binnendijkse gebieden, 152 ha binnen de 23 riviertrajecten en 183 ha buiten de levering.
									De dbf heeft twee velden, id en maatregel, en die zijn op een record na leeg. Er valt dus niets te selecteren en het hele bestand geldt als behouden dijk. Wat de levering met deze shape wil staat in Sloopgebied hieronder; zie #620."
				{
					attribute<rdc_meter> geometry        (poly);
					attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
				}

				unit<uint32> Moerasnatuur
				:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Rivieren_Landbouwtransitie_NbSgenuanceerd_20260908.gpkg"
				,  StorageType     = "gdal.vect"
				,  StorageReadOnly = "True"
				,  SqlString       = "select join_id, ha_totaal, geom from landbouwtransitie where bron = 'binnendijks moerasnatuurgebied' order by ST_Area(geom) desc"
				,  DialogType      = "Map"
				,  DialogData      = "geometry"
				,  Source          = "Deltares en Staatsbosbeheer, team Rivieren NL2120. Oorspronkelijke bestandsnaam toekomstbeeld_genuanceerd_landbouwtransitie.gpkg, per mail geleverd op 2026-09-06 als antwoord op de vraag uit #791 wat er in NbSGenuanceerd met de landbouw gebeurt. Bij de geopackage hoort de tabel Rivieren_Landbouwtransitie_Klassen_NbSgenuanceerd_20260908.xlsx in dezelfde map, met de klassenindeling en de arealen per gebied van klasse C."
				,  Descr           = "De 43 binnendijkse moerasnatuurgebieden, samen 7.810 ha: klasse A van de levering, functieverandering naar natuur, waarbij het landbouwkundig gebruik volledig verdwijnt.

									Dit is het enige nieuwe ruimtebeslag in de levering van 6 september 2026. De 59 gebieden ernaast, de 23 riviertrajecten en de 36 binnendijkse gebieden, zijn dezelfde als in Levering hierboven: hun arealen per gebied en hun ecotoopaandelen zijn tot op de decimaal gelijk aan de levering van 25 augustus. Nieuw is alleen de indeling in klassen, en die beschrijft wat het model al doet. Klasse B, 54 gebieden en 76.470 ha, wordt volgens de levering zeer extensief (natuurlijke begrazing en cyclisch beheer, uitdrukkelijk geen productielandbouw) en gaat hier als natuur- en waterecotoop de oplegging in. Klasse C, vijf binnendijkse gebieden, houdt 8.566 ha regulier landbouw over, precies de som van de ecotopen Agrarisch grasland en Agrarisch gebruik die de rangschikking op het droge eind van die gebieden neerzet. Dat samen is het antwoord op de vraag van #791 voor het landschap Rivieren.

									De moerasnatuurgebieden overlappen de 59 gebieden niet: de aanleverende partij heeft ze ontdubbeld en de 495 ha overlap met de riviertrajecten eraf gehaald. Op de vector nagemeten, doorsnede nul.

									Ze dragen geen ecotoopverdeling, dus geen rangschikking op natheid en geen gradient; ze krijgen als geheel het beheertype uit ModelParameters/Natuur/Moerasnatuur_Rivieren/Beheertypecode. Ze gaan wel mee in IsRivierIngreep en daarmee op slot voor nieuwbouw, maar niet in het sloopgebied: #620 beperkt de sloop tot de 36 binnendijkse gebieden en deze levering zei daar niets over bebouwing. Team Rivieren heeft dat op 9 september 2026 via Deltares bevestigd in #791: onder binnendijks moeras wordt zo min mogelijk gesloopt. De bestaande bebouwing blijft hier dus staan. Grens_Rivieren in SourceData/Landschap blijft bewust op de ecotopenlevering plus de behouden dijken staan; dat is de indeling van #705, die sinds #760 als rapportage-indeling is vervangen door de aangeleverde landschapsgrenzen."
				{
					attribute<rdc_meter> geometry        (poly);
					attribute<Ha>        opp                           := area(geometry, meter2_f64)[Ha];
					attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
				}

			parameter<bool> NeemMoerasnatuurMee := TRUE
			, Descr = "Doen de 43 moerasnatuurgebieden mee? Staat aan, want het is de levering. Uitzetten geeft het ruimtebeslag van voor 6 september 2026 terug en is daarmee het instrument om te meten wat deze uitbreiding kost.

						Gemeten op 8 september 2026 met deze schakelaar aan en uit, op NatuurLevering/Controle van NbSGenuanceerd: de levering gaat van 501.221 naar 508.930 ha, dus 7.710 ha erbij, en wat de stand verandert van 439.792 naar 446.820 ha. Het ruimtebeslag zelf is 7.816 ha op 25 meter; het verschil van 106 ha ligt in gebieden waar kust, zand nat of veen in de voorrangsvolgorde van NatuurLevering/Levering al iets leverde, en 692 ha is in het basisjaar al natuur. Van het ruimtebeslag is 6.425 ha in het basisjaar landbouwgrond, en dat is wat deze gebieden de landbouw kosten.";

			attribute<bool> IsMoerasnatuur (AdminDomain) := NeemMoerasnatuurMee && IsDefined(Moerasnatuur/Per_AdminDomain)
			, Descr = "Cel waarvan het middelpunt in een moerasnatuurgebied valt.";

			parameter<INL_Beheertype> Moerasnatuur_Type := rlookup(/ModelParameters/Natuur/Moerasnatuur_Rivieren/Beheertypecode, INL_Beheertype/code)
			, IntegrityCheck = "IsDefined(this)"
			, Descr = "Het beheertype van de moerasnatuurgebieden, opgezocht op code. De IntegrityCheck faalt als de code niet in de Index Natuur en Landschap voorkomt.";

			parameter<bool> NeemBinnendijksMee := TRUE
			, Descr = "Tellen naast de buitendijkse riviertrajecten ook de binnendijkse gebieden mee? Staat aan, want de levering bevat ze en het landschapstype gaat er expliciet over.

						Uitzetten haalt 23.886 ha uit het ruimtebeslag, ruim een kwart, en daarmee ook de enige
						agrarische rest in de levering. De aanleverende partij tekent bij de binnendijkse set aan dat
						het een gefilterde selectie van 36 gebieden is en niet dezelfde reeks als in NbSMax, dus voor
						een vergelijking tussen varianten is deze schakelaar het aangewezen instrument.";

			parameter<uint32> Trekking_Seed := /ModelParameters/Natuur/Trekking/Rivieren/Trekking_Seed
			, Descr = "Vaste seed voor de ruis die gelijke natheidswaarden uit elkaar trekt. Zonder ruis krijgen cellen met dezelfde diepte een willekeurige maar niet-reproduceerbare volgorde; met een vaste seed geeft dezelfde configuratie altijd dezelfde kaart.";

			parameter<float32> Ruis_Amplitude := /ModelParameters/Natuur/Trekking/Rivieren/Ruis_Amplitude
			, Descr = "Hoe zwaar de ruis meeweegt in de rangschikking, in meters natheid. Klein gehouden: hij hoort alleen gelijke waarden uit elkaar te trekken, niet de zonering te verstoren. Grote vlakken met exact dezelfde diepte, zoals de binnendijkse gebieden zonder dieptedata, worden hierdoor niet in een strakke band opgedeeld maar krijgen een gevlekt patroon binnen hun klasse.";

			parameter<Meter> Natheid_Water_Bonus := /ModelParameters/Natuur/Trekking/Rivieren/Natheid_Water_Bonus
			, Descr = "Opslag voor cellen die in het basisjaar al open water zijn. Die horen bovenaan de natheidsrangorde, want daar ligt het zomerbed en het stromende water. De opslag ligt boven de diepste dieptewaarde die in de kaart voorkomt, zodat bestaand water altijd voorgaat.";

			// ---- welke cellen doen mee ----
			attribute<bool> IsBinnendijks (Levering/gebied) := Levering/gebied/gebiedtype == 'Binnendijks', Descr = "Het veld type heeft twee waarden: Buitendijks voor de 23 riviertrajecten, Binnendijks voor de 36 overige gebieden.";
			attribute<bool> IsBuitendijks (Levering/gebied) := !IsBinnendijks, Descr = "Hier per record negeren en niet pas op het raster: buiten het ruimtebeslag levert de negatie van een lege verwijzing TRUE op.";
			attribute<bool> IsMeegenomen  (Levering/gebied) := !IsBinnendijks || NeemBinnendijksMee;

			attribute<Levering/gebied> Gebied_rel_Bron (AdminDomain) := poly2grid(Levering/gebied/geometry, AdminDomain);
			attribute<Levering/gebied> Gebied_rel      (AdminDomain) := MakeDefined(IsMeegenomen[Gebied_rel_Bron], FALSE) ? Gebied_rel_Bron : null_u[Levering/gebied]
			, Descr = "Het gebied waar de cel in valt, na de schakelaar NeemBinnendijksMee. Eerst per record beslissen en dan pas naar het raster: de negatie andersom levert buiten het ruimtebeslag TRUE op.";

			attribute<bool> WordtGeordend (AdminDomain) := IsDefined(Gebied_rel) && /Geography/rdc_meter/IsStudyArea_AdminDomain, Descr = "De cellen die een ecotoop krijgen: het hele ruimtebeslag binnen het studiegebied.";

			// ---- de natheid waarop gerangschikt wordt ----
			unit<uint64> RivierCel := select_with_org_rel(WordtGeordend)
			, Descr = "Alleen de cellen die meedoen, ongeveer 3,5 miljoen. Het sorteren gebeurt hier en niet op AdminDomain; dat scheelt een factor veertig."
			{
				attribute<AdminDomain> AdminDomain_rel               := org_rel;
				attribute<.>           Per_AdminDomain (AdminDomain) := invert(org_rel);
			}

			attribute<Levering/gebied> Gebied_Cel (RivierCel) := Gebied_rel[RivierCel/AdminDomain_rel], IntegrityCheck = "all(IsDefined(this))";
			attribute<bool>                IsBinnendijks_Cel (RivierCel) := MakeDefined(IsBinnendijks[Gebied_Cel], FALSE);
			attribute<bool>                IsWater_Cel (RivierCel) := Basisjaar/IsWater[RivierCel/AdminDomain_rel];

			attribute<Meter> Diepte_Cel (RivierCel) :=
				IsBinnendijks_Cel
					? /SourceData/Water/Dieptekaart[RivierCel/AdminDomain_rel]
					: MakeDefined(/SourceData/Water/Waterdiepte_A_PrimairOnbeschermd[RivierCel/AdminDomain_rel], /SourceData/Water/Dieptekaart[RivierCel/AdminDomain_rel])
			, Descr = "De overstromingsdiepte als maat voor de hoogteligging binnen de uiterwaard: dieper is lager en natter.

						Buitendijks de A-kaart van het onbeschermde hoofdwatersysteem, met de gecombineerde kaart
						als achtervang waar A leeg is. Binnendijks alleen de gecombineerde kaart, want daar dekt A
						maar een deel. Dit las tot #665 Dieptekaart0, omdat Dieptekaart toen alles boven tien meter
						op null zette en dat juist de diepste cellen zijn, die hier bovenaan de rangorde horen. Die
						klem is nu verhuisd naar de waterberging, waar hij hoort, en Dieptekaart houdt alleen de
						onzinwaarden uit de C-kaart tegen. Dat is hier de betere bron: 147 miljoen meter hoort net
						zomin bovenaan de rangorde.";

			parameter<string> Waterkern_Straal := /ModelParameters/Natuur/Trekking/Rivieren/Waterkern_Straal
			, Descr = "Over welke straal gemeten wordt hoezeer een watercel door water omringd is.

						Nodig omdat alle watercellen anders even nat zijn en dus op een hoop belanden. De diepte
						helpt daar niet: de overstromingskaart heeft in de geul zelf vaak geen waarde, want die
						kaart gaat over land dat onderloopt. Daardoor werd de keuze welke watercel het zomerbed
						wordt en welke stagnant water door de ruis bepaald, en dat gaf een gespikkelde zoom langs
						de oever in plaats van een gevulde geul.

						Honderdvijftig meter is ruim de halve breedte van de Waal, dus het midden van de geul komt
						op bijna 1 uit en de oeverzone loopt naar 0 af. Kleiner maakt het onderscheid tussen kern
						en rand te scherp, groter smeert het uit over de uiterwaard.";

			parameter<Meter> Waterkern_Bonus := /ModelParameters/Natuur/Trekking/Rivieren/Waterkern_Bonus
			, Descr = "Hoeveel de waterkern bovenop de wateropslag meetelt. Watercellen komen daarmee tussen 12 en 18 meter natheid te liggen, dus altijd boven land, en binnen het water bepaalt de kern de volgorde: het midden van de geul wordt zomerbed, de randen worden stromend en stagnant water.";

			attribute<float32> Waterkern_AD (AdminDomain) :=
				='potential(float32(Basisjaar/IsWater), /Geography/Distmatrices_25m/pot' + Waterkern_Straal + '/Flat2)
					/ /Geography/Distmatrices_25m/pot' + Waterkern_Straal + '/oppervlakte'
			, Descr = "Het aandeel water in een schijf rond de cel, tussen 0 en 1. Hoog in het midden van een brede geul, laag aan de oever en in smalle strangen.";

			attribute<Meter> Natheid_Cel (RivierCel) := MakeDefined(Diepte_Cel, 0[Meter]) + (IsWater_Cel ? Natheid_Water_Bonus + Waterkern_Bonus * Waterkern_AD[RivierCel/AdminDomain_rel] : 0[Meter])
			, Descr = "Hoe nat is deze cel. Bestaand open water gaat voor op alles, daarna de diepte. Cellen zonder dieptewaarde tellen als droogst; zie Controle/Areaal_ZonderDiepte voor hoeveel dat er zijn.";

			attribute<float32> Ruis_Cel (RivierCel) := ='rnd_uniform(' + string(Trekking_Seed) + ', RivierCel, range(float32, 0f, 1f))';

			parameter<string> Natheid_Straal := /ModelParameters/Natuur/Trekking/Rivieren/Natheid_Straal
			, Descr = "Over welke straal de natheid wordt gemiddeld voordat er gerangschikt wordt.

						De dieptekaart varieert op celniveau sterker dan de hoogteligging doet. Rangschikken op de
						kale celwaarde geeft daardoor vertanding tussen aangrenzende zones: naast elkaar liggende
						cellen wisselen van klasse omdat hun diepte een decimeter verschilt. Middelen over een
						schijf haalt die ruis eruit en laat de vorm van de uiterwaard staan.

						Vijftig meter is een schijf van 0,8 ha, ruim genoeg om celruis weg te halen en klein
						genoeg om een uiterwaard van een paar honderd meter breed niet plat te strijken. Op pot0m
						zetten schakelt het uit; dan telt alleen de cel zelf.";

			attribute<float32> Natheid_AD (AdminDomain) := WordtGeordend ? Natheid_Cel[RivierCel/Per_AdminDomain] / 1[Meter] : 0f
			, Descr = "De natheid terug op het volle raster, nul buiten het ruimtebeslag. Nodig omdat potential op een grid werkt en niet op het celdomein.";

			attribute<float32> Natheid_Glad_AD (AdminDomain) :=
				='potential(Natheid_AD, /Geography/Distmatrices_25m/pot' + Natheid_Straal + '/Flat2)
					/ max_elem(potential(float32(WordtGeordend), /Geography/Distmatrices_25m/pot' + Natheid_Straal + '/Flat2), 1f)'
			, Descr = "Het gemiddelde van de natheid over de schijf, alleen over de cellen die in het ruimtebeslag vallen. De deling door hetzelfde potentiaal van het masker maakt er een echt gemiddelde van; zonder die correctie zou een cel aan de rand van de uiterwaard omlaag getrokken worden door de nullen erbuiten.";

			attribute<float32> Ordening_Cel (RivierCel) := Natheid_Glad_AD[RivierCel/AdminDomain_rel] + Ruis_Amplitude * Ruis_Cel
			, Descr = "De grootheid waarop gesorteerd wordt, hoog is nat. De gladgestreken natheid bepaalt de zonering, de ruis breekt de resterende gelijke waarden.";

			// ---- de empirische verdelingsfunctie per gebied ----
			parameter<float32> Ordening_Max    := max(Ordening_Cel);
			parameter<float32> Ordening_Bereik := Ordening_Max - min(Ordening_Cel) + 1f;

			attribute<float64> Sleutel (RivierCel) := float64(uint32(Gebied_Cel)) + float64((Ordening_Max - Ordening_Cel) / Ordening_Bereik)
			, Descr = "Sorteersleutel: het gebiedsnummer als geheel deel en de omgekeerde natheid als breukdeel, geschaald op strikt kleiner dan 1. Oplopend sorteren geeft daarmee eerst alle cellen van gebied 0 van nat naar droog, dan die van gebied 1, enzovoort. Zo hoeft er niet per gebied gerangschikt te worden, wat GeoDMS niet als operator kent.";

			attribute<uint64> Rang_Globaal (RivierCel) := invert(index(Sleutel))[uint64], Descr = "Het rangnummer van de cel in de globale sortering.";

			attribute<uint64> Aantal_Cellen (Levering/gebied) := pcount(Gebied_Cel);
			attribute<uint64> Startpositie  (Levering/gebied) := cumulate(Aantal_Cellen) - Aantal_Cellen, Descr = "Waar begint dit gebied in de globale sortering. cumulate telt inclusief, dus het eigen aantal er weer af.";

			attribute<float32> Positie (RivierCel) := (float32(Rang_Globaal - Startpositie[Gebied_Cel]) + 0.5f) / float32(Aantal_Cellen[Gebied_Cel])
			, IntegrityCheck = "all(this > 0f && this < 1f)"
			, Descr = "De empirische verdelingsfunctie: 0 is de natste cel van het gebied, 1 de droogste. Per gebied exact gelijkmatig verdeeld, en daarom kloppen de arealen. De halve cel erbij zet de waarde midden in zijn bakje.";

			// ---- de cumulatieve aandelen, in gradientvolgorde ----
			container CumFractie :=
				for_each_nedv(
					'CumFr_' + NbSRivieren/Gradient/name
					, NbSRivieren/Gradient/IsEerste
						? 'Levering/gebied/Fr_' + NbSRivieren/Gradient/name + '[float32]'
						: 'CumFr_' + NbSRivieren/Gradient/VorigeName + ' + Levering/gebied/Fr_' + NbSRivieren/Gradient/name + '[float32]'
					, Levering/gebied
					, float32
				), Descr = "Cumulatieve aandelen per gebied, in de volgorde van NbSRivieren/Gradient, dus van nat naar droog. De laatste komt per gebied op 1 uit.";

			attribute<NbSRivieren/Gradient> Gradient_rel_Cel (RivierCel) :=
				='min_elem(' + AsList('uint8(Positie >= CumFractie/CumFr_' + NbSRivieren/Gradient/name + '[Gebied_Cel])', ' + ') + ', ' + string(uint8(#NbSRivieren/Gradient) - 1b) + 'b)[NbSRivieren/Gradient]'
			, Descr = "De plek van de cel op de gradient: het aantal cumulatieve grenzen dat onder Positie ligt. De min_elem vangt af dat de laatste grens door afronding net onder 1 kan uitkomen.";

			attribute<NbSRivieren/RivierEcotoop> Ecotoop_rel_AD (AdminDomain) := recollect_by_cond(WordtGeordend, NbSRivieren/Gradient/RivierEcotoop_rel[Gradient_rel_Cel])
			, Descr = "Het ecotoop per cel, waar alles hieronder aan hangt.";

			// ---- van ecotoop naar beheertype en naar de oplegging ----
			container Fr_perEcotoop :=
				for_each_nedv(
					NbSRivieren/RivierEcotoop/name
					, 'Levering/gebied/Fr_' + NbSRivieren/RivierEcotoop/name + '[Gebied_rel][float32]'
					, AdminDomain
					, float32
				), Descr = "Aandeel van het celoppervlak per ecotoop, zoals de levering het geeft. Buiten het ruimtebeslag null. Dit is de exacte, ononderbroken vorm van de levering; Ecotoop_rel_AD is de kaart die eruit volgt.";

			attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := MakeDefined(NbSRivieren/RivierEcotoop/INL_Beheertype_rel[Ecotoop_rel_AD], IsMoerasnatuur ? Moerasnatuur_Type : null_b[INL_Beheertype])
			, Descr = "Het natuurbeheertype dat bij het ecotoop hoort. Null waar de cel op agrarisch grasland, agrarisch gebruik of bebouwd uitkomt: daar wordt niets opgelegd. De moerasnatuurgebieden dragen geen ecotoop en vallen terug op hun eigen type; de ecotopenlevering gaat voor, al overlappen de twee sets elkaar niet.";
			attribute<bool> IsNatuurEcotoop (AdminDomain) := MakeDefined(NbSRivieren/RivierEcotoop/IsNatuurlijkTerrestrisch[Ecotoop_rel_AD], FALSE)
			, Descr = "De cel komt op een terrestrisch natuurecotoop uit. De keuze tussen natuur en water loopt bij rivieren over de categorie van het ecotoop, en sinds 5 september 2026 zegt het type hetzelfde: de twee waterecotopen dragen N02.01 en N04.02 in plaats van N01.03, zie Classifications/Grondgebruik/RivierEcotoop/Beheertypecode. Tot dan verzamelde N01.03 vier terrestrische en twee waterecotopen en zou het type 28.665 ha grasland, struweel en ruigte als water tellen.";
			attribute<bool> IsWaterEcotoop  (AdminDomain) := MakeDefined(NbSRivieren/RivierEcotoop/IsWater[Ecotoop_rel_AD], FALSE)
			, Descr = "De cel komt op een waterecotoop uit: zomerbed, stromend water of stagnant water. Sinds #751 gaat dit water gewoon mee in de oplegging; tot dan lag het achter een schakelaar die overal uit stond.";
			attribute<bool> IsOpgelegd      (AdminDomain) := (IsNatuurEcotoop || IsWaterEcotoop || IsMoerasnatuur) && !Sloopgebied/GeenOplegging
			, Descr = "Legt de levering hier een beheertype op: een natuur- of waterecotoop, en niet op een behouden dijk. Sinds #620 valt Sloopgebied/GeenOplegging eraf: op de dijken die behouden blijven wordt niets opgelegd, want een dijk die blijft liggen wordt geen uiterwaardnatuur. Dat kost 259 ha van de levering en Deltares is er op 28 augustus 2026 mee akkoord gegaan. Het is dezelfde ingreep als die van #641 voor bestaand bebouwd gebied, alleen hier lokaal en niet in het algemene opleggingsmasker, omdat de aanleiding uit deze levering komt. Wat de variant hiermee doet staat in Templates/VariantData/Natuur/Rivieren_T.";

			attribute<bool> IsRivierIngreep (AdminDomain) := IsDefined(Gebied_rel) || IsMoerasnatuur, Descr = "Cel valt in het ruimtebeslag van de levering: de ecotopengebieden na de schakelaar NeemBinnendijksMee, plus de moerasnatuurgebieden van #791.";
			attribute<bool> NietBouwen      (AdminDomain) := IsRivierIngreep
			, Descr = "Hier mag niet meer gebouwd worden. Gelezen door Templates/VariantData_T/Bouwregime/Bron/Landschap/Rivieren, alleen in NbSGenuanceerd. Dit is het hele ruimtebeslag, dus ook het deel dat agrarisch blijft: dat ligt in de uiterwaard van het landschapstype en komt daarmee niet in aanmerking voor nieuwbouw. Blijft ongewijzigd na #620: de aanscherping van 28 augustus 2026 raakt alleen de sloop, niet de bouwrestrictie.";

			container Sloopgebied
			: Descr = "Waar wijkt de bestaande bebouwing en waar blijft ze staan. Zie #620.
						Tot deze splitsing gold het hele ruimtebeslag als sloopgebied. Team Rivieren heeft dat op
						28 augustus 2026 aangescherpt: slopen, uitkopen en het verplaatsen van arbeidsplaatsen
						gebeurt in de nieuwe uiterwaarden, dus de 36 binnendijkse gebieden, en daarbinnen niet op
						de dijken die behouden blijven. Bebouwing die maar deels in het overblijvende vlak valt
						blijft eveneens staan. De rest van het ruimtebeslag gaat daarmee van regime Slopen naar
						NietBouwen: geen nieuwbouw meer, maar de bestaande bebouwing blijft. Dat regime staat in
						Templates/VariantData_T bij Bouwregime/Bron/Landschap/Rivieren.
				Het model sloopt sinds #620 alleen langs dit masker: ModelParameters/SloopVolgtExogeneOplegging
				staat uit, dus de oplegging zelf leegt geen stand meer. GeenOplegging hieronder houdt de behouden
				dijken bovendien buiten de natuur- en wateroplegging, want een dijk die blijft liggen wordt geen
				uiterwaardnatuur."
			{
				parameter<bool> DijkenSparen := TRUE
				, Descr = "Vallen de behouden dijken buiten het sloopgebied? Staat aan, want dat is de vraag uit #620. Uitzetten geeft het beeld van voor die levering terug.";

				parameter<bool> RandbebouwingSparen := TRUE
				, Descr = "Blijft bebouwing staan die maar deels in het sloopvlak valt? Staat aan, conform de levering. De toets loopt per pand over de cellen waar het pand aan bijdraagt: raakt een pand het sloopvlak en ligt het er niet helemaal in, dan vallen al zijn cellen buiten het sloopgebied. Dat is grover dan een toets op de pandcontour zelf, want een cel van 25 bij 25 meter steekt buiten het pand uit, en die grofheid werkt naar sparen toe. Dat is de richting die de levering vraagt.";

				parameter<bool> AlleenNieuweUiterwaard := TRUE
				, Descr = "Beperkt de sloop zich tot de 36 binnendijkse gebieden, de nieuwe uiterwaarden? Staat aan, want dat is wat de levering van 28 augustus 2026 letterlijk zegt: slopen is uiterwaarden_nieuw_genuanc_02 min dijken_behouden2.
							Uitzetten neemt het hele ruimtebeslag weer als sloopgebied, dus inclusief de 23 riviertrajecten, zoals tot #620 het geval was. Dit is het punt waarop de aanscherping het meest verschilt van wat er stond en het is niet met zekerheid wat er bedoeld is: de riviertrajecten zijn de bestaande uiterwaarden en het zomerbed, en de eerste opdracht in #620 rekende die er wel toe. De vraag ligt terug bij Deltares.";

				attribute<bool> IsDijk (AdminDomain) := DijkenSparen && IsDefined(DijkenBehouden/Per_AdminDomain)
				, Descr = "Cel waarvan het middelpunt in een behouden dijk valt. Op 25m levert dat 566 ha op, gelijk aan het vectorareaal: de stroken zijn dertig tot vijftig meter breed en vallen dus ruwweg samen met een rij cellen.";

				attribute<bool> IsNieuweUiterwaard (AdminDomain) := MakeDefined(IsBinnendijks[Gebied_rel], FALSE)
				, Descr = "De 36 binnendijkse gebieden uit de levering. Die zijn geometrisch gelijk aan de shape uiterwaarden_nieuw_genuanc_02 waar #620 naar verwijst; dat is bij het inlezen van die shape nagemeten, symmetrisch verschil nul.";

				attribute<bool> Vlak (AdminDomain) := (AlleenNieuweUiterwaard ? IsNieuweUiterwaard : IsRivierIngreep) && !IsDijk
				, Descr = "Het sloopvlak zoals de levering het formuleert: de nieuwe uiterwaarden min de behouden dijken. Hier gaat de bebouwingstoets nog overheen.";

				unit<uint32> PandCel := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(/ModelParameters/Model_StartYear) + '/pand/ToedelingsMatrix'
				, Descr = "De kruistabel pand maal cel uit de BAG van het basisjaar: per pand de cellen waar het aan bijdraagt. Dezelfde tabel die de stand over de cellen uitsmeert, dus dezelfde bebouwing waar de sloop op aangrijpt."
				{
					attribute<bool> LigtInVlak := Vlak[AdminDomain_rel], Descr = "Ligt dit stuk van het pand in het sloopvlak.";
				}

				unit<uint32> Pand := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(/ModelParameters/Model_StartYear) + '/pand'
				, Descr = "De pandenset van het basisjaar, de voorraad volgens de CBS-definitie. Alle panden tellen mee en niet alleen de woonpanden: de levering spreekt over bebouwing, en de sloopregel raakt naast woningen ook arbeidsplaatsen.";

				attribute<bool> Pand_RaaktVlak    (Pand) := any(PandCel/LigtInVlak, PandCel/Pand_rel), Descr = "Het pand draagt aan minstens een cel binnen het sloopvlak bij.";
				attribute<bool> Pand_GeheelInVlak (Pand) := all(PandCel/LigtInVlak, PandCel/Pand_rel), Descr = "Alle cellen waar het pand aan bijdraagt liggen binnen het sloopvlak.";
				attribute<bool> Pand_DeelsBuiten  (Pand) := Pand_RaaktVlak && !Pand_GeheelInVlak, Descr = "De bebouwing die volgens de levering blijft staan: ze valt slechts deels in het overblijvende vlak.";

				attribute<bool> Randbebouwing (AdminDomain) := RandbebouwingSparen && MakeDefined(any(Pand_DeelsBuiten[PandCel/Pand_rel], PandCel/AdminDomain_rel), FALSE)
				, Descr = "Cel die bijdraagt aan een pand dat maar deels in het sloopvlak valt. Dat is de vertaling van de regel naar het raster: sloop gaat per cel en niet per pand, dus een cel met een stuk randbebouwing erin wordt in zijn geheel gespaard.";

				attribute<bool> Slopen (AdminDomain) := Vlak && !Randbebouwing
				, Descr = "Het antwoord: hier wijkt de bestaande bebouwing. Wordt opgepakt in Templates/VariantData_T bij Bouwregime/Bron/Landschap/Rivieren, dat deze cellen regime Slopen geeft en de rest van het ruimtebeslag NietBouwen.";

				attribute<bool> GeenOplegging (AdminDomain) := IsRivierIngreep && IsDijk
				, Descr = "De behouden dijken binnen het ruimtebeslag, 400 ha op 25m. Hier legt het model geen natuur of water op, zie IsOpgelegd hierboven: een dijk die blijft liggen wordt geen uiterwaardnatuur. Deltares is hiermee akkoord op 28 augustus 2026.
							De randbebouwing zit hier bewust niet in. Die cellen vallen wel buiten het sloopgebied, maar de bebouwing die er staat mag volgens dezelfde afstemming met de natuur samengaan, dus de oplegging blijft er staan. Zie ModelParameters/SloopVolgtExogeneOplegging.";
			}

			container Controle
			: Descr = "Vergelijkt het gerasterde areaal per ecotoop met het areaal dat rechtstreeks uit de levering volgt. Vangt twee dingen af: een rangschikking die scheef loopt, en de valkuil van geneste polygonen waar bij het rasteren de verkeerde wint."
			{
				attribute<Ha> opp_gebied (Levering/gebied) := area(Levering/gebied/geometry, meter2_f64)[Ha];

				attribute<float32> Fractie_Totaal (Levering/gebied) := CumFractie/CumFr_BebouwdVerhard
				, IntegrityCheck = "all(abs(this - 1f) < 0.001f)"
				, Descr = "De laatste cumulatieve grens, en dus de som van de vijftien aandelen per gebied. Die moet op 1 uitkomen, anders klopt de toedeling niet.";

				unit<uint8> PerEcotoop := NbSRivieren/RivierEcotoop
				{
					attribute<string> Label := NbSRivieren/RivierEcotoop/Label, DialogType = "LabelText";

					attribute<Ha> Vector := ='union_data(., ' + AsItemList('sum(Levering/gebied/Fr_' + NbSRivieren/RivierEcotoop/name + '[float32] * Controle/opp_gebied * float32(IsMeegenomen))') + ')'
					, Descr = "Areaal per ecotoop rechtstreeks uit de levering: aandeel maal polygoonoppervlak, opgeteld over de meegenomen gebieden.";

					attribute<Ha> Raster := ='union_data(., ' + AsItemList('sum(Ecotoop_rel_AD == NbSRivieren/RivierEcotoop/V/' + NbSRivieren/RivierEcotoop/name + ' ? 1f : 0f) * AdminDomain/NrHaPerCell') + ')'
					, Descr = "Areaal per ecotoop zoals het model het op de kaart heeft staan.";

					attribute<float32> Ratio := Raster / Vector
					, IntegrityCheck = "all(IsNull(this) || abs(this - 1f) < 0.05f)"
					, Descr = "Het raster mag hooguit 5 procent van de levering afwijken. Null voor bebouwd, dat in deze levering overal op nul staat. De rangschikking telt cellen en drempelt niet, dus de afwijking hoort binnen een cel per ecotoop per gebied te blijven; loopt het verder weg, dan is er iets mis met het rasteren of met de volgorde in de SqlString.";
				}

				parameter<Ha> Areaal_Buitendijks      := sum(MakeDefined(IsBuitendijks[Gebied_rel], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 64.462 ha over 23 riviertrajecten, op 25m 64.438 ha.";
				parameter<Ha> Areaal_Binnendijks      := sum(MakeDefined( IsBinnendijks[Gebied_rel], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 23.886 ha over 36 gebieden, op 25m 23.877 ha, en nul als NeemBinnendijksMee uit staat.";
				parameter<Ha> Areaal_Ecotoopgebieden  := sum(IsDefined(Gebied_rel) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal over de ecotopenlevering van #621: 88.348 ha, op 25m 88.315 ha.";
				parameter<Ha> Areaal_Moerasnatuur     := sum(IsMoerasnatuur ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal over de moerasnatuurgebieden van #791. Op de vector 7.810 ha over 43 polygonen, waarvan een handvol snippers kleiner dan een cel; nul als NeemMoerasnatuurMee uit staat.";
				parameter<Ha> Areaal_Totaal           := sum(IsRivierIngreep ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal over het hele ruimtebeslag van het landschap, de twee hierboven samen. Op de vector 96.131 ha; de twee sets overlappen elkaar niet.";
				parameter<Ha> Areaal_Natuur           := sum(IsNatuurEcotoop && !Sloopgebied/GeenOplegging ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. Uit de levering volgt 58.649 ha terrestrische natuur; op 25m staat er 57.816 ha, na aftrek van de 259 ha die #620 op de behouden dijken en onder de randbebouwing weghaalt.";
				parameter<Ha> Areaal_Water            := sum(IsWaterEcotoop && !Sloopgebied/GeenOplegging ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. Uit de levering volgt 21.132 ha water; op 25m staat er 21.011 ha, na aftrek van de 23,5 ha uit #620.";
				parameter<Ha> Areaal_Agrarisch        := sum(MakeDefined(NbSRivieren/RivierEcotoop/IsAgrarisch[Ecotoop_rel_AD], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. Uit de levering volgt 8.566 ha die agrarisch blijft, verdeeld over vijf binnendijkse gebieden. Dat zijn de vijf gebieden van klasse C in de levering van #791; de moerasnatuurgebieden houden per definitie niets agrarisch over.";
				parameter<Ha> Areaal_MoerasOpgelegd   := sum(IsMoerasnatuur && !Sloopgebied/GeenOplegging ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Wat er van de moerasnatuurgebieden werkelijk wordt opgelegd, dus na aftrek van de behouden dijken die er doorheen lopen.";
				parameter<Ha> Areaal_MoerasLandbouw   := sum(IsMoerasnatuur && MakeDefined(/Classifications/Grondgebruik/LandgebruikType/IsLandbouw[/BaseData/StartState/Landgebruik/Type], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Hoeveel van de moerasnatuurgebieden in het basisjaar landbouwgrond is. Dat is wat deze uitbreiding de landbouw kost, de vraag van #791.";
				parameter<Ha> Areaal_MoerasAlNatuur   := sum(IsMoerasnatuur && Basisjaar/IsNatuur ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "En hoeveel er in het basisjaar al natuur is; daar verandert de oplegging niets aan de stand.";
				parameter<Ha> Areaal_ZonderDiepte     := sum(float32(!IsDefined(Diepte_Cel))) * AdminDomain/NrHaPerCell, Descr = "Hoeveel van het ruimtebeslag geen dieptewaarde heeft en dus als droogst in de rangorde komt. Loopt dit op, dan wordt de zonering in die gebieden door de ruis bepaald in plaats van door de hoogte.";

				parameter<Ha> Areaal_Dijken           := sum(Sloopgebied/IsDijk ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal bij #620. De shape meet 566 ha; op 25m hoort daar hetzelfde uit te komen, want de stroken zijn breder dan een cel.";
				parameter<Ha> Areaal_DijkInLevering   := sum(Sloopgebied/IsDijk && IsRivierIngreep ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het deel van de dijken dat binnen het ruimtebeslag valt en dus werkelijk iets afsnijdt. In de shape 383 ha, waarvan 231 ha binnendijks; op 25m 400 ha, want een cel telt heel mee zodra haar middelpunt in de dijk valt en de dijk loopt hier langs de rand van de gebieden.";
				parameter<Ha> Areaal_Sloopvlak        := sum(Sloopgebied/Vlak ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het sloopvlak voor de bebouwingstoets: nieuwe uiterwaarden min behouden dijken.";
				parameter<Ha> Areaal_Randbebouwing    := sum(Sloopgebied/Randbebouwing ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Hoeveel oppervlak de bebouwingstoets uit het sloopvlak haalt: de cellen van panden die er maar deels in vallen.";
				parameter<Ha> Areaal_Slopen           := sum(Sloopgebied/Slopen ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het uiteindelijke sloopgebied. Vergelijk met Areaal_Totaal: dat was tot #620 het sloopgebied.";
				parameter<Ha> Areaal_GeenOplegging    := sum(Sloopgebied/GeenOplegging ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waar binnen het ruimtebeslag de oplegging vervalt omdat de dijk blijft liggen. Dit is het areaal natuur en water dat #620 kost ten opzichte van #621.";

				parameter<uint32> Panden_RaaktVlak    := sum_uint32(Sloopgebied/Pand_RaaktVlak),    Descr = "Hoeveel panden uit het basisjaar het sloopvlak raken. Controle op de bebouwingstoets: dit getal hoort in de orde van duizenden te liggen, niet in de miljoenen en niet op nul.";
				parameter<uint32> Panden_DeelsBuiten  := sum_uint32(Sloopgebied/Pand_DeelsBuiten),  Descr = "Daarvan het deel dat er maar half in ligt en dus blijft staan. Dit hoort een kleine minderheid te zijn; wordt het de meerderheid, dan sluit de toets te ruim aan en spaart hij het hele gebied.";

				parameter<Ha> Areaal_NatuurVervallen  := sum(Sloopgebied/GeenOplegging && MakeDefined(NbSRivieren/RivierEcotoop/IsNatuurlijkTerrestrisch[Ecotoop_rel_AD], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het deel van Areaal_GeenOplegging dat zonder #620 natuur was geworden. Dit is precies wat de aanscherping de natuuropgave kost.";
				parameter<Ha> Areaal_WaterVervallen   := sum(Sloopgebied/GeenOplegging && MakeDefined(NbSRivieren/RivierEcotoop/IsWater[Ecotoop_rel_AD], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Idem voor het water, dat sinds #751 gewoon mee de oplegging in gaat.";

				parameter<String> Uitdraai_Sloopgebied :=
					  'areaal_totaal;'           + string(Areaal_Totaal)
					+ '|areaal_binnendijks;'     + string(Areaal_Binnendijks)
					+ '|areaal_buitendijks;'     + string(Areaal_Buitendijks)
					+ '|areaal_dijken;'          + string(Areaal_Dijken)
					+ '|areaal_dijk_in_levering;'+ string(Areaal_DijkInLevering)
					+ '|areaal_sloopvlak;'       + string(Areaal_Sloopvlak)
					+ '|areaal_randbebouwing;'   + string(Areaal_Randbebouwing)
					+ '|areaal_slopen;'          + string(Areaal_Slopen)
					+ '|areaal_geen_oplegging;'  + string(Areaal_GeenOplegging)
					+ '|areaal_ecotoopgebieden;' + string(Areaal_Ecotoopgebieden)
					+ '|areaal_moerasnatuur;'    + string(Areaal_Moerasnatuur)
					+ '|areaal_moeras_opgelegd;' + string(Areaal_MoerasOpgelegd)
					+ '|areaal_agrarisch;'       + string(Areaal_Agrarisch)
					+ '|areaal_natuur;'          + string(Areaal_Natuur)
					+ '|areaal_water;'           + string(Areaal_Water)
					+ '|areaal_natuur_vervallen;'+ string(Areaal_NatuurVervallen)
					+ '|areaal_water_vervallen;' + string(Areaal_WaterVervallen)
					+ '|panden_raakt_vlak;'      + string(Panden_RaaktVlak)
					+ '|panden_deels_buiten;'    + string(Panden_DeelsBuiten)
				, StorageName = "='%LocalDataProjDir%/Diagnose/Rivieren_Sloopgebied.txt'"
				, StorageType = "str"
				, Descr = "De arealen van #620 in een keer, zodat de afbakening zonder allocatierun na te rekenen is. Sleutel en waarde gescheiden door een puntkomma, regels door een verticale streep.";
			}
		}
		
		container Veen_NbSGenuanceerd
		: Descr = "NbS-bouwstenen in het veengebied en de daaruit volgende natuurbeheertypen, voor de variant NbSGenuanceerd."
		{
			container Bron_PerPeilvak
			: StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/NBSnuanc_bouwsteen_pct_perpeilvak.gpkg"
			, StorageType     = "gdal.vect"
			, StorageReadOnly = "TRUE"
			, Source          = "Deltares, aangeleverd via SURFdrive NL2120/Veen/NBS nuanc/nbsnuanc/voorNatuur"
			, DialogData      = "rdc_meter"
			{
				unit<uint32> gebied
				: SqlString = "select GPGIDENT as gpgident, deelgebied, coalesce(\"2_pct\", 0) / 100.0 as BS2, coalesce(\"3a_pct\", 0) / 100.0 as BS3a, coalesce(\"3b_pct\", 0) / 100.0 as BS3b, coalesce(\"4a_pct\", 0) / 100.0 as BS4a, coalesce(\"4b_pct\", 0) / 100.0 as BS4b, coalesce(\"5_pct\", 0) / 100.0 as BS5, coalesce(\"6_pct\", 0) / 100.0 as BS6, coalesce(\"7_pct\", 0) / 100.0 as BS7, coalesce(\"8_pct\", 0) / 100.0 as BS8, coalesce(\"9a_pct\", 0) / 100.0 as BS9a, coalesce(\"9b_pct\", 0) / 100.0 as BS9b, 0.0 as BS10a, geom from (select *, row_number() over (partition by geom order by fid) as rn, count(*) over (partition by geom) as cnt from NBSnuanc_bouwsteen_pct_perpeilvak) where rn = (cnt + 1) / 2 order by ST_Area(geom) desc"
				, Descr = "Gebieden met een peilvak. De percentages per bouwsteen tellen per peilvak niet tot 100 op; de rest is bouwsteen 0, 1 of 10.

							Naast de fracties komen twee tekstkolommen mee: gpgident, de peilvaksleutel die de twee veenleveringen delen en waarmee team Veen een gebied terugvindt, en deelgebied, de acht gebieden van Friesland-Groningen tot 3.2 Veluwe waarop de indicatoren en de terugkoppeling worden samengevat.";
			}
			container Bron_ZonderPeilvak
			: StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/NBSnuanc_bouwsteen_pct_zonderpv.gpkg"
			, StorageType     = "gdal.vect"
			, StorageReadOnly = "TRUE"
			, Source          = "Deltares, aangeleverd via SURFdrive NL2120/Veen/NBS nuanc/nbsnuanc/voorNatuur"
			, DialogData      = "rdc_meter"
			{
				unit<uint32> gebied
				: SqlString = "select naam, coalesce(\"2_pct\", 0) / 100.0 as BS2, coalesce(\"3a_pct\", 0) / 100.0 as BS3a, coalesce(\"3b_pct\", 0) / 100.0 as BS3b, coalesce(\"4a_pct\", 0) / 100.0 as BS4a, coalesce(\"4b_pct\", 0) / 100.0 as BS4b, coalesce(\"5_pct\", 0) / 100.0 as BS5, 0.0 as BS6, coalesce(\"7_pct\", 0) / 100.0 as BS7, 0.0 as BS8, 0.0 as BS9a, 0.0 as BS9b, coalesce(\"10_pct\", 0) / 100.0 as BS10a, geom from (select *, row_number() over (partition by geom order by fid) as rn, count(*) over (partition by geom) as cnt from NBSnuanc_bouwsteen_pct_zonderpv) where rn = (cnt + 1) / 2 order by ST_Area(geom) desc"
				, Descr = "Gebieden zonder peilvak. Hier geldt in principe een bouwsteen per gridcel, dus 100 procent. Voor 3 en 4 is de locatie van variant a en b niet bepaald, dus staat het daar op 50-50.

							De kolom naam draagt de deelgebiednaam, 3.1 of 3.2 Veluwe/Utrechtse heuvelrug, in dezelfde schrijfwijze als de kolom deelgebied van de peilvakkenlaag. Deze laag heeft geen GPGIDENT, dus naam is hier ook de sleutel in de terugkoppeling.";
			}
		}

		container Kust_NbSGenuanceerd
		: Descr = "Ruimtebeslag van de NbS-bouwstenen uit het landschapstype Kust, voor de variant NbSGenuanceerd. Zie issue #654.

					Drie leveringen van team Kust, een per deelgebied:
					  Duinen : zandige kust, kerven in de duinen, variant A.
					  Wadden : meegroeilandschappen en voorlanden, variant C.
					  ZWD    : Zuidwestelijke Delta, meegroeilandschappen en voorlanden, variant C.

					Deze levering van 2026-08-28 vervangt de levering van 2026-08-21 uit #623. Drie dingen zijn
					veranderd. De Wadden en de Zuidwestelijke Delta zijn nu variant C in plaats van variant A, en
					daarmee een stuk kleiner: samen 30.239 ha tegen 57.771 ha. De duinen zijn dezelfde 49 kerven als
					in #623, maar nu in RD in plaats van WGS84. En elke levering draagt nu het natuurbeheertype als
					kolomnaam mee, wat eerder een voorlopige keuze van het model was.

					In dit hele ruimtebeslag verandert het huidige grondgebruik in natuur. Er mag dus niet meer
					gebouwd worden, maar de bestaande bebouwing blijft sinds #707 wel staan. Dat loopt via
					NietBouwen (de zeef voor wonen en werken) en via INL_Beheertype_rel_AD (het exogeen opleggen, sinds #751 een stroom in Templates/VariantData/Natuur). De
					landgebruiksklasse wordt dus natuur terwijl de stand een verspreide woning kan houden.

					De megasuppleties zijn nog steeds niet geleverd: dat zijn puntlocaties op zee zonder ruimtebeslag
					op land."
		{

			parameter<bool> NeemBuitendijksMee := TRUE
			, Descr = "Tellen ook de buitendijkse delen mee (veld zijde is zee)? Staat aan, want de aanleverende partij schrijft dat het hele ruimtebeslag natuur wordt.

						Deze schakelaar weegt in variant C veel minder zwaar dan in variant A. De Wadden leveren nu
						alleen binnendijks vasteland, dus daar valt niets meer af; alleen de Zuidwestelijke Delta heeft
						nog een buitendijkse zijde. Uitzetten haalt daarmee 4.742 ha uit de oplegging in plaats van de
						31.689 ha uit #623. Het gaat wel om precies de kwelder- en voorlandvorming waar de
						meegroeilandschappen om draaien, dus de schakelaar hoort aan te blijven staan.";
			unit<uint32> Duinen
			:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Kust_Duinen_varA_NbSgenuanceerd_20260828.shp"
			,  StorageType     = "gdal.vect"
			,  StorageReadOnly = "True"
			,  DialogType      = "Map"
			,  DialogData      = "geometry"
			,  Source          = "Deltares, team Kust NL2120. Oorspronkelijke bestandsnaam varA_Duinen.shp, geleverd op 2026-08-29 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/Natuur Kust. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf."
			,  Descr           = "Zandige kust: 49 polygonen met hoge potentie voor kerven, samen 20.228 ha, van Walcheren tot de oostelijke Waddeneilanden.

								Dezelfde geometrie als de kerven uit #623, maar nu in RD geleverd; de omweg via WGS84 is daarmee vervallen. Het veld id is nog steeds niet uniek: 49 records op 32 ids, want de multipart-polygonen zijn geexplodeerd met behoud van het id van de ouder. De kolommen oppervlakt en oppvl2 tot en met oppvl5 bevatten dezelfde oppervlakte in m2, maar alleen oppvl5 is voor alle 49 records gevuld; Surface is wel overal gevuld en gelijk aan de polygoonoppervlakte. Reken met de geometrie.

								Nieuw is de kolom N08.02, het natuurbeheertype open duin, met waarde 1 voor 48 van de 49 records. Bij record 46 (69 ha) is die leeg. Zie Beheertypecode_Duinen hieronder: de kolomnaam kan hier niet als attribuut worden ingelezen, want een punt is in GeoDMS geen geldig naamteken."
			{
				attribute<rdc_meter> geometry        (poly);
				attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
				attribute<bool>      IsGebied        (AdminDomain) := IsDefined(Per_AdminDomain), Descr = "De duinenlevering kent geen binnen- en buitendijks onderscheid, dus hier telt het hele ruimtebeslag.";
			}

			unit<uint32> Wadden
			:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Kust_Wadden_varC_NbSgenuanceerd_20260828.shp"
			,  StorageType     = "gdal.vect"
			,  StorageReadOnly = "True"
			,  DialogType      = "Map"
			,  DialogData      = "geometry"
			,  Source          = "Deltares, team Kust NL2120. Oorspronkelijke bestandsnaam varC_wadden.shp, geleverd op 2026-08-29, zelfde map als Duinen."
			,  Descr           = "Waddengebied: 12 polygonen meegroeilandschap en voorland, variant C, samen 17.081 ha.

								Variant C is hier veel soberder dan de variant A uit #623, die 47.100 ha besloeg. Alles is binnendijks en alles ligt op het vasteland: de velden layer en path wijzen alle twaalf naar Waddenzee_Vasteland_Binnendijks. De eilanden en de buitendijkse delen die in variant A wel zaten zijn in variant C niet meer opgenomen. Het veld zijde staat dan ook overal op land.

								De kolom N09.01, schor of kwelder, staat voor alle twaalf op 1. Zie Beheertypecode_Kwelder."
			{
				attribute<rdc_meter> geometry        (poly);
				attribute<string>    zijde;
				attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
				attribute<bool>      IsBinnendijks   := lowercase(zijde) == 'land', Descr = "Het veld zijde heeft twee waarden: land is binnendijks, zee is buitendijks. In variant C staat het voor alle twaalf records op land.";
				attribute<bool>      IsMeegenomen    := IsBinnendijks || NeemBuitendijksMee;
				attribute<bool>      IsGebied        (AdminDomain) := MakeDefined(IsMeegenomen[Per_AdminDomain], FALSE), Descr = "Eerst per record beslissen en dan pas naar het raster: andersom levert de negatie buiten het ruimtebeslag TRUE op.";
			}

			unit<uint32> ZWD
			:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Kust_ZWD_varC_NbSgenuanceerd_20260828.shp"
			,  StorageType     = "gdal.vect"
			,  StorageReadOnly = "True"
			,  DialogType      = "Map"
			,  DialogData      = "geometry"
			,  Source          = "Deltares, team Kust NL2120. Oorspronkelijke bestandsnaam Nbt_varC_ZWD.shp, geleverd op 2026-08-29, zelfde map als Duinen."
			,  Descr           = "Zuidwestelijke Delta: 34 polygonen meegroeilandschap en voorland, variant C, samen 13.158 ha, waarvan 8.416 ha binnendijks en 4.742 ha buitendijks. Het ruimtebeslag ligt langs de Westerschelde; de laagnamen in het bestand noemen dat ook zo.

								Het veld zijde heeft twee waarden: land is binnendijks, zee is buitendijks. Anders dan bij de Wadden hangt het beheertype hier aan die zijde. De zestien buitendijkse polygonen dragen N01.02, duin- en kwelderlandschap; zeventien van de achttien binnendijkse dragen N09.01, schor of kwelder. Bij de achttiende, record 3 van 199 ha, staan beide kolommen op nul. Die telt hier gewoon mee als binnendijks, dus als schor of kwelder; dat is vraag 2 in #654.

								De negen binnendijkse polygonen uit de laag NBS_NuanSelectieGebiedsproces dragen een polderadministratie mee: NAAM, Eiland, JaarIndijk, Wilderom, DoNotUse en reason. DoNotUse staat bij die negen op nul en is bij de overige 25 leeg. De overige velden zijn zonale statistiek en worden hier niet gebruikt. De namen zijn in de dbf afgekapt: Elev. mean en Elev. me_1 tot en met me_5 zijn count, min, max, mean, median en stddev van de hoogte, in dezelfde volgorde als de reeksen GHW (gemiddeld hoogwater) en SSC (sedimentconcentratie). Het veld opp_m2 is niet de polygoonoppervlakte maar de celtelling maal 22500 m2 van het 150m-statistiekraster."
			{
				attribute<rdc_meter> geometry        (poly);
				attribute<string>    zijde;
				attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
				attribute<bool>      IsBinnendijks       := lowercase(zijde) == 'land';
				attribute<bool>      IsMeegenomen        := IsBinnendijks || NeemBuitendijksMee;
				attribute<bool>      IsGebied            (AdminDomain) := MakeDefined(IsMeegenomen[Per_AdminDomain], FALSE);
				attribute<bool>      IsBuitendijksGebied (AdminDomain) := MakeDefined(!IsBinnendijks[Per_AdminDomain], FALSE) && IsGebied, Descr = "Alleen de buitendijkse zijde, want daar hangt in deze levering een ander beheertype aan.";
			}

			attribute<bool> IsKustIngreep (AdminDomain) := Duinen/IsGebied || Wadden/IsGebied || ZWD/IsGebied
			, Descr = "Cel valt in het ruimtebeslag van een van de drie leveringen. Hier gebeuren twee dingen. Er mag niet meer gebouwd worden, dat loopt via NietBouwen hieronder naar de zeef. En er wordt natuur opgelegd, dat loopt via INL_Beheertype_rel_AD hieronder naar Templates/VariantData/Natuur/Kust_T.

							Wat hier sinds #707 niet meer gebeurt is slopen. Tot dan zette Templates/VariantData_T het hele ruimtebeslag op regime Slopen en werd de bestaande bebouwing geleegd; nu staat daar NietBouwen. Een verspreide woning binnen het ruimtebeslag blijft dus staan met de landgebruiksklasse natuur eromheen. Gemeten op de woningvoorraad in het basisjaar gaat het om 2.369 woningen, zie Sloop/Verschil/Kust707 in Templates/VariantData_T.";
			attribute<bool> NietBouwen    (AdminDomain) := IsKustIngreep, Descr = "Hier mag niet meer gebouwd worden. Gelezen door Templates/VariantData_T/Bouwregime/Bron/Landschap/Kust, alleen in NbSGenuanceerd.";

			parameter<string> Beheertypecode_Duinen   := 'N08.02'
			, Descr = "Open duin. Komt uit de levering zelf: de duinenshape draagt een kolom N08.02 die voor 48 van de 49 records op 1 staat. Dat is grover dan de N08.02.02 (stuivend duinzand) waar #623 voorlopig mee rekende, en het is nu een keuze van de aanleverende partij in plaats van een aanname van het model. De kolomnaam kan niet als attribuut worden ingelezen omdat een punt in GeoDMS geen geldig naamteken is, dus staat de code hier.";
			parameter<string> Beheertypecode_Kwelder  := 'N09.01'
			, Descr = "Schor of kwelder. Komt uit de levering: de kolom N09.01 staat op 1 voor alle twaalf Waddenrecords en voor zeventien van de achttien binnendijkse ZWD-records.";
			parameter<string> Beheertypecode_Voorland := 'N01.02'
			, Descr = "Duin- en kwelderlandschap. Komt uit de levering: de kolom N01.02 staat op 1 voor alle zestien buitendijkse ZWD-records. Nieuw ten opzichte van #623, dat buitendijks en binnendijks hetzelfde type gaf.";

			attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) :=
				Duinen/IsGebied
					? rlookup(Beheertypecode_Duinen, INL_Beheertype/code)
					: ZWD/IsBuitendijksGebied
						? rlookup(Beheertypecode_Voorland, INL_Beheertype/code)
						: IsKustIngreep
							? rlookup(Beheertypecode_Kwelder, INL_Beheertype/code)
							: null_b[INL_Beheertype]
			, IntegrityCheck = "IsDefined(rlookup(Beheertypecode_Duinen, INL_Beheertype/code)) && IsDefined(rlookup(Beheertypecode_Kwelder, INL_Beheertype/code)) && IsDefined(rlookup(Beheertypecode_Voorland, INL_Beheertype/code))"
			, Descr = "Beheertype per cel. Duinen gaan voor waar ze een meegroeilandschap zouden overlappen, en binnen de Zuidwestelijke Delta gaat de buitendijkse zijde voor op de binnendijkse; in de praktijk overlappen die elkaar nauwelijks. Het ene binnendijkse ZWD-record zonder beheertype in de levering valt hiermee op kwelder, zie vraag 2 in #654. De IntegrityCheck faalt als een van de drie codes niet in INL_Beheertype voorkomt.";

			container Controle
			{
				parameter<Ha> Areaal_Duinen := sum(Duinen/IsGebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 20.228 ha, gemeten op 25m 20.225 ha; het verschil is de rastering en wat buiten het studiegebied valt.";
				parameter<Ha> Areaal_Wadden := sum(Wadden/IsGebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 17.081 ha, gemeten op 25m 17.072 ha. Alles binnendijks, dus NeemBuitendijksMee doet hier niets.";
				parameter<Ha> Areaal_ZWD    := sum(ZWD/IsGebied    ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 13.158 ha met NeemBuitendijksMee, 8.416 ha zonder; gemeten op 25m 13.091 ha respectievelijk 8.349 ha.";
				parameter<Ha> Areaal_Totaal := sum(IsKustIngreep   ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal over de drie leveringen samen, dus zonder dubbeltelling van overlap. Gemeten op 25m 50.388 ha, precies de som van de drie afzonderlijk: anders dan in #623 overlappen de leveringen elkaar niet. Daarvan is 19.969 ha in het basisjaar al natuur en 2.682 ha al water.";
			}

		}

		container Zand_NbSGenuanceerd
		: Descr = "Beekdalherstel uit het landschapstype Zand, voor de variant NbSGenuanceerd. Zie issue #630.

					Een levering van team Zand: de beekdalen en droogdalen waar herstel plaatsvindt. Anders dan bij
					kust gaat het hier alleen op slot voor nieuwbouw. De bestaande bebouwing mag blijven staan, dus
					er wordt niet gesloopt en de sloop- en uitkoopindicatoren zien hier niets.

					De natuurontwikkeling zelf is er sinds #652 als allocatie: de opgave per claimregio uit
					ModelParameters/Natuur landt via Zand_Allocatiebasis hieronder en Templates/VariantData/Natuur/Zand_T
					op de kaart, natte natuur binnen dit beekdalherstel en droge natuur erbuiten."
		{
			unit<uint32> Beekdalherstel
			:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Zand_Beekdalherstel_NbSgenuanceerd_20260819.shp"
			,  StorageType     = "gdal.vect"
			,  StorageReadOnly = "True"
			,  DialogType      = "Map"
			,  DialogData      = "geometry"
			,  Source          = "Deltares, team Zand NL2120. Oorspronkelijke bestandsnaam beekdalherstel.shp, geleverd op 2026-08-21 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/beekdalherstel. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf."
			,  Descr           = "30.753 polygonen, samen ongeveer 220.796 ha, van Zeeuws-Vlaanderen tot Groningen.

								Twee velden: BKNSN_code met het subtype uit de Basiskaart Natuurlijk Systeem Nederland en
								Subtype_na met de bijbehorende omschrijving. Dat laatste veld is in de dbf afgekapt van
								Subtype_naam. Er is geen veld dat beekdalherstel onderscheidt van beekdal, dus de aanname
								is dat de hele levering herstelgebied is. Dat is vraag 1 uit #630."
			{
				attribute<rdc_meter> geometry             (poly);
				attribute<string>    BKNSN_code;
				attribute<string>    Subtype_na;
				attribute<.>         Per_AdminDomain       (AdminDomain) := poly2grid(geometry, AdminDomain);
			}
		}

		container Zand_Allocatiebasis
		: Descr = "De variant-onafhankelijke voorbereiding voor de extra natuur in het landschapstype Zand: claimregios, NNN-ringen, zeven, typen en geschiktheid. De allocatie zelf staat per variant in Templates/VariantData/Natuur/Zand_T, want die hangt af van de opgave en dus van de variant; dit deel niet, en het is te duur om per variant te berekenen.

				De gedeelde kaarten voor de extra natuur in het landschapstype Zand: claimregio's, zeven, typen en geschiktheid. Zie issue #652.

					Anders dan bij veen, kust en rivieren geeft de aanlevering hier geen kaart maar alleen een opgave in
					hectares per claimregio. Het model moet dus zelf bepalen waar die natuur landt. Dat gebeurt met
					Templates/VariantData/Natuur/NatuurAlloc_T, dat de opgave als harde bovengrens aan discrete_alloc_sp
					meegeeft; de aanroep staat in Zand_T, geinstantieerd in VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand. De getallen staan in
					ModelParameters/Natuur.

					Nat en droog zijn twee gescheiden werelden, en dat is geen modelkeuze maar staat zo in de
					aanlevering. Natte natuur is beekdalherstel en landt alleen binnen het ruimtebeslag van #630;
					droge natuur is bos, heide en zand en landt alleen daarbuiten, op de geomorfologisch geschikte
					delen. Ze delen de claimregio-indeling niet: natte natuur telt per deelgebied, droge natuur per
					deelgebied maal NNN-ring.

					De zes BKNSN-subtypen die de aanlevering voor natte natuur noemt, beekdal en droogdal in hun
					varianten, zijn precies de zes codes die in de beekdalherstel-levering van #630 zitten. Voor die
					kant is er dus geen aparte subtypenkaart nodig. Voor droge natuur wel, en die is er niet: de
					config heeft alleen de hoofdklassenkaart met elf klassen. Zie IsDroogBKN voor hoe dat is opgelost
					en wat het kost."
		{
			unit<UInt32> Claimregios_shp
			:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Zand_Claimregios_20260708.shp"
			,  StorageType     = "gdal.vect"
			,  StorageReadOnly = "True"
			,  DialogType      = "Map"
			,  DialogData      = "geometry"
			,  Source          = "Deltares, team Zand NL2120. Oorspronkelijke bestandsnaam begrenzing_zand.shp, geleverd op 2026-08-25 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/begrenzing_zand. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf."
			,  Descr           = "259 polygonen, samen 1.668.981 ha, zonder onderlinge overlap. Het veld deelgeb2 draagt de claimregio; deelgebied is in de hele levering leeg. Het veld fgr onderscheidt Hogere Zandgronden (248 polygonen, 1.618.033 ha) van Heuvelland (11 polygonen, 50.948 ha)."
			{
				attribute<rdc_meter> geometry (poly);
				attribute<String>    deelgeb2;
				attribute<String>    fgr;

				attribute</ModelParameters/Natuur/Deelgebied> Deelgebied_rel := rlookup(deelgeb2, /ModelParameters/Natuur/Deelgebied/Shapesleutel)
				, IntegrityCheck = "all(IsDefined(this))"
				, Descr = "Koppeling aan de opgave, over de veldwaarde en niet over de naam: de namen in de Excel en in de shapefile lopen uiteen, en Twente-Achterho is in de dbf afgekapt op vijftien tekens. De IntegrityCheck laat een onbekende waarde hard falen in plaats van hem stil op null te zetten.";
			}
			unit<UInt32> NNN
			:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NatuurNetwerkNedeland_inspire-pv-ps.nlps-nnn_EPSG28992_20230829.gpkg"
			,  StorageType     = "gdal.vect"
			,  StorageReadOnly = "True"
			,  DialogType      = "Map"
			,  DialogData      = "geometry"
			,  Source          = "Provincies, via PDOK, INSPIRE-thema Protected Sites, peildatum 2023-08-29."
			,  Descr           = "Het Natuurnetwerk Nederland, 40.468 polygonen. De overige velden zijn INSPIRE-boekhouding en worden hier niet gebruikt; alleen de geometrie telt."
			{
				attribute<rdc_meter> geometry (poly);
			}

			container Src := /SourceData/Grondgebruik/Natuur/Bron/Zand_NbSGenuanceerd, Descr = "De beekdallevering van #630, een niveau hoger in Bron.";
			parameter<bool> NeemDroogdalenMee := TRUE
			, Descr = "Tellen naast de beekdalen ook de droogdalen mee? Staat aan, want de levering heet beekdalherstel en de aanleverende partij heeft de droogdalen daar zelf in gezet.

						De levering bestaat voor 192.726 ha uit beekdal (Dz5, Dz6 en Lg5) en voor 28.070 ha uit
						droogdal (Sw4, Sw4x en Lg6). Uitzetten haalt dus ruim een achtste van het ruimtebeslag weg.
						Dit is vraag 1 uit #630 en staat nog uit bij team Zand.";

			parameter<bool> BeperkTotZandgebied := FALSE
			, Descr = "Alleen de dalen binnen de landschapsbegrenzing van zand op slot, of de hele levering? Staat uit, want de aanleverende partij heeft de hele shape geleverd.

						Dit is vraag 2 uit #630: de levering loopt door in andere landschappen. In termen van de
						Basiskaart Natuurlijk Systeem doet ze dat niet, want alle records vallen in Dekzandgebied (Dz),
						Stuwwallen (Sw) of loss (Lg). Het is dus de NL2120-landschapsindeling waar ze buiten treedt.
						Let op dat Begrenzing zandgebied een grove omhullende van 47 punten is, geen scherpe grens.";

			unit<uint8> DalTypeK : NrOfRows = 6
			, Descr = "De zes BKNSN-subtypen in de levering, met per type of het een beekdal of een droogdal is. De aantallen records zijn ter orientatie; de arealen staan bij NeemDroogdalenMee."
			{
				attribute<string> code      : ['Dz5','Dz6','Lg5','Sw4','Sw4x','Lg6'];
				attribute<string> label     : ['Beekdal zand/leem','Beekdal veen','Beekdal','Droogdal','Droogdal met keileem','Droogdal'];
				attribute<bool>   IsBeekdal : [TRUE,TRUE,TRUE,FALSE,FALSE,FALSE];
				attribute<uint32> NrRecords : [18418,4222,179,6056,298,1580];
			}

				attribute<DalTypeK>  DalTypeK_rel (Src/Beekdalherstel) := rlookup(Src/Beekdalherstel/BKNSN_code, DalTypeK/code), IntegrityCheck = "all(IsDefined(this))", Descr = "Faalt als er een BKNSN-code in de levering staat die niet in DalTypeK is opgenomen, bijvoorbeeld na een nieuwe levering.";
				attribute<bool>      IsBeekdal    (Src/Beekdalherstel) := DalTypeK/IsBeekdal[DalTypeK_rel];
				attribute<bool>      IsDroogdal   (Src/Beekdalherstel) := !IsBeekdal;
				attribute<bool>      IsMeegenomen (Src/Beekdalherstel) := IsBeekdal || NeemDroogdalenMee;
				attribute<bool>      IsGebied              (AdminDomain) := MakeDefined(IsMeegenomen[Src/Beekdalherstel/Per_AdminDomain], FALSE);
				attribute<bool>      IsBeekdalCel          (AdminDomain) := MakeDefined(IsBeekdal[Src/Beekdalherstel/Per_AdminDomain], FALSE), Descr = "Alleen voor de controlegetallen hieronder.";
				attribute<bool>      IsDroogdalCel         (AdminDomain) := MakeDefined(IsDroogdal[Src/Beekdalherstel/Per_AdminDomain], FALSE), Descr = "Alleen voor de controlegetallen hieronder. Let op: eerst per record negeren en dan pas naar het raster, anders levert de negatie buiten het ruimtebeslag TRUE op.";

			attribute<bool> IsInZandgebied   (AdminDomain) := /SourceData/RegioIndelingen/Landschappen/Zandgebied/IsGebied, Descr = "Valt de cel binnen de NL2120-landschapsbegrenzing van zand. Alleen gebruikt als BeperkTotZandgebied aan staat.";
			attribute<bool> IsBeekdalHerstel (AdminDomain) := IsGebied && (IsInZandgebied || !BeperkTotZandgebied)
			, Descr = "Cel valt in het ruimtebeslag van de levering, na toepassing van de twee schakelaars hierboven. Hier mag niet meer gebouwd worden. Er wordt niet gesloopt; de natuur die hier landt komt uit de allocatie in Templates/VariantData/Natuur/Zand_T.";
			attribute<bool> NietBouwen       (AdminDomain) := IsBeekdalHerstel, Descr = "Hier mag niet meer gebouwd worden. Gelezen door Templates/VariantData_T/Bouwregime/Bron/Landschap/Zand, alleen in NbSGenuanceerd.";

			parameter<Ha> Areaal_Beekdalen        := sum(IsBeekdalCel  ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 192.726 ha, op 25m 192.675 ha; het verschil is de rastering.";
			parameter<Ha> Areaal_Droogdalen       := sum(IsDroogdalCel ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 28.070 ha, op 25m ook 28.070 ha.";
			parameter<Ha> Areaal_Totaal           := sum(IsBeekdalHerstel             ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal na de schakelaars: het areaal dat daadwerkelijk op slot gaat. Met beide schakelaars op hun huidige stand 220.746 ha op 25m, tegen 220.796 ha in de levering.";
			parameter<Ha> Areaal_BuitenZandgebied := sum(IsGebied && !IsInZandgebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal bij vraag 2 uit #630: hoeveel van de levering ligt buiten de landschapsbegrenzing van zand. Dat is maar 156 ha van de 220.746, dus BeperkTotZandgebied aanzetten verandert vrijwel niets. Dat komt doordat Begrenzing zandgebied een grove omhullende is.";
			parameter<Ha> Areaal_OokInLaagveen    := sum(IsGebied && /SourceData/RegioIndelingen/Landschappen/Laagveen/IsGebied       ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal bij vraag 2 uit #630: hoeveel van de levering valt ook binnen de omhullende van het laagveenlandschap. Dat is 49.498 ha, ruim een vijfde. De omhullenden overlappen elkaar, dus dit is geen exclusieve toedeling; het is wel de plek waar de opmerking dat de shape doorloopt in andere landschappen vandaan komt.";
			parameter<Ha> Areaal_OokInRivieren    := sum(IsGebied && /SourceData/RegioIndelingen/Landschappen/Rivierengebied/IsGebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Idem voor het rivierenlandschap: 789 ha.";

			attribute<Claimregios_shp> Regio_rel_AD      (AdminDomain) := poly2grid(Claimregios_shp/geometry, AdminDomain);
			attribute</ModelParameters/Natuur/Deelgebied> Deelgebied_rel_AD (AdminDomain) := Claimregios_shp/Deelgebied_rel[Regio_rel_AD];

			parameter<Meter> Ringresolutie := /ModelParameters/Natuur/Trekking/Zand/Ringresolutie
			, Descr = "Op welke resolutie de afstandsringen rond het NNN bepaald worden. Op 100 meter, niet op de 25 meter van het AdminDomain, en dat is een bewuste afweging. De ring van 2.000 meter vraagt op 25 meter een kern van 161 bij 161 cellen over ruim 27 miljoen cellen; op 100 meter is dat 41 bij 41 over 1,7 miljoen cellen, ruwweg zestig keer zo goedkoop. De prijs is dat de ringgrens tot 100 meter kan verspringen, op een ringbreedte van 500 tot 1.000 meter. Wie het scherper wil: zet de drie potentialen hieronder op Distmatrices_25m en rdc_25m.";

			attribute<Bool> IsNNN_100m       (rdc_100m) := IsDefined(poly2grid(NNN/geometry, rdc_100m));
			attribute<Bool> Binnen500_100m   (rdc_100m) := potential(float32(IsNNN_100m), /Geography/Distmatrices_100m/pot500m/Flat2)  > 0f;
			attribute<Bool> Binnen1000_100m  (rdc_100m) := potential(float32(IsNNN_100m), /Geography/Distmatrices_100m/pot1000m/Flat2) > 0f;
			attribute<Bool> Binnen2000_100m  (rdc_100m) := potential(float32(IsNNN_100m), /Geography/Distmatrices_100m/pot2000m/Flat2) > 0f;

			attribute</ModelParameters/Natuur/Ring> Calc_Ring_rel_100m (rdc_100m) :=
				  IsNNN_100m      ? /ModelParameters/Natuur/Ring/V/InNNN
				: Binnen500_100m  ? /ModelParameters/Natuur/Ring/V/Tot500m
				: Binnen1000_100m ? /ModelParameters/Natuur/Ring/V/Tot1000m
				: Binnen2000_100m ? /ModelParameters/Natuur/Ring/V/Tot2000m
				:                   /ModelParameters/Natuur/Ring/V/Verder
			, Descr = "De ring waar de cel in valt. De reeks is uitputtend, dus dit is overal gevuld; buiten de claimregio's doet het er niet toe.";

			parameter<String> FileName_Ring_rel_100m := '%LocalDataProjDir%/BaseData/Grondgebruik/Natuur/Ring_rel_100m_NNN20230829_'+/ModelParameters/StudyArea+'.tif'
			, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

			parameter<String> Fingerprint_Ring_rel_100m :=
				  'nnn_date=20230829'
				+ ';ring_resolution_m=' + string(Ringresolutie)
				+ ';ring_kernels_m=500,1000,2000'
				+ ';ring_count='        + string(#/ModelParameters/Natuur/Ring)
				+ ';ring_names='        + asList(/ModelParameters/Natuur/Ring/name, ',')
				+ ';study_area='        + /ModelParameters/StudyArea
			, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. nnn_date staat als vaste waarde omdat de datum hard in het pad van NNN zit; komt daar een nieuwe levering, pas dan ook deze sleutel aan. ring_kernels_m staat eveneens als vaste waarde, want de drie potentialen hierboven kiezen hun kernel via het itempad en niet via een parameter; hetzelfde geldt voor de keuze van Distmatrices_100m en rdc_100m, waar Ringresolutie de documentatieparameter van is. De ringindeling zelf staat erin omdat een gewijzigde klasselijst dezelfde bestandsnaam zou hergebruiken.";

			container Decoupling_Ring_rel_100m := /Templates/DecoupledFile_T(FileName_Ring_rel_100m, Fingerprint_Ring_rel_100m);

			attribute</ModelParameters/Natuur/Ring> Make_Ring_rel_100m (rdc_100m) := Calc_Ring_rel_100m, StorageName = "=FileName_Ring_rel_100m", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_Ring_rel_100m/Write_Fingerprint"
			, Descr = "Schrijft de ringkaart eenmalig weg. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
			attribute</ModelParameters/Natuur/Ring> Read_Ring_rel_100m (rdc_100m) : StorageName = "=FileName_Ring_rel_100m", StorageType = "gdal.grid", StorageReadOnly = "TRUE";

			attribute</ModelParameters/Natuur/Ring> Ring_rel_100m (rdc_100m) := = Decoupling_Ring_rel_100m/MayReuse ? 'Read_Ring_rel_100m' : 'Make_Ring_rel_100m'
			, Descr = "De ring waar de cel in valt, ontkoppeld. Met een geldige fingerprint wordt de tif gelezen; anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_Ring_rel_100m/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";

			attribute</ModelParameters/Natuur/Ring> Ring_rel_AD (AdminDomain) := Ring_rel_100m[AdminDomain/rdc_100m_rel];

			unit<UInt32> Claimregio_Nat := range(uint32, 0, uint32(#/ModelParameters/Natuur/Deelgebied))
			, Descr = "De claimregio's van de natte natuur: de deelgebieden zelf."
			{
				attribute</ModelParameters/Natuur/Deelgebied> Deelgebied_rel                := value(id(.), /ModelParameters/Natuur/Deelgebied);
				attribute<String>                             Label                         := /ModelParameters/Natuur/Deelgebied/Label[Deelgebied_rel], DialogType = "LabelText";
				attribute<.>                                  Per_AdminDomain (AdminDomain) := value(uint32(Deelgebied_rel_AD), .);
			}

			unit<UInt32> Claimregio_Droog := range(uint32, 0, uint32(#/ModelParameters/Natuur/DroogClaims))
			, Descr = "De claimregio's van de droge natuur: deelgebied maal NNN-ring, in dezelfde volgorde als ModelParameters/Natuur/DroogClaims, dus deelgebied voorop en ring binnenin."
			{
				attribute</ModelParameters/Natuur/DroogClaims> Claim_rel := value(id(.), /ModelParameters/Natuur/DroogClaims);
				attribute<String>                              Label     := /ModelParameters/Natuur/DroogClaims/Label[Claim_rel], DialogType = "LabelText";

				attribute<UInt32> Index_AD (AdminDomain) := uint32(Deelgebied_rel_AD) < 5u ? uint32(Deelgebied_rel_AD) * 5u + uint32(Ring_rel_AD) : null_u
				, Descr = "Het rijnummer in DroogClaims. De grens bij 5 sluit de zesde regio uit, die alleen bestaat omdat de shapefile een zwerfpolygoon met deelgeb2 gelijk aan Veen bevat. Een niet-toegekende cel geeft hier null, want een vergelijking met null levert FALSE op.";

				attribute<.> Per_AdminDomain (AdminDomain) := value(Index_AD, .);
			}

			unit<UInt8> NatType : NrOfRows = 3
			, Descr = "De natte natuurtypen. De aanlevering onderscheidt bos/moeras van vochtige graslanden; de eerste valt hier uiteen in broekbos en moeras."
			{
				attribute<String> name : ['VochtigHooiland','Broekbos','Moeras'];
				attribute<String> code : ['N10.02','N14.01','N05.04'];
				attribute<String> ClaimExpr :
				[
					 '/ModelParameters/Natuur/NatClaims/@K@_VochtigGrasland'
					,'/ModelParameters/Natuur/NatClaims/@K@_BosMoeras * /ModelParameters/Natuur/Aandeel_Broekbos'
					,'/ModelParameters/Natuur/NatClaims/@K@_BosMoeras * (1f - /ModelParameters/Natuur/Aandeel_Broekbos)'
				], Descr = "Sjabloon voor de opgave, met @K@ voor de variantkolom. Wordt ingevuld in NatuurAllocZand_T.";

				attribute<INL_Beheertype> INL_Beheertype_rel := rlookup(code, INL_Beheertype/code)
				, IntegrityCheck = "all(IsDefined(this))"
				, Descr = "De vertaling van de omschrijving in #652 naar een beheertype. Vochtige graslanden worden N10.02 Vochtig hooiland, broekbos N14.01 Rivier- en beekbegeleidend bos, want in een beekdal is broekbos beekbegeleidend bos, en moeras N05.04 Dynamisch moeras. Voor het veenbroekbos in de beekdalen op veen, subtype Dz6, zou N14.02 Hoog- en laagveenbos passender zijn; dat onderscheid is niet gemaakt omdat de opgave geen splitsing naar subtype geeft.";
			}

			unit<UInt8> DroogType : NrOfRows = 3
			, Descr = "De droge natuurtypen, met de vaste aandelen 60-30-10 uit #652."
			{
				attribute<String> name        : ['Bos','Heide','OpenZand'];
				attribute<String> code        : ['N15.02','N07.01','N07.02'];
				attribute<String> AandeelNaam : ['Aandeel_Droog_Bos','Aandeel_Droog_Heide','Aandeel_Droog_OpenZand'];

				attribute<INL_Beheertype> INL_Beheertype_rel := rlookup(code, INL_Beheertype/code)
				, IntegrityCheck = "all(IsDefined(this))"
				, Descr = "Bos wordt N15.02 Dennen-, eiken- en beukenbos, heide N07.01 Droge heide en open zand N07.02 Zandverstuiving. Dat laatste bewust niet N05.01.13 Open zand: die code hangt in de classificatie onder moeras en hoort bij de rivieren, terwijl het hier om stuifzand in het zandlandschap gaat.";
			}

			attribute<Bool> IsAgrarischGrasland (LGNKlasse) := LGNKlasse/code == 1w || LGNKlasse/code == 45w
			, Descr = "De zeef van de natte natuur volgens #652: agrarisch grasland. Dat is LGN 1 agrarisch gras plus 45 natuurlijk beheerde agrarische graslanden.";

			attribute<Bool> IsAgrarisch (LGNKlasse) := IsAgrarischGrasland
				|| LGNKlasse/code ==  2w || LGNKlasse/code ==  3w || LGNKlasse/code ==  4w || LGNKlasse/code ==  5w
				|| LGNKlasse/code ==  6w || LGNKlasse/code ==  9w || LGNKlasse/code == 10w
				|| LGNKlasse/code == 61w || LGNKlasse/code == 62w
			, Descr = "De zeef van de droge natuur volgens #652: alle agrarische klassen behalve glastuinbouw. Dus mais, aardappelen, bieten, granen, overige landbouwgewassen, boomgaarden, bloembollen, boomkwekerijen en fruitkwekerijen bovenop het grasland, en klasse 8 glastuinbouw er niet bij.";

			attribute<Bool> IsDroogBKN (AdminDomain) :=
				   /SourceData/Landschap/BasiskaartNatuurlijkSysteemNederlandK/BNSN_rel_AdminDomain == /Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/V/Stuwwallen
				|| /SourceData/Landschap/BasiskaartNatuurlijkSysteemNederlandK/BNSN_rel_AdminDomain == /Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/V/Kleileemgebied
				|| /SourceData/Landschap/BasiskaartNatuurlijkSysteemNederlandK/BNSN_rel_AdminDomain == /Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/V/Dekzandgebied
			, Descr = "Ligt de cel in een landvorm die volgens de aanlevering geschikt is voor droge bos-, zand- en heidesystemen?

						De aanlevering noemt subtypen: dekzandrug, dekzandvlakte, grondmorene in drie varianten,
						smeltwaterafzetting, stuifzandduin en stuwwal. De config heeft alleen de hoofdklassenkaart met
						elf klassen, dus die subtypen zijn hier samengenomen tot drie hoofdklassen: Stuwwallen dekt
						stuwwal, Dekzandgebied dekt dekzandrug, dekzandvlakte, smeltwaterafzetting en stuifzandduin, en
						Kleileemgebied dekt de grondmorene, die immers keileem is. Samen 1.466.906 ha van de 1.668.981
						ha in de claimregio's.

						Dat is grover dan gevraagd, maar het verschil is klein: de subtypen die binnen deze drie
						hoofdklassen vallen en NIET in de lijst staan zijn de beekdalen en droogdalen, en die worden
						hieronder al apart uitgesloten omdat daar juist de natte natuur landt. Wat er dus echt
						verloren gaat is de scheiding tussen de kleinere landvormen binnen het dekzandgebied. Wil je
						dat scherper, dan is de subtypenversie van de Basiskaart Natuurlijk Systeem nodig, via de
						Klimaateffectatlas of rechtstreeks bij de aanleverende partij, die hem voor de opgave al
						gebruikt heeft.";

			parameter<Bool> NatteNatuurOpAlleLandbouw := TRUE
			, Descr = "Mag natte natuur op alle landbouwgrond in de beekdalen landen, of alleen op agrarisch grasland?

						Staat aan. Issue #652 schrijft agrarisch grasland voor, maar dan past de opgave niet: de zeef
						biedt dan 100.221 ha binnen het beekdalherstel en na de toets op bestaand bebouwd gebied nog
						97.126 ha, tegen een opgave van 109.972 ha in NbSMax en NbSGenuanceerd. Het tekort van 12.846 ha
						zat in alle vijf de deelgebieden, dus het was geen kwestie van een scheve verdeling. Met alle
						agrarische klassen is er 143.138 ha beschikbaar en past de opgave met ruimte over. Het hele
						beekdalherstel is 220.746 ha.

						Uitzetten geeft de letterlijke lezing van #652 terug, met dat tekort. De diagnose-uitdraai
						zandnatuur_krapte_nat.txt laat het per deelgebied zien.";

			attribute<Bool> Zeef_Nat (AdminDomain) := IsBeekdalHerstel && MakeDefined((NatteNatuurOpAlleLandbouw ? IsAgrarisch : IsAgrarischGrasland)[/SourceData/Grondgebruik/LGN/m25], FALSE)
			, Descr = "Waar mag natte natuur landen: binnen het beekdalherstel uit #630 en op landbouwgrond, zie NatteNatuurOpAlleLandbouw voor welke klassen dat zijn.";

			attribute<Bool> Zeef_Droog (AdminDomain) := !IsBeekdalHerstel && IsDroogBKN && MakeDefined(IsAgrarisch[/SourceData/Grondgebruik/LGN/m25], FALSE)
			, Descr = "Waar mag droge natuur landen: buiten het beekdalherstel, op een geschikte landvorm en op agrarische grond.";

			parameter<String> Cluster_Straal := /ModelParameters/Natuur/Trekking/Zand/Cluster_Straal
			, Descr = "Over welke straal de geschiktheid wordt uitgesmeerd, en daarmee hoe groot de natuurvlekken worden.

						Dit is het antwoord op het spikkelpatroon. De aanlevering geeft binnen een claimregio geen
						voorkeur voor de ene plek boven de andere, dus stond hier eerst een trekking per cel. De
						arealen klopten daarmee, maar de allocator koos dan de losse toppen van een ruisoppervlak,
						en die liggen als losse cellen van 25 bij 25 meter verspreid over het landbouwgebied.
						Hetzelfde probleem als bij waterberging in #575, en met dezelfde oplossing: middel de
						geschiktheid over een schijf, dan komen er aaneengesloten gebieden boven de zaaglijn uit in
						plaats van losse toppen.

						Vijfhonderd meter is een schijf van 78 ha. Groter geeft grotere en dus minder vlekken,
						kleiner geeft er meer en kleinere.";

			parameter<Float32> Ruis_Amplitude := /ModelParameters/Natuur/Trekking/Zand/Ruis_Amplitude
			, Descr = "Hoe zwaar de ruis meeweegt ten opzichte van de aansluiting bij bestaande natuur. Beide lopen van 0 tot 1, en de som wordt door 1 plus dit getal gedeeld, zodat de geschiktheid tussen 0 en 1 blijft zoals NatuurAlloc_T verlangt.

						Op een half gezet. De ruis kan de aansluiting daarmee overstemmen zodra het aandeel
						bestaande natuur in de omgeving onder de helft ligt, en dat is in verreweg de meeste
						claimregio's het geval. Zonder ruis zou de allocatie in de buitenste ringen op een vlak van
						allemaal nullen stuiten en daar weer willekeurig kiezen; met alleen ruis zou ze nergens
						aansluiten bij wat er al ligt.";

			parameter<UInt32> Seed_Nat   := /ModelParameters/Natuur/Trekking/Zand/Seed_Nat, Descr = "Vaste seeds voor de ruis, zodat twee runs met dezelfde configuratie dezelfde kaart geven. Per type een eigen seed, want de ruis is het enige dat de typen ruimtelijk uit elkaar houdt: de aansluitingsterm is voor alle typen gelijk en valt bij de keuze tussen typen dus tegen elkaar weg.";
			parameter<UInt32> Seed_Droog := /ModelParameters/Natuur/Trekking/Zand/Seed_Droog;

			attribute<Float32> Natuur_Aandeel_100m      (rdc_100m) := mean(float32(Basisjaar/IsNatuur), AdminDomain/rdc_100m_rel);
			attribute<Float32> NatuurWater_Aandeel_100m (rdc_100m) := mean(float32(Basisjaar/IsNatuur || Basisjaar/IsWater), AdminDomain/rdc_100m_rel)
			, Descr = "Voor de natte natuur telt bestaand open water mee als aanknopingspunt: in een beekdal is de beek zelf de plek waar natte natuur zich aan vastzet.";

			attribute<Float32> Aanhaken_Droog_100m (rdc_100m) :=
				='potential(Natuur_Aandeel_100m, /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/Flat2)
					/ /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/oppervlakte'
			, Descr = "Het aandeel bestaande natuur in een schijf rond de cel, tussen 0 en 1. Nieuwe natuur die tegen bestaande natuur aan ligt is meer waard dan een even grote vlek midden in het landbouwgebied, en dit is de maat die daarvoor zorgt.

						Op 100 meter gerekend en niet op de 25 meter van het AdminDomain, om dezelfde reden als bij
						Ringresolutie: een schijf van 500 meter vraagt op 25 meter een kern van 41 bij 41 cellen over
						ruim 27 miljoen cellen, op 100 meter is dat 11 bij 11 over 1,7 miljoen. De prijs is dat de
						rand van een natuurvlek op 100 meter verspringt, en dat is ruim binnen de nauwkeurigheid van
						een opgave die alleen hectares per claimregio geeft.";

			attribute<Float32> Aanhaken_Nat_100m (rdc_100m) :=
				='potential(NatuurWater_Aandeel_100m, /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/Flat2)
					/ /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/oppervlakte';

			container Ruis_Nat :=
				for_each_nedv(
					NatType/name
					, 'potential(rnd_uniform(' + string(Seed_Nat + uint32(id(NatType))) + ', rdc_500m, range(float32, 0f, 1f))[rdc_100m/rdc_500m_rel], /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/Flat2)
							/ /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/oppervlakte'
					, rdc_100m
					, Float32
				)
			, Descr = "Een glad ruisoppervlak per type, tussen 0 en 1.

						De trekking gebeurt per cel van 500 meter en wordt daarna over een schijf van Cluster_Straal
						gemiddeld. Twee redenen om niet per cel te trekken en dat te middelen: het gemiddelde van
						honderd trekkingen ligt zo dicht op een half dat er geen reliëf overblijft, en een gemiddelde
						van een handvol trekkingen blijft vanzelf tussen 0 en 1 zonder dat er genormaliseerd of
						afgekapt hoeft te worden.";

			container Ruis_Droog :=
				for_each_nedv(
					DroogType/name
					, 'potential(rnd_uniform(' + string(Seed_Droog + uint32(id(DroogType))) + ', rdc_500m, range(float32, 0f, 1f))[rdc_100m/rdc_500m_rel], /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/Flat2)
							/ /Geography/Distmatrices_100m/pot' + Cluster_Straal + '/oppervlakte'
					, rdc_100m
					, Float32
				);

			container Geschiktheid_Nat :=
				for_each_nedv(
					NatType/name
					, 'Zeef_Nat ? ((Aanhaken_Nat_100m + Ruis_Amplitude * Ruis_Nat/' + NatType/name + ') / (1f + Ruis_Amplitude))[AdminDomain/rdc_100m_rel] : null_f'
					, AdminDomain
					, Float32
				)
			, Descr = "Geschiktheid voor natte natuur: aansluiting bij bestaande natuur en water, plus ruis, en null buiten de zeef.

						Beide termen zijn glad, en dat is de hele bedoeling: de allocator maximaliseert de som van de
						geschiktheid binnen de opgave, dus met een glad oppervlak komen er aaneengesloten vlekken uit
						en niet de losse toppen die een trekking per cel oplevert.

						De taakverdeling tussen de twee termen zit in de wiskunde van de allocator. Welke cellen
						natuur worden hangt af van de hele geschiktheid, dus daar telt de aansluiting mee. Welk van de
						drie typen een cel wordt hangt alleen af van het verschil tussen de typen, en dat is de ruis,
						want de aansluitingsterm is voor alle typen dezelfde en valt weg. Zo komen de typen als
						aaneengesloten vlekken naast elkaar te liggen in plaats van door elkaar heen.";

			container Geschiktheid_Droog :=
				for_each_nedv(
					DroogType/name
					, 'Zeef_Droog ? ((Aanhaken_Droog_100m + Ruis_Amplitude * Ruis_Droog/' + DroogType/name + ') / (1f + Ruis_Amplitude))[AdminDomain/rdc_100m_rel] : null_f'
					, AdminDomain
					, Float32
				)
			, Descr = "Idem voor droge natuur. De ligging ten opzichte van het NNN, die #652 als trede noemt, zit hier niet in de geschiktheid maar in de claimregio: de aanlevering geeft per ring een eigen getal en heeft die afweging dus al gemaakt. De aansluiting bij bestaande natuur is iets anders dan die ring, want het NNN bevat ook nog niet gerealiseerde natuur.";

			container Controle
			: Descr = "Controlegetallen op de zeven en de indeling, los van de allocatie zelf."
			{
				parameter<Ha> Areaal_Claimregios := sum(IsDefined(Regio_rel_AD)  ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 1.668.981 ha.";
				parameter<Ha> Areaal_Zeef_Nat    := sum(Zeef_Nat                 ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Hoeveel agrarisch grasland ligt er in het beekdalherstel. Vergelijk met de opgave van 109.972 ha in NbS.";
				parameter<Ha> Areaal_Zeef_Droog  := sum(Zeef_Droog               ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Hoeveel agrarische grond op geschikte landvorm ligt er buiten de beekdalen. Vergelijk met de opgave van 180.158 ha in NbSMax.";
				parameter<Ha> Areaal_DroogBKN    := sum(IsDroogBKN               ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Areaal van de drie hoofdklassen samen, over heel Nederland.";
				parameter<Ha> Areaal_NNN         := sum(IsNNN_100m[AdminDomain/rdc_100m_rel] ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Areaal van het Natuurnetwerk Nederland zoals het model het op 100 meter ziet.";

				parameter<Ha> Areaal_Beekdal_Totaal       := sum(IsBeekdalHerstel ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het hele beekdalherstel uit #630, 220.746 ha.";
				parameter<Ha> Areaal_Beekdal_AlleLandbouw := sum(IsBeekdalHerstel && MakeDefined(IsAgrarisch[/SourceData/Grondgebruik/LGN/m25], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Hoeveel ruimte de natte natuur zou krijgen als de zeef alle agrarische klassen toeliet in plaats van alleen grasland. Het verschil met Areaal_Zeef_Nat is de enige knop waarmee de natte opgave alsnog past; zie de meting bij Zeef_Nat.";
			}
		}
	}

	container Basisjaar
	: Descr = "De natuur zoals die er in het basisjaar ligt, met een natuurbeheertype per cel. Zie ObjectVision/RSopen#652.

				Twee vragen, elk met een eigen bron. De stand-administratie (BaseData/StartState/Landgebruik) bepaalt OF
				een cel natuur of water is, uit LGN. De beheertypenkaart bepaalt WELK beheertype het dan is: sinds
				5 september 2026 het Natuurbeheerplan 2026 van de provincies (SourceData/Grondgebruik/NBP, #776), met de
				MNP-planpotentieelkaart als tweede kaart voor de gaten en daarna een heuristiek; ModelParameters/Beheertype_Basisjaar_Bron
				kiest tussen NBP en MNP. De NVK-kaart huidig van 2020 was tot dan de tweede keuze en is vervallen.

				Waarom de MNP-kaart niet rechtstreeks: die is planpotentieel, dus huidige natuur plus de volledige
				realisatie van alle geplande maatregelen, inclusief het Natuurnetwerk. Het masker op de stand haalt dat
				plandeel eruit, en het NBP is de huidig-kaart die dat masker eigenlijk overbodig maakt.

				Deze container heeft twee taken. Hij is de beheertypelaag van de bestaande natuur voor de
				NL2120-landgebruikskaart (Make_LandgebruikskaartNL2120_T/BT_Basisjaar) en geeft met IsNatuur en IsWater
				de zeven en de aanhaking van veen en zand hun basisjaar. En hij is de beoogde basis voor de indicatoren
				over bestaande natuurwaarden, waaronder de koolstofvoorraad in het basisjaar die in #483 nog op nul
				staat. De achtervang onder de landschapstypen in de NbS-varianten, waarvoor hij eind augustus 2026 in
				de plaats kwam van de volle MNP-kaart (die 187.445 ha landbouwgrond omzette op gezag van een BAU-plan),
				is sinds #751 de stand-administratie zelf."
	{
		attribute<bool> IsNatuur (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/IsNatuur[/BaseData/StartState/Landgebruik/Type], FALSE)
		, Descr = "Is deze cel in het basisjaar natuur? Sinds #751 een verwijzing naar de stand-administratie, zodat de oplegging, de landgebruikskaart en de indicatoren dezelfde definitie lezen: het type in BaseData/StartState/Landgebruik en de vlag IsNatuur op LandgebruikType. Stond daarvoor achtereenvolgens op LGN hedonisch, op gg_basis (#774) en weer op LGN hedonisch; de hedonische vlag telt riet, moerasbos en natuurlijk beheerd grasland als natuur, de stand-administratie alleen als er een beheertype ligt.";

		attribute<bool> IsWater (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/IsWater[/BaseData/StartState/Landgebruik/Type], FALSE)
		, Descr = "Is deze cel in het basisjaar open water? Sinds #751 uit de stand-administratie, net als IsNatuur hierboven; dat is LGN 16 en 17 plus de cellen waar de beheertypenkaart een watertype geeft.

					De vragers zijn de rivierenkant (de waterkern van het zomerbed) en veenbouwsteen 9b (bestaand open water om extra bufferruimte op te zetten), allebei vragen naar het wateroppervlak zelf. Een valkuil: via LU_ModelType kan het niet, want LGN 16 en 17 hebben daar een lege klasse, en tot 26 augustus 2026 stond IsWater daardoor overal op FALSE. Hoe de oplegging van nieuw water wordt getoetst staat sinds #751 in Templates/VariantData/Natuur/Natuur_T/IsNieuw.";

		attribute<bool> IsLandbouw (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/IsLandbouw[/BaseData/StartState/Landgebruik/Type], FALSE)
		, Descr = "Is deze cel in het basisjaar landbouwgrond? Uit dezelfde stand-administratie als IsNatuur en IsWater hierboven, via de vlag IsLandbouw op LandgebruikType: elk landbouwtype, plus de LGN-klassen die er een dragen.

					De vrager is veenbouwsteen 9a, het nieuwe open water voor waterbuffering. Dat landt volgens het antwoord van Deltares in #660 bij voorkeur op landbouwgrond en niet op bestaande natuur; zie Templates/VariantData/Natuur/Veen_T/BouwsteenType/VoorrangPad.";

		attribute<bool> IsBebouwd (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/IsBebouwd[/BaseData/StartState/Landgebruik/Type], FALSE)
		, Descr = "Staat er in het basisjaar bebouwing of verharding op deze cel? Idem uit de stand-administratie, via de vlag IsBebouwd op LandgebruikType. Dat zijn de LGN-klassen 18, 19, 20, 23, 26, 28, 252 en 253: bebouwing in primair en secundair bebouwd gebied, bebouwing in het buitengebied, en halfverharde en smalle wegen.

					Dit is de bebouwing zoals het landgebruik haar ziet en niet zoals de BAG haar ziet, en beide zijn nodig. De pandentoets (BaseData/Omgeving/Opleggingsmasker/HeeftPanden) kent alleen de panden zelf, deze vlag ook het erf, de verharding en de wegen eromheen. Team Veen rekent haar bebouwd gebied als wonen plus infrastructuur plus verhard werken en overig, dus deze kant sluit daarbij aan (#660). De vrager is de bebouwde fractie van de veenbouwstenen, zie Templates/VariantData/Natuur/Veen_T/IsBestaandeBebouwing.";

		attribute<INL_Beheertype> BT_NBP (AdminDomain) := /SourceData/Grondgebruik/NBP/INL_Beheertype_AD
		, Descr = "Beheertype volgens het Natuurbeheerplan 2026 op 25 meter, ontkoppeld (#776). De bron in BaseData/StartState/Landgebruik/Beheertype en de tegenpartij van de MNP-kaart in Controle.";

		attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := /BaseData/StartState/Landgebruik/Beheertype
		, Descr = "Het beheertype van de bestaande natuur en het bestaande water. Sinds #751 een verwijzing naar de basiskaart van de stand-administratie, BaseData/StartState/Landgebruik/Beheertype, zodat er een definitie is; de bron daarvan kiest ModelParameters/Beheertype_Basisjaar_Bron (NBP of MNP, #776), en het masker is hetzelfde als IsNatuur || IsWater hier. Stond tot 4 september 2026 als IsNatuur || IsWater ? BT_Levering : null. Null waar de cel geen van beide is, en ook waar hij dat wel is maar de bron geen type geeft; zie Controle/Areaal_ZonderBeheertype.

					Water hoort hier sinds #751 bij, en dat is geen uitbreiding maar een correctie. De typentabel INL_Beheertype bevat de watertypen al, N04.01 tot en met N04.04, en NatuurType scheidt ze van de natuurtypen met een vlag waarop een IntegrityCheck staat. Er waren dus nooit twee bronnen, alleen een masker dat de helft van de eigen tabel niet doorliet. Dit is de laag waar de beoogde administratie op verder bouwt: een beheertype per cel voor natuur en water samen, met het landgebruik dat zegt welke van de twee het is.";

		container Controle
		{
			parameter<Ha> Areaal_Natuur           := sum(IsNatuur && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Natuur in het basisjaar volgens de stand-administratie (LandgebruikType/IsNatuur op BaseData/StartState/Landgebruik/Type). Stond tot #774 op LGN hedonisch (509.140 ha), van #774 tot 4 september 2026 op LU_Basisjaar (587.216 ha), en sinds #751 op de stand-administratie; meet opnieuw voordat je het getal citeert.";
			parameter<Ha> Areaal_MetBeheertype    := sum(IsDefined(INL_Beheertype_rel_AD) && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Daarvan het deel waar de bron een beheertype geeft. Dekt sinds #751 natuur en water samen; leg het dus naast Areaal_Natuur plus Areaal_Water en niet naast Areaal_Natuur alleen.";
			parameter<Ha> Areaal_BT_uit_NBP       := sum(IsNatuur && IsDefined(BT_NBP) && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Bestaande natuur waarvoor het Natuurbeheerplan een beheertype geeft.";
			parameter<Ha> Areaal_BT_uit_MNP       := sum(IsNatuur && IsDefined(Bron/Landelijk_BAU/INL_Beheertype_rel_AD) && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Bestaande natuur waarvoor de MNP-kaart een beheertype geeft.";
			parameter<Ha> Areaal_BT_alleen_NBP    := sum(IsNatuur && IsDefined(BT_NBP) && !IsDefined(Bron/Landelijk_BAU/INL_Beheertype_rel_AD) && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waar het Natuurbeheerplan wel een type geeft en de MNP-kaart zwijgt.";
			parameter<Ha> Areaal_BT_Beide         := sum(IsNatuur && IsDefined(BT_NBP) && IsDefined(Bron/Landelijk_BAU/INL_Beheertype_rel_AD) && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waar beide bronnen een type geven.";
			parameter<Ha> Areaal_BT_Eens          := sum(IsNatuur && IsDefined(BT_NBP) && BT_NBP == Bron/Landelijk_BAU/INL_Beheertype_rel_AD && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "En waar ze het daar ook over eens zijn, op het niveau van het beheertype zelf.";
			parameter<Ha> Areaal_NT_Eens          := sum(IsNatuur && IsDefined(BT_NBP) && INL_Beheertype/NatuurType_rel[BT_NBP] == INL_Beheertype/NatuurType_rel[Bron/Landelijk_BAU/INL_Beheertype_rel_AD] && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Idem, maar dan op het grovere niveau van het natuurtype, de achttien N-hoofdklassen. Ligt dit veel hoger dan Areaal_BT_Eens, dan zit het verschil tussen de twee kaarten vooral in het detailniveau, bijvoorbeeld N05.01 tegenover N05.01.13, en niet in de vraag wat voor natuur het is.";
			parameter<Ha> Areaal_Water            := sum(IsWater && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Water in het basisjaar volgens het model. Hoort sinds #751 bij de noemer van Areaal_ZonderBeheertype, want de beheertypelaag dekt nu natuur en water samen.";
			parameter<Ha> Areaal_ZonderBeheertype := Areaal_Natuur + Areaal_Water - Areaal_MetBeheertype, Descr = "Natuur en water zonder beheertype: de stand zegt natuur of water en geen van de kaarten geeft een type. Met Beheertype_GatenVullen aan hoort dit nul te zijn (BaseData/StartState/Landgebruik/Controle telde op 5 september 2026 nul); zonder de aanvulling is het het gat dat het NBP en de MNP-kaart samen laten liggen.";
			parameter<Ha> Areaal_MNP_Plandeel     := sum(IsDefined(Bron/Landelijk_BAU/INL_Beheertype_rel_AD) && !IsNatuur && Geography/rdc_meter/IsStudyArea_AdminDomain ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "De andere kant: waar de MNP-kaart een beheertype geeft en het basisjaar geen natuur. Dat is het planpotentieel, en dat is precies wat met deze kaart niet meer wordt opgelegd in de NbS-varianten.";
		}
	}

}
