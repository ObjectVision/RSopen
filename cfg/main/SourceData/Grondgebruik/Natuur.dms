	unit<uint32> Read_Rivierengebied_BAU
	:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/BAU/BAU-Natuur.mmd"
	, 	StorageReadOnly = "true"
	,	Source          = "Ontvangen van Deltares op 20260611"
	, 	Descr           = "Natuur_Y2120_Rivierengebied_BAU";
	unit<uint32> Rivierengebied_BAU := Read_Rivierengebied_BAU
	{
		attribute<HydrologieK>    Hydrologie_rel    := rlookup(hydrologie, HydrologieK/label);
		attribute<EcotoopK>       Ecotoop_rel       := rlookup(NL_2120, EcotoopK/label);
		attribute<GeomorfologieK> Geomorfologie_rel := rlookup(zonering, GeomorfologieK/label);
		attribute<bool>           IsNat              := HydrologieK/IsOever[Hydrologie_rel] || Geomorfologie_rel == GeomorfologieK/V/Oevers; // Nat = oeverzone (HydrologieK/IsOever) of geomorfologische zone 'Oevers'. 'Oeverwal/hoge uiterwaard' is droog.
		
		unit<uint8> HydrologieK := unique_uint8(hydrologie)
		{
			attribute<string> label := values;
			attribute<bool>   IsOever := substr(label, 0, 5) == 'Oever', Descr = "Natte oeverzone: alle 'Oever - ...'-klassen. Onderscheidt nat/droog t.b.v. de beheertype-keuze.";
			container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
		}
		unit<uint8> EcotoopK := unique_uint8(NL_2120)
		{
			attribute<string> label := values;
			container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
		}
		unit<uint8> GeomorfologieK := unique_uint8(zonering)
		{
			attribute<string> label := values;
			container V := for_each_nedv(AsItemName(label), 'value('+string(id(.))+', ..)', void, .);
		}
		
		attribute<INL_Beheertype> INL_Beheertype_rel := 
			switch(
					case(Ecotoop_rel == EcotoopK/V/Moeras                                 , INL_Beheertype/V_obvCode/N05_04) // dynamisch moeras
				,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_bos && IsNat                , INL_Beheertype/V_obvCode/N14_01) // rivier-/beekbegeleidend bos (zachthoutooibos)
				,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_bos                         , INL_Beheertype/V_obvCode/N14_03) // haagbeuken-/essenbos (hardhoutooibos)
				,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_grasland && IsNat           , INL_Beheertype/V_obvCode/N10_02) // vochtig hooiland
				,case(Ecotoop_rel == EcotoopK/V/Natuurlijk_grasland                    , INL_Beheertype/V_obvCode/N12_02) // kruiden-/faunarijk grasland
				,case(Ecotoop_rel == EcotoopK/V/Onbegroeid_pionier_natuurlijk_ && IsNat, INL_Beheertype/V_obvCode/N05_01_14 ) // slikkige rivieroever
				,case(Ecotoop_rel == EcotoopK/V/Onbegroeid_pionier_natuurlijk_         , INL_Beheertype/V_obvCode/N05_01_13) // open zand
				,case(Ecotoop_rel == EcotoopK/V/Ruigte                                 , INL_Beheertype/V_obvCode/N12_06) // ruigteveld
				,case(Ecotoop_rel == EcotoopK/V/Struweel_houtig_                       , INL_Beheertype/V_obvCode/N05_01_06) // moerasstruweel (wilg)
				,case(Ecotoop_rel == EcotoopK/V/Stagnant_water                         , INL_Beheertype/V_obvCode/N04_02) // zoete plas
				,case(Ecotoop_rel == EcotoopK/V/Zomerbed                               , INL_Beheertype/V_obvCode/N02_01) // rivier
				, null_b // agrarisch gebruik/grasland en bebouwd = geen natuur -> geen beheertype
			);
		
		attribute<.>              Per_AdminDomain       (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
		attribute<NatuurType>     NatuurTypen_rel_AD    (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
	}
	
	unit<uint32> Rivierengebied_NbSMax 
	:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbS/Natuur_Y2120_Rivierengebied_NbSMax_20260629.shp"
	, 	StorageType     = "gdal.vect"
	,	Source          = "Ontvangen van Deltares op 20260528"
	, 	Descr           = "In de bijlage de kaartlaag voor NbS Max. Voor BaU nemen we de bestaande riviertranches (zie ook bestand) en de verdere veranderingen in het 
								BaU ruimtescanner scenario. Het GIS bestand heeft 3 lagen 'nieuwe uiterwaarden, moerasgebieden en water'. 
								In deze gebieden moet de bestaande bebouwing verdwijnen (uitkoop) en zijn er toekomstige bouwrestricties. 
								De moerasgebieden zijn ook tevens waterberginggebieden. Ook de landbouwfunctie verdwijnt in deze gebieden. 
								Ze moeten nog aangeven welk percentage welk type natuur wordt. Ga er vanuit dat dit een combinatie wordt van 
								open zand/grindvlakte, ruigte, grasland, zachthoutooibos, hardhoutooibos, zomerbed (water) en uiterwaardwater. 
								Volgens mij is het voor de meeste indicatoren nu niet relevant welk natuurtype het precies wordt. 
								Met uitzondering van koolstofvastlegging."
	, DialogData = "rdc_meter"
	{
		attribute<.>      Per_AdminDomain   (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<INL_Beheertype> INL_Beheertype_rel := switch(
																case(lowercase(type) == 'moeras',              rlookup('N05.04',    INL_Beheertype/code)) // moerasgebied -> dynamisch moeras
															,case(lowercase(type) == 'uiterwaarden',        rlookup('N12.02',    INL_Beheertype/code)) // nieuwe uiterwaard (mix) -> kruiden-/faunarijk grasland als representatieve klasse
															,case(lowercase(type) == 'water (beek bypass)', rlookup('N03.01',    INL_Beheertype/code)) // nevengeul -> beek en bron
															, null_b
														);
		attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
		attribute<NatuurType>     NatuurTypen_rel_AD    (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
	}
	
	// unit<uint32> Rivierengebied_NbSMax
	// :	StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbS/Natuur_Y2120_Rivierengebied_NbSMax_20260528.shp"
	// , 	StorageType     = "gdal.vect"
	// ,	Source          = "Ontvangen van Deltares op 20260528"
	// , 	Descr           = "In de bijlage de kaartlaag voor NbS Max. Voor BaU nemen we de bestaande riviertranches (zie ook bestand) en de verdere veranderingen in het 
	// 							BaU ruimtescanner scenario. Het GIS bestand heeft 3 lagen 'nieuwe uiterwaarden, moerasgebieden en water'. 
	// 							In deze gebieden moet de bestaande bebouwing verdwijnen (uitkoop) en zijn er toekomstige bouwrestricties. 
	// 							De moerasgebieden zijn ook tevens waterberginggebieden. Ook de landbouwfunctie verdwijnt in deze gebieden. 
	// 							Ze moeten nog aangeven welk percentage welk type natuur wordt. Ga er vanuit dat dit een combinatie wordt van 
	// 							open zand/grindvlakte, ruigte, grasland, zachthoutooibos, hardhoutooibos, zomerbed (water) en uiterwaardwater. 
	// 							Volgens mij is het voor de meeste indicatoren nu niet relevant welk natuurtype het precies wordt. 
	// 							Met uitzondering van koolstofvastlegging."
	// , DialogData = "rdc_meter"
	// {
	// 	attribute<.>      Per_AdminDomain   (AdminDomain) := poly2grid(geometry, AdminDomain);
	// 	attribute<INL_Beheertype> INL_Beheertype_rel := switch(
	// 														 case(lowercase(type) == 'moeras',              rlookup('N05.04',    INL_Beheertype/code)) // moerasgebied -> dynamisch moeras
	// 														,case(lowercase(type) == 'uiterwaarden',        rlookup('N12.02',    INL_Beheertype/code)) // nieuwe uiterwaard (mix) -> kruiden-/faunarijk grasland als representatieve klasse
	// 														,case(lowercase(type) == 'water (beek bypass)', rlookup('N03.01',    INL_Beheertype/code)) // nevengeul -> beek en bron
	// 														, null_b
	// 													);
	// 	attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := INL_Beheertype_rel[Per_AdminDomain];
	// 	attribute<NatuurType>     NatuurTypen_rel_AD    (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
	// }

	// De SqlString doet drie dingen die niet vanzelf spreken, zie #613.
	// 1. Hernoemen. De kolomnamen in de bron beginnen met een cijfer en zijn dus geen geldige DMS-itemnamen. Ze gaan naar
	//    BS2, BS3a en verder, gelijk aan NbSVeen/NbSBouwsteen/name, en meteen van percentage naar fractie. Kolommen die in
	//    een van beide lagen ontbreken komen als 0.0 mee, zodat beide lagen dezelfde twaalf bouwstenen kennen.
	// 2. Ontdubbelen. In de peilvakkenlaag komen 201 geometrieen meer dan een keer voor, bij 104 daarvan met verschillende
	//    percentages. Deltares laat weten dat de middelste rij de juiste is; dat is wat rn = (cnt + 1) / 2 selecteert.
	//    8439 rijen worden zo 7666. Gemeten scheelt de keuze tussen eerste, middelste en laatste minder dan een half
	//    procent per bouwsteen, dus dit is vooral een kwestie van reproduceerbaar vastleggen.
	// 3. Sorteren op oppervlak, groot eerst. De bron bevat geneste polygonen: een groot peilvak zonder bouwsteen 9a met
	//    daarbinnen kleine waterpolygonen die volledig 9a zijn. poly2grid laat de laatste polygoon winnen, dus zonder
	//    deze ordening wist het grote peilvak de kleine eronder uit en verdween er 1.500 ha bouwsteen 9a. Klein moet dus
	//    als laatste komen. Het gaat in totaal om 2.252 ha overlappend oppervlak.
	container NbSGenuanceerd_Veen
	: Descr = "NbS-bouwstenen in het veengebied en de daaruit volgende natuurbeheertypen, voor de variant NbSGenuanceerd."
	{
		container Bron_PerPeilvak
		: StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/NBSnuanc_bouwsteen_pct_perpeilvak.gpkg"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "TRUE"
		, Source          = "Deltares, aangeleverd via SURFdrive NL2120/Veen/NBS nuanc/nbsnuanc/voorNatuur"
		, DialogData      = "rdc_meter"
		{
			unit<uint32> gebied
			: SqlString = "select coalesce(\"2_pct\", 0) / 100.0 as BS2, coalesce(\"3a_pct\", 0) / 100.0 as BS3a, coalesce(\"3b_pct\", 0) / 100.0 as BS3b, coalesce(\"4a_pct\", 0) / 100.0 as BS4a, coalesce(\"4b_pct\", 0) / 100.0 as BS4b, coalesce(\"5_pct\", 0) / 100.0 as BS5, coalesce(\"6_pct\", 0) / 100.0 as BS6, coalesce(\"7_pct\", 0) / 100.0 as BS7, coalesce(\"8_pct\", 0) / 100.0 as BS8, coalesce(\"9a_pct\", 0) / 100.0 as BS9a, coalesce(\"9b_pct\", 0) / 100.0 as BS9b, 0.0 as BS10a, geom from (select *, row_number() over (partition by geom order by fid) as rn, count(*) over (partition by geom) as cnt from NBSnuanc_bouwsteen_pct_perpeilvak) where rn = (cnt + 1) / 2 order by ST_Area(geom) desc"
			, Descr = "Gebieden met een peilvak. De percentages per bouwsteen tellen per peilvak niet tot 100 op; de rest is bouwsteen 0, 1 of 10.";
		}

		container Bron_ZonderPeilvak
		: StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/NBSnuanc_bouwsteen_pct_zonderpv.gpkg"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "TRUE"
		, Source          = "Deltares, aangeleverd via SURFdrive NL2120/Veen/NBS nuanc/nbsnuanc/voorNatuur"
		, DialogData      = "rdc_meter"
		{
			unit<uint32> gebied
			: SqlString = "select coalesce(\"2_pct\", 0) / 100.0 as BS2, coalesce(\"3a_pct\", 0) / 100.0 as BS3a, coalesce(\"3b_pct\", 0) / 100.0 as BS3b, coalesce(\"4a_pct\", 0) / 100.0 as BS4a, coalesce(\"4b_pct\", 0) / 100.0 as BS4b, coalesce(\"5_pct\", 0) / 100.0 as BS5, 0.0 as BS6, coalesce(\"7_pct\", 0) / 100.0 as BS7, 0.0 as BS8, 0.0 as BS9a, 0.0 as BS9b, coalesce(\"10_pct\", 0) / 100.0 as BS10a, geom from (select *, row_number() over (partition by geom order by fid) as rn, count(*) over (partition by geom) as cnt from NBSnuanc_bouwsteen_pct_zonderpv) where rn = (cnt + 1) / 2 order by ST_Area(geom) desc"
			, Descr = "Gebieden zonder peilvak. Hier geldt in principe een bouwsteen per gridcel, dus 100 procent. Voor 3 en 4 is de locatie van variant a en b niet bepaald, dus staat het daar op 50-50.";
		}

		attribute<Bron_PerPeilvak/gebied>    PerPeilvak_rel    (AdminDomain) := poly2grid(Bron_PerPeilvak/gebied/geometry, AdminDomain);
		attribute<Bron_ZonderPeilvak/gebied> ZonderPeilvak_rel (AdminDomain) := poly2grid(Bron_ZonderPeilvak/gebied/geometry, AdminDomain);
		attribute<bool>                      IsVeengebied      (AdminDomain) := IsDefined(PerPeilvak_rel) || IsDefined(ZonderPeilvak_rel), Descr = "Cel valt binnen het door Deltares aangeleverde veengebied. Bouwsteen 0, 1 en 10 zijn niet aangeleverd en vallen hier dus grotendeels buiten.";

		container Fr_perBouwsteen := 
			for_each_nedv(
				NbSVeen/NbSBouwsteen/MetBrondata/name
				, 'MakeDefined(Bron_ZonderPeilvak/gebied/'+NbSVeen/NbSBouwsteen/MetBrondata/name+'[ZonderPeilvak_rel], Bron_PerPeilvak/gebied/'+NbSVeen/NbSBouwsteen/MetBrondata/name+'[PerPeilvak_rel])[float32]'
				, AdminDomain
				, float32
			), Descr = "Fractie van het celoppervlak per NbS-bouwsteen. Buiten het veengebied null, binnen het veengebied nul waar de bouwsteen niet voorkomt.";


		parameter<string> Expr_Natuurtype :='add('+AsItemList('Fr_perBouwsteen/'+NbSVeen/NbSBouwsteen/MetBrondata/name+' * NbSVeen/Fracties_vd_Bouwsteen/@NT@[NbSVeen/NbSBouwsteen/V/'+NbSVeen/NbSBouwsteen/MetBrondata/name+']')+')', Descr = "Sjabloon voor Fr_perNatuurtype: per bouwsteen de fractie van de cel maal het aandeel van het natuurbeheertype in die bouwsteen, gesommeerd over alle bouwstenen.";

		container Fr_perNatuurtype := 
			for_each_nedv(
				NbSVeen/NbSNatuurtype/InGebruik/name
				, replace(Expr_Natuurtype, '@NT@', NbSVeen/NbSNatuurtype/InGebruik/name)
				, AdminDomain
				, float32
			), Descr = "Fractie van het celoppervlak per natuurbeheertype, als mengsel over alle bouwstenen in het gebied. Dit is product 2 uit #613.";

		parameter<string> Expr_Landgebruik :='add('+AsItemList('Fr_perBouwsteen/'+NbSVeen/NbSBouwsteen/MetBrondata/name+' * NbSVeen/NbSBouwsteen/Fr_@LG@[NbSVeen/NbSBouwsteen/V/'+NbSVeen/NbSBouwsteen/MetBrondata/name+']')+')', Descr = "Sjabloon voor Fr_perLandgebruik, zelfde opzet als Expr_Natuurtype maar dan voor de hoofdtypen landgebruik uit kolommen X:AC.";

		container Fr_perLandgebruik :=
			for_each_nedv(
				NbSVeen/NbSLandgebruik/name
				, replace(Expr_Landgebruik, '@LG@', NbSVeen/NbSLandgebruik/name)
				, AdminDomain
				, float32
			), Descr = "Fractie van het celoppervlak per hoofdtype landgebruik. Let op VernatGrasland_Kruidenrijk: dat is de kolom die in de brontabel N12.02 agrarisch heet. Die geldt hier als agrarisch grasland en niet als natuur, conform de brontabel zelf, die hem buiten de N-typen houdt, en conform de economische functie grasland en veeteelt van bouwsteen 3a en 4a. Zou dat besluit omgaan, dan is het een kwestie van deze kaart optellen bij Fr_perNatuurtype/N12_02. Zie #613.";

		attribute<float32>              Fr_Bouwsteen_Totaal     (AdminDomain) := ='add('+AsItemList('Fr_perBouwsteen/'+NbSVeen/NbSBouwsteen/MetBrondata/name)+')', IntegrityCheck = "all(IsNull(this) || this <= 1.02f)", Descr = "Som van de bouwsteenfracties per cel. Blijft onder 1 omdat de rest bouwsteen 0, 1 of 10 is. In de bron komen afrondingen tot 101 procent voor; boven 102 procent klopt er iets niet, bijvoorbeeld doordat de twee lagen elkaar zijn gaan overlappen.";

		container Controle
		: Descr = "Vergelijkt het gerasterde areaal per bouwsteen met het areaal dat rechtstreeks uit de polygonen volgt. Bedoeld als vangnet voor de nesting in de bron: als de ordening in de SqlString wegvalt, wist een groot peilvak de kleine polygonen eronder uit en loopt het raster stil weg bij de vector."
		{
			attribute<Ha> opp_pv (Bron_PerPeilvak/gebied)    := area(Bron_PerPeilvak/gebied/geometry, meter2_f64)[Ha];
			attribute<Ha> opp_zp (Bron_ZonderPeilvak/gebied) := area(Bron_ZonderPeilvak/gebied/geometry, meter2_f64)[Ha];

			unit<uint8> PerBouwsteen := NbSVeen/NbSBouwsteen/MetBrondata
			{
				attribute<string> code := NbSVeen/NbSBouwsteen/MetBrondata/code;

				attribute<Ha> Vector := ='union_data(., '+AsItemList('sum(Bron_PerPeilvak/gebied/'+NbSVeen/NbSBouwsteen/MetBrondata/name+'[float32] * Controle/opp_pv) + sum(Bron_ZonderPeilvak/gebied/'+NbSVeen/NbSBouwsteen/MetBrondata/name+'[float32] * Controle/opp_zp)')+')'
				, Descr = "Areaal per bouwsteen rechtstreeks uit de polygonen. Telt de genestelde stukken dubbel, dus dit ligt iets boven de rasterwaarde.";

				attribute<Ha> Raster := ='union_data(., '+AsItemList('sum(Fr_perBouwsteen/'+NbSVeen/NbSBouwsteen/MetBrondata/name+') * AdminDomain/NrHaPerCell')+')'
				, Descr = "Areaal per bouwsteen zoals het model het gerasterd heeft.";

				attribute<float32> Ratio := Raster / Vector
				, IntegrityCheck = "all(abs(this - 1f) < 0.05f)"
				, Descr = "Het raster mag hooguit 5 procent van de vectorbron afwijken. De genestelde polygonen verklaren tot ongeveer 2 procent; loopt het verder weg, dan wint bij het rasteren de verkeerde polygoon. Zie #613.";
			}
		}
		attribute<float32>              Fr_Natuur_Totaal        (AdminDomain) := ='add('+AsItemList('Fr_perNatuurtype/'+NbSVeen/NbSNatuurtype/InGebruik/name)+')', Descr = "Som over alle natuurbeheertypen. Blijft onder het aandeel N-typen van de bouwstenen zolang 3b en 4b geen verdeling hebben.";
		attribute<NbSVeen/NbSBouwsteen> DominanteBouwsteen      (AdminDomain) := ='NbSVeen/NbSBouwsteen/MetBrondata/org_rel[ArgMax_ifdefined('+AsItemList('Fr_perBouwsteen/'+NbSVeen/NbSBouwsteen/MetBrondata/name+' > 0f ? Fr_perBouwsteen/'+NbSVeen/NbSBouwsteen/MetBrondata/name+' : null_f')+')[NbSVeen/NbSBouwsteen/MetBrondata]]', Descr = "De bouwsteen met de grootste fractie in de cel, product 1 uit #613. Alleen bedoeld voor kaartweergave: bij een gelijke stand wint de eerste, en minderheidsbouwstenen binnen een peilvak verdwijnen. Reken met Fr_perBouwsteen.";
		attribute<INL_Beheertype>       INL_Beheertype_rel_AD   (AdminDomain) := ='NbSVeen/NbSNatuurtype/InGebruik/INL_Beheertype_rel[ArgMax_ifdefined('+AsItemList('Fr_perNatuurtype/'+NbSVeen/NbSNatuurtype/InGebruik/name+' > 0f ? Fr_perNatuurtype/'+NbSVeen/NbSNatuurtype/InGebruik/name+' : null_f')+')[NbSVeen/NbSNatuurtype/InGebruik]]', Descr = "Het natuurbeheertype met de grootste fractie in de cel, product 3 uit #613. Bepaald over het mengsel van alle bouwstenen in het gebied, niet over de dominante bouwsteen. Bij een gelijke stand wint het eerste type in de volgorde van NbSNatuurtype.";
		attribute<NatuurType>           NatuurTypen_rel_AD      (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
		attribute<INL_Beheertype>       ExoNatuur               (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Natuur[NatuurTypen_rel_AD] ? INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		attribute<INL_Beheertype>       ExoWater                (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Water[NatuurTypen_rel_AD]  ? INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	}

	container NbSGenuanceerd_Kust
	: Descr = "Ruimtebeslag van de NbS-bouwstenen uit het toekomstbeeld Kust, voor de variant NbSGenuanceerd. Zie issue #623.

				Drie leveringen van team Kust, een per landschapstype:
				  Kerven        : zandige kust, gebieden met hoge potentie voor kerven in de duinen.
				  Westerschelde : meegroeilandschappen en voorlanden, variant A.
				  Waddenzee     : meegroeilandschappen en voorlanden, variant A, scenario Hoog.

				In dit hele ruimtebeslag verandert het huidige grondgebruik in natuur. Er mag dus niet meer
				gebouwd worden en de bestaande bebouwing wordt gesloopt. Dat loopt via NietBouwen (de zeef voor
				wonen en werken) en via ExoNatuur (het exogeen opleggen, dat op zijn beurt de sloop- en
				uitkoopindicatoren voedt).

				De megasuppleties zijn bewust niet geleverd: dat zijn puntlocaties op zee zonder ruimtebeslag op
				land. Van de varianten B en C is niets geleverd, alleen A."
	{
		parameter<bool> NeemBuitendijksMee := TRUE
		, Descr = "Tellen ook de buitendijkse delen mee (veld zijde is zee)? Staat aan, want de aanleverende partij schrijft dat het hele ruimtebeslag natuur wordt.

					Deze schakelaar raakt vooral het natuurareaal, nauwelijks de sloop. Uitzetten haalt 31.689 ha uit de
					oplegging, 41 procent van het totaal, waarvan 28.254 ha nu groot water is. Dat is precies de
					kwelder- en voorlandvorming waar de meegroeilandschappen om draaien: team Kust rekent voor de
					Wadden met een groei van 10.270 naar 24.477 ha kwelder. Van de 16.864 panden in het ruimtebeslag
					liggen er maar 298 in het deel dat alleen buitendijks wordt geraakt, dus voor sloop, uitkoop en de
					zeef maakt de stand nauwelijks verschil.";

		unit<uint32> Kerven
		:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Kust_Kerven_NbSgenuanceerd_20260624.shp"
		,  StorageType     = "gdal.vect"
		,  StorageReadOnly = "True"
		,  DialogType      = "Map"
		,  DialogData      = "geometry_rd"
		,  Source          = "Deltares, team Kust NL2120. Oorspronkelijke bestandsnaam Hogepotentie_Kerven.shp, geleverd op 2026-08-21 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/NaarSDNL2120_Inout Kust_NbSGenuanceerd_slopenEnNietBouwen. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf."
		,  Descr           = "Zandige kust: 49 polygonen met hoge potentie voor kerven, samen ongeveer 20.200 ha, van Walcheren tot de oostelijke Waddeneilanden.

							Drie eigenaardigheden in de levering. Ten eerste staat dit bestand als enige in WGS84 graden, vandaar geometry_rd. Ten tweede is het veld id niet uniek: 49 records op 32 ids, want de multipart-polygonen zijn geexplodeerd met behoud van het id van de ouder. Ten derde bevatten de kolommen oppervlakt en oppvl2 tot en met oppvl5 dezelfde oppervlakte in m2, maar is alleen oppvl5 voor alle 49 records gevuld; de rest heeft sterretjes. Reken dus met de geometrie en niet met die kolommen."
		{
			attribute<wgs84_base> geometry        (poly);
			attribute<rdc_meter>  geometry_rd     (poly)        := convert(geometry, rdc_meter), Descr = "Herprojectie van WGS84 naar RD. De levering zelf is bewust ongewijzigd gelaten, de omzetting gebeurt hier.";
			attribute<.>          Per_AdminDomain (AdminDomain) := poly2grid(geometry_rd, AdminDomain);
			attribute<bool>       IsGebied        (AdminDomain) := IsDefined(Per_AdminDomain);
		}

		unit<uint32> Westerschelde
		:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Kust_Westerschelde_NbSgenuanceerd_20260615.shp"
		,  StorageType     = "gdal.vect"
		,  StorageReadOnly = "True"
		,  DialogType      = "Map"
		,  DialogData      = "geometry"
		,  Source          = "Deltares, team Kust NL2120. Oorspronkelijke bestandsnaam Variant_A_WSBinnenBuitendijks.shp, geleverd op 2026-08-21, zelfde map als Kerven."
		,  Descr           = "Westerschelde: 21 polygonen meegroeilandschap en voorland, variant A, samen ongeveer 10.650 ha, waarvan 5.300 ha binnendijks.

							De overige velden zijn zonale statistiek en worden hier niet gebruikt. De namen zijn in de dbf afgekapt: Elev. mean en Elev. me_1 tot en met me_5 zijn count, min, max, mean, median en stddev van de hoogte, in dezelfde volgorde als de reeksen GHW (gemiddeld hoogwater) en SSC (sedimentconcentratie). Het veld opp_m2 is niet de polygoonoppervlakte maar de celtelling maal 22500 m2 van het 150m-statistiekraster, en telt dus maar tot ongeveer de helft op."
		{
			attribute<rdc_meter> geometry        (poly);
			attribute<string>    zijde;
			attribute<bool>      IsBinnendijks                 := lowercase(zijde) == 'land', Descr = "Het veld zijde heeft twee waarden: land is binnendijks, zee is buitendijks.";
			attribute<bool>      IsMeegenomen                  := IsBinnendijks || NeemBuitendijksMee;
			attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<bool>      IsGebied        (AdminDomain) := MakeDefined(IsMeegenomen[Per_AdminDomain], FALSE);
		}

		unit<uint32> Waddenzee
		:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Kust_Waddenzee_NbSgenuanceerd_20260630.shp"
		,  StorageType     = "gdal.vect"
		,  StorageReadOnly = "True"
		,  DialogType      = "Map"
		,  DialogData      = "geometry"
		,  Source          = "Deltares, team Kust NL2120. Oorspronkelijke bestandsnaam Waddenzee_Variant_A_BinnenBuitendijks_Hoog.shp, geleverd op 2026-08-21, zelfde map als Kerven."
		,  Descr           = "Waddenzee: 35 polygonen meegroeilandschap en voorland, variant A, scenario Hoog, samen ongeveer 47.100 ha, waarvan 20.800 ha binnendijks.

							Samengevoegd uit vier bronlagen: eilanden en vasteland, elk binnen- en buitendijks. Die herkomst staat nog in de velden layer en path. Wat Hoog precies betekent (hoog zeespiegelscenario of hoge ambitie) staat nog uit bij de aanleverende partij; de Westerschelde-levering heeft die aanduiding niet."
		{
			attribute<rdc_meter> geometry        (poly);
			attribute<string>    zijde;
			attribute<bool>      IsBinnendijks                 := lowercase(zijde) == 'land';
			attribute<bool>      IsMeegenomen                  := IsBinnendijks || NeemBuitendijksMee;
			attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<bool>      IsGebied        (AdminDomain) := MakeDefined(IsMeegenomen[Per_AdminDomain], FALSE);
		}

		attribute<bool> IsKustIngreep (AdminDomain) := Kerven/IsGebied || Westerschelde/IsGebied || Waddenzee/IsGebied
		, Descr = "Cel valt in het ruimtebeslag van een van de drie leveringen. Hier gebeuren twee dingen. Er mag niet meer gebouwd worden, dat loopt via NietBouwen hieronder naar de zeef. En de bestaande bebouwing moet wijken, dat loopt via ExoNatuur: het exogeen opleggen maakt de cel leeg en de indicatoren UitkoopEnSloopkostenNieuweNatuur rekenen daarop af.";
		attribute<bool> NietBouwen    (AdminDomain) := IsKustIngreep, Descr = "Hier mag niet meer gebouwd worden. Wordt in VariantData/NietBouwen opgepakt en daar alleen voor de variant NbSGenuanceerd aangezet.";

		parameter<string> Beheertypecode_Kerven       := 'N08.02.02'
		, Descr = "Voorlopige keuze: stuivend duinzand, want kerven zijn juist bedoeld om de duindynamiek terug te brengen. De vraag welke natuur het echt wordt staat nog uit bij team Stad, zie #623. Aanpassen kan hier, de rest volgt.";
		parameter<string> Beheertypecode_Meegroeiland := 'N09.01'
		, Descr = "Voorlopige keuze: schor of kwelder, het beheertype dat bij meegroeilandschappen en voorlanden hoort. Zelfde voorbehoud als bij Beheertypecode_Kerven.";

		attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) :=
			Kerven/IsGebied
				? rlookup(Beheertypecode_Kerven, INL_Beheertype/code)
				: IsKustIngreep
					? rlookup(Beheertypecode_Meegroeiland, INL_Beheertype/code)
					: null_b[INL_Beheertype]
		, IntegrityCheck = "IsDefined(rlookup(Beheertypecode_Kerven, INL_Beheertype/code)) && IsDefined(rlookup(Beheertypecode_Meegroeiland, INL_Beheertype/code))"
		, Descr = "Beheertype per cel. Kerven gaan voor waar ze een meegroeilandschap zouden overlappen; in de praktijk overlappen die elkaar nauwelijks. De IntegrityCheck faalt als een van de twee codes niet in INL_Beheertype voorkomt.";

		attribute<NatuurType>     NatuurTypen_rel_AD (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];
		attribute<INL_Beheertype> ExoNatuur          (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Natuur[NatuurTypen_rel_AD] ? INL_Beheertype_rel_AD : null_b[INL_Beheertype];
		attribute<INL_Beheertype> ExoWater           (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Water[NatuurTypen_rel_AD]  ? INL_Beheertype_rel_AD : null_b[INL_Beheertype], Descr = "Met de huidige voorlopige beheertypen levert dit niets op: zowel N08 als N09 telt als natuur, niet als water. Staat hier voor als er straks wel open water uit de kustlevering komt.";

		parameter<Ha> Areaal_Kerven        := sum(Kerven/IsGebied        ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering ongeveer 20.200 ha, hier minus wat buiten het studiegebied valt en plus of min de rastering.";
		parameter<Ha> Areaal_Westerschelde := sum(Westerschelde/IsGebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering ongeveer 10.650 ha met NeemBuitendijksMee, 5.300 ha zonder.";
		parameter<Ha> Areaal_Waddenzee     := sum(Waddenzee/IsGebied     ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering ongeveer 47.100 ha met NeemBuitendijksMee, 20.800 ha zonder.";
		parameter<Ha> Areaal_Totaal        := sum(IsKustIngreep          ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal over de drie leveringen samen, dus zonder dubbeltelling van overlap. Bij oplevering op 25m: 77.984 ha, tegen 78.989 ha bij optelling van de drie afzonderlijk, dus ruim 1.000 ha overlap.";
	}

	container NbSGenuanceerd_Zand
	: Descr = "Beekdalherstel uit het toekomstbeeld Zand, voor de variant NbSGenuanceerd. Zie issue #630.

				Een levering van team Zand: de beekdalen en droogdalen waar herstel plaatsvindt. Anders dan bij
				kust gaat het hier alleen op slot voor nieuwbouw. De bestaande bebouwing mag blijven staan, dus
				er loopt geen tak naar ExoNatuur en naar de sloop- en uitkoopindicatoren.

				De natuurontwikkeling zit hier nog niet in. Volgens de levering wordt de landbouwgrond in de
				beekdalen omgezet naar natuur en vochtig grasland (natuurinclusieve landbouw niveau 3), maar
				welk natuurbeheertype dat is en of het om alle landbouwgrond gaat staat nog uit bij team Zand.
				Zodra dat er is komt dat hier bij, met dezelfde opbouw als NbSGenuanceerd_Kust: een
				INL_Beheertype_rel_AD plus ExoNatuur."
	{
		parameter<bool> NeemDroogdalenMee := TRUE
		, Descr = "Tellen naast de beekdalen ook de droogdalen mee? Staat aan, want de levering heet beekdalherstel en de aanleverende partij heeft de droogdalen daar zelf in gezet.

					De levering bestaat voor 192.726 ha uit beekdal (Dz5, Dz6 en Lg5) en voor 28.070 ha uit
					droogdal (Sw4, Sw4x en Lg6). Uitzetten haalt dus ruim een achtste van het ruimtebeslag weg.
					Dit is vraag 1 uit #630 en staat nog uit bij team Zand.";

		parameter<bool> BeperkTotZandgebied := FALSE
		, Descr = "Alleen de dalen binnen de landschapsbegrenzing van zand op slot, of de hele levering? Staat uit, want de aanleverende partij heeft de hele shape geleverd.

					Dit is vraag 2 uit #630: de levering loopt door in andere landschappen. In termen van de
					Basiskaart Natuurlijk Systeem doet ze dat niet, want alle records vallen in Dekzandgebied (Dz),
					Stuwwallen (Sw) of loss (Lg). Het is dus de NL2120-landschapsindeling waar ze buiten treedt.
					Let op dat Begrenzing zandgebied een grove omhullende van 47 punten is, geen scherpe grens.";

		unit<uint8> DalTypeK : NrOfRows = 6
		, Descr = "De zes BKNSN-subtypen in de levering, met per type of het een beekdal of een droogdal is. De aantallen records zijn ter orientatie; de arealen staan bij NeemDroogdalenMee."
		{
			attribute<string> code      : ['Dz5','Dz6','Lg5','Sw4','Sw4x','Lg6'];
			attribute<string> label     : ['Beekdal zand/leem','Beekdal veen','Beekdal','Droogdal','Droogdal met keileem','Droogdal'];
			attribute<bool>   IsBeekdal : [TRUE,TRUE,TRUE,FALSE,FALSE,FALSE];
			attribute<uint32> NrRecords : [18418,4222,179,6056,298,1580];
		}

		unit<uint32> Beekdalherstel
		:  StorageName     = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Zand_Beekdalherstel_NbSgenuanceerd_20260819.shp"
		,  StorageType     = "gdal.vect"
		,  StorageReadOnly = "True"
		,  DialogType      = "Map"
		,  DialogData      = "geometry"
		,  Source          = "Deltares, team Zand NL2120. Oorspronkelijke bestandsnaam beekdalherstel.shp, geleverd op 2026-08-21 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/beekdalherstel. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf."
		,  Descr           = "30.753 polygonen, samen ongeveer 220.796 ha, van Zeeuws-Vlaanderen tot Groningen.

							Twee velden: BKNSN_code met het subtype uit de Basiskaart Natuurlijk Systeem Nederland en
							Subtype_na met de bijbehorende omschrijving. Dat laatste veld is in de dbf afgekapt van
							Subtype_naam. Er is geen veld dat beekdalherstel onderscheidt van beekdal, dus de aanname
							is dat de hele levering herstelgebied is. Dat is vraag 1 uit #630."
		{
			attribute<rdc_meter> geometry             (poly);
			attribute<string>    BKNSN_code;
			attribute<string>    Subtype_na;
			attribute<DalTypeK>  DalTypeK_rel                       := rlookup(BKNSN_code, DalTypeK/code), IntegrityCheck = "all(IsDefined(this))", Descr = "Faalt als er een BKNSN-code in de levering staat die niet in DalTypeK is opgenomen, bijvoorbeeld na een nieuwe levering.";
			attribute<bool>      IsBeekdal                          := DalTypeK/IsBeekdal[DalTypeK_rel];
			attribute<bool>      IsDroogdal                         := !IsBeekdal;
			attribute<bool>      IsMeegenomen                       := IsBeekdal || NeemDroogdalenMee;
			attribute<.>         Per_AdminDomain       (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<bool>      IsGebied              (AdminDomain) := MakeDefined(IsMeegenomen[Per_AdminDomain], FALSE);
			attribute<bool>      IsBeekdalCel          (AdminDomain) := MakeDefined(IsBeekdal[Per_AdminDomain], FALSE), Descr = "Alleen voor de controlegetallen hieronder.";
			attribute<bool>      IsDroogdalCel         (AdminDomain) := MakeDefined(IsDroogdal[Per_AdminDomain], FALSE), Descr = "Alleen voor de controlegetallen hieronder. Let op: eerst per record negeren en dan pas naar het raster, anders levert de negatie buiten het ruimtebeslag TRUE op.";
		}

		attribute<bool> IsInZandgebied   (AdminDomain) := /SourceData/RegioIndelingen/Landschappen/Zandgebied/IsGebied, Descr = "Valt de cel binnen de NL2120-landschapsbegrenzing van zand. Alleen gebruikt als BeperkTotZandgebied aan staat.";
		attribute<bool> IsBeekdalHerstel (AdminDomain) := Beekdalherstel/IsGebied && (IsInZandgebied || !BeperkTotZandgebied)
		, Descr = "Cel valt in het ruimtebeslag van de levering, na toepassing van de twee schakelaars hierboven. Hier mag niet meer gebouwd worden. Er wordt niet gesloopt, dus er loopt geen tak naar ExoNatuur.";
		attribute<bool> NietBouwen       (AdminDomain) := IsBeekdalHerstel, Descr = "Hier mag niet meer gebouwd worden. Wordt in VariantData/NietBouwen opgepakt en daar alleen voor de variant NbSGenuanceerd aangezet.";

		parameter<Ha> Areaal_Beekdalen        := sum(Beekdalherstel/IsBeekdalCel  ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 192.726 ha, op 25m 192.675 ha; het verschil is de rastering.";
		parameter<Ha> Areaal_Droogdalen       := sum(Beekdalherstel/IsDroogdalCel ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 28.070 ha, op 25m ook 28.070 ha.";
		parameter<Ha> Areaal_Totaal           := sum(IsBeekdalHerstel             ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal na de schakelaars: het areaal dat daadwerkelijk op slot gaat. Met beide schakelaars op hun huidige stand 220.746 ha op 25m, tegen 220.796 ha in de levering.";
		parameter<Ha> Areaal_BuitenZandgebied := sum(Beekdalherstel/IsGebied && !IsInZandgebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal bij vraag 2 uit #630: hoeveel van de levering ligt buiten de landschapsbegrenzing van zand. Dat is maar 156 ha van de 220.746, dus BeperkTotZandgebied aanzetten verandert vrijwel niets. Dat komt doordat Begrenzing zandgebied een grove omhullende is.";
		parameter<Ha> Areaal_OokInLaagveen    := sum(Beekdalherstel/IsGebied && /SourceData/RegioIndelingen/Landschappen/Laagveen/IsGebied       ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal bij vraag 2 uit #630: hoeveel van de levering valt ook binnen de omhullende van het laagveenlandschap. Dat is 49.498 ha, ruim een vijfde. De omhullenden overlappen elkaar, dus dit is geen exclusieve toedeling; het is wel de plek waar de opmerking dat de shape doorloopt in andere landschappen vandaan komt.";
		parameter<Ha> Areaal_OokInRivieren    := sum(Beekdalherstel/IsGebied && /SourceData/RegioIndelingen/Landschappen/Rivierengebied/IsGebied ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Idem voor het rivierenlandschap: 789 ha.";
	}

	
	container NbSGenuanceerd_Rivieren
	: Descr = "Ecotopen en natuurbeheertypen uit het toekomstbeeld Rivieren, voor de variant NbSGenuanceerd. Zie issue #621.

				Een levering van team Rivieren: 59 gebieden, 23 buitendijkse riviertrajecten (64.462 ha) en 36
				binnendijkse gebieden (23.886 ha), samen 88.348 ha. Per gebied geeft de levering geen kaartbeeld
				maar een verdeling: het aandeel van elk van de vijftien ecotooptypen, samen 100 procent. Van dat
				areaal krijgt 79.782 ha een natuurbeheertype; de resterende 8.566 ha blijft agrarisch grasland of
				akker en ligt in vijf van de binnendijkse gebieden.

				Het model werkt per cel met een klasse en niet met een mengsel, dus de verdeling moet ergens naar
				een kaart. Dat gebeurt hier met een trekking: elke cel krijgt een vaste toevalswaarde en valt
				daarmee in een van de ecotopen van zijn gebied, in verhouding tot de aandelen. Over het gebied als
				geheel komen de arealen daarmee uit op de levering. Zie TrekEcotopenProportioneel voor de reden om
				dat niet met de dominante klasse te doen.

				Hier gebeuren twee dingen. Er mag in het hele ruimtebeslag niet meer gebouwd worden, dat loopt via
				NietBouwen naar de zeef. En de cellen die natuur of water worden gaan via ExoNatuur en ExoWater de
				exogene oplegging in, die op haar beurt de sloop- en uitkoopindicatoren voedt. De cellen die
				agrarisch blijven gaan wel op slot maar worden niet opgelegd."
	{
		parameter<bool> NeemBinnendijksMee := TRUE
		, Descr = "Tellen naast de buitendijkse riviertrajecten ook de binnendijkse gebieden mee? Staat aan, want de levering bevat ze en het toekomstbeeld gaat er expliciet over.

					Uitzetten haalt 23.886 ha uit het ruimtebeslag, ruim een kwart, en daarmee ook de enige
					agrarische rest in de levering. De aanleverende partij tekent bij de binnendijkse set aan dat
					het een gefilterde selectie van 36 gebieden is en niet dezelfde reeks als in NbSMax, dus voor
					een vergelijking tussen varianten is deze schakelaar het aangewezen instrument.";

		parameter<bool> TrekEcotopenProportioneel := TRUE
		, Descr = "Hoe wordt de verdeling per gebied een kaart? Aan betekent trekken in verhouding tot de aandelen, uit betekent het hele gebied de dominante klasse geven.

					Aan, en dat is hier geen smaakkwestie. Dominant kiezen op beheertype, zoals bij de bouwstenen in
					het veengebied, kan bij deze levering helemaal niet: N01.03 Rivier- en moeraslandschap
					verzamelt zes van de vijftien ecotopen en wint daarmee in alle 59 gebieden, zodat het hele
					ruimtebeslag van 88.348 ha een klasse zou worden in plaats van 42.381 ha. Dominant kiezen op
					ecotoop, wat Ecotoop_rel_Dominant doet, houdt wel verschil maar verschuift de arealen fors:
					struweel (7.336 ha), stromend water (4.509 ha), onbegroeid pionier (2.416 ha) en agrarisch
					gebruik (4.283 ha) winnen nergens en verdwijnen helemaal, terwijl moeras van 8.028 naar 19.125
					ha springt en hardhout ooibos van 8.146 naar 14.582 ha. Dat raakt vooral koolstof, want ooibos,
					moeras en open water zitten in heel andere koolstofklassen.

					De prijs van de trekking is dat de plek binnen een gebied verzonnen is: de levering zegt niet
					waar in de uiterwaard het ooibos komt. De arealen kloppen, het patroon niet. Uitzetten geeft de
					dominante klasse terug, zie Ecotoop_rel_Dominant.";

		parameter<uint32> Trekking_Seed := 621
		, Descr = "Vaste seed van de trekking, zodat twee runs met dezelfde configuratie dezelfde kaart geven. Ophogen geeft een andere ruimtelijke uitkomst met dezelfde arealen; alleen zinvol om te toetsen hoe gevoelig een indicator is voor het patroon.";

		container Bron
		: StorageName     = "%RSo_DataDir%/Beleid/Overigen/Natuur/NbSGenuanceerd/Rivieren_Ecotopen_Beheertypen_NbSgenuanceerd_20260825.gpkg"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "TRUE"
		, Source          = "Deltares, team Rivieren NL2120. Oorspronkelijke bestandsnaam riviertraces_en_binnendijks_zonder_altena_ecotopen_beheertypen.gpkg, geleverd op 2026-08-25 via SharePoint NL2120, map Toekomstbeelden/Kernteam/Uitgangspunten en beoordeling/RSInput/NiewueNatuurRiviertenNbSGenuanceerd. Naast de geopackage horen bij dezelfde levering drie tabellen, die in dezelfde map staan: Rivieren_Ecotoopoppervlakten_NbSgenuanceerd_20260825.xlsx met de arealen, Rivieren_Ecotooptypen_typologie_NbSgenuanceerd_20260825.xlsx met de typologie en Rivieren_Natuurbeheertypen_naar_ecotopen_20260825.xlsx met de conversietabel. De inhoud van die laatste twee staat in Classifications/Grondgebruik/RivierEcotoop.dms."
		, DialogData      = "rdc_meter"
		{
			unit<uint32> gebied
			: SqlString = "select coalesce(\"% Natuurlijk grasland\", 0) as Fr_NatuurlijkGrasland, coalesce(\"% Stroomdalgrasland\", 0) as Fr_Stroomdalgrasland, coalesce(\"% Agrarisch grasland\", 0) as Fr_AgrarischGrasland, coalesce(\"% Agrarisch gebruik\", 0) as Fr_AgrarischGebruik, coalesce(\"% Hardhout ooibos\", 0) as Fr_HardhoutOoibos, coalesce(\"% Zachthout ooibos\", 0) as Fr_ZachthoutOoibos, coalesce(\"% Struweel (houtig)\", 0) as Fr_Struweel, coalesce(\"% Moeras\", 0) as Fr_Moeras, coalesce(\"% Onbegroeid & pionier (natuurlijk)\", 0) as Fr_OnbegroeidPionier, coalesce(\"% Ruigte nat\", 0) as Fr_RuigteNat, coalesce(\"% Ruigte droog\", 0) as Fr_RuigteDroog, coalesce(\"% Zomerbed rivier\", 0) as Fr_ZomerbedRivier, coalesce(\"% Stromend water\", 0) as Fr_StromendWater, coalesce(\"% Stagnant water\", 0) as Fr_StagnantWater, coalesce(\"% Bebouwd/verhard/antropogeen\", 0) as Fr_BebouwdVerhard, \"type\" as gebiedtype, join_id, geom from riviertraces_binnendijks_ecotopen_beheertypen order by ST_Area(geom) desc"
			, Descr = "De 59 gebieden met hun ecotoopverdeling. De SqlString doet twee dingen. Ten eerste hernoemen: de kolomnamen in de bron beginnen met een procentteken en zijn dus geen geldige DMS-itemnamen; ze gaan naar Fr_ plus de naam uit RivierEcotoop. Ten tweede sorteren op oppervlak, groot eerst, zodat een klein gebied dat binnen een groot ligt bij het rasteren wint. In deze levering overlappen de gebieden elkaar niet, maar dezelfde valkuil kostte bij het veengebied 1.500 ha, zie #613. Controle/PerEcotoop bewaakt dat.";
		}

		attribute<bool> IsBinnendijks (Bron/gebied) := Bron/gebied/gebiedtype == 'Binnendijks', Descr = "Het veld type heeft twee waarden: Buitendijks voor de 23 riviertrajecten, Binnendijks voor de 36 overige gebieden.";
		attribute<bool> IsBuitendijks (Bron/gebied) := !IsBinnendijks, Descr = "Hier per record negeren en niet pas op het raster: buiten het ruimtebeslag levert de negatie van een lege verwijzing TRUE op.";
		attribute<bool> IsMeegenomen  (Bron/gebied) := !IsBinnendijks || NeemBinnendijksMee;

		attribute<Bron/gebied> Gebied_rel_Bron (AdminDomain) := poly2grid(Bron/gebied/geometry, AdminDomain);
		attribute<Bron/gebied> Gebied_rel      (AdminDomain) := MakeDefined(IsMeegenomen[Gebied_rel_Bron], FALSE) ? Gebied_rel_Bron : null_u[Bron/gebied]
		, Descr = "Het gebied waar de cel in valt, na de schakelaar NeemBinnendijksMee. Eerst per record beslissen en dan pas naar het raster: de negatie andersom levert buiten het ruimtebeslag TRUE op.";

		container CumFractie :=
			for_each_nedv(
				'CumFr_' + NbSRivieren/RivierEcotoop/name
				, NbSRivieren/RivierEcotoop/IsEerste
					? 'Bron/gebied/Fr_' + NbSRivieren/RivierEcotoop/name + '[float32]'
					: 'CumFr_' + NbSRivieren/RivierEcotoop/VorigeName + ' + Bron/gebied/Fr_' + NbSRivieren/RivierEcotoop/name + '[float32]'
				, Bron/gebied
				, float32
			), Descr = "Cumulatieve aandelen per gebied, in de volgorde van RivierEcotoop. De laatste komt per gebied op 1 uit. Alleen bedoeld als bovengrenzen voor de trekking hieronder.";

		attribute<float32> Trekking (AdminDomain) := ='rnd_uniform(' + string(Trekking_Seed) + ', AdminDomain, range(float32, 0f, 1f))'
		, Descr = "Een vaste toevalswaarde per cel, tussen 0 en 1. Vaste seed, dus deterministisch: dezelfde configuratie geeft dezelfde kaart.";

		attribute<NbSRivieren/RivierEcotoop> Ecotoop_rel_Getrokken (AdminDomain) :=
			='IsDefined(Gebied_rel) ? min_elem(' + AsList('uint8(Trekking >= CumFractie/CumFr_' + NbSRivieren/RivierEcotoop/name + '[Gebied_rel])', ' + ') + ', ' + string(uint8(#NbSRivieren/RivierEcotoop) - 1b) + 'b)[NbSRivieren/RivierEcotoop] : null_b[NbSRivieren/RivierEcotoop]'
		, Descr = "Het getrokken ecotoop: het aantal cumulatieve grenzen dat onder de trekking ligt, en dat is precies de klasse waar de trekking in valt. De min_elem vangt af dat de laatste cumulatieve grens door afronding net onder 1 kan uitkomen terwijl de trekking daarboven ligt.";

		attribute<NbSRivieren/RivierEcotoop> Ecotoop_rel_Dominant (AdminDomain) :=
			='ArgMax_ifdefined(' + AsItemList('Fr_perEcotoop/' + NbSRivieren/RivierEcotoop/name + ' > 0f ? Fr_perEcotoop/' + NbSRivieren/RivierEcotoop/name + ' : null_f') + ')[NbSRivieren/RivierEcotoop]'
		, Descr = "Het ecotoop met het grootste aandeel in het gebied, gelijk voor alle cellen van dat gebied. Alleen in gebruik als TrekEcotopenProportioneel uit staat; daar staat wat dat met de arealen doet. Bij een gelijke stand wint het eerste ecotoop in de volgorde van RivierEcotoop.";

		attribute<NbSRivieren/RivierEcotoop> Ecotoop_rel_AD (AdminDomain) := = TrekEcotopenProportioneel ? 'Ecotoop_rel_Getrokken' : 'Ecotoop_rel_Dominant'
		, Descr = "Het ecotoop per cel, waar alles hieronder aan hangt.";

		container Fr_perEcotoop :=
			for_each_nedv(
				NbSRivieren/RivierEcotoop/name
				, 'Bron/gebied/Fr_' + NbSRivieren/RivierEcotoop/name + '[Gebied_rel][float32]'
				, AdminDomain
				, float32
			), Descr = "Aandeel van het celoppervlak per ecotoop, zoals de levering het geeft. Buiten het ruimtebeslag null. Dit is de exacte, ononderbroken vorm van de levering; Ecotoop_rel_AD is de kaart die daaruit getrokken is.";

		parameter<string> Expr_Natuurtype := 'add(' + AsItemList('(NbSRivieren/RivierEcotoop/Beheertype_name[NbSRivieren/RivierEcotoop/V/' + NbSRivieren/RivierEcotoop/name + '] == @NT@ ? Fr_perEcotoop/' + NbSRivieren/RivierEcotoop/name + ' : 0f)') + ')'
		, Descr = "Sjabloon voor Fr_perNatuurtype: tel de aandelen op van de ecotopen die volgens de conversietabel onder het beheertype vallen. De vergelijking met de naam is een parameter en wordt dus een keer bepaald, niet per cel.";

		container Fr_perNatuurtype :=
			for_each_nedv(
				NbSRivieren/RivierNatuurtype/name
				, replace(Expr_Natuurtype, '@NT@', quote(NbSRivieren/RivierNatuurtype/name))
				, AdminDomain
				, float32
			), Descr = "Aandeel van het celoppervlak per natuurbeheertype. Gelijk aan de kolommen 'ha N..' uit de levering, gedeeld door het gebiedsoppervlak.";

		attribute<float32> Fr_Natuur_Totaal (AdminDomain) := ='add(' + AsItemList('Fr_perNatuurtype/' + NbSRivieren/RivierNatuurtype/name) + ')'
		, Descr = "Het aandeel van de cel dat een natuurbeheertype krijgt. Over de hele levering 79.782 van de 88.348 ha; alleen in vijf binnendijkse gebieden ligt dit onder 1.";

		attribute<INL_Beheertype> INL_Beheertype_rel_AD (AdminDomain) := NbSRivieren/RivierEcotoop/INL_Beheertype_rel[Ecotoop_rel_AD]
		, Descr = "Het natuurbeheertype dat bij het getrokken ecotoop hoort. Null waar de trekking op agrarisch grasland, agrarisch gebruik of bebouwd uitkomt: daar wordt niets opgelegd.";
		attribute<NatuurType>     NatuurTypen_rel_AD    (AdminDomain) := INL_Beheertype/NatuurType_rel[INL_Beheertype_rel_AD];

		attribute<INL_Beheertype> ExoNatuur (AdminDomain) := MakeDefined(NbSRivieren/RivierEcotoop/IsNatuurlijkTerrestrisch[Ecotoop_rel_AD], FALSE) ? INL_Beheertype_rel_AD : null_b[INL_Beheertype]
		, Descr = "Exogeen op te leggen natuur: de cellen waar de trekking op een terrestrisch natuurecotoop uitkomt, 58.613 ha gemeten op 25m tegen 58.649 ha in de levering.

					De keuze tussen natuur en water loopt hier over de categorie van het ecotoop en niet over
					NatuurType/IsExogeenOpTeLeggen_Natuur, zoals bij de andere leveringen. Dat moet ook: het
					beheertype N01.03 Rivier- en moeraslandschap verzamelt vier terrestrische ecotopen en twee
					waterecotopen, en valt als NatuurType onder N01, dat als water te boek staat. Via die weg zou
					28.665 ha grasland, struweel en ruigte in de waterstroom belanden. Het ecotoop weet wel wat het
					is, het beheertype niet.";
		attribute<INL_Beheertype> ExoWater  (AdminDomain) := MakeDefined(NbSRivieren/RivierEcotoop/IsWater[Ecotoop_rel_AD], FALSE) ? INL_Beheertype_rel_AD : null_b[INL_Beheertype]
		, Descr = "Exogeen op te leggen water: zomerbed, stromend water en stagnant water, samen 21.146 ha gemeten op 25m tegen 21.132 ha in de levering. Let op dat ExogeenOpleggen/Totaal in VariantData op dit moment alleen de natuurstroom neemt en de waterstroom laat liggen, net als bij bouwsteen 9a en 9b in het veengebied. Dit deel van de levering wordt dus wel op slot gezet maar nog niet opgelegd.";

		attribute<bool> IsRivierIngreep (AdminDomain) := IsDefined(Gebied_rel)
		, Descr = "Cel valt in het ruimtebeslag van de levering, na de schakelaar NeemBinnendijksMee.";
		attribute<bool> NietBouwen      (AdminDomain) := IsRivierIngreep
		, Descr = "Hier mag niet meer gebouwd worden. Wordt in VariantData/NietBouwen opgepakt en daar alleen voor de variant NbSGenuanceerd aangezet. Dit is het hele ruimtebeslag, dus ook het deel dat agrarisch blijft: dat ligt in de uiterwaard van het toekomstbeeld en komt daarmee niet in aanmerking voor nieuwbouw. Hiervan valt 1.796 ha binnen bestaand bebouwd gebied; daar vervalt de oplegging op grond van #641 en gaat het gebied alleen op slot.";

		container Controle
		: Descr = "Vergelijkt het gerasterde areaal per ecotoop met het areaal dat rechtstreeks uit de levering volgt. Vangt twee dingen af: een trekking die scheef loopt, en de valkuil van geneste polygonen waar bij het rasteren de verkeerde wint."
		{
			attribute<Ha> opp_gebied (Bron/gebied) := area(Bron/gebied/geometry, meter2_f64)[Ha];

			attribute<float32> Fractie_Totaal (Bron/gebied) := CumFractie/CumFr_BebouwdVerhard
			, IntegrityCheck = "all(abs(this - 1f) < 0.001f)"
			, Descr = "De laatste cumulatieve grens, en dus de som van de vijftien aandelen per gebied. Die moet op 1 uitkomen, anders klopt de trekking niet: cellen boven de laatste grens zouden dan bij het laatste ecotoop worden opgeteld. De levering normaliseert daar zelf al op, zie de kolom procent totaal.";

			unit<uint8> PerEcotoop := NbSRivieren/RivierEcotoop
			{
				attribute<string> Label := NbSRivieren/RivierEcotoop/Label, DialogType = "LabelText";

				attribute<Ha> Vector := ='union_data(., ' + AsItemList('sum(Bron/gebied/Fr_' + NbSRivieren/RivierEcotoop/name + '[float32] * Controle/opp_gebied * float32(IsMeegenomen))') + ')'
				, Descr = "Areaal per ecotoop rechtstreeks uit de levering: aandeel maal polygoonoppervlak, opgeteld over de meegenomen gebieden.";

				attribute<Ha> Raster := ='union_data(., ' + AsItemList('sum(Ecotoop_rel_AD == NbSRivieren/RivierEcotoop/V/' + NbSRivieren/RivierEcotoop/name + ' ? 1f : 0f) * AdminDomain/NrHaPerCell') + ')'
				, Descr = "Areaal per ecotoop zoals het model het na de trekking op de kaart heeft staan.";

				attribute<float32> Ratio := Raster / Vector
				, IntegrityCheck = "all(IsNull(this) || abs(this - 1f) < 0.05f)"
				, Descr = "Het raster mag hooguit 5 procent van de levering afwijken. Null voor bebouwd, dat in deze levering overal op nul staat. De trekking zelf geeft bij deze aantallen cellen ruim onder een procent afwijking; loopt het verder weg, dan is er iets mis met het rasteren of met de volgorde in de SqlString.";
			}

			parameter<Ha> Areaal_Buitendijks := sum(MakeDefined(IsBuitendijks[Gebied_rel], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 64.462 ha over 23 riviertrajecten, op 25m 64.438 ha.";
			parameter<Ha> Areaal_Binnendijks := sum(MakeDefined( IsBinnendijks[Gebied_rel], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. In de levering 23.886 ha over 36 gebieden, op 25m 23.877 ha, en nul als NeemBinnendijksMee uit staat.";
			parameter<Ha> Areaal_Totaal      := sum(IsRivierIngreep ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal over de hele levering: 88.348 ha, op 25m 88.315 ha. Het verschil is de rastering.";
			parameter<Ha> Areaal_ExoNatuur   := sum(IsDefined(ExoNatuur) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. Uit de levering volgt 58.649 ha terrestrische natuur, op 25m na de trekking 58.613 ha.";
			parameter<Ha> Areaal_ExoWater    := sum(IsDefined(ExoWater)  ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. Uit de levering volgt 21.132 ha water, op 25m na de trekking 21.146 ha.";
			parameter<Ha> Areaal_Agrarisch   := sum(MakeDefined(NbSRivieren/RivierEcotoop/IsAgrarisch[Ecotoop_rel_AD], FALSE) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Controlegetal. Uit de levering volgt 8.566 ha die agrarisch blijft, verdeeld over vijf binnendijkse gebieden; op 25m na de trekking 8.555 ha.";
		}
	}

	attribute<INL_Beheertype> ExoNatuur_MNP_BAU                 (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Natuur[MNP_BAU/NatuurTypen_rel_AD] ? MNP_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	attribute<INL_Beheertype> ExoNatuur_Rivier_BAU              (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Natuur[Rivierengebied_BAU/NatuurTypen_rel_AD] ? Rivierengebied_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	attribute<INL_Beheertype> ExoNatuur_BAU1                    (AdminDomain) := ExoNatuur_MNP_BAU;
	attribute<INL_Beheertype> ExoNatuur_BAU2                    (AdminDomain) := ExoNatuur_MNP_BAU;
	
	attribute<INL_Beheertype> ExoNatuur_Rivier_NbSMax           (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Natuur[Rivierengebied_NbSMax/NatuurTypen_rel_AD] ? Rivierengebied_NbSMax/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	attribute<INL_Beheertype> ExoNatuur_NbSMax                  (AdminDomain) := MakeDefined(ExoNatuur_Rivier_NbSMax, ExoNatuur_Rivier_NbSMax);

	attribute<INL_Beheertype> ExoNatuur_Rivier_NbSGenuanceerd   (AdminDomain) := NbSGenuanceerd_Rivieren/ExoNatuur, Descr = "Exogeen op te leggen natuur in het rivierengebied, uit de ecotoopverdeling per riviertraject en binnendijks gebied. Zie #621. Tot die levering er was stond dit gelijk aan de NbSMax-kaart voor rivieren; die staat er nog voor NbSMax zelf en legt 46.233 ha op, tegen 58.613 ha nu.";
	attribute<INL_Beheertype> ExoNatuur_Veen_NbSGenuanceerd     (AdminDomain) := NbSGenuanceerd_Veen/ExoNatuur, Descr = "Exogeen op te leggen natuur in het veengebied, uit de NbS-bouwstenen. Zie #613.";
	attribute<INL_Beheertype> ExoNatuur_Kust_NbSGenuanceerd     (AdminDomain) := NbSGenuanceerd_Kust/ExoNatuur, Descr = "Exogeen op te leggen natuur in het kustgebied: kerven, meegroeilandschappen en voorlanden. Zie #623.";
	attribute<INL_Beheertype> ExoNatuur_NbSGenuanceerd          (AdminDomain) := MakeDefined(MakeDefined(ExoNatuur_Veen_NbSGenuanceerd, ExoNatuur_Kust_NbSGenuanceerd), ExoNatuur_Rivier_NbSGenuanceerd), Descr = "Veen, kust en rivierengebied samen. De volgorde bepaalt wie voorgaat waar er meer dan een beheertype is: eerst veen, dan kust, dan rivieren. De drie gebieden overlappen elkaar nauwelijks: van de 58.613 ha rivierennatuur is 57.839 ha nieuw naast veen en kust. Samen 593.462 ha, gemeten op 2026-08-25. Het toekomstbeeld zand levert geen natuur, alleen een zeef, zie #630.";

	attribute<INL_Beheertype> ExoWater_MNP_BAU                  (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Water[MNP_BAU/NatuurTypen_rel_AD] ? MNP_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	attribute<INL_Beheertype> ExoWater_Rivier_BAU               (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Water[Rivierengebied_BAU/NatuurTypen_rel_AD] ? Rivierengebied_BAU/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	attribute<INL_Beheertype> ExoWater_BAU1                     (AdminDomain) := ExoWater_MNP_BAU;
	attribute<INL_Beheertype> ExoWater_BAU2                     (AdminDomain) := ExoWater_MNP_BAU;

	attribute<INL_Beheertype> ExoWater_Rivier_NbSMax            (AdminDomain) := NatuurType/IsExogeenOpTeLeggen_Water[Rivierengebied_NbSMax/NatuurTypen_rel_AD] ? Rivierengebied_NbSMax/INL_Beheertype_rel_AD : null_b[INL_Beheertype];
	attribute<INL_Beheertype> ExoWater_NbSMax                   (AdminDomain) := MakeDefined(ExoWater_Rivier_NbSMax, ExoWater_Rivier_NbSMax);

	attribute<INL_Beheertype> ExoWater_Rivier_NbSGenuanceerd    (AdminDomain) := NbSGenuanceerd_Rivieren/ExoWater, Descr = "Exogeen op te leggen water in het rivierengebied: zomerbed, stromend water en stagnant water. Zie #621.";
	attribute<INL_Beheertype> ExoWater_Veen_NbSGenuanceerd      (AdminDomain) := NbSGenuanceerd_Veen/ExoWater, Descr = "Exogeen op te leggen water in het veengebied, vooral bouwsteen 9a en 9b. Zie #613.";
	attribute<INL_Beheertype> ExoWater_NbSGenuanceerd           (AdminDomain) := MakeDefined(ExoWater_Veen_NbSGenuanceerd, ExoWater_Rivier_NbSGenuanceerd), Descr = "Veen en rivierengebied samen; kust levert geen water. Zelfde volgorde als bij de natuur.";
}

