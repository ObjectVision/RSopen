// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Huidig, HDB, BAU.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container NVK : using = "Classifications/Grondgebruik/nvk"
{
	attribute<LU_ModelType>      HDB2050_100m_diff              (rdc_100m) := HDB/count_diff_25m_cellen >= ModelParameters/MinimumCountNieuwNatuur ? HDB/HDB2050_100m_LU_ModelType : (0b/0b)[LU_ModelType];
	attribute<LU_ModelType>      BAU2050_100m_diff              (rdc_100m) := BAU/count_diff_25m_cellen >= ModelParameters/MinimumCountNieuwNatuur ? BAU/BAU2050_100m_LU_ModelType : (0b/0b)[LU_ModelType];
	
	attribute<LU_ModelType>      HDB2050_25m_diff                (rdc_25m) := HDB/HDB2050_25m_diff;
	attribute<LU_ModelType>      BAU2050_25m_diff                (rdc_25m) := BAU/BAU2050_25m_diff;
 
	container Huidig
	{
		attribute<HDB_NVKKlasse> Read_Huidig_2_5m                (rdc_2_5m) 
		: StorageName = "%RSo_DataDir%/Grondgebruik/NVK/nvk_huidig-20201126-100144_newval.tif"
		, StorageType = "gdal.grid"
		, LazyCalculated = "TRUE"
		, Source = "Bron10, 20220216 SURFfilesender: basiskaarten NatuurVerkenning scenarios";
		///
		attribute<NVK_LHM_Tabel> Huidig_2_5m_NVK_LHM_Tabel       (rdc_2_5m) := invert(NVK_LHM_Tabel/HDB_NVKKlasse_rel)[Read_Huidig_2_5m];
		attribute<LHMType>       Huidig_2_5m_LHMType             (rdc_2_5m) := rjoin(Huidig_2_5m_NVK_LHM_Tabel, id(NVK_LHM_Tabel), NVK_LHM_Tabel/LHMType_rel);
		attribute<LU_ModelType>  Huidig_2_5m_LU_ModelType        (rdc_2_5m) := LHMType/LU_ModelType_rel[Huidig_2_5m_LHMType];
		///
		attribute<LU_ModelType>  Write_Huidig_25m_LU_ModelType    (rdc_25m) := Modus(Huidig_2_5m_LU_ModelType, rdc_2_5m/rdc_25m_rel), StorageName = "='%LocalDataProjDir%/BaseData/Grondgebruik/NVK/nvk_huidig_25m_LU_ModelType_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
		attribute<LU_ModelType>  Huidig_25m_LU_ModelType         (rdc_25m) : StorageName = "='%LocalDataProjDir%/BaseData/Grondgebruik/NVK/nvk_huidig_25m_LU_ModelType_'+/ModelParameters/StudyArea+'.tif'",	StorageType = "gdal.grid", 	StorageReadOnly = "TRUE";
		///
		attribute<LU_ModelType>  Huidig_100m_LU_ModelType        (rdc_100m) := Modus(Huidig_25m_LU_ModelType, rdc_25m/rdc_100m_rel);

		// #751: dezelfde kaart als natuurbeheertype, voor de stand-administratie in BaseData/StartState/Landgebruik.
		// De 171 NVK-klassen dragen de beheertypecode in hun naam; HDB_NVKKlasse/INL_Beheertype_rel koppelt de 75 die er
		// een hebben aan de Index Natuur en Landschap. Ontkoppeld met een fingerprint, want de modus over 14,56 miljard
		// cellen van 2,5 meter (112.000 bij 130.000) is een eenmalige klus; gemeten op 2026-09-04: 209 seconden.
		attribute<INL_Beheertype> INL_Beheertype_2_5m (rdc_2_5m) := HDB_NVKKlasse/INL_Beheertype_rel[Read_Huidig_2_5m];

		parameter<String> FileName_INL_Beheertype_25m    := '%LocalDataProjDir%/BaseData/Grondgebruik/NVK/nvk_huidig_25m_INL_Beheertype_'+/ModelParameters/StudyArea+'.tif';
		parameter<String> Fingerprint_INL_Beheertype_25m :=
			  'bron='          + PropValue(Read_Huidig_2_5m, 'StorageName')
			+ ';koppeling='    + asList(string(HDB_NVKKlasse/INL_Beheertype_rel), ',')
			+ ';beheertypen='  + asList(INL_Beheertype/code, ',')
			+ ';study_area='   + /ModelParameters/StudyArea
			+ ';grid_size='    + string(rdc_25m/gridsize)
		, Descr = "Wat de tif bepaalt: het bronbestand, de koppeling van NVK-klasse naar beheertype, de nummering van INL_Beheertype (de tif draagt rijnummers), het studiegebied en de celgrootte.";

		container Decoupling_INL_Beheertype_25m := /Templates/DecoupledFile_T(FileName_INL_Beheertype_25m, Fingerprint_INL_Beheertype_25m);

		attribute<INL_Beheertype> Make_INL_Beheertype_25m (rdc_25m) := modus(INL_Beheertype_2_5m, rdc_2_5m/rdc_25m_rel), StorageName = "=FileName_INL_Beheertype_25m", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_INL_Beheertype_25m/Write_Fingerprint"
		, Descr = "Modus van honderd subcellen per cel, net als Write_NL2120_MNP_BAU_INL_beheertypen_25m voor de MNP-kaart. Let op dat modus nulls overslaat: een cel met een enkele getypeerde subcel krijgt dat type, ook als de andere 99 leeg zijn. Of de cel natuur is beslist daarom niet deze kaart maar het LGN-masker in BaseData/StartState/Landgebruik/Beheertype; deze kaart zegt alleen welk type het dan is.";
		attribute<INL_Beheertype> Read_INL_Beheertype_25m (rdc_25m) : StorageName = "=FileName_INL_Beheertype_25m", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<INL_Beheertype> INL_Beheertype_25m      (rdc_25m) := = Decoupling_INL_Beheertype_25m/MayReuse ? 'Read_INL_Beheertype_25m' : 'Make_INL_Beheertype_25m'
		, Descr = "Het natuurbeheertype volgens de NVK-kaart huidig op 25 meter. Vraag Decoupling_INL_Beheertype_25m/Explanation op om te zien waarom de tif wel of niet opnieuw wordt gemaakt.";
	}

	container HDB
	{
		attribute<HDB_NVKKlasse> Read_HDB2050_2_5m               (rdc_2_5m) 
		: StorageName = "%RSo_DataDir%/Grondgebruik/NVK/hdb2050_run2021_t9xlsx_20220124-191401_newval.tif"
		, StorageType = "gdal.grid"
		, LazyCalculated = "TRUE"
		, Source = "Bron11, 20230704 SURFfilesender: NatuurVerkenning scenarios";
		///
		attribute<NVK_LHM_Tabel> HDB2050_2_5m_NVK_LHM_Tabel      (rdc_2_5m) := invert(NVK_LHM_Tabel/HDB_NVKKlasse_rel)[Read_HDB2050_2_5m];
		attribute<LHMType>       HDB2050_2_5m_LHMType            (rdc_2_5m) := rjoin(HDB2050_2_5m_NVK_LHM_Tabel, id(NVK_LHM_Tabel), NVK_LHM_Tabel/LHMType_rel);
		attribute<LU_ModelType>  HDB2050_2_5m_LU_ModelType       (rdc_2_5m) := LHMType/LU_ModelType_rel[HDB2050_2_5m_LHMType];
		///
		// StudyArea hoort in de naam, net als bij Huidig hierboven. Zonder die suffix schrijven runs met een ander
		// studiegebied over elkaars bestand heen, en dat merk je niet: de tif is dan gewoon leesbaar, alleen voor
		// het verkeerde gebied.
		attribute<LU_ModelType>  Write_HDB2050_25m_LU_ModelType   (rdc_25m) := Modus(HDB2050_2_5m_LU_ModelType, rdc_2_5m/rdc_25m_rel), StorageName = "='%LocalDataProjDir%/BaseData/Grondgebruik/NVK/nvk_hdb_25m_LU_ModelType_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
		attribute<LU_ModelType>  HDB2050_25m_LU_ModelType        (rdc_25m) : StorageName = "='%LocalDataProjDir%/BaseData/Grondgebruik/NVK/nvk_hdb_25m_LU_ModelType_'+/ModelParameters/StudyArea+'.tif'",	StorageType = "gdal.grid", 	StorageReadOnly = "TRUE";
		///
		attribute<LU_ModelType>  HDB2050_100m_LU_ModelType       (rdc_100m) := Modus(HDB2050_25m_LU_ModelType, rdc_25m/rdc_100m_rel);
		///
		attribute<LU_ModelType>  HDB2050_25m_diff                 (rdc_25m) := HDB2050_25m_LU_ModelType != Huidig/Huidig_25m_LU_ModelType ? HDB2050_25m_LU_ModelType : (0b/0b)[LU_ModelType];
		attribute<UInt8>         count_diff_25m_cellen           (rdc_100m) := sum_uint8(IsDefined(HDB2050_25m_diff), rdc_25m/rdc_100m_rel);
	}

	container BAU
	{
		attribute<UInt32> BaUdiff_BT (rdc_25m)
		:	StorageName     = "%RSo_DataDir%/Grondgebruik/NVK/BAU/20230901_Sandy_van_Tol/BaUdiff_BT.tif"
		,	Source          = "Bron12, 20220530 Y:\\Kennisbasis\\natuur\\Data_natuur\\LULUCF_KEV\\FGDB\\LULUCF_natuur.gdb BaUdiff_BT conversie naar tif lzw in ArcGIS 10.8.1"
		,	url             = "%RSo_DataDir%/Grondgebruik/LULUCF/220421_Nat25-KEV.pdf"
		, LazyCalculated = "TRUE"
		,	StorageType     = "gdal.grid"
		,	StorageReadOnly = "True"
		{
			attribute<UInt8>                 Data_org          (rdc_25m);
			attribute<String>                BT_naam           (rdc_25m) := rjoin(Data_org, uint8(BAU_Diff_K/GIS_BaUdiff_BT/VALUE), BAU_Diff_K/GIS_BaUdiff_BT/naam);
			attribute<NVK_LHM_Tabel>         NVK_LHM_Tabel_rel (rdc_25m) := rlookup(trim(LowerCase(BT_naam)), trim(LowerCase(NVK_LHM_Tabel/Uitleg_NVK))); 
		}
		
		attribute<LHMType>       LHMType_rel                      (rdc_25m) := NVK_LHM_Tabel/LHMType_rel[BaUdiff_BT/NVK_LHM_Tabel_rel]; 
		attribute<LU_ModelType>  LU_ModelType_rel                 (rdc_25m) := LHMType/LU_ModelType_rel[LHMType_rel];
		///
		attribute<LU_ModelType>  BAU2050_100m_LU_ModelType       (rdc_100m) := Modus(BAU2050_25m_diff, rdc_25m/rdc_100m_rel);
		///
		attribute<LU_ModelType>  BAU2050_25m_diff                 (rdc_25m) := LU_ModelType_rel;
		attribute<UInt8>         count_diff_25m_cellen           (rdc_100m) := sum_uint8(IsDefined(BAU2050_25m_diff), rdc_25m/rdc_100m_rel);
		
		container BAU_Diff_K 
		: StorageName = "%RSo_DataDir%/Grondgebruik/NVK/BAU/20230901_Sandy_van_Tol/RC_BT2LUCF_bewerk_20230920.xlsx"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "TRUE"
		, SyncMode = "AllTables";
	}
}