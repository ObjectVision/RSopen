////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het Natuurbeheerplan (NBP) van de twaalf provincies, subsidiejaar 2026, als beheertypenkaart van het basisjaar (#776).
// Hier wordt het plan ingelezen; de kaart op 25 meter staat in BaseData/Grondgebruik/NBP (#440).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container NBP
: Descr = "Het Natuurbeheerplan van de twaalf provincies voor subsidiejaar 2026, landelijk samengevoegd door RVO en gepubliceerd door BIJ12: per vlak het natuurbeheertype uit de Index Natuur en
			Landschap waarvoor de provincie beheersubsidie openstelt, en daarmee de kaart van de natuur zoals die er nu ligt (#776). De officiele bron waar de MNP-kaart (planpotentieel,
			Bron/Landelijk_BAU in Natuur.dms) en de NVK-kaart (een afgeleide op 2,5 meter die team effectbepaling niet geschikt vond) van afstammen; hij wordt elk jaar vastgesteld, dus een nieuwe
			jaargang is het nieuwe bestand ernaast zetten en Jaargang en Bronbestand aanpassen. Gelezen wordt de laag BeheerGebied; de rastering op 25 meter, als ontkoppelde tif, staat in
			BaseData/Grondgebruik/NBP (#440). De N-codes vertalen een op een naar INL_Beheertype, de L-codes (landschapselementen) kent die classificatie niet, zie BaseData/Grondgebruik/NBP/Controle. De ambitiekaart en de drie zoekgebiedlagen worden niet gelezen. Het studiegebied is
			land zonder Waddenzee, IJsselmeer en Noordzeekustzone, dus een groot deel van het NBP-areaal (zee en wad, afgesloten zeearm) valt erbuiten.", Source = "Natuurbeheerplan 2026, BIJ12 via RVO, ESRI-geodatabase"
{
	parameter<String> Jaargang    := '2026', Descr = "Het subsidiejaar van het plan; gaat in de naam van de tif.";
	parameter<String> Bronbestand := '20251119_NBP_RVO_subsidiejaar' + Jaargang + '.gdb', Descr = "De bestandsnaam zoals BIJ12 hem levert, met de datum van RVO ervoor. Volgend jaar: de nieuwe datum en Jaargang.";

	container Bron
	: StorageName     = "='%RSo_DataDir%/Beleid/Overigen/Natuur/' + Bronbestand"
	, StorageType     = "gdal.vect"
	, StorageReadOnly = "TRUE"
	, DialogData      = "rdc_meter"
	, Source          = "BIJ12, https://www.bij12.nl/onderwerp/natuursubsidies/snl/inhoud/natuurbeheerplan/, knop Vastgesteld NBP 2026 (ESRI gdb-formaat). Bestand van RVO gedateerd 19 november 2025, op 5 september 2026 op E:/SourceData gezet. Dezelfde pagina biedt de plannen van 2023, 2024 en 2025; volgend jaar staat daar 2027."
	, Descr = "De ESRI-geodatabase zoals BIJ12 hem levert: zes vlakkenlagen (BeheerGebied, BeheerGebiedAmbitie, ZoekGebiedKlimaat, ZoekGebiedAgrarisch, ZoekGebiedWater, Provinciegrenzen) en de tabel NatuurbeheerPlan met per provincie de vaststellingsdatum. GDAL leest hem met de OpenFileGDB-driver; alles in RD."
	{
		unit<uint32> BeheerGebied
		: SqlString = "select * from BeheerGebied order by Shape_Area desc"
		, Descr = "De beheertypenkaart: multipolygonen met per vlak een beheertype (N-codes en L-codes), de provincie, of het vlak subsidiabel is, en de geldigheidsperiode. Gesorteerd op oppervlak, groot
					eerst, zodat bij het rasteren een klein vlak binnen een groot vlak wint (#613). De velden beginTijd en eindTijd zijn de geldigheid van het plan en niet van het vlak, dus voor subsidiejaar
					2026 valt er niets te filteren. subsidiabel zegt of de provincie voor het vlak SNL-beheersubsidie openstelt, niet of de natuur er ligt (de Waddenzee is niet subsidiabel in Groningen en wel
					in Friesland); de kaart zegt daar evengoed welk beheertype er ligt, dus die vlakken tellen mee."
		{
			attribute<rdc_meter> geometry (poly);
			attribute<String>    beheerType;
			attribute<String>    provincie;
			attribute<Int32>     subsidiabel;
			attribute<Float64>   Shape_Area;

			attribute<Bool>           IsLandschapselement := substr(beheerType, 0, 1) == 'L', Descr = "L-codes: de landschapselementen van de Index Natuur en Landschap, L01 groene en blauwe elementen (houtwal, laan, bossingel, poel, hoogstamboomgaard, heggen, knotbomen), L02 historische
			elementen en L03.01 aardwerk en groeve, die naast de N-vlakken liggen en niet erin. Geen natuurbeheertype in INL_Beheertype: een houtwal is geen hakhout en een poel geen zoete plas, en de
			LGN-route van de stand-administratie geeft die cellen al bos, struweel, gras of water.";
			attribute<INL_Beheertype> INL_Beheertype_rel  := rlookup(beheerType, INL_Beheertype/code)
			, IntegrityCheck = "all(IsLandschapselement || IsDefined(INL_Beheertype_rel))"
			, Descr = "De vertaling naar de classificatie, op de code. De IntegrityCheck faalt zodra een nieuwe jaargang een N-code bevat die INL_Beheertype niet kent; dan hoort die rij in de classificatie erbij, en niet stil op null.";
			attribute<Ha>             Opp                 := Shape_Area[float32] / 10000f * 1[Ha], Descr = "Het polygoonoppervlak uit de bron, voor de controle op het rasteren.";

			attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
		}
	}
}
