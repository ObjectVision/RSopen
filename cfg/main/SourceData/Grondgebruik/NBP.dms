// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het Natuurbeheerplan (NBP) van de twaalf provincies, subsidiejaar 2026, als beheertypenkaart van het basisjaar (#776).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container NBP
: Descr = "Het Natuurbeheerplan van de twaalf provincies voor subsidiejaar 2026, landelijk samengevoegd door RVO en gepubliceerd door BIJ12. Dit is de officiele beheertypenkaart: per vlak het natuurbeheertype uit de Index Natuur en Landschap waarvoor de provincie beheersubsidie openstelt, en daarmee de kaart van de natuur zoals die er nu ligt. Zie #776.

			Waarom deze kaart en niet de twee die er al waren. De MNP-kaart van de WUR (Bron/Landelijk_BAU in Natuur.dms) is planpotentieel: huidige natuur plus de volledige realisatie van alle geplande maatregelen, en dat plandeel moet er met een masker weer uit. De NVK-kaart huidig van 2020 (NVK.dms) is een afgeleide op 2,5 meter met 171 klassen waarvan 75 een beheertype dragen, en team effectbepaling vond hem niet geschikt. Het NBP is de bron waar beide van afstammen, is van 2025 en wordt elk jaar opnieuw vastgesteld; volgend jaar is het een kwestie van het nieuwe bestand naast dit zetten en Jaargang en Bronbestand hieronder aanpassen.

			Wat het model ervan leest: de laag BeheerGebied, op 25 meter gerasterd en ontkoppeld als tif. De N-codes vertalen een op een naar INL_Beheertype; de L-codes (landschapselementen: houtwallen, poelen, bomenrijen, samen ongeveer 11.600 ha) kent die classificatie niet en die blijven zonder type, zie Controle. De laag BeheerGebiedAmbitie (de ambitiekaart: per provincie het beoogde type, met N00-typen voor nog om te vormen natuur en statusNNN; Overijssel ontbreekt erin) en de drie zoekgebiedlagen (klimaat, agrarisch en water, met per gebied de toegestane beheerfuncties; ZoekGebiedKlimaat hoort bij het agrarisch klimaatbeheer en raakt daarmee het veenwerk) worden niet gelezen.

			Het studiegebied van het model is de unie van de gegeneraliseerde CBS-provinciegrenzen, dus land zonder Waddenzee, IJsselmeer en Noordzeekustzone. Van het NBP-areaal ligt 42 procent daarbuiten, vrijwel geheel N01.01 zee en wad en N04.04 afgesloten zeearm; ook strand, schor en kwelder verliezen er een deel. Gemeten 5 september 2026: 710.513 ha met type binnen het studiegebied, waarvan 585.346 ha in de basiskaart de bron is (na de watertoets van BaseData/StartState/Landgebruik/Beheertype_Bron_Passend, die 28.571 ha terrestrisch type op LGN-water en 3.957 ha watertype op begroeiing afkeurt), met de MNP-kaart als aanvulling op 48.629 ha en de heuristiek op 146.768 ha."
{
	parameter<String> Jaargang    := '2026', Descr = "Het subsidiejaar van het plan; gaat in de naam van de tif.";
	parameter<String> Bronbestand := '20251119_NBP_RVO_subsidiejaar' + Jaargang + '.gdb', Descr = "De bestandsnaam zoals BIJ12 hem levert, met de datum van RVO ervoor. Volgend jaar: de nieuwe datum en Jaargang.";

	container Bron
	: StorageName     = "='%RSo_DataDir%/Beleid/Overigen/Natuur/' + Bronbestand"
	, StorageType     = "gdal.vect"
	, StorageReadOnly = "TRUE"
	, DialogData      = "rdc_meter"
	, Source          = "BIJ12, https://www.bij12.nl/onderwerp/natuursubsidies/snl/inhoud/natuurbeheerplan/, knop Vastgesteld NBP 2026 (ESRI gdb-formaat). Bestand van RVO gedateerd 19 november 2025, op 5 september 2026 op E:/SourceData gezet. Dezelfde pagina biedt de plannen van 2023, 2024 en 2025; volgend jaar staat daar 2027."
	, Descr           = "De ESRI-geodatabase zoals BIJ12 hem levert: zes vlakkenlagen (BeheerGebied, BeheerGebiedAmbitie, ZoekGebiedKlimaat, ZoekGebiedAgrarisch, ZoekGebiedWater, Provinciegrenzen) en de tabel NatuurbeheerPlan met per provincie de vaststellingsdatum (juni tot september 2025; Drenthe draagt daar 2026-09-16, een fout in de bron). GDAL leest hem met de OpenFileGDB-driver; alles in RD."
	{
		unit<uint32> BeheerGebied
		: SqlString = "select * from BeheerGebied order by Shape_Area desc"
		, Descr = "De beheertypenkaart: 273.584 multipolygonen met per vlak een beheertype (49 N-codes en 13 L-codes), de provincie, of het vlak subsidiabel is, en de geldigheidsperiode. Gesorteerd op oppervlak, groot eerst, zodat bij het rasteren een klein vlak dat binnen een groot vlak ligt wint; poly2grid laat de laatste polygoon winnen, zie #613.

					De velden beginTijd en eindTijd zijn de geldigheid van het plan en niet van het vlak: alleen provincie 20 en 22 vullen eindTijd, op 1 januari 2027 en 31 december 2026, dus voor subsidiejaar 2026 valt er niets te filteren. subsidiabel zegt of de provincie voor het vlak SNL-beheersubsidie openstelt, niet of de natuur er ligt: de Waddenzee is niet subsidiabel in Groningen en wel in Friesland. Het staat op nul voor 203.149 ha N-typen, vooral rijkswateren (afgesloten zeearm, zee en wad, rivier) en daarnaast zo een 30.000 ha bos, heide en grasland buiten het NNN op de Veluwe en in Brabant; binnen het studiegebied 44.365 ha. De kaart zegt daar evengoed welk beheertype er ligt, dus die vlakken tellen mee."
		{
			attribute<rdc_meter> geometry (poly);
			attribute<String>    beheerType;
			attribute<String>    provincie;
			attribute<Int32>     subsidiabel;
			attribute<Float64>   Shape_Area;

			attribute<Bool>           IsLandschapselement := substr(beheerType, 0, 1) == 'L', Descr = "L-codes: de landschapselementen van de Index Natuur en Landschap. L01 groene en blauwe elementen (houtwal, laan, bossingel, poel, hoogstamboomgaard, heggen, knotbomen), L02 historische elementen (fortterrein, historisch bouwwerk en erf, historische tuin) en L03.01 aardwerk en groeve; 55.781 vlakken, 11.647 ha, die naast de N-vlakken liggen en niet erin. Geen natuurbeheertype in INL_Beheertype: een houtwal is geen hakhout en een poel geen zoete plas, en de LGN-route van de stand-administratie geeft die cellen al bos, struweel, gras of water.";
			attribute<INL_Beheertype> INL_Beheertype_rel  := rlookup(beheerType, INL_Beheertype/code)
			, IntegrityCheck = "all(IsLandschapselement || IsDefined(INL_Beheertype_rel))"
			, Descr = "De vertaling naar de classificatie, op de code. De IntegrityCheck faalt zodra een nieuwe jaargang een N-code bevat die INL_Beheertype niet kent; dan hoort die rij in de classificatie erbij, en niet stil op null.";
			attribute<Ha>             Opp                 := Shape_Area[float32] / 10000f * 1[Ha], Descr = "Het polygoonoppervlak uit de bron, voor de controle op het rasteren.";

			attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
		}
	}

	attribute<INL_Beheertype> Calc_INL_Beheertype_AD (AdminDomain) := Bron/BeheerGebied/INL_Beheertype_rel[Bron/BeheerGebied/Per_AdminDomain]
	, Descr = "Het beheertype per cel, rechtstreeks uit de vlakken. Null buiten de kaart en op de landschapselementen. Dit is het rekenwerk dat de ontkoppelde tif hieronder eenmalig vastlegt.";

	parameter<String> FileName_INL_Beheertype_AD    := '%LocalDataProjDir%/BaseData/Grondgebruik/NBP/nbp' + Jaargang + '_INL_Beheertype_' + /ModelParameters/StudyArea + '_' + /ModelParameters/Advanced/AdminDomain_ref + '.tif'
	, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft.";
	parameter<String> Fingerprint_INL_Beheertype_AD :=
		  'bron='               + PropValue(Bron, 'StorageName')
		+ ';laag=BeheerGebied;sql=' + PropValue(Bron/BeheerGebied, 'SqlString') + ';landschapselementen=null'
		+ ';beheertypen='       + asList(INL_Beheertype/code, ',')
		+ ';study_area='        + /ModelParameters/StudyArea
		+ ';admin_domain='      + /ModelParameters/Advanced/AdminDomain_ref
	, Descr = "Wat de tif bepaalt: het bronbestand (met de jaargang in de naam), de laag en de SqlString (dus ook de rastervolgorde en een eventueel filter), de nummering van INL_Beheertype (de tif draagt rijnummers), het studiegebied en de resolutie. Een nieuwe jaargang of een extra rij in de classificatie maakt de tif ongeldig en laat hem opnieuw schrijven.";

	container Decoupling_INL_Beheertype_AD := /Templates/DecoupledFile_T(FileName_INL_Beheertype_AD, Fingerprint_INL_Beheertype_AD);

	attribute<INL_Beheertype> Make_INL_Beheertype_AD (AdminDomain) := Calc_INL_Beheertype_AD, StorageName = "=FileName_INL_Beheertype_AD", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_INL_Beheertype_AD/Write_Fingerprint"
	, Descr = "Schrijft de kaart eenmalig weg. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
	attribute<INL_Beheertype> Read_INL_Beheertype_AD (AdminDomain) : StorageName = "=FileName_INL_Beheertype_AD", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
	attribute<INL_Beheertype> INL_Beheertype_AD      (AdminDomain) := = Decoupling_INL_Beheertype_AD/MayReuse ? 'Read_INL_Beheertype_AD' : 'Make_INL_Beheertype_AD'
	, Descr = "Het natuurbeheertype volgens het Natuurbeheerplan 2026 op 25 meter, ontkoppeld. De bron van BaseData/StartState/Landgebruik/Beheertype zolang ModelParameters/Beheertype_Basisjaar_Bron op NBP staat. Vraag Decoupling_INL_Beheertype_AD/Explanation op om te zien waarom de tif wel of niet opnieuw wordt gemaakt.";

	container Controle
	: Descr = "Vergelijkt het gerasterde areaal per beheertype met het polygoonareaal uit de bron, en telt wat er buiten de classificatie valt. Twee rasterkolommen: over de hele kaart (dat meet het rasteren) en binnen het studiegebied (dat meet het masker). Vraag Tabel op; die schrijft naar LocalData/Diagnose. Let op dat dit de levende poly2grid opnieuw rekent, ook als de tif wordt hergebruikt; ongeveer een minuut."
	{
		attribute<Bool> SA (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain;

		unit<UInt8> PerType := INL_Beheertype
		{
			attribute<String> code   := INL_Beheertype/code;
			attribute<Ha>     Vector := sum(Bron/BeheerGebied/Opp, Bron/BeheerGebied/INL_Beheertype_rel), Descr = "Polygoonareaal per beheertype uit de bron, alle provincies samen.";
			attribute<Ha>     Raster_HeleKaart := sum(IsDefined(INL_Beheertype_AD) ? AdminDomain/NrHaPerCell : 0[Ha], INL_Beheertype_AD), Descr = "Hetzelfde areaal zoals het model het op 25 meter rastert, over de hele kaart.";
			attribute<Ha>     Raster := sum(SA ? AdminDomain/NrHaPerCell : 0[Ha], INL_Beheertype_AD), Descr = "Daarvan binnen het studiegebied: de unie van de gegeneraliseerde CBS-provinciegrenzen plus IJburg, dus land zonder Waddenzee, IJsselmeer en Noordzeekustzone. Dit is wat het model gebruikt.";
			attribute<Float32> Ratio := Vector > 0[Ha] ? Raster_HeleKaart / Vector : 1f, Descr = "Raster over de hele kaart gedeeld door het polygoonareaal: meet alleen het rasteren en hoort per type op een procent na 1 te zijn. Een kwart van de vlakken is kleiner dan een cel, maar de totalen overleven dat; gemeten 5 september 2026 tussen 0,98 en 1,005. Het verschil tussen Raster en Raster_HeleKaart is het studiegebied, niet het rasteren: N01.01 zee en wad houdt daarbinnen 1 procent over, N04.04 afgesloten zeearm 1 procent, N04.01 kranswierwater 18 procent, N08.01 strand 72 procent, N09.01 schor of kwelder 77 procent, N01.02 duin- en kwelderlandschap 89 procent.";
		}

		parameter<Ha> Areaal_Vector_N := sum(!Bron/BeheerGebied/IsLandschapselement ? Bron/BeheerGebied/Opp : 0[Ha]), Descr = "Polygoonareaal van alle N-typen.";
		parameter<Ha> Areaal_Vector_L := sum( Bron/BeheerGebied/IsLandschapselement ? Bron/BeheerGebied/Opp : 0[Ha]), Descr = "Polygoonareaal van de landschapselementen, dat zonder type blijft.";
		parameter<Ha> Areaal_Raster_HeleKaart := sum(IsDefined(INL_Beheertype_AD) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen met een beheertype over de hele kaart; hoort gelijk te zijn aan Areaal_Vector_N.";
		parameter<Ha> Areaal_Raster   := sum(SA && IsDefined(INL_Beheertype_AD) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen met een beheertype binnen het studiegebied.";
		parameter<Ha> Areaal_Raster_NietSubsidiabel := sum(SA && IsDefined(INL_Beheertype_AD) && Bron/BeheerGebied/subsidiabel[Bron/BeheerGebied/Per_AdminDomain] == 0i ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waarvan op vlakken die niet subsidiabel zijn.";

		parameter<String> Tabel :=
			  'post;ha'
			+ '|vector_n;'                + string(Areaal_Vector_N)
			+ '|vector_l;'                + string(Areaal_Vector_L)
			+ '|raster_hele_kaart;'       + string(Areaal_Raster_HeleKaart)
			+ '|raster_studiegebied;'     + string(Areaal_Raster)
			+ '|raster_niet_subsidiabel;' + string(Areaal_Raster_NietSubsidiabel)
			+ '||code;vector_ha;raster_hele_kaart_ha;raster_studiegebied_ha;ratio|'
			+ AsList(PerType/code + ';' + string(PerType/Vector) + ';' + string(PerType/Raster_HeleKaart) + ';' + string(PerType/Raster) + ';' + string(PerType/Ratio), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/776_nbp_controle.txt'", StorageType = "str";
	}
}
