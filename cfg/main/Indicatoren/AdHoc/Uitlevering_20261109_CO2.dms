container Uitlevering_20261109_CO2
: Descr = "Uitlevering van 9 november 2026 over de broeikasgasuitstoot uit het veen tussen het basisjaar en 2120, voor Nederland en Fryslân, in BaU (casus BAU, map BAU1), WBS (casus BAU2) en NbS (casus NbSGenuanceerder).
			Rekent geen model opnieuw door: leest de kaarten van de productierun van 10 en 11 september 2026 uit de opleveringsmap, en de cumulatieve vastlegging en afboeking uit de uitlevering van 30 september 2026,
			die op dezelfde allocatiestand zijn gerekend.

			Twee maten voor de CO2 uit veenoxidatie staan naast elkaar. Oxidatie_SOMERS is de cumulatieve SOMERS-uitstoot zoals SOMERS_CO2_laagveen hem rapporteert: een vaste jaarlijkse uitstoot per veenweideperceel,
			zonder rekening te houden met de dikte van het veenpakket of de koolstof die in de bodem zit. Oxidatie_Balans is de oxidatie die de koolstofboekhouding van CarbonStorageSequestration_T werkelijk van de voorraad
			afschrijft: alleen waar de veendiktekaart een veenpakket geeft, nooit meer dan de veenreserve plus de bovenlaag tot de minerale ondergrens, en in NbS met de kentallen van team Veen in plaats van SOMERS.
			Hij is afgeleid als vastlegging plus afboeking min de voorraadverandering, want die drie sluiten per cel. Methaan staat er los naast, en de twee totalen tellen elk een oxidatiemaat op bij het methaan.

			Alle kaarten in ton CO2 of ton CO2-equivalent per cel van 25 m, cumulatief van 2023 tot 2120, uitstoot positief; nul binnen Nederland waar niets wordt uitgestoten, leeg erbuiten."
{
	parameter<String> Bronmap    := 'D:/RSOpen_NL2120_Productierun_20260910', Descr = "De map van de productierun op deze machine, met de submappen Oplevering en Uitlevering_20260930.";
	parameter<String> Uitvoermap := '%LocalDataProjDir%/Uitlevering_20261109_CO2';
	parameter<String> ProvincieNaam := 'Friesland', Descr = "De provincie naast Nederland, met de naam zoals Provincie/name hem schrijft.";

	unit<uint32> Prov := /SourceData/RegioIndelingen/Provincie/StudyArea;
	parameter<Prov> Prov_rel := rlookup(ProvincieNaam, Prov/name), IntegrityCheck = "IsDefined(this)";

	attribute<Bool> IsNL            (/Geography/AdminDomain) := /Geography/rdc_meter/IsStudyArea_AdminDomain, Descr = "Het studiegebied, waarop ook de weggeschreven kaarten van de productierun zijn gemaskeerd.";
	attribute<Bool> IsProvincie     (/Geography/AdminDomain) := IsNL && Prov/Per_AdminDomain_Fijn == Prov_rel, Descr = "De provincie op 25 m, met de indeling die ook de indicatorentabellen lezen (#748).";
	attribute<Bool> OpPerceel       (/Geography/AdminDomain) := IsDefined(/SourceData/Landbouw/SOMERS/Veenweide_percelen/AdminDomain_rel), Descr = "Een veenweideperceel waarvoor SOMERS een uitstoot geeft; dezelfde afbakening als OpSOMERSPerceel in CarbonStorageSequestration_T.";
	attribute<Bool> HeeftVeenpakket (/Geography/AdminDomain) := MakeDefined(/SourceData/Landbouw/Peat_thickness[/Geography/AdminDomain/rdc_25m_rel][float32], 0f) > 0f, Descr = "Geeft de veendiktekaart hier een veenpakket; dezelfde toets als Oxidatie/HeeftVeenpakket in CarbonStorageSequestration_T, waar de boekhouding zonder veenpakket geen SOMERS-uitstoot afschrijft.";

	unit<uint8> Klasse : nrofrows = 8
	, Descr = "De cellen van Nederland in acht klassen: buiten of binnen de provincie, op een SOMERS-perceel of niet, met of zonder veenpakket op de veendiktekaart. Elke som hieronder is een som per klasse; Nederland is de som over alle acht."
	{
		attribute<Bool>   InProvincie     : [FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE], IntegrityCheck = "all(IsDefined(this))";
		attribute<Bool>   OpPerceel       : [FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE], IntegrityCheck = "all(IsDefined(this))";
		attribute<Bool>   HeeftVeenpakket : [FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE], IntegrityCheck = "all(IsDefined(this))";
	}
	attribute<Klasse> Klasse_rel (/Geography/AdminDomain) := IsNL ? value(uint8(IsProvincie) * 4b + uint8(OpPerceel) * 2b + uint8(HeeftVeenpakket), Klasse) : null_b;

	Template Variant_T
	: Descr = "De kaarten van een variant uit de opleveringsmap, en de maten die de notitie gebruikt."
	{
		parameter<String> Map;
		///
		parameter<String> Kaarten := /Indicatoren/AdHoc/Uitlevering_20261109_CO2/Bronmap + '/Oplevering/' + Map + '/kaarten_Y2120/';
		parameter<String> Ketens  := /Indicatoren/AdHoc/Uitlevering_20261109_CO2/Bronmap + '/Uitlevering_20260930/data/' + Map + '/kaarten_Y2120/';

		attribute<Float32> SOMERS_Mediaan_kg (/Geography/AdminDomain) : StorageName = "=Kaarten + 'SOMERS_CO2_Emissies_kg_Mediaan_Cumulatief_sindsStartyear_Y2120.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> SOMERS_Minimum_kg (/Geography/AdminDomain) : StorageName = "=Kaarten + 'SOMERS_CO2_Emissies_kg_Minimum_Cumulatief_sindsStartyear_Y2120.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> SOMERS_Maximum_kg (/Geography/AdminDomain) : StorageName = "=Kaarten + 'SOMERS_CO2_Emissies_kg_Maximum_Cumulatief_sindsStartyear_Y2120.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> Verandering_t     (/Geography/AdminDomain) : StorageName = "=Kaarten + 'CarbonStorageSequestration_stock_FromBaseYear_Y2120_tonCO2.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> Ongedekt_Bron_t   (/Geography/AdminDomain) : StorageName = "=Kaarten + 'CarbonStorageSequestration_ongedekt_Cumulatief_Y2120_tonCO2.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> Methaan_Bron_t    (/Geography/AdminDomain) : StorageName = "=Kaarten + 'Methaan_tonCO2eq_Cumulatief_sindsStartyear_Y2120.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> Vastlegging_t     (/Geography/AdminDomain) : StorageName = "=Ketens + 'CarbonStorageSequestration_Cumulatief_Vastlegging_Y2120_tonCO2.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";
		attribute<Float32> Afboeking_t       (/Geography/AdminDomain) : StorageName = "=Ketens + 'CarbonStorageSequestration_Cumulatief_Afboeking_Y2120_tonCO2.tif'", StorageType = "gdal.grid", StorageReadOnly = "True";

		attribute<Bool>    IsNL              (/Geography/AdminDomain) := /Indicatoren/AdHoc/Uitlevering_20261109_CO2/IsNL;

		attribute<Float32> Oxidatie_SOMERS     (/Geography/AdminDomain) := IsNL ? MakeDefined(SOMERS_Mediaan_kg, 0f) / 1000f : null_f, Descr = "SOMERS-mediaan in ton CO2; houdt geen rekening met de veendikte of de bodemkoolstof.";
		attribute<Float32> Oxidatie_SOMERS_Min (/Geography/AdminDomain) := IsNL ? MakeDefined(SOMERS_Minimum_kg, 0f) / 1000f : null_f;
		attribute<Float32> Oxidatie_SOMERS_Max (/Geography/AdminDomain) := IsNL ? MakeDefined(SOMERS_Maximum_kg, 0f) / 1000f : null_f;
		attribute<Float32> Oxidatie_Balans     (/Geography/AdminDomain) := IsNL ? MakeDefined(Vastlegging_t, 0f) + MakeDefined(Afboeking_t, 0f) - MakeDefined(Verandering_t, 0f) : null_f
		, Descr = "De oxidatie die de koolstofboekhouding van de voorraad afschrijft, in ton CO2: rekent met de veendikte en de bodemkoolstof. Vastlegging is positief en afboeking negatief, dus dit is vastlegging plus afboeking min de verandering.";
		attribute<Float32> Ongedekt            (/Geography/AdminDomain) := IsNL ? MakeDefined(Ongedekt_Bron_t, 0f) : null_f, Descr = "Oxidatie die de boekhouding vraagt maar die de voorraad niet meer kan leveren; niet in Oxidatie_Balans.";
		attribute<Float32> Methaan             (/Geography/AdminDomain) := IsNL ? MakeDefined(Methaan_Bron_t, 0f) : null_f, Descr = "Methaan uit het veen in ton CO2-equivalent.";
		attribute<Float32> Totaal_SOMERS       (/Geography/AdminDomain) := Oxidatie_SOMERS + Methaan, Descr = "CO2 uit oxidatie volgens SOMERS plus methaan, in ton CO2-equivalent.";
		attribute<Float32> Totaal_Balans       (/Geography/AdminDomain) := Oxidatie_Balans + Methaan, Descr = "CO2 uit oxidatie volgens de koolstofboekhouding plus methaan, in ton CO2-equivalent.";

		attribute<Float32> Oxidatie_Balans_Negatief (/Geography/AdminDomain) := Oxidatie_Balans < -0.001f ? Oxidatie_Balans : 0f
		, IntegrityCheck = "sum(float64(this)) > -1d"
		, Descr = "Toets dat de afgeleide oxidatie nergens noemenswaard negatief is; dan sluiten vastlegging, afboeking en verandering niet.";
	}

	container BaU := Variant_T('BAU1'),             Descr = "Casus BAU in de configuratie, map BAU1 in de oplevering.";
	container WBS := Variant_T('BAU2'),             Descr = "Casus BAU2 in de configuratie: hetzelfde landgebruik als BAU met een hogere waterstand in het veen.";
	container NbS := Variant_T('NbSGenuanceerder'), Descr = "Casus NbSGenuanceerder in de configuratie.";

	container Kaarten
	: Descr = "De kaarten die de notitie toont en levert: per variant de vier maten en het verschil met BaU, in ton per cel van 25 m. Een verschil is negatief waar de variant minder uitstoot dan BaU."
	{
		attribute<Float32> BaU_Oxidatie_SOMERS     (/Geography/AdminDomain) := BaU/Oxidatie_SOMERS,                       StorageName = "=Uitvoermap + '/BaU/CO2_PeatOxidation_SOMERS_2023_2120_tCO2.tif'",           StorageType = "gdalwrite.grid";
		attribute<Float32> BaU_Oxidatie_Balans     (/Geography/AdminDomain) := BaU/Oxidatie_Balans,                       StorageName = "=Uitvoermap + '/BaU/CO2_PeatOxidation_CarbonBalance_2023_2120_tCO2.tif'",    StorageType = "gdalwrite.grid";
		attribute<Float32> BaU_Methaan             (/Geography/AdminDomain) := BaU/Methaan,                               StorageName = "=Uitvoermap + '/BaU/CH4_Peat_2023_2120_tCO2eq.tif'",                        StorageType = "gdalwrite.grid";
		attribute<Float32> BaU_Totaal_SOMERS       (/Geography/AdminDomain) := BaU/Totaal_SOMERS,                         StorageName = "=Uitvoermap + '/BaU/Total_SOMERS_plus_CH4_2023_2120_tCO2eq.tif'",           StorageType = "gdalwrite.grid";
		attribute<Float32> BaU_Totaal_Balans       (/Geography/AdminDomain) := BaU/Totaal_Balans,                         StorageName = "=Uitvoermap + '/BaU/Total_CarbonBalance_plus_CH4_2023_2120_tCO2eq.tif'",    StorageType = "gdalwrite.grid";

		attribute<Float32> WBS_Oxidatie_SOMERS     (/Geography/AdminDomain) := WBS/Oxidatie_SOMERS,                       StorageName = "=Uitvoermap + '/WBS/CO2_PeatOxidation_SOMERS_2023_2120_tCO2.tif'",           StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_Oxidatie_Balans     (/Geography/AdminDomain) := WBS/Oxidatie_Balans,                       StorageName = "=Uitvoermap + '/WBS/CO2_PeatOxidation_CarbonBalance_2023_2120_tCO2.tif'",    StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_Methaan             (/Geography/AdminDomain) := WBS/Methaan,                               StorageName = "=Uitvoermap + '/WBS/CH4_Peat_2023_2120_tCO2eq.tif'",                        StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_Totaal_SOMERS       (/Geography/AdminDomain) := WBS/Totaal_SOMERS,                         StorageName = "=Uitvoermap + '/WBS/Total_SOMERS_plus_CH4_2023_2120_tCO2eq.tif'",           StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_Totaal_Balans       (/Geography/AdminDomain) := WBS/Totaal_Balans,                         StorageName = "=Uitvoermap + '/WBS/Total_CarbonBalance_plus_CH4_2023_2120_tCO2eq.tif'",    StorageType = "gdalwrite.grid";

		attribute<Float32> NbS_Oxidatie_SOMERS     (/Geography/AdminDomain) := NbS/Oxidatie_SOMERS,                       StorageName = "=Uitvoermap + '/NbS/CO2_PeatOxidation_SOMERS_2023_2120_tCO2.tif'",           StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_Oxidatie_Balans     (/Geography/AdminDomain) := NbS/Oxidatie_Balans,                       StorageName = "=Uitvoermap + '/NbS/CO2_PeatOxidation_CarbonBalance_2023_2120_tCO2.tif'",    StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_Methaan             (/Geography/AdminDomain) := NbS/Methaan,                               StorageName = "=Uitvoermap + '/NbS/CH4_Peat_2023_2120_tCO2eq.tif'",                        StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_Totaal_SOMERS       (/Geography/AdminDomain) := NbS/Totaal_SOMERS,                         StorageName = "=Uitvoermap + '/NbS/Total_SOMERS_plus_CH4_2023_2120_tCO2eq.tif'",           StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_Totaal_Balans       (/Geography/AdminDomain) := NbS/Totaal_Balans,                         StorageName = "=Uitvoermap + '/NbS/Total_CarbonBalance_plus_CH4_2023_2120_tCO2eq.tif'",    StorageType = "gdalwrite.grid";

		attribute<Float32> WBS_min_BaU_Oxidatie_SOMERS (/Geography/AdminDomain) := WBS/Oxidatie_SOMERS - BaU/Oxidatie_SOMERS, StorageName = "=Uitvoermap + '/Difference_WBS_minus_BaU/CO2_PeatOxidation_SOMERS_2023_2120_tCO2.tif'",        StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_min_BaU_Oxidatie_Balans (/Geography/AdminDomain) := WBS/Oxidatie_Balans - BaU/Oxidatie_Balans, StorageName = "=Uitvoermap + '/Difference_WBS_minus_BaU/CO2_PeatOxidation_CarbonBalance_2023_2120_tCO2.tif'", StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_min_BaU_Methaan         (/Geography/AdminDomain) := WBS/Methaan - BaU/Methaan,                 StorageName = "=Uitvoermap + '/Difference_WBS_minus_BaU/CH4_Peat_2023_2120_tCO2eq.tif'",                     StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_min_BaU_Totaal_SOMERS   (/Geography/AdminDomain) := WBS/Totaal_SOMERS - BaU/Totaal_SOMERS,     StorageName = "=Uitvoermap + '/Difference_WBS_minus_BaU/Total_SOMERS_plus_CH4_2023_2120_tCO2eq.tif'",        StorageType = "gdalwrite.grid";
		attribute<Float32> WBS_min_BaU_Totaal_Balans   (/Geography/AdminDomain) := WBS/Totaal_Balans - BaU/Totaal_Balans,     StorageName = "=Uitvoermap + '/Difference_WBS_minus_BaU/Total_CarbonBalance_plus_CH4_2023_2120_tCO2eq.tif'", StorageType = "gdalwrite.grid";

		attribute<Float32> NbS_min_BaU_Oxidatie_SOMERS (/Geography/AdminDomain) := NbS/Oxidatie_SOMERS - BaU/Oxidatie_SOMERS, StorageName = "=Uitvoermap + '/Difference_NbS_minus_BaU/CO2_PeatOxidation_SOMERS_2023_2120_tCO2.tif'",        StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_min_BaU_Oxidatie_Balans (/Geography/AdminDomain) := NbS/Oxidatie_Balans - BaU/Oxidatie_Balans, StorageName = "=Uitvoermap + '/Difference_NbS_minus_BaU/CO2_PeatOxidation_CarbonBalance_2023_2120_tCO2.tif'", StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_min_BaU_Methaan         (/Geography/AdminDomain) := NbS/Methaan - BaU/Methaan,                 StorageName = "=Uitvoermap + '/Difference_NbS_minus_BaU/CH4_Peat_2023_2120_tCO2eq.tif'",                     StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_min_BaU_Totaal_SOMERS   (/Geography/AdminDomain) := NbS/Totaal_SOMERS - BaU/Totaal_SOMERS,     StorageName = "=Uitvoermap + '/Difference_NbS_minus_BaU/Total_SOMERS_plus_CH4_2023_2120_tCO2eq.tif'",        StorageType = "gdalwrite.grid";
		attribute<Float32> NbS_min_BaU_Totaal_Balans   (/Geography/AdminDomain) := NbS/Totaal_Balans - BaU/Totaal_Balans,     StorageName = "=Uitvoermap + '/Difference_NbS_minus_BaU/Total_CarbonBalance_plus_CH4_2023_2120_tCO2eq.tif'", StorageType = "gdalwrite.grid";
	}

	unit<uint8> Tabel := Klasse
	, StorageName = "=Uitvoermap + '/Sommen_perKlasse.csv'"
	, StorageType = "gdalwrite.vect"
	, Descr       = "Per klasse van cellen het areaal in hectare en per variant de som van elke maat in ton CO2 of ton CO2-equivalent. Nederland is de som over de acht regels, de provincie de som over de laatste vier."
	{
		attribute<Bool>    InProvincie         := /Indicatoren/AdHoc/Uitlevering_20261109_CO2/Klasse/InProvincie;
		attribute<Bool>    OpPerceel           := /Indicatoren/AdHoc/Uitlevering_20261109_CO2/Klasse/OpPerceel;
		attribute<Bool>    HeeftVeenpakket     := /Indicatoren/AdHoc/Uitlevering_20261109_CO2/Klasse/HeeftVeenpakket;
		attribute<Float64> Areaal_ha           := float64(pcount(Klasse_rel)) * float64(/Geography/rdc_25m/NrHaPerCell[float32]);

		attribute<Float64> BaU_Oxidatie_SOMERS     := sum(float64(BaU/Oxidatie_SOMERS),     Klasse_rel);
		attribute<Float64> BaU_Oxidatie_SOMERS_Min := sum(float64(BaU/Oxidatie_SOMERS_Min), Klasse_rel);
		attribute<Float64> BaU_Oxidatie_SOMERS_Max := sum(float64(BaU/Oxidatie_SOMERS_Max), Klasse_rel);
		attribute<Float64> BaU_Oxidatie_Balans     := sum(float64(BaU/Oxidatie_Balans),     Klasse_rel);
		attribute<Float64> BaU_Ongedekt            := sum(float64(BaU/Ongedekt),            Klasse_rel);
		attribute<Float64> BaU_Methaan             := sum(float64(BaU/Methaan),             Klasse_rel);
		attribute<Float64> BaU_Totaal_SOMERS       := sum(float64(BaU/Totaal_SOMERS),       Klasse_rel);
		attribute<Float64> BaU_Totaal_Balans       := sum(float64(BaU/Totaal_Balans),       Klasse_rel);
		attribute<Float64> BaU_Uitstotend_ha       := sum(BaU/Oxidatie_SOMERS > 0f ? 1d : 0d, Klasse_rel) * float64(/Geography/rdc_25m/NrHaPerCell[float32]);

		attribute<Float64> WBS_Oxidatie_SOMERS     := sum(float64(WBS/Oxidatie_SOMERS),     Klasse_rel);
		attribute<Float64> WBS_Oxidatie_SOMERS_Min := sum(float64(WBS/Oxidatie_SOMERS_Min), Klasse_rel);
		attribute<Float64> WBS_Oxidatie_SOMERS_Max := sum(float64(WBS/Oxidatie_SOMERS_Max), Klasse_rel);
		attribute<Float64> WBS_Oxidatie_Balans     := sum(float64(WBS/Oxidatie_Balans),     Klasse_rel);
		attribute<Float64> WBS_Ongedekt            := sum(float64(WBS/Ongedekt),            Klasse_rel);
		attribute<Float64> WBS_Methaan             := sum(float64(WBS/Methaan),             Klasse_rel);
		attribute<Float64> WBS_Totaal_SOMERS       := sum(float64(WBS/Totaal_SOMERS),       Klasse_rel);
		attribute<Float64> WBS_Totaal_Balans       := sum(float64(WBS/Totaal_Balans),       Klasse_rel);
		attribute<Float64> WBS_Uitstotend_ha       := sum(WBS/Oxidatie_SOMERS > 0f ? 1d : 0d, Klasse_rel) * float64(/Geography/rdc_25m/NrHaPerCell[float32]);

		attribute<Float64> NbS_Oxidatie_SOMERS     := sum(float64(NbS/Oxidatie_SOMERS),     Klasse_rel);
		attribute<Float64> NbS_Oxidatie_SOMERS_Min := sum(float64(NbS/Oxidatie_SOMERS_Min), Klasse_rel);
		attribute<Float64> NbS_Oxidatie_SOMERS_Max := sum(float64(NbS/Oxidatie_SOMERS_Max), Klasse_rel);
		attribute<Float64> NbS_Oxidatie_Balans     := sum(float64(NbS/Oxidatie_Balans),     Klasse_rel);
		attribute<Float64> NbS_Ongedekt            := sum(float64(NbS/Ongedekt),            Klasse_rel);
		attribute<Float64> NbS_Methaan             := sum(float64(NbS/Methaan),             Klasse_rel);
		attribute<Float64> NbS_Totaal_SOMERS       := sum(float64(NbS/Totaal_SOMERS),       Klasse_rel);
		attribute<Float64> NbS_Totaal_Balans       := sum(float64(NbS/Totaal_Balans),       Klasse_rel);
		attribute<Float64> NbS_Uitstotend_ha       := sum(NbS/Oxidatie_SOMERS > 0f ? 1d : 0d, Klasse_rel) * float64(/Geography/rdc_25m/NrHaPerCell[float32]);
	}

	container Generate
	: Descr = "Vraag dit item op om de tabel en alle kaarten te schrijven. De toets op de afgeleide oxidatie hangt via de kolommen van de tabel mee."
	{
		parameter<Bool> Klaar := TRUE
		, ExplicitSuppliers = "Tabel;BaU/Oxidatie_Balans_Negatief;WBS/Oxidatie_Balans_Negatief;NbS/Oxidatie_Balans_Negatief;Kaarten/BaU_Oxidatie_SOMERS;Kaarten/BaU_Oxidatie_Balans;Kaarten/BaU_Methaan;Kaarten/BaU_Totaal_SOMERS;Kaarten/BaU_Totaal_Balans;Kaarten/WBS_Oxidatie_SOMERS;Kaarten/WBS_Oxidatie_Balans;Kaarten/WBS_Methaan;Kaarten/WBS_Totaal_SOMERS;Kaarten/WBS_Totaal_Balans;Kaarten/NbS_Oxidatie_SOMERS;Kaarten/NbS_Oxidatie_Balans;Kaarten/NbS_Methaan;Kaarten/NbS_Totaal_SOMERS;Kaarten/NbS_Totaal_Balans;Kaarten/WBS_min_BaU_Oxidatie_SOMERS;Kaarten/WBS_min_BaU_Oxidatie_Balans;Kaarten/WBS_min_BaU_Methaan;Kaarten/WBS_min_BaU_Totaal_SOMERS;Kaarten/WBS_min_BaU_Totaal_Balans;Kaarten/NbS_min_BaU_Oxidatie_SOMERS;Kaarten/NbS_min_BaU_Oxidatie_Balans;Kaarten/NbS_min_BaU_Methaan;Kaarten/NbS_min_BaU_Totaal_SOMERS;Kaarten/NbS_min_BaU_Totaal_Balans"
		, Descr = "De tabel als unit, want de csv hangt aan de unit en de kolommen hebben geen zware subboom; de kaarten afzonderlijk.";
	}
}
