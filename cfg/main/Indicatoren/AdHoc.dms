////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Ad hoc items voor het resultatenrapport aan het kernteam NL2120 (versie 0.1, september 2026).
//
// Afspraak: elk getal in dat rapport is herleidbaar naar een concreet item in deze configuratie. Wat niet als kolom of
// kaart in de export bestaat maar wel in het rapport staat, krijgt hier zijn rekenregel. Per container staat in de Descr
// waar het item structureel zou horen als het blijft.
//
// De items lezen de exporttabellen van de casus (Export/Tabellen/PerNederland en PerIndeling) en de arealentabel
// LandgebruikNL2120_Areaal, zodat ze op dezelfde definities rusten als de levering. Ze schrijven niets weg.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container AdHoc
{
	container Rapport_v01
	: Descr = "Samengestelde grootheden voor het resultatenrapport v0.1 aan het kernteam NL2120, per casus onder PerCasus. Zie de Descr per container voor de plek waar het item structureel thuishoort."
	{
		container NatuurNatDroog
		: Descr = "Voorstel voor team natuur: een tweedeling van de natuurbeheertypen in nat en droog, om de arealen per landschap uit te splitsen. Nat zijn de hoofdgroepen N01 behalve N01.04, en N02, N03,
					N04, N05, N06, N09, N10, N13 en N14: water, moeras, veen, vochtige heide, nat en vochtig schraalland, weidevogelgrasland en vochtig bos. Droog zijn N01.04, N07, N08, N11, N12, N15, N16 en
					N17. N00 (nog om te vormen) telt niet mee. Structureel hoort dit als attribuut IsNat op Classifications/Grondgebruik/INL_Beheertype, met een subtotaal nat en droog in
					Export/Grondgebruik/LandgebruikNL2120_Areaal."
		{
			unit<uint8> BT := /Classifications/Grondgebruik/INL_Beheertype;

			attribute<String> Hoofdgroep (BT) := substr(BT/code, 0, 3);
			attribute<Bool>   IsNat      (BT) :=
				   (Hoofdgroep == 'N01' && BT/code != 'N01.04')
				|| Hoofdgroep == 'N02' || Hoofdgroep == 'N03' || Hoofdgroep == 'N04' || Hoofdgroep == 'N05' || Hoofdgroep == 'N06'
				|| Hoofdgroep == 'N09' || Hoofdgroep == 'N10' || Hoofdgroep == 'N13' || Hoofdgroep == 'N14';
			attribute<Bool>   IsDroog    (BT) :=
				   BT/code == 'N01.04'
				|| Hoofdgroep == 'N07' || Hoofdgroep == 'N08' || Hoofdgroep == 'N11' || Hoofdgroep == 'N12'
				|| Hoofdgroep == 'N15' || Hoofdgroep == 'N16' || Hoofdgroep == 'N17';

			// Koppeling van de 165 klassen van de landgebruikskaart aan het beheertype, op het label; null buiten de natuur.
			unit<uint8>     LU         := /Classifications/Grondgebruik/LU_NL2120;
			attribute<BT>   BT_rel     (LU) := rlookup(LU/Label, BT/Label);
			attribute<Bool> LU_IsNat   (LU) := IsNat[BT_rel];
			attribute<Bool> LU_IsDroog (LU) := IsDroog[BT_rel];
		}

		container ArealenBasisjaar
		: Descr = "Areaal per hoofdklasse in het basisjaar, landelijk en per landschapsgebied van #760, met dezelfde begrenzingen (Landschapsgebieden/Impl) en dezelfde rekenregel als
					Export/Grondgebruik/LandgebruikHoofdklasse_Areaal voor de zichtjaren; de export slaat het basisjaar over, want Zichtjaren kent het niet als exportjaar. Leest de geleverde basisjaarkaart (de
					export van Basisjaar/LandgebruikskaartNL2120/Write_Result_Hoofdklasse_SA) en niet dat item zelf, zodat de opgeleverde LocalData niet opnieuw hoeft te rekenen en de kolom rust op precies de
					kaart die het rapport toont. Het basisjaar is variantonafhankelijk, dus een variantmap volstaat. De landschapskolommen overlappen elkaar en tellen niet op tot Nederland. Structureel: een
					basisjaarregel in LandgebruikHoofdklasse_Areaal, of het basisjaar als exportjaar toelaten."
		{
			parameter<String> Levering := 'Productierun_20260910', Descr = "De opleveringsmap onder LocalDataDir.";
			parameter<String> Variant  := 'BAU1',                  Descr = "Uit welke variantmap de basisjaarkaart komt; de vier zijn gelijk.";

			attribute<Classifications/Grondgebruik/LU_Hoofdklasse> Kaart (/Geography/AdminDomain)
			: StorageName     = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Variant + '/kaarten_basisjaar/LandgebruikskaartHoofdklasse_Basisjaar.tif'"
			, StorageType     = "gdal.grid"
			, StorageReadOnly = "True";

			unit<uint8> Klassen := /Classifications/Grondgebruik/LU_Hoofdklasse
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/ArealenBasisjaar_perHoofdklasse.csv'", StorageType = "gdalwrite.vect"
			{
				attribute<String>   Klasse         := /Classifications/Grondgebruik/LU_Hoofdklasse/Label;
				attribute<Units/Ha> Nederland      := pcount(Kaart)[float32] * /Geography/rdc_25m/NrHaPerCell;
				attribute<Units/Ha> Kust           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust     ? Kaart : null_b)[float32] * /Geography/rdc_25m/NrHaPerCell;
				attribute<Units/Ha> Rivieren       := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? Kaart : null_b)[float32] * /Geography/rdc_25m/NrHaPerCell;
				attribute<Units/Ha> Veen           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen     ? Kaart : null_b)[float32] * /Geography/rdc_25m/NrHaPerCell;
				attribute<Units/Ha> Zand           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand     ? Kaart : null_b)[float32] * /Geography/rdc_25m/NrHaPerCell;
				attribute<Units/Ha> Geen_landschap := pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? Kaart : null_b)[float32] * /Geography/rdc_25m/NrHaPerCell;
			}
		}

		container SterfteUitgesteld
		: Descr = "De sterfte-indicator (#484) herrekend tot grootheden die als aantallen mensen en levensjaren te lezen zijn, landelijk en per landschapsgebied van #760, uit de kaarten AfnamePerPeriode die de
					export per zichtjaar wegschrijft. SterfteAfnameDoorGroenToename rekent per periode hoeveel sterfgevallen er minder vallen door meer groen rond woningen; opgeteld over een eeuw
					(AfnameCumulatief) is dat geen aantal mensen meer, want een vermeden sterfgeval is een uitgesteld sterfgeval en de som telt dezelfde mensen meermaals. Drie grootheden die wel als aantal te
					lezen zijn: PerJaar_2120, sterfgevallen per jaar minder in 2120 (de laatste periode gedeeld door haar lengte); InLeven_2120, mensen die in 2120 in leven zijn en zonder het extra groen al
					overleden zouden zijn, elk uitgesteld sterfgeval gewogen met de kans dat die persoon 2120 haalt uit de CBS-overlevingstafel; en Levensjaren_2023_2120, de gewonnen levensjaren binnen de
					horizon, met Levensjaren_Totaal ook de jaren na 2120. Daarnaast de uitgestelde sterfgevallen per periode en hun som, met als controle de som van de kaart AfnameCumulatief van 2120. Een
					negatieve afname krijgt dezelfde gewichten: vervroegd in plaats van uitgesteld. De gewichten per zichtjaar staan in Data/CBS_Overlevingstafel/uitstelgewichten_2024.csv, afgeleid met het
					script uitstelgewichten.py daarnaast; de landschapskolommen overlappen elkaar en tellen niet op tot Nederland. Structureel hoort dit in SterfteAfnameDoorGroenToename zelf, als vervanging van
					AfnameCumulatief.", Source = "CBS StatLine 37360ned, periode-overlevingstafel 2024, totaal mannen en vrouwen"
		{
			parameter<String> Levering := 'Productierun_20260910', Descr = "De opleveringsmap onder LocalDataDir; de kaarten per zichtjaar staan in Indicatoren/<casus>.";

			unit<uint8> Zichtjaar
			: StorageName     = "%ProjDir%/Data/CBS_Overlevingstafel/uitstelgewichten_2024.csv"
			, StorageType     = "gdal.vect"
			, StorageReadOnly = "True"
			, Descr           = "De negen zichtjaren met per periode de lengte in jaren en de twee uitstelgewichten, zie uitstelgewichten.py."
			{
				attribute<String> Naam;
				attribute<String> Van;
				attribute<String> Tot;
				attribute<String> Jaren;
				attribute<String> w_InLeven2120;
				attribute<String> w_Levensjaren2120;

				attribute<String>  name          := Naam;
				attribute<Float32> Periode       := Jaren[Float32],             Descr = "Lengte van de periode tot dit zichtjaar in jaren.";
				attribute<Float32> w_InLeven     := w_InLeven2120[Float32],     Descr = "Deel van de in deze periode uitgestelde sterfgevallen dat in 2120 nog leeft.";
				attribute<Float32> w_Levensjaren := w_Levensjaren2120[Float32], Descr = "Extra levensjaren tot 2120 per in deze periode uitgesteld sterfgeval.";
			}
			parameter<Float32> LevensjarenPerUitgesteldSterfgeval := 9.16f, Descr = "Verwachte extra levensjaren per uitgesteld sterfgeval zonder horizon, de som van S(k) uit uitstelgewichten.py op de tafel van 2024.";

			unit<uint8> Casus : NrOfRows = 3, Descr = "De drie varianten van het rapport, met de casusmap onder Indicatoren."
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
				attribute<String> Map  : ['WLO_hoog_BAU', 'WLO_hoog_BAU2', 'WLO_hoog_NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760 (Landschapsgebieden/Impl)."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}

			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/Map) + ')');

			template Casus_T
			{
				parameter<String> Map;

				container PerZichtjaar := for_each_ne(Zichtjaar/name, 'Zichtjaar_T(' + quote(Zichtjaar/name) + ')');

				template Zichtjaar_T
				{
					parameter<String> ZJ;

					attribute<Float32> Kaart (/Geography/AdminDomain)
					: StorageName     = "='%LocalDataDir%/' + Levering + '/Indicatoren/' + Map + '/Mortaliteit_SterfteAfname_PerPeriode_' + ZJ + '_Nederland.tif'"
					, StorageType     = "gdal.grid"
					, StorageReadOnly = "True"
					, Descr           = "Uitgestelde sterfgevallen in de periode tot dit zichtjaar, per cel, zoals de export ze schreef.";
					attribute<Float32> Waarde (/Geography/AdminDomain) := MakeDefined(Kaart, 0f);

					parameter<Float32> Periode       := Zichtjaar/Periode[rlookup(ZJ, Zichtjaar/name)];
					parameter<Float32> w_InLeven     := Zichtjaar/w_InLeven[rlookup(ZJ, Zichtjaar/name)];
					parameter<Float32> w_Levensjaren := Zichtjaar/w_Levensjaren[rlookup(ZJ, Zichtjaar/name)];

					parameter<Float32> Nederland := sum(Waarde);
					parameter<Float32> Kust      := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust     ? Waarde : 0f);
					parameter<Float32> Rivieren  := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? Waarde : 0f);
					parameter<Float32> Veen      := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen     ? Waarde : 0f);
					parameter<Float32> Zand      := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand     ? Waarde : 0f);
				}

				container Controle
				: Descr = "De kaart AfnameCumulatief van 2120; de som per regio hoort gelijk te zijn aan Uitgesteld_Totaal."
				{
					attribute<Float32> Kaart (/Geography/AdminDomain)
					: StorageName     = "='%LocalDataDir%/' + Levering + '/Indicatoren/' + Map + '/Mortaliteit_SterfteAfname_Cumulatief_Y2120_Nederland.tif'"
					, StorageType     = "gdal.grid"
					, StorageReadOnly = "True";
					attribute<Float32> Waarde (/Geography/AdminDomain) := MakeDefined(Kaart, 0f);

					parameter<Float32> Nederland := sum(Waarde);
					parameter<Float32> Kust      := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust     ? Waarde : 0f);
					parameter<Float32> Rivieren  := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? Waarde : 0f);
					parameter<Float32> Veen      := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen     ? Waarde : 0f);
					parameter<Float32> Zand      := sum(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand     ? Waarde : 0f);
				}

				container PerRegio := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ')');

				template Regio_T
				{
					parameter<String> RegioNaam;

					parameter<Float32> Uitgesteld_Totaal        := = 'add(' + AsList('PerZichtjaar/' + Zichtjaar/name + '/' + RegioNaam, ',') + ')';
					parameter<Float32> InLeven_2120             := = 'add(' + AsList('PerZichtjaar/' + Zichtjaar/name + '/' + RegioNaam + ' * PerZichtjaar/' + Zichtjaar/name + '/w_InLeven', ',') + ')';
					parameter<Float32> Levensjaren_2023_2120    := = 'add(' + AsList('PerZichtjaar/' + Zichtjaar/name + '/' + RegioNaam + ' * PerZichtjaar/' + Zichtjaar/name + '/w_Levensjaren', ',') + ')';
					parameter<Float32> PerJaar_2120             := = 'PerZichtjaar/Y2120/' + RegioNaam + ' / PerZichtjaar/Y2120/Periode';
					parameter<Float32> Controle_Cumulatief_2120 := = 'Controle/' + RegioNaam;
				}

				unit<uint8> Tabel := Regio
				, Descr = "De vijf regio's van deze casus als tabel, zonder meta-expressies, zodat Rijen ze zo kan stapelen."
				{
					attribute<Float32> Uitgesteld_Y2040         := union_data(., PerZichtjaar/Y2040/Nederland, PerZichtjaar/Y2040/Kust, PerZichtjaar/Y2040/Rivieren, PerZichtjaar/Y2040/Veen, PerZichtjaar/Y2040/Zand);
					attribute<Float32> Uitgesteld_Y2050         := union_data(., PerZichtjaar/Y2050/Nederland, PerZichtjaar/Y2050/Kust, PerZichtjaar/Y2050/Rivieren, PerZichtjaar/Y2050/Veen, PerZichtjaar/Y2050/Zand);
					attribute<Float32> Uitgesteld_Y2060         := union_data(., PerZichtjaar/Y2060/Nederland, PerZichtjaar/Y2060/Kust, PerZichtjaar/Y2060/Rivieren, PerZichtjaar/Y2060/Veen, PerZichtjaar/Y2060/Zand);
					attribute<Float32> Uitgesteld_Y2070         := union_data(., PerZichtjaar/Y2070/Nederland, PerZichtjaar/Y2070/Kust, PerZichtjaar/Y2070/Rivieren, PerZichtjaar/Y2070/Veen, PerZichtjaar/Y2070/Zand);
					attribute<Float32> Uitgesteld_Y2080         := union_data(., PerZichtjaar/Y2080/Nederland, PerZichtjaar/Y2080/Kust, PerZichtjaar/Y2080/Rivieren, PerZichtjaar/Y2080/Veen, PerZichtjaar/Y2080/Zand);
					attribute<Float32> Uitgesteld_Y2090         := union_data(., PerZichtjaar/Y2090/Nederland, PerZichtjaar/Y2090/Kust, PerZichtjaar/Y2090/Rivieren, PerZichtjaar/Y2090/Veen, PerZichtjaar/Y2090/Zand);
					attribute<Float32> Uitgesteld_Y2100         := union_data(., PerZichtjaar/Y2100/Nederland, PerZichtjaar/Y2100/Kust, PerZichtjaar/Y2100/Rivieren, PerZichtjaar/Y2100/Veen, PerZichtjaar/Y2100/Zand);
					attribute<Float32> Uitgesteld_Y2110         := union_data(., PerZichtjaar/Y2110/Nederland, PerZichtjaar/Y2110/Kust, PerZichtjaar/Y2110/Rivieren, PerZichtjaar/Y2110/Veen, PerZichtjaar/Y2110/Zand);
					attribute<Float32> Uitgesteld_Y2120         := union_data(., PerZichtjaar/Y2120/Nederland, PerZichtjaar/Y2120/Kust, PerZichtjaar/Y2120/Rivieren, PerZichtjaar/Y2120/Veen, PerZichtjaar/Y2120/Zand);
					attribute<Float32> Uitgesteld_Totaal        := union_data(., PerRegio/Nederland/Uitgesteld_Totaal, PerRegio/Kust/Uitgesteld_Totaal, PerRegio/Rivieren/Uitgesteld_Totaal, PerRegio/Veen/Uitgesteld_Totaal, PerRegio/Zand/Uitgesteld_Totaal);
					attribute<Float32> Controle_Cumulatief_2120 := union_data(., PerRegio/Nederland/Controle_Cumulatief_2120, PerRegio/Kust/Controle_Cumulatief_2120, PerRegio/Rivieren/Controle_Cumulatief_2120, PerRegio/Veen/Controle_Cumulatief_2120, PerRegio/Zand/Controle_Cumulatief_2120);
					attribute<Float32> PerJaar_2120             := union_data(., PerRegio/Nederland/PerJaar_2120, PerRegio/Kust/PerJaar_2120, PerRegio/Rivieren/PerJaar_2120, PerRegio/Veen/PerJaar_2120, PerRegio/Zand/PerJaar_2120);
					attribute<Float32> InLeven_2120             := union_data(., PerRegio/Nederland/InLeven_2120, PerRegio/Kust/InLeven_2120, PerRegio/Rivieren/InLeven_2120, PerRegio/Veen/InLeven_2120, PerRegio/Zand/InLeven_2120);
					attribute<Float32> Levensjaren_2023_2120    := union_data(., PerRegio/Nederland/Levensjaren_2023_2120, PerRegio/Kust/Levensjaren_2023_2120, PerRegio/Rivieren/Levensjaren_2023_2120, PerRegio/Veen/Levensjaren_2023_2120, PerRegio/Zand/Levensjaren_2023_2120);
					attribute<Float32> Levensjaren_Totaal       := Uitgesteld_Totaal * LevensjarenPerUitgesteldSterfgeval;
				}
			}

			unit<uint32> RijenBron := combine(Casus, Regio)
			, Descr = "De regels, los van de weggeschreven unit: een kolom van een unit met StorageName mag niet op een zusterkolom steunen (Cannot start ValidationAndCommit while doing ValidationAndCommit)."
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}

			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/SterfteUitgesteld.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied, in de volgorde van Casus en Regio: de uitgestelde sterfgevallen per periode en de drie herrekende grootheden."
			{
				attribute<String>  Variant := RijenBron/CasusNaam;
				attribute<String>  Gebied  := RijenBron/RegioNaam;

				attribute<Float32> Uitgesteld_Y2040         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2040, PerCasus/BAU2/Tabel/Uitgesteld_Y2040, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2040);
				attribute<Float32> Uitgesteld_Y2050         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2050, PerCasus/BAU2/Tabel/Uitgesteld_Y2050, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2050);
				attribute<Float32> Uitgesteld_Y2060         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2060, PerCasus/BAU2/Tabel/Uitgesteld_Y2060, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2060);
				attribute<Float32> Uitgesteld_Y2070         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2070, PerCasus/BAU2/Tabel/Uitgesteld_Y2070, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2070);
				attribute<Float32> Uitgesteld_Y2080         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2080, PerCasus/BAU2/Tabel/Uitgesteld_Y2080, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2080);
				attribute<Float32> Uitgesteld_Y2090         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2090, PerCasus/BAU2/Tabel/Uitgesteld_Y2090, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2090);
				attribute<Float32> Uitgesteld_Y2100         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2100, PerCasus/BAU2/Tabel/Uitgesteld_Y2100, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2100);
				attribute<Float32> Uitgesteld_Y2110         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2110, PerCasus/BAU2/Tabel/Uitgesteld_Y2110, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2110);
				attribute<Float32> Uitgesteld_Y2120         := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Y2120, PerCasus/BAU2/Tabel/Uitgesteld_Y2120, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Y2120);
				attribute<Float32> Uitgesteld_Totaal        := union_data(., PerCasus/BAU1/Tabel/Uitgesteld_Totaal, PerCasus/BAU2/Tabel/Uitgesteld_Totaal, PerCasus/NbSGenuanceerder/Tabel/Uitgesteld_Totaal);
				attribute<Float32> Controle_Cumulatief_2120 := union_data(., PerCasus/BAU1/Tabel/Controle_Cumulatief_2120, PerCasus/BAU2/Tabel/Controle_Cumulatief_2120, PerCasus/NbSGenuanceerder/Tabel/Controle_Cumulatief_2120);
				attribute<Float32> PerJaar_2120             := union_data(., PerCasus/BAU1/Tabel/PerJaar_2120, PerCasus/BAU2/Tabel/PerJaar_2120, PerCasus/NbSGenuanceerder/Tabel/PerJaar_2120);
				attribute<Float32> InLeven_2120             := union_data(., PerCasus/BAU1/Tabel/InLeven_2120, PerCasus/BAU2/Tabel/InLeven_2120, PerCasus/NbSGenuanceerder/Tabel/InLeven_2120);
				attribute<Float32> Levensjaren_2023_2120    := union_data(., PerCasus/BAU1/Tabel/Levensjaren_2023_2120, PerCasus/BAU2/Tabel/Levensjaren_2023_2120, PerCasus/NbSGenuanceerder/Tabel/Levensjaren_2023_2120);
				attribute<Float32> Levensjaren_Totaal       := union_data(., PerCasus/BAU1/Tabel/Levensjaren_Totaal, PerCasus/BAU2/Tabel/Levensjaren_Totaal, PerCasus/NbSGenuanceerder/Tabel/Levensjaren_Totaal);
			}
		}

		container StandBasisjaar
		: Descr = "De standindicatoren van tabel 6.1, 6.2 en 9.1 van het resultatenrapport voor het basisjaar 2023, landelijk en per landschapsgebied van #760, met dezelfde rekenregels als de export voor de
					zichtjaren (RegionaleIndicatoren_T in Templates/Indicatoren_T/Export.dms) maar op de basisjaarcontainers, want de export slaat het basisjaar over. Per kolom: Dichtheid_Wonen en
					Dichtheid_Werken_Banen_ha uit Basisjaar/Dichtheid, het gemiddelde van de celdichtheid over de cellen met woningen of banen; Verharding uit Basisjaar/Verharding/Result met lege cellen als
					nul, gemiddeld over de cellen van het gebied binnen het studiegebied; BereikbaarheidGroen_Fractie_Tot300m_Groenaanbod_over_woning is voor het basisjaar niet te rekenen, want de fractietak
					van BereikbaarheidGroenBBG_T leest WaardeNabijheidGroen/Fracties/NatuurCel en die container bestaat alleen in het zichtjaar; Bereikbaarheid_Banen_OV, _Fiets en _Auto uit de kolommen
					Banen_*_StartYear per buurt uit Bereikbaarheid_Banen_Y2120.gpkg, bewonersgewogen over de buurten van het gebied; Piekbuiberging_Opgave_m3 uit Basisjaar/Piekbuiberging/PerGrid/Opgave per
					blok, waarbij aanbod, gedekt en dekkingsgraad in het basisjaar geen waarde hebben omdat de bestaande capaciteit daar als verbruikt geldt; de drie overstromingsschadekolommen uit
					Basisjaar/Overstromingsschade/Resultaat, nominaal. Het basisjaar is variantonafhankelijk, dus de casus BAU volstaat; de landschapskolommen overlappen elkaar. Structureel: het basisjaar als
					exportjaar toelaten in Zichtjaren, dan komt dit uit RegionaleIndicatoren_T."
		{
			parameter<String> Levering := 'Productierun_20260910', Descr = "De opleveringsmap onder LocalDataDir, voor de gpkg van de banenbereikbaarheid.";
			parameter<String> Casus    := 'WLO_hoog_BAU',         Descr = "Uit welke casus het basisjaar komt; het basisjaar is voor alle varianten gelijk.";
			container         B        := ='/Indicatoren/' + Casus + '/Basisjaar';
			unit<UInt32>      Buurt    := /SourceData/RegioIndelingen/cbs/Y2021/buurt, Descr = "De buurtindeling van de banenbereikbaarheid (Templates/Indicatoren/Bereikbaarheid.dms).";

			container BanenGpkg
			: StorageName     = "='%LocalDataDir%/' + Levering + '/Indicatoren/' + Casus + '/Bereikbaarheid_Banen_Y2120.gpkg'"
			, StorageType     = "gdal.vect"
			, StorageReadOnly = "True"
			, Descr           = "De uitvoer van Bereikbaarheid_Banen/Result van het laatste zichtjaar, met per buurt naast de zichtjaarwaarde ook de waarde van het basisjaar (StartYear)."
			{
				unit<uint32> Output_PerBuurt
				{
					attribute<String>  BU_CODE;
					attribute<Float32> Banen_W_OV_W_StartYear;
					attribute<Float32> Banen_BB_StartYear;
					attribute<Float32> Banen_CAR_StartYear;
				}
			}
			container BanenBasisjaar
			{
				attribute<Float32> OV       (Buurt) := rjoin(Buurt/statcode, BanenGpkg/Output_PerBuurt/BU_CODE, BanenGpkg/Output_PerBuurt/Banen_W_OV_W_StartYear);
				attribute<Float32> Fiets    (Buurt) := rjoin(Buurt/statcode, BanenGpkg/Output_PerBuurt/BU_CODE, BanenGpkg/Output_PerBuurt/Banen_BB_StartYear);
				attribute<Float32> Auto     (Buurt) := rjoin(Buurt/statcode, BanenGpkg/Output_PerBuurt/BU_CODE, BanenGpkg/Output_PerBuurt/Banen_CAR_StartYear);
				attribute<Float32> Woningen (Buurt) := sum(B/Stand/Aantal_Woningen_Totaal[Float32], Buurt/Per_AdminDomain), Descr = "De woningen van het basisjaar per buurt, het gewicht van de aggregatie.";
			}

			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760 (Landschapsgebieden/Impl)."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container Masker
			{
				attribute<Bool> Nederland (/Geography/AdminDomain) := const(TRUE, /Geography/AdminDomain);
				attribute<Bool> Kust      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsKust;
				attribute<Bool> Rivieren  (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren;
				attribute<Bool> Veen      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen;
				attribute<Bool> Zand      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsZand;
			}

			container PerRegio := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ', Masker/' + Regio/name + ')');

			template Regio_T
			{
				parameter<String> RegioNaam;
				attribute<Bool>   IsRegio (/Geography/AdminDomain);

				attribute<Float32> Zeef (/Geography/AdminDomain) := IsRegio && /Geography/AdminDomain/IsCompactedDomain ? 1f : null_f, Descr = "1 binnen het gebied en het studiegebied, null erbuiten; de aggregaties slaan null over. Het studiegebied hoort erbij omdat de zichtjaarkaarten daarbuiten leeg zijn en de teamgebieden tot op zee lopen.";

				parameter<Float32> Dichtheid_Wonen           := mean(B/Dichtheid/Wonen/Per_AdminDomain[Float32] * Zeef);
				parameter<Float32> Dichtheid_Werken_Banen_ha := mean(B/Dichtheid/Werken/Banen_ha/Per_AdminDomain[Float32] * Zeef);
				parameter<Float32> Verharding                := mean(MakeDefined(B/Verharding/Result, 0f) * Zeef), Descr = "Lege basisjaarcellen tellen als onverhard, zoals in het zichtjaar: daar krijgt een onveranderde cel Basisjaarverharding, het celgemiddelde van dezelfde kaart, en dat is nul waar de kaart leeg is. Zonder MakeDefined telt het gemiddelde alleen de cellen met verharding en komt landelijk op 0,60 in plaats van rond 0,15.";

				attribute<Bool>    BuurtInRegio               (Buurt) := modus(IsRegio, Buurt/Per_AdminDomain), Descr = "De buurt hoort bij het gebied waarin de meeste van haar cellen liggen.";
				attribute<Float32> BuurtZeef                  (Buurt) := BuurtInRegio ? 1f : null_f;
				parameter<Float32> Bereikbaarheid_Banen_OV    := sum(BanenBasisjaar/OV    * BanenBasisjaar/Woningen * BuurtZeef) / sum(BanenBasisjaar/Woningen * BuurtZeef);
				parameter<Float32> Bereikbaarheid_Banen_Fiets := sum(BanenBasisjaar/Fiets * BanenBasisjaar/Woningen * BuurtZeef) / sum(BanenBasisjaar/Woningen * BuurtZeef);
				parameter<Float32> Bereikbaarheid_Banen_Auto  := sum(BanenBasisjaar/Auto  * BanenBasisjaar/Woningen * BuurtZeef) / sum(BanenBasisjaar/Woningen * BuurtZeef);

				attribute<Bool>    BlokInRegio              (B/Piekbuiberging/Grid) := = 'any(IsRegio, /Geography/AdminDomain/rdc_' + /ModelParameters/Piekbuiberging/Grid_ref + '_rel)', Descr = "Het blok telt mee zodra een van zijn cellen in het gebied ligt. Dat is wat de zichtjaartabel doet: PerRegio/Regio/Per_Grid neemt de modus van de regio over de cellen van het blok, en buiten het gebied is die regio null en telt niet mee, dus elk blok met een cel in het gebied hoort erbij. Met een meerderheidsregel kwam de kustopgave op 128,7 in plaats van 130,7 mln m3.";
				parameter<Float32> Piekbuiberging_Opgave_m3 := sum(B/Piekbuiberging/PerGrid/Opgave[Float32] * (BlokInRegio ? 1f : null_f));

				parameter<Float32> Overstromingsschade_Hoofdwatersysteem_Binnendijks     := sum(B/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks[Float32]     * Zeef);
				parameter<Float32> Overstromingsschade_Hoofdwatersysteem_Buitendijks     := sum(B/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks[Float32]     * Zeef);
				parameter<Float32> Overstromingsschade_Regionaalwatersysteem_Binnendijks := sum(B/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks[Float32] * Zeef);
			}

			unit<uint8> Uitvoer := Regio
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/StandBasisjaar.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per gebied, kolomnamen als in de export; geen kolom steunt op een zusterkolom."
			{
				attribute<String>  Regio_name                                            := Regio/name;
				attribute<Float32> Dichtheid_Wonen                                       := union_data(., PerRegio/Nederland/Dichtheid_Wonen, PerRegio/Kust/Dichtheid_Wonen, PerRegio/Rivieren/Dichtheid_Wonen, PerRegio/Veen/Dichtheid_Wonen, PerRegio/Zand/Dichtheid_Wonen);
				attribute<Float32> Dichtheid_Werken_Banen_ha                             := union_data(., PerRegio/Nederland/Dichtheid_Werken_Banen_ha, PerRegio/Kust/Dichtheid_Werken_Banen_ha, PerRegio/Rivieren/Dichtheid_Werken_Banen_ha, PerRegio/Veen/Dichtheid_Werken_Banen_ha, PerRegio/Zand/Dichtheid_Werken_Banen_ha);
				attribute<Float32> Verharding                                            := union_data(., PerRegio/Nederland/Verharding, PerRegio/Kust/Verharding, PerRegio/Rivieren/Verharding, PerRegio/Veen/Verharding, PerRegio/Zand/Verharding);
				attribute<Float32> Bereikbaarheid_Banen_OV                               := union_data(., PerRegio/Nederland/Bereikbaarheid_Banen_OV, PerRegio/Kust/Bereikbaarheid_Banen_OV, PerRegio/Rivieren/Bereikbaarheid_Banen_OV, PerRegio/Veen/Bereikbaarheid_Banen_OV, PerRegio/Zand/Bereikbaarheid_Banen_OV);
				attribute<Float32> Bereikbaarheid_Banen_Fiets                            := union_data(., PerRegio/Nederland/Bereikbaarheid_Banen_Fiets, PerRegio/Kust/Bereikbaarheid_Banen_Fiets, PerRegio/Rivieren/Bereikbaarheid_Banen_Fiets, PerRegio/Veen/Bereikbaarheid_Banen_Fiets, PerRegio/Zand/Bereikbaarheid_Banen_Fiets);
				attribute<Float32> Bereikbaarheid_Banen_Auto                             := union_data(., PerRegio/Nederland/Bereikbaarheid_Banen_Auto, PerRegio/Kust/Bereikbaarheid_Banen_Auto, PerRegio/Rivieren/Bereikbaarheid_Banen_Auto, PerRegio/Veen/Bereikbaarheid_Banen_Auto, PerRegio/Zand/Bereikbaarheid_Banen_Auto);
				attribute<Float32> Piekbuiberging_Opgave_m3                              := union_data(., PerRegio/Nederland/Piekbuiberging_Opgave_m3, PerRegio/Kust/Piekbuiberging_Opgave_m3, PerRegio/Rivieren/Piekbuiberging_Opgave_m3, PerRegio/Veen/Piekbuiberging_Opgave_m3, PerRegio/Zand/Piekbuiberging_Opgave_m3);
				attribute<Float32> Overstromingsschade_Hoofdwatersysteem_Binnendijks     := union_data(., PerRegio/Nederland/Overstromingsschade_Hoofdwatersysteem_Binnendijks, PerRegio/Kust/Overstromingsschade_Hoofdwatersysteem_Binnendijks, PerRegio/Rivieren/Overstromingsschade_Hoofdwatersysteem_Binnendijks, PerRegio/Veen/Overstromingsschade_Hoofdwatersysteem_Binnendijks, PerRegio/Zand/Overstromingsschade_Hoofdwatersysteem_Binnendijks);
				attribute<Float32> Overstromingsschade_Hoofdwatersysteem_Buitendijks     := union_data(., PerRegio/Nederland/Overstromingsschade_Hoofdwatersysteem_Buitendijks, PerRegio/Kust/Overstromingsschade_Hoofdwatersysteem_Buitendijks, PerRegio/Rivieren/Overstromingsschade_Hoofdwatersysteem_Buitendijks, PerRegio/Veen/Overstromingsschade_Hoofdwatersysteem_Buitendijks, PerRegio/Zand/Overstromingsschade_Hoofdwatersysteem_Buitendijks);
				attribute<Float32> Overstromingsschade_Regionaalwatersysteem_Binnendijks := union_data(., PerRegio/Nederland/Overstromingsschade_Regionaalwatersysteem_Binnendijks, PerRegio/Kust/Overstromingsschade_Regionaalwatersysteem_Binnendijks, PerRegio/Rivieren/Overstromingsschade_Regionaalwatersysteem_Binnendijks, PerRegio/Veen/Overstromingsschade_Regionaalwatersysteem_Binnendijks, PerRegio/Zand/Overstromingsschade_Regionaalwatersysteem_Binnendijks);
			}

		}

		container Scenario
		: Descr = "De ruimtevraag van het omgevingsscenario voor het resultatenrapport: woningen (eengezins en meergezins) en banen in de stand van het basisjaar en als claim per zichtjaar, landelijk, plus de
					basisjaarstand per provincie voor de kaart met de groei tot 2120. De claims komen uit dezelfde items die de allocatie leest
					(VariantData/<variant>/Claims/WLO_hoog/Zichtjaren/<zichtjaar>/AllocRegios, wonen op de NVM-regio's per WP2xVSSH-segment, werken op de COROP-regio's als Totaal over de zes TIGRIS-sectoren,
					met de verankering op de LISA-trend uit ModelParameters/ClaimBasisjaar); ze zijn in alle varianten gelijk, dus BAU volstaat, en vanaf Advanced/FromWhichDoWeKeepTIGRISconstant loopt de reeks
					vlak. De basisjaarstand komt uit Indicatoren/<casus>/Basisjaar/Stand, de provincies uit RegioIndelingen/Provincie/StudyArea; de 2120-stand per provincie staat al in de export
					(ClaimRealisatie_Provincie)."
		{
			parameter<String> Variant   := 'BAU', Descr = "Uit welke variant de claims en het basisjaar komen; beide zijn variantonafhankelijk.";
			container         Cl        := ='/VariantData/' + Variant + '/Claims/WLO_hoog/Zichtjaren';
			container         B         := ='/Indicatoren/WLO_hoog_' + Variant + '/Basisjaar';
			unit<uint32>      Provincie := /SourceData/RegioIndelingen/Provincie/StudyArea;

			container Basisjaar
			{
				parameter<Float32> Eengezins  := sum(B/Stand/Aantal_Woningen_eengezins_VrijeSector[Float32] + B/Stand/Aantal_Woningen_eengezins_SocialeHuur[Float32]);
				parameter<Float32> Meergezins := sum(B/Stand/Aantal_Woningen_meergezins_VrijeSector[Float32] + B/Stand/Aantal_Woningen_meergezins_SocialeHuur[Float32]);
				parameter<Float32> Banen      := sum(B/Stand/Aantal_Banen_Totaal[Float32]);
			}
			unit<uint8> Zichtjaar : NrOfRows = 9 { attribute<String> name : ['Y2040', 'Y2050', 'Y2060', 'Y2070', 'Y2080', 'Y2090', 'Y2100', 'Y2110', 'Y2120']; }
			container PerZichtjaar := for_each_ne(Zichtjaar/name, 'Zichtjaar_T(' + quote(Zichtjaar/name) + ')');
			template Zichtjaar_T
			{
				parameter<String> ZJ;
				parameter<Float32> Eengezins  := = 'sum(Cl/' + ZJ + '/AllocRegios/NVM/Wonen/eengezins_VrijeSector[Float32] + Cl/' + ZJ + '/AllocRegios/NVM/Wonen/eengezins_SocialeHuur[Float32])';
				parameter<Float32> Meergezins := = 'sum(Cl/' + ZJ + '/AllocRegios/NVM/Wonen/meergezins_VrijeSector[Float32] + Cl/' + ZJ + '/AllocRegios/NVM/Wonen/meergezins_SocialeHuur[Float32])';
				parameter<Float32> Banen      := = 'sum(Cl/' + ZJ + '/AllocRegios/COROP/Werken/Totaal[Float32])';
			}

			unit<uint8> Reeks : NrOfRows = 10, Descr = "Het basisjaar en de negen zichtjaren."
			{
				attribute<String> name : ['Y2023', 'Y2040', 'Y2050', 'Y2060', 'Y2070', 'Y2080', 'Y2090', 'Y2100', 'Y2110', 'Y2120'];
			}
			unit<uint8> Uitvoer := Reeks
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/Scenario_reeks.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Landelijk per jaar: de stand van het basisjaar en daarna de claim per zichtjaar."
			{
				attribute<String>  Jaar       := Reeks/name;
				attribute<Float32> Eengezins  := union_data(., Basisjaar/Eengezins, PerZichtjaar/Y2040/Eengezins, PerZichtjaar/Y2050/Eengezins, PerZichtjaar/Y2060/Eengezins, PerZichtjaar/Y2070/Eengezins, PerZichtjaar/Y2080/Eengezins, PerZichtjaar/Y2090/Eengezins, PerZichtjaar/Y2100/Eengezins, PerZichtjaar/Y2110/Eengezins, PerZichtjaar/Y2120/Eengezins);
				attribute<Float32> Meergezins := union_data(., Basisjaar/Meergezins, PerZichtjaar/Y2040/Meergezins, PerZichtjaar/Y2050/Meergezins, PerZichtjaar/Y2060/Meergezins, PerZichtjaar/Y2070/Meergezins, PerZichtjaar/Y2080/Meergezins, PerZichtjaar/Y2090/Meergezins, PerZichtjaar/Y2100/Meergezins, PerZichtjaar/Y2110/Meergezins, PerZichtjaar/Y2120/Meergezins);
				attribute<Float32> Banen      := union_data(., Basisjaar/Banen, PerZichtjaar/Y2040/Banen, PerZichtjaar/Y2050/Banen, PerZichtjaar/Y2060/Banen, PerZichtjaar/Y2070/Banen, PerZichtjaar/Y2080/Banen, PerZichtjaar/Y2090/Banen, PerZichtjaar/Y2100/Banen, PerZichtjaar/Y2110/Banen, PerZichtjaar/Y2120/Banen);
			}

			unit<uint32> PerProvincie := Provincie
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/Scenario_provincie.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "De stand van het basisjaar per provincie: woningen totaal, eengezins, meergezins en banen."
			{
				attribute<String>  Provincie_name := Provincie/name;
				attribute<Float32> Woningen       := sum(B/Stand/Aantal_Woningen_Totaal[Float32], Provincie/Per_AdminDomain_Fijn);
				attribute<Float32> Eengezins      := sum(B/Stand/Aantal_Woningen_eengezins_VrijeSector[Float32] + B/Stand/Aantal_Woningen_eengezins_SocialeHuur[Float32], Provincie/Per_AdminDomain_Fijn);
				attribute<Float32> Meergezins     := sum(B/Stand/Aantal_Woningen_meergezins_VrijeSector[Float32] + B/Stand/Aantal_Woningen_meergezins_SocialeHuur[Float32], Provincie/Per_AdminDomain_Fijn);
				attribute<Float32> Banen          := sum(B/Stand/Aantal_Banen_Totaal[Float32], Provincie/Per_AdminDomain_Fijn);
			}
		}

		container PiekbuiT100
		: Descr = "De piekbuiberging van 2120 met de andere buikaart: 70 mm in 2 uur, herhalingstijd ongeveer 100 jaar (SourceData/Water/WaterdiepteBijHevigeNeerslag_T100), naast de 140 mm van Kans_ref 1000 in
					de levering. Dezelfde rekenregels als Templates/Indicatoren/Piekbuiberging.dms: de opgave is de waterschijf van de dieptekaart maal het celoppervlak binnen bestaand bebouwd gebied, per blok
					van Grid_ref gesommeerd; het aanbod is dat van de levering (onafhankelijk van de bui); gedekt is per blok het minimum van opgave en aanbod, en de dekkingsgraad is gedekt gedeeld door opgave.
					Landelijk en per landschapsgebied van #760. Ter controle staan de waarden bij de bui van de levering ernaast (kolommen _ref), die gelijk horen te zijn aan de tabellen. Structureel: beide
					buien naast elkaar in RegionaleIndicatoren_T, of Kans_ref als exportdimensie."
		{
			parameter<String> Kans_alt := '100', Descr = "De andere dieptekaart: 100 (70 mm in 2 uur) tegenover Kans_ref 1000 in de levering.";
			parameter<String> Grid_ref := /ModelParameters/Piekbuiberging/Grid_ref;
			unit<IPoint>      Grid     := = '/Geography/rdc_' + Grid_ref;

			unit<uint8> Casus : NrOfRows = 3
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
				attribute<String> Map  : ['WLO_hoog_BAU', 'WLO_hoog_BAU2', 'WLO_hoog_NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760 (Landschapsgebieden/Impl)."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container Masker
			{
				attribute<Bool> Nederland (/Geography/AdminDomain) := const(TRUE, /Geography/AdminDomain);
				attribute<Bool> Kust      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsKust;
				attribute<Bool> Rivieren  (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren;
				attribute<Bool> Veen      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen;
				attribute<Bool> Zand      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsZand;
			}

			attribute<Bool>         BestaandBebouwdGebied (/Geography/AdminDomain) := /BaseData/Omgeving/UrbanContour, Descr = "Dezelfde begrenzing als de opgave van de levering (Basisjaar.dms)."; 
			attribute<Units/meter>  Diepte_alt            (/Geography/AdminDomain) := = '/SourceData/Water/WaterdiepteBijHevigeNeerslag_T' + Kans_alt;
			attribute<Units/meter3> Opgave_alt_Cel        (/Geography/AdminDomain) := Diepte_alt * /Geography/AdminDomain/NrMeter2PerCell * float32(BestaandBebouwdGebied);
			attribute<Units/meter3> Blok_Opgave_alt       (Grid)                   := = 'sum(Opgave_alt_Cel, /Geography/AdminDomain/rdc_' + Grid_ref + '_rel)';

			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/Map) + ')');
			template Casus_T
			{
				parameter<String> Map;
				container               Z                 := ='/Indicatoren/' + Map + '/Zichtjaren/Y2120/Piekbuiberging/PerGrid';
				attribute<Units/meter3> Blok_Aanbod       (Grid) := Z/Aanbod;
				attribute<Units/meter3> Blok_Opgave_ref   (Grid) := Z/Opgave;
				attribute<Units/meter3> Blok_Gedekt_ref   (Grid) := Z/Gedekt;
				attribute<Units/meter3> Blok_Gedekt_alt   (Grid) := min_elem(Blok_Opgave_alt, Blok_Aanbod);
				attribute<Units/meter3> Blok_Ongedekt_alt (Grid) := Blok_Opgave_alt - Blok_Gedekt_alt;

				container PerRegio := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ', Masker/' + Regio/name + ')');
				template Regio_T
				{
					parameter<String> RegioNaam;
					attribute<Bool>   IsRegio (/Geography/AdminDomain);
					attribute<Float32> BlokZeef                    (Grid) := = 'any(IsRegio, /Geography/AdminDomain/rdc_' + Grid_ref + '_rel) ? 1f : null_f', Descr = "Het blok telt mee zodra een van zijn cellen in het gebied ligt, zoals de landschapstabellen.";
					parameter<Float32> Opgave_ref                  := sum(Blok_Opgave_ref[Float32]   * BlokZeef);
					parameter<Float32> Gedekt_ref                  := sum(Blok_Gedekt_ref[Float32]   * BlokZeef);
					parameter<Float32> Aanbod                      := sum(Blok_Aanbod[Float32]       * BlokZeef);
					parameter<Float32> Opgave_alt                  := sum(Blok_Opgave_alt[Float32]   * BlokZeef);
					parameter<Float32> Gedekt_alt                  := sum(Blok_Gedekt_alt[Float32]   * BlokZeef);
					parameter<Float32> Ongedekt_alt                := sum(Blok_Ongedekt_alt[Float32] * BlokZeef);
					parameter<Float32> Dekkingsgraad_ref           := Gedekt_ref / Opgave_ref;
					parameter<Float32> Dekkingsgraad_alt           := Gedekt_alt / Opgave_alt;
					parameter<Float32> Dekkingsgraad_alt_Ongeklemd := min_elem(Aanbod, Opgave_alt) / Opgave_alt;
				}

				unit<uint8> Tabel := Regio, Descr = "De vijf gebieden van deze casus als tabel, zonder meta-expressies, zodat Rijen ze kan stapelen."
				{
					attribute<Float32> Opgave_ref                   := union_data(., PerRegio/Nederland/Opgave_ref, PerRegio/Kust/Opgave_ref, PerRegio/Rivieren/Opgave_ref, PerRegio/Veen/Opgave_ref, PerRegio/Zand/Opgave_ref);
					attribute<Float32> Gedekt_ref                   := union_data(., PerRegio/Nederland/Gedekt_ref, PerRegio/Kust/Gedekt_ref, PerRegio/Rivieren/Gedekt_ref, PerRegio/Veen/Gedekt_ref, PerRegio/Zand/Gedekt_ref);
					attribute<Float32> Dekkingsgraad_ref            := union_data(., PerRegio/Nederland/Dekkingsgraad_ref, PerRegio/Kust/Dekkingsgraad_ref, PerRegio/Rivieren/Dekkingsgraad_ref, PerRegio/Veen/Dekkingsgraad_ref, PerRegio/Zand/Dekkingsgraad_ref);
					attribute<Float32> Aanbod                       := union_data(., PerRegio/Nederland/Aanbod, PerRegio/Kust/Aanbod, PerRegio/Rivieren/Aanbod, PerRegio/Veen/Aanbod, PerRegio/Zand/Aanbod);
					attribute<Float32> Opgave_alt                   := union_data(., PerRegio/Nederland/Opgave_alt, PerRegio/Kust/Opgave_alt, PerRegio/Rivieren/Opgave_alt, PerRegio/Veen/Opgave_alt, PerRegio/Zand/Opgave_alt);
					attribute<Float32> Gedekt_alt                   := union_data(., PerRegio/Nederland/Gedekt_alt, PerRegio/Kust/Gedekt_alt, PerRegio/Rivieren/Gedekt_alt, PerRegio/Veen/Gedekt_alt, PerRegio/Zand/Gedekt_alt);
					attribute<Float32> Ongedekt_alt                 := union_data(., PerRegio/Nederland/Ongedekt_alt, PerRegio/Kust/Ongedekt_alt, PerRegio/Rivieren/Ongedekt_alt, PerRegio/Veen/Ongedekt_alt, PerRegio/Zand/Ongedekt_alt);
					attribute<Float32> Dekkingsgraad_alt            := union_data(., PerRegio/Nederland/Dekkingsgraad_alt, PerRegio/Kust/Dekkingsgraad_alt, PerRegio/Rivieren/Dekkingsgraad_alt, PerRegio/Veen/Dekkingsgraad_alt, PerRegio/Zand/Dekkingsgraad_alt);
					attribute<Float32> Dekkingsgraad_alt_Ongeklemd  := union_data(., PerRegio/Nederland/Dekkingsgraad_alt_Ongeklemd, PerRegio/Kust/Dekkingsgraad_alt_Ongeklemd, PerRegio/Rivieren/Dekkingsgraad_alt_Ongeklemd, PerRegio/Veen/Dekkingsgraad_alt_Ongeklemd, PerRegio/Zand/Dekkingsgraad_alt_Ongeklemd);
				}
			}

			unit<uint32> RijenBron := combine(Casus, Regio)
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/PiekbuiT100.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: de piekbuiberging van 2120 bij de bui van de levering (_ref) en bij de bui van eens per 100 jaar (_alt), in m3 en als dekkingsgraad."
			{
				attribute<String>  Variant                     := RijenBron/CasusNaam;
				attribute<String>  Gebied                      := RijenBron/RegioNaam;
				attribute<Float32> Opgave_ref                  := union_data(., PerCasus/BAU1/Tabel/Opgave_ref, PerCasus/BAU2/Tabel/Opgave_ref, PerCasus/NbSGenuanceerder/Tabel/Opgave_ref);
				attribute<Float32> Gedekt_ref                  := union_data(., PerCasus/BAU1/Tabel/Gedekt_ref, PerCasus/BAU2/Tabel/Gedekt_ref, PerCasus/NbSGenuanceerder/Tabel/Gedekt_ref);
				attribute<Float32> Dekkingsgraad_ref           := union_data(., PerCasus/BAU1/Tabel/Dekkingsgraad_ref, PerCasus/BAU2/Tabel/Dekkingsgraad_ref, PerCasus/NbSGenuanceerder/Tabel/Dekkingsgraad_ref);
				attribute<Float32> Aanbod                      := union_data(., PerCasus/BAU1/Tabel/Aanbod, PerCasus/BAU2/Tabel/Aanbod, PerCasus/NbSGenuanceerder/Tabel/Aanbod);
				attribute<Float32> Opgave_alt                  := union_data(., PerCasus/BAU1/Tabel/Opgave_alt, PerCasus/BAU2/Tabel/Opgave_alt, PerCasus/NbSGenuanceerder/Tabel/Opgave_alt);
				attribute<Float32> Gedekt_alt                  := union_data(., PerCasus/BAU1/Tabel/Gedekt_alt, PerCasus/BAU2/Tabel/Gedekt_alt, PerCasus/NbSGenuanceerder/Tabel/Gedekt_alt);
				attribute<Float32> Ongedekt_alt                := union_data(., PerCasus/BAU1/Tabel/Ongedekt_alt, PerCasus/BAU2/Tabel/Ongedekt_alt, PerCasus/NbSGenuanceerder/Tabel/Ongedekt_alt);
				attribute<Float32> Dekkingsgraad_alt           := union_data(., PerCasus/BAU1/Tabel/Dekkingsgraad_alt, PerCasus/BAU2/Tabel/Dekkingsgraad_alt, PerCasus/NbSGenuanceerder/Tabel/Dekkingsgraad_alt);
				attribute<Float32> Dekkingsgraad_alt_Ongeklemd := union_data(., PerCasus/BAU1/Tabel/Dekkingsgraad_alt_Ongeklemd, PerCasus/BAU2/Tabel/Dekkingsgraad_alt_Ongeklemd, PerCasus/NbSGenuanceerder/Tabel/Dekkingsgraad_alt_Ongeklemd);
			}
		}

		container LandbouwOpKaart
		: Descr = "De vier landbouwkolommen van de indicatorentabel opnieuw geteld voor 2120, op de landgebruiksadministratie van de stand (Stand/Landgebruik_Type, #751) in plaats van op het subsectorlabel
					Stand/Subsector_rel: de opgelegde natte teelt en het vernatte grasland van de veenbouwstenen dragen geen subsectorlabel, zodat Landbouw_Areaal, Landbouw_NettoOpbrengst en Landbouw_NPV in de
					export dat areaal niet meetellen terwijl de landgebruikskaart en de arealentabellen het wel als landbouw tonen. De klasse per cel komt uit de administratie (LandgebruikType naar LandbouwType
					naar LandbouwKlasses), met daarop het saldo en de NPV van dezelfde geschiktheidskaarten als de export (Suitability/Y2120/Landbouw/per_LandbouwKlasse/<klasse>/NetRevenue en /NPV). Ter
					controle staat het areaal op het label ernaast (Areaal_Label). Landelijk en per landschapsgebied van #760. Structureel: het label van de opgelegde landbouw in de stand bewaren, dan komt dit
					uit RegionaleIndicatoren_T."
		{
			unit<uint8> Casus : NrOfRows = 3
			{
				attribute<String> name    : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
				attribute<String> Map     : ['WLO_hoog_BAU', 'WLO_hoog_BAU2', 'WLO_hoog_NbSGenuanceerder'];
				attribute<String> Variant : ['BAU', 'BAU2', 'NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760 (Landschapsgebieden/Impl)."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container Masker
			{
				attribute<Bool> Nederland (/Geography/AdminDomain) := const(TRUE, /Geography/AdminDomain);
				attribute<Bool> Kust      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsKust;
				attribute<Bool> Rivieren  (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren;
				attribute<Bool> Veen      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen;
				attribute<Bool> Zand      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsZand;
			}

			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/Map) + ', ' + quote(Casus/Variant) + ')');
			template Casus_T
			{
				parameter<String> Map;
				parameter<String> Variant;
				container                                                Z                := ='/Indicatoren/' + Map + '/Zichtjaren/Y2120';
				container                                                Suit             := ='/VariantData/' + Variant + '/Suitability/Y2120/Landbouw/per_LandbouwKlasse';
				attribute</Classifications/Grondgebruik/LandgebruikType> Type             (/Geography/AdminDomain) := Z/Stand/Landgebruik_Type;
				attribute</Classifications/Grondgebruik/LandbouwType>    LT               (/Geography/AdminDomain) := /Classifications/Grondgebruik/LandgebruikType/LandbouwType_rel[Type];
				attribute</Classifications/Actor/LandbouwKlasses>        LK               (/Geography/AdminDomain) := /Classifications/Grondgebruik/LandbouwType/LandbouwK_rel[LT], Descr = "De landbouwklasse per cel uit de administratie; null waar geen landbouw staat.";
				attribute</Classifications/Actor/LandbouwKlasses>        LKLabel          (/Geography/AdminDomain) := /Classifications/Actor/Sector/xSubsector/LandbouwK_rel[Z/Stand/Subsector_rel], Descr = "De klasse van het subsectorlabel, zoals de export hem leest; null waar het label ontbreekt of geen landbouw is.";
				attribute</Classifications/Actor/LandbouwKlasses>        LK2              (/Geography/AdminDomain) := MakeDefined(LKLabel, LK), Descr = "Het label waar het er is, anders de administratie: de gealloceerde landbouw houdt precies de klasse en het saldo van de export, en de labelloze cellen (opgelegde natte teelt, vernat grasland, krimpmarge) krijgen de klasse van hun administratietype.";
				attribute<Bool>                                          IsLandbouwKaart  (/Geography/AdminDomain) := IsDefined(LK) && /Geography/AdminDomain/IsCompactedDomain && (IsNull(Z/Stand/Subsector_rel) || /Classifications/Actor/Sector/xSubsector/IsLandbouw[Z/Stand/Subsector_rel]), Descr = "Landbouw volgens de administratie, behalve waar de stand wonen, werken of een andere sector heeft gezet: die cel houdt haar gewas in de administratie maar is geen landbouw meer, zoals de landgebruikskaart het ook doet. Een cel zonder label met een landbouwtype is de opgelegde natte teelt of het vernatte grasland.";
				attribute<Bool>                                          IsLandbouwLabel  (/Geography/AdminDomain) := /Classifications/Actor/Sector/xSubsector/IsLandbouw[Z/Stand/Subsector_rel] && /Geography/AdminDomain/IsCompactedDomain;
				attribute<Bool>                                          IsNatteTeelt     (/Geography/AdminDomain) := IsLandbouwKaart && lowercase(/Classifications/Grondgebruik/LandbouwType/name[LT]) == 'riet_paludicultuur';
				attribute<Bool>                                          IsVernatGrasland (/Geography/AdminDomain) := IsLandbouwKaart && (lowercase(/Classifications/Grondgebruik/LandbouwType/name[LT]) == 'grasland_vernat' || lowercase(/Classifications/Grondgebruik/LandbouwType/name[LT]) == 'grasland_vernat_kruidenrijk');

				container Saldo := for_each_nedv(/Classifications/Actor/LandbouwKlasses/Actief/name, 'LK2 == /Classifications/Actor/LandbouwKlasses/V/' + /Classifications/Actor/LandbouwKlasses/Actief/name + ' ? Suit/' + /Classifications/Actor/LandbouwKlasses/Actief/name + '/NetRevenue * 1[Units/jaar] : 0[Units/Eur_m2]', /Geography/AdminDomain, Units/Eur_m2)
				, Descr = "Het saldo van een jaar per klasse op de cellen die de administratie aan die klasse toekent, zoals Zichtjaar_NettoOpbrengsten_perLandbouwK in Export.dms maar dan op de kaart."
				{
					attribute<Units/Eur_m2> Totaal (/Geography/AdminDomain) := ='add(' + AsItemList(/Classifications/Actor/LandbouwKlasses/Actief/name) + ')';
				}
				container NPV := for_each_nedv(/Classifications/Actor/LandbouwKlasses/Actief/name, 'LK2 == /Classifications/Actor/LandbouwKlasses/V/' + /Classifications/Actor/LandbouwKlasses/Actief/name + ' ? Suit/' + /Classifications/Actor/LandbouwKlasses/Actief/name + '/NPV : 0[Units/Eur_m2]', /Geography/AdminDomain, Units/Eur_m2)
				{
					attribute<Units/Eur_m2> Totaal (/Geography/AdminDomain) := ='add(' + AsItemList(/Classifications/Actor/LandbouwKlasses/Actief/name) + ')';
				}
				attribute<Float32> SaldoCel (/Geography/AdminDomain) := Saldo/Totaal[Float32] * /Geography/AdminDomain/NrMeter2PerCell, Descr = "Euro per cel per jaar.";
				attribute<Float32> NPVCel   (/Geography/AdminDomain) := NPV/Totaal[Float32]   * /Geography/AdminDomain/NrMeter2PerCell, Descr = "Euro per cel.";

				container PerRegio := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ', Masker/' + Regio/name + ')');
				template Regio_T
				{
					parameter<String> RegioNaam;
					attribute<Bool>   IsRegio (/Geography/AdminDomain);
					attribute<Float32> Zeef                       (/Geography/AdminDomain) := IsRegio ? 1f : null_f;
					parameter<Float32> Areaal_Kaart               := sum((IsLandbouwKaart ? /Geography/AdminDomain/NrHaPerCell[Float32] : 0f) * Zeef);
					parameter<Float32> Areaal_Label               := sum((IsLandbouwLabel ? /Geography/AdminDomain/NrHaPerCell[Float32] : 0f) * Zeef);
					parameter<Float32> Areaal_NatteTeelt          := sum((IsNatteTeelt ? /Geography/AdminDomain/NrHaPerCell[Float32] : 0f) * Zeef);
					parameter<Float32> Areaal_VernatGrasland      := sum((IsVernatGrasland ? /Geography/AdminDomain/NrHaPerCell[Float32] : 0f) * Zeef);
					parameter<Float32> NettoOpbrengst_Kaart       := sum((IsLandbouwKaart ? SaldoCel : 0f) * Zeef);
					parameter<Float32> NPV_Kaart                  := sum((IsLandbouwKaart ? NPVCel : 0f) * Zeef);
					parameter<Float32> NettoOpbrengst_Kaart_perHa := NettoOpbrengst_Kaart / Areaal_Kaart;
					parameter<Float32> NPV_Kaart_perHa            := NPV_Kaart / Areaal_Kaart;
				}
				unit<uint8> Tabel := Regio
				{
					attribute<Float32> Areaal_Kaart                := union_data(., PerRegio/Nederland/Areaal_Kaart, PerRegio/Kust/Areaal_Kaart, PerRegio/Rivieren/Areaal_Kaart, PerRegio/Veen/Areaal_Kaart, PerRegio/Zand/Areaal_Kaart);
					attribute<Float32> Areaal_Label                := union_data(., PerRegio/Nederland/Areaal_Label, PerRegio/Kust/Areaal_Label, PerRegio/Rivieren/Areaal_Label, PerRegio/Veen/Areaal_Label, PerRegio/Zand/Areaal_Label);
					attribute<Float32> Areaal_NatteTeelt           := union_data(., PerRegio/Nederland/Areaal_NatteTeelt, PerRegio/Kust/Areaal_NatteTeelt, PerRegio/Rivieren/Areaal_NatteTeelt, PerRegio/Veen/Areaal_NatteTeelt, PerRegio/Zand/Areaal_NatteTeelt);
					attribute<Float32> Areaal_VernatGrasland       := union_data(., PerRegio/Nederland/Areaal_VernatGrasland, PerRegio/Kust/Areaal_VernatGrasland, PerRegio/Rivieren/Areaal_VernatGrasland, PerRegio/Veen/Areaal_VernatGrasland, PerRegio/Zand/Areaal_VernatGrasland);
					attribute<Float32> NettoOpbrengst_Kaart        := union_data(., PerRegio/Nederland/NettoOpbrengst_Kaart, PerRegio/Kust/NettoOpbrengst_Kaart, PerRegio/Rivieren/NettoOpbrengst_Kaart, PerRegio/Veen/NettoOpbrengst_Kaart, PerRegio/Zand/NettoOpbrengst_Kaart);
					attribute<Float32> NPV_Kaart                   := union_data(., PerRegio/Nederland/NPV_Kaart, PerRegio/Kust/NPV_Kaart, PerRegio/Rivieren/NPV_Kaart, PerRegio/Veen/NPV_Kaart, PerRegio/Zand/NPV_Kaart);
					attribute<Float32> NettoOpbrengst_Kaart_perHa  := union_data(., PerRegio/Nederland/NettoOpbrengst_Kaart_perHa, PerRegio/Kust/NettoOpbrengst_Kaart_perHa, PerRegio/Rivieren/NettoOpbrengst_Kaart_perHa, PerRegio/Veen/NettoOpbrengst_Kaart_perHa, PerRegio/Zand/NettoOpbrengst_Kaart_perHa);
					attribute<Float32> NPV_Kaart_perHa             := union_data(., PerRegio/Nederland/NPV_Kaart_perHa, PerRegio/Kust/NPV_Kaart_perHa, PerRegio/Rivieren/NPV_Kaart_perHa, PerRegio/Veen/NPV_Kaart_perHa, PerRegio/Zand/NPV_Kaart_perHa);
				}
			}

			unit<uint32> RijenBron := combine(Casus, Regio)
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/LandbouwOpKaart.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: areaal, saldo per jaar en NPV van de landbouw in 2120 op de landgebruiksadministratie, met het areaal op het label ter controle."
			{
				attribute<String>  Variant                    := RijenBron/CasusNaam;
				attribute<String>  Gebied                     := RijenBron/RegioNaam;
				attribute<Float32> Areaal_Kaart               := union_data(., PerCasus/BAU1/Tabel/Areaal_Kaart, PerCasus/BAU2/Tabel/Areaal_Kaart, PerCasus/NbSGenuanceerder/Tabel/Areaal_Kaart);
				attribute<Float32> Areaal_Label               := union_data(., PerCasus/BAU1/Tabel/Areaal_Label, PerCasus/BAU2/Tabel/Areaal_Label, PerCasus/NbSGenuanceerder/Tabel/Areaal_Label);
				attribute<Float32> Areaal_NatteTeelt          := union_data(., PerCasus/BAU1/Tabel/Areaal_NatteTeelt, PerCasus/BAU2/Tabel/Areaal_NatteTeelt, PerCasus/NbSGenuanceerder/Tabel/Areaal_NatteTeelt);
				attribute<Float32> Areaal_VernatGrasland      := union_data(., PerCasus/BAU1/Tabel/Areaal_VernatGrasland, PerCasus/BAU2/Tabel/Areaal_VernatGrasland, PerCasus/NbSGenuanceerder/Tabel/Areaal_VernatGrasland);
				attribute<Float32> NettoOpbrengst_Kaart       := union_data(., PerCasus/BAU1/Tabel/NettoOpbrengst_Kaart, PerCasus/BAU2/Tabel/NettoOpbrengst_Kaart, PerCasus/NbSGenuanceerder/Tabel/NettoOpbrengst_Kaart);
				attribute<Float32> NPV_Kaart                  := union_data(., PerCasus/BAU1/Tabel/NPV_Kaart, PerCasus/BAU2/Tabel/NPV_Kaart, PerCasus/NbSGenuanceerder/Tabel/NPV_Kaart);
				attribute<Float32> NettoOpbrengst_Kaart_perHa := union_data(., PerCasus/BAU1/Tabel/NettoOpbrengst_Kaart_perHa, PerCasus/BAU2/Tabel/NettoOpbrengst_Kaart_perHa, PerCasus/NbSGenuanceerder/Tabel/NettoOpbrengst_Kaart_perHa);
				attribute<Float32> NPV_Kaart_perHa            := union_data(., PerCasus/BAU1/Tabel/NPV_Kaart_perHa, PerCasus/BAU2/Tabel/NPV_Kaart_perHa, PerCasus/NbSGenuanceerder/Tabel/NPV_Kaart_perHa);
			}
		}

		// Vier uitvoeritems, toegevoegd op 16 september 2026 op verzoek van de eigenaar: de grootheden van CO2eq, NatuurArealen,
		// GrondexploitatiePosten en OphoogkostenWerklocaties die in rapport 1.0 nooit door GeoDMS zijn geschreven, alsnog als csv
		// in Rapport_v01. De twee eerste lezen de geleverde tabellen van de uitlevering van 14 september 2026, de twee laatste de
		// ontkoppelde stand van het zichtjaar; alle vier volgen de rekenregels van de gelijknamige containers onder PerCasus.

		container CO2eq_Uitvoer
		: Descr = "De netto broeikasgasemissie sinds het basisjaar in megaton CO2-equivalent, landelijk en per landschapsgebied van #760, met dezelfde rekenregel als PerCasus/<casus>/CO2eq maar gelezen uit de
					geleverde tabellen (NationaleIndicatoren.csv en Indicatoren_Landschap_<gebied>.csv), zodat GeoDMS de waarden schrijft zonder de indicatorenexport van de casus opnieuw te rekenen. Netto is
					min CO2Flow_TovBasisjaar (ton, negatief is verlies van voorraad) omgerekend naar megaton, plus Methaan_Cumulatief (megaton CO2-equivalent, positief is emissie); Ondergrens telt de ongedekte
					veenoxidatie mee via CO2Flow_TovBasisjaar_InclOngedekt, wat de cfg uitdrukkelijk een ondergrens en niet de indicator noemt (#733). In rapport 1.0 waren deze waarden met dezelfde formule in
					de rapportpijplijn berekend. Structureel: twee kolommen in RegionaleIndicatoren_T naast Methaan_Cumulatief."
		{
			parameter<String> Levering := 'Productierun_20260910', Descr = "De opleveringsmap onder LocalDataDir; de tabellen staan in Oplevering/<variant>/tabellen.";
			unit<uint8> Casus : NrOfRows = 3, Descr = "De drie varianten van het rapport, met de variantmap onder Oplevering."
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760, elk uit zijn eigen geleverde tabel."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/name) + ')');
			template Casus_T
			{
				parameter<String> Map;
				container Bron
				: Descr = "De geleverde tabellen van deze variant. De landschapstabellen dragen een regel voor het gebied en een landelijke regel; rlookup kiest de juiste."
				{
					unit<uint32> Nederland
					: StorageName = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Map + '/tabellen/NationaleIndicatoren.csv'"
					, StorageType = "gdal.vect", StorageReadOnly = "True"
					{
						attribute<String>  Regio_name;
						attribute<String>  CO2Flow_TovBasisjaar;
						attribute<String>  CO2Flow_TovBasisjaar_InclOngedekt;
						attribute<String>  Methaan_Cumulatief;
						attribute<Float32> Flow_ton        := CO2Flow_TovBasisjaar[Float32];
						attribute<Float32> FlowIncl_ton    := CO2Flow_TovBasisjaar_InclOngedekt[Float32];
						attribute<Float32> Methaan_mton    := Methaan_Cumulatief[Float32];
						attribute<Float32> Netto_mton      := Methaan_mton - Flow_ton / 1000000f;
						attribute<Float32> Ondergrens_mton := Methaan_mton - FlowIncl_ton / 1000000f;
						attribute<Float32> Methaan_aandeel := Methaan_mton / Netto_mton;
					}
					unit<uint32> Kust
					: StorageName = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Map + '/tabellen/Indicatoren_Landschap_Kust.csv'"
					, StorageType = "gdal.vect", StorageReadOnly = "True"
					{
						attribute<String>  Regio_name;
						attribute<String>  CO2Flow_TovBasisjaar;
						attribute<String>  CO2Flow_TovBasisjaar_InclOngedekt;
						attribute<String>  Methaan_Cumulatief;
						attribute<Float32> Flow_ton        := CO2Flow_TovBasisjaar[Float32];
						attribute<Float32> FlowIncl_ton    := CO2Flow_TovBasisjaar_InclOngedekt[Float32];
						attribute<Float32> Methaan_mton    := Methaan_Cumulatief[Float32];
						attribute<Float32> Netto_mton      := Methaan_mton - Flow_ton / 1000000f;
						attribute<Float32> Ondergrens_mton := Methaan_mton - FlowIncl_ton / 1000000f;
						attribute<Float32> Methaan_aandeel := Methaan_mton / Netto_mton;
					}
					unit<uint32> Rivieren
					: StorageName = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Map + '/tabellen/Indicatoren_Landschap_Rivieren.csv'"
					, StorageType = "gdal.vect", StorageReadOnly = "True"
					{
						attribute<String>  Regio_name;
						attribute<String>  CO2Flow_TovBasisjaar;
						attribute<String>  CO2Flow_TovBasisjaar_InclOngedekt;
						attribute<String>  Methaan_Cumulatief;
						attribute<Float32> Flow_ton        := CO2Flow_TovBasisjaar[Float32];
						attribute<Float32> FlowIncl_ton    := CO2Flow_TovBasisjaar_InclOngedekt[Float32];
						attribute<Float32> Methaan_mton    := Methaan_Cumulatief[Float32];
						attribute<Float32> Netto_mton      := Methaan_mton - Flow_ton / 1000000f;
						attribute<Float32> Ondergrens_mton := Methaan_mton - FlowIncl_ton / 1000000f;
						attribute<Float32> Methaan_aandeel := Methaan_mton / Netto_mton;
					}
					unit<uint32> Veen
					: StorageName = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Map + '/tabellen/Indicatoren_Landschap_Veen.csv'"
					, StorageType = "gdal.vect", StorageReadOnly = "True"
					{
						attribute<String>  Regio_name;
						attribute<String>  CO2Flow_TovBasisjaar;
						attribute<String>  CO2Flow_TovBasisjaar_InclOngedekt;
						attribute<String>  Methaan_Cumulatief;
						attribute<Float32> Flow_ton        := CO2Flow_TovBasisjaar[Float32];
						attribute<Float32> FlowIncl_ton    := CO2Flow_TovBasisjaar_InclOngedekt[Float32];
						attribute<Float32> Methaan_mton    := Methaan_Cumulatief[Float32];
						attribute<Float32> Netto_mton      := Methaan_mton - Flow_ton / 1000000f;
						attribute<Float32> Ondergrens_mton := Methaan_mton - FlowIncl_ton / 1000000f;
						attribute<Float32> Methaan_aandeel := Methaan_mton / Netto_mton;
					}
					unit<uint32> Zand
					: StorageName = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Map + '/tabellen/Indicatoren_Landschap_Zand.csv'"
					, StorageType = "gdal.vect", StorageReadOnly = "True"
					{
						attribute<String>  Regio_name;
						attribute<String>  CO2Flow_TovBasisjaar;
						attribute<String>  CO2Flow_TovBasisjaar_InclOngedekt;
						attribute<String>  Methaan_Cumulatief;
						attribute<Float32> Flow_ton        := CO2Flow_TovBasisjaar[Float32];
						attribute<Float32> FlowIncl_ton    := CO2Flow_TovBasisjaar_InclOngedekt[Float32];
						attribute<Float32> Methaan_mton    := Methaan_Cumulatief[Float32];
						attribute<Float32> Netto_mton      := Methaan_mton - Flow_ton / 1000000f;
						attribute<Float32> Ondergrens_mton := Methaan_mton - FlowIncl_ton / 1000000f;
						attribute<Float32> Methaan_aandeel := Methaan_mton / Netto_mton;
					}
				}
				parameter<Bron/Nederland> Rij_Nederland := rlookup('Nederland', Bron/Nederland/Regio_name), Descr = "De regel van het gebied in zijn tabel.";
				parameter<Bron/Kust>      Rij_Kust      := rlookup('Kust',      Bron/Kust/Regio_name);
				parameter<Bron/Rivieren>  Rij_Rivieren  := rlookup('Rivieren',  Bron/Rivieren/Regio_name);
				parameter<Bron/Veen>      Rij_Veen      := rlookup('Veen',      Bron/Veen/Regio_name);
				parameter<Bron/Zand>      Rij_Zand      := rlookup('Zand',      Bron/Zand/Regio_name);
				unit<uint8>               Tabel         := Regio, Descr = "De vijf gebieden van deze variant als tabel, zonder meta-expressies, zodat Rijen ze kan stapelen."
				{
					attribute<Float32> CO2Flow_TovBasisjaar_ton              := union_data(., Bron/Nederland/Flow_ton[Rij_Nederland],        Bron/Kust/Flow_ton[Rij_Kust],        Bron/Rivieren/Flow_ton[Rij_Rivieren],        Bron/Veen/Flow_ton[Rij_Veen],        Bron/Zand/Flow_ton[Rij_Zand]);
					attribute<Float32> CO2Flow_TovBasisjaar_InclOngedekt_ton := union_data(., Bron/Nederland/FlowIncl_ton[Rij_Nederland],    Bron/Kust/FlowIncl_ton[Rij_Kust],    Bron/Rivieren/FlowIncl_ton[Rij_Rivieren],    Bron/Veen/FlowIncl_ton[Rij_Veen],    Bron/Zand/FlowIncl_ton[Rij_Zand]);
					attribute<Float32> Methaan_Cumulatief_mton               := union_data(., Bron/Nederland/Methaan_mton[Rij_Nederland],    Bron/Kust/Methaan_mton[Rij_Kust],    Bron/Rivieren/Methaan_mton[Rij_Rivieren],    Bron/Veen/Methaan_mton[Rij_Veen],    Bron/Zand/Methaan_mton[Rij_Zand]);
					attribute<Float32> Netto_mton                            := union_data(., Bron/Nederland/Netto_mton[Rij_Nederland],      Bron/Kust/Netto_mton[Rij_Kust],      Bron/Rivieren/Netto_mton[Rij_Rivieren],      Bron/Veen/Netto_mton[Rij_Veen],      Bron/Zand/Netto_mton[Rij_Zand]);
					attribute<Float32> Ondergrens_mton                       := union_data(., Bron/Nederland/Ondergrens_mton[Rij_Nederland], Bron/Kust/Ondergrens_mton[Rij_Kust], Bron/Rivieren/Ondergrens_mton[Rij_Rivieren], Bron/Veen/Ondergrens_mton[Rij_Veen], Bron/Zand/Ondergrens_mton[Rij_Zand]);
					attribute<Float32> Methaan_aandeel                       := union_data(., Bron/Nederland/Methaan_aandeel[Rij_Nederland], Bron/Kust/Methaan_aandeel[Rij_Kust], Bron/Rivieren/Methaan_aandeel[Rij_Rivieren], Bron/Veen/Methaan_aandeel[Rij_Veen], Bron/Zand/Methaan_aandeel[Rij_Zand]);
				}
			}
			unit<uint32> RijenBron := combine(Casus, Regio)
			, Descr = "De regels, los van de weggeschreven unit: een kolom van een unit met StorageName mag niet op een zusterkolom steunen."
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/CO2eq.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: de twee bronkolommen uit de geleverde tabel, de netto emissie, de ondergrens en het methaanaandeel."
			{
				attribute<String>  Variant                               := RijenBron/CasusNaam;
				attribute<String>  Gebied                                := RijenBron/RegioNaam;
				attribute<Float32> CO2Flow_TovBasisjaar_ton              := union_data(., PerCasus/BAU1/Tabel/CO2Flow_TovBasisjaar_ton,              PerCasus/BAU2/Tabel/CO2Flow_TovBasisjaar_ton,              PerCasus/NbSGenuanceerder/Tabel/CO2Flow_TovBasisjaar_ton);
				attribute<Float32> CO2Flow_TovBasisjaar_InclOngedekt_ton := union_data(., PerCasus/BAU1/Tabel/CO2Flow_TovBasisjaar_InclOngedekt_ton, PerCasus/BAU2/Tabel/CO2Flow_TovBasisjaar_InclOngedekt_ton, PerCasus/NbSGenuanceerder/Tabel/CO2Flow_TovBasisjaar_InclOngedekt_ton);
				attribute<Float32> Methaan_Cumulatief_mton               := union_data(., PerCasus/BAU1/Tabel/Methaan_Cumulatief_mton,              PerCasus/BAU2/Tabel/Methaan_Cumulatief_mton,              PerCasus/NbSGenuanceerder/Tabel/Methaan_Cumulatief_mton);
				attribute<Float32> Netto_mton                            := union_data(., PerCasus/BAU1/Tabel/Netto_mton,                           PerCasus/BAU2/Tabel/Netto_mton,                           PerCasus/NbSGenuanceerder/Tabel/Netto_mton);
				attribute<Float32> Ondergrens_mton                       := union_data(., PerCasus/BAU1/Tabel/Ondergrens_mton,                      PerCasus/BAU2/Tabel/Ondergrens_mton,                      PerCasus/NbSGenuanceerder/Tabel/Ondergrens_mton);
				attribute<Float32> Methaan_aandeel                       := union_data(., PerCasus/BAU1/Tabel/Methaan_aandeel,                      PerCasus/BAU2/Tabel/Methaan_aandeel,                      PerCasus/NbSGenuanceerder/Tabel/Methaan_aandeel);
			}
		}

		container NatuurArealen_Uitvoer
		: Descr = "Areaal natte en droge natuur in het zichtjaar, landelijk, per landschapsgebied van #760 en buiten de vier gebieden, met de tweedeling
					uit NatuurNatDroog, gelezen uit de geleverde arealentabel LandgebruikNL2120_Areaal.csv van elke variant. Dezelfde rekenregel als
					PerCasus/<casus>/NatuurArealen, dat op de exportunit van de casus rekent en daarvoor de hele export nodig heeft. De klassen van de tabel
					worden op hun label aan LU_NL2120 gekoppeld; Klassen_gekoppeld telt hoeveel dat er zijn en hoort 165 te zijn. Toegevoegd op 16 september
					2026; in rapport 1.0 was deze tweedeling in de rapportpijplijn op de geleverde tabel toegepast. Sinds #827 staat de tweedeling ook
					structureel op INL_Beheertype (IsNat, IsDroog, NatDroog); wat nog ontbreekt zijn de subtotaalregels in Export/Grondgebruik/LandgebruikNL2120_Areaal."
		{
			parameter<String> Levering := 'Productierun_20260910', Descr = "De opleveringsmap onder LocalDataDir.";
			unit<uint8> Casus : NrOfRows = 3
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 6, Descr = "De kolommen van de arealentabel: landelijk, de vier gebieden van #760 en de rest van Nederland."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand', 'Geen_landschap'];
			}
			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/name) + ')');
			template Casus_T
			{
				parameter<String> Map;
				unit<uint32> Bron
				: StorageName = "='%LocalDataDir%/' + Levering + '/Oplevering/' + Map + '/tabellen/LandgebruikNL2120_Areaal.csv'"
				, StorageType = "gdal.vect", StorageReadOnly = "True"
				, Descr       = "De geleverde arealentabel van de 165 klassen, een regel per klasse."
				{
					attribute<String>  Klasse;
					attribute<String>  Nederland;
					attribute<String>  Kust;
					attribute<String>  Rivieren;
					attribute<String>  Veen;
					attribute<String>  Zand;
					attribute<String>  Geen_landschap;
					attribute<NatuurNatDroog/LU> LU_rel            := rlookup(Klasse, NatuurNatDroog/LU/Label), Descr = "De klasse van LU_NL2120 met hetzelfde label; null als het label niet voorkomt.";
					attribute<Bool>              IsNat             := NatuurNatDroog/LU_IsNat[LU_rel];
					attribute<Bool>              IsDroog           := NatuurNatDroog/LU_IsDroog[LU_rel];
					attribute<Float32>           Ha_Nederland      := Nederland[Float32];
					attribute<Float32>           Ha_Kust           := Kust[Float32];
					attribute<Float32>           Ha_Rivieren       := Rivieren[Float32];
					attribute<Float32>           Ha_Veen           := Veen[Float32];
					attribute<Float32>           Ha_Zand           := Zand[Float32];
					attribute<Float32>           Ha_Geen_landschap := Geen_landschap[Float32];
				}
				parameter<uint32>  NKlassen             := sum(uint32(IsDefined(Bron/LU_rel))), Descr = "Aantal klassen van de tabel dat aan LU_NL2120 is gekoppeld; hoort 165 te zijn.";
				parameter<Float32> Nat_Nederland        := sum(Bron/IsNat   ? Bron/Ha_Nederland      : 0f);
				parameter<Float32> Droog_Nederland      := sum(Bron/IsDroog ? Bron/Ha_Nederland      : 0f);
				parameter<Float32> Nat_Kust             := sum(Bron/IsNat   ? Bron/Ha_Kust           : 0f);
				parameter<Float32> Droog_Kust           := sum(Bron/IsDroog ? Bron/Ha_Kust           : 0f);
				parameter<Float32> Nat_Rivieren         := sum(Bron/IsNat   ? Bron/Ha_Rivieren       : 0f);
				parameter<Float32> Droog_Rivieren       := sum(Bron/IsDroog ? Bron/Ha_Rivieren       : 0f);
				parameter<Float32> Nat_Veen             := sum(Bron/IsNat   ? Bron/Ha_Veen           : 0f);
				parameter<Float32> Droog_Veen           := sum(Bron/IsDroog ? Bron/Ha_Veen           : 0f);
				parameter<Float32> Nat_Zand             := sum(Bron/IsNat   ? Bron/Ha_Zand           : 0f);
				parameter<Float32> Droog_Zand           := sum(Bron/IsDroog ? Bron/Ha_Zand           : 0f);
				parameter<Float32> Nat_Geen_landschap   := sum(Bron/IsNat   ? Bron/Ha_Geen_landschap : 0f);
				parameter<Float32> Droog_Geen_landschap := sum(Bron/IsDroog ? Bron/Ha_Geen_landschap : 0f);
				unit<uint8>        Tabel                := Regio, Descr = "De zes kolommen van deze variant als tabel, zonder meta-expressies, zodat Rijen ze kan stapelen."
				{
					attribute<Float32> Nat_ha            := union_data(., Nat_Nederland,   Nat_Kust,   Nat_Rivieren,   Nat_Veen,   Nat_Zand,   Nat_Geen_landschap);
					attribute<Float32> Droog_ha          := union_data(., Droog_Nederland, Droog_Kust, Droog_Rivieren, Droog_Veen, Droog_Zand, Droog_Geen_landschap);
					attribute<Float32> Natuur_ha         := Nat_ha + Droog_ha;
					attribute<uint32>  Klassen_gekoppeld := const(NKlassen, .);
				}
			}
			unit<uint32> RijenBron := combine(Casus, Regio)
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/NatuurArealen.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: areaal natte natuur, droge natuur en hun som in hectare, en het aantal gekoppelde klassen ter controle."
			{
				attribute<String>  Variant           := RijenBron/CasusNaam;
				attribute<String>  Gebied            := RijenBron/RegioNaam;
				attribute<Float32> Nat_ha            := union_data(., PerCasus/BAU1/Tabel/Nat_ha,            PerCasus/BAU2/Tabel/Nat_ha,            PerCasus/NbSGenuanceerder/Tabel/Nat_ha);
				attribute<Float32> Droog_ha          := union_data(., PerCasus/BAU1/Tabel/Droog_ha,          PerCasus/BAU2/Tabel/Droog_ha,          PerCasus/NbSGenuanceerder/Tabel/Droog_ha);
				attribute<Float32> Natuur_ha         := union_data(., PerCasus/BAU1/Tabel/Natuur_ha,         PerCasus/BAU2/Tabel/Natuur_ha,         PerCasus/NbSGenuanceerder/Tabel/Natuur_ha);
				attribute<uint32>  Klassen_gekoppeld := union_data(., PerCasus/BAU1/Tabel/Klassen_gekoppeld, PerCasus/BAU2/Tabel/Klassen_gekoppeld, PerCasus/NbSGenuanceerder/Tabel/Klassen_gekoppeld);
			}
		}

		container GrondexploitatiePosten_Uitvoer
		: Descr = "De negen posten van het exploitatiesaldo van de woningbouw, landelijk en per landschapsgebied van #760, opgeteld over de cellen waarover het saldo is geboekt (Grondexploitatie/IsNieuwbouw:
					netto woningen erbij sinds het basisjaar met een pakket dat het model zelf heeft gealloceerd, dus zonder de BAG-nieuwbouw van #550), met dezelfde definities als Grondexploitatie/Posten in
					Templates/Indicatoren.dms; zie PerCasus/<casus>/GrondexploitatiePosten voor de reden en de structurele plek. Saldo_uit_posten is opbrengsten min de acht kostenposten en hoort gelijk te zijn
					aan Grondexploitatie_Saldo in de geleverde tabel; Nieuwbouw_ha is de voet waarover het saldo is geboekt. De drie posten die uit KostenWoningbouw komen (bouwsom, grondproductie, bodemdaling)
					worden gelezen uit de kaarten die de productierun daarvan heeft geschreven, zodat dit item die kaarten niet opnieuw schrijft; de bijkomende kosten en winst en risico zijn daaruit afgeleid
					met dezelfde factoren als in Grondexploitatie/Posten. Diezelfde drie posten staan er ook opgeteld over alle cellen (kolommen _alle): dat zijn de geleverde kolommen
					KostenWoningbouw_Bouwkosten, _Regulier en _MeerkostenBodemdaling, en het verschil met de posten is de BAG-nieuwbouw, waarover geen saldo is geboekt; daarom tellen die geleverde kolommen niet
					op tot Grondexploitatie_Saldo, ook niet samen met de andere posten. Het item raakt Grondexploitatie/Saldo zelf niet. Draaien op de productiekopie, omdat de stand daar staat."
		{
			parameter<String> Levering := 'Productierun_20260910', Descr = "De opleveringsmap onder LocalDataDir; de kaarten van de run staan in Indicatoren/<casus>.";
			unit<uint8> Casus : NrOfRows = 3
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
				attribute<String> Map  : ['WLO_hoog_BAU', 'WLO_hoog_BAU2', 'WLO_hoog_NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760 (Landschapsgebieden/Impl)."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container Masker
			{
				attribute<Bool> Nederland (/Geography/AdminDomain) := const(TRUE, /Geography/AdminDomain);
				attribute<Bool> Kust      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsKust;
				attribute<Bool> Rivieren  (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren;
				attribute<Bool> Veen      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen;
				attribute<Bool> Zand      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsZand;
			}
			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/Map) + ')');
			template Casus_T
			{
				parameter<String> Map;
				parameter<String> Jaar := ='/Indicatoren/' + Map + '/Zichtjaren/Export/ExportZichtjaar', Descr = "Het exportzichtjaar van de casus, zodat dit item met de omgevingsvariabele ExportZichtjaar meebeweegt.";
				container         Bron := ='/Indicatoren/' + Map + '/Zichtjaren/' + Jaar + '/Grondexploitatie';
				container Kaart
				: Descr = "De drie kostenkaarten van KostenWoningbouw zoals de productierun ze in Indicatoren/<casus> heeft geschreven, alleen gelezen."
				{
					attribute<Units/Eur> Bouwsom (/Geography/AdminDomain)
					: StorageName = "='%LocalDataDir%/' + Levering + '/Indicatoren/' + Map + '/KostenWoningbouw_Bouwkosten_' + Jaar + '_Eur_Nederland.tif'"
					, StorageType = "gdal.grid", StorageReadOnly = "True";
					attribute<Units/Eur> Grondproductie (/Geography/AdminDomain)
					: StorageName = "='%LocalDataDir%/' + Levering + '/Indicatoren/' + Map + '/KostenWoningbouw_Regulier_' + Jaar + '_Eur_Nederland.tif'"
					, StorageType = "gdal.grid", StorageReadOnly = "True";
					attribute<Units/Eur> Bodemdaling (/Geography/AdminDomain)
					: StorageName = "='%LocalDataDir%/' + Levering + '/Indicatoren/' + Map + '/KostenWoningbouw_MeerkostenBodemdaling_' + Jaar + '_Eur_Nederland.tif'"
					, StorageType = "gdal.grid", StorageReadOnly = "True";
				}
				attribute<Bool>      IsNieuwbouw          (/Geography/AdminDomain) := Bron/IsNieuwbouw, Descr = "De cellen waarover het saldo is geboekt.";
				attribute<Units/Eur> Bouwsom_cel          (/Geography/AdminDomain) := MakeDefined(Kaart/Bouwsom, 0[Units/Eur]);
				attribute<Units/Eur> BijkomendeKosten_cel (/Geography/AdminDomain) := Bouwsom_cel * /ModelParameters/Wonen/Exploitatieposten/BijkomendeKostenOpslag;
				attribute<Units/Eur> WinstEnRisico_cel    (/Geography/AdminDomain) := (Bouwsom_cel + BijkomendeKosten_cel) * /ModelParameters/Wonen/Exploitatieposten/WinstEnRisicoFractie;
				attribute<Units/Eur> Grondproductie_cel   (/Geography/AdminDomain) := MakeDefined(Kaart/Grondproductie, 0[Units/Eur]);
				attribute<Units/Eur> Bodemdaling_cel      (/Geography/AdminDomain) := MakeDefined(Kaart/Bodemdaling, 0[Units/Eur]);
				container            PerRegio             := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ', Masker/' + Regio/name + ')');
				template Regio_T
				{
					parameter<String> RegioNaam;
					attribute<Bool>   IsRegio (/Geography/AdminDomain);
					attribute<Bool>      Telt                (/Geography/AdminDomain) := IsRegio && IsNieuwbouw, Descr = "In het gebied en met een geboekt saldo.";
					parameter<Units/Eur> Opbrengsten         := sum(Telt ? Bron/Posten/Opbrengsten    : 0[Units/Eur]);
					parameter<Units/Eur> Bouwsom             := sum(Telt ? Bouwsom_cel                : 0[Units/Eur]);
					parameter<Units/Eur> BijkomendeKosten    := sum(Telt ? BijkomendeKosten_cel       : 0[Units/Eur]);
					parameter<Units/Eur> WinstEnRisico       := sum(Telt ? WinstEnRisico_cel          : 0[Units/Eur]);
					parameter<Units/Eur> Grondproductie      := sum(Telt ? Grondproductie_cel         : 0[Units/Eur]);
					parameter<Units/Eur> Bodemdaling         := sum(Telt ? Bodemdaling_cel            : 0[Units/Eur]);
					parameter<Units/Eur> Piekbuiberging      := sum(Telt ? Bron/Posten/Piekbuiberging : 0[Units/Eur]);
					parameter<Units/Eur> Verwerving          := sum(Telt ? Bron/Posten/Verwerving     : 0[Units/Eur]);
					parameter<Units/Eur> Sloop               := sum(Telt ? Bron/Posten/Sloop          : 0[Units/Eur]);
					parameter<Units/Eur> Saldo_uit_posten    := Opbrengsten - Bouwsom - BijkomendeKosten - WinstEnRisico - Grondproductie - Bodemdaling - Piekbuiberging - Verwerving - Sloop;
					parameter<Units/Ha>  Nieuwbouw_ha        := sum(IsRegio ? Bron/Nieuwbouw_Ha : 0[Units/Ha]);
					parameter<Units/Eur> Bouwsom_alle        := sum(IsRegio ? Bouwsom_cel        : 0[Units/Eur]), Descr = "Over alle cellen: de geleverde kolom KostenWoningbouw_Bouwkosten; het verschil met Bouwsom is de BAG-nieuwbouw.";
					parameter<Units/Eur> Grondproductie_alle := sum(IsRegio ? Grondproductie_cel : 0[Units/Eur]), Descr = "Over alle cellen: de geleverde kolom KostenWoningbouw_Regulier.";
					parameter<Units/Eur> Bodemdaling_alle    := sum(IsRegio ? Bodemdaling_cel    : 0[Units/Eur]), Descr = "Over alle cellen: de geleverde kolom KostenWoningbouw_MeerkostenBodemdaling.";
				}
				unit<uint8> Tabel := Regio, Descr = "De vijf gebieden van deze casus als tabel, zonder meta-expressies, zodat Rijen ze kan stapelen."
				{
					attribute<Units/Eur> Opbrengsten         := union_data(., PerRegio/Nederland/Opbrengsten,         PerRegio/Kust/Opbrengsten,         PerRegio/Rivieren/Opbrengsten,         PerRegio/Veen/Opbrengsten,         PerRegio/Zand/Opbrengsten);
					attribute<Units/Eur> Bouwsom             := union_data(., PerRegio/Nederland/Bouwsom,             PerRegio/Kust/Bouwsom,             PerRegio/Rivieren/Bouwsom,             PerRegio/Veen/Bouwsom,             PerRegio/Zand/Bouwsom);
					attribute<Units/Eur> BijkomendeKosten    := union_data(., PerRegio/Nederland/BijkomendeKosten,    PerRegio/Kust/BijkomendeKosten,    PerRegio/Rivieren/BijkomendeKosten,    PerRegio/Veen/BijkomendeKosten,    PerRegio/Zand/BijkomendeKosten);
					attribute<Units/Eur> WinstEnRisico       := union_data(., PerRegio/Nederland/WinstEnRisico,       PerRegio/Kust/WinstEnRisico,       PerRegio/Rivieren/WinstEnRisico,       PerRegio/Veen/WinstEnRisico,       PerRegio/Zand/WinstEnRisico);
					attribute<Units/Eur> Grondproductie      := union_data(., PerRegio/Nederland/Grondproductie,      PerRegio/Kust/Grondproductie,      PerRegio/Rivieren/Grondproductie,      PerRegio/Veen/Grondproductie,      PerRegio/Zand/Grondproductie);
					attribute<Units/Eur> Bodemdaling         := union_data(., PerRegio/Nederland/Bodemdaling,         PerRegio/Kust/Bodemdaling,         PerRegio/Rivieren/Bodemdaling,         PerRegio/Veen/Bodemdaling,         PerRegio/Zand/Bodemdaling);
					attribute<Units/Eur> Piekbuiberging      := union_data(., PerRegio/Nederland/Piekbuiberging,      PerRegio/Kust/Piekbuiberging,      PerRegio/Rivieren/Piekbuiberging,      PerRegio/Veen/Piekbuiberging,      PerRegio/Zand/Piekbuiberging);
					attribute<Units/Eur> Verwerving          := union_data(., PerRegio/Nederland/Verwerving,          PerRegio/Kust/Verwerving,          PerRegio/Rivieren/Verwerving,          PerRegio/Veen/Verwerving,          PerRegio/Zand/Verwerving);
					attribute<Units/Eur> Sloop               := union_data(., PerRegio/Nederland/Sloop,               PerRegio/Kust/Sloop,               PerRegio/Rivieren/Sloop,               PerRegio/Veen/Sloop,               PerRegio/Zand/Sloop);
					attribute<Units/Eur> Saldo_uit_posten    := union_data(., PerRegio/Nederland/Saldo_uit_posten,    PerRegio/Kust/Saldo_uit_posten,    PerRegio/Rivieren/Saldo_uit_posten,    PerRegio/Veen/Saldo_uit_posten,    PerRegio/Zand/Saldo_uit_posten);
					attribute<Units/Ha>  Nieuwbouw_ha        := union_data(., PerRegio/Nederland/Nieuwbouw_ha,        PerRegio/Kust/Nieuwbouw_ha,        PerRegio/Rivieren/Nieuwbouw_ha,        PerRegio/Veen/Nieuwbouw_ha,        PerRegio/Zand/Nieuwbouw_ha);
					attribute<Units/Eur> Bouwsom_alle        := union_data(., PerRegio/Nederland/Bouwsom_alle,        PerRegio/Kust/Bouwsom_alle,        PerRegio/Rivieren/Bouwsom_alle,        PerRegio/Veen/Bouwsom_alle,        PerRegio/Zand/Bouwsom_alle);
					attribute<Units/Eur> Grondproductie_alle := union_data(., PerRegio/Nederland/Grondproductie_alle, PerRegio/Kust/Grondproductie_alle, PerRegio/Rivieren/Grondproductie_alle, PerRegio/Veen/Grondproductie_alle, PerRegio/Zand/Grondproductie_alle);
					attribute<Units/Eur> Bodemdaling_alle    := union_data(., PerRegio/Nederland/Bodemdaling_alle,    PerRegio/Kust/Bodemdaling_alle,    PerRegio/Rivieren/Bodemdaling_alle,    PerRegio/Veen/Bodemdaling_alle,    PerRegio/Zand/Bodemdaling_alle);
				}
			}
			unit<uint32> RijenBron := combine(Casus, Regio)
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/GrondexploitatiePosten.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: de negen posten in euro, nominaal in het zichtjaar, over de cellen met een geboekt saldo; het saldo uit de posten; de hectares van die cellen; en de drie kostenposten over alle cellen ter controle."
			{
				attribute<String>    Variant             := RijenBron/CasusNaam;
				attribute<String>    Gebied              := RijenBron/RegioNaam;
				attribute<Units/Eur> Opbrengsten         := union_data(., PerCasus/BAU1/Tabel/Opbrengsten,         PerCasus/BAU2/Tabel/Opbrengsten,         PerCasus/NbSGenuanceerder/Tabel/Opbrengsten);
				attribute<Units/Eur> Bouwsom             := union_data(., PerCasus/BAU1/Tabel/Bouwsom,             PerCasus/BAU2/Tabel/Bouwsom,             PerCasus/NbSGenuanceerder/Tabel/Bouwsom);
				attribute<Units/Eur> BijkomendeKosten    := union_data(., PerCasus/BAU1/Tabel/BijkomendeKosten,    PerCasus/BAU2/Tabel/BijkomendeKosten,    PerCasus/NbSGenuanceerder/Tabel/BijkomendeKosten);
				attribute<Units/Eur> WinstEnRisico       := union_data(., PerCasus/BAU1/Tabel/WinstEnRisico,       PerCasus/BAU2/Tabel/WinstEnRisico,       PerCasus/NbSGenuanceerder/Tabel/WinstEnRisico);
				attribute<Units/Eur> Grondproductie      := union_data(., PerCasus/BAU1/Tabel/Grondproductie,      PerCasus/BAU2/Tabel/Grondproductie,      PerCasus/NbSGenuanceerder/Tabel/Grondproductie);
				attribute<Units/Eur> Bodemdaling         := union_data(., PerCasus/BAU1/Tabel/Bodemdaling,         PerCasus/BAU2/Tabel/Bodemdaling,         PerCasus/NbSGenuanceerder/Tabel/Bodemdaling);
				attribute<Units/Eur> Piekbuiberging      := union_data(., PerCasus/BAU1/Tabel/Piekbuiberging,      PerCasus/BAU2/Tabel/Piekbuiberging,      PerCasus/NbSGenuanceerder/Tabel/Piekbuiberging);
				attribute<Units/Eur> Verwerving          := union_data(., PerCasus/BAU1/Tabel/Verwerving,          PerCasus/BAU2/Tabel/Verwerving,          PerCasus/NbSGenuanceerder/Tabel/Verwerving);
				attribute<Units/Eur> Sloop               := union_data(., PerCasus/BAU1/Tabel/Sloop,               PerCasus/BAU2/Tabel/Sloop,               PerCasus/NbSGenuanceerder/Tabel/Sloop);
				attribute<Units/Eur> Saldo_uit_posten    := union_data(., PerCasus/BAU1/Tabel/Saldo_uit_posten,    PerCasus/BAU2/Tabel/Saldo_uit_posten,    PerCasus/NbSGenuanceerder/Tabel/Saldo_uit_posten);
				attribute<Units/Ha>  Nieuwbouw_ha        := union_data(., PerCasus/BAU1/Tabel/Nieuwbouw_ha,        PerCasus/BAU2/Tabel/Nieuwbouw_ha,        PerCasus/NbSGenuanceerder/Tabel/Nieuwbouw_ha);
				attribute<Units/Eur> Bouwsom_alle        := union_data(., PerCasus/BAU1/Tabel/Bouwsom_alle,        PerCasus/BAU2/Tabel/Bouwsom_alle,        PerCasus/NbSGenuanceerder/Tabel/Bouwsom_alle);
				attribute<Units/Eur> Grondproductie_alle := union_data(., PerCasus/BAU1/Tabel/Grondproductie_alle, PerCasus/BAU2/Tabel/Grondproductie_alle, PerCasus/NbSGenuanceerder/Tabel/Grondproductie_alle);
				attribute<Units/Eur> Bodemdaling_alle    := union_data(., PerCasus/BAU1/Tabel/Bodemdaling_alle,    PerCasus/BAU2/Tabel/Bodemdaling_alle,    PerCasus/NbSGenuanceerder/Tabel/Bodemdaling_alle);
			}
		}

		container OphoogkostenWerklocaties_Uitvoer
		: Descr = "Wat de bodemdaling aan ophoging kost op de cellen waar de allocatie een werksubsector heeft neergezet, landelijk en per landschapsgebied van #760, uit de stand van het zichtjaar van de
					productierun (ontkoppeld); dezelfde rekenregel als PerCasus/<casus>/OphoogkostenWerklocaties, zie daar voor de reden, de begrenzing (alleen het zandpakket, niet de overige
					inrichtingselementen) en de structurele plek. Ter controle staan de werklocatiehectares en de meerkosten van de overstromingsmaatregel ernaast; die horen gelijk te zijn aan
					KostenWerklocaties_Werklocatie_Ha en KostenWerklocaties_MeerkostenOverstroming in de geleverde tabel. Draaien op de productiekopie."
		{
			unit<uint8> Casus : NrOfRows = 3
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
				attribute<String> Map  : ['WLO_hoog_BAU', 'WLO_hoog_BAU2', 'WLO_hoog_NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container Masker
			{
				attribute<Bool> Nederland (/Geography/AdminDomain) := const(TRUE, /Geography/AdminDomain);
				attribute<Bool> Kust      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsKust;
				attribute<Bool> Rivieren  (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren;
				attribute<Bool> Veen      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen;
				attribute<Bool> Zand      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsZand;
			}
			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/Map) + ')');
			template Casus_T
			{
				parameter<String> Map;
				parameter<String>       Jaar               := ='/Indicatoren/' + Map + '/Zichtjaren/Export/ExportZichtjaar';
				container               Bron               := ='/Indicatoren/' + Map + '/Zichtjaren/' + Jaar + '/KostenWerklocaties';
				attribute<Units/Eur_m2> Tarief_Bodemdaling (/Geography/AdminDomain) := Bron/Src/Kengetallen/Ophogen_permeter * (Bron/Ophoging_ZonderMaatregel / 1[Units/meter]) * Bron/Src/Kengetallen/Opslag
				, Descr = "Het tarief per m2 terrein voor de ophoging die de bodemdaling vraagt, met dezelfde opslag als bij de overstromingsmaatregel.";
				attribute<Units/Eur> Ophoogkosten_cel (/Geography/AdminDomain) := MakeDefined(Tarief_Bodemdaling * Bron/Werklocatie_m2, 0[Units/Eur])
				, Descr = "De rekening per cel, nominaal in het zichtjaar, nul buiten de werklocaties.";
				container PerRegio := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ', Masker/' + Regio/name + ')');
				template Regio_T
				{
					parameter<String> RegioNaam;
					attribute<Bool>   IsRegio (/Geography/AdminDomain);
					parameter<Units/Eur> Ophoogkosten           := sum(IsRegio ? Ophoogkosten_cel            : 0[Units/Eur]);
					parameter<Units/Ha>  Werklocatie_ha         := sum(IsRegio ? Bron/Werklocatie_Ha         : 0[Units/Ha]);
					parameter<Units/Eur> MeerkostenOverstroming := sum(IsRegio ? Bron/MeerkostenOverstroming : 0[Units/Eur]);
				}
				unit<uint8> Tabel := Regio
				{
					attribute<Units/Eur> Ophoogkosten           := union_data(., PerRegio/Nederland/Ophoogkosten,           PerRegio/Kust/Ophoogkosten,           PerRegio/Rivieren/Ophoogkosten,           PerRegio/Veen/Ophoogkosten,           PerRegio/Zand/Ophoogkosten);
					attribute<Units/Ha>  Werklocatie_ha         := union_data(., PerRegio/Nederland/Werklocatie_ha,         PerRegio/Kust/Werklocatie_ha,         PerRegio/Rivieren/Werklocatie_ha,         PerRegio/Veen/Werklocatie_ha,         PerRegio/Zand/Werklocatie_ha);
					attribute<Units/Eur> MeerkostenOverstroming := union_data(., PerRegio/Nederland/MeerkostenOverstroming, PerRegio/Kust/MeerkostenOverstroming, PerRegio/Rivieren/MeerkostenOverstroming, PerRegio/Veen/MeerkostenOverstroming, PerRegio/Zand/MeerkostenOverstroming);
				}
			}
			unit<uint32> RijenBron := combine(Casus, Regio)
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/OphoogkostenWerklocaties.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: de ophoogkosten van de bodemdaling op werklocaties in euro, nominaal, met de werklocatiehectares en de meerkosten van de overstromingsmaatregel ter controle."
			{
				attribute<String>    Variant                := RijenBron/CasusNaam;
				attribute<String>    Gebied                 := RijenBron/RegioNaam;
				attribute<Units/Eur> Ophoogkosten           := union_data(., PerCasus/BAU1/Tabel/Ophoogkosten,           PerCasus/BAU2/Tabel/Ophoogkosten,           PerCasus/NbSGenuanceerder/Tabel/Ophoogkosten);
				attribute<Units/Ha>  Werklocatie_ha         := union_data(., PerCasus/BAU1/Tabel/Werklocatie_ha,         PerCasus/BAU2/Tabel/Werklocatie_ha,         PerCasus/NbSGenuanceerder/Tabel/Werklocatie_ha);
				attribute<Units/Eur> MeerkostenOverstroming := union_data(., PerCasus/BAU1/Tabel/MeerkostenOverstroming, PerCasus/BAU2/Tabel/MeerkostenOverstroming, PerCasus/NbSGenuanceerder/Tabel/MeerkostenOverstroming);
			}
		}

		// Woningvoorraad naar bouwjaar, toegevoegd op 17 september 2026 op verzoek van de eigenaar: de woningen in 2120 en de woningen
		// met een bouwjaar voor 1970, voor BAU1, BAU2 en NbSGenuanceerder. Leest de ontkoppelde stand van het exportzichtjaar, de stand
		// van het basisjaar en de BAG van het basisjaar; schrijft de tabel met controlekolommen in Rapport_v01, en de levering (tabel
		// en kaarten) in de uitleveringsmap.

		container WoningvoorraadBouwjaar
		: Descr = "De woningvoorraad in het exportzichtjaar, en het deel daarvan met een bouwjaar voor 1970, landelijk en per landschapsgebied van #760 (#828). Woningen is de stand van het zichtjaar zoals de
					allocatie hem heeft weggeschreven, Stand/Aantal_Woningen_Totaal, dezelfde grootheid als Wonen_stand in ClaimRealisatie. De stand draagt geen bouwjaar; een woning van voor 1970 kan in het
					zichtjaar alleen een basisjaarwoning zijn, want alles wat de BAG-nieuwbouw en de allocatie erbij zetten is van na 2023. Het item telt daarom per cel welk deel van de basisjaarwoningen er in
					het zichtjaar nog staat en welk deel daarvan van voor 1970 is. Het aandeel van voor 1970 per cel komt uit de BAG van het basisjaar, met dezelfde toedeling van panden over cellen als de
					basisjaarstand (BaseData/Verdeling_VSSH, Uitsmeren_T): per pand de unieke woon-vbo's als het oorspronkelijke bouwjaar van het pand voor BouwjaarGrens ligt, maal ToedelingPand_CAD; woningen
					in een pand zonder bekend bouwjaar en vbo's zonder pand tellen niet als van voor 1970 maar staan wel in de noemer. Op een cel waar het model een ontwikkelpakket heeft gealloceerd is niets
					van het basisjaar over, want de allocatie vervangt daar de hele stand door de dichtheid van het pakket; zo'n cel heeft Stand/OP_rel gevuld en is geen BAG-nieuwbouw volgens
					StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/IsBAGnieuwbouwWonen, dezelfde afbakening als IsOPCel in WaardeNabijheidGroen. Op de overige cellen blijft van de basisjaarwoningen het deel
					over dat de stand van het zichtjaar nog draagt, begrensd op 1, wat de sloop uit VariantData/<variant>/Sloop, de verdringing door een andere sector en de netto sloop in de BAG tussen het
					basisjaar en het recente BAG-jaar vangt; een netto toename door BAG-nieuwbouw laat de basisjaarwoningen staan. Woningen_BouwjaarVoor1970 is per cel de basisjaarstand maal het behouden deel
					maal het aandeel van voor 1970. Twee aannames: een gedeeltelijke afname raakt de woningen van voor en na 1970 naar rato, en waar de BAG op dezelfde cel zowel sloop als nieuwbouw kent en de
					nieuwbouw netto groter is, telt de gesloopte basisjaarvoorraad als behouden. Controlekolommen in Rijen: Woningen_Basisjaar en Woningen_Basisjaar_BouwjaarVoor1970,
					Woningen_Basisjaar_Behouden, Woningen_OpModelpakket, Woningen_Basisjaar_ZonderBouwjaar en Controle_Basisjaar_BAG, de basisjaarwoningen opnieuw geteld uit de BAG, die gelijk hoort te zijn aan
					Woningen_Basisjaar; wijkt hij af, dan komt het aandeel uit een andere BAG dan de stand. De landschapskolommen overlappen elkaar en tellen niet op tot Nederland. Levering schrijft de twee
					grootheden voor het zichtjaar en ter vergelijking voor het basisjaar, en PerCasus/<casus>/Kaarten de twee grootheden van het zichtjaar als kaart van 25 meter, beide in de uitleveringsmap
					Uitlevering onder LocalDataProjDir. Structureel: de woningen als kolom in RegionaleIndicatoren_T, en het bouwjaar als indicator in Templates/Indicatoren.dms met deze rekenregel, bij voorkeur
					naar de bouwjaarklassen van SourceData/Vastgoed; exact wordt het pas met de bouwperiode als dimensie van de woningstand in StateBasisjaar, wat een nieuwe allocatierun vraagt."
		{
			parameter<Units/yr> BouwjaarGrens := 1970[Units/yr], Descr = "Een woning telt als van voor 1970 als het oorspronkelijke bouwjaar van haar pand (BAG, Bouwjaar_trunc) kleiner is dan dit jaar, dus tot en met 1969. Dezelfde grens als in de bouwjaarklassen van SourceData/Vastgoed.";
			parameter<String>   Uitlevering   := 'Uitlevering_20260917_woningen', Descr = "De uitleveringsmap onder LocalDataProjDir waarin Levering en de kaarten van PerCasus/<casus>/Kaarten worden geschreven.";
			parameter<String>   ExportJaar    := ='/Indicatoren/' + first(Casus/Map) + '/Zichtjaren/Export/ExportZichtjaar', Descr = "Het exportzichtjaar voor de bestandsnaam van Levering. Voor de drie casussen gelijk, want het komt uit dezelfde omgevingsvariabele ExportZichtjaar.";
			attribute<Float32>  Studiegebied  (/Geography/AdminDomain) := /Geography/AdminDomain/IsCompactedDomain ? 1f : null_f, Descr = "1 binnen het studiegebied en leeg erbuiten, zodat de kaarten buiten het model geen nul tonen maar geen waarde.";

			unit<uint8> Casus : NrOfRows = 3, Descr = "De drie varianten van het rapport, met de casusnaam."
			{
				attribute<String> name : ['BAU1', 'BAU2', 'NbSGenuanceerder'];
				attribute<String> Map  : ['WLO_hoog_BAU', 'WLO_hoog_BAU2', 'WLO_hoog_NbSGenuanceerder'];
			}
			unit<uint8> Regio : NrOfRows = 5, Descr = "Landelijk en de vier landschapsgebieden van #760 (Landschapsgebieden/Impl)."
			{
				attribute<String> name : ['Nederland', 'Kust', 'Rivieren', 'Veen', 'Zand'];
			}
			container Masker
			{
				attribute<Bool> Nederland (/Geography/AdminDomain) := const(TRUE, /Geography/AdminDomain);
				attribute<Bool> Kust      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsKust;
				attribute<Bool> Rivieren  (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren;
				attribute<Bool> Veen      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen;
				attribute<Bool> Zand      (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsZand;
			}

			container Basisjaar
			: Descr = "Het aandeel woningen met een bouwjaar voor BouwjaarGrens per cel in het basisjaar, uit de BAG van het basisjaar met dezelfde toedeling als de basisjaarstand. Variantonafhankelijk, dus een keer gerekend voor de drie varianten."
			{
				unit<UInt32> Pand      := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(/ModelParameters/Model_StartYear) + '/pand', Descr = "De pandenset van het basisjaar, dezelfde als in Verdeling_VSSH en EigendomStaat.";
				unit<UInt32> Toedeling := Pand/ToedelingsMatrix, Descr = "Pand maal cel met het aandeel van het pand in de cel; ToedelingPand_CAD is hernormaliseerd binnen het CompactedAdminDomain, zoals Uitsmeren_T de woningen telt.";

				attribute<Units/Woning> Woningen_perPand       (Pand) := Pand/Counts/woon_VBOs_uniek[Units/Woning], Descr = "De unieke woon-vbo's per pand, dezelfde telling als count_vbo_pand_woon in EigendomStaat.";
				attribute<Units/Woning> Voor1970_perPand       (Pand) := Pand/Bouwjaar_trunc < BouwjaarGrens ? Woningen_perPand : 0[Units/Woning], Descr = "Een pand zonder bekend bouwjaar valt hier weg, want een vergelijking met null geeft FALSE.";
				attribute<Units/Woning> ZonderBouwjaar_perPand (Pand) := IsNull(Pand/Bouwjaar_trunc) ? Woningen_perPand : 0[Units/Woning];

				attribute<Units/Woning> Woningen_Pand_CAD       (/Geography/CompactedAdminDomain) := sum(Woningen_perPand[Toedeling/Pand_rel]       * Toedeling/ToedelingPand_CAD, Toedeling/CompactedAdminDomain_rel);
				attribute<Units/Woning> Voor1970_CAD            (/Geography/CompactedAdminDomain) := sum(Voor1970_perPand[Toedeling/Pand_rel]       * Toedeling/ToedelingPand_CAD, Toedeling/CompactedAdminDomain_rel);
				attribute<Units/Woning> ZonderBouwjaar_Pand_CAD (/Geography/CompactedAdminDomain) := sum(ZonderBouwjaar_perPand[Toedeling/Pand_rel] * Toedeling/ToedelingPand_CAD, Toedeling/CompactedAdminDomain_rel);
				attribute<Units/Woning> ZonderPand_CAD          (/Geography/CompactedAdminDomain) := ='add(' + AsItemList('/BaseData/StartState/Verdeling_VSSH/VBOsZonderPand/Per_CAD_WP2/' + /Classifications/Vastgoed/WP2/name) + ')', Descr = "Woon-vbo's zonder pand in de pandenset, die de basisjaarstand op hun vbo-punt telt; hun bouwjaar is onbekend.";

				attribute<Units/Woning> Woningen       (/Geography/AdminDomain) := recollect_by_cond(/Geography/AdminDomain/IsCompactedDomain, Woningen_Pand_CAD + ZonderPand_CAD, 0[Units/Woning]), Descr = "Alle woningen van het basisjaar opnieuw geteld; hoort gelijk te zijn aan Basisjaar/Stand/Aantal_Woningen_Totaal.";
				attribute<Units/Woning> Voor1970       (/Geography/AdminDomain) := recollect_by_cond(/Geography/AdminDomain/IsCompactedDomain, Voor1970_CAD, 0[Units/Woning]);
				attribute<Units/Woning> ZonderBouwjaar (/Geography/AdminDomain) := recollect_by_cond(/Geography/AdminDomain/IsCompactedDomain, ZonderBouwjaar_Pand_CAD + ZonderPand_CAD, 0[Units/Woning]);

				attribute<Float32> Aandeel_Voor1970       (/Geography/AdminDomain) := Woningen > 0[Units/Woning] ? Voor1970[Float32] / Woningen[Float32] : 0f, Descr = "Het deel van de basisjaarwoningen in de cel met een bouwjaar voor BouwjaarGrens. Als aandeel en niet als aantal toegepast op de stand, zodat een verschil tussen deze telling en de basisjaarstand nooit meer woningen van voor 1970 geeft dan de cel draagt.";
				attribute<Float32> Aandeel_ZonderBouwjaar (/Geography/AdminDomain) := Woningen > 0[Units/Woning] ? ZonderBouwjaar[Float32] / Woningen[Float32] : 0f;
			}

			container PerCasus := for_each_ne(Casus/name, 'Casus_T(' + quote(Casus/Map) + ', ' + quote(Casus/name) + ')');
			template Casus_T
			{
				parameter<String> Map;
				parameter<String> Naam;
				parameter<String> Jaar  := ='/Indicatoren/' + Map + '/Zichtjaren/Export/ExportZichtjaar', Descr = "Het exportzichtjaar van de casus, zodat dit item met de omgevingsvariabele ExportZichtjaar meebeweegt.";
				container         Z     := ='/Indicatoren/' + Map + '/Zichtjaren/' + Jaar + '/Stand';
				container         B     := ='/Indicatoren/' + Map + '/Basisjaar/Stand';
				container         Start := ='/Allocatie/' + Map + '/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw';

				attribute<Units/Woning> Woningen_Cel           (/Geography/AdminDomain) := MakeDefined(Z/Aantal_Woningen_Totaal, 0[Units/Woning]), Descr = "De stand van het zichtjaar.";
				attribute<Units/Woning> Woningen_Basisjaar_Cel (/Geography/AdminDomain) := MakeDefined(B/Aantal_Woningen_Totaal, 0[Units/Woning]), Descr = "De stand van het basisjaar, zonder de BAG-nieuwbouw.";
				attribute<Bool>         IsBAGnieuwbouwWonen    (/Geography/AdminDomain) := recollect_by_cond(/Geography/AdminDomain/IsCompactedDomain, Start/IsBAGnieuwbouwWonen, FALSE), Descr = "Cel waar OP_rel uit de BAG-nieuwbouw komt en niet uit de allocatie (#550).";
				attribute<Bool>         IsModelpakket          (/Geography/AdminDomain) := IsDefined(Z/OP_rel) && !IsBAGnieuwbouwWonen, Descr = "Cel waar het model een ontwikkelpakket heeft gealloceerd en de stand van het basisjaar dus heeft vervangen.";
				attribute<Float32>      Behouden               (/Geography/AdminDomain) := IsModelpakket || Woningen_Basisjaar_Cel <= 0[Units/Woning] ? 0f : min_elem(Woningen_Cel[Float32] / Woningen_Basisjaar_Cel[Float32], 1f), Descr = "Het deel van de basisjaarwoningen dat in het zichtjaar nog staat, zie punt 2 en 3 in de Descr van de container.";

				attribute<Units/Woning> Basisjaar_Behouden_Cel         (/Geography/AdminDomain) := Woningen_Basisjaar_Cel * Behouden;
				attribute<Units/Woning> BouwjaarVoor1970_Cel           (/Geography/AdminDomain) := Basisjaar_Behouden_Cel * Basisjaar/Aandeel_Voor1970, Descr = "Woningen in het zichtjaar met een bouwjaar voor BouwjaarGrens.";
				attribute<Units/Woning> Basisjaar_BouwjaarVoor1970_Cel (/Geography/AdminDomain) := Woningen_Basisjaar_Cel * Basisjaar/Aandeel_Voor1970;
				attribute<Units/Woning> Basisjaar_ZonderBouwjaar_Cel   (/Geography/AdminDomain) := Woningen_Basisjaar_Cel * Basisjaar/Aandeel_ZonderBouwjaar;

				container Kaarten
				: Descr = "De twee grootheden als kaart van 25 meter in de uitleveringsmap, een map per variant, leeg buiten het studiegebied. Eigen schrijvers zonder subitems, want een StorageName op een item met subitems neemt die subitems mee; gdalwrite.grid zet de georeferentie in de tif zelf."
				{
					attribute<Units/Woning> Woningen                  (/Geography/AdminDomain) := Woningen_Cel * Studiegebied
					, StorageName = "='%LocalDataProjDir%/' + Uitlevering + '/kaarten/' + Naam + '/Woningen_' + Jaar + '.tif'", StorageType = "gdalwrite.grid"
					, Descr = "Woningen per cel in het zichtjaar.";
					attribute<Units/Woning> Woningen_BouwjaarVoor1970 (/Geography/AdminDomain) := BouwjaarVoor1970_Cel * Studiegebied
					, StorageName = "='%LocalDataProjDir%/' + Uitlevering + '/kaarten/' + Naam + '/Woningen_BouwjaarVoor1970_' + Jaar + '.tif'", StorageType = "gdalwrite.grid"
					, Descr = "Woningen per cel in het zichtjaar met een bouwjaar voor BouwjaarGrens.";
				}

				container PerRegio := for_each_ne(Regio/name, 'Regio_T(' + quote(Regio/name) + ', Masker/' + Regio/name + ')');
				template Regio_T
				{
					parameter<String> RegioNaam;
					attribute<Bool>   IsRegio (/Geography/AdminDomain);
					parameter<Float64> Woningen                             := sum(IsRegio ? Woningen_Cel[Float64]                   : 0d);
					parameter<Float64> Woningen_BouwjaarVoor1970            := sum(IsRegio ? BouwjaarVoor1970_Cel[Float64]           : 0d);
					parameter<Float64> Woningen_Basisjaar                   := sum(IsRegio ? Woningen_Basisjaar_Cel[Float64]         : 0d);
					parameter<Float64> Woningen_Basisjaar_BouwjaarVoor1970  := sum(IsRegio ? Basisjaar_BouwjaarVoor1970_Cel[Float64] : 0d);
					parameter<Float64> Woningen_Basisjaar_Behouden          := sum(IsRegio ? Basisjaar_Behouden_Cel[Float64]         : 0d);
					parameter<Float64> Woningen_OpModelpakket               := sum(IsRegio && IsModelpakket ? Woningen_Cel[Float64]  : 0d);
					parameter<Float64> Woningen_Basisjaar_ZonderBouwjaar    := sum(IsRegio ? Basisjaar_ZonderBouwjaar_Cel[Float64]   : 0d);
					parameter<Float64> Controle_Basisjaar_BAG               := sum(IsRegio ? Basisjaar/Woningen[Float64]             : 0d);
				}
				unit<uint8> Tabel := Regio, Descr = "De vijf gebieden van deze casus als tabel, zonder meta-expressies, zodat Rijen en Levering ze kunnen stapelen."
				{
					attribute<String>  Zichtjaar                           := const(Jaar, .);
					attribute<Float64> Woningen                            := union_data(., PerRegio/Nederland/Woningen,                            PerRegio/Kust/Woningen,                            PerRegio/Rivieren/Woningen,                            PerRegio/Veen/Woningen,                            PerRegio/Zand/Woningen);
					attribute<Float64> Woningen_BouwjaarVoor1970           := union_data(., PerRegio/Nederland/Woningen_BouwjaarVoor1970,           PerRegio/Kust/Woningen_BouwjaarVoor1970,           PerRegio/Rivieren/Woningen_BouwjaarVoor1970,           PerRegio/Veen/Woningen_BouwjaarVoor1970,           PerRegio/Zand/Woningen_BouwjaarVoor1970);
					attribute<Float64> Woningen_Basisjaar                  := union_data(., PerRegio/Nederland/Woningen_Basisjaar,                  PerRegio/Kust/Woningen_Basisjaar,                  PerRegio/Rivieren/Woningen_Basisjaar,                  PerRegio/Veen/Woningen_Basisjaar,                  PerRegio/Zand/Woningen_Basisjaar);
					attribute<Float64> Woningen_Basisjaar_BouwjaarVoor1970 := union_data(., PerRegio/Nederland/Woningen_Basisjaar_BouwjaarVoor1970, PerRegio/Kust/Woningen_Basisjaar_BouwjaarVoor1970, PerRegio/Rivieren/Woningen_Basisjaar_BouwjaarVoor1970, PerRegio/Veen/Woningen_Basisjaar_BouwjaarVoor1970, PerRegio/Zand/Woningen_Basisjaar_BouwjaarVoor1970);
					attribute<Float64> Woningen_Basisjaar_Behouden         := union_data(., PerRegio/Nederland/Woningen_Basisjaar_Behouden,         PerRegio/Kust/Woningen_Basisjaar_Behouden,         PerRegio/Rivieren/Woningen_Basisjaar_Behouden,         PerRegio/Veen/Woningen_Basisjaar_Behouden,         PerRegio/Zand/Woningen_Basisjaar_Behouden);
					attribute<Float64> Woningen_OpModelpakket              := union_data(., PerRegio/Nederland/Woningen_OpModelpakket,              PerRegio/Kust/Woningen_OpModelpakket,              PerRegio/Rivieren/Woningen_OpModelpakket,              PerRegio/Veen/Woningen_OpModelpakket,              PerRegio/Zand/Woningen_OpModelpakket);
					attribute<Float64> Woningen_Basisjaar_ZonderBouwjaar   := union_data(., PerRegio/Nederland/Woningen_Basisjaar_ZonderBouwjaar,   PerRegio/Kust/Woningen_Basisjaar_ZonderBouwjaar,   PerRegio/Rivieren/Woningen_Basisjaar_ZonderBouwjaar,   PerRegio/Veen/Woningen_Basisjaar_ZonderBouwjaar,   PerRegio/Zand/Woningen_Basisjaar_ZonderBouwjaar);
					attribute<Float64> Controle_Basisjaar_BAG              := union_data(., PerRegio/Nederland/Controle_Basisjaar_BAG,              PerRegio/Kust/Controle_Basisjaar_BAG,              PerRegio/Rivieren/Controle_Basisjaar_BAG,              PerRegio/Veen/Controle_Basisjaar_BAG,              PerRegio/Zand/Controle_Basisjaar_BAG);
				}
			}

			unit<uint32> RijenBron := combine(Casus, Regio)
			, Descr = "De regels, los van de weggeschreven units: een kolom van een unit met StorageName mag niet op een zusterkolom steunen."
			{
				attribute<String> CasusNaam := Casus/name[first_rel];
				attribute<String> RegioNaam := Regio/name[second_rel];
			}
			unit<uint32> Rijen := RijenBron
			, StorageName = "='%LocalDataProjDir%/Rapport_v01/WoningvoorraadBouwjaar.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "Een regel per variant en gebied: de woningen en de woningen met een bouwjaar voor 1970 in het zichtjaar, met de controlekolommen uit de Descr van de container."
			{
				attribute<String>  Variant                             := RijenBron/CasusNaam;
				attribute<String>  Gebied                              := RijenBron/RegioNaam;
				attribute<String>  Zichtjaar                           := union_data(., PerCasus/BAU1/Tabel/Zichtjaar,                           PerCasus/BAU2/Tabel/Zichtjaar,                           PerCasus/NbSGenuanceerder/Tabel/Zichtjaar);
				attribute<Float64> Woningen                            := union_data(., PerCasus/BAU1/Tabel/Woningen,                            PerCasus/BAU2/Tabel/Woningen,                            PerCasus/NbSGenuanceerder/Tabel/Woningen);
				attribute<Float64> Woningen_BouwjaarVoor1970           := union_data(., PerCasus/BAU1/Tabel/Woningen_BouwjaarVoor1970,           PerCasus/BAU2/Tabel/Woningen_BouwjaarVoor1970,           PerCasus/NbSGenuanceerder/Tabel/Woningen_BouwjaarVoor1970);
				attribute<Float64> Woningen_Basisjaar                  := union_data(., PerCasus/BAU1/Tabel/Woningen_Basisjaar,                  PerCasus/BAU2/Tabel/Woningen_Basisjaar,                  PerCasus/NbSGenuanceerder/Tabel/Woningen_Basisjaar);
				attribute<Float64> Woningen_Basisjaar_BouwjaarVoor1970 := union_data(., PerCasus/BAU1/Tabel/Woningen_Basisjaar_BouwjaarVoor1970, PerCasus/BAU2/Tabel/Woningen_Basisjaar_BouwjaarVoor1970, PerCasus/NbSGenuanceerder/Tabel/Woningen_Basisjaar_BouwjaarVoor1970);
				attribute<Float64> Woningen_Basisjaar_Behouden         := union_data(., PerCasus/BAU1/Tabel/Woningen_Basisjaar_Behouden,         PerCasus/BAU2/Tabel/Woningen_Basisjaar_Behouden,         PerCasus/NbSGenuanceerder/Tabel/Woningen_Basisjaar_Behouden);
				attribute<Float64> Woningen_OpModelpakket              := union_data(., PerCasus/BAU1/Tabel/Woningen_OpModelpakket,              PerCasus/BAU2/Tabel/Woningen_OpModelpakket,              PerCasus/NbSGenuanceerder/Tabel/Woningen_OpModelpakket);
				attribute<Float64> Woningen_Basisjaar_ZonderBouwjaar   := union_data(., PerCasus/BAU1/Tabel/Woningen_Basisjaar_ZonderBouwjaar,   PerCasus/BAU2/Tabel/Woningen_Basisjaar_ZonderBouwjaar,   PerCasus/NbSGenuanceerder/Tabel/Woningen_Basisjaar_ZonderBouwjaar);
				attribute<Float64> Controle_Basisjaar_BAG              := union_data(., PerCasus/BAU1/Tabel/Controle_Basisjaar_BAG,              PerCasus/BAU2/Tabel/Controle_Basisjaar_BAG,              PerCasus/NbSGenuanceerder/Tabel/Controle_Basisjaar_BAG);
			}
			unit<uint32> Levering := RijenBron
			, StorageName = "='%LocalDataProjDir%/' + Uitlevering + '/Woningvoorraad_' + ExportJaar + '.csv'"
			, StorageType = "gdalwrite.vect"
			, Descr       = "De twee grootheden voor het zichtjaar, en dezelfde twee voor het basisjaar als uitgangspunt, een regel per variant en gebied, rechtstreeks in de uitleveringsmap. De basisjaarkolommen zijn voor de drie varianten gelijk."
			{
				attribute<String>  Variant                             := RijenBron/CasusNaam;
				attribute<String>  Gebied                              := RijenBron/RegioNaam;
				attribute<String>  Zichtjaar                           := union_data(., PerCasus/BAU1/Tabel/Zichtjaar,                           PerCasus/BAU2/Tabel/Zichtjaar,                           PerCasus/NbSGenuanceerder/Tabel/Zichtjaar);
				attribute<Float64> Woningen                            := union_data(., PerCasus/BAU1/Tabel/Woningen,                            PerCasus/BAU2/Tabel/Woningen,                            PerCasus/NbSGenuanceerder/Tabel/Woningen);
				attribute<Float64> Woningen_BouwjaarVoor1970           := union_data(., PerCasus/BAU1/Tabel/Woningen_BouwjaarVoor1970,           PerCasus/BAU2/Tabel/Woningen_BouwjaarVoor1970,           PerCasus/NbSGenuanceerder/Tabel/Woningen_BouwjaarVoor1970);
				attribute<Float64> Woningen_Basisjaar                  := union_data(., PerCasus/BAU1/Tabel/Woningen_Basisjaar,                  PerCasus/BAU2/Tabel/Woningen_Basisjaar,                  PerCasus/NbSGenuanceerder/Tabel/Woningen_Basisjaar);
				attribute<Float64> Woningen_Basisjaar_BouwjaarVoor1970 := union_data(., PerCasus/BAU1/Tabel/Woningen_Basisjaar_BouwjaarVoor1970, PerCasus/BAU2/Tabel/Woningen_Basisjaar_BouwjaarVoor1970, PerCasus/NbSGenuanceerder/Tabel/Woningen_Basisjaar_BouwjaarVoor1970);
			}
		}


		container PerCasus :=
			for_each_ne(
				Classifications/Modellering/AllCases/Label
				, 'Rapport_v01_T(' + quote(Classifications/Modellering/AllCases/Label) + ')'
			);

		template Rapport_v01_T
		{
			parameter<String> CasusName;

			unit<uint32> Tabel_NL    := ='/Indicatoren/' + CasusName + '/Zichtjaren/Export/Tabellen/PerNederland/Tabel';
			unit<uint32> Tabel_Regio := ='/Indicatoren/' + CasusName + '/Zichtjaren/Export/Tabellen/PerIndeling/Tabel';
			unit<uint8>  Areaal      := ='/Indicatoren/' + CasusName + '/Zichtjaren/Export/Grondgebruik/LandgebruikNL2120_Areaal';

			container OphoogkostenWerklocaties
			: Descr = "Wat de bodemdaling aan ophoging kost op de cellen waar de allocatie een werksubsector heeft neergezet. De wonen-kant kent een post MeerkostenBodemdaling en de werken-kant niet:
						KostenWerklocaties rekent alleen wat er bovenop de bodemdalingsophoging komt om boven het water uit te komen. Dit item zet de drie onderdelen bij elkaar die er al liggen: de ophoogdikte uit
						bijlage E, het tarief per meter met dezelfde opslag, en het oppervlak van de werklocaties. Geen volle tegenhanger van KostenWoningbouw/MeerkostenBodemdaling, want die draagt ook de overige
						inrichtingselementen (verharding, riolering, groen en heipalen), waarvoor een verdeling nodig is die de bron voor bedrijventerreinen niet geeft; hier staat alleen het zandpakket. Structureel
						hoort dit als kolom in RegionaleIndicatoren_T naast KostenWerklocaties_MeerkostenOverstroming, met de rekenregel in Templates/Indicatoren/KostenWerklocaties.dms."
			{
				parameter<String> Jaar := ='/Indicatoren/' + CasusName + '/Zichtjaren/Export/ExportZichtjaar'
				, Descr = "Het zichtjaar waarop de export staat, uit dezelfde casus, zodat dit item met de omgevingsvariabele ExportZichtjaar meebeweegt.";

				container Bron := ='/Indicatoren/' + CasusName + '/Zichtjaren/' + Jaar + '/KostenWerklocaties';

				attribute<Units/Eur_m2> Tarief_Bodemdaling (/Geography/AdminDomain) :=
					Bron/Src/Kengetallen/Ophogen_permeter * (Bron/Ophoging_ZonderMaatregel / 1[Units/meter]) * Bron/Src/Kengetallen/Opslag
				, Descr = "Het tarief per m2 terrein voor de ophoging die de bodemdaling vraagt, met dezelfde opslag als bij de overstromingsmaatregel.";

				attribute<Units/Eur> Ophoogkosten (/Geography/AdminDomain) := MakeDefined(Tarief_Bodemdaling * Bron/Werklocatie_m2, 0[Units/Eur])
				, Descr = "De rekening per cel, nominaal in het zichtjaar, nul buiten de werklocaties.";

				parameter<Units/Eur> Ophoogkosten_Per_NL := sum(Ophoogkosten), Descr = "Landelijk totaal, de kolom die het rapport vraagt.";
			}

			container GrondexploitatiePosten
			: Descr = "De negen posten van het exploitatiesaldo van de woningbouw, landelijk opgeteld over de cellen waarover het saldo is geboekt, zodat het rapport de grondexploitatie compleet toont: de levering
						draagt het saldo en drie van de posten (bouwsom, grondproductie en bodemdaling, via KostenWoningbouw), de andere zes niet apart. Elke post komt uit Grondexploitatie/Posten, dus met de
						definities waarmee het saldo is gerekend, en de negen regels tellen op tot Grondexploitatie_Saldo. Opbrengsten is hier de opbrengstterm van het saldo, de marktwaarde met pakketweging en na
						aftrek van btw, en niet Woningwaarde_Nieuwbouw. Structureel horen dit negen kolommen in RegionaleIndicatoren_T naast Grondexploitatie_Saldo."
			{
				parameter<String> Jaar := ='/Indicatoren/' + CasusName + '/Zichtjaren/Export/ExportZichtjaar';
				container         Bron := ='/Indicatoren/' + CasusName + '/Zichtjaren/' + Jaar + '/Grondexploitatie';

				parameter<Units/Eur> Opbrengsten_Per_NL      := sum(Bron/Posten/Opbrengsten),      Descr = "Netto van btw, met de pakketweging in de prijs.";
				parameter<Units/Eur> Bouwsom_Per_NL          := sum(Bron/Posten/Bouwsom),          Descr = "Gelijk aan KostenWoningbouw_Bouwkosten; staat hier als controle.";
				parameter<Units/Eur> BijkomendeKosten_Per_NL := sum(Bron/Posten/BijkomendeKosten);
				parameter<Units/Eur> WinstEnRisico_Per_NL    := sum(Bron/Posten/WinstEnRisico);
				parameter<Units/Eur> Grondproductie_Per_NL   := sum(Bron/Posten/Grondproductie),   Descr = "Gelijk aan KostenWoningbouw_Regulier; staat hier als controle.";
				parameter<Units/Eur> Bodemdaling_Per_NL      := sum(Bron/Posten/Bodemdaling),      Descr = "Gelijk aan KostenWoningbouw_MeerkostenBodemdaling; staat hier als controle.";
				parameter<Units/Eur> Piekbuiberging_Per_NL   := sum(Bron/Posten/Piekbuiberging),   Descr = "Alleen van het gealloceerde pakket, en nul als de post niet in het saldo zat.";
				parameter<Units/Eur> Verwerving_Per_NL       := sum(Bron/Posten/Verwerving),       Descr = "Woningen na funderingsafwaardering, niet-woningen en grond.";
				parameter<Units/Eur> Sloop_Per_NL            := sum(Bron/Posten/Sloop),            Descr = "De sloop van wat er op de bebouwde cel stond; niet de sloop voor de bouwstenen.";
				parameter<Units/Eur> Saldo_Per_NL            := Bron/Saldo_Per_NL,                 Descr = "Het saldo zelf, ter controle: opbrengsten min de acht kostenposten.";
				parameter<Units/Ha>  Nieuwbouw_Ha_Per_NL     := Bron/Nieuwbouw_Ha_Per_NL,          Descr = "De hectares waarover het saldo is geboekt, zonder de BAG-nieuwbouw.";
			}

			container CO2eq
			: Descr = "Netto broeikasgasemissie sinds het basisjaar in megaton CO2-equivalent, emissie positief, samengesteld uit twee kolommen van de indicatorentabel met tegengestelde tekens en verschillende
						eenheden: CO2Flow_TovBasisjaar (ton, negatief is verlies van voorraad, dus emissie) en Methaan_Cumulatief (megaton CO2-equivalent, positief is emissie). Lachgas zit er niet in. Netto is de
						indicator; Ondergrens telt de ongedekte veenoxidatie mee als verlies, wat bij CO2Flow_TovBasisjaar_InclOngedekt uitdrukkelijk een ondergrens en niet de indicator heet (#733). Structureel
						horen dit twee kolommen in RegionaleIndicatoren_T naast Methaan_Cumulatief."
			{
				attribute<Units/mton> Netto_NL             (Tabel_NL)    := (-Tabel_NL/CO2Flow_TovBasisjaar)[Units/mton]              + Tabel_NL/Methaan_Cumulatief;
				attribute<Units/mton> Ondergrens_NL        (Tabel_NL)    := (-Tabel_NL/CO2Flow_TovBasisjaar_InclOngedekt)[Units/mton] + Tabel_NL/Methaan_Cumulatief;
				attribute<Units/mton> Netto_Regio          (Tabel_Regio) := (-Tabel_Regio/CO2Flow_TovBasisjaar)[Units/mton]              + Tabel_Regio/Methaan_Cumulatief;
				attribute<Units/mton> Ondergrens_Regio     (Tabel_Regio) := (-Tabel_Regio/CO2Flow_TovBasisjaar_InclOngedekt)[Units/mton] + Tabel_Regio/Methaan_Cumulatief;
				attribute<Float32> Methaan_Aandeel_NL      (Tabel_NL)    := Tabel_NL/Methaan_Cumulatief / Netto_NL
				, Descr = "Aandeel van methaan in de netto emissie; boven 1 als de CO2-kant per saldo vastlegt.";
			}

			container NatuurArealen
			: Descr = "Areaal natte en droge natuur in het zichtjaar, landelijk en per landschapsgebied, uit de arealentabel van de 165 klassen met de tweedeling uit NatuurNatDroog. De landschapskolommen overlappen elkaar en tellen niet op tot Nederland (#760). Structureel: twee subtotaalregels in Export/Grondgebruik/LandgebruikNL2120_Areaal."
			{
				attribute<Bool> IsNat   (Areaal) := NatuurNatDroog/LU_IsNat;
				attribute<Bool> IsDroog (Areaal) := NatuurNatDroog/LU_IsDroog;

				parameter<Units/Ha> Nat_Nederland        := sum(IsNat   ? Areaal/Nederland      : 0[Units/Ha]);
				parameter<Units/Ha> Droog_Nederland      := sum(IsDroog ? Areaal/Nederland      : 0[Units/Ha]);
				parameter<Units/Ha> Nat_Kust             := sum(IsNat   ? Areaal/Kust           : 0[Units/Ha]);
				parameter<Units/Ha> Droog_Kust           := sum(IsDroog ? Areaal/Kust           : 0[Units/Ha]);
				parameter<Units/Ha> Nat_Rivieren         := sum(IsNat   ? Areaal/Rivieren       : 0[Units/Ha]);
				parameter<Units/Ha> Droog_Rivieren       := sum(IsDroog ? Areaal/Rivieren       : 0[Units/Ha]);
				parameter<Units/Ha> Nat_Veen             := sum(IsNat   ? Areaal/Veen           : 0[Units/Ha]);
				parameter<Units/Ha> Droog_Veen           := sum(IsDroog ? Areaal/Veen           : 0[Units/Ha]);
				parameter<Units/Ha> Nat_Zand             := sum(IsNat   ? Areaal/Zand           : 0[Units/Ha]);
				parameter<Units/Ha> Droog_Zand           := sum(IsDroog ? Areaal/Zand           : 0[Units/Ha]);
				parameter<Units/Ha> Nat_Geen_landschap   := sum(IsNat   ? Areaal/Geen_landschap : 0[Units/Ha]);
				parameter<Units/Ha> Droog_Geen_landschap := sum(IsDroog ? Areaal/Geen_landschap : 0[Units/Ha]);
			}
		}
	}
}
