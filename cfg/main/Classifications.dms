container Classifications: using = "Units", KeepData = "True"
{
	#include<Actor.dms>
	#include<Bereikbaarheid.dms>
	#include<Data.dms>
	#include<Grondgebruik.dms>
	#include<Landschap.dms>
	// #include<MateriaalStromen.dms>
	#include<Modellering.dms>
	#include<OSM.dms>
	#include<Overstromingsgevaarzonering.dms>
	#include<Time.dms>
	#include<Vastgoed.dms>
	#include<Zonneladder.dms>
	#include<TigrisXL.dms>
	#include<Landbouw.dms>
	
	unit<uint8> WaterretentieKOrg: NrOfRows = 8 // Kentallen ontvangen van Daan rooze (Deltares) in 2025 voor het PBL project Herijking klimaatrisico's NAS
	{
		attribute<string>                       name: ['GroenDak','BlauwDak','Halfverharding','Wadi','HolleWeg','Waterplein','InfiltratieveldMetOpslag','Infiltratiekratten'];
		attribute<m3_m2>          Bergingscapaciteit: [0.01      ,0.10      ,0.05            ,0.35  ,0.10      ,0.75        ,0.80                      ,0.40                ];
		attribute<Eur_m2>               Aanlegkosten: [120       ,234       ,100             ,75    ,30        ,4125        ,60                        ,950                 ];
		attribute<Eur_m2_jaarlijks> Onderhoudskosten: [6.00      ,9.00      ,0.42            ,0.75  ,2.25      ,1.65        ,0.50                      ,5.32                ];
		attribute<bool>       HeeftBenodigdeVelddata: [false     ,false     ,true            ,true  ,true      ,false       ,false                     ,false               ];
		
		attribute<string> Label := name;
		
		container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		
		unit<uint8> MetBenodigdeVelddata := select_with_org_rel(WaterretentieK/HeeftBenodigdeVelddata == true)
		{
			attribute<string> name := WaterretentieK/name[org_rel];
			attribute<m3_m2>  Bergingscapaciteit := WaterretentieK/Bergingscapaciteit[org_rel];
			
			attribute<string> Label := name;
		
			container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		}
	}
	
	unit<uint8> WaterretentieK: NrOfRows = 14
	, Descr = "Bergingscapaciteit per maatregel in m3 per m2 en de kosten per maatregel, kentallen van Deltares en van team Stad. GroenDak en BlauwDak zijn de kentallen voor een plat dak. GroenDakSchuin staat er sinds #746 naast met capaciteit nul: team Stad van Deltares stelt dat een groen dak op een schuin dak niets bergt, en wilde dat op deze plek als apart kental. Een blauw dak mag volgens hetzelfde besluit alleen op een plat dak; dat regelen de lezers door de blauwe fractie alleen op het platte deel van het dak te zetten (ModelParameters/Piekbuiberging/Dakvorm), dus daar hoort geen schuine rij bij.

				De drie rijen HalfverhardingWijkweg, HalfverhardingWoonerf en HalfverhardingInrit staan er sinds #757. Ze dragen hetzelfde kental als Halfverharding en bestaan alleen omdat Deltares er per variant een ander aandeel op wil: in NbSMax en NbSGenuanceerd is alle wijkweg halfverhard, woonerven ook, en inritten alleen in NbSGenuanceerd omdat NbSMax geen voortuinen met inritten meer kent. Een aandeel per variant kan alleen als eigen rij, want de BGT-klassenkaart wordt weggeschreven voordat de variant bekend is. Hun kaarten zijn op 3 september 2026 weggeschreven via WriteBaseData/Impl/WaterbergingCapaciteit; zonder die kaarten meldt de keten per laag een GDAL-fout met exitcode 0 en komt de uitdraai leeg terug. Gemeten oppervlak: wijkweg 391,8 mln m2, inrit 22,6 en woonerf 2,3. Dat de BGT zo weinig als woonerf registreert is de reden dat die groep in het aanbod nauwelijks meetelt. De wijkweg draagt daarmee twee maatregelen tegelijk, halfverharding op het hele oppervlak en de holle weg op een deel ervan; dat is een gelaagde en geen verdelende lezing, zie de Descr bij FractieWaterretentieCapaciteitHalfverhardingWijkweg in VariantK.

				De kostenkolommen zijn op 8 september 2026 samengesteld uit drie bronnen (#798), in de volgorde die Deltares daar oplegt: eerst team Stad, dan de Deltares-wiki, dan Arcadis. Per cel, dus een rij kan zijn aanlegkosten aan de ene bron ontlenen en zijn onderhoud aan de andere; BronAanlegkosten en BronOnderhoudskosten leggen per cel vast welke dat is. Team Stad levert alleen aanlegkosten en alleen voor daken en kratten (260706_kengetallen_NL2120.xlsx in #798), de wiki dekt de rest, en Arcadis vult de enige cel die daarna nog leeg was, die van DoorlatendGroen. De Arcadis-bron is de MKBA Klimaatbestendige inrichting pilotwijken Spangen en Mariahoeve van 26 februari 2019, bijgevoegd in #798, met prijspeil 2017, een analyseperiode van 40 jaar en een discontovoet van 3 procent. Die regel heet daar waterberging in onverhard oppervlak en het rapport geeft hem als 120 euro per m3 en 30 euro per m2, waarbij de 30 hoort bij een berging van 0,25 m3 per m2 in granulaat. Deze tabel geeft DoorlatendGroen 0,05 m3 per m2, dus de 30 euro betaalt vijf keer zoveel berging als er hier wordt bijgeschreven. Daarom staat hier 6 euro, de omrekenregel hieronder toegepast: 120 maal 0,05. Tussen 8 en 9 september 2026 stond hier 30, de kale bronwaarde, op verzoek van Deltares; dat verzoek kwam voordat het rapport in het issue stond, en op 9 september gaf Deltares aan de mismatch zelf ook niet te kunnen duiden. De keuze voor 6 is die van team RS en houdt de tabel intern consistent: overal waar een bron per m3 rekent betaalt het model voor het volume dat het ook bijschrijft. Het onderhoud blijft op 0,37 euro per m2 per jaar staan, de kale bronwaarde, want onderhoud hangt aan het oppervlak dat open moet blijven en niet aan het bergingsvolume eronder. Blijkt later dat niet de prijs maar de capaciteit van 0,05 m3 per m2 te laag is voor deze maatregel, dan hoort de correctie op Bergingscapaciteit hierboven en bewegen berging en kosten samen mee; nu is alleen deze ene prijs veranderd. De maatregel bestaat alleen in nieuwbouw in de twee NbS-varianten, hij draagt daar ongeveer een zevende van de piekbuikosten, en die kosten sturen de allocatie niet meer, dus deze keuze raakt alleen een kolom in de opleveringstabel. Drie regels van team Stad worden gebruikt. GroenDak neemt het natuurdak met 12 cm substraat en niet het sedumdak met 6 cm: het bergingskental van 0,01 m3 per m2 komt van de wikiregel Groene daken, en die beschrijft zichzelf als extensief circa 10 cm en uitdrukkelijk geen sedum, dus de 12 cm is de maat die bij dit kental hoort. BlauwDak neemt het groen-blauwe dak statisch extensief. Deltares bevestigde dat op 8 september 2026 in #798, met de toevoeging van team Stad dat er alleen groene en groen-blauwe daken bestaan; een kaal waterdak is er dus niet en het model bergt hier 0,10 m3 per m2 in een statisch systeem. In die regel staat gemiddeld 95 terwijl van en tot 90 en 125 zijn, en 95 is ook precies het gemiddelde van het groene natuurdak een regel hoger. Deltares bevestigde in hetzelfde antwoord dat dat een overnamefout is, dus hier staat 107,50, het midden van de geleverde bandbreedte, en niet de 95 uit het blad. Het onderhoud van dit dak is dat van een groen dak, 6,00 euro per m2 per jaar, op aanwijzing van Deltares in datzelfde antwoord: de wiki noemt bij waterdaken nul, en dat is voor een groen-blauw dak niet plausibel. Infiltratiekratten neemt de infiltratiekoffer met Aquacell 400 kratten zonder EPDM, want de EPDM-variant is uitdrukkelijk voor een hoge grondwaterstand en dat is hier geen aparte maatregel.

				Twee bewerkingen zitten tussen de bron en deze tabel. De eerste: waar de bron per m3 rekent, is het bedrag hier vermenigvuldigd met de Bergingscapaciteit van dezelfde rij, want deze kolommen staan per m2 en de lezer werkt met oppervlak. Dat geldt voor Waterplein (1650 euro per m3, hier 1237,50) en Infiltratiekratten (475 euro per m3 op de wiki, 5,30 euro onderhoud per m3). De wiki doet die omrekening zelf ook, in de kolom Kosten euro m-2, maar deelt daar door de aangenomen hoogte in plaats van te vermenigvuldigen: 475 gedeeld door 0,5 geeft de 950 die hier tot 8 september 2026 stond, en 1650 gedeeld door 0,4 de 4125. Dat is een factor 1 gedeeld door h kwadraat te hoog, vier keer bij de kratten en ruim zes keer bij het waterplein. Dat de eigen omrekening van de kratten, 475 maal 0,40 is 190 euro per m2, binnen de bandbreedte van 170 tot 190 van team Stad valt, is de bevestiging dat deze kant klopt en de wikikolom niet.

				De tweede: de bedragen van team Stad zijn kale aanlegkosten. Diezelfde levering noemt bouwplaatskosten en planuitwerking apart, elk 5 tot 10 procent, samen gemiddeld 15 procent. Die opslag staat niet in de bedragen hieronder maar als ModelParameters/Piekbuiberging/OpslagIndirecteKosten, en de kolom OpslagIndirecteKosten zegt per rij of hij van toepassing is. Alleen de rijen van team Stad dragen hem; de wikibedragen zijn inclusief graaf- en herstelwerk en zouden hem dubbel tellen.

				Waterplein, InfiltratieveldMetOpslag en Infiltratiekratten dragen wel een kental maar geen capaciteitskaart, dus ze tellen nergens mee. Dat blijft zo: Deltares bevestigde op 8 september 2026 in #798 dat team Stad die drie maatregelen bewust buiten het project heeft gelaten. Hun bedragen staan er alleen om de tabel compleet te houden.

				Van de drie bronnen noemt alleen Arcadis een prijspeil, 2017. De wiki geeft per regel losse aanwijzingen, zoals een inflatiecorrectie van 5 procent en de Benchmark Gemeentelijk Groen 2018, maar geen jaar; het rekenblad van team Stad noemt niets. Voor die twee staat de vraag uit. Zolang dat open staat zijn deze bedragen niet zuiver optelbaar bij posten met een vastgelegd prijspeil, zoals de bouwkosten op prijspeil 2023.

				De kostenkolommen worden nog nergens gelezen; dat is de tweede helft van #798. Voor de schuine dakrij zijn ze gelijk aan de platte, want een groen dak op een schuin dak kost hetzelfde en bergt alleen niets."
	// Bronnen: team Stad van Deltares (#798), https://publicwiki.deltares.nl/spaces/AST/pages/160236837/Tabellen+aanleg-+en+beheerkosten en de Arcadis-tabel in #798
	{
		attribute<string>                       name: ['GroenDak','BlauwDak','Halfverharding','Wadi','HolleWeg','Waterplein','InfiltratieveldMetOpslag','Infiltratiekratten', 'DoorlatendGroen', 'BergingOpWater', 'GroenDakSchuin', 'HalfverhardingWijkweg', 'HalfverhardingWoonerf', 'HalfverhardingInrit'];
		attribute<m3_m2>          Bergingscapaciteit: [0.01      ,0.10      ,0.05            ,0.30  ,0.10      ,0.75        ,0.80                      ,0.40                ,0.05              ,0.50             ,0.00            ,0.05                   ,0.05                   ,0.05                 ];
		attribute<Eur_m2>               Aanlegkosten: [95        ,107.50    ,100             ,75    ,30        ,1237.50     ,60                        ,170                 ,6                 ,0                ,95              ,100                    ,100                    ,100                  ];
		attribute<Eur_m2_jaarlijks> Onderhoudskosten: [6.00      ,6.00      ,0.42            ,0.75  ,2.25      ,1.35        ,0.50                      ,2.12                ,0.37              ,0                ,6.00            ,0.42                   ,0.42                   ,0.42                 ];
		attribute<string>          BronAanlegkosten: ['TeamStad','TeamStad','Deltares'      ,'Deltares','Deltares','Deltares','Deltares'                ,'TeamStad'          ,'Arcadis'         ,'Deltares'       ,'TeamStad'      ,'Deltares'             ,'Deltares'             ,'Deltares'           ];
		attribute<string>      BronOnderhoudskosten: ['Deltares','Deltares','Deltares'      ,'Deltares','Deltares','Deltares','Deltares'                ,'Deltares'          ,'Arcadis'         ,'Deltares'       ,'Deltares'      ,'Deltares'             ,'Deltares'             ,'Deltares'           ];
		attribute<bool>       OpslagIndirecteKosten: [true      ,true      ,false           ,false ,false     ,false       ,false                     ,true                ,false             ,false            ,true            ,false                  ,false                  ,false                ];
		attribute<bool>       HeeftBenodigdeVelddata: [false     ,false     ,true            ,true  ,true      ,false       ,false                     ,false               , true             , true            ,false           ,true                   ,true                   ,true                 ];
		
		attribute<Eur_m2> AanlegkostenInclOpslag := Aanlegkosten * (1f + float32(OpslagIndirecteKosten) * /ModelParameters/Piekbuiberging/OpslagIndirecteKosten)
		, Descr = "De aanlegkosten zoals de lezers ze horen te gebruiken (#798): het kental uit de bron, met de opslag voor bouwplaatskosten en planuitwerking erop waar de bron die apart noemt. Dat is alleen bij de rijen van team Stad, en de kolom OpslagIndirecteKosten hiernaast zegt welke dat zijn. Zo staat de opslag op een plek en niet bij elke lezer opnieuw.";
		
		attribute<string> Label := name;
		
		container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		
		unit<uint8> MetBenodigdeVelddata := select_with_org_rel(WaterretentieK/HeeftBenodigdeVelddata == true)
		{
			attribute<string> name := WaterretentieK/name[org_rel];
			attribute<m3_m2>  Bergingscapaciteit := WaterretentieK/Bergingscapaciteit[org_rel];
			attribute<Eur_m2> AanlegkostenInclOpslag := WaterretentieK/AanlegkostenInclOpslag[org_rel];
			attribute<Eur_m2_jaarlijks> Onderhoudskosten := WaterretentieK/Onderhoudskosten[org_rel];
			
			attribute<string> Label := name;
		
			container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		}
	}
	
	container CO2
	{
		unit<uint8> EmissieK: NrOfRows = 3
		{
			attribute<string> name: ['Minimum', 'Mediaan', 'Maximum'];
			attribute<string> label := name;
		}
		
		unit<uint8> PrijsK: NrOfRows = 2
		{
			attribute<string> name: ['Minimum', 'Maximum'];
			attribute<string> label := name;
			attribute<Eur_ton> Prijs := union_data(., ModelParameters/Landbouw/CO2_prijs_minimum, ModelParameters/Landbouw/CO2_prijs_maximum);
		}
		
		unit<uint32> EmissieXPrijsK := combine(EmissieK, PrijsK)
		{
			attribute<string> Emissie_name := EmissieK/name[first_rel];
			attribute<string> Prijs_name := PrijsK/name[second_rel];
			attribute<string> label := 'Emissies'+Emissie_name+'_'+'Prijs'+Prijs_name;
			attribute<string> name := replace(label, '_', '/');
			attribute<Eur_ton> Prijs := PrijsK/Prijs[second_rel];
		}
	}
}