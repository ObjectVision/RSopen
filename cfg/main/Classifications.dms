container Classifications: using = "Units", KeepData = "True"
{
	#include<Actor.dms>
	#include<Bereikbaarheid.dms>
	#include<Data.dms>
	#include<Grondgebruik.dms>
	#include<Landschap.dms>
	// #include<MateriaalStromen.dms>
	#include<Modellering.dms>
	#include<OSM.dms>
	#include<Overstromingsgevaarzonering.dms>
	#include<Time.dms>
	#include<Vastgoed.dms>
	#include<Zonneladder.dms>
	#include<TigrisXL.dms>
	#include<Landbouw.dms>
	
	unit<uint8> WaterretentieKOrg: NrOfRows = 8 // Kentallen ontvangen van Daan rooze (Deltares) in 2025 voor het PBL project Herijking klimaatrisico's NAS
	{
		attribute<string>                       name: ['GroenDak','BlauwDak','Halfverharding','Wadi','HolleWeg','Waterplein','InfiltratieveldMetOpslag','Infiltratiekratten'];
		attribute<m3_m2>          Bergingscapaciteit: [0.01      ,0.10      ,0.05            ,0.35  ,0.10      ,0.75        ,0.80                      ,0.40                ];
		attribute<Eur_m2>               Aanlegkosten: [120       ,234       ,100             ,75    ,30        ,4125        ,60                        ,950                 ];
		attribute<Eur_m2_jaarlijks> Onderhoudskosten: [6.00      ,9.00      ,0.42            ,0.75  ,2.25      ,1.65        ,0.50                      ,5.32                ];
		attribute<bool>       HeeftBenodigdeVelddata: [false     ,false     ,true            ,true  ,true      ,false       ,false                     ,false               ];
		
		attribute<string> Label := name;
		
		container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		
		unit<uint8> MetBenodigdeVelddata := select_with_org_rel(WaterretentieK/HeeftBenodigdeVelddata == true)
		{
			attribute<string> name := WaterretentieK/name[org_rel];
			attribute<m3_m2>  Bergingscapaciteit := WaterretentieK/Bergingscapaciteit[org_rel];
			
			attribute<string> Label := name;
		
			container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		}
	}
	
	unit<uint8> WaterretentieK: NrOfRows = 14
	, Descr = "Bergingscapaciteit per maatregel in m3 per m2 en de kosten per maatregel, kentallen van Deltares en van team Stad. GroenDak en BlauwDak gelden voor een plat dak; GroenDakSchuin staat er met
				capaciteit nul omdat een groen dak op een schuin dak niets bergt (#746), en een blauw dak mag alleen op een plat dak, wat de lezers regelen via ModelParameters/Piekbuiberging/Dakvorm.
				HalfverhardingWijkweg, HalfverhardingWoonerf en HalfverhardingInrit dragen hetzelfde kental als Halfverharding en bestaan omdat Deltares er per variant een ander aandeel op wil (#757); een
				aandeel per variant kan alleen als eigen rij, want de BGT-klassenkaart wordt weggeschreven voordat de variant bekend is, en de wijkweg draagt zo halfverharding en de holle weg tegelijk, een
				gelaagde lezing. De kostenkolommen komen uit drie bronnen in de volgorde die Deltares oplegt (team Stad, de Deltares-wiki, Arcadis), per cel vastgelegd in BronAanlegkosten en
				BronOnderhoudskosten (#798); bedragen per m3 zijn met de Bergingscapaciteit van de rij naar m2 omgerekend, en de kale aanlegkosten van team Stad krijgen de opslag uit
				ModelParameters/Piekbuiberging/OpslagIndirecteKosten via de kolom OpslagIndirecteKosten. Waterplein, InfiltratieveldMetOpslag en Infiltratiekratten hebben een kental maar geen
				capaciteitskaart en tellen nergens mee, want team Stad heeft ze buiten het project gelaten. Het prijspeil is 2025 als aanname, op aanwijzing van Deltares, en niet omgerekend naar het
				modelprijspeil 2023; komt het echte prijspeil van team Stad, dan hoort die omrekening er te komen, met een index voor grond-, weg- en waterbouw. Bestaand gebied leest AanlegkostenInclOpslag,
				nieuwbouw MeerkostenTovRegulier.", Source = "capaciteit en kosten Deltares-wiki en team Stad (260706_kengetallen_NL2120.xlsx, #798); DoorlatendGroen uit Arcadis, MKBA Klimaatbestendige inrichting pilotwijken Spangen en Mariahoeve, 26 februari 2019, 120 euro per m3 maal 0,05 m3 per m2"
	// Bronnen: team Stad van Deltares (#798), https://publicwiki.deltares.nl/spaces/AST/pages/160236837/Tabellen+aanleg-+en+beheerkosten en de Arcadis-tabel in #798
	{
		attribute<string>                       name: ['GroenDak','BlauwDak','Halfverharding','Wadi','HolleWeg','Waterplein','InfiltratieveldMetOpslag','Infiltratiekratten', 'DoorlatendGroen', 'BergingOpWater', 'GroenDakSchuin', 'HalfverhardingWijkweg', 'HalfverhardingWoonerf', 'HalfverhardingInrit'];
		attribute<m3_m2>          Bergingscapaciteit: [0.01      ,0.10      ,0.05            ,0.30  ,0.10      ,0.75        ,0.80                      ,0.40                ,0.05              ,0.50             ,0.00            ,0.05                   ,0.05                   ,0.05                 ];
		attribute<Eur_m2>               Aanlegkosten: [95        ,107.50    ,100             ,75    ,30        ,1237.50     ,60                        ,170                 ,6                 ,0                ,95              ,100                    ,100                    ,100                  ];
		attribute<Eur_m2_jaarlijks> Onderhoudskosten: [6.00      ,6.00      ,0.42            ,0.75  ,2.25      ,1.35        ,0.50                      ,2.12                ,0.37              ,0                ,6.00            ,0.42                   ,0.42                   ,0.42                 ];
		attribute<string>          BronAanlegkosten: ['TeamStad','TeamStad','Deltares'      ,'Deltares','Deltares','Deltares','Deltares'                ,'TeamStad'          ,'Arcadis'         ,'Deltares'       ,'TeamStad'      ,'Deltares'             ,'Deltares'             ,'Deltares'           ];
		attribute<string>      BronOnderhoudskosten: ['Deltares','Deltares','Deltares'      ,'Deltares','Deltares','Deltares','Deltares'                ,'Deltares'          ,'Arcadis'         ,'Deltares'       ,'Deltares'      ,'Deltares'             ,'Deltares'             ,'Deltares'           ];
		attribute<bool>       OpslagIndirecteKosten: [true      ,true      ,false           ,false ,false     ,false       ,false                     ,true                ,false             ,false            ,true            ,false                  ,false                  ,false                ];
		attribute<bool>       HeeftBenodigdeVelddata: [false     ,false     ,true            ,true  ,true      ,false       ,false                     ,false               , true             , true            ,false           ,true                   ,true                   ,true                 ];
		attribute<Eur_m2> ReferentiekostenRegulier: [0         ,0         ,30              ,7     ,0         ,0           ,0                         ,0                   ,0                 ,0                ,0               ,30                     ,30                     ,30                   ];

		attribute<Eur_m2> AanlegkostenInclOpslag := Aanlegkosten * (1f + float32(OpslagIndirecteKosten) * /ModelParameters/Piekbuiberging/OpslagIndirecteKosten)
		, Descr = "De aanlegkosten zoals de lezers ze horen te gebruiken (#798): het kental uit de bron met de opslag voor bouwplaatskosten en planuitwerking erop waar de bron die apart noemt, dus alleen bij
					de rijen van team Stad, zie de kolom OpslagIndirecteKosten; zo staat de opslag op een plek. Het bedrag voor bestaand gebied, waar de maatregel iets vervangt dat er al ligt; voor nieuwbouw
					geldt MeerkostenTovRegulier.";

		attribute<Eur_m2> MeerkostenTovRegulier := max_elem(AanlegkostenInclOpslag - ReferentiekostenRegulier, 0[Eur_m2])
		, Descr = "Wat de maatregel in een nieuwe wijk extra kost boven de uitvoering die er zonder bergingsambitie zou liggen (#798); gelezen door
					Templates/VariantData_T/Geschiktheden/Piekbuibergingkosten.dms, de post in het exploitatiesaldo van wonen. Nieuwbouw draagt een ander bedrag dan bestaand gebied omdat de grondproductiekosten
					in het saldo de straat die er sowieso komt al dekken; de volle aanlegprijs van halfverharding zou het wegdek twee keer betalen. ReferentiekostenRegulier draagt per maatregel wat de reguliere
					uitvoering kost: halfverharding 30 euro per m2, afgeleid uit wat de Fakton-component BouwWoonrijp in dit model voor verharding rekent bij ongeveer 3.000 m2 openbare verharding per hectare;
					de wadi het kental van gazonaanleg, want die ligt in groen dat er ook zonder ambitie zou zijn; de andere maatregelen nul omdat zij niets vervangen. De hele kolom op nul geeft de volle prijs
					in het saldo; de discussie met Deltares over deze waarden staat open in #798.";
		
		attribute<string> Label := name;
		
		container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		
		unit<uint8> MetBenodigdeVelddata := select_with_org_rel(WaterretentieK/HeeftBenodigdeVelddata == true)
		{
			attribute<string>           name                   := WaterretentieK/name[org_rel];
			attribute<m3_m2>            Bergingscapaciteit     := WaterretentieK/Bergingscapaciteit[org_rel];
			attribute<Eur_m2>           AanlegkostenInclOpslag := WaterretentieK/AanlegkostenInclOpslag[org_rel];
			attribute<Eur_m2_jaarlijks> Onderhoudskosten       := WaterretentieK/Onderhoudskosten[org_rel];
			
			attribute<string> Label := name;
		
			container V := for_each_nedv(AsItemName(name), string(id(.))+'[..]', void, .);
		}
	}
	
	container CO2
	{
		unit<uint8> EmissieK: NrOfRows = 3
		{
			attribute<string> name: ['Minimum', 'Mediaan', 'Maximum'];
			attribute<string> label := name;
		}
		
		unit<uint8> PrijsK: NrOfRows = 2
		{
			attribute<string> name: ['Minimum', 'Maximum'];
			attribute<string> label := name;
			attribute<Eur_ton> Prijs := union_data(., ModelParameters/Landbouw/CO2_prijs_minimum, ModelParameters/Landbouw/CO2_prijs_maximum);
		}
		
		unit<uint32> EmissieXPrijsK := combine(EmissieK, PrijsK)
		{
			attribute<string> Emissie_name := EmissieK/name[first_rel];
			attribute<string> Prijs_name := PrijsK/name[second_rel];
			attribute<string> label := 'Emissies'+Emissie_name+'_'+'Prijs'+Prijs_name;
			attribute<string> name := replace(label, '_', '/');
			attribute<Eur_ton> Prijs := PrijsK/Prijs[second_rel];
		}
	}
}