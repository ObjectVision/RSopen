				parameter<String> FunderingschadeWordtHersteld                       := asList(string(VariantK/FunderingschadeWordtHersteld),               ',');
				
				//werken
				parameter<String> EvidentBenutVariant_Werken                         := asList(VariantK/EvidentBenutVariant_Werken,                         ',');
				parameter<String> RestrictiesVariant_Werken                          := asList(VariantK/RestrictiesVariant_Werken,                          ',');
				parameter<String> StimuliVariant_Werken                              := asList(VariantK/StimuliVariant_Werken,                              ',');
				parameter<String> MinimumDichtheidToenameWerken                      := asList(string(VariantK/MinimumDichtheidToenameWerken),              ',');
				parameter<String> m2BVO_job_Kantoor                                  := asList(string(VariantK/m2BVO_job_Kantoor),                          ',');
				parameter<String> Groeifactor_Nijverheid                             := asList(string(VariantK/Groeifactor_Nijverheid),                     ',');
				parameter<String> Groeifactor_Logistiek                              := asList(string(VariantK/Groeifactor_Logistiek),                      ',');
				parameter<String> Groeifactor_Detailhandel                           := asList(string(VariantK/Groeifactor_Detailhandel),                   ',');
				parameter<String> Groeifactor_Ov_consumentendiensten                 := asList(string(VariantK/Groeifactor_Ov_consumentendiensten),          ',');
				parameter<String> Groeifactor_Zak_dienstverlening                    := asList(string(VariantK/Groeifactor_Zak_dienstverlening),             ',');
				parameter<String> Groeifactor_Overheid_kw_diensten                   := asList(string(VariantK/Groeifactor_Overheid_kw_diensten),            ',');
				
				//wonen en werken
				parameter<String> VerhardingTovDefault                               := asList(string(VariantK/VerhardingTovDefault),                       ',');
				parameter<String> ClaimVariantName                                   := asList(VariantK/ClaimVariantName,                                   ',');
				parameter<String> DichtheidFactorGeneriek                            := asList(string(VariantK/DichtheidFactorGeneriek),                    ',');
				parameter<String> DichtheidFactorOV_EG                               := asList(string(VariantK/DichtheidFactorOV_EG),                       ',');
				parameter<String> DichtheidFactorOV_MG                               := asList(string(VariantK/DichtheidFactorOV_MG),                       ',');
				parameter<String> DichtheidFactorOV_NietWonen                        := asList(string(VariantK/DichtheidFactorOV_NietWonen),                ',');
