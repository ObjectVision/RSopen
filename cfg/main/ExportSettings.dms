			container VariantParameters : using = "/VariantParameters"
			{
				parameter<String> VariantNames := asList(VariantK/name, ',');
				
				//wonen
				parameter<String> OntwikkelPakketVariant                             := asList(VariantK/OntwikkelPakketVariant,                           ',');
