////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #705, verwijderen zodra de getallen in het issue staan.
//
// Meet de arealen van de landschapsregio-indeling in SourceData/Landschap/LandschapsRegio: hectares per regio, het
// restant zonder regio binnen Nederland (de grote wateren en de cellen zonder basisklasse), en per landschapsteam
// hoeveel van het eigen leverings- of begrenzingsgebied ook in de eigen regio valt. Dat laatste laat zien wat de
// prioriteitsvolgorde kust, rivieren, veen, zand aan de andere landschappen afstaat.
//
// De indeling hangt niet aan een casus of zichtjaar, dus DiagCasus en DiagJaar spelen hier geen rol.
// Draai het item Tabel.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose705
: using = "Geography"
, Descr = "Tijdelijk meetharnas voor #705: arealen van de landschapsregio-indeling."
{
	unit<UInt32> LR := /SourceData/Landschap/LandschapsRegio;

	parameter<float32> CelHa := AdminDomain/NrHaPerCell[float32];

	parameter<float64> ha_kust     := sum(float64(float32(LR/Per_AdminDomain == LR/V/Kust)     * CelHa));
	parameter<float64> ha_rivieren := sum(float64(float32(LR/Per_AdminDomain == LR/V/Rivieren) * CelHa));
	parameter<float64> ha_veen     := sum(float64(float32(LR/Per_AdminDomain == LR/V/Veen)     * CelHa));
	parameter<float64> ha_zand     := sum(float64(float32(LR/Per_AdminDomain == LR/V/Zand)     * CelHa));
	parameter<float64> ha_overig   := sum(float64(float32(LR/Per_AdminDomain == LR/V/Overig)   * CelHa));

	parameter<float64> ha_leeg_grootwater_nl := sum(float64(float32(IsNull(LR/Per_AdminDomain) && AdminDomain/IsCompactedDomain && LR/Impl/IsGrootWater) * CelHa))
	, Descr = "Groot water binnen de provinciegrenzen zonder regio: Waddenzee, IJsselmeer en verwanten. Dit is het deel dat volgens #705 bewust buiten de indeling blijft.";
	parameter<float64> ha_leeg_overig_nl     := sum(float64(float32(IsNull(LR/Per_AdminDomain) && AdminDomain/IsCompactedDomain && !LR/Impl/IsGrootWater) * CelHa))
	, Descr = "Cellen binnen de provinciegrenzen zonder regio en zonder grootwatervlag. Hoort nul te zijn: IsOverig vangt elke landcel binnen Nederland.";
	parameter<float64> ha_basis_null_nl      := sum(float64(float32(IsNull(LR/Impl/Basis) && AdminDomain/IsCompactedDomain && !LR/Impl/IsGrootWater) * CelHa))
	, Descr = "Landcellen binnen Nederland waar beide basiskaarten geen klasse geven. Die worden Overig of een teamgebied; dit getal zegt hoe groot die terugval is.";

	parameter<float64> ha_go_viabnsn := sum(float64(float32(IsNull(LR/Impl/Basis_Gebiedstype) && IsDefined(LR/Impl/Basis_BNSN)) * CelHa))
	, Descr = "Cellen waar het gebiedstypenraster niets zegt, vrijwel alleen de gebouwde omgeving, en de BNSN-terugval wel een landschap geeft. Hoort in de buurt van het GO-areaal van 491.105 ha te liggen; nul betekent dat de terugval niet werkt.";

	parameter<float64> ha_kustlevering        := sum(float64(float32(LR/Impl/InKustlevering) * CelHa));
	parameter<float64> ha_kustlevering_eigen  := sum(float64(float32(LR/Impl/InKustlevering && LR/Per_AdminDomain == LR/V/Kust) * CelHa));
	parameter<float64> ha_rivierengebied      := sum(float64(float32(LR/Impl/InRivierengebied) * CelHa));
	parameter<float64> ha_rivierengebied_eigen:= sum(float64(float32(LR/Impl/InRivierengebied && LR/Per_AdminDomain == LR/V/Rivieren) * CelHa));
	parameter<float64> ha_veengebied          := sum(float64(float32(LR/Impl/InVeengebied) * CelHa));
	parameter<float64> ha_veengebied_eigen    := sum(float64(float32(LR/Impl/InVeengebied && LR/Per_AdminDomain == LR/V/Veen) * CelHa));
	parameter<float64> ha_zandgebied          := sum(float64(float32(LR/Impl/InZandgebied) * CelHa));
	parameter<float64> ha_zandgebied_eigen    := sum(float64(float32(LR/Impl/InZandgebied && LR/Per_AdminDomain == LR/V/Zand) * CelHa));

	// waar staan de teamgebieden hun hectares aan af: verdeling over de andere regio's
	parameter<float64> ha_rivierengebied_kust := sum(float64(float32(LR/Impl/InRivierengebied && LR/Per_AdminDomain == LR/V/Kust) * CelHa));
	parameter<float64> ha_veengebied_kust     := sum(float64(float32(LR/Impl/InVeengebied && LR/Per_AdminDomain == LR/V/Kust) * CelHa));
	parameter<float64> ha_veengebied_rivieren := sum(float64(float32(LR/Impl/InVeengebied && LR/Per_AdminDomain == LR/V/Rivieren) * CelHa));
	parameter<float64> ha_zandgebied_kust     := sum(float64(float32(LR/Impl/InZandgebied && LR/Per_AdminDomain == LR/V/Kust) * CelHa));
	parameter<float64> ha_zandgebied_rivieren := sum(float64(float32(LR/Impl/InZandgebied && LR/Per_AdminDomain == LR/V/Rivieren) * CelHa));
	parameter<float64> ha_zandgebied_veen     := sum(float64(float32(LR/Impl/InZandgebied && LR/Per_AdminDomain == LR/V/Veen) * CelHa));

	parameter<String> Tabel :=
		  'post;ha'
		+ '|regio_kust;'                + string(ha_kust)
		+ '|regio_rivieren;'            + string(ha_rivieren)
		+ '|regio_veen;'                + string(ha_veen)
		+ '|regio_zand;'                + string(ha_zand)
		+ '|regio_overig;'              + string(ha_overig)
		+ '|leeg_grootwater_nl;'        + string(ha_leeg_grootwater_nl)
		+ '|leeg_overig_nl;'            + string(ha_leeg_overig_nl)
		+ '|basis_null_nl;'             + string(ha_basis_null_nl)
		+ '|go_viabnsn;'                + string(ha_go_viabnsn)
		+ '|kustlevering;'              + string(ha_kustlevering)
		+ '|kustlevering_eigen;'        + string(ha_kustlevering_eigen)
		+ '|rivierengebied;'            + string(ha_rivierengebied)
		+ '|rivierengebied_eigen;'      + string(ha_rivierengebied_eigen)
		+ '|veengebied;'                + string(ha_veengebied)
		+ '|veengebied_eigen;'          + string(ha_veengebied_eigen)
		+ '|zandgebied;'                + string(ha_zandgebied)
		+ '|zandgebied_eigen;'          + string(ha_zandgebied_eigen)
		+ '|rivierengebied_naar_kust;'  + string(ha_rivierengebied_kust)
		+ '|veengebied_naar_kust;'      + string(ha_veengebied_kust)
		+ '|veengebied_naar_rivieren;'  + string(ha_veengebied_rivieren)
		+ '|zandgebied_naar_kust;'      + string(ha_zandgebied_kust)
		+ '|zandgebied_naar_rivieren;'  + string(ha_zandgebied_rivieren)
		+ '|zandgebied_naar_veen;'      + string(ha_zandgebied_veen)
	, StorageName = "%LocalDataProjDir%/Diagnose/705_landschapsregio.txt"
	, StorageType = "str"
	, Descr = "Een regel per post, puntkomma-gescheiden, regels gescheiden door een liggend streepje.";
}
