////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Met deze file kan in achtereenvolgende runs de zgn. baseData (Data die generiek zijn en relatief veel rekentijd kosten om te produceren) worden ge�xporteerd.
// De Data worden weggeschreven naar de LocalDataDir. Het model gaat er default vanuit dat het deze 'ontkoppelde' Data kan gebruiken, en dus niet hoeft te (her)genereren.
// Dit laatste kan worden aangepast in de /ModelParameters of worden 'overruled' vanuit de batch omgeving
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container WriteBaseData : using = "Classifications"
{
	parameter<String> Generate_Run1 :=
		  Impl/Write_BAG_WP5_rel;

	parameter<String> Generate_Run2 :=
		  Impl/BBG
		+ Impl/MakeWindBuffersBGT //alleen wanneer de windsector meedraait
		+ Impl/IsAutowegKlaverbladFix
		+ Impl/PopK_Buffers_UrbanContour //de begrenzing van 2022, sinds #749 de enige bron
		+ Impl/Verwervingskosten
		+ Impl/BRT_Vergriddingen
		+ Impl/IBIS_Zeefafgeleiden
		+ Impl/Groenfracties
		+ Impl/MakeNBP //de beheertypenkaart van het basisjaar (#776), alleen wanneer het basisjaar een beheertypenkaart leest
		+ Impl/MakeMNP //de planpotentieelkaart van de WUR op 25 meter (#795), alleen wanneer het basisjaar, de natuuroplegging of een landschapslevering hem leest
		, Descr = "Activeer dit item om alle te ontkoppelen base data te genereren.";

		parameter<String> Generate_Run3 :=
		  Impl/StateBasisjaar
		+ Impl/Verdeling_VSSH_Proxy
		+ Impl/Sloopkosten
		+ Impl/Werken_Geschiktheid
		+ Impl/MakeWaterbergingNormen //alleen wanneer de sector Waterberging meedraait
		+ Impl/AfstandsKernels
		+ Impl/MakeZonneladder
		+ Impl/MakeVerblijfsrecreatie_Trends
		+ Impl/TIGRISClaims //de claims in LocalData; ze lezen geen basedata en niets in Run1 tot en met Run3 leest ze
		+ Impl/MakeWoningtypeEengezins //het gebouwde aandeel per woningtype binnen eengezins; leest de WP5-mmd van Run1, alleen wanneer wonen meedraait
		, Descr = "Activeer dit item om de basedata te genereren die op Run1 en Run2 voortbouwt, de claims in LocalData inbegrepen. Een eigen proces na Run2: de proxies lezen de WP5-mmd van Run1 en de GrootWater-buffer in AfstandsKernels de BBG-tifs van Run2.";

		parameter<String> Generate_Run4_IndicatorenData :=
		  Impl/MakeGroenBruinBlauwVerhard
		+ Impl/MakeWaterbergingCapaciteit
		, Descr = "Activeer dit item om de ontkoppelde base data te genereren die de indicatoren van deze projectlijn nodig hebben; welke dat zijn volgt uit ModelParameters/Indicatoren/Domein.
					De BGT-oppervlakken groen, bruin en water geven samen de verharding van het basisjaar en daarmee de landgebruikskaart, en alles wat die kaart leest; zonder de rij Landgebruikskaart blijven ze weg. WaterbergingCapaciteit
					hoort bij het domein Water: Templates/Indicatoren/Piekbuiberging/Aanbod.dms leest de zes capaciteitslagen in container OpOverigePlekken, en ontbreken de tifs, dan geeft de keten per laag een
					GDAL-fout met een lege laag als uitkomst (#757).";
	
	container Impl
	{
		parameter<String> StateBasisjaar                := 'Ready', ExplicitSuppliers = "BaseData/StartState/StateBasisjaar/Write/Generate;BaseData/StartState/Verdeling_VSSH/Checks/WoningstandSluitendMetBAG", Descr = "Schrijft de stand in het basisjaar voor alle subsectoren weg; voorkomt dat deze zwaar berekende startdata bij elke variant-run opnieuw gegenereerd moeten worden. Controleert daarbij via de Checks dat de woningstand sluit met het aantal woon-vbo's in de BAG.";
		parameter<String> Verdeling_VSSH_Proxy          := 'Ready', ExplicitSuppliers = "BaseData/StartState/Verdeling_VSSH/Per_AllocRegios/Generate_Wonen", Descr = "Genereert de verdeling van woningsubectoren (VrijeSector/SocialeHuur) voor alle allocatieregios.";
		parameter<String> WoningtypeEengezins           := 'Ready', ExplicitSuppliers = "BaseData/StartState/WoningtypeEengezins/Decoupling/Write_Fingerprint", Descr = "Schrijft het gebouwde aandeel per woningtype binnen eengezins per regio van de eerste allocatieregio van wonen, met het zijbestand; de schrijvers hangen onder Write_Fingerprint (#847).";
		parameter<String> MakeWoningtypeEengezins       := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'WoningtypeEengezins' : quote('NotNeeded'), Descr = "Alleen wanneer wonen meedraait; zonder wonen is er geen eerste allocatieregio van wonen.";
		unit<UInt32> TIGRISClaims_Case := select_with_org_rel(
				Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Zichtjaar_value <= ModelParameters/Advanced/FromWhichDoWeKeepTIGRISconstant
			&&	Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Variant_name == VariantParameters/VariantK/ClaimVariantName[Classifications/Modellering/AllCases/variant_rel[Classifications/Modellering/ZichtjaarxTXLClaimsxCase/second_rel]])
		, Descr = "De claimjaren, claims en casussen waarvoor TIGRIS-claims worden geschreven: elk jaar van Time/ClaimJaar tot en met FromWhichDoWeKeepTIGRISconstant, het basisjaar inbegrepen, want de
					leeskant ankert de claim daarop, en alleen de varianten met eigen TIGRIS-claims (VariantK/ClaimVariantName). Latere zichtjaren lezen de map van FromWhichDoWeKeepTIGRISconstant
					(Templates/Claims/ZichtjaarXScenarioxAllocRegios.dms, TIGRIS_Jaar_name) en de andere varianten die van hun claimvariant; voor hen heeft de levering ook geen bronbestanden.";
		unit<UInt32> TIGRISClaims_Bestand := combine(TIGRISClaims_Case, Classifications/Modellering/AllocRegiosK/TigrisRegios)
		{
			attribute<String> Pad := 'PrivData/Claims/AggregateToRegions/'+Classifications/Modellering/ZichtjaarxTXLClaimsxCase/name[TIGRISClaims_Case/org_rel[first_rel]]+'/AllocRegios/'+Classifications/Modellering/AllocRegiosK/TigrisRegios/name[second_rel]+'/Write';
		}
		parameter<String> TIGRISClaims                  := 'Ready', ExplicitSuppliers = "=AsList(TIGRISClaims_Bestand/Pad, ';')", Descr = "Schrijft de TIGRIS-claims voor wonen en werken per claimjaar en allocatieregio naar LocalData (PrivData/Claims/WonenEnWerken/ClaimRef), uit de levering in %PrivDataDir%.";
		parameter<String> IsAutoweg                     := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/IsAutoweg/Make_Per_AdminDomain", Descr = "Maakt de buffer rond autosnelwegen op de afstand uit ModelParameters/Wind/BufferSizeSnelwegenVoorWindRestrictie. Enige lezer is de windtak van de zeef, dus deze staat achter MakeWindBuffersBGT.";
		parameter<String> IsAutowegKlaverbladFix        := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/IsAutoweg/FixKlaverbladen/Make_Per_AdminDomain", Descr = "Voert correcties uit op knooppunten (klaverbladen) in de autosnelweg-laag om artefacten en overlapfouten te verwijderen; zorgt voor correcte uitsluitingen bij analyses.";
		parameter<String> IsSpoorweg                    := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/IsSpoorbaan/Make_Per_AdminDomain", Descr = "Maakt de buffer rond spoorbanen op dezelfde afstand als de autowegbuffer. Enige lezer is de windtak van de zeef, dus deze staat achter MakeWindBuffersBGT.";
		parameter<String> BBG                           := 'Ready', ExplicitSuppliers = "='/SourceData/Grondgebruik/BBG/Dominant/impl/Make25mgrids_Modus/Y'+ModelParameters/BBG_Year+'/DominantCBSKlasse_25m;/SourceData/Grondgebruik/BBG/Dominant/impl/Make100mgrids_Modus/Y'+ModelParameters/BBG_Year+'/DominantCBSKlasse_100m'", Descr = "Produceert de BBG-laag op 25 en 100 meter voor de jaargang die ModelParameters/BBG_Year aanwijst; het model leest alleen die jaargang, want Grondgebruik/gg_CBS en Basisjaar stellen hun pad
					samen met BBG_Year en de 5m-afgeleiden komen rechtstreeks uit de bronpolygonen. Zet BBG_Year op een andere jaargang en deze regel maakt die. Loop dan
					BaseData/Suitabilities/Waterberging/IsMeer na, dat Y2022 met de hand noemt in plaats van via BBG_Year en de tif van 2022 dus ook wil als BBG_Year iets anders zegt; een ontbrekende tif geeft
					een GDAL-fout met een lege laag, zie Generate_Run3.";
		
		parameter<String> GroenBruinBlauwVerhard        := GroenOpp_AdminDomain + WaterOpp_AdminDomain + BruinOpp_AdminDomain /*+ VerhardOpp_AdminDomain*/; //VerhardOpp uitgezet augustus 2026: de tif wordt nergens gelezen, de verhardingsindicator gebruikt het afgeleide rekenitem. Weer aanzetten als er een echte lezer komt.
		parameter<String> GroenOpp_AdminDomain          := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_GroenOpp_AdminDomain", Descr = "Produceert de 'Groen oppervlakte' laag per admindomain: Obv fractie groen uit BGT, relevant voor BereikbaarheidGroen indicator.";
		parameter<String> WaterOpp_AdminDomain          := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_WaterOpp_AdminDomain", Descr = "Produceert de 'Water oppervlakte' laag per admindomain: Obv fractie groen uit BGT, relevant voor diversen.";
		parameter<String> BruinOpp_AdminDomain          := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_BruinOpp_AdminDomain", Descr = "Produceert de 'Bruin oppervlakte' laag per admindomain: Obv fractie groen uit BGT, relevant voor diversen.";
		parameter<String> VerhardOpp_AdminDomain        := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_VerhardOpp_AdminDomain", Descr = "Produceert de 'verharde oppervlakte' laag per admindomain: relevant voor diversen.";
		
		parameter<String> WaterbergingCapaciteit                      := HalfverhardingCapaciteit_AdminDomain + HolleWegCapaciteit_AdminDomain + WadiCapaciteit_AdminDomain + HalfverhardingWijkwegCapaciteit_AdminDomain + HalfverhardingWoonerfCapaciteit_AdminDomain + HalfverhardingInritCapaciteit_AdminDomain;
		parameter<String> HalfverhardingCapaciteit_AdminDomain        := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_HalfverhardingCapaciteit_AdminDomain";
		parameter<String> HolleWegCapaciteit_AdminDomain              := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_HolleWegCapaciteit_AdminDomain";
		parameter<String> WadiCapaciteit_AdminDomain                  := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_WadiCapaciteit_AdminDomain";
		parameter<String> HalfverhardingWijkwegCapaciteit_AdminDomain := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_HalfverhardingWijkwegCapaciteit_AdminDomain";
		parameter<String> HalfverhardingWoonerfCapaciteit_AdminDomain := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_HalfverhardingWoonerfCapaciteit_AdminDomain";
		parameter<String> HalfverhardingInritCapaciteit_AdminDomain   := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/Make_HalfverhardingInritCapaciteit_AdminDomain";
		
		parameter<String> PopK_Buffers_UrbanContour              := 'Ready', ExplicitSuppliers = "SourceData/RegioIndelingen/BegrenzingBebouwdGebied/Maak_PopK_Buffers/Generate", Descr = "Dezelfde bufferzones, maar rond de bebouwde gebieden van de eigen begrenzing met het inwonertal uit de CBS-vierkanten (#749, op 25 meter sinds #759). Schrijft naar dezelfde map met prefix UrbanContour_, dus naast de set van de bevolkingskernen en niet eroverheen. De set die de trede leest (#749).";

		// De triggers hieronder wijzen naar de kanonieke schakel-items (Decoupling/MayReuse ? Read : Make) en niet
		// rechtstreeks naar de Make-items. Zo schrijft een basedata-run alleen wat ontbreekt of een verouderde
		// fingerprint heeft, en delen alle lezers binnen een proces dezelfde uitkomst zonder lees/schrijf-race op
		// hetzelfde bestand. Het fingerprint-zijbestand hangt als ExplicitSupplier aan elk Make-item zelf.
		parameter<String> BRT_Vergriddingen             := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain;SourceData/Grondgebruik/BRT/IsBRTEvidentBenut/Per_AdminDomain", Descr = "De BRT-vergriddingen per admindomain: woonkernen (vormtoets van de allocatie, grondproductiekosten) en dierentuinen of openluchtmusea (zeef basisjaar). Jaar- en variantinvariant; werden tot augustus 2026 in elk zichtjaarproces opnieuw uit de top10nl-gpkg vergrid.";
		parameter<String> IBIS_Zeefafgeleiden           := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/IBIS/Result/RestrictiefWonen;SourceData/Grondgebruik/IBIS/Result/RestrictiefGevoeligeWerkfuncties;SourceData/Grondgebruik/IBIS/Result/IsVol_grid;SourceData/Grondgebruik/IBIS/Result/IsBedrijfsmatigTerrein", Descr = "De vier IBIS-afgeleiden die de zeef en de omgekeerde milieuzonering lezen: de woonbuffer en de buffer voor gevoelige werkfuncties rond werklocaties, de vol-status per cel van 25 meter en de ligging op bestaand bedrijfsmatig terrein. De jaargangenstapeling 2016-2024 met geos-buffers draaide tot augustus 2026 in elk zichtjaarproces.";
		parameter<String> Groenfracties                 := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/LGN/Groenfracties/n_gedekt_500m;SourceData/Grondgebruik/LGN/Groenfracties/fr_water_500m;SourceData/Grondgebruik/LGN/Groenfracties/n_gedekt_2500m_100m;SourceData/Grondgebruik/LGN/Groenfracties/fr_natuur_tot2500m_100m", Descr = "De basisjaar-groenfracties uit de LGN met hun noemers. Allocatie (GroenNabijheid, #637) en indicator (WaardeNabijheidGroen, #566) lezen dezelfde kanonieke items en dus dezelfde bestanden.";
		parameter<String> Sloopkosten                   := 'Ready', ExplicitSuppliers = "BaseData/Suitabilities/Wonen/Sloopkosten/Totaal;BaseData/Suitabilities/Wonen/Sloopkosten/Totaal_niet_woningen", Descr = "De sloopkostenkaarten van de bestaande voorraad (woningen en niet-woningen) voor het exploitatiesaldo. Staat in run2 omdat de kaarten de basisjaar-BAG-keten lezen die daar toch al opgebouwd wordt voor StateBasisjaar; dit dicht ook de gemengde vintage waarin sloopkosten live naast de verwervingskosten-tif stonden.";
		parameter<String> Werken_Geschiktheid           := 'Ready', ExplicitSuppliers = "=asList('BaseData/Suitabilities/Werken/ProbabilityMap_perSector/'+Classifications/Actor/TXLJobs6/name+'/raw', ';')", Descr = "De statische werken-geschiktheidskaart (raw) per Jobs6-sector. De dynamische kaart per zichtjaar telt alleen delta's op bij deze statische raw; de csv-coefficienten blijven live want die zijn voor de delta-berekening nodig en kosten seconden. Run2 omdat raw de UAI_dynamisch bevat en die de BAG leest.";
		parameter<String> WaterbergingNormen            := 'Ready', ExplicitSuppliers = "BaseData/Suitabilities/Waterberging/Depth_Norm;BaseData/Suitabilities/Waterberging/InvUAI_Norm;BaseData/Suitabilities/Waterberging/IsMeer_Nabij_Norm;BaseData/Suitabilities/Waterberging/IsVeen_Nabij_Norm;BaseData/Suitabilities/Waterberging/Kwel_Norm;BaseData/Suitabilities/Waterberging/Wegzijging_Norm;BaseData/Suitabilities/Waterberging/IsDiepGenoeg", Descr = "De variant-onafhankelijke waterberging-geschiktheidsnormen; de variantweging blijft live in Suitability_Zichtjaar_T. Run2 omdat InvUAI_Norm via de UAI aan de BAG hangt.";
		parameter<String> AfstandsKernels               := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Ring_rel_100m;BaseData/Omgeving/GrootWater1500mBuffer;BaseData/Omgeving/N2K1000mBuffer;SourceData/Grondgebruik/NWB/Stichtse_Rotonde/Per_AdminDomain", Descr = "De jaar- en variantinvariante afstandskernels: de NNN-ringkaart op 100m, de buffers rond Natura2000 en groot water, en de Stichtse Rotonde. Run2 omdat de GrootWater-buffer de ontkoppelde BBG-tifs uit run1 leest.";
		parameter<String> Verwervingskosten             := 'Ready', ExplicitSuppliers = "BaseData/Suitabilities/Wonen/Verwervingskosten/Generate", Descr = "Berekent en schrijft verwervingskosten voor woonlocaties/totale suitability; noodzakelijk voor kostenafwegingen bij allocatie en haalbaarheidsberekeningen.";
		// De twee triggers hieronder vragen alleen het fingerprint-zijbestand: de geschreven items staan als Writers
		// onder de Decoupling en hangen dus onder dat zijbestand, zodat het pas ontstaat als de bestanden er staan
		// (#837). Het blijft de trigger die het zijbestand maakt en niet het geschreven item zelf, want dit zijn
		// containers en ExplicitSuppliers lift op containerniveau niet mee wanneer je een los kind opvraagt. Vraag je
		// zo'n bestand rechtstreeks op zonder deze trigger, dan wordt het wel gerekend en geschreven maar komt er
		// geen zijbestand, en rekent de volgende run het opnieuw uit.
		parameter<String> Zonneladder                   := 'Ready', ExplicitSuppliers = "BaseData/Zonneladder/PerAdminDomain/Decoupling/Write_Fingerprint", Descr = "Schrijft de 'zonneladder' (geprioritiseerde locaties voor zonprojecten) per allocdomain; wordt gebruikt door de zonnesector voor plaatsing en ranking van locaties.";
		parameter<String> Verblijfsrecreatie_Trends     := 'Ready', ExplicitSuppliers = "BaseData/StartState/Verblijfsrecreatie_Trends/Trends/Decoupling/Write_Fingerprint", Descr = "Schrijft trends en beta-parameters voor de verblijfsrecreatie-sector; deze trendparameters sturen de ontwikkeling over runs.";
		
		parameter<String> MakeVerblijfsrecreatie_Trends := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'Verblijfsrecreatie_Trends' : quote('NotNeeded'), Descr = "Schakelt het genereren van verblijfsrecreatie-trends in wanneer de sector aanwezig is; voorkomt onnodige berekeningen voor niet-relevante varianten.";
		parameter<String> MakeZonneladder               := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasZonSector ? 'Zonneladder' : quote('NotNeeded'), Descr = "Schakelt het genereren van de zonneladder in wanneer de zonsector is opgenomen in de variant; bespaart rekentijd als zon niet relevant is.";
		parameter<String> MakeWindBuffersBGT            := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'WindBuffersBGT' : quote('NotNeeded'), Descr = "Schakelt de twee BGT-buffers voor de windrestrictie in wanneer de windsector meedraait. De leeskant staat op dezelfde voorwaarde:
																																												Templates/Beschikbaarheden/Zeef_Basisjaar_T/IsEvidentBenut_obv_BGT_wind is de enige lezer van IsAutoweg/Per_AdminDomain en IsSpoorbaan/Per_AdminDomain, en die tak staat op IsThisSectorWind,
																																												dus zonder windsector worden de twee tifs geschreven en nooit gelezen. IsAutowegKlaverbladFix valt hier bewust niet onder: die kaart is de autoweg inclusief op- en afritten, hangt niet aan
																																												de windbuffer en wordt in elk zichtjaarproces gelezen.";
		parameter<String> MakeWaterbergingNormen        := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWaterbergingSector ? 'WaterbergingNormen' : quote('NotNeeded'), Descr = "Schakelt de waterberging-geschiktheidsnormen in wanneer de sector Waterberging meedraait; de enige lezer is de geschiktheid van die sector.";
		parameter<String> MakeGroenBruinBlauwVerhard    := =/ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Landgebruikskaart] ? 'GroenBruinBlauwVerhard' : quote('NotNeeded')
		, Descr = "Schakelt de BGT-oppervlakken in wanneer de projectlijn de landgebruikskaart levert (ModelParameters/Indicatoren/Domein): de kaart leest ze via de verharding van het basisjaar, en de domeinen Water, Natuur en Landbouw lezen de kaart.";
		parameter<String> MakeWaterbergingCapaciteit    := =/ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Water] ? 'WaterbergingCapaciteit' : quote('NotNeeded'), Descr = "Schakelt de bergingscapaciteiten van de piekbuiberging in wanneer de projectlijn het domein Water levert.";
		parameter<String> WindBuffersBGT                := IsAutoweg + IsSpoorweg, Descr = "De twee windrestrictiebuffers samen, zodat MakeWindBuffersBGT er een naam voor heeft om naar te wijzen.";
		parameter<String> MakeNBP                       := =ModelParameters/Natuur/Beheertype_Basisjaar_Bron != 'Heuristiek' ? 'NBP' : quote('NotNeeded'), Descr = "Schakelt de NBP-kaart in wanneer het basisjaar een beheertypenkaart leest (ModelParameters/Natuur/Beheertype_Basisjaar_Bron): BaseData/StartState/Landgebruik leest het NBP dan als bron of tweede kaart, en als vastgesteld beheertype op grasland.";
		parameter<String> MakeMNP                       := =ModelParameters/Natuur/Beheertype_Basisjaar_Bron != 'Heuristiek' || ModelParameters/Natuur/NatuurOpleggen || any(VariantParameters/VariantK/HeeftLandschapslevering) ? 'MNP' : quote('NotNeeded'), Descr = "Schakelt de MNP-kaart in wanneer iets haar leest: het basisjaar als bron of tweede kaart, de natuuroplegging als levering (Templates/VariantData/Natuur/Natuur_T) en een landschapslevering als planpotentieel (Veen_T).";
		parameter<String> NBP                           := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/NBP/INL_Beheertype_AD", Descr = "Rastert het Natuurbeheerplan 2026 naar 25 meter en schrijft de ontkoppelde tif met fingerprint (#776). Staat in run 2 omdat BaseData/StartState/Landgebruik/Type erop rust en de basisjaarstand van run 3 die leest.";
		parameter<String> MNP                           := 'Ready', ExplicitSuppliers = "SourceData/Grondgebruik/Natuur/Bron/Landelijk_BAU/INL_beheertypen_25m", Descr = "Vat de MNP-planpotentieelkaart van de WUR samen van 2,5 naar 25 meter en schrijft de ontkoppelde tif met fingerprint (#795). Naast NBP, want BaseData/StartState/Landgebruik/Beheertype leest
					hem als tweede kaart en de BAU-oplegging leest hem als levering. Kost enkele minuten, want de bron telt ruim veertien miljard cellen. Een kaart die naast de bron op de share staat en door
					geen enkele run wordt gemaakt geeft bij verwijdering een lege laag zonder foutmelding; daarom wordt hij hier gemaakt.";
		parameter<String> Write_BAG_WP5_rel             := 'Ready', ExplicitSuppliers = "='SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/pand/AfleidingPandType/Write_WP5/WP5_rel; SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/pand_alle_statussen/AfleidingPandType/Write_WP5/WP5_rel; SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/BAG_RecentYear)+'/pand/AfleidingPandType/Write_WP5/WP5_rel; SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/BAG_RecentYear)+'/pand_alle_statussen/AfleidingPandType/Write_WP5/WP5_rel; SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/pand_alle_statussen_toekomst/AfleidingPandType/Write_WP5/WP5_rel; SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/BAG_RecentYear)+'/pand_alle_statussen_toekomst/AfleidingPandType/Write_WP5/WP5_rel'", Descr ="Voor debug purposes";
	}
}


