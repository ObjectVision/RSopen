// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Wat het model afleidt uit de BAG die SourceData/Vastgoed/BAG inleest (#440): de woonpandtypering WP5 per
// pandenset en jaar, als ontkoppelde mmd in LocalData. Laadt via #include: AfleidingPandType.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BAG: using = "/SourceData/Vastgoed/BAG;Classifications/Vastgoed;Classifications"
, Descr = "De woonpandtypering WP5 per pandenset van SourceData/Vastgoed/BAG/PerJaar, met dezelfde jaren en dezelfde drie pandensets. De using op SourceData/Vastgoed/BAG laat de rekenregels naar dezelfde WP5-klassen verwijzen als de BAG zelf (#440)."
{
	container PerJaar := for_each_ne(/SourceData/Vastgoed/BAG/BAG_jaren/name, 'PerJaar_T('+quote(string(/SourceData/Vastgoed/BAG/BAG_jaren/jaar))+')');

	Template PerJaar_T
	: Descr = "De typering van de drie pandensets van een jaar."
	{
		parameter<String> JaarStr;
		///
		container pand                         := Pandset_T(JaarStr, 'pand');
		container pand_alle_statussen          := Pandset_T(JaarStr, 'pand_alle_statussen');
		container pand_alle_statussen_toekomst := Pandset_T(JaarStr, 'pand_alle_statussen_toekomst');
	}

	Template Pandset_T
	: Descr = "De typering van een pandenset; het pad wijst naar de set in SourceData/Vastgoed/BAG/PerJaar, en de selectienaam komt daarvandaan, zodat het bestand dezelfde naam houdt."
	{
		parameter<String> JaarStr;
		parameter<String> Pandset;
		///
		parameter<String> Pad              := '/SourceData/Vastgoed/BAG/PerJaar/Y'+JaarStr+'/'+Pandset;
		parameter<String> Selection_string := = Pad+'/Selection_string';

		#include<AfleidingPandType.dms>
	}
}
