container Grondgebruik
: Descr = "Wat het model afleidt uit de grondgebruiksbronnen die SourceData/Grondgebruik inleest (#440)."
{
	#include<BGT.dms>
	#include<BRT.dms>
	#include<LGN.dms>
	#include<IBIS.dms>
	#include<BBG.dms>
	#include<NBP.dms>
	#include<Natuur.dms>
	#include<NWB.dms>
}
