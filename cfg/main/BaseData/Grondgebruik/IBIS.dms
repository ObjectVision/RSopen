////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Wat het model afleidt uit de IBIS-werklocaties die SourceData/Grondgebruik/IBIS inleest (#440).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container IBIS: using = "Units;Geography;Classifications;Classifications/Grondgebruik"
, Descr = "De afleidingen uit de IBIS-werklocaties van de jaargang in ModelParameters/IBIS_Year: de milieuzone van wonen, de zone waarin milieugevoelige werkfuncties restrictief zijn, de
			terreinen die als vol tellen en de bedrijfsmatige terreinen, elk als ontkoppelde tif. Het inlezen en de stapeling van de jaargangen staan in SourceData/Grondgebruik/IBIS (#440)."
{
	unit<uint32> Result := ='/SourceData/Grondgebruik/IBIS/Y'+ModelParameters/IBIS_Year
	{
		attribute<.>         Per_AdminDomain        (AdminDomain) := poly2grid(geometry, AdminDomain);
		attribute<.>         Per_AllocDomain        (AllocDomain) := poly2grid(geometry, AllocDomain);
		attribute<MilieuCat> MilieuCat_rel                        := rlookup(Milieucategorie_x10, MilieuCat/Categorie_x10)
		, IntegrityCheck = "all(IsDefined(this))"
		, Descr = "De rij in ModelParameters/Wonen/MilieuCat die bij dit terrein hoort. De IntegrityCheck vangt de stille fout uit #694: levert een volgende IBIS-jaargang een schrijfwijze die de tabel niet
				kent, dan geeft de rlookup null en zou de bufferafstand stil op nul terugvallen. Omdat Milieucategorie_x10 zelf nooit null is, is een null hier altijd een ontbrekende rij en nooit
				ontbrekende brondata.";
		attribute<Meter>     Buffer_Dist                          := MakeDefined(MilieuCat/Buffer_wonen[MilieuCat_rel], 0[Meter]);
		attribute<Meter>     Buffer_Dist_gemengd                  := MakeDefined(MilieuCat/Buffer_wonen_gemengd[MilieuCat_rel], 0[Meter]), Descr = "De richtafstand van gemengd gebied, een stap lager; de zeef neemt die in stedelijke buurten.";

		attribute<bool>      IsWoningbouwplanCel    (AdminDomain) := /SourceData/Plancapaciteit/Read/Wonen/Hard/Per_AdminDomain || /SourceData/Plancapaciteit/Read/Wonen/Zacht/Per_AdminDomain
		, Descr = "Ligt de cel in een woningbouwplan, hard of zacht, uit de plancaplevering van ModelParameters/PlanCapaciteit_filedate.";
		attribute<uint32>    NrCellen                             := sum_uint32(IsDefined(Per_AdminDomain), Per_AdminDomain), Descr = "Het aantal cellen van 25 meter waarvan het middelpunt in het terrein ligt.";
		attribute<uint32>    NrCellenOnderWoningbouwplan          := sum_uint32(IsWoningbouwplanCel, Per_AdminDomain);
		attribute<float32>   AandeelOnderWoningbouwplan           := NrCellen > 0 ? float32(NrCellenOnderWoningbouwplan) / float32(NrCellen) : 0f
		, Descr = "Het deel van het terrein dat onder een woningbouwplan ligt. Een terrein kleiner dan een cel heeft geen cellen en telt niet als transformerend.";
		attribute<bool>      IsTransformerend                     := AandeelOnderWoningbouwplan >= /ModelParameters/Wonen/MilieuCat/TransformatieDrempel
		, Descr = "Gaat het terrein volgens de plannen grotendeels naar wonen? Dan verdwijnt de bedrijvigheid en houdt het geen milieuzone, niet op het terrein en niet eromheen; zie
				ModelParameters/Wonen/MilieuCat/TransformatieDrempel.";

		//Alleen terreinen met een bufferafstand > 0 (milieucategorie 2 en hoger) blokkeren wonen. Voorheen kregen ook cat-1-terreinen, economische zones en terreinen zonder categorie via geos_buffer(0) hun eigen polygoon als buffer, waardoor wonen op elke IBIS-werklocatie restrictief was; dat was alleen als rem op hoge categorieen bedoeld.
		//Een terrein dat volgens de woningbouwplannen grotendeels transformeert, krijgt geen buffer: zijn bedrijvigheid verdwijnt.
		unit<uint32> MetWoonbuffer := select_with_org_rel(Buffer_Dist > 0[Meter] && !IsTransformerend)
		{
			attribute<rdc_meter> geometrie            (poly) := geometry[org_rel]; //lexicaal indexeren: org_rel -> Buffer_Dist zoekt in de onderliggende Y-unit, waar de afgeleide attributen niet bestaan
			attribute<Meter>     BufferAfstand               := Buffer_Dist[org_rel];
			//geos en niet dms: dms_buffer_multi_polygon is op terreinen met duizenden hoekpunten en een buffer van honderden meters duizenden malen trager.
			attribute<rdc_meter> Buffer_wonen         (poly) := geos_buffer_multi_polygon(geometrie, float64(BufferAfstand), 4b);
			attribute<Meter>     BufferAfstand_gemengd       := Buffer_Dist_gemengd[org_rel];
			attribute<rdc_meter> Buffer_wonen_gemengd (poly) := geos_buffer_multi_polygon(geometrie, float64(BufferAfstand_gemengd), 4b);
		}

		attribute<uint8>     Calc_MilieuzoneWonen   (AdminDomain) := IsDefined(poly2grid(MetWoonbuffer/Buffer_wonen_gemengd, AdminDomain)) ? 2b : IsDefined(poly2grid(MetWoonbuffer/Buffer_wonen, AdminDomain)) ? 1b : 0b, Descr = "De milieuzone van wonen als code per cel: 0 buiten elke zone, 1 binnen de zone voor een rustige woonwijk maar buiten die voor gemengd gebied, 2 binnen de zone voor gemengd gebied, die ook het terrein zelf dekt. Alleen werklocaties met categorie 2 of hoger die niet transformeren tellen. De zeef (Zeef_Basisjaar_T/src/IsRestrictief_obvMilieuCat_Wonen) neemt in stedelijke buurten alleen code 2 en daarbuiten 1 en 2.";

		parameter<String>    FileName_MilieuzoneWonen             := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/MilieuzoneWonen_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		parameter<String>    Fingerprint_MilieuzoneWonen          :=
			  'ibis_year='        + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg,2026:IBIS_NL_2026_20261012.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024,2026'
			+ ';buffer_wonen_m='  + asList(string(/ModelParameters/Wonen/MilieuCat/Buffer_wonen), ',')
			+ ';buffer_wonen_gemengd_m=' + asList(string(/ModelParameters/Wonen/MilieuCat/Buffer_wonen_gemengd), ',')
			+ ';milieucat_count=' + string(#/ModelParameters/Wonen/MilieuCat)
			+ ';milieucat_aanvulling=' + string(/ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend) + ':' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven) + ',' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
			+ ';transformatie_drempel=' + string(/ModelParameters/Wonen/MilieuCat/TransformatieDrempel)
			+ ';plancap_wonen='   + (/ModelParameters/UsePrivPlancapaciteit ? 'priv_' : '') + /ModelParameters/PlanCapaciteit_filedate
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';study_area='      + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. De bufferafstanden per milieucategorie komen uit de VNG-tabel in
				ModelParameters/Wonen/MilieuCat, dus een gewijzigde tabel verandert de kaart zonder de bestandsnaam te raken. ibis_sources benoemt de brondata per bruikbare jaargang en moet met de hand mee
				veranderen bij een nieuwe IBIS-levering; stacked_years is de jaargangenstapeling, voor het volledige verslag. transformatie_drempel en plancap_wonen bepalen welke terreinen als
				transformerend geen buffer krijgen.";

		container            Decoupling_MilieuzoneWonen           := /Templates/DecoupledFile_T(FileName_MilieuzoneWonen, Fingerprint_MilieuzoneWonen, 'Write_MilieuzoneWonen');

		attribute<uint8>     Write_MilieuzoneWonen  (AdminDomain) := Calc_MilieuzoneWonen, StorageName = "=Decoupling_MilieuzoneWonen/StorageFile", StorageType = "tif", Descr = "Schrijft de kaart eenmalig als tif, zonder zijbestand; dat volgt via Make_MilieuzoneWonen.";
		attribute<uint8>     Make_MilieuzoneWonen   (AdminDomain) := Write_MilieuzoneWonen, ExplicitSuppliers = "Decoupling_MilieuzoneWonen/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_MilieuzoneWonen, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<uint8>     Read_MilieuzoneWonen   (AdminDomain) : StorageName = "=Decoupling_MilieuzoneWonen/StorageFile", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<uint8>     MilieuzoneWonen        (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld ? 'Calc_MilieuzoneWonen'
			:	Decoupling_MilieuzoneWonen/MayReuse ? 'Read_MilieuzoneWonen'
			:	                                       'Make_MilieuzoneWonen'
		, Descr = "De milieuzone van wonen als code per cel, zie Calc_MilieuzoneWonen. Drie standen: niet ontkoppeld rekent
				door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand.
				Decoupling_MilieuzoneWonen/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";

		//Milieugevoelige niet-woonfuncties (diensten, detailhandel, verblijfsrecreatie) worden alleen rond zware terreinen (categorie 4 en hoger) geweerd, met dezelfde VNG-buffer. Voorheen mochten die functies wel direct naast bestaand categorie-6-terrein, terwijl ze rond nieuw gealloceerde nijverheid juist gebufferd werden.
		unit<uint32> MetGevoeligBuffer := select_with_org_rel(MakeDefined(Milieucategorie_x10, 0b) >= 40b && !IsTransformerend)
		{
			attribute<rdc_meter> geometrie   (poly) := geometry[org_rel];
			attribute<Meter>     BufferAfstand      := Buffer_Dist[org_rel];
			attribute<rdc_meter> Buffer_poly (poly) := geos_buffer_multi_polygon(geometrie, float64(BufferAfstand), 4b); //geos en niet dms, zie Buffer_wonen
		}
		attribute<bool>      Calc_RestrictiefGevoeligeWerkfuncties (AdminDomain) := IsDefined(poly2grid(MetGevoeligBuffer/Buffer_poly, AdminDomain)), Descr = "Binnen de milieucat-buffer van een werklocatie met categorie 4 of hoger; daar zijn milieugevoelige werkfuncties en verblijfsrecreatie in de basisjaar-zeef restrictief.";

		parameter<String>    FileName_RestrictiefGevoeligeWerkfuncties := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/RestrictiefGevoeligeWerkfuncties_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		parameter<String>    Fingerprint_RestrictiefGevoeligeWerkfuncties :=
			  'ibis_year='        + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg,2026:IBIS_NL_2026_20261012.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024,2026'
			+ ';buffer_wonen_m='  + asList(string(/ModelParameters/Wonen/MilieuCat/Buffer_wonen), ',')
			+ ';milieucat_count=' + string(#/ModelParameters/Wonen/MilieuCat)
			+ ';milieucat_aanvulling=' + string(/ModelParameters/Wonen/MilieuCat/AanvullenBijOnbekend) + ':' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Zeehaven) + ',' + string(/ModelParameters/Wonen/MilieuCat/Aanvulling_Bedrijventerrein)
			+ ';min_cat=40'
			+ ';transformatie_drempel=' + string(/ModelParameters/Wonen/MilieuCat/TransformatieDrempel)
			+ ';plancap_wonen='   + (/ModelParameters/UsePrivPlancapaciteit ? 'priv_' : '') + /ModelParameters/PlanCapaciteit_filedate
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';study_area='      + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. min_cat is de hardgecodeerde drempel 4b in de selectie MetGevoeligBuffer; verandert die
				drempel in de code, pas dan ook deze sleutel aan. De bufferafstanden komen uit dezelfde VNG-tabel als bij MilieuzoneWonen; ibis_sources moet met de hand mee veranderen bij een nieuwe
				IBIS-levering.";

		container            Decoupling_RestrictiefGevoeligeWerkfuncties := /Templates/DecoupledFile_T(FileName_RestrictiefGevoeligeWerkfuncties, Fingerprint_RestrictiefGevoeligeWerkfuncties, 'Write_RestrictiefGevoeligeWerkfuncties');

		attribute<bool>      Write_RestrictiefGevoeligeWerkfuncties (AdminDomain) := Calc_RestrictiefGevoeligeWerkfuncties, StorageName = "=Decoupling_RestrictiefGevoeligeWerkfuncties/StorageFile", StorageType = "tif", Descr = "Schrijft de kaart eenmalig als tif, zonder zijbestand; dat volgt via Make_RestrictiefGevoeligeWerkfuncties.";
		attribute<bool>      Make_RestrictiefGevoeligeWerkfuncties (AdminDomain) := Write_RestrictiefGevoeligeWerkfuncties, ExplicitSuppliers = "Decoupling_RestrictiefGevoeligeWerkfuncties/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_RestrictiefGevoeligeWerkfuncties, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<bool>      Read_RestrictiefGevoeligeWerkfuncties (AdminDomain) : StorageName = "=Decoupling_RestrictiefGevoeligeWerkfuncties/StorageFile", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      RestrictiefGevoeligeWerkfuncties (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld                 ? 'Calc_RestrictiefGevoeligeWerkfuncties'
			:	Decoupling_RestrictiefGevoeligeWerkfuncties/MayReuse ? 'Read_RestrictiefGevoeligeWerkfuncties'
			:	                                                       'Make_RestrictiefGevoeligeWerkfuncties'
		, Descr = "Binnen de milieucat-buffer van een werklocatie met categorie 4 of hoger; daar zijn milieugevoelige werkfuncties en verblijfsrecreatie in de basisjaar-zeef restrictief. Drie standen: niet
				ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het
				zijbestand. Decoupling_RestrictiefGevoeligeWerkfuncties/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";
		attribute<float64>   Fractie_Uitgegeven                   := Uitgegeven / netto_oppervlakte;
		attribute<bool>      IsVol_obvFractie                     := Fractie_Uitgegeven >= ModelParameters/Werken/BedrijfsterreinUitgegevenFractieAlsVolBeschouwen;
		// attribute<bool>      IsVol                          := NOT(IsNietVol);
		// attribute<bool>      IsNietVol_grid   (AllocDomain) := IsNietVol[Per_AllocDomain];
		attribute<bool>      Calc_IsVol_grid        (AdminDomain) := (IsVol_obvFractie || IsVol)[Per_AdminDomain];

		parameter<String>    Uitgifte_Versie                      := '2026-10-12'
		, Descr = "Sleutel voor de rekenregel van NogUitgeefbaarHa in de fingerprint van IsVol_grid: sinds deze datum telt een lege uitgifte in het peiljaar als nul, waar het terrein daarvoor als helemaal
				uitgegeven telde. Een andere waarde dan in het zijbestand maakt de kaart opnieuw, dus de waarde verandert mee met die regel; krijgt een volgende wijziging een issue, zet dan het issuenummer.";

		parameter<String>    FileName_IsVol_grid                  := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/IsVol_grid_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		parameter<String>    Fingerprint_IsVol_grid               :=
			  'ibis_year='     + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg,2026:IBIS_NL_2026_20261012.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024,2026'
			+ ';vol_fraction=' + string(/ModelParameters/Werken/BedrijfsterreinUitgegevenFractieAlsVolBeschouwen)
			+ ';uitgifte_rule=' + Uitgifte_Versie
			+ ';admin_grid='   + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='    + string(AdminDomain/gridsize)
			+ ';study_area='   + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. vol_fraction is de drempel waarboven een terrein op de uitgegeven fractie als vol telt; het
				vol-veld uit IBIS telt daarnaast altijd mee. De uitgiftekolommen waarop de fractie rust verschillen per jaargang en zitten via ibis_year en ibis_sources in de fingerprint, de rekenregel erop via
				uitgifte_rule. admin_grid vangt
				dat een andere resolutie van AdminDomain een ander bestand onder dezelfde naam zou opleveren.";

		container            Decoupling_IsVol_grid                := /Templates/DecoupledFile_T(FileName_IsVol_grid, Fingerprint_IsVol_grid, 'Write_IsVol_grid');

		attribute<bool>      Write_IsVol_grid       (AdminDomain) := Calc_IsVol_grid, StorageName = "=Decoupling_IsVol_grid/StorageFile", StorageType = "tif", Descr = "Schrijft de kaart eenmalig als tif, zonder zijbestand; dat volgt via Make_IsVol_grid.";
		attribute<bool>      Make_IsVol_grid        (AdminDomain) := Write_IsVol_grid, ExplicitSuppliers = "Decoupling_IsVol_grid/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_IsVol_grid, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<bool>      Read_IsVol_grid        (AdminDomain) : StorageName = "=Decoupling_IsVol_grid/StorageFile", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      IsVol_grid             (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld ? 'Calc_IsVol_grid'
			:	Decoupling_IsVol_grid/MayReuse       ? 'Read_IsVol_grid'
			:	                                       'Make_IsVol_grid'
		, Descr = "Ligt de cel van 25 meter op een IBIS-werklocatie die als vol telt, op het vol-veld of op de uitgegeven fractie boven de drempel. Drie standen: niet ontkoppeld rekent door zonder
				tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand.
				Decoupling_IsVol_grid/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";
		
		//Bestaande vergunde bedrijvigheid: de terreintypen waar nieuwe nijverheid of logistiek verdichting van bestaand gebruik is en geen nieuw milieuconflict oplevert. Retail-, onderwijs- en zorglocaties tellen hier bewust niet mee, en een cel buiten elk terrein is null en dus FALSE.
		attribute<bool>      Calc_IsBedrijfsmatigTerrein (AdminDomain) := Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/Bedrijventerrein
		                                                                  || Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/Zeehaventerrein
		                                                                  || Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/EZ_platform_gebonden_bedrijvigheid
		                                                                  || Type_Per_AdminDomain == /Classifications/Grondgebruik/IBIS/V/EZ_agribusiness_complexen
													, Descr = "Ligt de cel op een bestaand werkterrein waar nijverheid en logistiek thuishoren. Gebruikt in de omgekeerde milieuzonering (#669), die daar vervalt omdat de VNG-richtafstanden niet gelden tegen bestaande vergunde bedrijvigheid.";

		parameter<String>    FileName_IsBedrijfsmatigTerrein      := '%LocalDataProjDir%/BaseData/Grondgebruik/IBIS/IsBedrijfsmatigTerrein_'+/ModelParameters/IBIS_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		parameter<String>    Fingerprint_IsBedrijfsmatigTerrein   :=
			  'ibis_year='          + /ModelParameters/IBIS_Year
			+ ';ibis_sources=2023:IBIS_werklocaties_2023.gpkg,2024:IBIS_NL_2024_extern.gpkg,2026:IBIS_NL_2026_20261012.gpkg'
			+ ';stacked_years=2016,2017,2018,2019,2021,2022,2023,2024,2026'
			+ ';bedrijfsmatig_types=Bedrijventerrein,Zeehaventerrein,EZ_platform_gebonden_bedrijvigheid,EZ_agribusiness_complexen'
			+ ';ibis_class_codes='  + asList(/Classifications/Grondgebruik/IBIS/code, ',')
			+ ';wloc_type_norm=v2_eerste_teken'
			+ ';admin_grid='        + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='         + string(AdminDomain/gridsize)
			+ ';study_area='        + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. bedrijfsmatig_types is de hardgecodeerde lijst terreintypen in de expressie; verandert die
				lijst, pas dan ook deze sleutel aan. ibis_class_codes is de codeset waarop Type_rel via rlookup wordt bepaald; ibis_sources benoemt de brondata per bruikbare jaargang; wloc_type_norm is de
				versie van de normalisatieregel in WLOC_TYPE_code (#738), die bepaalt welke terreinen een klasse krijgen terwijl codelijst en typenamen gelijk blijven. Wijzigt de regel, hoog dan het
				versienummer op, anders blijft een verouderde tif geldig ogen.";

		container            Decoupling_IsBedrijfsmatigTerrein    := /Templates/DecoupledFile_T(FileName_IsBedrijfsmatigTerrein, Fingerprint_IsBedrijfsmatigTerrein, 'Write_IsBedrijfsmatigTerrein');

		attribute<bool>      Write_IsBedrijfsmatigTerrein (AdminDomain) := Calc_IsBedrijfsmatigTerrein, StorageName = "=Decoupling_IsBedrijfsmatigTerrein/StorageFile", StorageType = "tif", Descr = "Schrijft de kaart eenmalig als tif, zonder zijbestand; dat volgt via Make_IsBedrijfsmatigTerrein.";
		attribute<bool>      Make_IsBedrijfsmatigTerrein (AdminDomain) := Write_IsBedrijfsmatigTerrein, ExplicitSuppliers = "Decoupling_IsBedrijfsmatigTerrein/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_IsBedrijfsmatigTerrein, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<bool>      Read_IsBedrijfsmatigTerrein (AdminDomain) : StorageName = "=Decoupling_IsBedrijfsmatigTerrein/StorageFile", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      IsBedrijfsmatigTerrein (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld       ? 'Calc_IsBedrijfsmatigTerrein'
			:	Decoupling_IsBedrijfsmatigTerrein/MayReuse ? 'Read_IsBedrijfsmatigTerrein'
			:	                                             'Make_IsBedrijfsmatigTerrein'
		, Descr = "Ligt de cel op een bestaand werkterrein waar nijverheid en logistiek thuishoren; de omgekeerde milieuzonering (#669) vervalt daar. Drie standen: niet ontkoppeld rekent door zonder
				tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand.
				Decoupling_IsBedrijfsmatigTerrein/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";
		
		unit<uint8>          MilieuCat                            := ModelParameters/Wonen/MilieuCat;
	}
}
