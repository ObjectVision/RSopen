// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Wat het model afleidt uit het Natuurbeheerplan dat SourceData/Grondgebruik/NBP inleest (#440).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container NBP: using = "Units;Geography;Classifications;Classifications/Grondgebruik"
, Descr = "Het natuurbeheertype van het Natuurbeheerplan op 25 meter, als ontkoppelde tif, met de controle op het rasteren. Het inlezen van het plan staat in SourceData/Grondgebruik/NBP (#776, #440)."
{
	attribute<INL_Beheertype> Calc_INL_Beheertype_AD (AdminDomain) := /SourceData/Grondgebruik/NBP/Bron/BeheerGebied/INL_Beheertype_rel[/SourceData/Grondgebruik/NBP/Bron/BeheerGebied/Per_AdminDomain]
	, Descr = "Het beheertype per cel, rechtstreeks uit de vlakken. Null buiten de kaart en op de landschapselementen. Dit is het rekenwerk dat de ontkoppelde tif hieronder eenmalig vastlegt.";

	parameter<String> FileName_INL_Beheertype_AD    := '%LocalDataProjDir%/BaseData/Grondgebruik/NBP/nbp' + /SourceData/Grondgebruik/NBP/Jaargang + '_INL_Beheertype_' + /ModelParameters/StudyArea + '_' + /ModelParameters/Advanced/AdminDomain_ref + '.tif'
	, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";
	parameter<String> Fingerprint_INL_Beheertype_AD :=
		  'bron='               + PropValue(/SourceData/Grondgebruik/NBP/Bron, 'StorageName')
		+ ';laag=BeheerGebied;sql=' + PropValue(/SourceData/Grondgebruik/NBP/Bron/BeheerGebied, 'SqlString') + ';landschapselementen=null'
		+ ';beheertypen='       + asList(INL_Beheertype/code, ',')
		+ ';study_area='        + /ModelParameters/StudyArea
		+ ';admin_domain='      + /ModelParameters/Advanced/AdminDomain_ref
	, Descr = "Wat de tif bepaalt: het bronbestand (met de jaargang in de naam), de laag en de SqlString (dus ook de rastervolgorde en een eventueel filter), de nummering van INL_Beheertype (de tif draagt rijnummers), het studiegebied en de resolutie. Een nieuwe jaargang of een extra rij in de classificatie maakt de tif ongeldig en laat hem opnieuw schrijven.";

	container Decoupling_INL_Beheertype_AD := /Templates/DecoupledFile_T(FileName_INL_Beheertype_AD, Fingerprint_INL_Beheertype_AD, 'Write_INL_Beheertype_AD');

	attribute<INL_Beheertype> Write_INL_Beheertype_AD (AdminDomain) := Calc_INL_Beheertype_AD, StorageName = "=Decoupling_INL_Beheertype_AD/StorageFile", StorageType = "gdalwrite.grid"
	, Descr = "Schrijft de kaart eenmalig weg, zonder zijbestand; dat volgt via Make_INL_Beheertype_AD.";
	attribute<INL_Beheertype> Make_INL_Beheertype_AD (AdminDomain) := Write_INL_Beheertype_AD, ExplicitSuppliers = "Decoupling_INL_Beheertype_AD/Write_Fingerprint"
	, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_INL_Beheertype_AD, want alleen langs deze weg ontstaat de fingerprint (#837).";
	attribute<INL_Beheertype> Read_INL_Beheertype_AD (AdminDomain) : StorageName = "=Decoupling_INL_Beheertype_AD/StorageFile", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
	attribute<INL_Beheertype> INL_Beheertype_AD      (AdminDomain) := = Decoupling_INL_Beheertype_AD/MayReuse ? 'Read_INL_Beheertype_AD' : 'Make_INL_Beheertype_AD'
	, Descr = "Het natuurbeheertype volgens het Natuurbeheerplan 2026 op 25 meter, ontkoppeld. De bron van BaseData/StartState/Landgebruik/Beheertype zolang ModelParameters/Natuur/Beheertype_Basisjaar_Bron op NBP staat. Vraag Decoupling_INL_Beheertype_AD/Explanation op om te zien waarom de tif wel of niet opnieuw wordt gemaakt.";

	container Controle
	: Descr = "Vergelijkt het gerasterde areaal per beheertype met het polygoonareaal uit de bron, en telt wat er buiten de classificatie valt; twee rasterkolommen, over de hele kaart (meet het rasteren)
			en binnen het studiegebied (meet het masker). De getallen rekenen de levende poly2grid opnieuw, ook als de tif wordt hergebruikt."
	{
		attribute<Bool> SA (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain;

		unit<UInt8> PerType := INL_Beheertype
		{
			attribute<String>  code             := INL_Beheertype/code;
			attribute<Ha>      Vector           := sum(/SourceData/Grondgebruik/NBP/Bron/BeheerGebied/Opp, /SourceData/Grondgebruik/NBP/Bron/BeheerGebied/INL_Beheertype_rel), Descr = "Polygoonareaal per beheertype uit de bron, alle provincies samen.";
			attribute<Ha>      Raster_HeleKaart := sum(IsDefined(INL_Beheertype_AD) ? AdminDomain/NrHaPerCell : 0[Ha], INL_Beheertype_AD), Descr = "Hetzelfde areaal zoals het model het op 25 meter rastert, over de hele kaart.";
			attribute<Ha>      Raster           := sum(SA ? AdminDomain/NrHaPerCell : 0[Ha], INL_Beheertype_AD), Descr = "Daarvan binnen het studiegebied: de unie van de gegeneraliseerde CBS-provinciegrenzen plus IJburg, dus land zonder Waddenzee, IJsselmeer en Noordzeekustzone. Dit is wat het model gebruikt.";
			attribute<Float32> Ratio            := Vector > 0[Ha] ? Raster_HeleKaart / Vector : 1f, Descr = "Raster over de hele kaart gedeeld door het polygoonareaal: meet alleen het rasteren en hoort per type op een procent na 1 te zijn, ook al is een kwart van de vlakken kleiner dan een cel. Het
			verschil tussen Raster en Raster_HeleKaart is het studiegebied: zee en wad en afgesloten zeearm houden daarbinnen bijna niets over, strand, schor en kwelder verliezen een deel.";
		}

		parameter<Ha> Areaal_Vector_N               := sum(!/SourceData/Grondgebruik/NBP/Bron/BeheerGebied/IsLandschapselement ? /SourceData/Grondgebruik/NBP/Bron/BeheerGebied/Opp : 0[Ha]), Descr = "Polygoonareaal van alle N-typen.";
		parameter<Ha> Areaal_Vector_L               := sum( /SourceData/Grondgebruik/NBP/Bron/BeheerGebied/IsLandschapselement ? /SourceData/Grondgebruik/NBP/Bron/BeheerGebied/Opp : 0[Ha]), Descr = "Polygoonareaal van de landschapselementen, dat zonder type blijft.";
		parameter<Ha> Areaal_Raster_HeleKaart       := sum(IsDefined(INL_Beheertype_AD) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen met een beheertype over de hele kaart; hoort gelijk te zijn aan Areaal_Vector_N.";
		parameter<Ha> Areaal_Raster                 := sum(SA && IsDefined(INL_Beheertype_AD) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen met een beheertype binnen het studiegebied.";
		parameter<Ha> Areaal_Raster_NietSubsidiabel := sum(SA && IsDefined(INL_Beheertype_AD) && /SourceData/Grondgebruik/NBP/Bron/BeheerGebied/subsidiabel[/SourceData/Grondgebruik/NBP/Bron/BeheerGebied/Per_AdminDomain] == 0i ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waarvan op vlakken die niet subsidiabel zijn.";

	}
}
