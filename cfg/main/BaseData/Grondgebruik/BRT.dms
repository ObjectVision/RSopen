// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Wat het model afleidt uit de Basisregistratie Topografie die SourceData/Grondgebruik/BRT inleest (#440).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BRT: using = "Units;Geography;Classifications;Classifications/Grondgebruik"
, Descr = "Wat het model uit de BRT afleidt: welke cellen in een woonkern liggen en welke in een functioneel gebied dat als evident benut geldt, elk als ontkoppelde tif op AdminDomain. Het
			inlezen van de BRT staat in SourceData/Grondgebruik/BRT (#440)."
{
	unit<UInt32> EvidentBenutCategorieen: NrOfRows = 7
	, Descr = "Welke categorieen meedoen. naam is de containernaam onder MaakLosseCat_functioneel_gebied, die met AsItemName uit het label volgt; label is de tekst zoals hij in Classifications/Grondgebruik/BRT staat en gaat mee in de fingerprint. Beide moeten kloppen: de eerste bepaalt welke geometrie wordt gelezen, de tweede welke visualisatiecodes in de sleutel zitten."
	{
			attribute<String> naam : ['Terrein_vlakken_dierentuin_safaripark'
				        ,'Terrein_vlakken_openluchtmuseum'
				        ,'Terrein_vlakken_park'
				        ,'Terrein_vlakken_begraafplaats'
				        ,'Terrein_vlakken_erebegraafplaats'
				        ,'Terrein_vlakken_grafheuvel'
				        ,'Terrein_vlakken_militair_oefengebied'];
			attribute<String> label: ['terrein vlakken - dierentuin, safaripark'
				        ,'terrein vlakken - openluchtmuseum'
				        ,'terrein vlakken - park'
				        ,'terrein vlakken - begraafplaats'
				        ,'terrein vlakken - erebegraafplaats'
				        ,'terrein vlakken - grafheuvel'
				        ,'terrein vlakken - militair oefengebied'];
	}

	unit<UInt32> IsBRTEvidentBenut := ='union_unit('+AsList('/SourceData/Grondgebruik/BRT/Compleet/MaakLosseCat_functioneel_gebied/'+EvidentBenutCategorieen/naam+'/combined_vlak', ',')+')'
	, Descr = "De BRT-functioneelgebiedcategorieen die als evident benut gelden, samen in een unit; de set staat als lijst in EvidentBenutCategorieen hieronder en een categorie erbij is een regel (#405).
				Alleen labels uit de groep FUNCTIONEEL_GEBIED in Classifications/Grondgebruik/BRT zijn hier te bereiken, want MaakLosseCat_functioneel_gebied selecteert uit top10nl_functioneel_gebied_vlak;
				een label uit de groep TERREIN, zoals dodenakker, levert een container met nul vlakken zonder foutmelding, daarom staan hier begraafplaats en erebegraafplaats. Deze bron naast de
				bodemstatistiek en de BGT, omdat alleen de BRT het functionele gebied als zodanig kent: een park in een bosrijke omgeving valt bij het CBS in de klasse bos. De lezer zit in
				IsRestrictief_Overal, dus deze uitsluiting geldt ook binnen plancapaciteit; voor een park is dat een keuze."
	{
		attribute<rdc_meter> geometry             (poly)        := ='union_data(., '+AsList('/SourceData/Grondgebruik/BRT/Compleet/MaakLosseCat_functioneel_gebied/'+EvidentBenutCategorieen/naam+'/combined_vlak/geometry', ',')+')';
		attribute<bool>      Calc_Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain)), Descr = "De vergridding zelf, met dezelfde expressie als voor de ontkoppeling.";

		parameter<String> FileName_Per_AdminDomain := '%LocalDataProjDir%/BaseData/Grondgebruik/BRT/IsBRTEvidentBenut_'+/ModelParameters/BRT_file_date+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		unit<UInt32> SelectieCodes := select_with_org_rel(IsDefined(rlookup(lowercase(/SourceData/Grondgebruik/BRT/BRT_Classifications/Label), lowercase(EvidentBenutCategorieen/label))))
		, Descr = "De visualisatiecodes die een van de gekozen labels dragen. Deze set zit in de fingerprint omdat een gewijzigde toewijzing van codes aan deze labels de selectie verandert zonder dat de labellijst meebeweegt."
		{
			attribute<Int32> code := /SourceData/Grondgebruik/BRT/BRT_Classifications/code[org_rel];
		}

		parameter<String> Fingerprint_Per_AdminDomain :=
		  'brt_date='         + /ModelParameters/BRT_file_date
		+ ';study_area='      + /ModelParameters/StudyArea
		+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
		+ ';grid_size='       + string(AdminDomain/gridsize)
		+ ';source_layers=functioneel_gebied_vlak,functioneel_gebied_multivlak'
		+ ';selection_labels=' + asList(EvidentBenutCategorieen/label, '|')
		+ ';selection_codes=' + asList(string(SelectieCodes/code), ',')
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. selection_labels vangt het bijkomen of wegvallen van een categorie, selection_codes een gewijzigde toewijzing van codes aan diezelfde labels.";

		container Decoupling_Per_AdminDomain := /Templates/DecoupledFile_T(FileName_Per_AdminDomain, Fingerprint_Per_AdminDomain, 'Write_Per_AdminDomain');

		attribute<bool>      Write_Per_AdminDomain (AdminDomain) := Calc_Per_AdminDomain, StorageName = "=Decoupling_Per_AdminDomain/StorageFile", StorageType = "tif"
		, Descr = "Schrijft de vergridding eenmalig als tif, zonder zijbestand; dat volgt via Make_Per_AdminDomain.";
		attribute<bool>      Make_Per_AdminDomain (AdminDomain) := Write_Per_AdminDomain, ExplicitSuppliers = "Decoupling_Per_AdminDomain/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_Per_AdminDomain, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<bool>      Read_Per_AdminDomain (AdminDomain) : StorageName = "=Decoupling_Per_AdminDomain/StorageFile", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<bool>      Per_AdminDomain      (AdminDomain) := = Decoupling_Per_AdminDomain/MayReuse ? 'Read_Per_AdminDomain' : 'Make_Per_AdminDomain'
		, Descr = "Klopt de fingerprint dan wordt de tif gelezen, anders wordt er gerekend en meteen weggeschreven.";
	}
	
	unit<UInt32> IsWoonkern := /SourceData/Grondgebruik/BRT/Compleet/MaakLosseCat_plaats/Plaats_woonkern/combined_vlak
	{
		attribute<rdc_meter> geometry             (poly)        := /SourceData/Grondgebruik/BRT/Compleet/MaakLosseCat_plaats/Plaats_woonkern/combined_vlak/geometry;
		attribute<bool>      Calc_Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain)), Descr = "De vergridding zelf, met dezelfde expressie als voor de ontkoppeling: elke cel die door een woonkernvlak van de BRT wordt geraakt.";

		parameter<String> FileName_Per_AdminDomain := '%LocalDataProjDir%/BaseData/Grondgebruik/BRT/IsWoonkern_'+/ModelParameters/BRT_file_date+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		unit<UInt32> SelectieCodes := select_with_org_rel(lowercase(/SourceData/Grondgebruik/BRT/BRT_Classifications/Label) == 'plaats - woonkern')
		, Descr = "De visualisatiecodes die het woonkernlabel dragen. Deze set zit in de fingerprint omdat een gewijzigde toewijzing van codes aan dit label de selectie verandert zonder de bestandsnaam te raken."
		{
			attribute<Int32> code := /SourceData/Grondgebruik/BRT/BRT_Classifications/code[org_rel];
		}

		parameter<String> Fingerprint_Per_AdminDomain :=
			  'brt_date='         + /ModelParameters/BRT_file_date
			+ ';study_area='      + /ModelParameters/StudyArea
			+ ';admin_grid='      + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='       + string(AdminDomain/gridsize)
			+ ';source_layers=plaats_vlak,plaats_multivlak'
			+ ';selection_label=plaats - woonkern'
			+ ';selection_codes=' + asList(string(SelectieCodes/code), ',')
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. brt_date is de vintage van de gpkg; admin_grid en grid_size vangen dat een andere
				rasterresolutie een ander bestand onder dezelfde naam zou opleveren; source_layers en selection_label liggen vast in de configuratie en staan hier als leesbaar verslag; selection_codes komt
				uit de klassentabel en beweegt mee wanneer die toewijzing wijzigt.";

		container Decoupling_Per_AdminDomain := /Templates/DecoupledFile_T(FileName_Per_AdminDomain, Fingerprint_Per_AdminDomain, 'Write_Per_AdminDomain');

		attribute<bool>      Write_Per_AdminDomain (AdminDomain) := Calc_Per_AdminDomain, StorageName = "=Decoupling_Per_AdminDomain/StorageFile", StorageType = "tif", Descr = "Schrijft de vergridding eenmalig als tif, zonder zijbestand; dat volgt via Make_Per_AdminDomain.";
		attribute<bool>      Make_Per_AdminDomain (AdminDomain) := Write_Per_AdminDomain, ExplicitSuppliers = "Decoupling_Per_AdminDomain/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_Per_AdminDomain, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<bool>      Read_Per_AdminDomain (AdminDomain) : StorageName = "=Decoupling_Per_AdminDomain/StorageFile", StorageType = "tif", StorageReadOnly = "TRUE", Descr = "Leest de eerder weggeschreven tif terug. Domein en waardetype zijn gelijk aan die van Calc_Per_AdminDomain.";
		attribute<bool>      Per_AdminDomain      (AdminDomain) := = Decoupling_Per_AdminDomain/MayReuse ? 'Read_Per_AdminDomain' : 'Make_Per_AdminDomain'
		, Descr = "De schakel met de oorspronkelijke naam, zodat de lezers elders in de configuratie ongemoeid blijven. Klopt de fingerprint dan wordt de tif gelezen, anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_Per_AdminDomain/Explanation op om te zien waarom een bestand wel of niet opnieuw gemaakt wordt.";
	}
}
