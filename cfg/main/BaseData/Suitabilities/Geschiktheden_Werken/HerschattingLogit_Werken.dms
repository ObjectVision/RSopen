
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
//
// Herschatting van de geschiktheidslogit voor werken binnen het model zelf, met Templates/Statistiek/Mlogit_T (#708). De
// schatting uit de studie Ruimte voor werken (2022), logitcoeff_mlogit_devType_20220401.csv, was een multinomiale logit over zes
// werksectoren en geen ontwikkeling, op de groei van de pandvoetafdruk per functie tussen 2012 en 2022 op cellen van 100 m. De
// herschatting telt alleen bouw als ontwikkeling (Groei_T) en schat op 2017 tot 2022, met de UAI, de landgebruiksaandelen en de
// IBIS-werklocaties van het begin van die periode (Covariaten_T) en zonder beleidsdummy's en provincies; 2022 tot 2026 is de
// toetsperiode en 2012 tot 2017 een mogelijke tweede periode. Het model leest de herschatte coefficienten uit
// logitcoeff_mlogit_devType_20261116.csv, met dezelfde getallen als de Vergelijking hieronder.
//


container Herschatting
: Descr = "Herschatting van de werken-geschiktheidslogit (#708). De keuze per cel van 100 m is de werksector met de grootste groei van de pandvoetafdruk door bouw in de schattingsperiode (Groei_T), als die groei ModelParameters/Werken_Herschatting_Drempel haalt, en anders geen ontwikkeling."
{
	unit<uint8> Var : NrOfRows = 16
	, Descr = "De termen van de schatting, met de constante: de termen van Calc_raw op de kaarten van het begin van de periode, met de UAI als logaritme, per schaalniveau een bereikbaarheid (de reistijd naar het dichtstbijzijnde OV-knooppunt en naar 500.000 inwoners, in plaats van de afstand tot een station en de reistijd naar 100.000 inwoners) en of de cel op een IBIS-werklocatie ligt, met zeehaventerrein apart omdat de dienstensectoren daar nauwelijks bouwen. naam2022 is dezelfde term in de csv van 2022 (Datum2022), om de schattingen naast elkaar te leggen, en leeg bij een term die daar niet in staat."
	{
		attribute<String> name :
		[ 'ln_dist_cargoair', 'ln_dist_highway', 'ln_dist_seaport', 'ln_tt_ov', 'ln_tt_500k'
		, 'ln_landprice', 'ln_dist_urbancontour', 'ln_uai', 'lu_share_unavailable', 'lu_share_construction'
		, 'lu_share_nature', 'lu_share_residential', 'avgshr_otherbuiltup_1000m', 'op_ibis_zeehaven', 'op_ibis_overig', 'Constant'
		];
		attribute<String> naam2022 :
		[ 'lndistto_cargoair_km', 'lndist_highway_km_2018', 'lndist_seaport_km_2019', '', ''
		, 'lnlandprice', 'lndist_urbancontour_km_2000', 'uai_2018', 'lu_share_unavailable_2012', 'lu_share_construction_2012'
		, 'lu_share_nature_2012', 'lu_share_residential_2012', 'avgshr_LU12_ngh_1000r_otherbu', '', '', 'Constant'
		];
	}

	Template Groei_T
	: Descr = "Ontwikkeling per cel van 100 m door bouw tussen de BAG-standen van 1 januari van BeginJaar en EindJaar. Bouw is nieuwbouw, een bestaand pand met een recent bouwjaar dat zijn eerste verblijfsobject kreeg, en een werkpand dat zijn sector houdt en groter werd. Een ouder pand dat later in de BAG kwam of later een verblijfsobject kreeg (registratie) en een pand dat van gebruik of sector wisselde tellen niet mee, want het model plaatst met de geschiktheidskaart bouw (#708). De logies van een pand in een verblijfsrecreatiegebied van het CBS telt niet als werken, want het model deelt die apart toe als verblijfsrecreatie (#364)."
	{
		parameter<UInt32> BeginJaar;
		parameter<UInt32> EindJaar;
		//
		unit<uint32> Pand0      := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(BeginJaar) + '/pand';
		unit<uint32> Pand1      := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(EindJaar) + '/pand';
		unit<uint32> Toedeling0 := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(BeginJaar) + '/pand/ToedelingsMatrix_AllocDomain';
		unit<uint32> Toedeling1 := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(EindJaar) + '/pand/ToedelingsMatrix_AllocDomain';

		attribute<String> VoetMet      (/Classifications/Actor/Jobs6) := 'MakeDefined(float32(' + replace(/Classifications/Actor/Jobs6/vbo_gebruiksdoel_plus_ref, '@', 'PandX/Oppervlaktes/Footprint_perGebruiksdoel/', '#', '') + '), 0f)';
		attribute<String> VoetZonder   (/Classifications/Actor/Jobs6) := 'MakeDefined(float32(' + replace(/Classifications/Actor/Jobs6/vbo_gebruiksdoel_plus_ref, ' + @logies#', '', '@', 'PandX/Oppervlaktes/Footprint_perGebruiksdoel/', '#', '') + '), 0f)';
		attribute<String> VoetExpr     (/Classifications/Actor/Jobs6) := strcount(/Classifications/Actor/Jobs6/vbo_gebruiksdoel_plus_ref, ' + @logies#') > 0 ? 'MakeDefined(PandX/LigtInCBSVerblijfsrecreatie, FALSE) ? ' + VoetZonder + ' : ' + VoetMet : VoetMet
		, Descr = "De voetafdruk van een werksector in een pand, met PandX voor het pand; bij de sector met logies zonder de logies als het pand in een verblijfsrecreatiegebied van het CBS ligt.";

		container Voet0 := for_each_nedv(/Classifications/Actor/Jobs6/name, replace(VoetExpr, 'PandX', 'Pand0'), Pand0, float32), Descr = "Voetafdruk per werksector per pand in het beginjaar, in m2.";
		container Voet1 := for_each_nedv(/Classifications/Actor/Jobs6/name, replace(VoetExpr, 'PandX', 'Pand1'), Pand1, float32), Descr = "Voetafdruk per werksector per pand in het eindjaar, in m2.";
		attribute<float32>  WerkTotaal0 (Pand0) := ='add(' + AsItemList('Voet0/' + TXLJobs6/name) + ')';
		attribute<float32>  WerkTotaal1 (Pand1) := ='add(' + AsItemList('Voet1/' + TXLJobs6/name) + ')';
		attribute<TXLJobs6> Sector0     (Pand0) := ='ArgMax(' + AsItemList('Voet0/' + TXLJobs6/name) + ')[TXLJobs6]', Descr = "De werksector met de grootste voetafdruk in het pand in het beginjaar.";
		attribute<TXLJobs6> Sector1     (Pand1) := ='ArgMax(' + AsItemList('Voet1/' + TXLJobs6/name) + ')[TXLJobs6]', Descr = "De werksector met de grootste voetafdruk in het pand in het eindjaar.";

		attribute<Pand0> Pand0_rel (Pand1) := IsDefined(Pand1/pand_bag_nr) ? rlookup(Pand1/pand_bag_nr, Pand0/pand_bag_nr) : (0/0)[Pand0], Descr = "Hetzelfde pand in het beginjaar, op BAG-pandnummer.";
		attribute<Pand1> Pand1_rel (Pand0) := IsDefined(Pand0/pand_bag_nr) ? rlookup(Pand0/pand_bag_nr, Pand1/pand_bag_nr) : (0/0)[Pand1], Descr = "Hetzelfde pand in het eindjaar, op BAG-pandnummer.";

		attribute<bool> IsWerk1        (Pand1) := WerkTotaal1 > 0f;
		attribute<bool> InBegin        (Pand1) := IsDefined(Pand0_rel), Descr = "Het pand stond al in de BAG van het beginjaar.";
		attribute<bool> WasWerk        (Pand1) := InBegin && WerkTotaal0[Pand0_rel] > 0f;
		attribute<bool> RecentBouwjaar (Pand1) := int32(Pand1/Bouwjaar) >= int32(BeginJaar) - int32(/ModelParameters/Werken_Herschatting_BouwjaarMarge);
		attribute<bool> IsNieuwbouw    (Pand1) := IsWerk1 && !InBegin && RecentBouwjaar, Descr = "Een werkpand dat in het beginjaar niet in de BAG stond en een recent bouwjaar heeft.";
		attribute<bool> KreegVbo       (Pand1) := IsWerk1 && InBegin && !WasWerk && Pand0/counts/VBOs[Pand0_rel] == 0 && RecentBouwjaar, Descr = "Een pand dat in het beginjaar in aanbouw of zonder verblijfsobject in de BAG stond, met een recent bouwjaar.";
		attribute<bool> Uitbreiding    (Pand1) := IsWerk1 && WasWerk && Sector1 == Sector0[Pand0_rel] && Pand1/Footprint[float32] - Pand0/Footprint[float32][Pand0_rel] >= /ModelParameters/Werken_Herschatting_PandGroter, Descr = "Een werkpand dat zijn sector hield en groter werd.";
		attribute<bool> IsBouw         (Pand1) := IsNieuwbouw || KreegVbo || Uitbreiding;
		attribute<bool> IsBouw0        (Pand0) := IsDefined(Pand1_rel) && IsBouw[Pand1_rel], Descr = "Het pand is in het eindjaar een bouwpand; alleen bij een uitbreiding heeft het in het beginjaar een voetafdruk die eraf gaat.";

		container PerSector :=
			for_each_nedv(
				TXLJobs6/name
				, 'sum(IsBouw[Toedeling1/Pand_rel] ? Voet1/' + TXLJobs6/name + '[Toedeling1/Pand_rel] * Toedeling1/ToedelingPand : 0f, Toedeling1/AllocDomain_rel)'
				+ ' - sum(IsBouw0[Toedeling0/Pand_rel] ? Voet0/' + TXLJobs6/name + '[Toedeling0/Pand_rel] * Toedeling0/ToedelingPand : 0f, Toedeling0/AllocDomain_rel)'
				, AllocDomain
				, float32
			), Descr = "Groei van de voetafdruk per werksector per cel door de bouwpanden: hun voetafdruk in het eindjaar min die in het beginjaar, verdeeld over de cellen waarin ze liggen.";
		attribute<float32>  Max      (AllocDomain) := ='max_elem(' + asItemList('MakeDefined(PerSector/' + TXLJobs6/name + ', 0f)') + ')';
		attribute<TXLJobs6> Grootste (AllocDomain) := ='ArgMax(' + asItemList('MakeDefined(PerSector/' + TXLJobs6/name + ', 0f)') + ')[TXLJobs6]', Descr = "De werksector met de grootste groei.";
		attribute<TXLJobs6> keuze    (AllocDomain) := Max >= /ModelParameters/Werken_Herschatting_Drempel ? Grootste : (0/0)[TXLJobs6]
		, Descr = "De werksector met de grootste groei, als die groei de drempel haalt; null is geen ontwikkeling, het referentiealternatief.";
		attribute<uint32>   Aantal   (TXLJobs6)    := pcount_uint32(keuze), Descr = "Aantal ontwikkelde cellen per werksector.";
		parameter<uint32>   Totaal                 := sum(Aantal);

		attribute<float32> Bijdrage         (Toedeling1)  := IsBouw[Toedeling1/Pand_rel] ? WerkTotaal1[Toedeling1/Pand_rel] * Toedeling1/ToedelingPand : 0f, Descr = "De werkvoetafdruk die een bouwpand in een cel legt, in m2.";
		attribute<float32> GrootsteBijdrage (AllocDomain) := max(Bijdrage, Toedeling1/AllocDomain_rel);
		attribute<uint64>  ClusterPand      (AllocDomain) := max(Bijdrage > 0f && Bijdrage == GrootsteBijdrage[Toedeling1/AllocDomain_rel] ? Pand1/pand_bag_nr[Toedeling1/Pand_rel] : (0/0)[uint64], Toedeling1/AllocDomain_rel)
		, Descr = "Het BAG-pandnummer van het bouwpand met de grootste bijdrage aan de cel, 0 in een cel zonder bouwpand (de max over een lege groep). Een pand ligt vaak in meer cellen, en de standaardfouten van de schatting worden naar dit pand geclusterd.";
		attribute<float32> Bebouwd0         (AllocDomain) := sum(MakeDefined(Pand0/Footprint[float32], 0f)[Toedeling0/Pand_rel] * Toedeling0/ToedelingPand, Toedeling0/AllocDomain_rel)
		, Descr = "De voetafdruk van alle panden in de cel in het beginjaar, in m2, om te toetsen of de schatting beter voorspelt op de cellen die toen nog beschikbaar waren (#647).";
	}
	container Groei      := Groei_T(2017, 2022), Descr = "De schattingsperiode (#708).";
	container GroeiToets := Groei_T(2022, 2026), Descr = "De toetsperiode: de kaart die op de schattingsperiode is geschat, moet de ontwikkeling van deze jaren goed rangschikken (#708).";
	container Groei2012  := Groei_T(2012, 2017), Descr = "De periode voor de schattingsperiode, om te toetsen of een tweede periode iets toevoegt (#708).";

	parameter<String> TellingBouw := 'periode;sector;cellen\n'
		+ AsList('2012-2017;' + TXLJobs6/name + ';' + string(Groei2012/Aantal), '\n') + '\n2012-2017;totaal;' + string(Groei2012/Totaal) + '\n'
		+ AsList('2017-2022;' + TXLJobs6/name + ';' + string(Groei/Aantal), '\n') + '\n2017-2022;totaal;' + string(Groei/Totaal) + '\n'
		+ AsList('2022-2026;' + TXLJobs6/name + ';' + string(GroeiToets/Aantal), '\n') + '\n2022-2026;totaal;' + string(GroeiToets/Totaal) + '\n'
	, StorageName = "='%LocalDataProjDir%/Diagnose/herschatting_werken_telling_bouw.txt'"
	, StorageType = "str"
	, Descr = "Het aantal ontwikkelde cellen per werksector in de drie periodes, als txt in de Diagnose-map; op aanvraag.";

	Template Covariaten_T
	: Descr = "De covariaten op cellen van 100 m aan het begin van een periode, met de transformaties van Calc_raw. De UAI en de landgebruiksaandelen komen uit de BAG en de BBG van Jaar, de werklocaties uit IBIS van IbisJaar. Van de afstanden, de grondprijs en de reistijden is geen oudere stand met dezelfde methode, dus die zijn in elke periode de kaart die de toepassing ook leest. De afstanden en de grondprijs zijn op 100 m gemaakt en naar 25 m gezet, dus het gemiddelde over de zestien cellen is die waarde zelf (#708)."
	{
		parameter<UInt32> Jaar;
		parameter<UInt32> IbisJaar;
		//
		parameter<String> BBG := '/BaseData/Grondgebruik/BBG/Dominant/Share_LU_Type/Y' + string(Jaar) + '/';
		container UAI := /BaseData/Suitabilities/Wonen/UrbanAttractivityIndex/CalculateUAI(/BaseData/Suitabilities/Wonen/UrbanAttractivityIndex/C_5000m_AbsWeight/potentiaal, /BaseData/Suitabilities/Wonen/UrbanAttractivityIndex/C_5000m_AbsWeight/distance_decay, Jaar)
		, Descr = "De UAI uit de BAG van Jaar, met de potentiaal en het afstandsverval van de UAI die het model toepast.";

		attribute<float32> ln_dist_cargoair          (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/DistTo_CargoAir / 1[km]), AdminDomain/AllocDomain_rel);
		attribute<float32> ln_dist_highway           (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/DistTo_Highway_acces_exit_2018 / 1[km]), AdminDomain/AllocDomain_rel);
		attribute<float32> ln_dist_seaport           (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/DistTo_Zeehavens_2019 / 1[km]), AdminDomain/AllocDomain_rel);
		attribute<float32> ln_dist_train             (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/DistTo_Trainstation_2019 / 1[km]), AdminDomain/AllocDomain_rel);
		attribute<float32> ln_landprice              (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/Hedonic_landPrice_2007 / 1[Eur_m2]), AdminDomain/AllocDomain_rel);
		attribute<float32> ln_dist_urbancontour      (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/DistTo_Urban_Contour_2000 / 1[km]), AdminDomain/AllocDomain_rel);
		attribute<float32> ln_tt_100k                (AllocDomain) := log(max_elem(/SourceData/Diversen/Impl/Reistijden/tt_100kinhab_min, 1[min]) / 1[min])[AllocDomain/rdc_100m_rel], Descr = "Reistijd naar 100.000 inwoners op de kaart van 2024.";
		attribute<float32> ln_tt_100k_2017           (AllocDomain) := log(max_elem(/SourceData/Diversen/Impl/Reistijden/tt_100kinhab_min_2017, 1[min]) / 1[min])[AllocDomain/rdc_100m_rel], Descr = "Reistijd naar 100.000 inwoners op de kaart van 2017, die met een andere methode is gemaakt dan die van 2024.";
		attribute<float32> ln_tt_500k                (AllocDomain) := log(max_elem(/SourceData/Diversen/Impl/Reistijden/tt_500kinhab_min, 1[min]) / 1[min])[AllocDomain/rdc_100m_rel], Descr = "Reistijd naar 500.000 inwoners op de kaart van 2024.";
		attribute<float32> ln_tt_ov                  (AllocDomain) := log(max_elem(/SourceData/Diversen/Impl/Reistijden/tt_OVknooppunten_min, 1[min]) / 1[min])[AllocDomain/rdc_100m_rel], Descr = "Reistijd naar het dichtstbijzijnde OV-knooppunt op de kaart van 2026.";
		attribute<float32> ln_uai                    (AllocDomain) := log(UAI/Resultaat + /ModelParameters/Werken_UAIVerschuiving);
		attribute<float32> lu_share_unavailable      (AllocDomain) := ='(' + BBG + 'infrastructure + ' + BBG + 'water)[AllocDomain/rdc_100m_rel]';
		attribute<float32> lu_share_construction     (AllocDomain) := ='' + BBG + 'construction[AllocDomain/rdc_100m_rel]';
		attribute<float32> lu_share_nature           (AllocDomain) := ='(' + BBG + 'othernature + ' + BBG + 'forest)[AllocDomain/rdc_100m_rel]';
		attribute<float32> lu_share_residential      (AllocDomain) := ='' + BBG + 'residential[AllocDomain/rdc_100m_rel]';
		attribute<float32> avgshr_otherbuiltup_1000m (AllocDomain) := ='/BaseData/Grondgebruik/BBG/Dominant/Avg_shr_LUType_neigh/Y' + string(Jaar) + '/r1000/otherbuiltup[AllocDomain/rdc_100m_rel]';
		attribute<float32> op_ibis_zeehaven          (AllocDomain) := float32(/SourceData/Grondgebruik/IBIS/Y2022/Zeehavens/Per_AllocDomain)
		, Descr = "1 als de cel in het vaste zeehavengebied ligt (SourceData/Grondgebruik/IBIS/Y2022/Zeehavens), en anders 0; in elke periode en in de toepassing hetzelfde gebied.";
		attribute<float32> op_ibis_overig            (AllocDomain) := ='float32(IsDefined(/SourceData/Grondgebruik/IBIS/Y' + string(IbisJaar) + '/Type_Per_AllocDomain) && !/SourceData/Grondgebruik/IBIS/Y2022/Zeehavens/Per_AllocDomain)'
		, Descr = "1 als de cel op een werklocatie uit de IBIS van IbisJaar ligt buiten het vaste zeehavengebied, ook een van onbekend type, en anders 0. In de toepassing is dat de IBIS van ModelParameters/IBIS_Year.";
		attribute<float32> Constant                  (AllocDomain) := const(1f, AllocDomain);

		attribute<bool> IsEindig (AllocDomain) := ='AND(' + AsList('abs(' + Var/name + ') < 1e30f', ',') + ')', Descr = "Alle termen van Var zijn gedefinieerd en eindig.";
	}
	container Covariaten      := Covariaten_T(Groei/BeginJaar, Groei/BeginJaar), Descr = "De covariaten aan het begin van de schattingsperiode.";
	container CovariatenToets := Covariaten_T(GroeiToets/BeginJaar, GroeiToets/BeginJaar), Descr = "De covariaten aan het begin van de toetsperiode.";
	container Covariaten2012  := Covariaten_T(Groei2012/BeginJaar, 2016), Descr = "De covariaten aan het begin van de periode 2012 tot 2017, met IBIS van 2016, de oudste jaargang in SourceData/Grondgebruik/IBIS.";

	attribute<float32> Lot      (AllocDomain) := rnd_uniform(/ModelParameters/Werken_Herschatting_Seed, AllocDomain, range(float32, 0f, 1f));
	attribute<bool>    InSample (AllocDomain) := AllocDomain/IsStudyArea && Covariaten/IsEindig && (IsDefined(Groei/keuze) || Lot < /ModelParameters/Werken_Herschatting_Trekking)
	, Descr = "Alle cellen met een ontwikkeling en een trekking uit de cellen zonder, binnen het studiegebied en met eindige waarden op alle termen.";

	attribute<bool>   ValtWeg (AllocDomain) := AllocDomain/IsStudyArea && !Covariaten/IsEindig, Descr = "Cellen in het studiegebied die niet mee kunnen doen, omdat een term geen eindige waarde heeft.";
	parameter<uint32> Weggevallen                := sum(uint32(ValtWeg)), Descr = "Aantal cellen in het studiegebied dat wegvalt.";
	parameter<uint32> WeggevallenMetOntwikkeling := sum(uint32(ValtWeg && IsDefined(Groei/keuze))), Descr = "Aantal cellen met een ontwikkeling dat wegvalt.";

	unit<uint64> Selectie := select_with_org_rel(InSample), Descr = "De cellen van 100 m in de steekproef; een selectie uit een grid is uint64.";
	unit<uint32> Obs := range(uint32, 0, uint32(#Selectie))
	, Descr = "De waarnemingen, als uint32 zoals Mlogit_T vraagt."
	{
		attribute<AllocDomain> org_rel := Selectie/org_rel[uint64(id(.))[Selectie]];
	}

	container Data :=
		for_each_nedv(
			Var/name
			, 'float64(Covariaten/' + Var/name + '[Obs/org_rel])'
			, Obs
			, float64
		)
	, Descr = "De invoer van Mlogit_T op de waarnemingen: de termen van Var, de keuze, het steekproefmasker en de trekkingskans."
	{
		attribute<TXLJobs6> keuze    (Obs) := Groei/keuze[Obs/org_rel];
		attribute<bool>     InSample (Obs) := const(TRUE, Obs);
		parameter<float64>  Trekkingskans := float64(/ModelParameters/Werken_Herschatting_Trekking);
	}

	parameter<String> Datum2022 := '20220401', Descr = "De bestandsdatum van de csv met de schatting uit Ruimte voor werken (2022), waar de herschatting naast wordt gelegd.";
	container ReadCoefficients2022 := for_each_ne(TXLJobs6/name, 'ReadCoefficientsT(' + quote(TXLJobs6/name) + ', Datum2022, '''')'), Descr = "De coëfficiënten van de schatting uit 2022, die het model niet meer leest.";
	Template Coef2022_T
	{
		parameter<String>  Sector;
		attribute<float64> beta (Var) := ='union_data(Var, ' + AsList(Var/naam2022 == '' ? '(0d/0d)' : 'float64(ReadCoefficients2022/' + Sector + '/Result/' + Var/naam2022 + ')', ', ') + ')';
	}
	container Coef2022PerSector := for_each_ne(TXLJobs6/name, 'Coef2022_T(' + quote(TXLJobs6/name) + ')');
	container Coef2022 := for_each_nedv(TXLJobs6/name, 'Coef2022PerSector/' + TXLJobs6/name + '/beta', Var, float64), Descr = "De coëfficiënten van de schatting uit 2022 voor de termen van Var, om de herschatting naast te leggen; bij de UAI is dat de lineaire term.";

	parameter<float64> n_ref := sum(IsDefined(Data/keuze) ? 0d : 1d), Descr = "Aantal waarnemingen zonder ontwikkeling in de steekproef.";
	Template Start_T
	: Descr = "Startpunt: per sector de constante op de log van het aantal ontwikkelingen gedeeld door het aantal zonder, het optimum van het model met alleen constanten, en de overige coefficienten op 0, zoals in Logit_T. Vanaf de oorspronkelijke coefficienten is de fit slechter dan met alleen constanten, omdat de steekproef en de weggelaten termen de constanten verschuiven."
	{
		unit<uint8> V;
		//
		parameter<V> ConstIdx := rlookup('Constant', V/name);
		container Start :=
			for_each_nedv(
				TXLJobs6/name
				, 'id(V) == ConstIdx ? log(sum(MakeDefined(Data/keuze == ' + string(id(TXLJobs6)) + '[TXLJobs6], FALSE) ? 1d : 0d) / n_ref) : 0d'
				, V
				, float64
			);
	}
	container StartSchatting := Start_T(Var);

	container Schatting := Templates/Statistiek/Mlogit_T('werken', Obs, Var, TXLJobs6, Data, StartSchatting/Start), Descr = "De schatting op de termen van Var, op de bouw van de schattingsperiode.";

	attribute<float64> Coef2022_schatting (Schatting/Par) := ='union_data(Schatting/Par, ' + asItemList('Coef2022/' + TXLJobs6/name) + ')';
	attribute<String>  Regel              (Schatting/Par) := Schatting/Par/name + ';' + MakeDefined(string(Coef2022_schatting), '') + ';' + string(Schatting/beta_gecorrigeerd) + ';' + string(Schatting/se);

	parameter<String>  Vergelijking := 'parameter;schatting2022;herschatting;se\n' + AsList(Regel, '\n') + '\n'
		+ 'waarnemingen;' + string(Schatting/N_) + '\nreferentie;' + string(Schatting/n_ref) + '\nLL0;' + string(Schatting/LL0)
		+ '\nLL;' + string(Schatting/LL_eind) + '\nMcFaddenR2;' + string(Schatting/McFaddenR2) + '\nConvergentieStap;' + string(Schatting/ConvergentieStap) + '\n'
	, StorageName = "='%LocalDataProjDir%/Diagnose/mlogit_werken_vergelijking.txt'"
	, StorageType = "str"
	, Descr = "De herschatting naast de schatting uit 2022, als txt in de Diagnose-map; op aanvraag.";
}
