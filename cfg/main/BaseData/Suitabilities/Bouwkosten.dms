//
// De CBS-bouwkosten per m2 bvo van het landsdeel op de cel, voor huur en koop (#870): de vergridding van de kentallen in ModelParameters/Wonen/Bouwkosten.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bouwkosten
: Descr = "De CBS-bouwkosten per m2 bvo van het landsdeel waarin de cel ligt, voor huurwoningen en koopwoningen, uit de kentallen in ModelParameters/Wonen/Bouwkosten. De geschiktheid
			(Templates/VariantData_T/Geschiktheden/Bouwkosten.dms) en de indicator KostenWoningbouw lezen deze twee kaarten; buiten de landsdeelpolygonen zijn ze null en vallen de lezers terug op het
			landelijk gemiddelde."
{
	unit<UInt32>         Landsdeel       := /ModelParameters/Wonen/Bouwkosten, Descr = "De landsdelen van CBS met hun kentallen per m2 bvo.";
	attribute<Landsdeel> Per_AllocDomain (AllocDomain) := poly2grid(Landsdeel/geometry, AllocDomain);
	attribute<Landsdeel> Per_AdminDomain (AdminDomain) := Per_AllocDomain[AdminDomain/AllocDomain_rel];
	attribute<Eur_m2>    SocialeHuur     (AdminDomain) := Landsdeel/Huurwoningen[Per_AdminDomain];
	attribute<Eur_m2>    VrijeSector     (AdminDomain) := Landsdeel/Koopwoningen[Per_AdminDomain];
}
