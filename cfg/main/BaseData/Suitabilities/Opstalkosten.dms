// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De opstalkosten: wat het kost om te verwerven en te slopen wat er op een cel staat, uitgesmeerd over het kadastrale perceel van de cel (#861)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Opstalkosten
: Descr = "Wat het kost om te verwerven en te slopen wat er op een cel staat (de verwervingskosten van woningen en niet-woningen, de sloopkosten van beide en de funderingsschade), uitgesmeerd over het kadastrale perceel (#861, SourceData/Vastgoed/BRK): elke cel
			hoort bij het perceel waarin haar midden ligt, de kosten van alle pandcellen van een perceel worden gelijk over de cellen van dat perceel verdeeld, en een cel zonder perceel houdt haar
			eigen kosten. Wie een pand koopt om te slopen koopt het perceel, dus de tuin kost wat het huis kost en een flat met zijn groen eromheen weegt op elke cel van het perceel; zonder uitsmering
			is een tuin of een stuk openbare ruimte in woongebied voor niets te koop. Het totaal per post blijft behouden (Behoud). De geschiktheid (Templates/Suitabilities/Suitability_Wonen_perOP_T)
			en de indicator Grondexploitatie lezen dit; de stand, de sloop en de andere indicatoren blijven per cel rekenen met wat er werkelijk staat."
{
	unit<UInt32>       Perceel     := /SourceData/Vastgoed/BRK/Perceel;
	attribute<Perceel> Eenheid_rel (AdminDomain) := /SourceData/Vastgoed/BRK/Perceel_rel, Descr = "Het perceel van de cel, de eenheid waarover de opstalkosten worden uitgesmeerd; null voor een cel waarvan het midden in geen perceel ligt.";

	attribute<Eur>  Verwerving_Woningen_Cel     (AdminDomain) := MakeDefined(Verwervingskosten/Woningen/Totaal,          0[Eur]), Descr = "De hedonische waarde van de woningen in de cel, nul zonder woningen.";
	attribute<Eur>  Verwerving_NietWoningen_Cel (AdminDomain) := MakeDefined(Verwervingskosten/Niet_Woningen/Totaal,     0[Eur]), Descr = "De verwervingskosten van het niet-woonvastgoed in de cel.";
	attribute<Eur>  Sloop_Woningen_Cel          (AdminDomain) := MakeDefined(Sloopkosten/Totaal,                         0[Eur]), Descr = "De sloopkosten van de woningen in de cel.";
	attribute<Eur>  Sloop_NietWoningen_Cel      (AdminDomain) := MakeDefined(Sloopkosten/Totaal_Niet_Woningen,           0[Eur]), Descr = "De sloopkosten van het niet-woonvastgoed in de cel.";
	attribute<Eur>  Funderingsschade_Cel        (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, /SourceData/Vastgoed/Funderingsschade/per_pand/k, 0[Eur]), 0[Eur]), Descr = "De funderingsschade van de woningen in de cel, nul zonder schade.";
	attribute<Bool> IsPandcel                   (AdminDomain) := Verwerving_Woningen_Cel > 0[Eur] || Verwerving_NietWoningen_Cel > 0[Eur] || Sloop_Woningen_Cel > 0[Eur] || Sloop_NietWoningen_Cel > 0[Eur], Descr = "Staat er in de cel een BAG-pand met een verwervings- of sloopkostenpost: woningen met een hedonische waarde of met woonoppervlak, of niet-woonvloeroppervlak? Ook de sloopposten tellen, anders valt een woning zonder prijs buiten de uitsmering en gaat haar sloopkostenpost verloren.";


	attribute<UInt64> CellenPerEenheid     (Perceel) := pcount(Eenheid_rel), Descr = "Het aantal cellen van het perceel, de noemer van de uitsmering; minstens een voor een perceel met een cel.";
	attribute<UInt32> PandcellenPerEenheid (Perceel) := sum_uint32(IsPandcel, Eenheid_rel), Descr = "Het aantal pandcellen op het perceel.";
	attribute<Bool>    HeeftOpstal (Perceel) := PandcellenPerEenheid > 0, Descr = "Staat er op het perceel een pand met een kostenpost? Dan kiest de allocatie voor wonen het perceel als geheel: zijn beschikbare cellen krijgen hetzelfde saldo (Templates/Suitabilities/Suitability_Wonen_perOP_T, PerPerceel) en dezelfde dichtheidstoets (WoningenPerCelEenheid).";
	attribute<Perceel> Eenheid_rel_Compacted (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Eenheid_rel), Descr = "Het perceel van de cel op het domein waarop de zeef en de geschiktheid rekenen.";
	attribute<Woning>  Woningen_Eenheid      (Perceel) := sum(/BaseData/StartState/StateBasisjaar/Src0/Wonen/WP1s/Totaal, Eenheid_rel_Compacted), Descr = "De woningen van het basisjaar op het perceel.";
	attribute<Woning>  WoningenPerCelEenheid (CompactedAdminDomain) := IsDefined(Eenheid_rel_Compacted) && HeeftOpstal[Eenheid_rel_Compacted] ? Woningen_Eenheid[Eenheid_rel_Compacted] / float32(CellenPerEenheid[Eenheid_rel_Compacted]) : /BaseData/StartState/StateBasisjaar/Src0/Wonen/WP1s/Totaal
	, Descr = "De woningen per cel waar de dichtheidstoets van wonen mee rekent: op een perceel met een pand het gemiddelde over de cellen van het perceel, zodat een flat met zijn groen als geheel wordt getoetst; elders de woningen van de cel zelf.";
	parameter<Float32> AandeelPandcellenMetPerceel := float32(sum(uint32(IsPandcel && IsDefined(Eenheid_rel)))) / float32(sum(uint32(IsPandcel)))
	, Descr = "Het aandeel van de pandcellen met een perceel. Een pand staat altijd op een perceel, dus dit hoort dicht bij een te liggen; een lage waarde betekent een lege of verschoven perceelkaart, en dan smeert de uitsmering niets uit zonder dat iets anders faalt. Diagnose/Basisjaar leest dit (ChecksBasisjaar).";

	Template Uitsmeren_T
	: Descr = "Smeert een kostenpost van de pandcellen uit over hun perceel: de post van alle pandcellen van het perceel samen, gelijk verdeeld over alle cellen van het perceel. Een cel zonder perceel houdt haar eigen post. De som over alle cellen is de som van de post."
	{
		attribute<Eur> Bron (AdminDomain);
		//
		attribute<Eur>     PerEenheid (Perceel)     := sum(Bron, Eenheid_rel), Descr = "De post van alle pandcellen van het perceel samen.";
		attribute<Eur>     Result     (AdminDomain) := IsDefined(Eenheid_rel) ? PerEenheid[Eenheid_rel] / float32(CellenPerEenheid[Eenheid_rel]) : Bron, Descr = "De uitgesmeerde post per cel: het perceelstotaal gedeeld door het aantal cellen van het perceel.";
		parameter<Float64> Behoud                   := sum(float64(Result)) / sum(float64(Bron)), Descr = "Het totaal na de uitsmering gedeeld door het totaal ervoor; een, op afronding na. De controlewaarde brk_uitsmering_behoud in Diagnose/ChecksBasisjaar leest die van de verwervingskosten van woningen van het eerste zichtjaar.";
	}

	container Verwerving_NietWoningen := Uitsmeren_T(Verwerving_NietWoningen_Cel), Descr = "De verwervingskosten van het niet-woonvastgoed, uitgesmeerd.";
	container Sloop_Woningen           := Uitsmeren_T(Sloop_Woningen_Cel),          Descr = "De sloopkosten van de woningen, uitgesmeerd.";
	container Sloop_NietWoningen       := Uitsmeren_T(Sloop_NietWoningen_Cel),      Descr = "De sloopkosten van het niet-woonvastgoed, uitgesmeerd.";
	container Funderingsschade         := Uitsmeren_T(Funderingsschade_Cel),        Descr = "De funderingsschade, uitgesmeerd zoals de woningwaarde, zodat de afwaardering in de geschiktheid schade en waarde van hetzelfde perceel vergelijkt.";

	container PerZichtjaar :=
		for_each_ne(
			/Classifications/Time/Zichtjaar/name
			, 'PerZichtjaar_T('+quote(/Classifications/Time/Zichtjaar/name)+')'
		), Descr = "Per zichtjaar de verwervingskosten van de woningen in geld, uitgesmeerd: de hedonische waarde min de korting voor corporatiebezit (#861), maal de vervangingsfactor van dat zichtjaar (#859). De kenmerken die bepalen welke bestaande bouw aan de beurt is, zoals bouwperiode, eigendom en energielabel, gaan sinds #869 niet meer als opslag in deze kosten maar in de herontwikkelingskans.";

	Template PerZichtjaar_T
	{
		parameter<String> Zichtjaar_name;
		//
		attribute<Eur> Bron (AdminDomain) := ='(Verwerving_Woningen_Cel - Corporatiebezit/Korting) * Vervanging/PerZichtjaar/'+Zichtjaar_name+'/Factor', Descr = "De verwervingskosten van de woningen in de cel in dit zichtjaar: de hedonische waarde min de korting voor corporatiebezit, maal de vervangingsfactor.";
		container Verwerving_Woningen := Uitsmeren_T(Bron);
	}
}
