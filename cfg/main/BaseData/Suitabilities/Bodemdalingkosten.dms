////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De kengetallen en de hoeveelheden achter de kosten van bouwen op een bodemdalingsgevoelige
// ondergrond (#505). Beide zijn variantonafhankelijk en staan daarom in BaseData; de berekening zelf
// staat in Templates/Suitabilities/Bodemdalingkosten_T en wordt zowel per ontwikkelpakket als per cel
// aangeroepen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bodemdalingkosten
: Descr = "De invoer voor de kosten van bouwen op een bodemdalingsgevoelige ondergrond: de tarieven uit bijlage E van het landelijk afwegingskader bodemdalingbestendige nieuwbouw, en de vier hoeveelheidskaarten waarin die tarieven zijn uitgedrukt.

			Bron: 11211556-001-BGS-0001, 23 maart 2026, Deltares en Sweco in opdracht van IenW. Kaarten geleverd op 27 augustus 2026, zie SourceData/Bodem/Bodemdalingbestendig.

			Hier staat alleen de invoer. De rekenkern staat in Templates/Suitabilities/Bodemdalingkosten_T, zodat dezelfde formules zowel per ontwikkelpakket kunnen draaien voor het exploitatiesaldo als een keer per cel voor de indicator."
{
	container Hoeveelheden
	: Descr = "De vier geleverde kaarten op AdminDomain, plus de grootheid die daaruit volgt."
	{
		attribute<meter> Ophoogdikte           (AdminDomain) := /SourceData/Bodem/Bodemdalingbestendig/Ophoogdikte[AdminDomain/rdc_100m_rel],           Descr = "Benodigde ophoogdikte zand voor integraal ophogen.";
		attribute<meter> Heipaallengte         (AdminDomain) := /SourceData/Bodem/Bodemdalingbestendig/Heipaallengte[AdminDomain/rdc_100m_rel],         Descr = "Benodigde heipaallengte, in de levering afgekapt op de klasse boven 14 meter.";
		attribute<meter> AfgraafdiepteDrijvend (AdminDomain) := /SourceData/Bodem/Bodemdalingbestendig/AfgraafdiepteDrijvend[AdminDomain/rdc_100m_rel], Descr = "Af te graven diepte voor aquatisch bouwen.";
		attribute<meter> DikteEPS              (AdminDomain) := /SourceData/Bodem/Bodemdalingbestendig/DikteEPS[AdminDomain/rdc_100m_rel],              Descr = "Dikte van de EPS-laag bij een leeflaag van 30 cm.";
		attribute<meter> AfgraafdiepteEPS      (AdminDomain) := /SourceData/Bodem/Bodemdalingbestendig/AfgraafdiepteEPS[AdminDomain/rdc_100m_rel],      Descr = "De af te graven laag bij licht ophoogmateriaal, meetkundig afgeleid als de laagdikte plus 10 cm.";

		attribute<Bool>  HeeftEPS (AdminDomain) := IsDefined(DikteEPS), Descr = "Waar de EPS-kaart niets zegt is alternatief D niet beschikbaar. De kaart dekt 32.635 km2.";

		attribute<meter> OphoogdikteOverstroming (AdminDomain) :=
			/Classifications/Overstromingsgevaarzonering/zoneringK/VraagtAangepastBouwen[/BaseData/Omgeving/Overstromingsgevaarzonering]
				? MakeDefined(/BaseData/Omgeving/Overstromingsdiepte, 0[meter])
				: 0[meter]
		,	Descr = "Hoeveel moet het maaiveld omhoog om boven de overstromingsdiepte uit te komen? Alleen in de gevaarzones die aangepast bouwen vragen, elders nul. Dezelfde dieptekaart als de zeef leest, dus het elementgewijze maximum van de drie LIWO-kaarten.

					Dit is de overstromingskant van dezelfde grootheid als Ophoogdikte hierboven. Allebei increments op het huidige maaiveld: de ophoogdikte omdat het rapport eist dat het nieuwe maaiveld 20 cm boven het huidige uitkomt, en de overstromingsdiepte omdat de LIWO-kaarten de waterdiepte boven datzelfde maaiveld geven. Daarom zijn ze vergelijkbaar en kan OphoogdikteTotaal het maximum van de twee nemen. Zie #681.";

		attribute<meter> OphoogdikteTotaal (AdminDomain) := =
			/ModelParameters/Wonen/OverstromingsophogingInBodemdalingkosten
				? 'max_elem(Ophoogdikte, OphoogdikteOverstroming)'
				: 'Ophoogdikte'
		,	Descr = "De ophoging die deze plek werkelijk vraagt: het maximum van wat de bodemdaling vraagt en wat de overstromingsdiepte vraagt. Het maximum en niet de som, want wie tot de diepste van de twee eisen ophoogt voldoet aan allebei; optellen zou hetzelfde zand twee keer rekenen.

					Dit is de maaiveldboekhouding uit #681 in zijn kleinste vorm. Wat er nog niet in zit: de ophoogdikte is zettingsbewust over dertig jaar en de overstromingsdiepte niet, en de dieptekaarten zijn statisch over de zichtjaren. Het maximum van twee grootheden die op verschillende momenten gelden onderschat dus; dat is bekend en staat in #681.

					Alleen de ophogende alternatieven volgen dit getal. Bij licht ophoogmateriaal komt de laagdikte uit een geleverde kaart die de overstromingseis niet kent, dus daar is de post te laag zodra de overstroming de bodemdaling overheerst. Alles funderen en drijvend bouwen hogen het maaiveld niet op en krijgen langs deze weg dus geen extra post.

					Let op wat dat laatste wel en niet betekent. De keuze tussen de zes alternatieven in Bodemdalingkosten_T/Goedkoopste is het goedkoopste beschikbare alternatief per cel, en Beschikbaar/A tot en met F hangen alleen aan de locatie en aan de schakelaars in ModelParameters, niet aan de bouwwijze van het gealloceerde ontwikkelpakket. Een drijvend pakket wordt dus doorgerekend als partieel ophogen zolang dat goedkoper is, en betaalt met deze schakelaar aan een ophoging die het fysiek niet uitvoert. Dat is een overschatting en geen onderschatting, ze betreft de LNL-laag-pakketten, en ze verdwijnt zodra de bouwwijze per cel uit de benodigde ophoging volgt in plaats van uit de OP-tabel. Zie #681.";

		attribute<Eur_m2> Paaltarief (AdminDomain) :=
			  Heipaallengte <  1.2[meter] ? 0[Eur_m2]
			: Heipaallengte <= 5.0[meter] ? Kengetallen/Paal_kort
			: Kengetallen/Paal_permeter * (Heipaallengte / 1[meter])
		,	Descr = "De heipaalstaffel uit Tabel E-1: onder 1,2 meter gratis, van 1,2 tot 5 meter een vast bedrag, daarboven evenredig met de lengte.

					Let op de eenheid. In Tabel E-1 staat de staffel als bedrag per heipaal, in de tabellen E-3 tot en met E-7 staat dezelfde staffel met dezelfde getallen als bedrag per m2. Hoeveel palen er per m2 bebouwing nodig zijn geeft het rapport nergens. We lezen de staffel daarom overal als bedrag per m2, wat de tabellen onderling consistent maakt en geen getal vraagt dat er niet is.

					Ordegrootte-toets: een woning met 60 m2 voetafdruk op palen van 12 meter komt daarmee op 18.000 euro fundering. Dat ligt in de goede orde voor een paalfundering onder een rijtjeswoning. De andere lezing, waarbij die 60 m2 bijvoorbeeld tien palen krijgt, geeft 3.000 euro en dat is te laag. Zie de aannamelijst bij #505.";
	}

	container Kengetallen
	: Descr = "De tarieven uit de tabellen E-1 tot en met E-9, in euro per m2, exclusief btw, prijspeil GWWkosten 2024 en een interne kostendatabase van Sweco. De opslag van 19 procent voor algemene kosten, uitvoeringskosten en winst en risico staat apart in Opslag."
	{
		parameter<Eur_m2> Ophogen_permeter     := 20[Eur_m2],  Descr = "Ophogen en voorbelasten met ophoogzand, per m2 per meter ophoging.";
		parameter<Eur_m2> Paal_kort            := 25[Eur_m2],  Descr = "Heipalen van 1,2 tot 5 meter.";
		parameter<Eur_m2> Paal_permeter        := 25[Eur_m2],  Descr = "Heipalen boven 5 meter, per meter paallengte.";
		parameter<Eur_m2> Afgraven_permeter    := 15[Eur_m2],  Descr = "Afgraven en afvoeren grond, per m2 per meter, transportafstand circa 25 km, geen restwaarde.";
		parameter<Eur_m2> Afgraven_vast        := 15[Eur_m2],  Descr = "Afgraven en afvoeren grond onder bebouwing bij drijvend bouwen, per m2.";
		parameter<Eur_m2> Drijfconstructie     := 600[Eur_m2], Descr = "Drijf- en aanmeerconstructie. De gevoeligheidsanalyse F.11 van het rapport rekent met 500.";
		parameter<Eur_m2> InrichtenGroen       := 5[Eur_m2],   Descr = "Inrichten groen: struiken en heesters, gras, bermen.";
		parameter<Eur_m2> InrichtenPark        := 20[Eur_m2],  Descr = "Inrichten park, wijk-, buurt- of blokgroen: grasveld met bomen, betonband, een bankje met prullenbak.";
		parameter<Eur_m2> Verharding           := 75[Eur_m2],  Descr = "Straatklinkers met een fundering van menggranulaat van 0,3 m.";
		parameter<Eur_m2> Riolering            := 161[Eur_m2], Descr = "Riool exclusief verharding, drukriool met 30 procent opslag, 30/70 verdeling enkele en dubbele streng, 890 euro per m1 gedeeld door 5,5 meter straatbreedte.";
		parameter<Eur_m2> Steigers             := 1000[Eur_m2],Descr = "Plaatsen steigers voor toegang tot de woningen bij drijvend bouwen.";
		parameter<Eur_m2> Betonconstructie     := 278[Eur_m2], Descr = "Betonconstructie zonder verharding: afgraven en afvoeren tot 1,5 m, werkvloer 0,3 m, betonconstructie 0,55 m, grond of zand 2 m.";
		parameter<Eur_m2> BetonEnVerharding    := 340[Eur_m2], Descr = "Betonconstructie met verharding. Bevat blijkens de opbouw in het rapport al klinkerverharding a 62 euro, dus de losse verhardingspost van 75 euro telt hier niet nog eens bovenop. Zie AlternatiefE_TeltVerhardingApart.";

		parameter<Eur_m2> EPS_permeter         := 125[Eur_m2], Descr = "Licht ophoogmateriaal EPS, per m2 per meter laagdikte.";
		parameter<Eur_m2> EPS_afgraven_permeter:= 5[Eur_m2],   Descr = "Afgraven bij licht ophoogmateriaal, per m2 per meter. De afgegraven laag wordt in het gebied hergebruikt en hoeft niet te worden afgevoerd, vandaar het lagere tarief dan bij drijvend bouwen.";
		parameter<meter>  EPS_afdeklaag        := 0.3[meter],  Descr = "Dikte van de leeflaag bovenop het EPS, waarvoor de kaart DikteEPS is doorgerekend.";
		parameter<Eur_m2> Afdeklaag_permeter   := 20[Eur_m2],  Descr = "Aanbrengen afdeklaag van grond of zand, per m2 per meter.";

		parameter<meter>  OphoogdikteAlternatiefC := 1.2[meter], Descr = "Alternatief C hoogt overal met een vaste 1,20 meter zand op, ook waar integraal ophogen met minder toe kan.";
		parameter<meter>  OphoogdikteReferentie   := 0.2[meter], Descr = "De ophoging op een locatie zonder bodemdalingsopgave: de eis dat het nieuwe maaiveld 20 cm boven het huidige uitkomt. Dit is het nulpunt waartegen de meerkosten worden gemeten.";

		parameter<Float32> Opslag := 1.19f, Descr = "Opslag van 19 procent voor algemene kosten, uitvoeringskosten en winst en risico, zoals in het rapport op alle aanlegkosten gelegd.";

		parameter<Eur_m2> Onderhoud_Groen      := 73.16[Eur_m2],  Descr = "Tabel E-9: groenonderhoud a 1,80 euro per m2 per jaar, contant gemaakt over 100 jaar. Geldt voor tuinen, parken en de overige openbare ruimte, in alle zes de alternatieven.";
		parameter<Eur_m2> Onderhoud_Water      := 27.73[Eur_m2],  Descr = "Tabel E-9: baggerkosten a 0,67 euro per m2 per jaar, contant over 100 jaar. Alleen bij drijvend bouwen gerekend, vanwege het grote wateroppervlak.";
		parameter<Eur_m2> Onderhoud_Verharding := 40.64[Eur_m2],  Descr = "Tabel E-9: 1,00 euro per m2 per jaar, onderhoudscyclus van 52 jaar op basis van CROW-145.";
		parameter<Eur_m2> Onderhoud_Riolering  := 108.38[Eur_m2], Descr = "Tabel E-9: 1,60 euro per m2 per jaar, stelsel een keer vervangen in 100 jaar.";
		parameter<Eur_m2> Onderhoud_Steigers   := 364.75[Eur_m2], Descr = "Tabel E-9: een keer per twee jaar schoonspuiten a 5 euro per m2 en een keer per 60 jaar vervangen a 1.000 euro per m2. Alleen bij drijvend bouwen.";

		parameter<Bool> AlternatiefE_TeltVerhardingApart := FALSE
		,	Descr = "Tabel E-3 zet bij alternatief E een kruisje bij Aanbrengen verharding (75 euro) en ook bij Aanbrengen betonconstructie en verharding (340 euro), terwijl de opbouw van die 340 euro in de lopende tekst al klinkerverharding a 62 euro bevat. In E-4 heeft verharding juist geen kruisje bij E. We lezen dat als een dubbeltelling in E-3 en tellen de verharding bij E dus niet apart mee. Dit is een aanname; zie de openstaande vraag aan Deltares in #505.";
	}

	container Tarief
	: Descr = "Het tarief per m2 dat van de locatie afhangt, dus van de vier kaarten. Staat hier en niet in het sjabloon, zodat het maar een keer over het domein wordt uitgerekend en niet opnieuw voor elk van de 53 ontwikkelpakketten."
	{
		attribute<Eur_m2> Ophogen     (AdminDomain) := Kengetallen/Ophogen_permeter * (Hoeveelheden/OphoogdikteTotaal / 1[meter]), Descr = "Leest OphoogdikteTotaal en niet Ophoogdikte, zodat de overstromingsophoging meebetaalt zodra ModelParameters/Wonen/OverstromingsophogingInBodemdalingkosten aanstaat. Met die schakelaar uit is dit letterlijk Ophoogdikte en verandert er niets. Zie #681.";
		attribute<Eur_m2> OphogenC    (AdminDomain) := const(Kengetallen/Ophogen_permeter * (Kengetallen/OphoogdikteAlternatiefC / 1[meter]), AdminDomain);
		attribute<Eur_m2> OphogenRef  (AdminDomain) := const(Kengetallen/Ophogen_permeter * (Kengetallen/OphoogdikteReferentie   / 1[meter]), AdminDomain);
		attribute<Eur_m2> Paal        (AdminDomain) := Hoeveelheden/Paaltarief;
		attribute<Eur_m2> EPS         (AdminDomain) :=
			  Kengetallen/EPS_afgraven_permeter * (Hoeveelheden/AfgraafdiepteEPS / 1[meter])
			+ Kengetallen/EPS_permeter          * (Hoeveelheden/DikteEPS         / 1[meter])
			+ Kengetallen/Afdeklaag_permeter    * (Kengetallen/EPS_afdeklaag     / 1[meter]);
		attribute<Eur_m2> AfgravenD   (AdminDomain) := Kengetallen/Afgraven_permeter * (Hoeveelheden/AfgraafdiepteDrijvend / 1[meter]), Descr = "Afgraven voor open water bij drijvend bouwen.";
		attribute<Eur_m2> VerhardingE (AdminDomain) := = Kengetallen/AlternatiefE_TeltVerhardingApart ? 'const(Kengetallen/Verharding, AdminDomain)' : 'const(0[Eur_m2], AdminDomain)';
	}

	container Beschikbaar
	: Descr = "Welke alternatieven op deze plek mogen meedoen in de keuze. Hangt van de locatie af en niet van het ontwikkelpakket, dus ook dit staat buiten het sjabloon."
	{
		parameter<Bool>  A := /ModelParameters/Wonen/Bodemdaling_AlternatiefToegestaan_A;
		parameter<Bool>  B := /ModelParameters/Wonen/Bodemdaling_AlternatiefToegestaan_B;
		parameter<Bool>  E := /ModelParameters/Wonen/Bodemdaling_AlternatiefToegestaan_E;
		parameter<Bool>  F := /ModelParameters/Wonen/Bodemdaling_AlternatiefToegestaan_F;

		attribute<Bool>  C (AdminDomain) := /ModelParameters/Wonen/Bodemdaling_AlternatiefToegestaan_C && Hoeveelheden/OphoogdikteTotaal <= Kengetallen/OphoogdikteAlternatiefC
		,	Descr = "Ophogen met een vaste 1,20 meter zand voldoet alleen waar integraal ophogen met niet meer dan 1,20 meter toe kan. Waar meer nodig is haalt dit alternatief de eisen niet; het rapport laat in Figuur 3-6 zien wanneer dat misgaat, maar dat is als kaart niet geleverd. Gevolg van deze keuze is dat C nooit wint: waar hij mag, is integraal ophogen per definitie niet duurder. Hij blijft in de opsomming staan omdat het rapport zes alternatieven kent en de zeef er later op kan gaan sturen.";

		attribute<Bool>  D (AdminDomain) := /ModelParameters/Wonen/Bodemdaling_AlternatiefToegestaan_D && Hoeveelheden/HeeftEPS
		,	Descr = "Licht ophoogmateriaal vraagt de EPS-kaart, en die dekt niet het hele land.";
	}
}
