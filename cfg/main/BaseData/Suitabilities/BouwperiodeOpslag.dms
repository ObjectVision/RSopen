// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het effect van de bouwperiode van de woningen op de herontwikkelingskans, per woning van het basisjaar (#861, #869)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BouwperiodeOpslag
: Descr = "Het effect van de bouwperiode op de herontwikkelingskans, per woning van het basisjaar (#861, #869): het effect van haar bouwperiode uit ModelParameters/Wonen/BouwperiodeOpslag,
			in de stad uit de base-specificatie en daarbuiten uit de rural-specificatie (Stedelijkheid). Tot #869 rekende dit per cel om naar een opslag in euro op de verwervingskosten, met een
			nulpunt en een ijkconstante per zone; dat is vervallen."
{
	unit<UInt32>       vbo                      := Verwervingskosten/vbo_startjaar;
	attribute<Bool>    IsStedelijk_VBO   (vbo)  := Stedelijkheid/IsStedelijk[vbo/AdminDomain_rel];
	attribute<Float32> Coef_VBO          (vbo)  := Vervanging/HeeftBouwjaar
		? (IsStedelijk_VBO ? /ModelParameters/Wonen/BouwperiodeOpslag/Coef[Vervanging/Bouwperiode_rel] : /ModelParameters/Wonen/BouwperiodeOpslag/Coef_Landelijk[Vervanging/Bouwperiode_rel])
		: null_f, Descr = "Het effect van de bouwperiode van de woning op de log-odds van herontwikkeling, uit de specificatie van haar zone; null zonder bouwjaar.";
}
