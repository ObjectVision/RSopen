// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De opslag op de verwervingskosten van woningen naar de bouwperiode (#861)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BouwperiodeOpslag
: Descr = "De opslag op de verwervingskosten van woningen naar de bouwperiode, per cel (#861): per woning van het basisjaar het effect van haar bouwperiode uit
			ModelParameters/Wonen/BouwperiodeOpslag min het effect op het nulpunt, in de stad uit de base-specificatie en daarbuiten uit de rural-specificatie (Stedelijkheid), per cel het
			gemiddelde over haar woningen maal de sterkte, min de verschuiving van het nulpunt in de stad of daarbuiten, omgerekend naar euro per hectare met de wisselkoers van de cel en maal de
			oppervlakte van de cel. Herontwikkeleenheid telt haar op bij de verwervingskosten; een woning zonder bouwjaar telt niet mee in het gemiddelde."
{
	unit<UInt32>       vbo                      := Verwervingskosten/vbo_startjaar;
	attribute<Bool>    IsStedelijk_VBO   (vbo)  := Stedelijkheid/IsStedelijk[vbo/AdminDomain_rel];
	attribute<Float32> Coef_VBO          (vbo)  := Vervanging/HeeftBouwjaar
		? (IsStedelijk_VBO ? /ModelParameters/Wonen/BouwperiodeOpslag/Coef[Vervanging/Bouwperiode_rel] : /ModelParameters/Wonen/BouwperiodeOpslag/Coef_Landelijk[Vervanging/Bouwperiode_rel])
		: null_f;
	parameter<Float32> Coef_Gemiddeld_Stedelijk := mean(IsStedelijk_VBO ? Coef_VBO : null_f), Descr = "Het gemiddelde effect over de woningen met een bouwjaar in de stad.";
	parameter<Float32> Coef_Gemiddeld_Landelijk := mean(IsStedelijk_VBO ? null_f : Coef_VBO), Descr = "Het gemiddelde effect over de woningen met een bouwjaar daarbuiten.";
	parameter<Float32> Anker_Stedelijk          := = /ModelParameters/Wonen/BouwperiodeOpslag/Nulpunt == 'Gemiddelde'
		? 'Coef_Gemiddeld_Stedelijk'
		: '/ModelParameters/Wonen/BouwperiodeOpslag/Coef[rlookup(' + quote(/ModelParameters/Wonen/BouwperiodeOpslag/Nulpunt) + ', /Classifications/Vastgoed/Bouwperiode/name)]'
	, IntegrityCheck = "IsDefined(this)", Descr = "Het effect waarop de opslag in de stad nul is; een nulpunt dat geen bouwperiode is faalt hier.";
	parameter<Float32> Anker_Landelijk          := = /ModelParameters/Wonen/BouwperiodeOpslag/Nulpunt == 'Gemiddelde'
		? 'Coef_Gemiddeld_Landelijk'
		: '/ModelParameters/Wonen/BouwperiodeOpslag/Coef_Landelijk[rlookup(' + quote(/ModelParameters/Wonen/BouwperiodeOpslag/Nulpunt) + ', /Classifications/Vastgoed/Bouwperiode/name)]'
	, IntegrityCheck = "IsDefined(this)", Descr = "Het effect waarop de opslag daarbuiten nul is.";
	attribute<Float32> Afwijking_VBO     (vbo)         := Coef_VBO - (IsStedelijk_VBO ? Anker_Stedelijk : Anker_Landelijk);
	attribute<Float32> Afwijking_Cel     (AdminDomain) := mean(Afwijking_VBO, vbo/AdminDomain_rel);
	attribute<Float32> Verschuiving_Cel  (AdminDomain) := Stedelijkheid/IsStedelijk ? /ModelParameters/Wonen/BouwperiodeOpslag/Verschuiving_Stedelijk : /ModelParameters/Wonen/BouwperiodeOpslag/Verschuiving_Landelijk, Descr = "De verschuiving van het nulpunt op de cel, die van de stad of die daarbuiten.";
	attribute<Eur>     Opslag_Cel        (AdminDomain) := MakeDefined(Verwervingskosten/Woningen/Totaal, 0[Eur]) > 0[Eur] ? ((MakeDefined(Afwijking_Cel, 0f) * /ModelParameters/Wonen/BouwperiodeOpslag/Sterkte - Verschuiving_Cel) * Stedelijkheid/Wisselkoers)[Eur_ha] * AdminDomain/NrHaPerCell : 0[Eur]
	, Descr = "De opslag van de cel: negatief voor een cel met woningen uit een bouwperiode die vaker wordt herontwikkeld dan die van het nulpunt, en voor elke cel met woningen de verschuiving van het nulpunt maal de wisselkoers.";
}
