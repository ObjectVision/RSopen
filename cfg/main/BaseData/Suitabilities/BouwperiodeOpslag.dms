//
// De opslag op de verwervingskosten van woningen naar de bouwperiode (#861)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BouwperiodeOpslag
: Descr = "De opslag op de verwervingskosten van woningen naar de bouwperiode, per cel (#861): per woning van het basisjaar het effect van haar bouwperiode uit
			ModelParameters/Wonen/BouwperiodeOpslag min het effect op het nulpunt, per cel het gemiddelde over haar woningen, omgerekend naar euro per hectare met het effect van de
			verwervingskosten uit ModelParameters/Wonen/Eigendom, maal de sterkte en de oppervlakte van de cel. Herontwikkeleenheid telt haar op bij de verwervingskosten; een woning zonder
			bouwjaar telt niet mee."
{
	unit<UInt32>       vbo            := Verwervingskosten/vbo_startjaar;
	attribute<Float32> Coef_VBO       (vbo)         := Vervanging/HeeftBouwjaar ? /ModelParameters/Wonen/BouwperiodeOpslag/Coef[Vervanging/Bouwperiode_rel] : null_f;
	parameter<Float32> Coef_Gemiddeld                := mean(Coef_VBO), Descr = "Het gemiddelde effect over de woningen met een bouwjaar.";
	parameter<Float32> Anker                         := = /ModelParameters/Wonen/BouwperiodeOpslag/Nulpunt == 'Gemiddelde'
		? 'Coef_Gemiddeld'
		: '/ModelParameters/Wonen/BouwperiodeOpslag/Coef[rlookup(' + quote(/ModelParameters/Wonen/BouwperiodeOpslag/Nulpunt) + ', /Classifications/Vastgoed/Bouwperiode/name)]'
	, IntegrityCheck = "IsDefined(this)", Descr = "Het effect waarop de opslag nul is; een nulpunt dat geen bouwperiode is faalt hier.";
	attribute<Float32> Afwijking_Cel  (AdminDomain) := mean(Coef_VBO - Anker, vbo/AdminDomain_rel);
	attribute<Eur>     Opslag_Cel     (AdminDomain) := MakeDefined(Verwervingskosten/Woningen/Totaal, 0[Eur]) > 0[Eur] ? (MakeDefined(Afwijking_Cel, 0f) * /ModelParameters/Wonen/BouwperiodeOpslag/Sterkte / /ModelParameters/Wonen/Eigendom/Coef_Verwervingskosten * 1000000f)[Eur_ha] * AdminDomain/NrHaPerCell : 0[Eur]
	, Descr = "De opslag van de cel, negatief voor een cel met woningen uit een bouwperiode die vaker wordt herontwikkeld dan die van het nulpunt.";
}
