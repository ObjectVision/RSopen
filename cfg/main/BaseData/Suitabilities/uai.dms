////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Berekening van de Urban Attractivity Index (UAI) op basis van de potentie en afstand tot voorzieningen en
// monumenten Template voor het berekenen van de UAI op basis van een bepaalde potentiaal en
// afstandsvervalfunctie De UAI is de som van de genormaliseerde potentiaal van detailhandel, bijeenkomst/logies
// en monumentaal vastgoed.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container UrbanAttractivityIndex
: Descr = "Berekening van de Urban Attractivity Index (UAI) op basis van de potentie en afstand tot voorzieningen en monumenten"
{
	attribute<Float32> R_5000m_AbsWeight (AllocDomain) := C_5000m_AbsWeight/Resultaat;
	parameter<String>  FingerprintDeel_Maxima          := 'uai_max=' + string(/ModelParameters/Werken/UAIMaximum/Detailhandel) + '_' + string(/ModelParameters/Werken/UAIMaximum/BijeenkomstLogies) + '_' + string(/ModelParameters/Werken/UAIMaximum/Monumentaal), Descr = "De landelijke maxima waarop R_5000m_AbsWeight normeert, voor de fingerprint van elk ontkoppeld bestand dat deze UAI leest (#888).";
	
	container C_5000m_AbsWeight := CalculateUAI(5000, 'AbsWeight', BAG_RecentYear, TRUE), Descr = "De UAI die het model toepast, genormeerd op de landelijke maxima uit ModelParameters/Werken/UAIMaximum, zodat een regionale run dezelfde waarden krijgt als een landelijke (#888).";

	Template CalculateUAI
	: Descr = "Template voor het berekenen van de UAI op basis van een bepaalde potentiaal en afstandsvervalfunctie, uit de BAG-stand van 1 januari van BAG_jaar. NormeerLandelijk kiest of elke potentiaal op zijn landelijke maximum uit ModelParameters/Werken/UAIMaximum normeert of op het maximum in het studiegebied (#888)."
	{
		parameter<UInt32> potentiaal;
		parameter<String> distance_decay;
		parameter<UInt32> BAG_jaar;
		parameter<Bool>   NormeerLandelijk;
		///

		attribute<Float32> Resultaat    (AllocDomain)        := Detailhandel/norm + BijeenkomstLogies/norm + Monumentaal/norm, Descr = "De UAI is de som van de genormaliseerde potentiaal van detailhandel, bijeenkomst/logies en monumentaal vastgoed.";
		attribute<Float32> Resultaat_ln (AllocDomain)        := log(log(log(log(resultaat + 1f) + 1f) + 1f) +1f), Descr = "De UAI wordt vier keer gelogaritmeerd om de uitschieters te dempen.";
		parameter<Float32> max                               := max(resultaat_ln), Descr = "De maximale waarde van de UAI in het studiegebied.";
		attribute<Float32> Resultaat_ln_scaled (AllocDomain) := Resultaat_ln / max, Descr = "De UAI wordt geschaald op een maximum van 1.";
		
		container Detailhandel      := T(Count/Detailhandel, potentiaal, distance_decay, NormeerLandelijk, /ModelParameters/Werken/UAIMaximum/Detailhandel), Descr = "De potentiaal van detailhandel op basis van een bepaalde potentiaal en afstandsvervalfunctie.";
		container BijeenkomstLogies := T(Count/BijeenkomstLogies, potentiaal, distance_decay, NormeerLandelijk, /ModelParameters/Werken/UAIMaximum/BijeenkomstLogies), Descr = "De potentiaal van bijeenkomst- en logiesobjecten op basis van een bepaalde potentiaal en afstandsvervalfunctie.";
		container Monumentaal       := T(Count/Monumentaal, potentiaal, distance_decay, NormeerLandelijk, /ModelParameters/Werken/UAIMaximum/Monumentaal), Descr = "De potentiaal van monumentale panden op basis van een bepaalde potentiaal en afstandsvervalfunctie.";
		
		container Count
		{
			attribute<Float32> Detailhandel      (AllocDomain) := ='SourceData/Vastgoed/BAG/PerJaar/Y'+string(BAG_jaar)+'/vbo/Per_Gebruiksdoel/winkel/select/counts/Per_AllocDomain[float32]', Descr = "Aantal detailhandelsobjecten per allocdomain.";
			attribute<Float32> BijeenkomstLogies (AllocDomain) := ='SourceData/Vastgoed/BAG/PerJaar/Y'+string(BAG_jaar)+'/vbo/Per_Gebruiksdoel/bijeenkomst/select/counts/Per_AllocDomain[float32] + SourceData/Vastgoed/BAG/PerJaar/Y'+string(BAG_jaar)+'/vbo/Per_Gebruiksdoel/logies/select/counts/Per_AllocDomain[float32]', Descr = "Aantal bijeenkomst- en logiesobjecten per allocdomain.";
			attribute<Float32> Monumentaal       (AllocDomain) := ='MakeDefined(SourceData/Vastgoed/BAG/PerJaar/Y'+string(BAG_jaar)+'/pand/met_vbo/Counts/Monumentaal_Per_AllocDomain[float32], 0f)', Descr = "Aantal monumentale panden per allocdomain.";
		}
		
		Template T
		: Descr = "Template voor het berekenen van de potentiaal op basis van een bepaalde potentiaal en afstandsvervalfunctie"
		{
			attribute<Float32> Count (AllocDomain);
			parameter<UInt32>  potentiaal;
			parameter<String>  distance_decay;
			parameter<Bool>    NormeerLandelijk;
			parameter<Float32> Max_Landelijk;
			//

			attribute<Float32> Potential (AllocDomain) := ='potential(Count, Distmatrices_100m/pot'+string(potentiaal)+'m/'+distance_decay+')', Descr = "Berekening van de potentiaal op basis van de afstandsvervalfunctie.";
			parameter<Float32> Max_Studiegebied        := max(Potential), Descr = "De maximale waarde van de potentiaal in het studiegebied.";
			parameter<Float32> Max                     := NormeerLandelijk ? Max_Landelijk : Max_Studiegebied
			, IntegrityCheck = "!NormeerLandelijk || (/ModelParameters/Werken/UAIMaximum/BAG_Jaar == /ModelParameters/BAG_RecentYear && (/ModelParameters/StudyArea != 'Nederland' || abs(Max_Studiegebied / Max_Landelijk - 1f) < 1e-4f))"
			, Descr = "Het maximum waarop de potentiaal normeert: het landelijke maximum uit ModelParameters/Werken/UAIMaximum of dat van het studiegebied (#888). De controle eist dat de landelijke maxima bij BAG_RecentYear horen en in een landelijke run gelijk zijn aan Max_Studiegebied, zodat een nieuwe BAG-stand niet op verouderde maxima normeert.";
			attribute<Float32> Max_regio (AllocDomain) := max(Potential, SourceData/RegioIndelingen/CBS/Gekozen/Gemeente/Per_AllocDomain)[SourceData/RegioIndelingen/CBS/Gekozen/Gemeente/Per_AllocDomain], Descr = "De maximale waarde van de potentiaal per gemeente.";
			attribute<Float32> norm      (AllocDomain) := (Potential / Max) / 3f, Descr = "De genormaliseerde potentiaal, gedeeld door 3 om de drie componenten van de UAI gelijk te wegen.";
		}
	}
}