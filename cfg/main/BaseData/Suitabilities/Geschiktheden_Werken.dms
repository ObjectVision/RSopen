////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepalen van de geschiktheid van locaties voor verschillende werksectoren op basis van een logit model. Bepalen
// van de geschiktheidskaart per werksector op basis van een logit model. Bepaal per cel de sector met de hoogste
// geschiktheid.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Werken : using = "SourceData/Actoren/Banen;Classifications/Grondgebruik;Classifications/Actor"
, Descr = "Bepalen van de geschiktheid van locaties voor verschillende werksectoren op basis van een logit model."
{
	container ProbabilityMap_perSector := for_each_ne(TXLJobs6/name, 'MakeProbabilityMapT('+quote(TXLJobs6/name)+')'), Descr = "Bepalen van de geschiktheidskaart per werksector op basis van een logit model.";
	
	container MaxElemKaart
	{
		attribute<TXLJobs6> ArgMax (AdminDomain) := ='ArgMax('+asItemList('ProbabilityMap_perSector/'+TXLJobs6/name+'/exponentiated')+')[TXLJobs6]', Descr = "Bepaal per cel de sector met de hoogste geschiktheid.";
		attribute<TXLJobs6> SndBest(AdminDomain) := ='ArgMax('+asItemList('ArgMax = TXLJobs6/V/'+TXLJobs6/name+'? -9999f: ProbabilityMap_perSector/'+TXLJobs6/name+'/exponentiated')+')[TXLJobs6]', Descr = "Bepaal per cel de sector met de op één na hoogste geschiktheid.";
	}
	
	container ReadCoefficients := for_each_ne(TXLJobs6/name, 'ReadCoefficientsT('+quote(TXLJobs6/name)+',ModelParameters/Werken_coeff_date,'''')');

	Template MakeProbabilityMapT
	: Descr = "Template voor het maken van een geschiktheidskaart per werksector op basis van een logit model."
	{
		parameter<String> Sectorname;
		
		attribute<Float32> Calc_raw (AdminDomain):= = 'MakeDefined(
			ReadCoefficients/'+Sectorname+'/Result/Constant
			+ log(Diversen/Per_AdminDomain/DistTo_CargoAir / 1[km])                    * ReadCoefficients/'+Sectorname+'/Result/lndistto_cargoair_km 
			+ log(Diversen/Per_AdminDomain/DistTo_Highway_acces_exit_2018 / 1[km])     * ReadCoefficients/'+Sectorname+'/Result/lndist_highway_km_2018 
			+ log(Diversen/Per_AdminDomain/DistTo_Zeehavens_2019 / 1[km])              * ReadCoefficients/'+Sectorname+'/Result/lndist_seaport_km_2019 
			+ log(Diversen/Per_AdminDomain/DistTo_Trainstation_2019 / 1[km])           * ReadCoefficients/'+Sectorname+'/Result/lndist_train_km_2019 
			+ log(Diversen/Per_AdminDomain/tt_100kinhab_min / 1[min])                  * ReadCoefficients/'+Sectorname+'/Result/ln_tt_100kinhab_min_2017 
			+ log(Diversen/Per_AdminDomain/Hedonic_landPrice_2007 / 1[Eur_m2])         * ReadCoefficients/'+Sectorname+'/Result/lnlandPrice 
			+ log(Diversen/Per_AdminDomain/DistTo_Urban_Contour_2000 / 1[km])          * ReadCoefficients/'+Sectorname+'/Result/lndist_urbancontour_km_2000 
			
			+ Diversen/Per_AdminDomain/UAI_dynamisch                                   * ReadCoefficients/'+Sectorname+'/Result/UAI_2018 //actuele UAI met de 2018-coefficient, conform de wonen-suitability (UAI_dynamisch x UAI_2021-coefficient) (#599)
			+ Diversen/Per_AdminDomain/lu_share_unavailable                            * ReadCoefficients/'+Sectorname+'/Result/lu_share_unavailable_2012
			+ Diversen/Per_AdminDomain/lu_share_construction                           * ReadCoefficients/'+Sectorname+'/Result/lu_share_construction_2012
			+ Diversen/Per_AdminDomain/lu_share_nature                                 * ReadCoefficients/'+Sectorname+'/Result/lu_share_nature_2012
			+ Diversen/Per_AdminDomain/lu_share_residential                            * ReadCoefficients/'+Sectorname+'/Result/lu_share_residential_2012
			+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_otherbuiltup         * ReadCoefficients/'+Sectorname+'/Result/avgshr_LU12_ngh_1000r_otherbu
			,-1e9f
		)', Descr = "Nutsfunctie per cel. Cellen met ontbrekende data krijgen -1e9, zodat exp(raw) daar 0 is en de cel kans 0 krijgt; met de oude vulling 0f kreeg nodata exp(0)=1, een substantiele middenkans (#599).";
		
		parameter<String> FileName_raw := '%LocalDataProjDir%/BaseData/Suitabilities/Werken_raw_'+Sectorname+'_coeff'+/ModelParameters/Werken_coeff_date+'_bag'+string(/ModelParameters/BAG_RecentYear)+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";
		
		parameter<String> Fingerprint_raw :=
			  'sector='                 + Sectorname
			+ ';coeff_date='            + /ModelParameters/Werken_coeff_date
			+ ';bag_recent_year='       + string(/ModelParameters/BAG_RecentYear)
			+ ';bag_date='              + /ModelParameters/BAG_file_date
			+ ';bbg_year='              + /ModelParameters/BBG_Year
			+ ';uai=dynamic_R5000m_AbsWeight'
			+ ';tt_100k_year=2024'
			+ ';dist_highway_year=2018'
			+ ';dist_seaport_year=2019'
			+ ';dist_train_year=2019'
			+ ';dist_urban_contour_year=2000'
			+ ';dist_cargoair_file=DistCargoAir.tif'
			+ ';land_price_year=2007'
			+ ';nodata_fill=-1e9'
			+ ';admin_grid='            + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='             + string(AdminDomain/gridsize)
			+ ';study_area='            + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. coeff_date kiest de csv logitcoeff_mlogit_devType, sector kiest daaruit de rijen. bag_recent_year en bag_date voeden de dynamische UAI, die per BAG-jaarset winkels, bijeenkomst plus logies en monumentale panden telt (uai.dms). bbg_year kiest de landgebruiksaandelen en het buurtaandeel overig bebouwd. De sleutels met een vast jaartal zijn de vintages die hard in de paden van de regressor-tifs zitten (Impl.dms en Reistijden.dms): tt_100k_year staat op 2024 omdat tt_100kinhab_min uit de 2024-reistijdenkaart komt, en de cargoair-tif heeft geen vintage in de naam en staat daarom als bestandsnaam. uai benoemt de constructie van de dynamische UAI (potentiaal 5000 m, AbsWeight-verval); een wijziging in uai.dms verandert geen enkele parameter, werk dan deze sleutel met de hand bij. nodata_fill is de vulwaarde voor cellen met ontbrekende data (#599). study_area bepaalt de celselectie en via het maximum ook de normalisatie van de UAI. admin_grid en grid_size vangen dat een andere resolutie een ander bestand onder dezelfde naam oplevert.";
		
		container Decoupling_raw := /Templates/DecoupledFile_T(FileName_raw, Fingerprint_raw);
		
		attribute<Float32> Make_raw (AdminDomain) := Calc_raw, StorageName = "=FileName_raw", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling_raw/Write_Fingerprint", Descr = "Schrijft de statische raw-geschiktheid van deze sector als tif weg. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<Float32> Read_raw (AdminDomain) : StorageName = "=FileName_raw", StorageType = "gdal.grid", StorageReadOnly = "TRUE", Descr = "Leest de weggeschreven raw-kaart terug. Waardetype en domein staan expliciet en zijn gelijk aan Calc_raw.";
		
		attribute<Float32> raw (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld ? 'Calc_raw'
			:	Decoupling_raw/MayReuse              ? 'Read_raw'
			:	                                       'Make_raw'
		, Descr = "Wat de rest van het model gebruikt, in drie standen. Niet ontkoppeld rekent door zonder tussenbestand. Ontkoppeld met een geldige fingerprint leest de tif. Ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. De lezers elders (noemer, exponentiated, raw_ordinaal en de dynamische werken-geschiktheid in Zichtjaar_T) verwijzen naar dit item en hoeven dus niet aangepast te worden. Vraag Decoupling_raw/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		
		attribute<Float32> noemer        (AdminDomain):= ='1f + '+asList('exp(ProbabilityMap_perSector/'+TXLJobs6/name+'/raw)',' + '), Descr = "Berekening van de noemer voor de geschiktheid op basis van de raw scores van alle sectoren.";
		attribute<Float32> exponentiated (AdminDomain):= exp(raw) / noemer, Descr = "Berekening van de exponentiated score voor geschiktheid op basis van de raw score en de noemer.";
		attribute<Float32> raw_ordinaal  (AdminDomain):= raw <= -1e8f ? null_f : raw, Descr = "Raw-nut voor ordinaal gebruik in de allocatie (ModelParameters/Werken/GeschiktheidAlsRaw): nodata (-1e9) wordt null zodat die cellen nooit in de kandidaatset komen (#599). De MNL-kansdeling (exponentiated) blijft in gebruik voor de keuze tussen subsectoren en voor presentatie.";
	}
	
	Template ReadCoefficientsT
	: Descr = "Template voor het inlezen van de logit coëfficiënten per werksector."
	{
		parameter<String> Sectorname;
		parameter<String> Datum;
		parameter<String> Variantname;
		
		unit<UInt32> domain
		:  StorageName = "='%RSo_DataDir%/Vastgoed/logitcoeff_mlogit_devType_'+Datum+'.csv'"
		,  StorageType = "gdal.vect"
		,  StorageReadOnly = "True" 
		{
			//NB: de provincie-fixed-effects (.prov-rijen) uit de schatting worden bewust NIET in de raw-formule gebruikt: FE's zouden harde grenseffecten tussen provincies in de geschiktheidskaart geven (#599).
			//NB: ook de vijf beleidsdummy's uit de schatting (vinex, natura2000, bundelingsgebieden, bufferzones_2005, ehs_1990) staan niet in de raw-formule: ruimtelijke restricties legt RSopen op via de zeef en de restrictiekaarten, en het beleid uit de schattingsperiode (VINEX, bufferzones 2005, EHS 1990) is geen toekomstbeleid. Keerzijde: waar de zeef die gebieden niet uitsluit, mist de kaart de geschatte negatieve druk. Zie de wiki-pagina Geschiktheid voor de volledige afweging.
			attribute<Bool>   IsFE := lowercase(substr(parm, strlen(parm) - 5, strlen(parm))) == lowercase('.prov'), Descr = "Controleren of het een fixed effect betreft (provincie) of een continue variabele.";
			attribute<String> parm1 := IsFE ? 'p'+parm : parm, Descr = "Indien het een fixed effect betreft, moet er een 'p' voor de variabele naam gezet worden.";
			attribute<String> name := replace(parm1, 'construction', 'buildingsite', '_cons', 'Constant', 'buildingsite', 'construction', 'o.', '', ' ', '_','-','','.',''), Descr = "Hernoemen van de variabelen naar een standaard naamgeving.";
		}
		
		unit<UInt32> sector_subset := select_with_org_rel(LowerCase(domain/eq) == LowerCase(Sectorname))
		{
			attribute<String>  name     := domain/name[org_rel];
			attribute<Float32> estimate := domain/estimate[org_rel][float32];
			attribute<Float32> p        := domain/p[org_rel][float32];
		}
		
		container Result := 
			for_each_nedv(
				sector_subset/name
				,'rjoin(rlookup('+quote(lowercase(sector_subset/name))+', lowercase(sector_subset/name)), id(sector_subset), sector_subset/estimate)[float32]'
				, void
				, float32
			), Descr = "Inlezen van de coëfficiënten voor de logit model per werksector op basis van de naam van de variabele.";
	}
}