////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepalen van de geschiktheid van locaties voor verschillende werksectoren op basis van een logit model. Bepalen
// van de geschiktheidskaart per werksector op basis van een logit model. Bepaal per cel de sector met de hoogste
// geschiktheid.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Werken : using = "SourceData/Actoren/Banen;Classifications/Grondgebruik;Classifications/Actor"
, Descr = "Bepalen van de geschiktheid van locaties voor verschillende werksectoren op basis van een logit model."
{
	container ProbabilityMap_perSector := for_each_ne(TXLJobs6/name, 'MakeProbabilityMapT('+quote(TXLJobs6/name)+')'), Descr = "Bepalen van de geschiktheidskaart per werksector op basis van een logit model.";
	
	container MaxElemKaart
	{
		attribute<TXLJobs6> ArgMax (AdminDomain) := ='ArgMax('+asItemList('ProbabilityMap_perSector/'+TXLJobs6/name+'/exponentiated')+')[TXLJobs6]', Descr = "Bepaal per cel de sector met de hoogste geschiktheid.";
		attribute<TXLJobs6> SndBest(AdminDomain) := ='ArgMax('+asItemList('ArgMax = TXLJobs6/V/'+TXLJobs6/name+'? -9999f: ProbabilityMap_perSector/'+TXLJobs6/name+'/exponentiated')+')[TXLJobs6]', Descr = "Bepaal per cel de sector met de op één na hoogste geschiktheid.";
	}
	
	container ReadCoefficients := for_each_ne(TXLJobs6/name, 'ReadCoefficientsT('+quote(TXLJobs6/name)+',ModelParameters/Werken_coeff_date,'''')');

	attribute<Classifications/Grondgebruik/IBIS> IbisType        (AdminDomain) := /BaseData/Grondgebruik/IBIS/Result/Type_Per_AdminDomain, Descr = "Het type werklocatie in IBIS van ModelParameters/IBIS_Year, null buiten IBIS.";
	attribute<Bool>                              IsOpZeehaven    (AdminDomain) := /SourceData/Grondgebruik/IBIS/Y2022/Zeehavens/Per_AdminDomain, Descr = "De cel ligt in het vaste zeehavengebied (SourceData/Grondgebruik/IBIS/Y2022/Zeehavens), hetzelfde gebied als in de schatting (#708).";
	attribute<Float32> OpIbisZeehaven (AdminDomain) := float32(IsOpZeehaven), Descr = "1 als de cel in het vaste zeehavengebied ligt (IsOpZeehaven), en anders 0: de term op_ibis_zeehaven van de geschiktheid (#708).";
	attribute<Float32> OpIbisOverig   (AdminDomain) := float32(IsDefined(IbisType) && !IsOpZeehaven)
	, Descr = "1 als de cel op een IBIS-werklocatie van IBIS_Year ligt buiten het vaste zeehavengebied, ook een van onbekend type, en anders 0: de term op_ibis_overig (#708). IBIS blijft in alle zichtjaren de stand van IBIS_Year; nieuw werken buiten IBIS telt via het buurtaandeel overig bebouwd in Zichtjaar_T.";

	#include<HerschattingLogit_Werken.dms>

	Template MakeProbabilityMapT
	: Descr = "Template voor het maken van een geschiktheidskaart per werksector op basis van een logit model."
	{
		parameter<String> Sectorname;
		
		attribute<Float32> Calc_raw (AdminDomain):= = 'MakeDefined(
			ReadCoefficients/'+Sectorname+'/Result/Constant
			+ log(Diversen/Per_AdminDomain/DistTo_CargoAir / 1[km])                    * ReadCoefficients/'+Sectorname+'/Result/ln_dist_cargoair
			+ log(Diversen/Per_AdminDomain/DistTo_Highway_acces_exit_2018 / 1[km])     * ReadCoefficients/'+Sectorname+'/Result/ln_dist_highway
			+ log(Diversen/Per_AdminDomain/DistTo_Zeehavens_2019 / 1[km])              * ReadCoefficients/'+Sectorname+'/Result/ln_dist_seaport
			+ log(Diversen/Per_AdminDomain/tt_OVknooppunten_min / 1[min])              * ReadCoefficients/'+Sectorname+'/Result/ln_tt_ov
			+ log(Diversen/Per_AdminDomain/tt_500kinhab_min / 1[min])                  * ReadCoefficients/'+Sectorname+'/Result/ln_tt_500k
			+ log(Diversen/Per_AdminDomain/Hedonic_landPrice_2007 / 1[Eur_m2])         * ReadCoefficients/'+Sectorname+'/Result/ln_landprice
			+ log(Diversen/Per_AdminDomain/DistTo_Urban_Contour_2000 / 1[km])          * ReadCoefficients/'+Sectorname+'/Result/ln_dist_urbancontour
			+ log(Diversen/Per_AdminDomain/UAI_dynamisch + /ModelParameters/Werken_UAIVerschuiving) * ReadCoefficients/'+Sectorname+'/Result/ln_uai
			+ Diversen/Per_AdminDomain/lu_share_unavailable                            * ReadCoefficients/'+Sectorname+'/Result/lu_share_unavailable
			+ Diversen/Per_AdminDomain/lu_share_construction                           * ReadCoefficients/'+Sectorname+'/Result/lu_share_construction
			+ Diversen/Per_AdminDomain/lu_share_nature                                 * ReadCoefficients/'+Sectorname+'/Result/lu_share_nature
			+ Diversen/Per_AdminDomain/lu_share_residential                            * ReadCoefficients/'+Sectorname+'/Result/lu_share_residential
			+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_otherbuiltup         * ReadCoefficients/'+Sectorname+'/Result/avgshr_otherbuiltup_1000m
			+ OpIbisZeehaven                                                           * ReadCoefficients/'+Sectorname+'/Result/op_ibis_zeehaven
			+ OpIbisOverig                                                             * ReadCoefficients/'+Sectorname+'/Result/op_ibis_overig
			,-1e9f
		)', Descr = "Nutsfunctie per cel, met de termen van Herschatting/Var. Cellen met ontbrekende data krijgen -1e9, zodat exp(raw) daar 0 is en de cel kans 0 krijgt (#599).";
		
		parameter<String> FileName_raw := '%LocalDataProjDir%/BaseData/Suitabilities/Werken_raw_'+Sectorname+'_coeff'+/ModelParameters/Werken_coeff_date+'_bag'+string(/ModelParameters/BAG_RecentYear)+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";
		
		parameter<String> Fingerprint_raw :=
			  'sector='                 + Sectorname
			+ ';coeff_date='            + /ModelParameters/Werken_coeff_date
			+ ';bag_recent_year='       + string(/ModelParameters/BAG_RecentYear)
			+ ';bag_date='              + /ModelParameters/BAG_file_date
			+ ';bbg_year='              + /ModelParameters/BBG_Year
			+ ';uai=ln_dynamic_R5000m_AbsWeight'
			+ ';uai_shift='             + string(/ModelParameters/Werken_UAIVerschuiving)
			+ ';ibis_year='             + /ModelParameters/IBIS_Year
			+ ';ibis_zeehaven=Y2022_vast_kade'
			+ ';ibis_terms=zeehaven_overig'
			+ ';tt_ov_year=2026'
			+ ';tt_500k_year=2024'
			+ ';dist_highway_year=2018'
			+ ';dist_seaport_year=2019'
			+ ';dist_urban_contour_year=2000'
			+ ';dist_cargoair_file=DistCargoAir.tif'
			+ ';land_price_year=2007'
			+ ';nodata_fill=-1e9'
			+ ';admin_grid='            + /ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='             + string(AdminDomain/gridsize)
			+ ';study_area='            + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. coeff_date kiest de csv logitcoeff_mlogit_devType en sector de rijen daaruit; bag_recent_year
			en bag_date voeden de dynamische UAI; bbg_year kiest de landgebruiksaandelen en het buurtaandeel overig bebouwd; ibis_year kiest de IBIS-jaargang van de term op_ibis_overig en ibis_zeehaven benoemt het vaste zeehavengebied in IBIS.dms; de sleutels met een
			vast jaartal zijn de vintages die hard in de paden van de regressor-tifs zitten (Impl.dms en Reistijden.dms), en de cargoair-tif staat als bestandsnaam omdat hij geen vintage in de naam heeft;
			uai en ibis_terms benoemen hoe de UAI en IBIS in de formule staan, en een wijziging in uai.dms of in de indeling van IBIS verandert geen parameter, dus werk die sleutels dan met de hand bij;
			nodata_fill is de vulwaarde voor cellen met ontbrekende data (#599); study_area bepaalt de celselectie en via het maximum de normalisatie van de UAI; admin_grid en grid_size vangen een andere
			resolutie onder dezelfde naam.";
		
		container Decoupling_raw := /Templates/DecoupledFile_T(FileName_raw, Fingerprint_raw, 'Write_raw');
		
		attribute<Float32> Write_raw (AdminDomain) := Calc_raw, StorageName = "=Decoupling_raw/StorageFile", StorageType = "gdalwrite.grid", Descr = "Schrijft de statische raw-geschiktheid van deze sector als tif weg, zonder zijbestand; dat volgt via Make_raw.";
		attribute<Float32> Make_raw (AdminDomain) := Write_raw, ExplicitSuppliers = "Decoupling_raw/Write_Fingerprint"
		, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_raw, want alleen langs deze weg ontstaat de fingerprint (#837).";
		attribute<Float32> Read_raw (AdminDomain) : StorageName = "=Decoupling_raw/StorageFile", StorageType = "gdal.grid", StorageReadOnly = "TRUE", Descr = "Leest de weggeschreven raw-kaart terug. Waardetype en domein staan expliciet en zijn gelijk aan Calc_raw.";
		
		attribute<Float32> raw (AdminDomain) :=
			=	!/ModelParameters/BaseDataOntkoppeld ? 'Calc_raw'
			:	Decoupling_raw/MayReuse              ? 'Read_raw'
			:	                                       'Make_raw'
		, Descr = "Wat de rest van het model gebruikt, in drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige
			fingerprint rekent en schrijft in een keer, inclusief het zijbestand. De lezers elders (noemer, exponentiated, raw_ordinaal en de dynamische werken-geschiktheid in Zichtjaar_T) verwijzen
			naar dit item; Decoupling_raw/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";
		
		attribute<Float32> noemer        (AdminDomain):= ='1f + '+asList('exp(ProbabilityMap_perSector/'+TXLJobs6/name+'/raw)',' + '), Descr = "Berekening van de noemer voor de geschiktheid op basis van de raw scores van alle sectoren.";
		attribute<Float32> exponentiated (AdminDomain):= exp(raw) / noemer, Descr = "Berekening van de exponentiated score voor geschiktheid op basis van de raw score en de noemer.";
		attribute<Float32> raw_ordinaal  (AdminDomain):= raw <= -1e8f ? null_f : raw, Descr = "Raw-nut voor ordinaal gebruik in de allocatie: nodata (-1e9) wordt null zodat die cellen nooit in de kandidaatset komen (#599). De MNL-kansdeling (exponentiated) blijft in gebruik voor de keuze tussen subsectoren en voor presentatie.";
	}
	
	Template ReadCoefficientsT
	: Descr = "Template voor het inlezen van de logit coëfficiënten per werksector."
	{
		parameter<String> Sectorname;
		parameter<String> Datum;
		parameter<String> Variantname;
		
		unit<UInt32> domain
		:  StorageName = "=(Datum == '20261116' ? '%LocalDataProjDir%' : '%RSo_DataDir%')+'/Vastgoed/logitcoeff_mlogit_devType_'+Datum+'.csv'" // TIJDELIJK voor de proefrun van #708: terug naar alleen %RSo_DataDir% zodra de csv in SourceData staat
		,  StorageType = "gdal.vect"
		,  StorageReadOnly = "True" 
		{
			//NB: de provincie-fixed-effects (.prov-rijen) uit de schatting worden bewust NIET in de raw-formule gebruikt: FE's zouden harde grenseffecten tussen provincies in de geschiktheidskaart geven (#599).
			//NB: ook de vijf beleidsdummy's uit de schatting (vinex, natura2000, bundelingsgebieden, bufferzones_2005, ehs_1990) staan niet in de raw-formule: ruimtelijke restricties legt RSopen op via de zeef en de restrictiekaarten, en het beleid uit de schattingsperiode (VINEX, bufferzones 2005, EHS 1990) is geen toekomstbeleid. Keerzijde: waar de zeef die gebieden niet uitsluit, mist de kaart de geschatte negatieve druk. Zie de wiki-pagina Geschiktheid voor de volledige afweging.
			attribute<Bool>   IsFE := lowercase(substr(parm, strlen(parm) - 5, strlen(parm))) == lowercase('.prov'), Descr = "Controleren of het een fixed effect betreft (provincie) of een continue variabele.";
			attribute<String> parm1 := IsFE ? 'p'+parm : parm, Descr = "Indien het een fixed effect betreft, moet er een 'p' voor de variabele naam gezet worden.";
			attribute<String> name := replace(parm1, 'construction', 'buildingsite', '_cons', 'Constant', 'buildingsite', 'construction', 'o.', '', ' ', '_','-','','.',''), Descr = "Hernoemen van de variabelen naar een standaard naamgeving.";
		}
		
		unit<UInt32> sector_subset := select_with_org_rel(LowerCase(domain/eq) == LowerCase(Sectorname))
		{
			attribute<String>  name     := domain/name[org_rel];
			attribute<Float32> estimate := domain/estimate[org_rel][float32];
			attribute<Float32> p        := domain/p[org_rel][float32];
		}
		
		container Result := 
			for_each_nedv(
				sector_subset/name
				,'rjoin(rlookup('+quote(lowercase(sector_subset/name))+', lowercase(sector_subset/name)), id(sector_subset), sector_subset/estimate)[float32]'
				, void
				, float32
			), Descr = "Inlezen van de coëfficiënten voor de logit model per werksector op basis van de naam van de variabele.";
	}
}