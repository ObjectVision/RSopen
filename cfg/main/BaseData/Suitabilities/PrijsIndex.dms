// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Inlezen van de prijsindex voor verschillende woningtypen. inlezen van coefficienten uit prijsindex. Template
// voor het inlezen van de prijsindex voor een bepaald woningtype.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container PrijsIndex
: Descr = "Inlezen van de prijsindex voor verschillende woningtypen."
{
	parameter<String> Schattingen_StareaRef := 'NL';
	
	// container ReadCoefficients_WP2 := 
		// for_each_ne(
			// Vastgoed/WP2/name
			// , 'T('+string(id(Vastgoed/WP2))+'[Vastgoed/WP2],''WP2'','''','+quote(ModelParameters/NVM_filedate)+')'
		// );
		
	container ReadCoefficients_WP4 := 
		for_each_ne(
			Classifications/Vastgoed/WP4/name
			, 'T('+string(id(Classifications/Vastgoed/WP4))+'[Classifications/Vastgoed/WP4],''WP4'','''','+quote(ModelParameters/NVM_filedate)+')'
		), Descr = "inlezen van coefficienten uit prijsindex.", URL = "https://github.com/jipclaassens/PriceIndices";
	
	Template T
	: Descr = "Template voor het inlezen van de prijsindex voor een bepaald woningtype."
	{
		//
		parameter<Types_dom> id;
		parameter<String> Types_dom_str; 
		parameter<String> Schattingen_StareaRef0;
		parameter<String> Datum;
		//
		parameter<String> Schattingen_StareaRef := Schattingen_StareaRef0 == '' ? Schattingen_StareaRef0 : '_'+Schattingen_StareaRef0;
		unit<UInt8>       Types_dom := ='Classifications/Vastgoed/'+Types_dom_str;
		parameter<String> WP_name   := =lowercase(Types_dom_str) == lowercase('WP4') ? 'Types_dom/name_english[id]' : 'Types_dom/name[id]';
		
		unit<UInt32> AdminDomain
		:  StorageName = "= '%RSo_DataDir%/Vastgoed/Estimates_'+Datum+'_'+WP_name+'.csv'"
		,  StorageType = "gdal.vect"
		,  StorageReadOnly = "True"
		{
			attribute<String> term;  // R-pipeline (PriceIndices) schrijft de coefficientnaam in kolom 'term'

			// De R-export gebruikt al schone namen; hier alleen de bouwperiode- en
			// transactiejaar-dummies naar de RS-interne namen (d_constr*, y*) mappen.
			// Overige termen (lnsize, uai_2012, lntt_ovknoop, lntt_500k_2024, constant, ...)
			// matchen 1-op-1 met HouseCharacteristics_src.
			attribute<String> name := replace(lowercase(term),
										'trans_year_2000', 'y2000'
										,'trans_year_2001', 'y2001'
										,'trans_year_2002', 'y2002'
										,'trans_year_2003', 'y2003'
										,'trans_year_2004', 'y2004'
										,'trans_year_2005', 'y2005'
										,'trans_year_2006', 'y2006'
										,'trans_year_2007', 'y2007'
										,'trans_year_2008', 'y2008'
										,'trans_year_2009', 'y2009'
										,'trans_year_2010', 'y2010'
										,'trans_year_2011', 'y2011'
										,'trans_year_2012', 'y2012'
										,'trans_year_2013', 'y2013'
										,'trans_year_2014', 'y2014'
										,'trans_year_2015', 'y2015'
										,'trans_year_2016', 'y2016'
										,'trans_year_2017', 'y2017'
										,'trans_year_2018', 'y2018'
										,'trans_year_2019', 'y2019'
										,'trans_year_2020', 'y2020'
										,'trans_year_2021', 'y2021'
										,'trans_year_2022', 'y2022'
										,'trans_year_2023', 'y2023'
										,'bouwperiode_tm1925',    'd_constrlt1926'
										,'bouwperiode_1926_1950', 'd_constr19261950'
										,'bouwperiode_1951_1965', 'd_constr19511965'
										,'bouwperiode_1966_1973', 'd_constr19661973'
										,'bouwperiode_1974_1981', 'd_constr19741981'
										,'bouwperiode_1982_1991', 'd_constr19821991'
										,'bouwperiode_1992_2001', 'd_constr19922001'
										,'bouwperiode_va2002',    'd_constrgt2001'
										), Descr = "Bouwperiode-/jaardummies naar RS-interne namen; overige termen 1-op-1.";
		}
	
		container Result := 
			for_each_nedv(
				Classifications/Vastgoed/HouseCharacteristics_src/name
				, 'rjoin(rlookup('+quote(lowercase(Classifications/Vastgoed/HouseCharacteristics_src/name))+', lowercase(AdminDomain/name)), id(AdminDomain), AdminDomain/estimate)[float32]'
				, void
				, float32
			), Descr = "Inlezen van de coëfficiënten voor de prijsindex op basis van de naam van de variabele.";
	}
}