//
// De verwervingskosten van corporatiewoningen tegen hun beleidswaarde (#861)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Corporatiebezit
: Descr = "De korting op de verwervingskosten van woningen voor het corporatiebezit (#861): de sociale huurwoningen van de cel kosten hun beleidswaarde uit ModelParameters/Wonen/Corporatie in
			plaats van hun hedonische waarde, hoogstens die waarde. Het aantal sociale huurwoningen komt uit de basisjaarstand; hun hedonische waarde is hun aandeel in de woningen van de cel maal
			de hedonische waarde van alle woningen van de cel. Opstalkosten trekt de korting af van de verwervingskosten."
{
	attribute<Woning> SocialeHuur (AdminDomain) := /BaseData/StartState/StateBasisjaar/Read/Wonen/eengezins_SocialeHuur + /BaseData/StartState/StateBasisjaar/Read/Wonen/meergezins_SocialeHuur;
	attribute<Woning> Totaal      (AdminDomain) := /BaseData/StartState/StateBasisjaar/Read/Wonen/Aantal_Woningen_Totaal;
	attribute<Eur>    Markt       (AdminDomain) := Totaal > 0[Woning] ? MakeDefined(Verwervingskosten/Woningen/Totaal, 0[Eur]) * float32(SocialeHuur / Totaal) : 0[Eur], Descr = "De hedonische waarde van de sociale huurwoningen van de cel.";
	attribute<Eur>    Beleid      (AdminDomain) := min_elem((float32(SocialeHuur) * float32(/ModelParameters/Wonen/Corporatie/BeleidswaardePerWoning))[Eur], Markt), Descr = "De beleidswaarde van de sociale huurwoningen van de cel, hoogstens hun hedonische waarde.";
	attribute<Eur>    Korting     (AdminDomain) := Markt - Beleid, Descr = "Wat de verwervingskosten van de cel lager uitvallen, nul zonder sociale huur.";
}
