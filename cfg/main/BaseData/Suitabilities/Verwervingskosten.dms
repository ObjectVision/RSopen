////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Schatting van de verwervingskosten voor woningen en niet-woningen op basis van een set van modelvarianten.
// Haal de woningwaarde per woningtype op Koppel de woningwaarde per woningtype aan de vbo's en zet om naar Eur
// per vbo
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Verwervingskosten
: Descr = "Schatting van de verwervingskosten voor woningen en niet-woningen op basis van een set van modelvarianten."
{
	container BAG               := SourceData/Vastgoed/BAG/PerJaar;
	container BAG_ModelJaar     := = 'BAG/Y'+string(ModelParameters/Model_StartYear);
	container BAG_RecentsteJaar := = 'BAG/Y'+string(ModelParameters/Model_StartYear);
	
	unit<UInt32> vbo_startjaar  := BAG_RecentsteJaar/VBO/per_Gebruiksdoel/woon/Select;
	unit<UInt32> pand_startjaar := BAG_RecentsteJaar/pand;
	
	parameter<String> Generate := 'Ready', ExplicitSuppliers = "Woningen/Write;Niet_Woningen/Write";
	
	container Woningen
	{
		container PerWP4PerWoning := 
			for_each_nedv(
				Classifications/Vastgoed/WP4/name
				,'Woningwaarde_perWoningType/'+Classifications/Vastgoed/WP4/name+'/Basisjaar'
				,AdminDomain
				, Eur_Woning
		), Descr = "Haal de woningwaarde per woningtype op";
		
		attribute<Eur> PerVBO (vbo_startjaar) :=
			= 'max_elem(
					merge(
						vbo_startjaar/WP4_rel[UInt16],
						Eur_Woning ,'+
						asItemList('PerWP4PerWoning/'+Classifications/Vastgoed/WP4/name+'[vbo_startjaar/AdminDomain_rel]')+
					'),
					0[Eur_Woning]
				) * 1[Woning]', Descr = "Koppel de woningwaarde per woningtype aan de vbo's en zet om naar Eur per vbo";
		
		attribute<Eur> Calc   (AdminDomain) := sum(PerVBO, vbo_startjaar/AdminDomain_rel), Descr = "Bereken de totale woningwaarde per admin domain";

		parameter<String> TifFile := '%LocalDataProjDir%/BaseData/Vastgoed/Verwervingskosten_Woningen_AdminDomain_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

		parameter<String> Fingerprint :=
			  'start_year='              + string(ModelParameters/Model_StartYear)
			+ ';bag_recent_year='        + string(ModelParameters/BAG_RecentYear)
			+ ';bag_date='               + ModelParameters/BAG_file_date
			+ ';nvm_date='               + ModelParameters/NVM_filedate
			+ ';nvm_coeff_year='         + ModelParameters/NVM_coeff_Year
			+ ';constr_period_in_price=' + string(ModelParameters/Wonen/BouwperiodeInVoorraadprijs)
			+ ';constr_period_count='    + string(#Classifications/Vastgoed/Bouwperiode)
			+ ';constr_period_breaks='   + asList(string(Classifications/Vastgoed/Bouwperiode/ClassBreaks), ',')
			+ ';wp4_classes='            + asList(Classifications/Vastgoed/WP4/name, ',')
			+ ';trunc_upper_woononly='   + string(ModelParameters/VBO_opp_truncation_BovengrenzenAlleenWoon)
			+ ';trunc_upper='            + string(ModelParameters/Wonen/VBO_opp_truncation_upper)
			+ ';trunc_lower='            + string(ModelParameters/Wonen/VBO_opp_truncation_lower)
			+ ';admin_grid='             + ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='              + string(AdminDomain/gridsize)
			+ ';study_area='             + ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. start_year is de vbo-set waarover gesommeerd wordt; bag_recent_year bepaalt met bag_date de
						voorraadkenmerken waarop de hedonische prijs per cel rust; nvm_date kiest de coefficienten en de regiokarakteristieken, nvm_coeff_year de jaardummy die het prijspeil zet; de
						bouwperiodeklassen van #675 staan als breaks-reeks, want een verschoven klassengrens verandert de bestandsnaam niet; de drie truncatieparameters (#700) bepalen de oppervlaktegrondslag;
						admin_grid vangt dat 25m tegenover 100m een ander bestand onder dezelfde naam oplevert.";

		container Decoupling := Templates/DecoupledFile_T(TifFile, Fingerprint);

		attribute<Eur> Write  (AdminDomain) := Calc, StorageName = "=TifFile", IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling/Write_Fingerprint", Descr = "If this IntegrityCheck fails, go back and investigate why the calc is already failing. Do not continue without fixing this! All following results will be invalid! Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan de container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<Eur> Read_UNCHECKED   (AdminDomain) : StorageName = "=TifFile", StorageReadOnly = "True", Descr = "This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the container following this one checks for this.", StorageType = "tif";
		attribute<Eur> Read   (AdminDomain) := Read_UNCHECKED, IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))", Descr = "If this IntegrityCheck fails, go back and investigate why the calc/write is already failing. Do not continue without fixing this! All following results will be invalid!";
		attribute<Eur> Totaal (AdminDomain) :=
			=	!ModelParameters/BaseDataOntkoppeld ? 'Calc'
			:	Decoupling/MayReuse                 ? 'Read'
			:	                                      'Write'
		, Descr = "Wat de rest van het model gebruikt, in drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. Decoupling/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";
	}
	
	container Niet_Woningen
	: Descr = "De verwervingskosten van het bestaande niet-woonvastgoed per cel: het niet-woon vloeroppervlak maal een verwervingsprijs per vierkante meter. Anders dan bij woningen is er voor niet-woningen geen hedonisch prijsmodel; de prijs komt uit de WOZ-brondata, met een landelijk kental als terugval. Zie #674 voor waar dit vandaan komt."
	{
		parameter<meter2>  OppMaxPerCel := (AdminDomain/NrMeter2PerCell[Float32] * ModelParameters/Wonen/Verwervingskosten/NietWoningen_MaxBouwlagenPerCel)[meter2]
		, Descr = "Het maximale niet-woonvloeroppervlak per cel: het celoppervlak maal het aantal bouwlagen uit ModelParameters/Wonen/Verwervingskosten/NietWoningen_MaxBouwlagenPerCel. Uit het celoppervlak en
						niet als vast getal, want op een grid van 100 meter hoort de grens zestien keer hoger te liggen. Begrenst opp_per_grid en Samenstelling/Voor1994 hieronder; de onderbouwing staat bij die
						parameter.";

		parameter<Eur_m2>  kental                            := ModelParameters/Wonen/Verwervingskosten/NietWoningen, Descr = "Het landelijke kental voor de verwervingsprijs per vierkante meter niet-woonvloeroppervlak, op het prijspeil van Model_StartYear.";

		attribute<Eur_m2>  WOZ_Woningen_per_m2 (AdminDomain) := SourceData/Vastgoed/WOZ/Y2017/Gegeven_BBG, Descr = "De WOZ-waarde per vierkante meter vloeroppervlak van woningen, uit de CBS-brondata met peildatum 1 januari 2016, per buurt teruggevallen op wijk en gemeente. De bodemgebruiksklasse van de
						cel kiest welke reeks geldt, maar die klasse zegt waar een woning staat en niet wat voor object het is: de brondata telt landelijk evenveel objecten als de woningvoorraad, en de reeks voor
						bedrijfsterreinen beweegt mee met de woningprijs ter plaatse, vandaar de omrekening hieronder. Twee scheefheden in de bron zijn niet rechtgezet: de prijs is per buurt mean plus sd, een
						bovenschatting, en woongebied krijgt geen groeifactor terwijl de andere drie klassen via Groeifactor_CommercieelVastgoed naar 2023 zijn gebracht. Het jaartal 2017 staat hard in het pad, want
						er is maar een WOZ-jaar in de brondata.";

		container Samenstelling
		: Descr = "Hoeveel van het niet-woonvloeroppervlak in een cel hal is, nodig om een distributiehal anders te beprijzen dan een winkel (#674). Dezelfde toedelingsmatrix en dezelfde unieke telling als opp_per_grid, maar uitgesplitst naar gebruiksdoel en per gebruiksdoel gewogen met het aandeel dat fysiek een hal is."
		{
			attribute<meter2>  Hal       (AdminDomain) := /ModelParameters/Werken/HalFractie/industrie * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/industrie[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ /ModelParameters/Werken/HalFractie/Logistiek * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/Logistiek[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ /ModelParameters/Werken/HalFractie/utiliteit_combi * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/utiliteit_combi[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ /ModelParameters/Werken/HalFractie/Kantoor * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/Kantoor[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ /ModelParameters/Werken/HalFractie/winkel * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/winkel[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ /ModelParameters/Werken/HalFractie/bijeenkomst * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/bijeenkomst[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ /ModelParameters/Werken/HalFractie/Gezondheidszorg * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/Gezondheidszorg[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ 0.306f * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/onderwijs[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ 0.290f * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/overige_gebruiks[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ 0.454f * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/sport[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ 0.043f * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/logies[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ 0.075f * sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/cel[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
			, Descr = "Het hal-oppervlak in de cel, als gewogen som over de gebruiksdoelen. De gewichten zijn per gebruiksdoel het aandeel van het vloeroppervlak in verblijfsobjecten die groter zijn dan 1.000 m2
						en waarvan het vloeroppervlak onder anderhalf maal de voetafdruk van hun pand blijft, dus groot en in feite eenlaags. Een aandeel per klasse en geen lijstje klassen, want het gebruiksdoel
						alleen is een slechte hal-indicator: industriefunctie is voor bijna de helft kleine bedrijfsruimte, terwijl veel sporthallen en bouwmarkten wel een hal zijn. De twee drempels zijn een keuze
						en geen bron.", Source = "BAG, jaarset Y2023";
			attribute<meter2>  Utiliteit (AdminDomain) := sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/industrie[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/Logistiek[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/utiliteit_combi[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/Kantoor[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/winkel[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/bijeenkomst[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/Gezondheidszorg[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/onderwijs[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/overige_gebruiks[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/sport[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/logies[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
																			+ sum(pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/cel[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
			, Descr = "Alle utiliteitsklassen samen. Wijkt af van opp_per_grid: die telt verblijfsobjecten in panden zonder woonfunctie, deze telt utiliteits-vbo's ook in gemengde panden. Alleen de verhouding tussen Hal en Utiliteit wordt gebruikt, dus dat verschil valt weg.";
			attribute<meter2>  Voor1994_bron (AdminDomain) := sum((pand_startjaar/Bouwjaar_trunc < ModelParameters/Wonen/Sloopkosten/AsbestBouwjaarGrens
																? pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/niet_woon
																: 0[meter2])[pand_startjaar/ToedelingsMatrix/Pand_rel] * pand_startjaar/ToedelingsMatrix/ToedelingPand, pand_startjaar/ToedelingsMatrix/AdminDomain_rel)
			, Descr = "Het niet-woon vloeroppervlak in de cel dat in een pand van voor het asbestverbod staat. Voedt de asbesttoeslag in de sloopkosten (#701). Landelijk is 53,1 procent van het niet-woonvloeroppervlak van voor 1994; 4,7 miljoen m2 heeft geen bouwjaar en telt hier niet mee, wat de toeslag eerder te laag dan te hoog maakt.";

			attribute<meter2>  Voor1994 (AdminDomain) := Voor1994_bron > ../OppMaxPerCel ? ../OppMaxPerCel : Voor1994_bron
			, Descr = "Voor1994_bron, begrensd op de fysieke bovengrens per cel. Deze term voedt de asbesttoeslag in de sloopkosten rechtstreeks en niet via een verhouding, dus hij hoort dezelfde grens te dragen
						als opp_per_grid; Hal en Utiliteit blijven ongegrensd omdat daarvan alleen de verhouding wordt gebruikt. Een toets en geen min_elem, zodat een ontbrekende waarde ontbrekend blijft.";

			attribute<Float32> Fractie_Hal (AdminDomain) := Utiliteit > 0[meter2]
													? Hal / Utiliteit
													: ModelParameters/Wonen/Verwervingskosten/NietWoningen_FractieHal_Default, Descr = "Het aandeel hal in het utiliteitsvloeroppervlak van de cel.";
		}

		attribute<Float32> WOZVerhouding       (AdminDomain) := Samenstelling/Fractie_Hal * ModelParameters/Wonen/Verwervingskosten/NietWoningen_WOZVerhouding_Hal
															+ (1f - Samenstelling/Fractie_Hal) * ModelParameters/Wonen/Verwervingskosten/NietWoningen_WOZVerhouding_Overig
		, Descr = "De verhouding tussen de niet-woonprijs en de woningprijs in deze cel, gewogen naar de samenstelling van het vloeroppervlak. Loopt van de hal-verhouding in een cel met alleen hallen tot de overige verhouding in een cel zonder hallen. Zie de Descr van ModelParameters/Wonen/Verwervingskosten voor waarom dit naar samenstelling gaat en niet met een enkel kental.";

		attribute<Eur_m2>  WOZ_per_m2          (AdminDomain) := WOZ_Woningen_per_m2 * WOZVerhouding, Descr = "De WOZ-waarde per vierkante meter voor niet-woningen: de woningprijs ter plaatse maal de naar samenstelling gewogen verhouding. Locatie en type zitten er dus allebei in, en ze zijn gescheiden: de verhoudingen zijn zo geijkt dat een cel met alleen hallen landelijk op circa 600 euro per m2 uitkomt en een cel zonder hallen op circa 1.400, ongeacht wat de woningprijs ter plaatse doet.";

		attribute<Eur_m2>  prijs_per_m2        (AdminDomain) := MakeDefined(WOZ_per_m2, kental), Descr = "De verwervingsprijs per vierkante meter. Het kental is de terugval voor de circa 34.000 cellen met niet-woonvastgoed waar de brondata geen WOZ-waarde geeft, 2,4 procent van de cellen met vastgoed.";

		attribute<meter2>  opp_per_grid_bron   (AdminDomain) := pand_startjaar/Oppervlaktes/VBOopp_perGebruiksdoel/niet_woon_AdminDomain, Descr = "Het niet-woon vloeroppervlak per cel, via de toedelingsmatrix die een pand over zijn cellen verdeelt, met elk verblijfsobject precies een keer geteld; hetzelfde oppervlak gaat in
						Sloopkosten/Totaal_niet_woningen, zodat hetzelfde gebouw voor verwerven en slopen op dezelfde maat staat. Niet via pand/Oppervlaktes/vbo_opp_niet_woon, dat een verblijfsobject bij elk
						gerelateerd pand meetelt en elk pand met enig niet-woonoppervlak tot zijn volle footprint optilt (#674).";

		attribute<Bool>    IsAfgekapt          (AdminDomain) := opp_per_grid_bron > OppMaxPerCel
		, Descr = "Cellen waar de bron boven de fysieke bovengrens uitkomt en dus wordt begrensd. Staat er als eigen item zodat de omvang van de ingreep te tellen is zonder de bron opnieuw te hoeven bouwen: som deze vlag voor het aantal cellen. Een ontbrekende waarde geeft FALSE, want null > x is FALSE.";

		attribute<meter2>  opp_per_grid        (AdminDomain) := opp_per_grid_bron > OppMaxPerCel ? OppMaxPerCel : opp_per_grid_bron
		, Descr = "Het niet-woonvloeroppervlak per cel zoals de kostenkant het gebruikt: de bron hierboven, begrensd op OppMaxPerCel. Alle lezers zitten op dit item, dus de verwervingskosten hieronder,
					Sloopkosten/Calc_Totaal_niet_woningen en de tellingen in Diagnose krijgen de begrensde waarde. Een toets en geen min_elem, zodat een ontbrekende waarde ontbrekend blijft en een leeg veld
					geen wolkenkrabber wordt.";

		attribute<Eur>     Per_AdminDomain     (AdminDomain) := MakeDefined(opp_per_grid, 0[meter2]) * prijs_per_m2, Descr = "De verwervingskosten van het niet-woonvastgoed per cel. Een cel zonder niet-woonvastgoed komt op nul uit en niet op undefined: undefined zou via het exploitatiesaldo de hele cel uit de allocatie halen.";

		attribute<Eur>     Calc             (AdminDomain) := Per_AdminDomain
		, IntegrityCheck = "= /ModelParameters/StudyArea == 'Nederland' ? 'sum(float64(this)) > 250e9 && sum(float64(this)) < 900e9' : 'TRUE'"
		, Descr = "De grens bewaakt de koppeling tussen de prijs per m2 en het oppervlak waarmee die wordt vermenigvuldigd: het landelijke totaal ligt in de orde van de WOZ-waarde van het Nederlandse
						niet-woonvastgoed. De grenzen zijn zo gekozen dat een herijking van de prijsniveaus binnen redelijke marges er niet tegenaan loopt, maar een factor drie in het oppervlak of een verdubbeling
						van de prijs wel; zo ving de check de sprong in het niet-woonoppervlak bij #700 op, waarna de prijs is herijkt (#674). Vuurt hij weer, herijk dan NietWoningen_2017 en
						NietWoningen_WOZVerhouding en verruim de grens niet om hem stil te krijgen.";

		parameter<String> TifFile := '%LocalDataProjDir%/BaseData/Vastgoed/Verwervingskosten_Niet_Woningen_AdminDomain_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft. PropValue van een StorageName levert de expressietekst en niet de uitkomst, en daar kan ExistingFile niets mee.";

		parameter<String> Fingerprint :=
			  'woz_year=2017'
			+ ';growth_office='          + string(ModelParameters/Werken/Groeifactor_CommercieelVastgoed/Kantoor)
			+ ';growth_industry='        + string(ModelParameters/Werken/Groeifactor_CommercieelVastgoed/industrie)
			+ ';growth_retail='          + string(ModelParameters/Werken/Groeifactor_CommercieelVastgoed/winkel)
			+ ';woz_ratio_hall='         + string(ModelParameters/Wonen/Verwervingskosten/NietWoningen_WOZVerhouding_Hal)
			+ ';woz_ratio_other='        + string(ModelParameters/Wonen/Verwervingskosten/NietWoningen_WOZVerhouding_Overig)
			+ ';hall_fraction_default='  + string(ModelParameters/Wonen/Verwervingskosten/NietWoningen_FractieHal_Default)
			+ ';unit_price_2017='        + string(ModelParameters/Wonen/Verwervingskosten/NietWoningen_2017)
			+ ';max_storeys_per_cell=' + string(ModelParameters/Wonen/Verwervingskosten/NietWoningen_MaxBouwlagenPerCel)
			+ ';unit_price_start_year='  + string(kental)
			+ ';start_year='             + string(ModelParameters/Model_StartYear)
			+ ';bag_recent_year='        + string(ModelParameters/BAG_RecentYear)
			+ ';bag_date='               + ModelParameters/BAG_file_date
			+ ';trunc_upper_woononly='   + string(ModelParameters/VBO_opp_truncation_BovengrenzenAlleenWoon)
			+ ';trunc_upper='            + string(ModelParameters/Wonen/VBO_opp_truncation_upper)
			+ ';trunc_lower='            + string(ModelParameters/Wonen/VBO_opp_truncation_lower)
			+ ';combi_split='            + ModelParameters/Werken/UtiliteitCombi/Verdeelsleutel
			+ ';storey_height_nonres_cm='+ string(ModelParameters/VBO_opp_LaaghoogteNietWoon)
			+ ';tolerance_nonres='       + string(ModelParameters/VBO_opp_TolerantieNietWoon)
			+ ';admin_grid='             + ModelParameters/Advanced/AdminDomain_ref
			+ ';grid_size='              + string(AdminDomain/gridsize)
			+ ';study_area='             + ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. woz_year staat als vaste waarde omdat het jaartal hard in het pad van de WOZ-brondata zit; de
						drie groeifactoren indexeren de WOZ-reeksen buiten woongebied; unit_price_start_year is het kental op het prijspeil van start_year en vangt ook een gewijzigde bouwkostenindex; de
						truncatieparameters (#700, #702) en de twee niet-woonparameters bepalen de oppervlaktegrondslag onder opp_per_grid en de halfractie. Een benadering: de halfractie hangt aan de BAG-pandset en
						de hoogteregel van #700, een keten die in geen parameterlijst zit, dus een nieuwe BAG-levering of een andere truncatie verandert de fingerprint, maar een wijziging in de hal-gewichten of de
						toedelingsmatrix zelf niet.";

		container Decoupling := Templates/DecoupledFile_T(TifFile, Fingerprint);

		attribute<Eur>     Write            (AdminDomain) := Calc, StorageName = "=TifFile", IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))", StorageType = "gdalwrite.grid", ExplicitSuppliers = "Decoupling/Write_Fingerprint", Descr = "Check om ervoor te zorgen dat niet de hele kaart undefined of zero is. Is dit wel zo, ga dan terug tracen naar waar het probleem zit. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan de container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<Eur>     Read_UNCHECKED   (AdminDomain) : StorageName = "=TifFile", StorageReadOnly = "True", Descr = "This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the container following this one checks for this.", StorageType = "tif";
		attribute<Eur>     Read             (AdminDomain) := Read_UNCHECKED, IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))";
		attribute<Eur>     Totaal           (AdminDomain) :=
			=	!ModelParameters/BaseDataOntkoppeld ? 'Calc'
			:	Decoupling/MayReuse                 ? 'Read'
			:	                                      'Write'
		, Descr = "Wat de rest van het model gebruikt, in drie standen: niet ontkoppeld rekent door zonder tussenbestand, ontkoppeld met een geldige fingerprint leest de tif, ontkoppeld zonder geldige fingerprint rekent en schrijft in een keer, inclusief het zijbestand. Decoupling/Explanation zegt waarom een bestand wel of niet hergebruikt wordt.";
	}
	

	

	

	

	

	

	

	

	

	
	attribute<Eur> Totaal (AdminDomain) := Woningen/Totaal + Niet_Woningen/Totaal, Descr = "De totale verwervingskosten, woningen plus niet-woningen";
}