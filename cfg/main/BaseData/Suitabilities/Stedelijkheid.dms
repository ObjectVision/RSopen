// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Stad of platteland per cel, de zone-indeling van de EconLogic-schatting van herontwikkeling (#861, #869)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Stedelijkheid
: Descr = "Stad of platteland per cel (#861). De herontwikkelingskans (#869) volgt in de stad de base-specificatie van de EconLogic-schatting, geschat op buurten met een omgevingsadressendichtheid vanaf
			ModelParameters/Wonen/Eigendom/OAD_Stedelijk, en daarbuiten volgens de rural-specificatie. De omgevingsadressendichtheid is die van CBS: per buurt het gemiddelde over haar
			adressen van het aantal adressen per km2 binnen 1 km, hier uit de verblijfsobjecten van het basisjaar. Met een provincie als studiegebied tellen de adressen over de grens niet mee."
{
	unit<UInt32> Buurt := /SourceData/RegioIndelingen/CBS/Gekozen/Buurt;
	container    VBO   := Verwervingskosten/BAG_RecentsteJaar/VBO/Per_Gebruiksdoel;

	attribute<Float32> Adressen             (AllocDomain) := float32(VBO/woon/Select/Counts/Per_AllocDomain) + float32(VBO/niet_woon/Select/Counts/Per_AllocDomain), Descr = "De verblijfsobjecten van het basisjaar per cel van 100 m, met en zonder woonfunctie.";
	attribute<Float32> Dichtheid            (AllocDomain) := potential(Adressen, /Geography/Distmatrices_100m/pot1000m/Flat2) / (/Geography/Distmatrices_100m/pot1000m/oppervlakte * 0.01f), Descr = "Het aantal adressen per km2 binnen 1 km van de cel.";
	attribute<Float32> OAD                  (Buurt)       := sum(Adressen * Dichtheid, Buurt/Per_AllocDomain) / sum(Adressen, Buurt/Per_AllocDomain), Descr = "De omgevingsadressendichtheid van de buurt: Dichtheid gemiddeld over haar adressen.";
	attribute<Bool>    IsStedelijk          (AdminDomain) := MakeDefined(OAD[Buurt/Per_AdminDomain], 0f) >= float32(/ModelParameters/Wonen/Eigendom/OAD_Stedelijk), Descr = "Ligt de cel in een stedelijke buurt? Een cel zonder buurt of in een buurt zonder adressen telt als platteland.";
}
