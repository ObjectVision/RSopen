// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De opslag op de verwervingskosten van woningen naar het energielabel, per cel en per zichtjaar (#860)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Energielabel
: Descr = "De opslag op de verwervingskosten van woningen naar het energielabel, per cel en per zichtjaar (#860). Per woning van het basisjaar het label uit EP-online
			(SourceData/Vastgoed/Energielabels) en daarvan de log van de sloopverhouding uit ModelParameters/Wonen/Energielabel min het gemiddelde over de gelabelde woningen van hetzelfde
			woningtype en dezelfde bouwperiode; een woning zonder label krijgt nul. Per cel het gemiddelde over haar woningen, omgerekend naar euro per hectare met de wisselkoers van de
			cel (Stedelijkheid, stad of platteland), maal de oppervlakte van de cel. Herontwikkeleenheid telt de opslag van het zichtjaar op bij de verwervingskosten."
{
	unit<UInt32> vbo    := Verwervingskosten/vbo_startjaar;
	unit<UInt8>  Label  := /Classifications/Vastgoed/Energielabel;
	unit<UInt32> TypeBP := combine(/Classifications/Vastgoed/WP4, /Classifications/Vastgoed/Bouwperiode), Descr = "De groepen waarbinnen het label wordt vergeleken: woningtype maal bouwperiode van het prijsmodel.";

	attribute<Float32> Gamma           (Label)       := log(/ModelParameters/Wonen/Energielabel/SloopVerhouding), Descr = "Het effect van het label op de log-odds van sloop.";
	attribute<Label>   Label_rel       (vbo)         := /SourceData/Vastgoed/Energielabels/PerVbo/Label_rel[rlookup(vbo/vbo_bag_nr, /SourceData/Vastgoed/Energielabels/PerVbo/values)];
	attribute<TypeBP>  TypeBP_rel      (vbo)         := combine_data(TypeBP, vbo/WP4_rel, Vervanging/Bouwperiode_rel);
	attribute<Float32> Gamma_VBO       (vbo)         := Gamma[Label_rel];
	attribute<Float32> Gamma_Groep     (TypeBP)      := mean(Gamma_VBO, TypeBP_rel), Descr = "Het gemiddelde effect over de gelabelde woningen van de groep.";
	attribute<Float32> Afwijking_VBO   (vbo)         := MakeDefined(Gamma_VBO - Gamma_Groep[TypeBP_rel], 0f), Descr = "Het label van de woning ten opzichte van haar groep, nul zonder label.";
	attribute<Float32> Afwijking_Cel   (AdminDomain) := mean(Afwijking_VBO, vbo/AdminDomain_rel);
	attribute<Eur>     OpslagBasisjaar (AdminDomain) := MakeDefined(Verwervingskosten/Woningen/Totaal, 0[Eur]) > 0[Eur] ? (MakeDefined(Afwijking_Cel, 0f) * Stedelijkheid/Wisselkoers)[Eur_ha] * AdminDomain/NrHaPerCell : 0[Eur]
	, Descr = "De opslag van de cel in het basisjaar, negatief voor een cel met slechtere labels dan haar groep.";

	container PerZichtjaar :=
		for_each_ne(
			/Classifications/Time/Zichtjaar/name
			, 'PerZichtjaar_T('+string(/Classifications/Time/Zichtjaar/PrevYearRange_rel)+'[YearRange])'
		), Descr = "Per zichtjaar de opslag op het begin van de periode, want de allocatie koopt de stand aan het begin van de periode.";

	Template PerZichtjaar_T
	{
		parameter<YearRange> Begin;
		//
		parameter<Float32> Krimp := max_elem(0f, float32((/ModelParameters/Wonen/Energielabel/KrimpJaar - Begin) / 1[YearRange]) / float32((/ModelParameters/Wonen/Energielabel/KrimpJaar - /ModelParameters/Model_StartYear) / 1[YearRange]))
		, Descr = "Het deel van de opslag dat op het begin van de periode nog geldt: een in het basisjaar, lineair naar nul in KrimpJaar, daarna nul.";
		attribute<Eur> Opslag (AdminDomain) := OpslagBasisjaar * Krimp, Descr = "De opslag van de cel op het begin van de periode.";
	}
}
