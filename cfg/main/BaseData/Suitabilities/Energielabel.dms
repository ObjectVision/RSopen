// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De labelopslag op de verwervingskosten van woningen, per cel en per zichtjaar (#860)
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Energielabel
: Descr = "De opslag op de verwervingskosten van woningen naar het energielabel van de cel, per zichtjaar (#860). Het label van de cel is de modus van de RVO-labels van de panden erin, dezelfde
			kaart als de zeefregel GeenSloopvanafELabel gebruikt; de opslag per label en het krimpjaar staan in ModelParameters/Wonen/Energielabel. Suitability_Wonen_perOP_T vermenigvuldigt
			Verwervingskosten/Woningen0 met PerZichtjaar/Factor, naast de factor van de vervanging. Een cel zonder label krijgt factor een."
{
	attribute<Float32> Opslag (AdminDomain) := MakeDefined(/ModelParameters/Wonen/Energielabel/Opslag[/SourceData/Vastgoed/Energielabels/Modus], 0f), Descr = "De opslag van de cel als fractie van de hedonische waarde, nul zonder label.";

	container PerZichtjaar :=
		for_each_ne(
			/Classifications/Time/Zichtjaar/name
			, 'PerZichtjaar_T('+string(/Classifications/Time/Zichtjaar/PrevYearRange_rel)+'[YearRange])'
		), Descr = "Per zichtjaar de factor op de verwervingskosten van woningen: een plus de opslag van de cel maal de krimp op het begin van de periode, zoals Vervanging/PerZichtjaar, want de allocatie
				koopt de stand aan het begin van de periode. In het eerste zichtjaar is de krimp een.";

	Template PerZichtjaar_T
	{
		parameter<YearRange> Begin;
		//
		parameter<Float32> Krimp := max_elem(0f, float32((/ModelParameters/Wonen/Energielabel/KrimpJaar - Begin) / 1[YearRange]) / float32((/ModelParameters/Wonen/Energielabel/KrimpJaar - /ModelParameters/Model_StartYear) / 1[YearRange]))
		, Descr = "Het deel van de opslag dat op het begin van de periode nog geldt: een in het basisjaar, lineair naar nul in KrimpJaar, daarna nul.";
		attribute<Float32> Factor (AdminDomain) := 1f + Opslag * Krimp, Descr = "Waarmee de verwervingskosten van de woningen in de cel worden vermenigvuldigd.";
	}
}
