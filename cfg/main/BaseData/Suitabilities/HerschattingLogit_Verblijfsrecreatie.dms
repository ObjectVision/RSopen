////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Herschatting van de geschiktheidslogit voor verblijfsrecreatie binnen het model, met Templates/Statistiek/Logit_T, op
// dezelfde manier als werken (#708). De uitkomst is de bouw van verblijfsrecreatie per cel van 100 m tussen de BAG-standen van
// 2017 en 2022 (Groei_T). De termen zijn die van de raw-formule in MakeProbabilityMapT_Verblijfsrec op de kaarten van 2017
// (Covariaten_T), met de logies in de cel en in het venster van de cel en de acht cellen eromheen (#649). De schatting neemt
// alle cellen met bouw en een trekking uit de andere cellen, en corrigeert de constante daarvoor. Csv schrijft de
// coefficienten weg in het formaat van de logitcoeff-csv die het model via Verblijfsrec_coeff_date leest; de Vergelijking
// legt de herschatting naast die csv.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Herschatting
: Descr = "Herschatting van de verblijfsrecreatie-geschiktheidslogit op de termen van de toegepaste raw-formule (#649). y is de bouw van verblijfsrecreatie in een cel van 100 m tussen de BAG-standen van 2017 en 2022 (Groei_T); de covariaten zijn de termen van de raw-formule op de kaarten van 2017 (Covariaten_T)."
{
	unit<uint8> Var_toegepast : NrOfRows = 18
	, Descr = "De 17 termen van de toegepaste raw-formule plus de constante, benoemd naar de kolomnamen in de logitcoeff-csv, zodat schatting en csv naast elkaar te leggen zijn."
	{
		attribute<String> name :
		[ 'dist_airport_km_2019', 'dist_highway_km_2018', 'dist_train_km_2019', 'dist_urbancontour_km_2000'
		, 'ln_tt_100kinhab_min_2017', 'landprice_2007', 'landscape_quality', 'dist_natura2000_km_2020'
		, 'avg_shr_lutype_neigh_1000r_a', 'avg_shr_lutype_neigh_1000r_i', 'avg_shr_lutype_neigh_1000r_f'
		, 'avg_shr_lutype_neigh_1000r_o', 'avg_shr_lutype_neigh_1000r_r', 'avg_shr_lutype_neigh_1000r_w'
		, 'avg_shr_lutype_neigh_1000r_d', 'ln_vr_bag', 'ln_vr_venster_bag', 'Constant'
		];
	}

	Template Logies_T
	: Descr = "De logies in een verblijfsrecreatiegebied van het CBS volgens de BAG-stand van 1 januari van Jaar, per pand en per cel van 100 m, op dezelfde populatie als de claim en de stand van verblijfsrecreatie (#364)."
	{
		parameter<UInt32> Jaar;
		//
		unit<uint32> Pand      := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(Jaar) + '/pand';
		unit<uint32> Toedeling := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(Jaar) + '/pand/ToedelingsMatrix_AllocDomain';

		attribute<float32> PerPand (Pand)                := MakeDefined(Pand/LigtInCBSVerblijfsrecreatie, FALSE) ? MakeDefined(value(Pand/Oppervlaktes/Footprint_perGebruiksdoel/logies, float32), 0f) : 0f, Descr = "De voetafdruk van de logies in het pand in m2 als het pand in een verblijfsrecreatiegebied van het CBS ligt, en anders 0.";
		attribute<float32> Cel     (AllocDomain)         := sum(PerPand[Toedeling/Pand_rel] * Toedeling/ToedelingPand, Toedeling/AllocDomain_rel), Descr = "De voetafdruk van die logies per cel van 100 m in m2, verdeeld over de cellen waarin het pand ligt.";
		attribute<float32> Cel_rdc (/Geography/rdc_100m) := sum(Cel, AllocDomain/rdc_100m_rel);
		attribute<float32> Venster (AllocDomain)         := (Cel_rdc + potential(Cel_rdc, /Geography/Distmatrices/Impl_100m/pot100m/PotRange/neighbourhood))[AllocDomain/rdc_100m_rel], Descr = "Dezelfde voetafdruk opgeteld over de cel en de acht cellen eromheen, zoals Logies_Venster_100m in de toepassing.";
	}
	container Logies2017 := Logies_T(2017), Descr = "De logies aan het begin van de schattingsperiode.";
	container Logies2022 := Logies_T(2022), Descr = "De logies aan het eind van de schattingsperiode.";

	Template Groei_T
	: Descr = "Bouw van verblijfsrecreatie per cel van 100 m tussen de BAG-standen van L0 en L1 (Logies_T). Bouw volgt Groei_T van werken (#708): een pand met logies in een verblijfsrecreatiegebied in L1 dat in L0 niet in de BAG stond of nog geen verblijfsobject had en een recent bouwjaar heeft, of een pand dat in beide standen zulke logies had en groter werd. Een ouder pand dat later in de BAG kwam en een pand dat van gebruik wisselde tellen niet mee, want het model plaatst met de geschiktheidskaart bouw."
	{
		container L0;
		container L1;
		//
		unit<uint32> Pand0 := L0/Pand;
		unit<uint32> Pand1 := L1/Pand;

		attribute<Pand0> Pand0_rel (Pand1) := IsDefined(Pand1/pand_bag_nr) ? rlookup(Pand1/pand_bag_nr, Pand0/pand_bag_nr) : (0/0)[Pand0], Descr = "Hetzelfde pand in L0, op BAG-pandnummer.";
		attribute<Pand1> Pand1_rel (Pand0) := IsDefined(Pand0/pand_bag_nr) ? rlookup(Pand0/pand_bag_nr, Pand1/pand_bag_nr) : (0/0)[Pand1], Descr = "Hetzelfde pand in L1, op BAG-pandnummer.";

		attribute<bool> IsVr1          (Pand1) := L1/PerPand > 0f;
		attribute<bool> InBegin        (Pand1) := IsDefined(Pand0_rel), Descr = "Het pand stond al in de BAG van L0.";
		attribute<bool> WasVr          (Pand1) := InBegin && L0/PerPand[Pand0_rel] > 0f;
		attribute<bool> RecentBouwjaar (Pand1) := int32(Pand1/Bouwjaar) >= int32(L0/Jaar) - int32(/ModelParameters/Werken/Herschatting/BouwjaarMarge);
		attribute<bool> IsNieuwbouw    (Pand1) := IsVr1 && !InBegin && RecentBouwjaar, Descr = "Een pand met logies in een verblijfsrecreatiegebied dat in L0 niet in de BAG stond en een recent bouwjaar heeft.";
		attribute<bool> KreegVbo       (Pand1) := IsVr1 && InBegin && !WasVr && Pand0/counts/VBOs[Pand0_rel] == 0 && RecentBouwjaar, Descr = "Een pand dat in L0 in aanbouw of zonder verblijfsobject in de BAG stond, met een recent bouwjaar.";
		attribute<bool> Uitbreiding    (Pand1) := IsVr1 && WasVr && Pand1/Footprint[float32] - Pand0/Footprint[float32][Pand0_rel] >= /ModelParameters/Werken/Herschatting/PandGroter, Descr = "Een pand dat in beide standen logies in een verblijfsrecreatiegebied had en groter werd.";
		attribute<bool> IsBouw         (Pand1) := IsNieuwbouw || KreegVbo || Uitbreiding;
		attribute<bool> IsBouw0        (Pand0) := IsDefined(Pand1_rel) && IsBouw[Pand1_rel], Descr = "Het pand is in L1 een bouwpand; alleen bij een uitbreiding heeft het in L0 logies die eraf gaan.";

		attribute<float32> m2 (AllocDomain) :=
			  sum(IsBouw[L1/Toedeling/Pand_rel] ? L1/PerPand[L1/Toedeling/Pand_rel] * L1/Toedeling/ToedelingPand : 0f, L1/Toedeling/AllocDomain_rel)
			- sum(IsBouw0[L0/Toedeling/Pand_rel] ? L0/PerPand[L0/Toedeling/Pand_rel] * L0/Toedeling/ToedelingPand : 0f, L0/Toedeling/AllocDomain_rel)
			, Descr = "Groei van de logies per cel door de bouwpanden: hun logies in L1 min die in L0, verdeeld over de cellen waarin ze liggen, in m2.";
		attribute<bool>   y      (AllocDomain) := m2 >= /ModelParameters/Verblijfsrecreatie/Herschatting/Drempel, Descr = "De cel telt als bouw van verblijfsrecreatie.";
		parameter<uint32> Aantal               := sum(uint32(y)), Descr = "Aantal cellen met bouw.";
	}
	container Groei := Groei_T(Logies2017, Logies2022), Descr = "De schattingsperiode.";

	Template Covariaten_T
	: Descr = "De termen van de raw-formule op cellen van 100 m aan het begin van een periode, met dezelfde transformaties: afstanden in km, de reistijd als logaritme, de grondprijs per m2, de beleving, de buurtaandelen uit de BBG van het jaar van L en de logies uit L. Van de afstanden, de grondprijs, de reistijd en de beleving is geen oudere stand, dus die zijn de kaarten die de toepassing ook leest."
	{
		container L;
		//
		parameter<String> Buurt := '/BaseData/Grondgebruik/BBG/Dominant/Avg_shr_LUType_neigh/Y' + string(L/Jaar) + '/r1000/';

		attribute<float32> dist_airport_km_2019         (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/DistTo_Airports_2019 / 1[km], AdminDomain/AllocDomain_rel);
		attribute<float32> dist_highway_km_2018         (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/DistTo_Highway_acces_exit_2018 / 1[km], AdminDomain/AllocDomain_rel);
		attribute<float32> dist_train_km_2019           (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/DistTo_Trainstation_2019 / 1[km], AdminDomain/AllocDomain_rel);
		attribute<float32> dist_urbancontour_km_2000    (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/DistTo_Urban_Contour_2000 / 1[km], AdminDomain/AllocDomain_rel);
		attribute<float32> ln_tt_100kinhab_min_2017     (AllocDomain) := mean(log(/SourceData/Diversen/Per_AdminDomain/tt_100kinhab_min / 1[min]), AdminDomain/AllocDomain_rel);
		attribute<float32> landprice_2007               (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/Hedonic_landPrice_2017 / 1[Eur_m2], AdminDomain/AllocDomain_rel);
		attribute<float32> landscape_quality            (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/BelevingLandschap/NoMissing2, AdminDomain/AllocDomain_rel);
		attribute<float32> dist_natura2000_km_2020      (AllocDomain) := mean(/SourceData/Diversen/Per_AdminDomain/DistTo_Natura2000_2020 / 1[km], AdminDomain/AllocDomain_rel);
		attribute<float32> avg_shr_lutype_neigh_1000r_a (AllocDomain) := ='' + Buurt + 'agriculture[AllocDomain/rdc_100m_rel]';
		attribute<float32> avg_shr_lutype_neigh_1000r_i (AllocDomain) := ='' + Buurt + 'infrastructure[AllocDomain/rdc_100m_rel]';
		attribute<float32> avg_shr_lutype_neigh_1000r_f (AllocDomain) := ='' + Buurt + 'forest[AllocDomain/rdc_100m_rel]';
		attribute<float32> avg_shr_lutype_neigh_1000r_o (AllocDomain) := ='' + Buurt + 'othernature[AllocDomain/rdc_100m_rel]';
		attribute<float32> avg_shr_lutype_neigh_1000r_r (AllocDomain) := ='' + Buurt + 'residential[AllocDomain/rdc_100m_rel]';
		attribute<float32> avg_shr_lutype_neigh_1000r_w (AllocDomain) := ='' + Buurt + 'water[AllocDomain/rdc_100m_rel]';
		attribute<float32> avg_shr_lutype_neigh_1000r_d (AllocDomain) := ='' + Buurt + 'diversity[AllocDomain/rdc_100m_rel]';
		attribute<float32> ln_vr_bag                    (AllocDomain) := log(1f + L/Cel), Descr = "De logaritme van 1 plus de logies in de cel in m2.";
		attribute<float32> ln_vr_venster_bag            (AllocDomain) := log(1f + L/Venster), Descr = "De logaritme van 1 plus de logies in de cel en de acht cellen eromheen in m2.";
		attribute<float32> Constant                     (AllocDomain) := const(1f, AllocDomain);

		attribute<bool> IsEindig (AllocDomain) := ='AND(' + AsList('abs(' + Var_toegepast/name + ') < 1e30f', ',') + ')', Descr = "Alle termen van Var_toegepast zijn gedefinieerd en eindig.";
	}
	container Covariaten := Covariaten_T(Logies2017), Descr = "De covariaten aan het begin van de schattingsperiode.";

	attribute<float32> Lot      (AllocDomain) := rnd_uniform(/ModelParameters/Verblijfsrecreatie/Herschatting/Seed, AllocDomain, range(float32, 0f, 1f));
	attribute<bool>    InSample (AllocDomain) := AllocDomain/IsStudyArea && Covariaten/IsEindig && (Groei/y || Lot < /ModelParameters/Verblijfsrecreatie/Herschatting/Trekking), Descr = "Alle cellen met bouw en een trekking uit de cellen zonder, binnen het studiegebied en met eindige waarden op alle termen.";

	unit<uint64> Selectie := select_with_org_rel(InSample), Descr = "De cellen van 100 m in de steekproef; een selectie uit een grid is uint64.";
	
	unit<uint32> Obs := range(uint32, 0, uint32(#Selectie))
	, Descr = "De waarnemingen, als uint32 zoals Logit_T vraagt."
	{
		attribute<AllocDomain> org_rel := Selectie/org_rel[uint64(id(.))[Selectie]];
	}

	container Data :=
		for_each_nedv(
			Var_toegepast/name
			, 'float64(Covariaten/' + Var_toegepast/name + '[Obs/org_rel])'
			, Obs
			, float64
		)
	, Descr = "De invoer van Logit_T op de waarnemingen: de termen van Var_toegepast, de uitkomst, het steekproefmasker en de trekkingskans."
	{
		attribute<bool>    y        (Obs) := Groei/y[Obs/org_rel];
		attribute<bool>    InSample (Obs) := const(TRUE, Obs);
		parameter<float64> Trekkingskans := float64(/ModelParameters/Verblijfsrecreatie/Herschatting/Trekking);
	}

	container Toegepast := Templates/Statistiek/Logit_T('verblijfsrecreatie_toegepast', Obs, Var_toegepast, Data), Descr = "De schatting op de termen van de toegepaste raw-formule, op de bouw van de schattingsperiode.";

	attribute<float64> CoefCsv (Var_toegepast) := ='union_data(Var_toegepast, ' + AsList('float64(ReadCoefficients_Verblijfsrecreatie/Variant_Dist_1000m_Neighbourhood/Result/' + Var_toegepast/name + ')', ', ') + ')', Descr = "De coefficienten uit de csv die de toepassing leest (Verblijfsrec_coeff_date), voor de termen van Var_toegepast.";
	attribute<String>  Regel   (Var_toegepast) := Var_toegepast/name + ';' + string(CoefCsv) + ';' + string(Toegepast/beta_gecorrigeerd) + ';' + string(Toegepast/Eind/se);

	parameter<String>  Vergelijking := 'parameter;csv;herschatting;se\n' + AsList(Regel, '\n') + '\n'
		+ 'waarnemingen;' + string(Toegepast/N_) + '\nbouwcellen;' + string(Toegepast/pos_) + '\nbouwcellen_studiegebied;' + string(sum(uint32(Groei/y && AllocDomain/IsStudyArea)))
		+ '\nLL0;' + string(Toegepast/LL0) + '\nLL;' + string(Toegepast/LL_eind) + '\nMcFaddenR2;' + string(Toegepast/McFaddenR2) + '\nConvergentieStap;' + string(Toegepast/ConvergentieStap) + '\n'
	, StorageName = "='%LocalDataProjDir%/Diagnose/logit_verblijfsrecreatie_vergelijking.txt'"
	, StorageType = "str"
	, Descr = "De herschatting naast de csv die de toepassing leest, als txt in de Diagnose-map; op aanvraag. De csv van 20261117 komt uit Csv, dus een verschil tussen de twee kolommen betekent dat de invoer of de opzet sinds die schatting veranderd is.";

	attribute<String>  CsvRegel (Var_toegepast) := 'HasVerblijfsrecreatieGrowth;' + Var_toegepast/name + ';' + string(Toegepast/beta_gecorrigeerd) + ';' + string(Toegepast/Eind/se) + ';' + string(Toegepast/beta_gecorrigeerd / Toegepast/Eind/se);
	parameter<String>  Csv := 'eq;parm;estimate;stderr;z\n' + AsList(CsvRegel, '\n') + '\n'
	, StorageName = "='%LocalDataProjDir%/Diagnose/logitcoeff_HasVerblijfsrecreatie_herschatting_Dist_1000m_Neighbourhood.csv'"
	, StorageType = "str"
	, Descr = "De herschatting in het formaat van de logitcoeff-csv die ReadCoefficientsT leest, in de Diagnose-map; op aanvraag. Met de datum van de schatting in de naam wordt hij de csv van Verblijfsrec_coeff_date, zoals bij werken (#708); de csv van 20261117 is zo gemaakt (#649).";
}
