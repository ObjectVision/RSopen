////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Herschatting van de geschiktheidslogit voor verblijfsrecreatie, binnen het model zelf, met
// Templates/Statistiek/Logit_T. Waarom deze herschatting bestaat: de toegepaste formule in
// MakeProbabilityMapT_Verblijfsrec gebruikt 15 van de 22 geschatte termen uit
// logitcoeff_HasVerblijfsrecreatie_20211213_Dist_1000m_Neighbourhood.csv (Koomen, Claassens &
// Konig 2021), maar wel de constante van het volledige model. De weggelaten termen (de vijf
// beleidsdummy's en de EHS-afstand) hadden in de schatting een deel van de verklaring op zich
// genomen; door ze weg te laten zonder de overige coefficienten opnieuw te schatten verschuift
// de rangschikking van cellen. Deze herschatting maakt schatting en toepassing weer consistent:
// zelfde termen, zelfde transformaties, zelfde databron als de toepassing. De beleidsdummy's
// blijven bewust weg: restricties lopen in RSopen via de zeef, niet via de geschiktheid.
//
// Twee varianten: Toegepast (exact de 15 termen plus constante van de huidige raw-formule) en
// Toegepast_plus_ehs (idem plus DistTo_EHS_1990, de term die in de toepassing is
// uitgecommentarieerd). De toepassing zelf blijft ongewijzigd; omschakelen naar deze
// coefficienten is een aparte stap.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Herschatting
: Descr = "Herschatting van de verblijfsrecreatie-geschiktheidslogit op de termen die de toepassing echt gebruikt. y is de overgang naar verblijfsrecreatie tussen BBG 1996 en BBG 2015; de covariaten zijn exact de Diversen-termen en transformaties uit de raw-formule van MakeProbabilityMapT_Verblijfsrec."
{
	unit<uint8> Var_toegepast : NrOfRows = 16
	, Descr = "De 15 termen van de toegepaste raw-formule plus de constante, benoemd naar de kolomnamen in de logitcoeff-csv zodat de rapporten naast elkaar te leggen zijn."
	{
		attribute<String> name :
		[ 'dist_airport_km_2019', 'dist_highway_km_2018', 'dist_train_km_2019', 'dist_urbancontour_km_2000'
		, 'ln_tt_100kinhab_min_2017', 'landprice_2007', 'landscape_quality', 'dist_natura2000_km_2020'
		, 'avg_shr_lutype_1996_neigh_1000r_a', 'avg_shr_lutype_1996_neigh_1000r_i', 'avg_shr_lutype_1996_neigh_1000r_f'
		, 'avg_shr_lutype_1996_neigh_1000r_o', 'avg_shr_lutype_1996_neigh_1000r_r', 'avg_shr_lutype_1996_neigh_1000r_w'
		, 'avg_shr_lutype_1996_neigh_1000r_d', 'Constant'
		];
	}

	unit<uint8> Var_toegepast_plus_ehs : NrOfRows = 17
	, Descr = "Zelfde termen plus dist_ehs_km_1990, de term die in de raw-formule is uitgecommentarieerd."
	{
		attribute<String> name :
		[ 'dist_airport_km_2019', 'dist_highway_km_2018', 'dist_train_km_2019', 'dist_urbancontour_km_2000'
		, 'dist_ehs_km_1990'
		, 'ln_tt_100kinhab_min_2017', 'landprice_2007', 'landscape_quality', 'dist_natura2000_km_2020'
		, 'avg_shr_lutype_1996_neigh_1000r_a', 'avg_shr_lutype_1996_neigh_1000r_i', 'avg_shr_lutype_1996_neigh_1000r_f'
		, 'avg_shr_lutype_1996_neigh_1000r_o', 'avg_shr_lutype_1996_neigh_1000r_r', 'avg_shr_lutype_1996_neigh_1000r_w'
		, 'avg_shr_lutype_1996_neigh_1000r_d', 'Constant'
		];
	}

	container Data
	: Descr = "Covariaten, afhankelijke variabele en steekproefmasker. Transformaties exact zoals in de raw-formule: afstanden in km, reistijd als log(minuten), grondprijs per m2, beleving via NoMissing2. Beide varianten delen deze container, zodat ze op dezelfde steekproef geschat worden."
	{
		attribute<float32> dist_airport_km_2019      (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/DistTo_Airports_2019 / 1[km];
		attribute<float32> dist_highway_km_2018      (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/DistTo_Highway_acces_exit_2018 / 1[km];
		attribute<float32> dist_train_km_2019        (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/DistTo_Trainstation_2019 / 1[km];
		attribute<float32> dist_urbancontour_km_2000 (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/DistTo_Urban_Contour_2000 / 1[km];
		attribute<float32> dist_ehs_km_1990          (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/DistTo_EHS_1990 / 1[km];
		attribute<float32> ln_tt_100kinhab_min_2017  (AdminDomain) := log(/SourceData/Diversen/Per_AdminDomain/tt_100kinhab_min / 1[min]);
		attribute<float32> landprice_2007            (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Hedonic_landPrice_2007 / 1[Eur_m2];
		attribute<float32> landscape_quality         (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/BelevingLandschap/NoMissing2;
		attribute<float32> dist_natura2000_km_2020   (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/DistTo_Natura2000_2020 / 1[km];

		attribute<float32> avg_shr_lutype_1996_neigh_1000r_a (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_agriculture;
		attribute<float32> avg_shr_lutype_1996_neigh_1000r_i (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_infrastructure;
		attribute<float32> avg_shr_lutype_1996_neigh_1000r_f (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_forest;
		attribute<float32> avg_shr_lutype_1996_neigh_1000r_o (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_othernature;
		attribute<float32> avg_shr_lutype_1996_neigh_1000r_r (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_residential;
		attribute<float32> avg_shr_lutype_1996_neigh_1000r_w (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_water;
		attribute<float32> avg_shr_lutype_1996_neigh_1000r_d (AdminDomain) := /SourceData/Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_diversity;

		attribute<float32> Constant (AdminDomain) := const(1f, AdminDomain);

		attribute<bool> WasVerblijfsrecreatie_1996 (AdminDomain) := /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain_perKlasse/Y1996/PerKlasse/Verblijfsrecreatie, Descr = "Dominant grondgebruik verblijfsrecreatie volgens BBG 1996.";
		attribute<bool> IsVerblijfsrecreatie_2015  (AdminDomain) := /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain_perKlasse/Y2015/PerKlasse/Verblijfsrecreatie, Descr = "Dominant grondgebruik verblijfsrecreatie volgens BBG 2015.";

		attribute<bool> y (AdminDomain) := IsVerblijfsrecreatie_2015 && !WasVerblijfsrecreatie_1996, Descr = "HasVerblijfsrecreatieGrowth: de cel werd verblijfsrecreatie tussen 1996 en 2015.";

		attribute<bool> InSample (AdminDomain) :=
			   AdminDomain/IsStudyArea
			&& IsDefined(y)
			&& IsDefined(dist_airport_km_2019)
			&& IsDefined(dist_highway_km_2018)
			&& IsDefined(dist_train_km_2019)
			&& IsDefined(dist_urbancontour_km_2000)
			&& IsDefined(dist_ehs_km_1990)
			&& IsDefined(ln_tt_100kinhab_min_2017)
			&& IsDefined(landprice_2007)
			&& IsDefined(landscape_quality)
			&& IsDefined(dist_natura2000_km_2020)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_a)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_i)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_f)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_o)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_r)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_w)
			&& IsDefined(avg_shr_lutype_1996_neigh_1000r_d)
			, Descr = "Studiegebied met volledige data op alle termen, inclusief de EHS-afstand, zodat beide varianten dezelfde steekproef hebben.";
	}

	parameter<String> CoefFile := '%LocalDataProjDir%/BaseData/Vastgoed/Verblijfsrecreatie/LogitCoef_toegepast_'+/ModelParameters/StudyArea+'.mmd'
	, Descr = "Ontkoppeld bestand met de herschatte coefficienten, zodat de geschiktheidskaart niet bij elke verse berekening de volledige schatting (orde tien minuten op het volledige raster) hoeft te draaien. Zelfde mechanisme als de Betas van de verblijfsrecreatietrends. Bij een onleesbare verse mmd: zie GeoDMS-issue 1195, het 0Dictionary-bestand verwijst dan verkeerd en moet gepatcht.";

	parameter<String> Fingerprint :=
		  'terms=' + asList(Var_toegepast/name, ',')
		+ ';y=bbg_verblijfsrecreatie_groei_1996_2015'
		+ ';study_area=' + /ModelParameters/StudyArea
		+ ';admin_ref=' + /ModelParameters/Advanced/AdminDomain_ref
		+ ';bbg_year=' + /ModelParameters/BBG_Year
		+ ';iters=15'
	, Descr = "De invoeren die de coefficienten bepalen: de termenlijst, de definitie van de afhankelijke variabele, het studiegebied, de rasterresolutie waarop geschat wordt, de BBG-jaargang die de buurtaandelen voedt, en het aantal IRLS-iteraties.";

	container Write_Coef
	: StorageName = "=CoefFile"
	, Descr = "Schrijf de herschatte coefficienten en standaardfouten weg naar mmd."
	{
		attribute<Float64> beta (Var_toegepast) := Toegepast/It15/beta;
		attribute<Float64> se   (Var_toegepast) := Toegepast/Eind/se;
	}

	container Read_Coef
	: StorageName = "=CoefFile", StorageReadOnly = "TRUE"
	, Descr = "Lees de eerder weggeschreven coefficienten weer in uit mmd.";

	container Decoupling := Templates/DecoupledFile_T(CoefFile, Fingerprint);

	container Coef := = Decoupling/MayReuse ? 'Read_Coef' : 'Write_Coef'
	, Descr = "Wat de toepassing hoort te gebruiken: leest de mmd wanneer die er staat en de fingerprint klopt, en rekent hem anders opnieuw uit en schrijft hem weg.";

	container CoefVoorToepassing :=
		for_each_nedv(
			Var_toegepast/name
			, 'float32(Coef/beta[' + string(id(Var_toegepast)) + '[Var_toegepast]])'
			, void
			, float32
		), Descr = "Scalar per term, float32, met dezelfde namen als ReadCoefficients_Verblijfsrecreatie/.../Result, zodat de raw-formule in MakeProbabilityMapT_Verblijfsrec er een op een naar kan verwijzen (#649).";

	parameter<String> Generate := 'Ready', ExplicitSuppliers = "Write_Coef/beta;Write_Coef/se;Decoupling/Write_Fingerprint"
	, Descr = "Trigger om het coefficientenbestand samen met het fingerprint-zijbestand te genereren.";

	container Toegepast          := Templates/Statistiek/Logit_T('verblijfsrecreatie_toegepast', Var_toegepast, Data), Descr = "Herschatting op exact de termen van de toegepaste raw-formule.";
	container Toegepast_plus_ehs := Templates/Statistiek/Logit_T('verblijfsrecreatie_toegepast_plus_ehs', Var_toegepast_plus_ehs, Data), Descr = "Herschatting met daarnaast de EHS-afstand.";
}
