// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Wat het model afleidt uit de regio-indelingen die SourceData/RegioIndelingen inleest (#440): de buffers rond
// de bebouwde gebieden per populatieklasse.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container RegioIndelingen
{
	container BegrenzingBebouwdGebied
	: Descr = "De buffers van een kilometer rond de bebouwde gebieden van SourceData/RegioIndelingen/BegrenzingBebouwdGebied, per populatieklasse en als ontkoppelde tif in LocalData; het inwonertal en de klassen staan bij de begrenzing zelf (#749, #440)."
	{
		container Maak_PopK_Buffers :=
			for_each_ne(
				/SourceData/RegioIndelingen/BegrenzingBebouwdGebied/PopK/name
				, 'Maak_PopK_Buffers_T('+quote(/SourceData/RegioIndelingen/BegrenzingBebouwdGebied/PopK/name)+', '+quote('UrbanContour_')+', /SourceData/RegioIndelingen/BegrenzingBebouwdGebied)'
			), Descr = "Buffers van een kilometer rond de bebouwde gebieden per populatieklasse, met het inwonertal uit de CBS-vierkanten (#749). Hetzelfde sjabloon als bij de bevolkingskernen; alleen de bron en het bestandsprefix verschillen, zodat de twee sets naast elkaar op schijf kunnen staan."
		{
			parameter<String> Generate := 'Ready', ExplicitSuppliers = "=asList(/SourceData/RegioIndelingen/BegrenzingBebouwdGebied/PopK/name+'/select/split_geometry/MetBuffer/Write_Is_Buffer', ';')";
		}

		Template Maak_PopK_Buffers_T
		{
			parameter<String> PopK_name;
			parameter<String> Bestandsprefix : Descr = "Onderscheidt de weggeschreven buffers per bron (#749). Zonder dit zouden de kernen van 2011 en de begrenzing van 2022 naar hetzelfde tif schrijven, en dan bepaalt de volgorde van genereren wat erin staat zonder dat de configuratie dat ergens zegt.";
			unit<UInt32> Bron : Descr = "De unit waarvan de kernen worden gebufferd. Moet expliciet worden meegegeven: een sjabloon resolveert een ongekwalificeerde naam vanaf de plek waar het staat, en dit sjabloon staat in Bevolkingskern_2011, zodat de aanroep vanuit BegrenzingBebouwdGebied anders stil de klassen van de bevolkingskernen leest (skill geodms-valkuilen, naamafscherming).";
			///
			unit<UInt32> select := ='select_with_org_rel(Bron/'+PopK_name+')'
			{
				attribute<rdc_meter> geometry (poly) := (org_rel -> geometry)[rdc_meter]
				, Descr = "De cast is nodig en geen sierlijkheid. BegrenzingBebouwdGebied is gedefinieerd als de gpkg-tabel en overschrijft daarin geometry met een rdc_meter-versie, maar de dereferentie hierboven pakt door early binding de geerfde geometrie uit die tabel, en die staat in rdc_meter_base. Zonder cast valt deze keten om op een values mismatch, en pas bij het rekenen: de parse ziet het niet.";
				
				unit<UInt32> split_geometry := geos_split_polygon(geometry)
				{
					attribute<rdc_meter> Buffer1000m     (poly) := geos_buffer_multi_polygon(geometry[rdc_meter], float64(/ModelParameters/Advanced/Bevolkingskern_Bufferstraal / 1[meter]), 4b);
					attribute<rdc_meter> MetBuffer       (poly) := Buffer1000m
					{
						attribute<..>    Per_AdminDomain (AdminDomain) := poly2grid(MetBuffer, AdminDomain);
						attribute<Bool>  Write_Is_Buffer (AdminDomain) := IsDefined(Per_AdminDomain), StorageName = "='%LocalDataProjDir%/BaseData/PopBuffers/'+Bestandsprefix+PopK_name+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'", StorageType = "tif";
						attribute<Bool>  Is_Buffer       (AdminDomain) : StorageName = "='%LocalDataProjDir%/BaseData/PopBuffers/'+Bestandsprefix+PopK_name+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'", StorageReadOnly = "TRUE", StorageType = "tif";
					}
				}
			}
		}
	}
}
