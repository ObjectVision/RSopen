////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepalen van geschiktheden voor verschillende sectoren op basis van logit modellen, prijsindeces en regionale
// en nationale kenmerken. Bepalen van de woningwaarde per woningtype op basis van de prijsindex en de regionale
// en nationale kenmerken van de woningen. Haal de woning oppervlak per woningtype op Laadt via #include:
// RegionalAvgCharacteristics, UAI, PrijsIndex, Grondproductiekosten, Verwervingskosten, Geschiktheden_Werken.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Suitabilities
: Descr = "Bepalen van geschiktheden voor verschillende sectoren op basis van logit modellen, prijsindeces en regionale en nationale kenmerken."
{
	container Wonen
	{
		container Woningwaarde_perWoningType := 
			for_each_ne(
				Classifications/Vastgoed/WP4/name
				, 'Templates/Suitabilities/Woningwaarde_perWoningType_T('+string(id(Classifications/Vastgoed/WP4))+'[Classifications/Vastgoed/WP4])'
			), Descr = "Bepalen van de woningwaarde per woningtype op basis van de prijsindex en de regionale en nationale kenmerken van de woningen.";
		
		#include<RegionalAvgCharacteristics.dms>
		#include<UAI.dms>
		#include<PrijsIndex.dms>
		#include<Grondproductiekosten.dms>
		#include<Verwervingskosten.dms>
		
		container Sloopkosten := 
			for_each_nedv(
				Classifications/Vastgoed/WP4/name
				, 'MakeDefined(SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/VBO/per_Gebruiksdoel/woon/Select/Oppervlaktes/per_WP4_AdminDomain/'+Classifications/Vastgoed/WP4/name+' * 1[verblijfsobject] * /ModelParameters/Wonen/Sloopkosten/'+Classifications/Vastgoed/WP4/name+', 0[eur])' 
				, AdminDomain
				, eur
			), Descr = "Haal de woning oppervlak per woningtype op"
		{
			attribute<eur> Totaal               (AdminDomain) := ='add('+AsItemList(Classifications/Vastgoed/WP4/name)+')';
			attribute<eur> Totaal_niet_woningen (AdminDomain) := ='SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/pand/Oppervlaktes/VBOopp_perGebruiksdoel/niet_woon_AdminDomain * /ModelParameters/Wonen/Sloopkosten/Kantoor';
		} 
	} 
	
	#include<Geschiktheden_Werken.dms>
	
	container Verblijfsrecreatie : using = "SourceData/Actoren/Banen;Classifications/Grondgebruik;Classifications/Actor"
	{
		container ProbabilityMap_Verblijfsrecreatie
		: Descr = "Bepalen van de geschiktheid van locaties voor verblijfsrecreatie op basis van een logit model met verschillende varianten."
		{
			container Variant_Dist_1000m_Neighbourhood   := MakeProbabilityMapT_Verblijfsrec('Verblijfsrecreatie','Dist_1000m_Neighbourhood', '1000');
		}
		
		container ReadCoefficients_Verblijfsrecreatie
		: Descr = "Inlezen van de logit coëfficiënten voor verschillende modelvarianten voor verblijfsrecreatie."
		{
			//container Variant_Dist_100m_Neighbourhood  := ReadCoefficientsT('Verblijfsrecreatie',ModelParameters/Verblijfsrec_coeff_date,'_Dist_100m_Neighbourhood');
			container Variant_Dist_1000m_Neighbourhood := ReadCoefficientsT('Verblijfsrecreatie',ModelParameters/Verblijfsrec_coeff_date,'_Dist_1000m_Neighbourhood');
			//container Variant_LnDist_100m_Neighbourhood := ReadCoefficientsT('Verblijfsrecreatie',ModelParameters/Verblijfsrec_coeff_date,'_LnDist_100m_Neighbourhood');
			//container Variant_LnDist_1000m_Neighbourhood := ReadCoefficientsT('Verblijfsrecreatie',ModelParameters/Verblijfsrec_coeff_date,'_LnDist_1000m_Neighbourhood');
		}

		#include<HerschattingLogit_Verblijfsrecreatie.dms>

		Template MakeProbabilityMapT_Verblijfsrec
		: Descr = "Template voor het maken van een geschiktheidskaart voor verblijfsrecreatie op basis van een logit model met verschillende varianten."
		{
			parameter<String> Sectorname;
			parameter<String> Variantname;
			parameter<String> Radius;
			
			container Coef := = ModelParameters/Verblijfsrecreatie/GebruikHerschatteLogitCoefficienten
				? '/BaseData/Suitabilities/Verblijfsrecreatie/Herschatting/CoefVoorToepassing'
				: 'ReadCoefficients_Verblijfsrecreatie/Variant_'+Variantname+'/Result'
			, Descr = "Bron van de logit-coefficienten: standaard de in het model herschatte set (consistent met de toegepaste termen, #649), anders de csv-coefficienten uit 2021. De itemnamen zijn in beide bronnen gelijk.";
			
			attribute<Float32> raw (AdminDomain) := ='MakeDefined(
				Coef/Constant
				+ (Diversen/Per_AdminDomain/DistTo_Airports_2019 / 1[km])                       * Coef/dist_airport_km_2019
				+ (Diversen/Per_AdminDomain/DistTo_Highway_acces_exit_2018 / 1[km])             * Coef/dist_highway_km_2018 
				+ (Diversen/Per_AdminDomain/DistTo_Trainstation_2019 / 1[km])                   * Coef/dist_train_km_2019
				+ (Diversen/Per_AdminDomain/DistTo_Urban_Contour_2000 / 1[km])                  * Coef/dist_urbancontour_km_2000
				// + (Diversen/Per_AdminDomain/DistTo_EHS_1990 / 1[km])                         * Coef/dist_ehs_km_1990
				+ log(Diversen/Per_AdminDomain/tt_100kinhab_min / 1[min])                       * Coef/ln_tt_100kinhab_min_2017 
				+ (Diversen/Per_AdminDomain/Hedonic_landPrice_2007 / 1[Eur_m2])                 * Coef/landPrice_2007
				+ (Diversen/Per_AdminDomain/BelevingLandschap/NoMissing2[float32])              * Coef/landscape_quality
				+ (Diversen/Per_AdminDomain/DistTo_Natura2000_2020 / 1[km])                     * Coef/dist_natura2000_km_2020
				
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_agriculture               * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_a
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_infrastructure            * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_i
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_forest                    * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_f
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_othernature               * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_o
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_residential               * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_r
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_water                     * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_w
				+ Diversen/Per_AdminDomain/Avg_shr_LUType_neigh_1000r_diversity                 * Coef/avg_shr_luType_1996_neigh_'+Radius+'r_d
				,-1e9f
			)', Descr = "Berekening van de raw score voor geschiktheid op basis van de coëfficiënten en de variabelen. Cellen met ontbrekende data krijgen -1e9, zodat exp(raw)/(1+exp(raw)) daar 0 is; met de oude vulling 0f kreeg nodata kans 0,5 en kwam daarmee juist bovenaan de rangorde (zelfde fix als werken, #599).";
			
			attribute<Float32> exponentiated (AdminDomain):= AdminDomain/IsStudyArea ? exp(raw) / (1f + exp(raw)) : 0f, Descr = "Berekening van de exponentiated score voor geschiktheid op basis van de raw score. Buiten het studiegebied is de geschiktheid 0.";
		}
		
		Template ReadCoefficientsT
		: Descr = "Template voor het inlezen van de logit coëfficiënten voor verschillende modelvarianten voor verblijfsrecreatie."
		{
			parameter<String> Sectorname;
			parameter<String> Datum;
			parameter<String> Variantname;
			
			unit<UInt32> AdminDomain
			:  StorageName = "='%RSo_DataDir%/Vastgoed/logitcoeff_Has'+Sectorname+'_'+Datum+''+Variantname+'.csv'"
			,  StorageType = "gdal.vect"
			,  StorageReadOnly = "True" 
			{
				attribute<String> parm;
				attribute<String> name := replace(parm, 'construction', 'buildingsite', '_cons', 'Constant', 'buildingsite', 'construction', 'o.', '', ' ', '_','-','');
			}
			
			container Result := for_each_nedv(AdminDomain/name, 'rjoin(rlookup('+quote(lowercase(AdminDomain/name))+', lowercase(AdminDomain/name)), id(AdminDomain), AdminDomain/estimate)[float32]', void, float32), Descr = "Inlezen van de coëfficiënten voor de logit model voor verblijfsrecreatie op basis van de naam van de variabele.";
		}
	}
	
	container Waterberging
	: Descr = "Variant-onafhankelijke ingrediënten voor de waterberging-geschiktheid. De gewogen som per variant wordt bepaald in Templates/Suitabilities/Suitability_Zichtjaar_T/Waterberging."
	{
		attribute<meter>   Diepte     (AdminDomain) := SourceData/Water/Dieptekaart, Descr = "Maximale waterdiepte bij overstroming. Hoe dieper, hoe meer berging (m3) per m2.";
		attribute<float32> Inv_UAI    (AdminDomain) := 1f - /SourceData/Diversen/Per_AdminDomain/UAI_dynamisch, Descr = "Inverse van de urban attractivity index: hoe minder aantrekkelijk voor stedelijke functies, hoe geschikter voor waterberging.";

		attribute<bool>    IsMeer     (AdminDomain) := /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain/Y2022 == /Classifications/Grondgebruik/CBSKlasse/V/Spaarbekken
														|| /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain/Y2022 == /Classifications/Grondgebruik/CBSKlasse/V/Recreatief_binnenwater
														|| /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain/Y2022 == /Classifications/Grondgebruik/CBSKlasse/V/Binnenwater_voor_delfstofwinning
														|| /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain/Y2022 == /Classifications/Grondgebruik/CBSKlasse/V/Vloei_en_slibveld
														|| /SourceData/Grondgebruik/BBG/Dominant/Per_AdminDomain/Y2022 == /Classifications/Grondgebruik/CBSKlasse/V/Overig_binnenwater
														, Descr = "Bestaand binnenwater (selectie van BBG-klassen, exclusief grote wateren als IJsselmeer/Markermeer). Wordt uitgesloten van allocatie zodat bestaand water niet de LU-klasse waterberging krijgt, maar telt wel mee als nabijheidscriterium.";
		attribute<Float32> IsMeer_Nabij (AdminDomain) := ='potential(IsMeer[float32], Distmatrices/Impl_25m/pot'+ModelParameters/Waterberging/MeerNabijPotentiaal+'/PotRange/rev_dist_scaled)', Descr = "Nabijheid van bestaande meren (potentiaal met afstandsverval), tbv clustering van waterberging rond bestaand water.";

		attribute<bool>    IsVeen       (AdminDomain) := SourceData/Bodem/BOFEK/IsVeen_grid, Descr = "Veengebieden volgens BOFEK. De waterbergingsvraag komt voort uit het nat houden van deze gebieden.";
		attribute<Float32> IsVeen_Nabij (AdminDomain) := ='potential(IsVeen[float32], Distmatrices/Impl_25m/pot'+ModelParameters/Waterberging/VeenNabijPotentiaal+'/PotRange/rev_dist_scaled)', Descr = "Nabijheid van veengebieden (potentiaal met afstandsverval), zodat waterberging zoveel mogelijk direct naast of te midden van het veen landt.";

		attribute<float32> Kwel       (AdminDomain) := SourceData/Water/kwel_1996_2003_average > 0f ? SourceData/Water/kwel_1996_2003_average : null_f, Descr = "Kwel in mm/d (positieve waarden uit de kwel-wegzijgingskaart). Hoe meer kwel, hoe geschikter voor waterberging.";
		attribute<float32> Wegzijging (AdminDomain) := SourceData/Water/kwel_1996_2003_average < 0f ? SourceData/Water/kwel_1996_2003_average : null_f, Descr = "Wegzijging in mm/d (negatieve waarden uit de kwel-wegzijgingskaart). Hoe sterker de wegzijging, hoe ongeschikter: het water 'verdwijnt' naar de ondergrond.";

		attribute<float32> Depth_Norm        (AdminDomain) := IsMeer ? 0f : Diepte / rth_element(Diepte, 0.95f), Descr = "Diepte genormaliseerd naar ~0..1 via het 95e percentiel. Bestaande meren uitgesloten.";
		attribute<float32> InvUAI_Norm       (AdminDomain) := IsMeer ? 0f : Inv_UAI, Descr = "Inverse UAI als 0..1 criterium. Bestaande meren uitgesloten.";
		attribute<float32> IsMeer_Nabij_Norm (AdminDomain) := IsMeer ? 0f : IsMeer_Nabij / max(IsMeer_Nabij), Descr = "Meer-nabijheid geschaald naar 0..1. Bestaande meren zelf uitgesloten: nabijheid geldt alleen rond het water, niet erop.";
		attribute<float32> IsVeen_Nabij_Norm (AdminDomain) := IsVeen || IsMeer ? 0f : IsVeen_Nabij / max(IsVeen_Nabij), Descr = "Veen-nabijheid geschaald naar 0..1. Veen zelf en bestaande meren uitgesloten: nabijheid geldt alleen naast het veen, niet erop.";

		attribute<Bool>    IsDiepGenoeg      (AdminDomain) := MakeDefined(Diepte, 0[meter]) >= /ModelParameters/Waterberging/Minimum_Waterschijf, Descr = "Is de waterschijf minimaal ModelParameters/Waterberging/Minimum_Waterschijf? Zo niet, dan geschiktheid 0; geen dieptedata telt als 0 meter.";

		attribute<float32> Kwel_Norm       (AdminDomain) := IsMeer ? 0f : min_elem(MakeDefined(Kwel, 0f), /ModelParameters/Waterberging/Kwel_AfkapBoven) / /ModelParameters/Waterberging/Kwel_AfkapBoven, Descr = "Kwel afgekapt op Kwel_AfkapBoven en lineair geschaald naar 0..1; geen data telt als 0 mm/d. Verhoogt de geschiktheid. Bestaande meren uitgesloten.";
		attribute<float32> Wegzijging_Norm (AdminDomain) := IsMeer ? 0f : max_elem(MakeDefined(Wegzijging, 0f), /ModelParameters/Waterberging/Wegzijging_AfkapOnder) / /ModelParameters/Waterberging/Wegzijging_AfkapOnder, Descr = "Wegzijging afgekapt op Wegzijging_AfkapOnder en lineair geschaald naar 0..1 (1 = sterke wegzijging); geen data telt als 0 mm/d. Wordt als negatieve term van de geschiktheid afgetrokken. Bestaande meren uitgesloten.";
	}
}