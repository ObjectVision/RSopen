////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De kaart die de lijsten van evident benut lezen, opgebouwd uit de BGT, de BRT en de BAG. Zie #872.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container EvidentBenutKaart : using = "Classifications/Grondgebruik;Geography"
, Descr = "Per cel welk gebruik evident is, in de codes van de CBS-klassen, zodat de zeef per sector een vraag stelt: staat de klasse van deze cel op de lijst in VariantParameters/EvidentBenut (#872)? De kaart leest de bodemstatistiek niet.
			Bronnen: de BGT voor wat fysiek ligt, de BRT voor de functie van een terrein en de BAG voor de functie van een gebouw; het functioneel gebied van de BGT is optioneel en in de meeste gemeenten leeg. Een cel
			krijgt een klasse of niets. Metro en sneltram, Bouwterrein, Buitenland, Oorspronkelijk NoData en de landbouwklassen komen op deze kaart niet voor."
{
	parameter<String> FileName := '%LocalDataProjDir%/BaseData/Grondgebruik/EvidentBenutKaart/Klasse_BGT'+/ModelParameters/BGT_file_date+'_BRT'+/ModelParameters/BRT_file_date+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'
	, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

	container BGT
	: Descr = "Per groep BGT-klassen of die groep samen meer dan de halve cel dekt, op 2,5 meter en met dezelfde meerderheidsregel als Templates/VariantData_T/EvidentBenut. De groepen staan in VariantParameters/EvidentBenut/BGT/Kaart."
	{
		unit<UInt32> Src := /BaseData/Grondgebruik/BGT/IsDefinedAndNotNoData;
		unit<UInt8>  Groep : NrOfRows = 10
		{
			attribute<String> name : ['Water','Zee','Hoofdweg','Spoor','Vliegbaan','Groen','Bos','NatuurNat','Woonomgeving','Benut'];
		}
		container PerVlak := for_each_nedv(
			  Groep/name
			, '/VariantParameters/EvidentBenut/BGT/Kaart/'+Groep/name+'[Src/visualisatiecode_rel]'
			, Src
			, Bool
		);
		container Meerderheid := for_each_nedv(
			  Groep/name
			, 'Modus(any(PerVlak/'+Groep/name+'[Src/per_2_5_all/polygon_rel], Src/per_2_5_all/grid_rel), rdc_2_5m/rdc_25m_rel)'
			, AdminDomain
			, Bool
		);
	}

	container BRT
	: Descr = "De vlakken van de BRT die een klasse op deze kaart aanwijzen. Een cel telt als zijn middelpunt in een vlak ligt. De selectie gaat op de tekstkolom en niet op de
				visualisatiecode, want Classifications/Grondgebruik/BRT mist vakantiepark en de code van kazerne is die van kassengebied."
	{
		container Bron := /SourceData/Grondgebruik/BRT/Compleet;

		unit<UInt32> FunctieTabel : NrOfRows = 54, Descr = "Welk type functioneel gebied welke klasse aanwijst; zonder regel in deze tabel doet een type niet mee. Natuurgebied is geen CBS-klasse en telt alleen samen met het terreintype grasland, zie Klasse. Dierentuin en openluchtmuseum staan bij de sociaal-culturele voorzieningen en militair oefengebied bij de openbare, omdat die klassen op de lijst van elke sector staan (#405, #872)."
		{
			attribute<String> type : [
				 'zonnepark','stortplaats','milieustraat'
				,'zandwinning','grindwinning','groeve','gaswinning','oliewinning','zoutwinning','mijn'
				,'vliegveld, luchthaven','zweefvliegveldterrein','emplacement','begraafplaats','erebegraafplaats','grafheuvel'
				,'sportterrein, sportcomplex','golfterrein','tennispark','zwembadcomplex','ijsbaan','crossbaan','circuit','kartingbaan','renbaan','skibaan','slipschool'
				,'volkstuinen'
				,'vakantiepark','bungalowpark','camping, kampeerterrein','caravanpark'
				,'recreatiegebied','attractiepark','jachthaven','openluchttheater'
				,'ziekenhuiscomplex','campus','gebouwencomplex','dierentuin, safaripark','openluchtmuseum'
				,'kazerne, legerplaats','zuiveringsinstallatie','transformatorstation','zenderpark','gebied voor radioastronomie','militair oefengebied, schietterrein'
				,'bedrijventerrein','productie-installatie','werf'
				,'park','botanische tuin','heemtuin'
				,'natuurgebied'
			];
			attribute<String> klasse : [
				 'Zonnepark','Stortplaats','Stortplaats'
				,'Delfstofwinplaats','Delfstofwinplaats','Delfstofwinplaats','Delfstofwinplaats','Delfstofwinplaats','Delfstofwinplaats','Delfstofwinplaats'
				,'Vliegveld','Vliegveld','Spoorterrein','Begraafplaats','Begraafplaats','Begraafplaats'
				,'Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein','Sportterrein'
				,'Volkstuin'
				,'Verblijfsrecreatief_terrein','Verblijfsrecreatief_terrein','Verblijfsrecreatief_terrein','Verblijfsrecreatief_terrein'
				,'Dagrecreatief_terrein','Dagrecreatief_terrein','Dagrecreatief_terrein','Dagrecreatief_terrein'
				,'Sociaal_culturele_voorziening','Sociaal_culturele_voorziening','Sociaal_culturele_voorziening','Sociaal_culturele_voorziening','Sociaal_culturele_voorziening'
				,'Openbare_voorziening','Openbare_voorziening','Openbare_voorziening','Openbare_voorziening','Openbare_voorziening','Openbare_voorziening'
				,'Bedrijfsterrein','Bedrijfsterrein','Bedrijfsterrein'
				,'Stedelijk_groen','Stedelijk_groen','Stedelijk_groen'
				,'Natuurgebied'
			];
		}
		unit<UInt32> TerreinTabel : NrOfRows = 8, Descr = "Hetzelfde voor het type landgebruik in de terreinlaag van de BRT."
		{
			attribute<String> type   : ['spoorbaanlichaam','dodenakker','dodenakker met bos','basaltblokken, steenglooiing','heide','duin','zand','grasland'];
			attribute<String> klasse : ['Spoorterrein','Begraafplaats','Begraafplaats','Semi_verhard_overig_terrein','Open_droog_natuurlijk_terrein','Open_droog_natuurlijk_terrein','Open_droog_natuurlijk_terrein','Grasland'];
		}
		unit<UInt32> FunctieKlassen := unique(FunctieTabel/klasse);
		unit<UInt32> TerreinKlassen := unique(TerreinTabel/klasse);

		unit<UInt32> Functioneel := union_unit(Bron/top10nl_functioneel_gebied_vlak, Bron/top10nl_functioneel_gebied_multivlak)
		{
			attribute<rdc_meter> geometry (poly) := union_data(., Bron/top10nl_functioneel_gebied_vlak/geometry, Bron/top10nl_functioneel_gebied_multivlak/geometry);
			attribute<String>    type            := union_data(., Bron/top10nl_functioneel_gebied_vlak/typefunctioneelgebied, Bron/top10nl_functioneel_gebied_multivlak/typefunctioneelgebied);
			attribute<String>    Klasse_name     := FunctieTabel/klasse[rlookup(lowercase(type), lowercase(FunctieTabel/type))];
		}
		unit<UInt32> Terrein := select_with_org_rel(IsDefined(rlookup(lowercase(Bron/top10nl_terrein_vlak/typelandgebruik), lowercase(TerreinTabel/type))))
		{
			attribute<rdc_meter> geometry (poly) := Bron/top10nl_terrein_vlak/geometry[org_rel];
			attribute<String>    Klasse_name     := TerreinTabel/klasse[rlookup(lowercase(Bron/top10nl_terrein_vlak/typelandgebruik[org_rel]), lowercase(TerreinTabel/type))];
		}

		Template Vergrid_T
		{
			parameter<String> Klasse;
			unit<UInt32>      Vlakken;
			//
			unit<UInt32> Selectie := select_with_org_rel(Vlakken/Klasse_name == Klasse)
			{
				attribute<rdc_meter> geometry (poly) := Vlakken/geometry[org_rel];
			}
			attribute<Bool> Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(Selectie/geometry, AdminDomain));
		}
		container Functie := for_each_ne(FunctieKlassen/values, 'Vergrid_T('+quote(FunctieKlassen/values)+', Functioneel)');
		container Terreinklasse := for_each_ne(TerreinKlassen/values, 'Vergrid_T('+quote(TerreinKlassen/values)+', Terrein)');

		unit<UInt32> Kas := select_with_org_rel(lowercase(Bron/top10nl_gebouw_vlak/typegebouw) == 'kas, warenhuis')
		{
			attribute<rdc_meter> geometry (poly) := Bron/top10nl_gebouw_vlak/geometry[org_rel];
			attribute<Bool>      Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain));
		}
		unit<UInt32> Zee := select_with_org_rel(lowercase(Bron/top10nl_waterdeel_vlak/typewater) == 'zee' || lowercase(Bron/top10nl_waterdeel_vlak/typewater) == 'droogvallend' || lowercase(Bron/top10nl_waterdeel_vlak/typewater) == 'droogvallend (lat)')
		, Descr = "De zee en de droogvallende delen; de platen en slikken zijn in de BGT geen zee en mogen niet als land gelden."
		{
			attribute<rdc_meter> geometry (poly) := Bron/top10nl_waterdeel_vlak/geometry[org_rel];
			attribute<Bool>      Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain));
		}
		attribute<ha> WaterdeelOppervlak (Bron/top10nl_waterdeel_vlak) := area(Bron/top10nl_waterdeel_vlak/geometry, meter2_f64)[ha];
		unit<UInt32> GrootWater := select_with_org_rel(lowercase(Bron/top10nl_waterdeel_vlak/typewater) == 'meer, plas' && WaterdeelOppervlak >= /ModelParameters/EvidentBenutKaart/GrootWaterMinimum)
		, Descr = "De grote meren, die de windsector anders behandelt dan het overige binnenwater; de BGT maakt dat onderscheid niet."
		{
			attribute<rdc_meter> geometry (poly) := Bron/top10nl_waterdeel_vlak/geometry[org_rel];
			attribute<Bool>      Per_AdminDomain (AdminDomain) := IsDefined(poly2grid(geometry, AdminDomain));
		}
	}

	container BAG
	: Descr = "De functie van de gebouwen, uit de basisjaarstand. De BGT-store bevat geen panden en de gebouwlaag van de BRT kent de functie van vrijwel geen enkel gebouw."
	{
		parameter<Float32> MinimumVoetafdruk := float32(/ModelParameters/EvidentBenutKaart/MinimumVoetafdruk), Descr = "De voetafdruk per cel vanaf waar een functie de cel typeert.";
		attribute<Bool> HeeftWoningen   (AdminDomain) := MakeDefined(/BaseData/StartState/StateBasisjaar/State/Wonen/Aantal_Woningen_Totaal[float32], 0f) > 0f;
		attribute<Bool> IsWinkel        (AdminDomain) := MakeDefined(float32(/BaseData/StartState/StateBasisjaar/State/PandFootprint/Detailhandel), 0f) >= MinimumVoetafdruk;
		attribute<Bool> IsVoorziening   (AdminDomain) := MakeDefined(float32(/BaseData/StartState/StateBasisjaar/State/PandFootprint/Overheid_kw_diensten), 0f) >= MinimumVoetafdruk;
	}

	attribute<CBSKlasse> Calc_Klasse (AdminDomain) :=
		switch(
			 case(BGT/Meerderheid/Zee || BRT/Zee/Per_AdminDomain,                                                               CBSKlasse/V/NoordZee)
			,case(BGT/Meerderheid/Water && BRT/GrootWater/Per_AdminDomain,                                                      CBSKlasse/V/IJsselmeer_en_Markermeer)
			,case(BGT/Meerderheid/Water,                                                                                        CBSKlasse/V/Overig_binnenwater)
			,case(BGT/Meerderheid/Spoor || BRT/Functie/Spoorterrein/Per_AdminDomain || BRT/Terreinklasse/Spoorterrein/Per_AdminDomain, CBSKlasse/V/Spoorterrein)
			,case(BGT/Meerderheid/Hoofdweg,                                                                                     CBSKlasse/V/Hoofdweg)
			,case(BGT/Meerderheid/Vliegbaan || BRT/Functie/Vliegveld/Per_AdminDomain,                                           CBSKlasse/V/Vliegveld)
			,case(BRT/Functie/Begraafplaats/Per_AdminDomain || BRT/Terreinklasse/Begraafplaats/Per_AdminDomain,                 CBSKlasse/V/Begraafplaats)
			,case(BGT/Meerderheid/Groen || BRT/Functie/Stedelijk_groen/Per_AdminDomain,                                         CBSKlasse/V/Stedelijk_groen)
			,case(BGT/Meerderheid/Benut,                                                                                         CBSKlasse/V/Hoofdweg)
			,case(BRT/Functie/Zonnepark/Per_AdminDomain,                                                                        CBSKlasse/V/Zonnepark)
			,case(BRT/Functie/Stortplaats/Per_AdminDomain,                                                                      CBSKlasse/V/Stortplaats)
			,case(BRT/Functie/Delfstofwinplaats/Per_AdminDomain,                                                                CBSKlasse/V/Delfstofwinplaats)
			,case(BRT/Terreinklasse/Semi_verhard_overig_terrein/Per_AdminDomain,                                                CBSKlasse/V/Semi_verhard_overig_terrein)
			,case(BRT/Functie/Sportterrein/Per_AdminDomain,                                                                     CBSKlasse/V/Sportterrein)
			,case(BRT/Functie/Volkstuin/Per_AdminDomain,                                                                        CBSKlasse/V/Volkstuin)
			,case(BRT/Functie/Verblijfsrecreatief_terrein/Per_AdminDomain,                                                      CBSKlasse/V/Verblijfsrecreatief_terrein)
			,case(BRT/Functie/Dagrecreatief_terrein/Per_AdminDomain,                                                            CBSKlasse/V/Dagrecreatief_terrein)
			,case(BRT/Functie/Sociaal_culturele_voorziening/Per_AdminDomain || BAG/IsVoorziening,                               CBSKlasse/V/Sociaal_culturele_voorziening)
			,case(BRT/Functie/Openbare_voorziening/Per_AdminDomain,                                                             CBSKlasse/V/Openbare_voorziening)
			,case(BRT/Functie/Bedrijfsterrein/Per_AdminDomain,                                                                  CBSKlasse/V/Bedrijfsterrein)
			,case(BRT/Kas/Per_AdminDomain,                                                                                      CBSKlasse/V/Glastuinbouw)
			,case(BAG/IsWinkel,                                                                                                 CBSKlasse/V/Detailhandel_en_horeca)
			,case(/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain && (BAG/HeeftWoningen || BGT/Meerderheid/Woonomgeving), CBSKlasse/V/Woonterrein)
			,case(BGT/Meerderheid/Bos,                                                                                          CBSKlasse/V/Bos)
			,case(BRT/Terreinklasse/Open_droog_natuurlijk_terrein/Per_AdminDomain,                                              CBSKlasse/V/Open_droog_natuurlijk_terrein)
			,case(BGT/Meerderheid/NatuurNat || (BRT/Functie/Natuurgebied/Per_AdminDomain && BRT/Terreinklasse/Grasland/Per_AdminDomain), CBSKlasse/V/Open_nat_natuurlijk_terrein)
			,null_b[CBSKlasse]
		)
	, Descr = "De volgorde is de voorrang: wat fysiek ligt gaat voor op de functie van het terrein, en de functie van een terrein voor het gebouw en de bedekking. Zo blijft water water binnen een recreatiegebied en een sportveld een sportveld binnen een woonkern.
				De BGT-set Default en het groen komen voor de overige functies, omdat een cel die de set haalt voor elke sector dicht is: Hoofdweg en Stedelijk groen staan op alle lijsten.";

	parameter<String> Regelversie := '872.2', Descr = "Versiesleutel van de rekenregel hierboven en van de volgorde, met het issue van de laatste wijziging; verander hem mee, anders blijft een oude kaart in gebruik.";
	parameter<String> Fingerprint :=
		  'bgt_date='        + /ModelParameters/BGT_file_date
		+ ';brt_date='       + /ModelParameters/BRT_file_date
		+ ';start_year='     + string(/ModelParameters/Model_StartYear)
		+ ';bag_table=BAG_'  + /ModelParameters/BAG_file_date + '_History'
		+ ';study_area='     + /ModelParameters/StudyArea
		+ ';admin_grid='     + /ModelParameters/Advanced/AdminDomain_ref
		+ ';grid_size='      + string(AdminDomain/gridsize)
		+ ';rule='           + Regelversie
		+ ';big_water_ha='   + string(/ModelParameters/EvidentBenutKaart/GrootWaterMinimum)
		+ ';min_footprint='  + string(/ModelParameters/EvidentBenutKaart/MinimumVoetafdruk)
		+ ';bgt_water='      + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Water)), '')
		+ ';bgt_sea='        + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Zee)), '')
		+ ';bgt_road='       + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Hoofdweg)), '')
		+ ';bgt_rail='       + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Spoor)), '')
		+ ';bgt_runway='     + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Vliegbaan)), '')
		+ ';bgt_green='      + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Groen)), '')
		+ ';bgt_forest='     + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Bos)), '')
		+ ';bgt_wet='        + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/NatuurNat)), '')
		+ ';bgt_residential=' + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Woonomgeving)), '')
		+ ';bgt_used='       + asList(string(uint8(/VariantParameters/EvidentBenut/BGT/Kaart/Benut)), '')
		+ ';brt_function='   + asList(BRT/FunctieTabel/type + '>' + BRT/FunctieTabel/klasse, '|')
		+ ';brt_terrain='    + asList(BRT/TerreinTabel/type + '>' + BRT/TerreinTabel/klasse, '|')
	, Descr = "De volledige lijst invoeren die de kaart bepaalt, ook de waarden die al in de bestandsnaam zitten. De nullen-en-enen-reeksen vangen een wijziging binnen een groep BGT-klassen en de twee tabellen een wijziging in de BRT-klassen; start_year en bag_table staan voor de basisjaarstand die de drie BAG-toetsen lezen.";

	container Decoupling := /Templates/DecoupledFile_T(FileName, Fingerprint, 'Write_Klasse');

	attribute<CBSKlasse> Write_Klasse (AdminDomain) := Calc_Klasse, StorageName = "=Decoupling/StorageFile", StorageType = "gdalwrite.grid"
	, Descr = "Schrijft de kaart eenmalig als tif, zonder zijbestand; dat volgt via Make_Klasse.";
	attribute<CBSKlasse> Make_Klasse (AdminDomain) := Write_Klasse, ExplicitSuppliers = "Decoupling/Write_Fingerprint"
	, Descr = "Maakt het bestand en daarna het zijbestand. Vraag dit item en niet Write_Klasse, want alleen langs deze weg ontstaat de fingerprint (#837).";
	attribute<CBSKlasse> Read_Klasse (AdminDomain) : StorageName = "=Decoupling/StorageFile", StorageType = "gdal.grid", StorageReadOnly = "True";

	attribute<CBSKlasse> Klasse (AdminDomain) := = !/ModelParameters/BaseDataOntkoppeld ? 'Calc_Klasse' : Decoupling/MayReuse ? 'Read_Klasse' : 'Make_Klasse'
	, Descr = "Wat de zeef leest. Klopt de fingerprint dan wordt de tif gelezen, anders wordt er gerekend en meteen weggeschreven. Leest de basisjaarstand, dus de eerste keer rekenen hoort na WriteBasedata/Generate_Run3.";
}
