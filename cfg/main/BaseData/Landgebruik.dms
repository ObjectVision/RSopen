////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De basisjaarkaart van het landgebruik, in twee routes achter ModelParameters/Landgebruik_Basis: de CBS-bodemstatistiek
// (BBG) zoals het altijd was, en de stand-administratie op LGN met natuurbeheertypen en de BRP als verbijzondering (#751).
// Daarnaast de functievlaggen uit de bodemstatistiek die de geschiktheden lezen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landgebruik : using = "Classifications/Actor;Classifications/Grondgebruik"
, Descr = "De basisjaarkaart van het landgebruik en de stand-administratie waar die op rust. Zie #751.

			Twee routes, gekozen door ModelParameters/Landgebruik_Basis. De BBG-route is de oude: de CBS-bodemstatistiek
			bepaalt de klasse per cel, met de BRP en LGN als achtervang voor de landbouw. De LGN-route is de
			stand-administratie: LGN als fysieke basis, verbijzonderd met een natuurbeheertype waar LGN natuur of water
			ziet en met een landbouwtype uit de BRP waar LGN landbouw ziet. De uitkomst van die route is Type, een
			LandgebruikType per cel, en LU_Basisjaar_LGN is daar de landgebruikskaart-klasse van.

			LU_Basisjaar is wat de rest van het model leest, in beide routes. De functievlaggen IsWerklocatie tot en met
			IsBouwterrein blijven op de bodemstatistiek staan: die zijn functie, en daar is LGN geen bron voor."
{
	// ---- de bodemstatistiek staat sinds #781 in BaseData/StartState/Bodemstatistiek ----
	attribute<Bool> IsZeehaven    (AdminDomain) := SourceData/Grondgebruik/IBIS/IsZeehaven_AdminDomain, Descr = "Is het een zeehaven volgens IBIS definitie?";

	// ---- landbouw als gewasklasse: de BRP met LGN als achtervang, voor beide routes ----

	attribute<LU_ModelType> LU_Landbouw_BRP (AdminDomain) := Classifications/Landbouw/BRPGewasType/LU_ModelType_rel[SourceData/Landbouw/BRP/BRPGewasType_rel]
	, Descr = "Landbouw klasse op basis van de Basisregistratie Gewaspercelen, het gewas per perceel zoals de teler het opgeeft. Null waar geen perceel ligt en waar de gewascode geen tegenhanger heeft in de klassen van Actor/LandbouwKlasses. De tif draagt de gewascode; de vertaling naar de klasse staat in Classifications/Landbouw/BRPGewasType en werkt dus meteen door.";
	attribute<LU_ModelType> LU_Landbouw_LGN (AdminDomain) := LGNKlasse/LU_ModelType_rel[LGN], Descr = "Landbouw klasse op basis van LGN";
	attribute</Classifications/Actor/LandbouwKlasses> LandbouwK_rel_BRP (AdminDomain) := Classifications/Landbouw/BRPGewasType/LandbouwK_rel[SourceData/Landbouw/BRP/BRPGewasType_rel]
	, Descr = "Dezelfde bron als LU_Landbouw_BRP hierboven, maar als landbouwklasse van de allocatie in plaats van als klasse van de landgebruikskaart.";
	attribute</Classifications/Actor/LandbouwKlasses> LandbouwK_rel_LGN (AdminDomain) := LGNKlasse/LandbouwK_rel[LGN]
	, Descr = "Idem voor de LGN-terugval, op gewasniveau. Niet langs LandbouwType: dat vat aardappelen, bieten en granen samen in bouwland, en LGN kent die drie wel apart.";
	attribute</Classifications/Actor/LandbouwKlasses> LandbouwK_rel     (AdminDomain) := MakeDefined(LandbouwK_rel_BRP, LandbouwK_rel_LGN)
	, IntegrityCheck = "all(IsDefined(this) == IsDefined(Classifications/Actor/LU_ModelType/LandbouwK_rel[LU_Landbouw]) && (!IsDefined(this) || this == Classifications/Actor/LU_ModelType/LandbouwK_rel[LU_Landbouw]))"
	, Descr = "Het gewas van het basisjaar, eerst uit de BRP en anders uit LGN, dezelfde volgorde als LU_Landbouw hieronder maar zonder de omweg langs de klasse van de landgebruikskaart (#803). Dit is wat de landbouwallocatie nodig heeft als herkomst van de transitiekosten.

				De IntegrityCheck eist dat deze kolom hetzelfde zegt als de oude route langs LU_ModelType, en hoort weg samen met die unit.";
	attribute<LU_ModelType> LU_Landbouw     (AdminDomain) := MakeDefined(LU_Landbouw_BRP, LU_Landbouw_LGN)
	, Descr = "Landbouw klasse, eerst op basis van de BRP en anders op basis van LGN.

				Stond tot 4 september 2026 op de voedergewassenkaart uit 2014 in plaats van de BRP; zie #751 voor waarom die eruit ging en wat het scheelt. De vorm is onveranderd gebleven: een perceelsbron die het eerste woord heeft en LGN als achtervang daar waar die bron zwijgt.

				Dit is de gewasklasse, dus aardappelen, bieten, granen. Die detaillering is wat de landbouwallocatie en de landbouwstand in het basisjaar nodig hebben; het stabiele landbouwtype van de stand-administratie staat hieronder in LandbouwType_rel.";

	// ---- de BBG-route ----

	attribute<LU_ModelType> LU_CBS   (AdminDomain) := CBSKlasse/LU_ModelType_rel[Bodemstatistiek/gg_CBS], Descr = "Landgebruik ModelType klasse op basis van CBS grondgebruik";
	attribute<LU_ModelType> LU_Basisjaar_BBG0   (AdminDomain) := MakeDefined(LU_CBS, LU_Landbouw), Descr = "Landgebruik ModelType klasse, eerst op basis van CBS, anders op basis van landbouw";
	attribute<LU_ModelType> LU_Basisjaar_BBG1   (AdminDomain) := IsNull(LU_Basisjaar_BBG0) && Bodemstatistiek/gg_CBS == CBSKlasse/v/Overig_agrarisch_terrein ? LU_ModelType/v/Landbouw_gg_vee : LU_Basisjaar_BBG0, Descr = "Is LU_Basisjaar_BBG0 undefined en als het een overige agrarisch gebruik is volgens CBS, dan grondgebonden vee. Anders LU_Basisjaar_BBG0";
	attribute<LU_ModelType> LU_Basisjaar_BBG (AdminDomain) := MakeDefined(LU_Basisjaar_BBG1, LU_ModelType/v/overig_Totaal), Descr = "De basisjaarkaart langs de BBG-route. Als LU_Basisjaar_BBG1 undefined is, dan overig. Anders LU_Basisjaar_BBG1. Heette tot 4 september 2026 LU_Basisjaar.";

	// ---- de LGN-route: de stand-administratie ----

	attribute<LGNKlasse>      LGN                            (AdminDomain) := SourceData/Grondgebruik/LGN/m25, Descr = "De fysieke bedekking volgens LGN van ModelParameters/LGN_Year, de basis van de stand-administratie.";
	attribute<Bool>           LGN_IsNatuurOfWater            (AdminDomain) := MakeDefined(LU_Landbouw_LGN == LU_ModelType/V/Natuur_Totaal || LU_Landbouw_LGN == LU_ModelType/V/Water_Totaal, FALSE), Descr = "Ziet LGN hier natuur of water? Dan komt het type uit de beheertypenkaart, en anders uit LGN zelf; de BRP komt er niet aan te pas. Beslist op de kolom LU_ModelType van de LGN-tabel en niet op IsNatuur_hedonisch: die hedonische vlag telt riet (42), moerasbos (43) en natuurlijk beheerd agrarisch grasland (45) als natuur, terwijl het model ze als natte teelt en extensieve landbouw kent, net als hun BRP-tegenhangers 331 en 332. Hier tellen ze dus als landbouw.";
	attribute<Bool>           LGN_VerbijzonderMetBeheertype  (AdminDomain) := LGN_IsNatuurOfWater || MakeDefined(LGNKlasse/code[LGN] == 42w || LGNKlasse/code[LGN] == 43w || LGNKlasse/code[LGN] == 45w, FALSE), Descr = "Mag de volledige beheertypeketen deze cel een type geven, dus de bron, de tweede kaart en de heuristiek? Natuur en water volgens LGN, plus drie klassen die LGN op de grens zet: 42 rietvegetatie, 43 bos in moerasgebied en 45 natuurlijk beheerd agrarisch grasland. Het model kent die drie als natte teelt en extensieve landbouw, en zonder beheertype blijven ze dat; ligt er wel een beheertype, dan is het rietmoeras N05, broekbos N14 of kruidenrijk grasland N12 en wint de natuurkant. Gemeten op 2026-09-04: zonder deze regel viel N12.02 kruiden- en faunarijk grasland van 59.555 naar 22.523 ha omdat het onder LGN 45 ligt.

					Twee graslandklassen staan hier bewust NIET bij en worden een regel lager apart behandeld, zie LGN_GraslandMetVastgesteldBeheertype.";

	attribute<Bool>           LGN_GraslandMetVastgesteldBeheertype (AdminDomain) := MakeDefined(LGNKlasse/code[LGN] == 1w || LGNKlasse/code[LGN] == 47w, FALSE), Descr = "De twee graslandklassen waar alleen de VASTGESTELDE beheertypenkaart een type mag geven: 1 agrarisch gras en 47 overig gras. Toegevoegd op 8 september 2026.

					De grond ervoor is dat het Natuurbeheerplan een vaststelling is en geen waarneming: krijgt een perceel provinciale subsidie omdat het een beheertype draagt, dan is het natuur, ook als LGN er gras ziet. Gemeten op 8 september 2026 gaf het NBP binnen het studiegebied 710.508 ha een beheertype, waarvan 93.151 ha op een cel die de kaart natuur noch water noemde; 40.352 ha daarvan lag onder LGN 47 en 28.978 ha onder LGN 1, samen 69.330 ha.

					Waarom deze twee klassen apart staan en niet gewoon in de regel hierboven. Die regel opent de hele keten, dus ook de tweede kaart, en dat is met het NBP als bron de MNP-planpotentieelkaart. Die geeft een type op grond van PLAN en niet van wat er ligt, en op agrarisch gras is dat precies waar zij haar planpotentieel neerlegt. Met de klassen in de regel hierboven kwam de basisjaarnatuur op 681.926 ha uit terwijl er 658.022 werd verwacht, dus lekte er 23.904 ha planpotentieel het basisjaar in; de nieuwe natuur van BAU zakte daardoor naar 30.137 ha, ver onder de 43.902 waar het naartoe moest. Vandaar de beperking tot de vastgestelde kaart.

					Wat er bewust NIET bij komt, en waarom de toets als geheel blijft bestaan: het resterende deel van die 93.151 ha ligt op 10.237 ha gras en bos binnen bebouwd gebied (stadsgroen, LGN 20, 23 en 28), 4.834 ha wegen en spoor (LGN 251, 252 en 253) en 5.608 ha actief bouwland (granen, mais, aardappelen, bieten en overige gewassen). Daar spreekt het beheertypevlak een waarneming tegen die het model elders nodig heeft; een vlak dat over een snelweg heen is getekend maakt die snelweg geen natuur.";

	attribute<INL_Beheertype> Beheertype_Vastgesteld         (AdminDomain) := SourceData/Grondgebruik/NBP/INL_Beheertype_AD, Descr = "De vastgestelde beheertypenkaart, het Natuurbeheerplan 2026 van de provincies. Rechtstreeks gelezen en niet via Beheertype_Bron, want de regel gaat over de officiele vaststelling en niet over welke kaart in ModelParameters als bron is aangewezen.";
	attribute<INL_Beheertype> Beheertype_Vastgesteld_Passend (AdminDomain) := IsDefined(Beheertype_Vastgesteld) && INL_Beheertype/IsWater[Beheertype_Vastgesteld] == LGN_IsWater ? Beheertype_Vastgesteld : null_b[INL_Beheertype], Descr = "Met dezelfde watertoets als de andere twee kaarten.";
	attribute<Bool>           LGN_IsBebouwd                  (AdminDomain) := MakeDefined(LGNKlasse/isBebouwd[LGN], FALSE), Descr = "Ziet LGN hier bebouwing of verharding? Dan blijft dat zo, ook als er een BRP-perceel over ligt, want een erf is geen weiland.";
	attribute<Bool>           LGN_IsWater                    (AdminDomain) := MakeDefined(LU_Landbouw_LGN == LU_ModelType/V/Water_Totaal, FALSE), Descr = "Ziet LGN hier open water (klasse 16 of 17)? De waarneming waar de watertoets van de beheertypen aan wordt gehouden.";
	attribute<Bool>           LGN_IsHoofdinfra               (AdminDomain) := LGNKlasse/code[LGN] == 251w, Descr = "LGN-klasse 251, hoofdinfrastructuur en spoorbaanlichamen. De enige LGN-klasse die op Infra_Totaal hoort; de LGN-tabel geeft haar geen LU_ModelType omdat de BBG-route infra uit de bodemstatistiek haalt.";
	attribute<LU_ModelType>   LGN_Bebouwd_LU                 (AdminDomain) := LGNKlasse/code[LGN] == 18w 
																				? LU_ModelType/V/Wonen_Totaal
																				: MakeDefined(LGNKlasse/code[LGN] == 19w, FALSE) 
																					? LU_ModelType/V/Werken_Totaal
																					: null_b[LU_ModelType], Descr = "De functie van de bebouwing volgens LGN zelf: klasse 18 bebouwing in primair bebouwd gebied is wonen, klasse 19 bebouwing in secundair bebouwd gebied is werken. Dat zijn LGN's eigen woon- en bedrijfsklassen; zie de LGN_code-kolommen bij WonenK en WerkenK in Classifications/Actor.
																														Tot 7 september 2026 stonden hier ook 20 bos en 23 gras in primair bebouwd gebied als wonen, en 28 gras in secundair bebouwd gebied als werken. Dat is er met #783 uit gehaald, want daar werd een locatie-aanduiding een functie: LGN zegt niet dat dat gras woningbouw is, alleen dat het gras binnen bebouwd gebied ligt. Wat het opleverde was scheef. Van de 382.656 ha die zo wonen werd was 68.499 ha werkelijk bebouwing en 314.157 ha bos en gras, en bij werken was van de 125.701 ha maar 7.280 ha bebouwing tegen 118.421 ha gras. De werkenklasse bestond dus voor 94 procent uit gras.
																														Wat er nu gebeurt met dat groen: het valt door naar zijn eigen LGN-klasse en komt in de hoofdklassenkaart van #783 op stedelijk groen terecht, 432.578 ha. De straten, tuinen en parken tellen daarmee niet meer als woon- of werkgebied, en wonen en werken worden wat de BAG- en LISA-standen via de dominantieregel van de landgebruikskaart aanwijzen, plus de bebouwing die LGN zelf ziet. Bebouwing in het buitengebied (26) blijft ook nu buiten deze regel: erven en gehuchten zijn geen woongebied.";

	attribute<Actor/Sector/wo_Landbouw> LGN_Bebouwd_Sector   (AdminDomain) :=
		  LGNKlasse/code[LGN] == 18w                        ? rlookup(lowercase('Wonen'),  lowercase(Actor/Sector/wo_Landbouw/name))
		: MakeDefined(LGNKlasse/code[LGN] == 19w, FALSE)    ? rlookup(lowercase('Werken'), lowercase(Actor/Sector/wo_Landbouw/name))
		: null_b[Actor/Sector/wo_Landbouw]
	, Descr = "Dezelfde uitspraak als LGN_Bebouwd_LU hierboven, maar als sector in plaats van als klasse van de landgebruikskaart: klasse 18 is wonen, klasse 19 is werken, de rest niets.

				Hiermee kan de NL2120-kaart zeggen wie de cel bezet zonder de oude kaart te lezen (#803). Wat het model zelf bouwt komt uit SubSector_rel in de stand; wat er in het basisjaar al stond komt hiervandaan.

				Leeg wanneer de betreffende sector niet in ModelParameters/SectorAllocRegio staat. Dat is geen fout: draait het model zonder wonen, dan is er ook geen woonklasse om naar te wijzen, en valt de cel in de kaart terug op haar landgebruikstype.";

	attribute<INL_Beheertype> Beheertype_Bron                (AdminDomain) := = ModelParameters/Beheertype_Basisjaar_Bron == 'NBP'
																				? 'SourceData/Grondgebruik/NBP/INL_Beheertype_AD'
																				: 'SourceData/Grondgebruik/Natuur/Bron/Landelijk_BAU/INL_Beheertype_rel_AD', Descr = "De beheertypenkaart, nog zonder masker: het Natuurbeheerplan 2026 van de provincies (NBP, de officiele beheertypenkaart, #776) of de MNP-planpotentieelkaart, gekozen in ModelParameters/Beheertype_Basisjaar_Bron. De NVK-kaart huidig van 2020 was tot 5 september 2026 de tweede keuze en is vervallen: het NBP is de bron waar hij van afstamt.";
	attribute<INL_Beheertype> Beheertype_Tweede              (AdminDomain) := = ModelParameters/Beheertype_Basisjaar_Bron == 'NBP'
																				? 'SourceData/Grondgebruik/Natuur/Bron/Landelijk_BAU/INL_Beheertype_rel_AD'
																				: 'SourceData/Grondgebruik/NBP/INL_Beheertype_AD', Descr = "De andere beheertypenkaart, als eerste aanvulling waar de gekozen bron zwijgt. Met het NBP als bron is dat de MNP-kaart: die geeft een type op het planpotentieel, dus ook op natuur die het NBP nog niet kent, en daarna doet de heuristiek hieronder de rest.";
	attribute<INL_Beheertype> Beheertype_Bron_Passend        (AdminDomain) := IsDefined(Beheertype_Bron)   && INL_Beheertype/IsWater[Beheertype_Bron]   == LGN_IsWater ? Beheertype_Bron   : null_b[INL_Beheertype], Descr = "De bron, maar alleen waar haar type de categorie van LGN niet omdraait: geen terrestrisch beheertype op een cel die LGN als water ziet, en geen watertype op een cel die LGN als begroeiing ziet. LGN beslist de categorie, de beheertypenkaart verbijzondert erbinnen; dat is dezelfde regel als bij de landbouwtypen. Zonder deze toets kreeg 28.571 ha open water het beheertype van het omliggende moeras of grasland (de kaarten tekenen een reservaat als een vlak) en 3.957 ha begroeiing een watertype, zie Controle; de watercel werd in de stand natuur in plaats van water, en veenbouwsteen 9b (bestaand water met extra buffer) vond zijn water niet: 26.280 ha realisatie zonder en 27.044 ha met de toets, gemeten 5 september 2026. Dat laatste is weer het getal van 3 september; het tekort van 10.891 ha op de opgave van 37.935 ha dat dan overblijft is het verdelingsverschil uit #660 en geen gevolg van de stand-administratie. Waar de toets een type afkeurt vult de andere kaart of de heuristiek het gat, en die geeft een watercel een watertype.";
	attribute<INL_Beheertype> Beheertype_Tweede_Passend      (AdminDomain) := IsDefined(Beheertype_Tweede) && INL_Beheertype/IsWater[Beheertype_Tweede] == LGN_IsWater ? Beheertype_Tweede : null_b[INL_Beheertype], Descr = "Dezelfde toets op de tweede kaart.";

	attribute<Bool>           IsVeenOfMoerig                 (AdminDomain) := MakeDefined(SourceData/Bodem/BOFEK/IsVeenOfMoerig_grid, FALSE), Descr = "Veen of moerige grond volgens BOFEK 2020, de sleutel tussen de droge en de natte lezing van de heuristiek.";
	attribute<INL_Beheertype> Beheertype_Heuristiek          (AdminDomain) := LU_Landbouw_LGN == LU_ModelType/V/Water_Totaal
																				? MakeDefined(BeheertypeHeuristiek/PerCBS_Water[Bodemstatistiek/gg_CBS], BeheertypeHeuristiek/PerLGN_Droog[LGN])
																				: IsVeenOfMoerig ? BeheertypeHeuristiek/PerLGN_Nat[LGN] : BeheertypeHeuristiek/PerLGN_Droog[LGN], Descr = "Het beheertype dat het meest waarschijnlijk is als geen kaart iets zegt: voor water de functieklasse van de bodemstatistiek (zee, afgesloten zeearm, rivier, plas) en anders zoet of zout volgens LGN; voor de begroeiing de LGN-klasse, nat of droog gelezen naar BOFEK. Zie Classifications/Grondgebruik/BeheertypeHeuristiek voor de tabellen en de aannames.";
	attribute<INL_Beheertype> Beheertype_Aangevuld          (AdminDomain) := MakeDefined(MakeDefined(Beheertype_Bron_Passend, Beheertype_Tweede_Passend), LGN_IsNatuurOfWater ? Beheertype_Heuristiek : null_b[INL_Beheertype]), Descr = "Bron, dan de andere kaart, dan de heuristiek. De heuristiek alleen waar LGN zelf natuur of water ziet: riet, moerasbos en natuurlijk beheerd grasland zonder beheertype blijven landbouw.";
	attribute<INL_Beheertype> Beheertype_Gekozen            (AdminDomain) := = ModelParameters/Beheertype_GatenVullen ? 'Beheertype_Aangevuld' : 'Beheertype_Bron_Passend';
	attribute<INL_Beheertype> Beheertype                    (AdminDomain) := LGN_VerbijzonderMetBeheertype
																				? Beheertype_Gekozen
																				: LGN_GraslandMetVastgesteldBeheertype
																					? Beheertype_Vastgesteld_Passend
																					: null_b[INL_Beheertype], Descr = "Het natuurbeheertype van de bestaande natuur en het bestaande water in het basisjaar. Twee trappen.

					Waar LGN natuur of water ziet, plus riet, moerasbos en natuurlijk grasland, geldt de volledige keten: de bron, de tweede kaart en de heuristiek. Zie LGN_VerbijzonderMetBeheertype.

					Op agrarisch gras en overig gras geldt alleen de vastgestelde beheertypenkaart, het Natuurbeheerplan. Daar is een beheertype een provinciale vaststelling en dus reden om de cel natuur te noemen, maar een plankaart is dat niet: op grasland ligt juist het planpotentieel van de MNP-kaart. Gemeten op 8 september 2026 werd op die twee klassen 93.331 ha natuur, waarvan 68.386 ha uit het NBP en 24.945 ha uit de MNP-kaart; die laatste 24.945 ha is plan en hoort niet in het basisjaar. Zie LGN_GraslandMetVastgesteldBeheertype.

					Dat masker is samen wat de planpotentieelkaart van de MNP tot een huidig-kaart maakt. SourceData/Grondgebruik/Natuur/Basisjaar/INL_Beheertype_rel_AD verwijst hierheen.";

	attribute<LandbouwType>   LandbouwType_rel_BRP          (AdminDomain) := Classifications/Landbouw/BRPGewasType/LandbouwType_rel[SourceData/Landbouw/BRP/BRPGewasType_rel], Descr = "Het landbouwtype uit de BRP, via de kolom LandbouwType in Classifications/Landbouw/BRPGewasType. Null waar geen perceel ligt of het gewas geen landbouw is.";
	attribute<LandbouwType>   LandbouwType_rel_LGN          (AdminDomain) := LGNKlasse/LandbouwType_rel[LGN], Descr = "Het landbouwtype uit LGN, via de kolom LandbouwType in Classifications/Grondgebruik/LGNKlasse. Null voor elke LGN-klasse die geen landbouw is.";
	attribute<LandbouwType>   LandbouwType_rel              (AdminDomain) := LGN_IsNatuurOfWater || LGN_IsBebouwd || IsDefined(Beheertype) ? null_b[LandbouwType] : MakeDefined(LandbouwType_rel_BRP, LandbouwType_rel_LGN), Descr = "Het landbouwtype van de cel: de BRP waar een perceel ligt, anders LGN, en helemaal niets waar LGN natuur, water of bebouwing ziet of waar de beheertypenkaart al een type gaf. LGN beslist dus de categorie en de BRP verbijzondert erbinnen; een perceel dat over een bos of een erf heen is ingetekend maakt daar geen landbouw van.";

	attribute<LandgebruikType>Type                          (AdminDomain) := IsDefined(Beheertype) 
																				? invert(LandgebruikType/INL_Beheertype_rel)[Beheertype]
																				: IsDefined(LandbouwType_rel)
																					? invert(LandgebruikType/LandbouwType_rel)[LandbouwType_rel]
																					: invert(LandgebruikType/LGNKlasse_rel)[LGN], Descr = "De stand-administratie in het basisjaar: een LandgebruikType per cel. Beheertype gaat voor, dan landbouwtype, dan de LGN-klasse zelf. Elke cel met een LGN-waarde krijgt zo precies een type. Dit is de laag die als stand mee de allocatie in hoort te gaan en waar de indicatoren hun bron in vinden; zie Classifications/Grondgebruik/LandgebruikType voor wat erin zit en wat er bewust niet in zit.";

	attribute<LU_ModelType>   LU_Basisjaar_LGN0            (AdminDomain) := LGN_IsHoofdinfra
																				? LU_ModelType/V/Infra_Totaal
																				: IsDefined(LGN_Bebouwd_LU)
																					? LGN_Bebouwd_LU
																					: MakeDefined(LandgebruikType/IsLandbouw[Type], FALSE)
																						? MakeDefined(LU_Landbouw, LandgebruikType/LU_ModelType_rel[Type])
																						: LandgebruikType/LU_ModelType_rel[Type], Descr = "De landgebruikskaart-klasse van de stand-administratie. Op landbouwcellen de gewasklasse uit LU_Landbouw, want de landbouwstand en de landbouwallocatie rekenen in gewassen; elders de klasse van het type zelf. Hoofdinfrastructuur wordt Infra en het bebouwde gebied van LGN wordt wonen of werken naar zijn functie, zie LGN_Bebouwd_LU. Wat overblijft aan bebouwing (buitengebied, infrastructuur anders dan hoofdwegen) heeft geen LU_ModelType en blijft hier leeg: de dominantieregel van de landgebruikskaart zet daar wonen, werken of verblijfsrecreatie neer op gezag van de BAG- en LISA-standen.";
	attribute<LU_ModelType>   LU_Basisjaar_LGN             (AdminDomain) := MakeDefined(LU_Basisjaar_LGN0, LU_ModelType/v/overig_Totaal), Descr = "De basisjaarkaart langs de LGN-route, met Overig waar geen klasse volgt, net als in de BBG-route.";
	attribute<LU_ModelType>   LU_Basisjaar                 (AdminDomain) := LU_Basisjaar_LGN, Descr = "De basisjaarkaart van het landgebruik die de rest van het model leest.";

	container Controle
	: Descr = "De controlegetallen van de stand-administratie en van de twee routes naast elkaar. Bedoeld om te lezen voordat Landgebruik_Basis omgaat, en om te zien wat de beheertypenkaart wel en niet dekt."
	{
		attribute<Bool> SA (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain;

		parameter<Ha> Areaal_Studiegebied      := sum(SA ? AdminDomain/NrHaPerCell : 0[Ha]);
		parameter<Ha> Areaal_MetBeheertype     := sum(SA && LandgebruikType/Deel_rel[Type] == LandgebruikType/Deel/V/Beheertype ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen waarvan het type een natuurbeheertype is.";
		parameter<Ha> Areaal_MetLandbouwtype   := sum(SA && LandgebruikType/Deel_rel[Type] == LandgebruikType/Deel/V/Landbouw   ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen waarvan het type een landbouwtype is.";
		parameter<Ha> Areaal_UitLGN            := sum(SA && LandgebruikType/Deel_rel[Type] == LandgebruikType/Deel/V/LGN        ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen die op de LGN-klasse zelf staan: bebouwing, infrastructuur, en natuur en water zonder beheertype.";
		parameter<Ha> Areaal_ZonderType        := sum(SA && !IsDefined(Type) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Hoort nul te zijn binnen het studiegebied, want LGN dekt het hele land.";
		parameter<Ha> Areaal_NatuurOfWater_LGN := sum(SA && LGN_IsNatuurOfWater ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Natuur en water volgens LGN.";
		parameter<Ha> Areaal_NatuurOfWater_ZonderBeheertype := sum(SA && LGN_IsNatuurOfWater && !IsDefined(Beheertype) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Daarvan het deel waar de beheertypenkaart zwijgt. Dit is het gat dat een betere beheertypenbron moet dichten.";
		parameter<Ha> Areaal_Beheertype_UitBron       := sum(SA && IsDefined(Beheertype) && IsDefined(Beheertype_Bron_Passend) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Beheertype uit de gekozen bron.";
		parameter<Ha> Areaal_Beheertype_UitTweede     := sum(SA && IsDefined(Beheertype) && !IsDefined(Beheertype_Bron_Passend) && IsDefined(Beheertype_Tweede_Passend) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Aangevuld uit de andere beheertypenkaart.";
		parameter<Ha> Areaal_Beheertype_UitHeuristiek := sum(SA && IsDefined(Beheertype) && !IsDefined(Beheertype_Bron_Passend) && !IsDefined(Beheertype_Tweede_Passend) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Aangevuld uit de heuristiek. Nul met Beheertype_GatenVullen uit.";
		parameter<Ha> Areaal_Bron_LandOpWater  := sum(SA && LGN_IsWater && IsDefined(Beheertype_Bron) && !INL_Beheertype/IsWater[Beheertype_Bron] ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waar de bron een terrestrisch beheertype legt op een cel die LGN als water ziet; die typen keurt Beheertype_Bron_Passend af.";
		parameter<Ha> Areaal_Bron_WaterOpLand  := sum(SA && !LGN_IsWater && LGN_VerbijzonderMetBeheertype && IsDefined(Beheertype_Bron) && INL_Beheertype/IsWater[Beheertype_Bron] ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het omgekeerde: een watertype op een cel die LGN als begroeiing ziet.";
		parameter<Ha> Areaal_LandbouwUitBRP    := sum(SA && IsDefined(LandbouwType_rel) && IsDefined(LandbouwType_rel_BRP) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Landbouwtype dat van de BRP komt.";
		parameter<Ha> Areaal_LandbouwUitLGN    := sum(SA && IsDefined(LandbouwType_rel) && !IsDefined(LandbouwType_rel_BRP) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Landbouwtype dat van de LGN-achtervang komt.";
		parameter<Ha> Areaal_BRPOverruledDoorLGN := sum(SA && IsDefined(LandbouwType_rel_BRP) && (LGN_IsNatuurOfWater || LGN_IsBebouwd || IsDefined(Beheertype)) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "BRP-percelen waar LGN natuur, water of bebouwing ziet en het perceel dus niet telt. Grotendeels code 335 natuurterreinen en natuurlijk grasland op natuurgrond.";
		parameter<Ha> Areaal_Verschil_BBG_LGN  := sum(SA && LU_Basisjaar_BBG != LU_Basisjaar_LGN ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Waar de twee routes een andere LU_ModelType geven. Dit is de omvang van de omschakeling.";

		parameter<String> Tabel_Kerngetallen :=
			  'post;ha'
			+ '|studiegebied;'                        + string(Areaal_Studiegebied)
			+ '|type_uit_beheertypenkaart;'           + string(Areaal_MetBeheertype)
			+ '|type_uit_landbouwtypologie;'          + string(Areaal_MetLandbouwtype)
			+ '|type_uit_lgn;'                        + string(Areaal_UitLGN)
			+ '|zonder_type;'                         + string(Areaal_ZonderType)
			+ '|natuur_of_water_volgens_lgn;'         + string(Areaal_NatuurOfWater_LGN)
			+ '|daarvan_zonder_beheertype;'           + string(Areaal_NatuurOfWater_ZonderBeheertype)
			+ '|beheertype_uit_bron;'                 + string(Areaal_Beheertype_UitBron)
			+ '|beheertype_uit_tweede_kaart;'         + string(Areaal_Beheertype_UitTweede)
			+ '|beheertype_bron_land_op_water;' + string(Areaal_Bron_LandOpWater)
			+ '|beheertype_bron_water_op_land;' + string(Areaal_Bron_WaterOpLand)
			+ '|beheertype_uit_heuristiek;'           + string(Areaal_Beheertype_UitHeuristiek)
			+ '|landbouwtype_uit_brp;'                + string(Areaal_LandbouwUitBRP)
			+ '|landbouwtype_uit_lgn;'                + string(Areaal_LandbouwUitLGN)
			+ '|brp_perceel_overruled_door_lgn;'      + string(Areaal_BRPOverruledDoorLGN)
			+ '|verschil_bbg_lgn_route;'              + string(Areaal_Verschil_BBG_LGN)
		, StorageName = "='%LocalDataProjDir%/Diagnose/751_kerngetallen.txt'", StorageType = "str"
		, Descr = "De kerngetallen van de stand-administratie in het basisjaar, als een tabel om op te vragen.";

		attribute<Ha> Areaal_PerType    (LandgebruikType) := sum(SA ? AdminDomain/NrHaPerCell : 0[Ha], Type), Descr = "Het areaal per type in het basisjaar.";
		attribute<Ha> Areaal_PerLU_BBG  (LU_ModelType)    := sum(SA ? AdminDomain/NrHaPerCell : 0[Ha], LU_Basisjaar_BBG), Descr = "De basisjaarkaart per klasse langs de BBG-route.";
		attribute<Ha> Areaal_PerLU_LGN  (LU_ModelType)    := sum(SA ? AdminDomain/NrHaPerCell : 0[Ha], LU_Basisjaar_LGN), Descr = "Idem langs de LGN-route.";

		parameter<String> Tabel_PerLU :=
			  'lu_modeltype;ha_bbg;ha_lgn|'
			+ AsList(LU_ModelType/name + ';' + string(Areaal_PerLU_BBG) + ';' + string(Areaal_PerLU_LGN), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/751_routes_per_lu.txt'", StorageType = "str"
		, Descr = "De twee routes naast elkaar per klasse. Schrijft naar LocalData/Diagnose zodat de getallen na een run terug te lezen zijn.";
		parameter<String> Tabel_PerType :=
			  'landgebruiktype;ha|'
			+ AsList(LandgebruikType/name + ';' + string(Areaal_PerType), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/751_areaal_per_type.txt'", StorageType = "str";
	}

	container NabijGrootWaterInBBG
	{
		attribute<Bool>    IsGrootWater    (AdminDomain) := /BaseData/StartState/Bodemstatistiek/IsGrootWater, Descr = "Is het groot water volgens CBS definitie?";
		attribute<Float32> Smoothed_srcsrc (AdminDomain) := potential(IsGrootWater[float32], Distmatrices/Impl_25m/pot500m/PotRange/rev_dist_scaled ), Descr = "Smoothing van groot water met een bereik van 500m";
		attribute<Float32> Smoothed0       (AdminDomain) := Smoothed_srcsrc * BaseData/Omgeving/OV_Reistijd/TotRailHalte/Smoothed, Descr = "Vermenigvuldigen met nabijheid treinstation om gebieden te benadrukken die zowel nabij groot water als nabij een treinstation liggen";
		attribute<Float32> Smoothed        (AdminDomain) := Smoothed0  / max(Smoothed0), Descr = "Normaliseren op de maximale waarde";
	}
}
