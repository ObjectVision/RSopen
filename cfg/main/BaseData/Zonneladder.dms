// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the
// container following this one checks for this. Laadt via #include: NoRegret, ZorgvuldigInpassen,
// CombiGevoeligeLocaties, GrootschaligEnkelvoudig.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Zonneladder : using = "Units;ModelParameters/zon;Geography"
{
	// Wat doen we niet:
	// > Daken: buiten scope/resolutie van deze studie; Importeren we uit andere studie
	// > Verweesde (bedrijven)terreinen
	// > pauzelandschappen
	// > dijktaluds: waarom niet?
	// > stads/dorpsrand: irrelevant
	// > recr gebieden. idem
	
	unit<UInt32> LadderTreden := /Classifications/Zonneladder/LadderTreden;
	
	parameter<String> BBG_Bron := uint32(ModelParameters/BBG_Year) >= 2020 ? 'src' : 'BBG_Reeks_1996_2017'; 
	
	container PerAllocDomain
	{
		container Calc
		{
			attribute<Bool> Overkappingen      (AllocDomain) := NoRegret/OnbenutBebouwd/UitBGT_overkapping/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> Parkeerterreinen   (AllocDomain) := NoRegret/OnbenutBebouwd/UitBGT_parkeervlak/Result/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> Vuilstortplaatsen  (AllocDomain) := NoRegret/OnbenutBebouwd/UitBRT_stortplaatsen/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> BassinsGltb        (AllocDomain) := NoRegret/OnbenutBebouwd/Bassins/Bassin_op_Glastuinbouw/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> Geluidsschermen    (AllocDomain) := NoRegret/OpInfraWerken/Geluidsschermen/Combine_all_layers/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> Vliegvelden        (AllocDomain) := NoRegret/OpInfraWerken/RondVliegvelden/Combine_all_layers/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> Wegbermen          (AllocDomain) := ZorgvuldigInpassen/LangsInfraWerken/UitBGT_bermen/union_domain/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> IndustrielePlassen (AllocDomain) := ZorgvuldigInpassen/IndustrielePlassen/UitBBG_watermetdelfstoffen/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> AnderePlassen      (AllocDomain) := CombiGevoeligeLocaties/AnderePlassen/UitBBG_watermetrecreatie/Union/unioned_domain/Defined_Per_AllocDomain;
			attribute<Bool> Landbouw           (AllocDomain) := GrootschaligEnkelvoudig/Landbouw/UitBBG_overige_agrarisch_gebruik/Union/unioned_domain/Defined_Per_AllocDomain;
		}
		
		container Write := 
			for_each_neidvat(
				/Classifications/Zonneladder/LadderTreden/name
				, 'Calc/'+/Classifications/Zonneladder/LadderTreden/name
				, 'not(all(IsNull(this)))'
				, AllocDomain
				, bool
				, '%LocalDataProjDir%/BaseData/Grondgebruik/ZonneLadder/'+/Classifications/Zonneladder/LadderTreden/name+'_'+/ModelParameters/StudyArea+'.tif'
				, 'tif'
			);
			
		container Read_UNCHECKED := 
			for_each_ndvat(
				/Classifications/Zonneladder/LadderTreden/name
				, AllocDomain
				, bool
				, '%LocalDataProjDir%/BaseData/Grondgebruik/ZonneLadder/'+/Classifications/Zonneladder/LadderTreden/name+'_'+/ModelParameters/StudyArea+'.tif'
				, 'tif'
			), Descr = "This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the container following this one checks for this.";
			
		container Read := 
			for_each_neidv(
				/Classifications/Zonneladder/LadderTreden/name
				, 'Read_UNCHECKED/'+/Classifications/Zonneladder/LadderTreden/name
				, 'not(all(IsNull(this)))'
				, AllocDomain
				, bool
			);
			
		parameter<String> Fingerprint :=
			  'bgt_date='     + /ModelParameters/BGT_file_date
			+ ';brt_date='    + /ModelParameters/BRT_file_date
			+ ';bbg_year='    + /ModelParameters/BBG_Year
			+ ';study_area='  + /ModelParameters/StudyArea
			+ ';alloc_grid='  + /ModelParameters/Advanced/AllocDomain_ref
			+ ';step_count='  + string(#/Classifications/Zonneladder/LadderTreden)
			+ ';steps='       + asList(/Classifications/Zonneladder/LadderTreden/name, ',')
		, Descr = "De invoeren die de laddertreden bepalen. De definities achter de treden staan in NoRegret.dms, ZorgvuldigInpassen.dms, CombiGevoeligeLocaties.dms en GrootschaligEnkelvoudig.dms, en die leunen op de BGT, de BRT en de BBG.";

		parameter<String> AnchorFile := '%LocalDataProjDir%/BaseData/Grondgebruik/ZonneLadder/'+first(/Classifications/Zonneladder/LadderTreden/name)+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "De treden worden in een keer samen geschreven, dus een van hen volstaat als peilstok voor de vraag of de set er staat.";

		container Decoupling := Templates/DecoupledFile_T(AnchorFile, Fingerprint);

		container Result := = ModelParameters/BaseDataOntkoppeld && Decoupling/MayReuse ? 'Read' : 'Write'
		, Descr = "Leest de treden alleen terug wanneer ze er staan en de fingerprint nog klopt. Anders wordt er gerekend en geschreven.
					Dat lost een stille valkuil op: de trigger in WriteBaseData.dms staat uitgecommentarieerd terwijl deze leeskant wel gebruikt werd, dus verwees het model naar bestanden die niemand aanmaakte.
					LET OP bij het weer aanzetten van de zonsector: het schrijven van het zijbestand met de fingerprint hangt aan de Generate in WriteBaseData.dms en niet aan de treden zelf, want dit is een for_each-container en ExplicitSuppliers op containerniveau lift niet mee wanneer je een los kind opvraagt. Vraag je een trede rechtstreeks op zonder die Generate, dan wordt hij wel gerekend en geschreven maar komt er geen zijbestand, en rekent de volgende run hem opnieuw uit."
		{
			attribute<Bool> Totaal (AllocDomain) := const(TRUE, AllocDomain);
		}
	}
	
	#include <NoRegret.dms>
	#include <ZorgvuldigInpassen.dms>
	#include <CombiGevoeligeLocaties.dms>
	#include <GrootschaligEnkelvoudig.dms>
}