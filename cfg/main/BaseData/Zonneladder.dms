// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the
// container following this one checks for this. Laadt via #include: NoRegret, ZorgvuldigInpassen,
// CombiGevoeligeLocaties, GrootschaligEnkelvoudig.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Zonneladder : using = "Units;ModelParameters/zon;Geography"
{
	// Wat doen we niet:
	// > Daken: buiten scope/resolutie van deze studie; Importeren we uit andere studie
	// > Verweesde (bedrijven)terreinen
	// > pauzelandschappen
	// > dijktaluds: waarom niet?
	// > stads/dorpsrand: irrelevant
	// > recr gebieden. idem
	
	unit<UInt32> LadderTreden := /Classifications/Zonneladder/LadderTreden;
	
	parameter<String> BBG_Bron := uint32(ModelParameters/BBG_Year) >= 2020 ? 'src' : 'BBG_Reeks_1996_2017'; 
	
	container PerAdminDomain
	{
		container Calc
		{
			attribute<Bool> Overkappingen      (AdminDomain) := NoRegret/OnbenutBebouwd/UitBGT_overkapping/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> Parkeerterreinen   (AdminDomain) := NoRegret/OnbenutBebouwd/UitBGT_parkeervlak/Result/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> Vuilstortplaatsen  (AdminDomain) := NoRegret/OnbenutBebouwd/UitBRT_stortplaatsen/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> BassinsGltb        (AdminDomain) := NoRegret/OnbenutBebouwd/Bassins/Bassin_op_Glastuinbouw/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> Geluidsschermen    (AdminDomain) := NoRegret/OpInfraWerken/Geluidsschermen/Combine_all_layers/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> Vliegvelden        (AdminDomain) := NoRegret/OpInfraWerken/RondVliegvelden/Combine_all_layers/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> Wegbermen          (AdminDomain) := ZorgvuldigInpassen/LangsInfraWerken/UitBGT_bermen/union_domain/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> IndustrielePlassen (AdminDomain) := ZorgvuldigInpassen/IndustrielePlassen/UitBBG_watermetdelfstoffen/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> AnderePlassen      (AdminDomain) := CombiGevoeligeLocaties/AnderePlassen/UitBBG_watermetrecreatie/Union/unioned_domain/Defined_Per_AdminDomain;
			attribute<Bool> Landbouw           (AdminDomain) := GrootschaligEnkelvoudig/Landbouw/UitBBG_overige_agrarisch_gebruik/Union/unioned_domain/Defined_Per_AdminDomain;
		}
		
		container Write := 
			for_each_neidvat(
				/Classifications/Zonneladder/LadderTreden/name
				, 'Calc/'+/Classifications/Zonneladder/LadderTreden/name
				, 'not(all(IsNull(this)))'
				, AdminDomain
				, bool
				, '%LocalDataProjDir%/BaseData/Grondgebruik/ZonneLadder/'+/Classifications/Zonneladder/LadderTreden/name+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+Decoupling/StorageSuffix+'.tif'
				, 'tif'
			);
			
		unit<UInt32> GelezenTreden := select_with_attr_by_cond(/Classifications/Zonneladder/LadderTreden, const(Decoupling/MayReuse, /Classifications/Zonneladder/LadderTreden))
		, Descr = "De treden die Read_UNCHECKED en Read teruglezen: alle, als de set er staat met een kloppende fingerprint, en anders geen, zodat er geen lezer is van een bestand dat er niet staat (pbl-nl/model-RSopen#53).";

		container Read_UNCHECKED := 
			for_each_ndvat(
				GelezenTreden/name
				, AdminDomain
				, bool
				, '%LocalDataProjDir%/BaseData/Grondgebruik/ZonneLadder/'+GelezenTreden/name+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+Decoupling/StorageSuffix+'.tif'
				, 'tif'
			), Descr = "This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the container following this one checks for this.";
			
		container Read := 
			for_each_neidv(
				GelezenTreden/name
				, 'Read_UNCHECKED/'+GelezenTreden/name
				, 'not(all(IsNull(this)))'
				, AdminDomain
				, bool
			);
			
		parameter<String> Fingerprint :=
			  'bgt_date='     + /ModelParameters/BGT_file_date
			+ ';brt_date='    + /ModelParameters/BRT_file_date
			+ ';bbg_year='    + /ModelParameters/BBG_Year
			+ ';study_area='  + /ModelParameters/StudyArea
			+ ';admin_grid='  + /ModelParameters/Advanced/AdminDomain_ref
			+ ';step_count='  + string(#/Classifications/Zonneladder/LadderTreden)
			+ ';steps='       + asList(/Classifications/Zonneladder/LadderTreden/name, ',')
		, Descr = "De invoeren die de laddertreden bepalen. De definities achter de treden staan in NoRegret.dms, ZorgvuldigInpassen.dms, CombiGevoeligeLocaties.dms en GrootschaligEnkelvoudig.dms, en die leunen op de BGT, de BRT en de BBG.";

		parameter<String> AnchorFile := '%LocalDataProjDir%/BaseData/Grondgebruik/ZonneLadder/'+first(/Classifications/Zonneladder/LadderTreden/name)+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'
		, Descr = "De treden worden in een keer samen geschreven, dus een van hen volstaat als peilstok voor de vraag of de set er staat. Het pad zonder hash; elke trede krijgt de hash voor de extensie, via Decoupling/StorageSuffix.";

		parameter<String> Writers := asList('Write/' + /Classifications/Zonneladder/LadderTreden/name, ';')
		, Descr = "De treden die de tifs schrijven. Ze staan als leverancier onder het zijbestand, zodat dat pas ontstaat als de hele set er staat (#837).";
		container Decoupling := Templates/DecoupledFile_T(AnchorFile, Fingerprint, Writers);

		container Result := = ModelParameters/BaseDataOntkoppeld && Decoupling/MayReuse ? 'Read' : 'Write'
		, Descr = "Leest de treden alleen terug wanneer ze er staan en de fingerprint klopt, en rekent en schrijft ze anders. Let op bij het weer aanzetten van de zonsector: het zijbestand met de fingerprint
					hangt aan de Generate in WriteBaseData.dms en niet aan de treden zelf, want dit is een for_each-container en ExplicitSuppliers op containerniveau lift niet mee wanneer je een los kind
					opvraagt; een trede die rechtstreeks wordt opgevraagd wordt wel gerekend en geschreven, maar zonder zijbestand, en de volgende run rekent hem opnieuw. Die Generate vraagt alleen nog
					het zijbestand, want de treden staan als Writers onder Decoupling en worden daar als leverancier van bijgewerkt (#837)."
		{
			attribute<Bool> Totaal (AdminDomain) := const(TRUE, AdminDomain);
		}
	}
	
	#include <NoRegret.dms>
	#include <ZorgvuldigInpassen.dms>
	#include <CombiGevoeligeLocaties.dms>
	#include <GrootschaligEnkelvoudig.dms>
}