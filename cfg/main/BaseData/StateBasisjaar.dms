////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Hier wordt de stand per subsector in het basisjaar bepaald, weggeschreven en ingeladen
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container StateBasisjaar : using = "Classifications/modellering"
, Descr = "Hier wordt de stand per subsector in het basisjaar bepaald, weggeschreven en ingeladen"
{
	container State := =ModelParameters/BaseDataOntkoppeld ? 'Read' : 'Write';

	// #776: de twee standtifs van het landgebruik (Type en JaarVerandering) hangen anders dan de andere standbestanden
	// aan een klein en opsombaar stel invoer: de beheertypenkaart en haar bron, de LGN-, BRP- en BBG-jaargang, de
	// koppelkolommen van de classificaties en de heuristiek. Dat stel staat hier als fingerprint, zodat een andere
	// beheertypenkaart de stand-tif niet stil laat staan: de leeskant faalt dan hard tot WriteBasedata run 2 opnieuw
	// is gedraaid. De overige standbestanden hebben bewust geen fingerprint, zie de skill rs-fingerprints.
	parameter<String> FileName_Landgebruik_Type := '%LocalDataProjDir%/BaseData/StandBasisjaar/' + /Classifications/Actor/LandgebruikK/StandVar_path[value(0, /Classifications/Actor/LandgebruikK)] + '_' + /ModelParameters/StudyArea + '.tif'
	, IntegrityCheck = "/Classifications/Actor/LandgebruikK/name[value(0, /Classifications/Actor/LandgebruikK)] == 'Type'"
	, Descr = "Hetzelfde pad als de for_each hieronder samenstelt uit StandVar_Prep/path, uit dezelfde bron (LandgebruikK/StandVar_path), zodat een hernoeming daar het zijbestand niet van de tif losmaakt.";
	parameter<String> Fingerprint_Landgebruik :=
		  'beheertype_bron='   + /ModelParameters/Beheertype_Basisjaar_Bron
		+ ';gaten_vullen='     + string(/ModelParameters/Beheertype_GatenVullen)
		+ ';landgebruik_basis=' + /ModelParameters/Landgebruik_Basis
		+ ';beheertype_passend=lgn_categorie'
		+ ';nbp='              + /SourceData/Grondgebruik/NBP/Fingerprint_INL_Beheertype_AD
		+ ';mnp='              + PropValue(/SourceData/Grondgebruik/Natuur/Bron/Landelijk_BAU/Write_NL2120_MNP_BAU_INL_beheertypen_25m, 'StorageName')
		+ ';lgn_year='         + /ModelParameters/LGN_Year
		+ ';brp='              + /SourceData/Landbouw/BRP/Fingerprint_Gewascode
		+ ';bbg_year='         + /ModelParameters/BBG_Year
		+ ';start_year='       + string(/ModelParameters/Model_StartYear)
		+ ';study_area='       + /ModelParameters/StudyArea
		+ ';admin_domain='     + /ModelParameters/Advanced/AdminDomain_ref
		+ ';landgebruik_set='  + AsList(/Classifications/Grondgebruik/LandgebruikType/name, ',')
		+ ';lgn_lu='           + AsList(MakeDefined(string(/Classifications/Grondgebruik/LGNKlasse/LU_ModelType_rel), 'null'), ',')
		+ ';lgn_bebouwd='      + AsList(string(/Classifications/Grondgebruik/LGNKlasse/isBebouwd), ',')
		+ ';lgn_landbouwtype=' + AsList(MakeDefined(string(/Classifications/Grondgebruik/LGNKlasse/LandbouwType_rel), 'null'), ',')
		+ ';brp_landbouwtype=' + AsList(MakeDefined(string(/Classifications/Landbouw/BRPGewasType/LandbouwType_rel), 'null'), ',')
		+ ';heuristiek_droog=' + AsList(MakeDefined(string(/Classifications/Grondgebruik/BeheertypeHeuristiek/PerLGN_Droog), 'null'), ',')
		+ ';heuristiek_nat='   + AsList(MakeDefined(string(/Classifications/Grondgebruik/BeheertypeHeuristiek/PerLGN_Nat), 'null'), ',')
		+ ';heuristiek_water=' + AsList(MakeDefined(string(/Classifications/Grondgebruik/BeheertypeHeuristiek/PerCBS_Water), 'null'), ',')
	, Descr = "Wat de basisjaarstand van het landgebruik bepaalt. De bronnen zelf (de NBP-tif en de BRP-tif via hun eigen fingerprint, de MNP-kaart via haar pad), de schakelaars, en de koppelkolommen als reeks omdat een wijziging binnen een tabel de naamlijst niet verandert; nulls staan als het woord null in de reeks, anders verliest een verplaatsing naar een lege rij haar positie. De BOFEK-veenkaart die de natte lezing van de heuristiek kiest zit er niet in; die bron wisselt niet van jaargang.

				Twee kanttekeningen. landgebruik_basis bepaalt Type en JaarVerandering niet (die lopen altijd langs LGN), maar staat er als hefboom: de landbouwstandtifs lezen LU_Basisjaar en dragen geen fingerprint, dus als de schakelaar omgaat dwingt de leestoets op Landgebruik/Type run 2 af en die ververst ze mee. En mnp= vangt alleen het pad van de 25m-tif op E:, niet haar inhoud: die tif draagt rijnummers van INL_Beheertype en is schrijf-eenmaal, dus een rij erbij in die classificatie maakt hem stil verkeerd zonder dat deze fingerprint dat ziet.";
	container Decoupling_Landgebruik := /Templates/DecoupledFile_T(FileName_Landgebruik_Type, Fingerprint_Landgebruik)
	, Descr = "De fingerprintcontrole voor Landgebruik/Type en JaarVerandering samen; het zijbestand staat naast de Type-tif. Vraag Explanation op als Read/Landgebruik/Type op zijn IntegrityCheck faalt.";
	
	container Read_UNCHECKED :=
		for_each_ndvna(
			StandVar_Prep/path
			, AdminDomain
			, StandVar_Prep
			, StandVar_Prep/unit_name
			, '%LocalDataProjDir%/BaseData/StandBasisjaar/'+StandVar_Prep/path+'_'+/ModelParameters/StudyArea+'.tif'
		), StorageReadOnly = "TRUE", Descr = "This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the container following this one checks for this."
	{
		container Wonen
		{
			attribute<meter2> Footprint (AdminDomain) : StorageName = "='%LocalDataProjDir%/BaseData/StandBasisjaar/Wonen/Footprint_'+/ModelParameters/StudyArea+'.tif'";
		}
		container Verblijfsrecreatie
		{
			attribute<meter2> Footprint (AdminDomain) : StorageName = "='%LocalDataProjDir%/BaseData/StandBasisjaar/Verblijfsrecreatie/Footprint_'+/ModelParameters/StudyArea+'.tif'";
		}
	}
	
	container Read :=
		for_each_neidvn(
			StandVar_Prep/path
			, 'Read_UNCHECKED/'+StandVar_Prep/path
			, StandVar_Prep/IsLandbouw || StandVar_Prep/IsWaterberging ? ''
				: lowercase(StandVar_Prep/Sector_name) == lowercase('Landgebruik') ? 'not(all(IsNull(this))) && /BaseData/StartState/StateBasisjaar/Decoupling_Landgebruik/IsValid'
				: 'not(all(IsNull(this))) && not(all(IsZero(this)))'
			, AdminDomain
			, StandVar_Prep
			, StandVar_Prep/unit_name
		), Descr = "Check om ervoor te zorgen dat niet de hele kaart undefined is. Is dit wel het geval, ga dan terug naar Write van dit item, check of die ook undefined is, of dat er iets in het opslaan van de tif fout gaat. De twee landgebruikstifs toetsen daarnaast hun fingerprint (#776): faalt die, dan is de beheertypenkaart of een koppeltabel veranderd sinds de tif is geschreven en moet WriteBasedata run 2 opnieuw."
	{
		container Wonen
		{
			attribute<Woning> Aantal_Woningen_Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP2xVSSH/name)+')';
			attribute<meter2> Footprint              (AdminDomain) := Read_UNCHECKED/Wonen/Footprint, IntegrityCheck = "not(all(IsNull(this)))", Descr = "Check om ervoor te zorgen dat niet de hele kaart undefined is. Is dit wel het geval, ga dan terug naar Write van dit item, check of die ook undefined is, of dat er iets in het opslaan van de tif fout gaat.";
		}
		
		container Verblijfsrecreatie
		{
			attribute<meter2> Footprint              (AdminDomain) := Read_UNCHECKED/Verblijfsrecreatie/Footprint, IntegrityCheck = "not(all(IsNull(this)))", Descr = "Check om ervoor te zorgen dat niet de hele kaart undefined is. Is dit wel het geval, ga dan terug naar Write van dit item, check of die ook undefined is, of dat er iets in het opslaan van de tif fout gaat.";
		}
		
		container PandFootprint
		{
			attribute<meter2> Totaal                 (AdminDomain) := ='add('+asItemList(Actor/Jobs6/name)+')';
		}
	}
	
	container Write :=
		for_each_neidvnat(
			StandVar_Prep/path
			, 'Src/'+StandVar_Prep/path+'' 
			, StandVar_Prep/IsLandbouw || StandVar_Prep/IsWaterberging ? '' : 'not(all(IsNull(this))) && not(all(IsZero(this)))'
			, AdminDomain
			, StandVar_Prep
			, StandVar_Prep/unit_name
			, '%LocalDataProjDir%/BaseData/StandBasisjaar/'+StandVar_Prep/path+'_'+/ModelParameters/StudyArea+'.tif'
			, 'gdalwrite.grid'
		), Descr = "Check om ervoor te zorgen dat niet de hele kaart undefined of zero is. Is dit wel zo, ga dan terug tracen naar waar het probleem zit."
	{
		parameter<String> Generate := 'Ready', ExplicitSuppliers = "=asList(StandVar_Prep/path, ';')+';Wonen/Footprint;Verblijfsrecreatie/Footprint;Decoupling_Landgebruik/Write_Fingerprint'";
		
		container Wonen
		{
			attribute<meter2>     Footprint (AdminDomain) := Src/Wonen/Footprint, StorageName = "='%LocalDataProjDir%/BaseData/StandBasisjaar/Wonen/Footprint_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
		}
		container Verblijfsrecreatie
		{
			attribute<meter2>     Footprint (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'Src/Verblijfsrecreatie/Footprint' : 'const(null_d, AdminDomain, meter2)', StorageName = "='%LocalDataProjDir%/BaseData/StandBasisjaar/Verblijfsrecreatie/Footprint_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
		}
	}
	
	container Src
	{
		container Wonen := 
			for_each_nedv(
				Vastgoed/WP2xVSSH/name
				, 'recollect_by_cond(AdminDomain/IsCompactedDomain, Src0/Wonen/WP2xVSSHs/'+Vastgoed/WP2xVSSH/name+')'
				, AdminDomain
				, Woning
			), Descr = "Vertaling van compacted naar uncompacted domain."
		{
			attribute<Woning> Totaal    (AdminDomain) := = 'add('+asItemList(Vastgoed/WP2xVSSH/name)+')';
			attribute<meter2> Footprint (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src0/Wonen/Footprint);
		}
		
		container Werken := 
			for_each_nedv(
				Actor/Jobs6/name
				, 'Src0/Werken/'+Actor/Jobs6/name
				, AdminDomain
				, job
			), Descr = "Ophalen banen per subsector in basisjaar";
		
		container Wind
		{
			attribute<MW>    Totaal                         (AdminDomain) := Src0/Wind/Totaal;
			attribute<MW>    Totaal_Compacted      (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Src0/Wind/Totaal);
			attribute<Yr>    jaartal_ingebruikname          (AdminDomain) := Src0/Wind/jaartal_ingebruikname;
			attribute<Meter> Ashoogte                       (AdminDomain) := Src0/Wind/Ashoogte;
			attribute<Meter> Rotordiameter                  (AdminDomain) := Src0/Wind/Rotordiameter;
			attribute<Meter> MaxWerpafstandNom              (AdminDomain) := Src0/Wind/MaxWerpafstandNom;
		}
		
		container Zon
		{
			attribute<MW> Totaal (AdminDomain) := Src0/Zon/Totaal;
		}
		
		container Verblijfsrecreatie
		{
			attribute<Verblijfsobject> Totaal    (AdminDomain) := Src0/Verblijfsrecreatie/Totaal;
			attribute<meter2>          Footprint (AdminDomain) := Src0/Verblijfsrecreatie/Footprint;
		}
		
		container Waterberging
		{
			attribute<meter3>          Totaal    (AdminDomain) := const(0[meter3], AdminDomain);
		}
		
		container PandFootprint := 
			for_each_nedv(
				Actor/Jobs6/name
				,'BaseData/StartState/PandFootprint/PerYear_AdminDomain/Y'+string(ModelParameters/Model_StartYear)+'/pand_met_vbo/Footprint_perJobs6_AdminDomain/'+Actor/Jobs6/name
				, AdminDomain
				, m2PandFootprint
			), Descr = "Ophalen pandfootprint per werk-subsect uit relevant BAG-jaar";
			
		container Landbouw := 
			for_each_nedv(
				Actor/LandbouwKlasses/name
				,'BaseData/StartState/Landgebruik/LU_Basisjaar == rlookup(Actor/LandbouwKlasses/V/'+Actor/LandbouwKlasses/name+', Actor/LU_ModelType/LandbouwK_rel) ? AdminDomain/NrHaPerCell : 0[Ha]'
				, AdminDomain
				, Ha
			), Descr = "Ophalen landbouw klasse in basisjaar uit landgebruikskaart";

		container Landgebruik
		: Descr = "De stand-administratie landgebruik in het basisjaar (#751): het type per cel uit BaseData/StartState/Landgebruik, en als jaar van verandering het startjaar, want ouder weet het basisjaar niet. Gaat als twee standvariabelen mee door de allocatie en wordt per zichtjaar als tif weggeschreven."
		{
			attribute</Classifications/Grondgebruik/LandgebruikType> Type            (AdminDomain) := BaseData/StartState/Landgebruik/Type;
			attribute<Yr>              JaarVerandering (AdminDomain) := const(UInt16(ModelParameters/Model_StartYear)[Yr], AdminDomain);
		}
	}
	
	container Src0
	{
		#include<Wonen.dms>
		
		container Werken := 
			for_each_nedv(
				Actor/Jobs6/name
				, ModelParameters/Werken/Use_AltLISA 
						? 'AlternatieveLISA/PerVariant/'+Actor/Jobs6/name+'_'+ModelParameters/Werken/AltLISA_cluster_Variant+'_'+ModelParameters/Werken/AltLISA_potential_Variant+'/Estimate_potential'
						: 'WritePrivData/LISA/fss/Per_TXLJobs7_AdminDomain/'+Actor/Jobs6/name
				, AdminDomain
				, job
			), Descr = "Ophalen werk-banen uit LISA of Alt-LISA afhankelijk van modelparameter instelling.";
		
		container Wind
		{
			attribute<MW>    Totaal                (AdminDomain) := SourceData/Energie/Wind/Veldsituatie/AdminDomain/Vermogen_enkelecellen / float32(rdc_meter/IsStudyArea_AdminDomain); 
			attribute<Yr>    jaartal_ingebruikname (AdminDomain) := SourceData/Energie/Wind/Veldsituatie/AdminDomain/jaartal_ingebruikname / UInt16(rdc_meter/IsStudyArea_AdminDomain); 
			attribute<Meter> Ashoogte              (AdminDomain) := SourceData/Energie/Wind/Veldsituatie/AdminDomain/Ashoogte / float32(rdc_meter/IsStudyArea_AdminDomain);
			attribute<Meter> Rotordiameter         (AdminDomain) := SourceData/Energie/Wind/Veldsituatie/AdminDomain/Rotordiameter / float32(rdc_meter/IsStudyArea_AdminDomain);
			attribute<Meter> MaxWerpafstandNom     (AdminDomain) := SourceData/Energie/Wind/Veldsituatie/AdminDomain/MaxWerpafstandNom / float32(rdc_meter/IsStudyArea_AdminDomain);
		}
		
		container Zon
		{
			attribute<MW> Totaal (AdminDomain) := SourceData/Energie/Zon/Zonnevelden_polygonen/AdminDomain/Vermogen / float32(rdc_meter/IsStudyArea_AdminDomain), Descr = "Truck om cellen buiten StudyArea op 0 te zetten.";
		}
		
		container Verblijfsrecreatie
		: Descr = "Stand verblijfsrecreatie in het basisjaar, geteld als logies-objecten uit de BAG. Standaard tellen alleen de logies binnen de CBS-verblijfsrecreatiegebieden mee, want de claim komt uit een trendanalyse op precies die selectie; tellen alle logies mee, dan zit ook het stadshotel in de stand en ligt die structureel boven de claim (#364). Zie ModelParameters/Verblijfsrecreatie/StandAlleenInCBSGebied om terug te vallen op de oude telling."
		{
			parameter<String> LogiesPad := 'PandFootprint/PerYear_AdminDomain/Y'+string(ModelParameters/Model_StartYear)+'/pand_met_vbo/PerGebruiksdoel_corr/logies/';
			parameter<String> Masker    := ModelParameters/Verblijfsrecreatie/StandAlleenInCBSGebied ? '_inCBSVerblijfsrecreatie' : '';
			
			attribute<verblijfsobject> Totaal    (AdminDomain) := =LogiesPad+'count_Per_AdminDomain'+Masker+'[verblijfsobject]';  
			attribute<meter2>          Footprint (AdminDomain) := =LogiesPad+'Footprint_Per_AdminDomain'+Masker;  
		}
	}
}