////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bereking van de verdeling van woningen over sociale huur en vrije sector, per woningtype (een of meergezins)
// en per administratief gebied (CompactedAdminDomain). Het heeft deze indeling voor woon subsectoren, maar
// aanlevering van clamis is op een en meergezins indeling. Dus een vertaalslag moet hiervoor gemaakt worden. Dit
// doen we via een eigendomslaag icm de BAG. Link naar eigendomstaat per pand sociale huur is als eigendom een
// woningcorporatie is
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Verdeling_VSSH
: Descr = "Bereking van de verdeling van woningen over sociale huur en vrije sector, per woningtype (een of meergezins) en per administratief gebied (CompactedAdminDomain). Het heeft deze indeling voor woon subsectoren, maar aanlevering van clamis is op een en meergezins indeling. Dus een vertaalslag moet hiervoor gemaakt worden. Dit doen we via een eigendomslaag icm de BAG."
{
	unit<UInt32> pand_volledig_domain := /SourceData/Vastgoed/BAG/VolledigeBAG/panden/pand;
	unit<UInt32> pand_domain          := SourceData/Vastgoed/EigendomStaat/pand
	, Descr = "Link naar eigendomstaat per pand"
	{
		attribute<Bool> panden_SocialeHuur_selection_condition := Eigendom_rel == /Classifications/Vastgoed/Eigendom/V/WoonCorp, Descr = "sociale huur is als eigendom een woningcorporatie is";
		attribute<Bool> panden_VrijeSector_selection_condition := Eigendom_rel != /Classifications/Vastgoed/Eigendom/V/WoonCorp, Descr = "vrije sector is al het andere";
	}
	
	container Per_AdminDomain :=
		for_each_nedv(
			Classifications/Vastgoed/WP2xVSSH/name
			, 'Uitsmeren_WP2_'+Classifications/Vastgoed/WP2xVSSH/VSSH_name+'/'+Classifications/Vastgoed/WP2xVSSH/WP_name+'/Aantal_Woningen_Per_CompactedAdminDomain[Woning]'
			, CompactedAdminDomain
			, Woning
		), Descr = "ophalen van de uitgesmeerde aantallen woningen per compactedAdminDomain per WP2xVSSH"
	{
		attribute<Float32> Totaal (CompactedAdminDomain) := =asList(Classifications/Vastgoed/WP2xVSSH/name, ' + ');
	}
	
	container Footprint_Per_CompactedAdminDomain :=
		for_each_nedv(
			Classifications/Vastgoed/WP2xVSSH/name
			, 'Uitsmeren_WP2_'+Classifications/Vastgoed/WP2xVSSH/VSSH_name+'/'+Classifications/Vastgoed/WP2xVSSH/WP_name+'/Footprint_Per_CompactedAdminDomain[meter2]'
			, CompactedAdminDomain
			, meter2
		), Descr = "ophalen van de uitgesmeerde footprint per compactedAdminDomain per WP2xVSSH"
	{
		attribute<meter2> Totaal (CompactedAdminDomain) := =asList(Classifications/Vastgoed/WP2xVSSH/name, ' + ');
	}
	
	unit<UInt32> per_Gemeente := ='SourceData/RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/gemeente'
	{
		attribute<UInt32>  Aantal_SH := sum(panden_SocialeHuur/count_vbo_pand_woon, point_in_polygon(centroid_or_mid(panden_SocialeHuur/geometry), geometry)), Descr = "Bereken aantal woningen die in sociale huur panden liggen per gemeente";
		attribute<UInt32>  Aantal_VS := sum(panden_VrijeSector/count_vbo_pand_woon, point_in_polygon(centroid_or_mid(panden_VrijeSector/geometry), geometry)), Descr = "bereken aantal woningen die in vrije sector panden liggen per gemeente";
		
		attribute<Float32> P_SH      := Aantal_SH[float32] / (Aantal_SH + Aantal_VS)[float32], Descr = "Bereken per gemeente het aandeel sociale huur";
		attribute<Float32> P_SH_perCompactedAdminDomain (CompactedAdminDomain) := P_SH[Per_CompactedAdminDomain], Descr = "Geef elke cel in de gemeente die dat aandeel als constante.";
	}
	
	unit<UInt32> panden_SocialeHuur := select_with_attr_by_org_rel(SourceData/Vastgoed/EigendomStaat/pand, pand_domain/panden_SocialeHuur_selection_condition);
	unit<UInt32> panden_VrijeSector := select_with_attr_by_org_rel(SourceData/Vastgoed/EigendomStaat/pand, pand_domain/panden_VrijeSector_selection_condition);

	attribute<Woning> GeenExtraWoningen_Per_CAD (CompactedAdminDomain) := const(0[Woning], CompactedAdminDomain), Descr = "Nul-attribuut voor Uitsmeren_T instanties zonder extra woningen (sociale huur; vbo's zonder pand tellen als vrije sector).";

	container Uitsmeren_WP2_SocialeHuur := for_each_ne(Classifications/Vastgoed/WP2/name, 'Uitsmeren_T('+quote(Classifications/Vastgoed/WP2/name)+', ''WP2'', panden_SocialeHuur, pand_domain/panden_SocialeHuur_selection_condition, GeenExtraWoningen_Per_CAD)'), Descr = "Smeer sociale huur woningen uit over panden per WP2";
	container Uitsmeren_WP2_VrijeSector := for_each_ne(Classifications/Vastgoed/WP2/name, 'Uitsmeren_T('+quote(Classifications/Vastgoed/WP2/name)+', ''WP2'', panden_VrijeSector, pand_domain/panden_VrijeSector_selection_condition, VBOsZonderPand/Per_CAD_WP2/'+Classifications/Vastgoed/WP2/name+')'), Descr = "Smeer vrije sector woningen uit over panden per WP2. De woon-vbo's zonder pand in de pandenset worden hier als extra woningen op hun vbo-punt meegeteld.";

	container Uitsmeren_WP4_SocialeHuur := for_each_ne(Classifications/Vastgoed/WP4/name, 'Uitsmeren_T('+quote(Classifications/Vastgoed/WP4/name)+', ''WP4'', panden_SocialeHuur, pand_domain/panden_SocialeHuur_selection_condition, GeenExtraWoningen_Per_CAD)'), Descr = "Smeer sociale huur woningen uit over panden per WP4";
	container Uitsmeren_WP4_VrijeSector := for_each_ne(Classifications/Vastgoed/WP4/name, 'Uitsmeren_T('+quote(Classifications/Vastgoed/WP4/name)+', ''WP4'', panden_VrijeSector, pand_domain/panden_VrijeSector_selection_condition, VBOsZonderPand/Per_CAD_WP4/'+Classifications/Vastgoed/WP4/name+')'), Descr = "Smeer vrije sector woningen uit over panden per WP4. De woon-vbo's zonder pand in de pandenset worden hier als extra woningen op hun vbo-punt meegeteld.";

	container VBOsZonderPand
	: Descr = "Woon-vbo's zonder gerelateerd pand in de pandenset van het modeljaar (pand op 1 januari niet in voorraad, of pand uitgefilterd op omvang/ligging). Deze woningen worden op het vbo-punt geplaatst zodat ze niet uit de woningstand vallen. Eigendom is onbekend (geen pandkoppeling met de eigendomslaag), dus conform de conventie elders (onbekend = Koop) tellen ze als VrijeSector."
	{
		unit<UInt32> vbo_woon_domain := ='SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/vbo/Per_Gebruiksdoel/woon/select'
		{
			attribute<Bool>        zonder_pand_condition := ='!IsDefined(SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/vbo/Per_Gebruiksdoel/woon/select/eerste_pand_rel)';
			attribute<AdminDomain> AdminDomain_rel       := ='SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/vbo/Per_Gebruiksdoel/woon/select/AdminDomain_rel';
			attribute<uint64>      vbo_bag_nr            := ='SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/vbo/Per_Gebruiksdoel/woon/select/vbo_bag_nr';
		}

		unit<UInt32> vbo_zonder_pand := select_with_org_rel(vbo_woon_domain/zonder_pand_condition)
		{
			attribute<AdminDomain>            AdminDomain_rel := org_rel -> AdminDomain_rel;
			attribute<CompactedAdminDomain>   CAD_rel         := CompactedAdminDomain/Per_AdminDomain[AdminDomain_rel], Descr = "Cel waarin het vbo-punt ligt; null buiten het studiegebied-masker, die vbo's vallen (verantwoord) uit.";
			attribute<uint64>                 vbo_bag_nr      := org_rel -> vbo_bag_nr;
			attribute<uint64>                 bag_pand_nr_0   := rjoin(vbo_bag_nr, SourceData/Vastgoed/BAG/VolledigeBAG/VBOs/src/gerelateerdPand/vbo_bag_nr, SourceData/Vastgoed/BAG/VolledigeBAG/VBOs/src/gerelateerdPand/pand_bag_nr), Descr = "eerste gerelateerde pand in de volledige BAG (ongeacht status), tbv groepering naar woningtype";
			attribute<uint64>                 groep_key       := MakeDefined(bag_pand_nr_0, vbo_bag_nr);
			attribute<groep>                  groep_rel       := rlookup(groep_key, groep/values);
			attribute<UInt32>                 aantal_in_groep := pcount(groep_rel)[groep_rel];

			attribute<Classifications/Vastgoed/WP2> WP2_rel   := aantal_in_groep > 1 ? Classifications/Vastgoed/WP2/V/meergezins  : Classifications/Vastgoed/WP2/V/eengezins,  Descr = "Woningtype obv aantal vbo's dat hetzelfde (niet-geselecteerde) pand deelt: meerdere vbo's in een pand duidt op meergezins.";
			attribute<Classifications/Vastgoed/WP4> WP4_rel   := aantal_in_groep > 1 ? Classifications/Vastgoed/WP4/V/appartement : Classifications/Vastgoed/WP4/V/vrijstaand, Descr = "WP4 typering consistent met WP2_rel (appartement bij meergezins, vrijstaand bij eengezins).";

			unit<UInt32> groep := unique(groep_key);
		}

		container Per_CAD_WP2 :=
			for_each_nedv(
				Classifications/Vastgoed/WP2/name
				, 'sum_uint32(vbo_zonder_pand/WP2_rel == '+string(id(Classifications/Vastgoed/WP2))+'[Classifications/Vastgoed/WP2], vbo_zonder_pand/CAD_rel)[Woning]'
				, CompactedAdminDomain
				, Woning
			), Descr = "Aantal woon-vbo's zonder pand per CompactedAdminDomain cel, per WP2 type.";

		container Per_CAD_WP4 :=
			for_each_nedv(
				Classifications/Vastgoed/WP4/name
				, 'sum_uint32(vbo_zonder_pand/WP4_rel == '+string(id(Classifications/Vastgoed/WP4))+'[Classifications/Vastgoed/WP4], vbo_zonder_pand/CAD_rel)[Woning]'
				, CompactedAdminDomain
				, Woning
			), Descr = "Aantal woon-vbo's zonder pand per CompactedAdminDomain cel, per WP4 type.";
	}

	container Checks
	: Descr = "Sluitendheidscontrole: de uitgesmeerde woningstand moet, op verantwoorde uitval buiten het studiegebied en afrondingsruis na, gelijk zijn aan het aantal unieke woon-vbo's in de BAG voorraad van het modeljaar."
	{
		parameter<Float64> stand_totaal                          := sum(float64(Per_AdminDomain/Totaal)), Descr = "Som van de uitgesmeerde woningstand over alle cellen en WP2xVSSH categorieen.";
		parameter<Float64> bron_unieke_woon_vbos                 := ='float64(uint32(#SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/vbo/Per_Gebruiksdoel/woon/select))', Descr = "Aantal unieke woon-vbo's in voorraad op 1 januari van het modeljaar.";
		parameter<Float64> uitval_vbos_zonder_pand_buiten_gebied := sum(IsDefined(VBOsZonderPand/vbo_zonder_pand/CAD_rel) ? 0d : 1d), Descr = "Woon-vbo's zonder pand waarvan het vbo-punt buiten het studiegebied-masker ligt.";
		parameter<Float64> uitval_panden_geheel_buiten_gebied    := sum(pand_domain/ToedelingsMatrix/ToedelingPand_binnenCAD > 0f ? 0d : float64(pand_domain/count_vbo_pand_woon)), Descr = "Woningen in panden die geheel buiten het studiegebied-masker liggen.";
		parameter<Float64> verantwoord_totaal                    := stand_totaal + uitval_vbos_zonder_pand_buiten_gebied + uitval_panden_geheel_buiten_gebied;
		parameter<Float64> verschil_met_bron                     := abs(verantwoord_totaal - bron_unieke_woon_vbos);
		parameter<Float64> tolerantie                            := max_elem(10d, 0.00001d * bron_unieke_woon_vbos), Descr = "Bij verificatie (2026-08, BAG 20260710, jaar 2023) was het werkelijke verschil 0.07 woningen (float32 afrondingsruis), de tolerantie is daar ruim boven maar strak genoeg om structurele lekken (ordegrootte honderden+) direct te vangen.";

		parameter<String>  WoningstandSluitendMetBAG := 'Ready', IntegrityCheck = "verschil_met_bron <= tolerantie"
		, Descr = "Faalt dit item, dan gaan er weer woningen verloren (of dubbel geteld worden) in de keten van BAG woon-vbo's naar de StateBasisjaar woningstand. Kwantificeer dan de keten: unieke vbo's, telling per pand, uitsmeren naar CompactedAdminDomain.";
	}

	unit<UInt8>          AllocRegio       := /Classifications/Modellering/AllocRegiosK;

	container Per_AllocRegios := 
		for_each_ne(
			AllocRegio/name
			, 'MakeProxy_perAllocRegio_T('+string(id(AllocRegio))+'[AllocRegio])'
		)
	{
		parameter<String> Generate_Wonen              := 'Ready', ExplicitSuppliers = "=asList(AllocRegio/name+'/Write_Wonen_WP2xVSSH', ';')";
	}
	
	Template MakeProxy_perAllocRegio_T
	{
		parameter<AllocRegio> AllocRegio_rel;
		///
		parameter<String> AllocRegio_name := AllocRegio/name[AllocRegio_rel];
		parameter<String> AllocRegio_path := AllocRegio/path[AllocRegio_rel];

		unit<UInt32> RegioUnit := ='/SourceData/'+AllocRegio_path;
		
		container Write_Wonen_WP2xVSSH
		: StorageName = "='%LocalDataProjDir%/BaseData/Vastgoed/WP2xVSSH_Proxy/'+AllocRegio_name+'/'+/ModelParameters/StudyArea+'.mmd'"
		, Descr = "deze proxy's worden gebruikt om de claims te verdelen tusen een/meergezins naar VS/SH."
		{
			attribute<Woning> eengezins_VrijeSector_Proxy  (RegioUnit) := sum(Verdeling_VSSH/Per_AdminDomain/eengezins_VrijeSector, RegioUnit/Per_CompactedAdminDomain);
			attribute<Woning> eengezins_SocialeHuur_Proxy  (RegioUnit) := sum(Verdeling_VSSH/Per_AdminDomain/eengezins_SocialeHuur, RegioUnit/Per_CompactedAdminDomain);
			attribute<Woning> meergezins_VrijeSector_Proxy (RegioUnit) := sum(Verdeling_VSSH/Per_AdminDomain/meergezins_VrijeSector, RegioUnit/Per_CompactedAdminDomain);
			attribute<Woning> meergezins_SocialeHuur_Proxy (RegioUnit) := sum(Verdeling_VSSH/Per_AdminDomain/meergezins_SocialeHuur, RegioUnit/Per_CompactedAdminDomain);
			attribute<Woning> eengezins_Proxy              (RegioUnit) := eengezins_VrijeSector_Proxy  + eengezins_SocialeHuur_Proxy;
			attribute<Woning> meergezins_Proxy             (RegioUnit) := meergezins_VrijeSector_Proxy + meergezins_SocialeHuur_Proxy;
		}
	}	
	
	Template Uitsmeren_T
	: Descr = ""
	{
		parameter<String> WP_str;
		parameter<String> WP_Type;
		unit<UInt32>      pand_perVSSH_domain;
		attribute<Bool>   VSSH_cond (pand_domain);
		attribute<Woning> ExtraWoningen_Per_CAD (CompactedAdminDomain);
		//
		
		attribute<meter2> Footprint_pand_perVSSH_domain            (pand_perVSSH_domain) := ='pand_perVSSH_domain/'+WP_Type+'_rel == Classifications/Vastgoed/'+WP_Type+'/V/'+WP_str+' ? pand_perVSSH_domain/Footprint : 0[meter2]', Descr = "Selecteer footprint als wp-type gelijk is, anders 0.";
		attribute<meter2> Footprint_per_pand_domain                        (pand_domain) := recollect_by_cond(VSSH_cond, Footprint_pand_perVSSH_domain, 0[meter2]), Descr = "Breng dat resultaat van pand_perVSSH_domain naar het pand_domain.";
		attribute<meter2> Footprint_Per_CompactedAdminDomain      (CompactedAdminDomain) := sum(Footprint_per_pand_domain[pand_domain/ToedelingsMatrix/Pand_rel] * pand_domain/ToedelingsMatrix/ToedelingPand, pand_domain/ToedelingsMatrix/CompactedAdminDomain_rel), Descr = "sommeer de pandfootprint over CAD cellen, gebaseerd op de uitsmeer-pand-relatie. Zodat grote panden netjes over meerdere cellen worden verdeeld."; 
		
		attribute<meter2> VBOopp_per_pand_perVSSH_domain           (pand_perVSSH_domain) := ='pand_perVSSH_domain/'+WP_Type+'_rel == Classifications/Vastgoed/'+WP_Type+'/V/'+WP_str+' ? pand_perVSSH_domain/VBOopp_inPand_'+WP_str+' : 0[meter2]', Descr = "Selecteer vbo opp als wp-type gelijk is, anders 0";
		attribute<meter2> VBOopp_per_pand_domain                           (pand_domain) := recollect_by_cond(VSSH_cond, VBOopp_per_pand_perVSSH_domain, 0[meter2]), Descr = "Breng dat resultaat van pand_perVSSH_domain naar het pand_domain.";
		attribute<meter2> VBOopp_Per_CompactedAdminDomain         (CompactedAdminDomain) := sum(VBOopp_per_pand_domain[pand_domain/ToedelingsMatrix/Pand_rel] * pand_domain/ToedelingsMatrix/ToedelingPand, pand_domain/ToedelingsMatrix/CompactedAdminDomain_rel), Descr = "sommeer de pandvboopp over CAD cellen, gebaseerd op de uitsmeer-pand-relatie. Zodat grote panden netjes over meerdere cellen worden verdeeld.";
		
		attribute<Woning> Aantal_Woningen_per_pand_perVSSH_domain  (pand_perVSSH_domain) := ='pand_perVSSH_domain/'+WP_Type+'_rel_woningtelling == Classifications/Vastgoed/'+WP_Type+'/V/'+WP_str+' ? pand_perVSSH_domain/count_vbo_pand_woon[Woning] : 0[Woning]', Descr = "Selecteer aantal woningen als wp-type gelijk is, anders 0. Gebruikt de _woningtelling typering met fallback, zodat ook woningen in panden zonder WP5 typering meetellen.";
		attribute<Woning> Aantal_Woningen_per_pand_domain                  (pand_domain) := recollect_by_cond(VSSH_cond, Aantal_Woningen_per_pand_perVSSH_domain, 0[Woning]), Descr = "Breng dat resultaat van pand_perVSSH_domain naar het pand_domain.";
		attribute<Woning> Aantal_Woningen_Per_CompactedAdminDomain(CompactedAdminDomain) := sum(Aantal_Woningen_per_pand_domain[pand_domain/ToedelingsMatrix/Pand_rel] * pand_domain/ToedelingsMatrix/ToedelingPand_CAD, pand_domain/ToedelingsMatrix/CompactedAdminDomain_rel) + ExtraWoningen_Per_CAD, Descr = "sommeer het aantal woningen over CAD cellen, gebaseerd op de uitsmeer-pand-relatie. Zodat grote panden netjes over meerdere cellen worden verdeeld. Gebruikt de over het CompactedAdminDomain hernormaliseerde gewichten (ToedelingPand_CAD) zodat pand-delen buiten het masker geen woningen laten wegvallen, en telt de extra woningen (vbo's zonder pand, op vbo-punt geplaatst) erbij op.";
	}
}