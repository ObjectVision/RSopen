////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Wat het model afleidt uit de landbouwbronnen die SourceData/Landbouw inleest (#440): de gerasterde gewascode
// uit de BRP en de opbrengstdervingskaarten van de WWL-gewassen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landbouw : using = "Classifications/Landbouw"
, Descr = "De afleidingen uit de landbouwbronnen die als ontkoppeld bestand in LocalData staan: de gewascode uit de BRP op 25 meter en de opbrengstderving per levering, klimaatanker en gewas. Het inlezen staat in SourceData/Landbouw (#440)."
{
	container BRP
	: Descr = "De gewascode per cel van 25 meter uit de percelen van de Basisregistratie Gewaspercelen die SourceData/Landbouw/BRP inleest (#751, #440)."
	{
		attribute<Int32> Calc_Gewascode (rdc_25m) := /SourceData/Landbouw/BRP/Bron/perceel/gewascode[poly2grid(/SourceData/Landbouw/BRP/Bron/perceel/geometry, rdc_25m)]
		, Descr = "De gewascode per cel, null waar geen perceel ligt. Int32 omdat de kolom als MEDIUMINT binnenkomt.";

		parameter<String> FileName_Gewascode := '%LocalDataProjDir%/BaseData/Landbouw/BRP_Gewascode_25m_'+/ModelParameters/BRP_Year+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

		parameter<String> Fingerprint_Gewascode :=
			  'brp_year='          + /ModelParameters/BRP_Year
			+ ';sql='              + PropValue(/SourceData/Landbouw/BRP/Bron/perceel, 'SqlString')
			+ ';study_area='       + /ModelParameters/StudyArea
			+ ';grid_size='        + string(rdc_25m/gridsize)
		, Descr = "De volledige lijst invoeren die de tif bepaalt. brp_year bepaalt via de bestandsnaam welk gpkg wordt gelezen. De sleutel sql draagt de letterlijke tekst van de SqlString, want die bepaalt
					welke percelen meedoen en in welke volgorde ze worden gerasterd, en dat laatste beslist bij overlap wie wint; zonder die sleutel zou een aanpassing de uitkomst veranderen zonder remake en
					zonder dat de areaaltoets hieronder vuurt (#613). De koppeling naar de landbouwklasse staat er bewust niet in: de tif draagt de rauwe gewascode en de vertaling gebeurt na het lezen.";

		container Decoupling_Gewascode := /Templates/DecoupledFile_T(FileName_Gewascode, Fingerprint_Gewascode, 'Write_Gewascode');

		attribute<Int32> Write_Gewascode (rdc_25m) := Calc_Gewascode, StorageName = "=Decoupling_Gewascode/StorageFile", StorageType = "gdalwrite.grid"
		, Descr = "Schrijft de gerasterde gewascode eenmalig weg, zonder zijbestand; dat volgt via Make_Gewascode. Het rasteren kost ongeveer een minuut en leest 2,9 GB van de gesynchroniseerde schijf; ontkoppelen scheelt dat bij elke volgende aanroep.";
		attribute<Int32> Make_Gewascode (rdc_25m) := Write_Gewascode, ExplicitSuppliers = "Decoupling_Gewascode/Write_Fingerprint;Controle/Afwijking"
		, Descr = "Maakt de tif en daarna het zijbestand, en toetst onderweg het gerasterde areaal tegen het polygoonareaal. Vraag dit item en niet Write_Gewascode, want alleen langs deze weg ontstaat de fingerprint (#837).";

		attribute<Int32> Read_Gewascode (rdc_25m) : StorageName = "=Decoupling_Gewascode/StorageFile", StorageType = "gdal.grid", StorageReadOnly = "TRUE";

		attribute<BRPGewasType> BRPGewasType_rel (rdc_25m) := = Decoupling_Gewascode/MayReuse ? 'rlookup(Read_Gewascode, BRPGewasType/code)' : 'rlookup(Make_Gewascode, BRPGewasType/code)'
		, Descr = "Vraag Decoupling_Gewascode/Explanation op als je wilt weten waarom de tif wel of niet opnieuw wordt gemaakt.";

		// 			De vertaling gebeurt hier, na het lezen, en niet in de tif. Dat is bewust: de tif draagt de rauwe
		// 			gewascode, dus een wijziging in BRPGewas werkt meteen door en hoeft niet in de fingerprint. Zou de
		// 			tif de vertaalde klasse dragen, dan was die koppeling wel een determinant en leverde een wijziging
		// 			aan de tabel stil een verouderd bestand.";

		container Controle
		: Descr = "Areaaltoets op het rasteren, naast de fingerprint. Een fingerprintsleutel vangt een gewijzigde SqlString niet: verandert daar de sorteervolgorde of een filter, dan blijft de sleutel gelijk terwijl het raster verschuift. Bij #613 verdween zo 1.500 van de 12.233 ha met exitcode 0. Deze toets legt het gerasterde areaal naast het polygoonareaal en valt om zodra die twee uit elkaar lopen."
		{
			parameter<Ha> Areaal_Vector := sum(area(/SourceData/Landbouw/BRP/Bron/perceel/geometry, meter2_f64)[Ha])
			, Descr = "Het areaal van alle percelen samen, rechtstreeks uit de polygonen.";

			parameter<Ha> Areaal_Raster := sum(IsDefined(Calc_Gewascode) ? rdc_25m/NrHaPerCell : 0[Ha])
			, Descr = "Hetzelfde areaal zoals het model het op 25 meter gerasterd heeft.";

			parameter<Bool> IsHeelNederland := /ModelParameters/StudyArea == 'Nederland'
			, Descr = "Draait het model over het hele land? Bepaalt hoe streng de toets hieronder kan zijn.";

			parameter<float32> Ratio := Areaal_Raster / Areaal_Vector
			, Descr = "De verhouding tussen die twee; het rasteren kost een fractie van een procent, want percelen zijn groot ten opzichte van een cel van 25 meter. De marge van een procent is ruim en toch scherp
						genoeg voor het soort fout dat hij moet vangen (#613). Hangt via ExplicitSuppliers aan Make_Gewascode en vuurt dus alleen wanneer de tif werkelijk wordt gemaakt, want aan de leeskant zou hij
						het gpkg bij elke run openen; hij vult de fingerprint aan en vervangt haar niet, vandaar de SqlString in de sleutel.";

			parameter<float32> Afwijking := IsHeelNederland
				? abs(Ratio - 1f)
				: (Ratio > 0.01f && Ratio < 1.01f ? 0f : 1f)
			, IntegrityCheck = "Afwijking < 0.01f"
			, Descr = "Waar de toets werkelijk op valt: op heel Nederland de afstand van Ratio tot 1, onder de 0,01. Op een kleiner studiegebied kan Ratio nooit 1 worden, want Areaal_Vector telt alle percelen in
						het gpkg en Areaal_Raster alleen het studiegebied, en een centroide-filter lost dat niet op omdat grenspercelen dan heel meetellen en half gerasterd worden. Buiten het landelijke geval eist
						de toets daarom alleen dat er iets gerasterd is en niet meer dan de vectorkant, wat de grove faalvormen vangt.";

		}
	}

	container Yield_Reduction: using = "/SourceData/Landbouw/Yield_Reduction"
	, Descr = "De opbrengstdervingskaarten per hydrologische levering, klimaatanker en gewas, uit de WWL-relatiedatabase, BOFEK en de grondwaterstanden. De relatiedatabase en de beregeningskaart leest SourceData/Landbouw/Yield_Reduction in, en de using daarop laat de rekenregels hieronder ongewijzigd naar WWL_relatie_database en de beregeningskaart verwijzen (#440)."
	{
		container OpbrengstenDerving_Dynamisch :=
			for_each_ne(
				OpbrengstendervingsVarianten/name
				, 'OpbrengstenDerving_T('+string(id(OpbrengstendervingsVarianten))+'[OpbrengstendervingsVarianten])'
			)
		{
			parameter<String> generate := 'Ready', explicitsuppliers = "=AsList(OpbrengstendervingsVarianten/name+'/Make_Opbrengstderving', ';')"
			, Descr = "Maakt alle opbrengstdervingskaarten opnieuw, met hun fingerprint, ook waar die nog klopt. Noemt met opzet Make_Opbrengstderving en niet Opbrengstderving: dat laatste leest de kaart terug zolang de fingerprint klopt, en dan maakt deze haak niets.";
		
			container BAU            := = any(Leveringen/label == 'BAU')            ? 'GenerateLevering_T()' : '/Templates/Leeg';
			container BAU2           := = any(Leveringen/label == 'BAU2')           ? 'GenerateLevering_T()' : '/Templates/Leeg';
			container NbSGenuanceerd := = any(Leveringen/label == 'NbSGenuanceerd') ? 'GenerateLevering_T()' : '/Templates/Leeg';
			container WBS            := = any(Leveringen/label == 'WBS')            ? 'GenerateLevering_T()' : '/Templates/Leeg';
		}

		unit<uint8> Leveringen := select_with_org_rel(NL2120_Varianten/WordtGelezen)
		, Descr = "De hydrologische leveringen die een variant leest, zie NL2120_Varianten/WordtGelezen. Alleen daarvoor worden opbrengstdervingskaarten gemaakt."
		{
			attribute<string> label := NL2120_Varianten/label[org_rel];
		}

		Template GenerateLevering_T
		: Descr = "De haken die de dervingskaarten van een levering maken, per klimaatanker en alles samen; de kaarten zelf maakt de for_each in OpbrengstenDerving_Dynamisch onder dezelfde naam."
		{
			parameter<String> Generate       := 'Ready', explicitsuppliers = "=AsList('Generate_'+WWL_Zichtjaren/label, ';')";
			parameter<String> Generate_Y2017 := 'Ready', explicitsuppliers = "=AsList('Y2017/'+ WWL_relatie_database/WWL_Gewassen/name+'/Make_Opbrengstderving', ';')";
			parameter<String> Generate_Y2050 := 'Ready', explicitsuppliers = "=AsList('Y2050/'+ WWL_relatie_database/WWL_Gewassen/name+'/Make_Opbrengstderving', ';')";
			parameter<String> Generate_Y2085 := 'Ready', explicitsuppliers = "=AsList('Y2085/'+ WWL_relatie_database/WWL_Gewassen/name+'/Make_Opbrengstderving', ';')";
		}

		unit<uint8> OpbrengstendervingsVarianten := combine_uint8(Leveringen, WWL_Zichtjaren, WWL_relatie_database/WWL_Gewassen)
		{
			attribute<NL2120_Varianten> NL2120_Varianten_rel := Leveringen/org_rel[first_rel];
			attribute<WWL_Zichtjaren>   WWL_Zichtjaren_rel   := second_rel;
			attribute<WWL_relatie_database/WWL_Gewassen>     WWL_Gewassen_rel     := third_rel;

			attribute<string> name := NL2120_Varianten/label[NL2120_Varianten_rel]+'/'+WWL_Zichtjaren/label[WWL_Zichtjaren_rel]+'/'+WWL_relatie_database/WWL_Gewassen/name[WWL_Gewassen_rel];
		}		

	
		Template OpbrengstenDerving_T
		{
			parameter<OpbrengstendervingsVarianten> OpbrengstendervingsVarianten_rel;

			parameter<string>  NL2120_Varianten_name := NL2120_Varianten/label[OpbrengstendervingsVarianten/NL2120_Varianten_rel[OpbrengstendervingsVarianten_rel]];
			parameter<string>  Grondwaterstanden_pad := NL2120_Varianten_name == 'NbSGenuanceerd' || NL2120_Varianten_name == 'WBS' ? '/BaseData/Water/Grondwaterstanden/'+NL2120_Varianten_name : '/SourceData/Water/Grondwaterstanden/'+NL2120_Varianten_name
			, Descr = "Waar de grondwaterstanden van deze levering staan: de twee leveringen van Deltares in SourceData/Water/Grondwaterstanden, NbSGenuanceerd en WBS met hun oplegging in BaseData/Water/Grondwaterstanden (#440).";
			parameter<string>  WWL_Zichtjaar         := WWL_Zichtjaren/name[OpbrengstendervingsVarianten/WWL_Zichtjaren_rel[OpbrengstendervingsVarianten_rel]];
			parameter<uint32>  Zichtjaar_klimaat     := WWL_Zichtjaar == '2017'
																? uint32(/ModelParameters/Landbouw/Scenario/Basisjaar_rel)
																: uint32(/ModelParameters/Landbouw/Scenario/WarmHoog_rel)
			, Descr = "Welke klimaatband van de WWL-schaderelatie deze kaart gebruikt: die van het basisjaar of die van het scenario. Het klimaat is volgens Deltares in #782 een scenariokenmerk en geen
						variantkenmerk, dus de keuze staat in ModelParameters/Landbouw/Scenario en geldt voor alle varianten; BAU2 leest via VariantK/Hydrologie_Levering de referentiestanden en krijgt hier de warme
						schaderelatie, een bewuste keuze van Deltares (zie de vraag in #782). Het basisjaar houdt de referentieband, want SourceData/Water/Grondwaterstanden zet er voor elke variant REF2017BP18 op.
						Of de combinatie van W2050-standen en een warme schaderelatie voor zichtjaar 2040 de bedoeling is, is een vraag voor Deltares.";
			parameter<uint32>  Gewas_code            := WWL_relatie_database/WWL_Gewassen/code[OpbrengstendervingsVarianten/WWL_Gewassen_rel[OpbrengstendervingsVarianten_rel]];
			parameter<string>  Gewas_name            := WWL_relatie_database/WWL_Gewassen/label[OpbrengstendervingsVarianten/WWL_Gewassen_rel[OpbrengstendervingsVarianten_rel]];
			parameter</Classifications/Landbouw/ZoutgevoeligheidK> Zoutgroep := WWL_relatie_database/WWL_Gewassen/Zoutgevoeligheid_rel[OpbrengstendervingsVarianten/WWL_Gewassen_rel[OpbrengstendervingsVarianten_rel]];

			parameter<float32> gxg_sign  := 1f;      // positief = diepte onder maaiveld
			parameter<float32> gxg_scale := 100f;    // op 100 zetten als de kaart in meters staat

			unit<uint32> combo_sel := select_with_org_rel(WWL_relatie_database/combo/klimaat    == Zichtjaar_klimaat
															&& WWL_relatie_database/combo/gewas_code == Gewas_code)
			{
				attribute<uint32> bodem_code := org_rel -> bodem_code;
				attribute<uint32> gewas_code := org_rel -> combo/gewas_code;
				attribute<uint32> beregening := org_rel -> combo/beregening;
				attribute<uint32> band       := org_rel -> combo/band;
			}

			unit<uint32> LUT_opslag := combine(combo_sel, WWL_relatie_database/dmgtot)
			, Descr = "De banden van deze gewas-klimaatcombinatie gestapeld, per combinatie in de opslagvolgorde van de grid (tegels); alleen via LUT/opslag_rel te lezen."
			{
				attribute<float32> dmgtot_stack := ='union_data(., ' + AsItemList('WWL_relatie_database/dmgtot_bands/b' + string(combo_sel/band)) + ')';
			}
			unit<uint32> LUT := combine(combo_sel, WWL_relatie_database/wwl_k)   //lookup table
			{
				attribute<uint32>  wwl_row    := WWL_relatie_database/wwl_k/rij[second_rel];
				attribute<uint32>  wwl_col    := WWL_relatie_database/wwl_k/kol[second_rel];

				// De netcdf heeft ghg als rij-as en glg als kolom-as, beide van 0 tot 3 meter oplopend. GDAL leest de rij-as gespiegeld
				// (rij 0 is ghg 3,00 m) en de kolom-as ongespiegeld (kolom 0 is glg 0,00 m). Gemeten in #837: de natste hoek, 99 procent
				// schade, ligt op rij 300 kolom 0, de droogste op rij 0 kolom 300, en de fysisch onmogelijke helft (GLG ondieper dan GHG)
				// is null waar de kolom kleiner is dan 300 min de rij.
				attribute<uint32>  ghg        := 300 - wwl_row;   // rij   = ghg, cm = 300 - index
				attribute<uint32>  glg        := wwl_col;         // kolom = glg, cm = index
				attribute<uint32>  bodem_code := combo_sel/bodem_code[first_rel];
				attribute<uint32>  gewas_code := combo_sel/gewas_code[first_rel];
				attribute<uint32>  beregening := combo_sel/beregening[first_rel];

				// mixed-radix sleutel; slots: beregening<2, bodem_code<8192 (BOFEK EK max 5007), gewas_code<32, ghg<512, glg<512. Zelfde formule per-cel (zie key hieronder).
				attribute<uint64>  key		  := (((uint64(beregening)*8192u64 + uint64(bodem_code))*32u64 + uint64(gewas_code))*512u64 + uint64(ghg))*512u64 + uint64(glg);

				attribute<LUT_opslag> opslag_rel  := value(uint32(first_rel) * 90601 + uint32(WWL_relatie_database/wwl_k/perm[second_rel]), LUT_opslag), Descr = "Waar de waarde van deze rij in de gestapelde opslagvolgorde staat.";
				attribute<float32>    dmgtot_stack := LUT_opslag/dmgtot_stack[opslag_rel];
			}

			container Input
			{
				attribute<uint32> bodem_code         (AdminDomain) := SourceData/Bodem/BOFEK/BOFEK_CODE_Gevuld, Descr = "De BOFEK-code met de vulling van de cellen zonder code (#837).";
				attribute<uint32> gewas_code         (AdminDomain) := const(../Gewas_code, AdminDomain);
				attribute<bool>   VernattingOpgelegd (AdminDomain) := =
						NL2120_Varianten_name == 'NbSGenuanceerd' || NL2120_Varianten_name == 'WBS'
							? '/BaseData/Water/Grondwaterstanden/'+NL2120_Varianten_name+'/Opgelegd'
							: 'const(FALSE, AdminDomain)'
				, Descr = "Legt de levering op deze cel een grondwaterstand op? Alleen in NbSGenuanceerd en WBS kan dat waar zijn; de andere leveringen leggen niets op en hebben geen item Opgelegd, vandaar
							de tak op de naam. In NbSGenuanceerd dezelfde cellen als BaseData/Water/Grondwaterstanden/NbSGenuanceerd/Opgelegd: de bouwstenen 1, 2, 3a, 3b, 4a, 4b en 5 tot en met 8, dus zonder open
							water, de twee bebouwde bouwstenen en het gebied buiten het veen. In WBS de veenweidepercelen die WBS vernat, BaseData/Water/Grondwaterstanden/WBS/Opgelegd.";

				attribute<uint32>  beregenings_code_scenario (AdminDomain)  := =
						/ModelParameters/Landbouw/BeregeningScenario_name == 'A_GeenBeregening'
							? 'const(uint32(/Classifications/Landbouw/WWL_BeregeningsK/v/GeenBeregening), AdminDomain)'
							: /ModelParameters/Landbouw/BeregeningScenario_name == 'B1_Beregening_allepercelen_ongelim'
								? 'const(uint32(/Classifications/Landbouw/WWL_BeregeningsK/v/WelBeregening), AdminDomain)'
								: 'uint32(Beregeningskaart_Basisprognoses_2018/WWL_Beregenings_rel)'
				, Descr = "Welke beregeningsvariant de WWL-schaderelatie per cel gebruikt; de relatiedatabase kent GeenBeregening en WelBeregening. Gestuurd door ModelParameters/Landbouw/BeregeningScenario_name: A
							betekent nergens beregening, B1 overal, en B2 precies wat de Beregeningskaart_Basisprognoses_2018 zegt, alleen de percelen met een installatie in 2018. De opbrengstderving is de dominante
							term in de netto-opbrengst, dus dit is geen cosmetische keuze.";

				attribute<bool>    ZoutTeHoog (AdminDomain) := =
						'Beregeningskaart_Basisprognoses_2018 == /ModelParameters/Landbouw/Verzilting/Beregeningskaart_Oppervlaktewater'
					+	' && /SourceData/Landbouw/Verzilting/PerAnker/Y'+WWL_Zichtjaar+'/Concentratie > /ModelParameters/Landbouw/Verzilting/MaxConcentratie_gl[Zoutgroep]'
				, Descr = "Beregent deze cel uit oppervlaktewater dat bij dit anker te zout is voor de gewasgroep van dit gewas (#616)? Onwaar waar de concentratie onbekend is.";

				attribute<uint32>  beregenings_code (AdminDomain) := VernattingOpgelegd || ZoutTeHoog
					? const(uint32(/Classifications/Landbouw/WWL_BeregeningsK/v/GeenBeregening), AdminDomain)
					: beregenings_code_scenario
				, Descr = "Het scenario hierboven, met twee uitzonderingen waar de beregening uit staat, wat het scenario ook zegt. De eerste is de cel waar de levering een grondwaterstand oplegt (VernattingOpgelegd), het antwoord van Deltares op
							de vraag uit #542 (#793). De uitzondering ligt op Opgelegd en niet alleen op de natte-teeltklassen, want ook de veenvormende bouwstenen zijn nat. Riet en lisdodde raakt dit niet, want die
							lezen de kansenkaarten; wat deze regel stuurt is de derving van de WWL-gewassen op diezelfde cellen, en daarmee of de allocator daar iets anders dan natte teelt zou willen neerzetten.
							De tweede is de cel die uit oppervlaktewater beregent dat te zout is (ZoutTeHoog, #616).";
				attribute<float32> ghg_cm       (AdminDomain) := ='gxg_scale * gxg_sign * '+Grondwaterstanden_pad+'/GHG_'+WWL_Zichtjaar;
				attribute<float32> glg_cm       (AdminDomain) := ='gxg_scale * gxg_sign * '+Grondwaterstanden_pad+'/GLG_'+WWL_Zichtjaar;

				attribute<int32>   ghg_index    (AdminDomain) := IsDefined(ghg_cm) ? int32(max_elem(0f, min_elem(300f, ghg_cm)) + 0.5f) : null_i;
				attribute<int32>   glg_index    (AdminDomain) := IsDefined(glg_cm) ? int32(max_elem(0f, min_elem(300f, glg_cm)) + 0.5f) : null_i;
			}

			attribute<uint64>  key              (AdminDomain) := (((uint64(input/beregenings_code)*8192u64 + uint64(input/bodem_code))*32u64 + uint64(input/gewas_code))*512u64 + uint64(input/ghg_index))*512u64 + uint64(input/glg_index);
			attribute<uint32>  match            (AdminDomain) := rlookup(key, lut/key);

			// ----- RESULT
			parameter<String> FileName_Opbrengstderving := '%LocalDataProjDir%/BaseData/Landbouw/WWL_Opbrengstderving/'+NL2120_Varianten_name+'_'+WWL_Zichtjaar+'_'+Gewas_name+'_'+/ModelParameters/StudyArea+'.tif'
			, Descr = "Waar de opbrengstdervingskaart van deze levering, dit anker en dit gewas komt te staan: onder %LocalDataProjDir%, want dit is modeluitvoer en geen brondata, en de gedeelde brondata op
						Nextcloud is schrijf-eenmaal. De studiegebied-suffix hoort erbij omdat AdminDomain met het studiegebied meebeweegt; zonder suffix leest een run op een deelgebied het Nederland-bestand in een
						kleiner domein, met een FileTileArray-fout en een leeg resultaat. Het pad zonder hash; DecoupledFile_T zet de hash erin en geeft het pad door als StorageFile.";

			parameter<String> Opzoeking_Versie := '837'
			, Descr = "Sleutel voor de opzoeklogica van dit sjabloon in de fingerprint: de indeling van de banden in combo, de permutatie naar de opslagvolgorde in wwl_k en de richting van de ghg- en glg-as in
						LUT (#837). Een andere waarde dan in het zijbestand maakt de kaart opnieuw, dus de waarde verandert mee met die logica.";

			parameter<String> GxG_Herkomst := =Grondwaterstanden_pad+'/Herkomst_'+WWL_Zichtjaar
			, Descr = "Waar de GHG- en GLG-kaart van deze levering en dit anker vandaan komen, zoals de grondwaterstanden van Grondwaterstanden_pad dat per levering opgeven: de bestanden met hun vulling, en in NbSGenuanceerd de
						veenoplegging. Voor die levering is dat de invoer van de veenallocatie, dus de fingerprint rekent niets uit.";

			parameter<String> Fingerprint_Opbrengstderving :=
				  'hydrology='       + NL2120_Varianten_name
				+ ';anchor='         + WWL_Zichtjaar
				+ ';crop='           + Gewas_name
				+ ';crop_code='      + string(Gewas_code)
				+ ';study_area='     + /ModelParameters/StudyArea
				+ ';admin_domain='   + /ModelParameters/Advanced/AdminDomain_ref
				+ ';wwl_db='         + WWL_relatie_database/Bestand
				+ ';climate='        + /Classifications/Landbouw/WWL_Klimaatscenarios/name[value(Zichtjaar_klimaat, /Classifications/Landbouw/WWL_Klimaatscenarios)]
				+ ';climate_band='   + string(Zichtjaar_klimaat)
				+ ';crop_codes='     + AsList(string(WWL_relatie_database/WWL_Gewassen/code), ',')
				+ ';soil_codes='     + AsList(string(WWL_relatie_database/codes/bodem/code), ',')
				+ ';'                + GxG_Herkomst
				+ ';soil='           + /SourceData/Bodem/BOFEK_Bestand
				+ ';soil_fill='      + /SourceData/Bodem/BOFEK/Vulling_Versie
				+ ';irrigation='     + /ModelParameters/Landbouw/BeregeningScenario_name
				+ ';irrigation_map=' + Beregeningskaart_Bestand
				+ ';'                + /SourceData/Landbouw/Verzilting/Herkomst
				+ ';salt_group='     + /Classifications/Landbouw/ZoutgevoeligheidK/name[Zoutgroep]
				+ ';gxg_scale='      + string(gxg_scale)
				+ ';gxg_sign='       + string(gxg_sign)
				+ ';lookup='         + Opzoeking_Versie
			, Descr = "Alle invoer die de kaart bepaalt, ook wat al in de bestandsnaam staat: levering, anker, gewas, studiegebied en resolutie, de netcdf en de klimaatband, de volgorde van gewassen en
						bodemcodes waarop de banden zijn ingedeeld, de grondwaterstanden (GxG_Herkomst), BOFEK met haar vulling, de beregening met de verzilting en de opzoeklogica zelf.";

			container Decoupling_Opbrengstderving := /Templates/DecoupledFile_T(FileName_Opbrengstderving, Fingerprint_Opbrengstderving, 'Write_Kaart');

			attribute<float32> Calc_Opbrengstderving (AdminDomain) := lut/dmgtot_stack[match] / 100f
			, Descr = "De opbrengstderving per gewas als fractie, afgeleid uit BOFEK, de WWL-relatiedatabase en de grondwaterstanden van dit anker. Hier zit de zware kant van de keten: per gewas worden honderden
						banden uit de netcdf gelezen.";

			attribute<float32> Write_Kaart (AdminDomain) := Calc_Opbrengstderving, StorageName = "=Decoupling_Opbrengstderving/StorageFile", StorageType = "gdalwrite.grid"
			, IntegrityCheck = "not(all(IsNull(this))) && not(all(IsZero(this)))"
			, Descr = "Schrijft de kaart weg, zonder zijbestand; dat volgt via Make_Opbrengstderving. De IntegrityCheck vangt een kaart die helemaal leeg of nul is; dat is geen uitkomst maar een gemiste
						opzoeking of een bron die niet openging, en zonder toets zou die kaart met een kloppende fingerprint worden weggeschreven.";

			attribute<float32> Make_Opbrengstderving (AdminDomain) := Write_Kaart, ExplicitSuppliers = "Decoupling_Opbrengstderving/Write_Fingerprint"
			, Descr = "Maakt de kaart en daarna het zijbestand. Schrijft bij elke aanroep, ook als de fingerprint klopt; de haken in OpbrengstenDerving_Dynamisch vragen dit item.";

			attribute<float32> Read_Opbrengstderving (AdminDomain) : StorageName = "=Decoupling_Opbrengstderving/StorageFile", StorageType = "gdal.grid", StorageReadOnly = "TRUE"
			, Descr = "De weggeschreven kaart teruglezen, zonder de netcdf aan te raken.";

			attribute<float32> Opbrengstderving (AdminDomain) := =/ModelParameters/OpbrengstdervingOntkoppeld ? (Decoupling_Opbrengstderving/MayReuse ? 'Read_Opbrengstderving' : 'Make_Opbrengstderving') : 'Calc_Opbrengstderving'
			, Descr = "Wat de rest van het model leest. Met OpbrengstdervingOntkoppeld op TRUE de weggeschreven kaart zolang de fingerprint klopt en anders een nieuwe, op FALSE de afleiding zelf zonder te schrijven.
						Decoupling_Opbrengstderving/Explanation zegt waarom de kaart wel of niet opnieuw wordt gemaakt.";
		}
	}
}
