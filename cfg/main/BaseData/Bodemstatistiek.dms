// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De CBS-bodemstatistiek per cel, en de functievlaggen die eruit volgen. Zie #781.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bodemstatistiek : using = "Classifications/Actor;Classifications/Grondgebruik"
, Descr = "De CBS-bodemstatistiek van BBG_Year op AdminDomain, en de vlaggen die het model eruit leest (#781). Naast de stand-administratie in BaseData/StartState/Landgebruik en niet erin, want die is
			LGN als fysieke basis, verbijzonderd met de beheertypenkaart en de BRP, en aan het pad hoort te zien te zijn welke bron een lezer gebruikt. Geen herintroductie van de bodemstatistiek als
			basiskaart: wat hier blijft is wat zij als enige bron zegt, functie in plaats van bedekking; welke lezers dat zijn en waarom ze mogen blijven staat in #781, waar een vervangingspoging op de
			BGT maar een klein deel van het exogene schild dekte."
{
	attribute<CBSKlasse> gg_CBS (AdminDomain) := ='SourceData/Grondgebruik/BBG/dominant/Per_AdminDomain/Y'+ModelParameters/BBG_Year
	, Descr = "CBS grondgebruik klasse in het basisjaar. Leest de bron rechtstreeks, dus zonder omweg langs de stand-administratie."
	{
		attribute<CBSKlasse/Aggr> Per_Aggr (AdminDomain) := CBSKlasse/Aggr_rel[.], Descr = "Aggregatie van CBS grondgebruik klassen naar de aggregatie klasse";
	}

	attribute<Bool> IsWerklocatie (AdminDomain) := CBSKlasse/IsWerklocatie[gg_CBS], Descr = "Is het een werklocatie volgens CBS definitie?";
	attribute<Bool> IsWoonlocatie (AdminDomain) := CBSKlasse/IsWoonlocatie[gg_CBS], Descr = "Is het een woonlocatie volgens CBS definitie?";
	attribute<Bool> IsGrootWater  (AdminDomain) := CBSKlasse/IsGrootWater[gg_CBS], Descr = "Is het groot water volgens CBS definitie?";
	attribute<Bool> IsGroen       (AdminDomain) := CBSKlasse/IsGroen[gg_CBS], Descr = "Is het groen volgens CBS definitie?";
	attribute<Bool> IsBouwterrein (AdminDomain) := gg_CBS == CBSKlasse/V/bouwterrein, Descr = "Is het bouwterrein volgens CBS definitie?";

	attribute<Bool> IsExogeen (AdminDomain) := CBSKlasse/IsExogeen[gg_CBS]
	, Descr = "Grondgebruik dat buiten de allocatie en de exogene oplegging blijft: infrastructuur en begraafplaatsen, dus hoofdweg, spoorterrein, begraafplaats, semi-verhard overig terrein, vliegveld en
				metro en sneltram. Een keer hier, in plaats van twee keer los uitgeschreven. Uit de BGT is dit niet te halen, want de bodemstatistiek kent een wegzone inclusief bermen en knooppunten en de
				BGT de rijbaan als object (#781).";
}
