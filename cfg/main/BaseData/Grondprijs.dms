////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Hedonische grondprijs per cel van 100 m naar de methode van Stad en Land (CPB 2010), uit de grondprijs per PC4 en per
// gemeente die PriceIndices schat uit de NVM-verkopen (stap 7, perceel in ln, de helling van een PC4 gekrompen naar die van
// zijn gemeente). Per jaar van de kaart twee csv's in Map. SourceData/Diversen/PerDomainT geeft de kaarten door als
// Hedonic_landPrice_<jaar>, naast Hedonic_landPrice_2007, de kaart van Stad en Land zelf.
//
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Grondprijs
: Descr = "De hedonische grondprijs per m2 perceel per cel van 100 m, in euro's van het jaar van de kaart. Een cel krijgt de PC4 die onder zijn adressen het meest voorkomt, een cel zonder adres de PC4 van de dichtstbijzijnde cel met een adres, en een PC4 zonder verkopen de grondprijs van de gemeente van de cel."
{
	parameter<String> Map := '%RSo_DataDir%/Omgeving/Grondprijs', Descr = "De map met per jaar Hedonic_landPrice_pc4_<jaar>.csv (pc4, n, p_m2, bron_helling) en Hedonic_landPrice_gemeente_<jaar>.csv (gemeente_code, p_m2), de uitvoer van PriceIndices.";

	unit<uint32> Gemeente := /SourceData/RegioIndelingen/CBS/Gekozen/Gemeente;
	unit<uint32> Vbo      := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(BAG_RecentYear) + '/vbo';

	unit<uint32> Adres := select_with_org_rel(IsDefined(Vbo/geometry) && strlen(Vbo/postcode) >= 4)
	, Descr = "De verblijfsobjecten van de BAG van BAG_RecentYear met een ligging en een postcode."
	{
		attribute<rdc_meter> geometry     := Vbo/geometry[org_rel];
		attribute<UInt16>    PC4          := UInt16(left(Vbo/postcode[org_rel], 4));
		attribute<rdc_100m>  rdc_100m_rel := geometry[rdc_100m];
	}

	attribute<UInt16>   PC4_Adres     (rdc_100m) := modus(Adres/PC4, Adres/rdc_100m_rel), Descr = "De PC4 die het vaakst voorkomt onder de adressen van de cel, leeg in een cel zonder adres.";
	attribute<Gemeente> Gemeente_Vlak (rdc_100m) := poly2grid(Gemeente/geometry, rdc_100m), Descr = "De gemeente waarin het middelpunt van de cel ligt.";

	unit<uint64> CelMetAdres := select_with_org_rel(IsDefined(PC4_Adres) && IsDefined(Gemeente_Vlak))
	, Descr = "De cellen met een adres en een gemeente, waarvan een cel zonder adres of zonder gemeente die overneemt."
	{
		attribute<rdc_meter> geometry     := rdc_100m/point[org_rel];
		attribute<UInt16>    PC4          := PC4_Adres[org_rel];
		attribute<Gemeente>  Gemeente_rel := Gemeente_Vlak[org_rel];
	}

	attribute<CelMetAdres> Dichtstbij   (rdc_100m) := connect(CelMetAdres/geometry, rdc_100m/point), Descr = "De dichtstbijzijnde cel met een adres en een gemeente.";
	attribute<UInt16>      PC4          (rdc_100m) := MakeDefined(PC4_Adres, CelMetAdres/PC4[Dichtstbij]);
	attribute<Gemeente>    Gemeente_rel (rdc_100m) := MakeDefined(Gemeente_Vlak, CelMetAdres/Gemeente_rel[Dichtstbij]);

	Template Jaar_T
	: Descr = "De kaart van een jaar uit de twee csv's van dat jaar."
	{
		parameter<String> Jaar;
		//
		unit<uint32> PerPC4
		:	StorageName     = "=Map + '/Hedonic_landPrice_pc4_' + Jaar + '.csv'"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<UInt16> Nr    := UInt16(pc4);
			attribute<Eur_m2> Prijs := Float32(p_m2)[Eur_m2];
		}
		unit<uint32> PerGemeente
		:	StorageName     = "=Map + '/Hedonic_landPrice_gemeente_' + Jaar + '.csv'"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Eur_m2> Prijs := Float32(p_m2)[Eur_m2];
		}

		attribute<PerGemeente> PerGemeente_rel (Gemeente) := rlookup(Gemeente/statcode, PerGemeente/gemeente_code), IntegrityCheck = "all(IsDefined(this))", Descr = "De regel van de gemeente in de csv; de check bewaakt dat de csv dezelfde gemeente-indeling heeft als het model.";
		attribute<Eur_m2>      Grondprijs     (rdc_100m) := MakeDefined(PerPC4/Prijs[rlookup(PC4, PerPC4/Nr)], PerGemeente/Prijs[PerGemeente_rel][Gemeente_rel]), IntegrityCheck = "all(IsDefined(this))", Descr = "De grondprijs van de PC4 van de cel, of die van zijn gemeente als de PC4 geen verkopen had.";
	}

	container Y2012 := Jaar_T('2012'), Descr = "Uit de verkopen van 2003 tot en met 2012.";
	container Y2017 := Jaar_T('2017'), Descr = "Uit de verkopen van 2008 tot en met 2017, voor de herschatting van de logits voor werken en verblijfsrecreatie op de bouw van 2017 tot 2022.";
	container Y2023 := Jaar_T('2023'), Descr = "Uit de verkopen van 2014 tot en met 2023, de meest recente stand.";
}
