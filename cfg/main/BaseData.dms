// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file bevat de zgn. baseData die het model nodig heeft voor de verschillende berekeningen/analyses. BaseData zijn altijd afgeleid van de SourceData en soms ontkoppeld (geexporteerd vanuit SourceData).
// De Data worden on-the-fly gegenereerd of, indien reeds gegenereerd (ontkoppeld), ingelezen vanuit de LocalDataDir.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container BaseData: using = "Classifications;Units;Geography;ModelParameters"
{
	container BAG_ModelJaar  := = 'SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear), Descr = "Container voor de BAG in het model BAG jaar";
	container BAG_RecentJaar := = 'SourceData/Vastgoed/BAG/PerJaar/Y'+string(BAG_RecentYear), Descr = "Container voor de BAG in het meest recente BAG jaar";
	
	container StartState
	{
		#include<StateBasisjaar.dms> 
		#include<PandFootprint.dms>
		#include<BAG_nieuwbouw.dms> //nieuwbouw vanaf model jaar tot recent jaar
		#include<Landgebruik.dms>
		#include<Eigendom.dms>
		#include<Verdeling_VSSH.dms>
		#include<AlternatieveLISA.dms>
		#include<VerzorgendBijWonen.dms> //banen per woning in bestaand woongebied, grondslag voor het verzorgend werken in een woon-OP (#710)
		#include<VerblijfsrecreatieTrends.dms> //trends berekening tbv claims
		
		attribute<Verblijfsobject> VBOs_ModelJaar (AdminDomain) := count(BAG_ModelJaar/vbo/geometry, BAG_ModelJaar/vbo/AdminDomain_rel)[Verblijfsobject]
		, Descr = "Aantal VBOs in het model jaar per AdminDomain"
		{
			attribute<m2_vbo> Oppervlakte (AdminDomain) := sum(BAG_ModelJaar/VBO/oppervlakte_trunc, BAG_ModelJaar/VBO/AdminDomain_rel)
			, Descr = "Totale oppervlakte van VBOs in het model jaar per AdminDomain"
			{
				container Per_gebruiksdoel :=
					for_each_nedv(
						Vastgoed/vbo_gebruiksdoel/name,
						'sum(
							BAG_ModelJaar/VBOs/GebruiksdoelSets/'+Vastgoed/vbo_gebruiksdoel/name+'/GebruiksdoelSet/oppervlakte_trunc,
							BAG_ModelJaar/VBOs/GebruiksdoelSets/'+Vastgoed/vbo_gebruiksdoel/name+'/GebruiksdoelSet/AdminDomain_rel 
						)',
						AdminDomain, m2_vbo
				), Descr = "Oppervlakte van VBOs in het model jaar per AdminDomain, uitgesplitst naar gebruiksdoel";
			}
			
			container Per_gebruiksdoelSrc :=
				for_each_nedv(
					Vastgoed/vbo_gebruiksdoel/name
					,'BAG_ModelJaar/VBOs/GebruiksdoelSets/'+Vastgoed/vbo_gebruiksdoel/name+'/GebruiksdoelSet/count_Per_AdminDomain'
					, AdminDomain
					, Verblijfsobject
			), Descr = "Aantal VBOs in het model jaar per AdminDomain, uitgesplitst naar gebruiksdoel";
			
			container Per_gebruiksdoel :=
				for_each_nedv(
					Vastgoed/vbo_gebruiksdoel/name
					,'Per_gebruiksdoelSrc/'+Vastgoed/vbo_gebruiksdoel/name+' / AdminDomain/NrHaPerCell'
					, AdminDomain
					, vbo_ha
			), Descr = "Aantal VBOs per ha in het model jaar per AdminDomain, uitgesplitst naar gebruiksdoel";
		}
	}
	
	container Densities
	{
		#include<PandFootprint_baan.dms>
	}
	
	container Omgeving
	{
		#include<OV_Reistijd.dms>
		
		attribute<Bool> IsSlappeBodem (AdminDomain) := /SourceData/Water/TeSlap/IsSlap_25mtr;
		
		container RuimteVoorRivierafvoer
		{
			container BaU
			{
				attribute<Bool> Gebiedsreservering                (AdminDomain) := SourceData/Omgevingsrecht/AMvB/NL_IMRO_0000_BZKamGCBarro_5025/Kaart4/Gebiedsreservering/Multi/Result, Descr = "Gebiedsreservering voor rivierbedverruiming";
				attribute<Bool> Stroomvoerend_deel_rivierbed      (AdminDomain) := SourceData/Omgevingsrecht/AMvB/NL_IMRO_0000_BZKamGCBarro_5025/Kaart4/Stroomvoerend_deel_rivierbed/Multi/Result, Descr = "Stroomvoerend deel rivierbed";
			
				attribute<Bool> Result (AdminDomain) := Gebiedsreservering || Stroomvoerend_deel_rivierbed;
			}
			
			container Transformatief
			{
				attribute<Bool> RuimteVoorDeRivier_GroeneRivieren        (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_GroeneRivieren2/IsDefined;
				attribute<Bool> RuimteVoorDeRivier_GroteDijkverleggingen (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_GroteDijkverleggingen/IsDefined;
				attribute<Bool> RuimteVoorDeRivier_OverigeRetentie       (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_OverigeRetentie/IsDefined;
				attribute<Bool> RuimteVoorDeRivier_Retentiegebieden      (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_Retentiegebieden/IsDefined;
				attribute<Bool> Spankracht_komberging                    (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/Spankracht_komberging/IsDefined;
				attribute<Bool> Spankracht_Retentie                      (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/Spankracht_Retentie/IsDefined;
				attribute<Bool> GroeneRivieren_OnbedijkteMaas            (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/GroeneRivieren_OnbedijkteMaas/IsDefined;
				attribute<Bool> Natuurlijk_Rivierdal                     (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/Natuurlijk_Rivierdal/IsDefined;
				
				attribute<Bool> Result (AdminDomain) := 
					BaU/Result ||
					RuimteVoorDeRivier_GroeneRivieren ||
					RuimteVoorDeRivier_GroteDijkverleggingen ||
					RuimteVoorDeRivier_OverigeRetentie ||
					RuimteVoorDeRivier_Retentiegebieden ||
					Spankracht_komberging ||
					Spankracht_Retentie ||
					GroeneRivieren_OnbedijkteMaas ||
					Natuurlijk_Rivierdal;
			}
			
			container NbSMAx
			{
				attribute<Bool> RuimteVoorDeRivier_GroeneRivieren        (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_GroeneRivieren2/IsDefined;
				attribute<Bool> RuimteVoorDeRivier_GroteDijkverleggingen (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_GroteDijkverleggingen/IsDefined;
				attribute<Bool> RuimteVoorDeRivier_OverigeRetentie       (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_OverigeRetentie/IsDefined;
				attribute<Bool> RuimteVoorDeRivier_Retentiegebieden      (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/RuimteVoorDeRivier_Retentiegebieden/IsDefined;
				attribute<Bool> Spankracht_komberging                    (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/Spankracht_komberging/IsDefined;
				attribute<Bool> Spankracht_Retentie                      (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/Spankracht_Retentie/IsDefined;
				attribute<Bool> GroeneRivieren_OnbedijkteMaas            (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/GroeneRivieren_OnbedijkteMaas/IsDefined;
				attribute<Bool> Natuurlijk_Rivierdal                     (AdminDomain) := SourceData/Water/RuimteVoorRivierafvoer/Natuurlijk_Rivierdal/IsDefined;
				
				attribute<Bool> Result (AdminDomain) := 
					BaU/Result ||
					RuimteVoorDeRivier_GroeneRivieren ||
					RuimteVoorDeRivier_GroteDijkverleggingen ||
					RuimteVoorDeRivier_OverigeRetentie ||
					RuimteVoorDeRivier_Retentiegebieden ||
					Spankracht_komberging ||
					Spankracht_Retentie ||
					GroeneRivieren_OnbedijkteMaas ||
					Natuurlijk_Rivierdal;
			}
			
			container NbSGenuanceerd
			{
			}
		}
		
		attribute <bool> UrbanContour (AdminDomain) := /SourceData/RegioIndelingen/BegrenzingBebouwdGebied/Is_BebouwdGebied
		, Descr = "Bestaand bebouwd gebied volgens de eigen begrenzing per peiljaar, ModelParameters/BegrenzingBebouwdGebied_jaar. Verving de unie die hier stond, die naast het VROM-raster uit 2003 ook elke cel met een woning of werklocatie meetelde, waardoor verspreide bebouwing als bebouwd gebied gold; die unie is bij #749 verwijderd omdat hij nergens meer werd opgevraagd.
					Sinds #749 leest Omgeving/UrbanContour dezelfde begrenzing, dus het model kent nog maar een definitie van bestaand bebouwd gebied. Wat er nog naast staat is RondBevolkingskern hieronder, en dat is een andere grootheid: dat zijn buffers rond kernen boven of onder een inwonertal, en daar is de bevolkingskernindeling de bron voor omdat de begrenzing bebouwd gebied geen inwonertal draagt.";

		container KantoorDominantie
		: Descr = "Waar is zakelijke dienstverlening in het basisjaar de dominante werksubsector? Bron voor de verdikkingsingrepen van #668: de potentieelvloer in de dichtheid, de voorrangstrede en de zeefvrijstellingen gelden alleen op deze cellen. Bewust op de basisjaarstand verankerd, net als de rest van de potentieel- en zeefketen, zodat er geen kringverwijzing met de allocatie ontstaat."
		{
			attribute<Float32> KantoorBanen (AdminDomain) := (/BaseData/StartState/StateBasisjaar/State/Werken/Zak_dienstverlening[float32]), Descr = "Kantoorbanen in het basisjaar per cel van 25 meter.";
			attribute<Float32> WerkBanen    (AdminDomain) := (/BaseData/StartState/StateBasisjaar/State/Werken/Nijverheid[float32]
				+ /BaseData/StartState/StateBasisjaar/State/Werken/Logistiek[float32]
				+ /BaseData/StartState/StateBasisjaar/State/Werken/Detailhandel[float32]
				+ /BaseData/StartState/StateBasisjaar/State/Werken/Ov_consumentendiensten[float32]
				+ /BaseData/StartState/StateBasisjaar/State/Werken/Zak_dienstverlening[float32]
				+ /BaseData/StartState/StateBasisjaar/State/Werken/Overheid_kw_diensten[float32]), Descr = "Alle werkbanen in het basisjaar per cel van 25 meter.";
			attribute<Float32> KantoorAandeel    (AdminDomain) := MakeDefined(KantoorBanen / WerkBanen, 0f), Descr = "Aandeel van kantoor in de werkbanen van de cel; 0 waar geen werk is.";
			attribute<Bool>    IsKantoorDominant (AdminDomain) := KantoorBanen > 0f && KantoorAandeel >= /ModelParameters/Werken/KantoorDominantieDrempel, Descr = "Cel waar kantoor de werkstand domineert. Op deze cellen is toewijzing aan kantoor verdikking van de bestaande voorraad en geen nieuwbouw.";
			attribute<Float32> WerkBanenWaarKantoorDominant (AdminDomain) := IsKantoorDominant ? WerkBanen : 0f, Descr = "De werkstand op de dominante cellen, als grondslag voor de potentieelvloer; elders 0, zodat een max_elem daar niets doet.";
		}

		container Opleggingsmasker
		: Descr = "Waar mag het model een ander grondgebruik neerzetten dan er nu ligt? Een masker over het AdminDomain, gedeeld door iedereen die die vraag stelt. Zie #661.

				De toets stond eerder drie keer los opgeschreven, en die drie liepen uit elkaar. Templates/VariantData_T
				toetste bij ExogeenOpleggen op bestaand bebouwd gebied en op exogeen grondgebruik,
				Templates/SourceData/NatuurAlloc_T en Diagnose/NatuurOverzicht alleen op bestaand bebouwd gebied. Gevolg
				was dat de natuurallocatie natuur kon neerzetten op hoofdwegen, spoor, vliegvelden en begraafplaatsen, en
				dat de diagnosekolom die zegt hoeveel er na het masker overblijft te hoog uitkwam. Nu leest elk van de
				drie dit item.
				HeeftPanden staat er bewust naast en niet in. Zie de toelichting daar."
		{
			attribute<Bool> IsBestaandBebouwdGebied (AdminDomain) := /BaseData/Omgeving/UrbanContour
			, Descr = "Bestaand bebouwd gebied volgens de eigen begrenzing, peiljaar uit ModelParameters/BegrenzingBebouwdGebied_jaar. Dat zijn vlakken op volle resolutie, dus dorpen en dorpsranden vallen erbinnen en verspreide bebouwing erbuiten. Zie #641 voor waarom de oplegging hier vervalt.";

			attribute<Bool> IsExogeenGrondgebruik (AdminDomain) := MakeDefined(/Classifications/Grondgebruik/CBSKlasse/IsExogeen[/BaseData/StartState/Landgebruik/gg_cbs], FALSE)
			, Descr = "Grondgebruik dat het model niet omzet: hoofdwegen, spoorwegen, vliegvelden en begraafplaatsen. Dat is de groep Infra plus Begraafplaats uit de CBS-bodemstatistiek, dezelfde vlag waarmee de landgebruikskaart deze cellen al ongemoeid laat. Toegevoegd op verzoek vanuit Deltares op 26 augustus 2026, nadat de veenlevering natuur over Schiphol heen legde en de luchthaven daarmee wegsloopte.";

			attribute<Bool> MagOpleggen (AdminDomain) := !IsBestaandBebouwdGebied && !IsExogeenGrondgebruik
			, Descr = "Mag een exogene levering deze cel raken? In alle varianten hetzelfde. Valt de oplegging weg, dan blijft de bebouwing staan en gaat het gebied via Bouwregime hooguit op slot voor nieuwbouw.

					De pandentoets zit hier niet in, en dat is het onderscheid dat #661 maakt. Een levering zegt waar
					iets moet komen en heeft die afweging al gemaakt: bij veen, kust en rivieren is het bouwregime
					Slopen, dus daar is de sloop de bedoeling. Een allocatie kiest zelf en kan dus uitwijken naar een
					onbebouwde cel binnen dezelfde claimregio. Alleen die tweede leest HeeftPanden.";

			attribute<Bool> HeeftPanden (AdminDomain) := ='/SourceData/Vastgoed/BAG/PerJaar/Y'+string(/ModelParameters/BAG_RecentYear)+'/pand/Counts/Per_AdminDomain > 0f'
			, Descr = "Staat er een BAG-pand in de cel, geheel of gedeeltelijk? Dit is de pandentoets op 25 m van het model. De natuurallocatie van #661 leest hem, en sinds #770 ook de zichtjaar-zeef voor zon en wind, via Zeef_T/Src/HeeftPandenInCelInBasisjaar.

					Alle panden, niet alleen woonpanden. #630 zegt dat de bestaande bebouwing in de beekdalen blijft
					staan, en dat gaat net zo goed over een schuur of een bedrijfspand als over een woning.

					Peiljaar is het meest recente BAG-jaar en niet het modeljaar: de nieuwbouw tussen modeljaar en recent
					jaar komt via BaseData/StartState/BAG_nieuwbouw alsnog in de stand terecht. De prijs is dat een pand
					dat na het modeljaar gesloopt is hier niet meer meetelt.

					Deze Descr beweerde tot #605 dat de landbouwzeef dezelfde toets kent en precies dit item leest, en
					dat de keuze van het peiljaar daarmee een tweede toedelingsmatrix bespaarde. Geen van drieen klopte.
					Het item PandenInBasisjaar in Zeef_Basisjaar_T stond sinds februari 2025 zonder afnemer en is bij #605
					verwijderd; de landbouwzeef heeft dus geen pandentoets. De vraag of landbouw er een hoort te krijgen
					staat open in #605, met de kanttekening dat MinimalLandAvailability_Landbouw van 0,60 ha per cel die
					vraag nu al beantwoordt en dat de gepubliceerde methode op de wiki geen pandentoets kent.";
		}
		
		container RondBevolkingskern 
		{
			attribute<Bool> Is100kPlus (AdminDomain) := =/ModelParameters/Advanced/RondBevolkingskernVolgtUrbanContour
					? 'SourceData/RegioIndelingen/BegrenzingBebouwdGebied/Maak_PopK_Buffers/isMeerdan100Kinw/select/split_geometry/MetBuffer/Is_Buffer'
					: 'Maak_PopK_Buffers/isMeerdan100Kinw/select/split_geometry/MetBuffer/Is_Buffer'
			, Label = "100K", Descr = "Een buffer van een kilometer rond de kernen in deze populatieklasse. De bron hangt aan ModelParameters/Advanced/RondBevolkingskernVolgtUrbanContour: de bevolkingskernen van 2011, of de begrenzing bebouwd gebied van 2022 met het inwonertal uit de CBS-vierkanten van 2023 (#749).";
			attribute<Bool> Is20kPlus (AdminDomain) := =/ModelParameters/Advanced/RondBevolkingskernVolgtUrbanContour
					? 'SourceData/RegioIndelingen/BegrenzingBebouwdGebied/Maak_PopK_Buffers/isMeerdan20Kinw/select/split_geometry/MetBuffer/Is_Buffer'
					: 'Maak_PopK_Buffers/isMeerdan20Kinw/select/split_geometry/MetBuffer/Is_Buffer'
			, Label = "25K", Descr = "Een buffer van een kilometer rond de kernen in deze populatieklasse. De bron hangt aan ModelParameters/Advanced/RondBevolkingskernVolgtUrbanContour: de bevolkingskernen van 2011, of de begrenzing bebouwd gebied van 2022 met het inwonertal uit de CBS-vierkanten van 2023 (#749).";
			attribute<Bool> Is20kMin (AdminDomain) := =/ModelParameters/Advanced/RondBevolkingskernVolgtUrbanContour
					? 'SourceData/RegioIndelingen/BegrenzingBebouwdGebied/Maak_PopK_Buffers/isMinderdan20Kinw/select/split_geometry/MetBuffer/Is_Buffer'
					: 'Maak_PopK_Buffers/isMinderdan20Kinw/select/split_geometry/MetBuffer/Is_Buffer'
			, Label = "20K", Descr = "Een buffer van een kilometer rond de kernen in deze populatieklasse. De bron hangt aan ModelParameters/Advanced/RondBevolkingskernVolgtUrbanContour: de bevolkingskernen van 2011, of de begrenzing bebouwd gebied van 2022 met het inwonertal uit de CBS-vierkanten van 2023 (#749).";
		}
		
		attribute<Float32> BelevingLandschap (AdminDomain) := SourceData/Diversen/Per_AdminDomain/BelevingLandschap/NoMissing
		{
			attribute<Bool> IsKleinerDanZesPunt5  (AdminDomain) := . < 6.5f, Descr = "Beleving landschap score is lager dan 6.5";
			attribute<Bool> IsGroterDanZeven      (AdminDomain) := . > 7.0f, Descr = "Beleving landschap score is hoger dan 7.0";
			attribute<Bool> IsGroterDanZevenPunt3 (AdminDomain) := . > 7.3f, Descr = "Beleving landschap score is hoger dan 7.3";
			attribute<Bool> IsZeerLaag            (AdminDomain) := IsKleinerDanZesPunt5, Descr = "Beleving landschap score is zeer laag (lager dan 6.5)";
			attribute<Bool> IsLaag                (AdminDomain) := !IsHoog, Descr = "Beleving landschap score is laag (lager dan 7.0)";
			attribute<Bool> IsHoog                (AdminDomain) := IsGroterDanZeven, Descr = "Beleving landschap score is hoog (hoger dan 7.0)";
			attribute<Bool> IsZeerHoog            (AdminDomain) := IsGroterDanZevenPunt3, Descr = "Beleving landschap score is zeer hoog (hoger dan 7.3)";
			attribute<Bool> IsZeerZeerHoog        (AdminDomain) := . > 7.6f, Descr = "Beleving landschap score is zeer zeer hoog (hoger dan 7.6)";
			attribute<Float32> Potential          (AdminDomain) := potential(., Distmatrices/Impl_25m/pot2000m/PotRange/rev_dist_scaled) / sum(Distmatrices/Impl_25m/pot2000m/PotRange/rev_dist_scaled)
			, Descr = "Potentiaal van de beleving landschap score binnen 2km, gebaseerd op een omgekeerde afstandsvervalfunctie"
			{
				attribute<Bool> IsGroterDanZeven      (AdminDomain) := . >= 7.0f, Descr = "Beleving landschap score is groter dan of gelijk aan 7.0";
				attribute<Bool> IsGroterDanZevenPunt3 (AdminDomain) := . >= 7.3f, Descr = "Beleving landschap score is groter dan of gelijk aan 7.3";
				attribute<Bool> IsHoog                (AdminDomain) := IsGroterDanZeven, Descr = "Beleving landschap score is hoog (hoger dan of gelijk aan 7.0)"
				{
					attribute<Bool> EnBelevingIsNietHoog (AdminDomain) := IsHoog && !BelevingLandschap/IsHoog;
					attribute<Bool> EnBelevingIsLaag     (AdminDomain) := IsHoog && BelevingLandschap/IsLaag;
				}
				
				attribute<Bool> IsZeerHoog (AdminDomain) := IsGroterDanZevenPunt3, Descr = "Beleving landschap score is zeer hoog (hoger dan of gelijk aan 7.3)"
				{
					attribute<Bool> EnBelevingIsNietHoog (AdminDomain) := IsZeerHoog && !BelevingLandschap/IsHoog;
				}
			}
		}
		
		attribute<Classifications/Overstromingsgevaarzonering/zoneringK> Overstromingsgevaarzonering (AdminDomain) := SourceData/Water/Overstromingsgevaarzonering;
		
		attribute<meter> Overstromingsdiepte              (AdminDomain) := SourceData/Water/Dieptekaart[meter], Descr = "Gemiddelde overstromingsdiepte in meters";
		attribute<meter> OverstromingsdiepteOud           (AdminDomain) := value(SourceData/Water/DieptekaartOud == -9999f ? const(0f, AdminDomain) : SourceData/Water/DieptekaartOud, meter), Descr = "Gemiddelde overstromingsdiepte in meters";
		
		attribute<Bool> NietOverstroombaar                (AdminDomain) := IsNull(Overstromingsdiepte) || Overstromingsdiepte <= 0[meter]
		, Descr = "De dieptelezing van hoge grond: de maximumdieptekaart geeft hier geen overstroming. Tot #698 was dit de definitie van HogeGronden, geschreven als !(diepte > 0); sindsdien is dat de fysisch-geografische lezing hieronder en dient dit item nog als terugval daarvan.
					Het zwaartepunt zit in de null en niet in de nul: van de 1.821.012 ha die hier uitkomt heeft 1.767.506 ha helemaal geen waarde in de kaart en 53.506 ha een diepte van precies nul. De null staat er nu expliciet, want juist die stille tak veranderde bij #665 van betekenis toen de bergingsgrens van tien meter uit de dieptekaart naar ModelParameters/Waterberging/Maximum_Waterschijf verhuisde: cellen boven die grens droegen daarna een echte diepte en vielen hier uit. Dat verzette 357 ha.";

		attribute<Bool> HogeGronden                       (AdminDomain) := IsDefined(SourceData/Landschap/BasiskaartNatuurlijkSysteemNederlandK/BNSN_rel_AdminDomain)
			? Classifications/Landschap/BasiskaartNatuurlijkSysteemNederlandK/IsHoogNederland[SourceData/Landschap/BasiskaartNatuurlijkSysteemNederlandK/BNSN_rel_AdminDomain]
			: NietOverstroombaar
		, Descr = "Hoge gronden: de pleistocene helft van de Basiskaart Natuurlijk Systeem Nederland. Welke hoofdklasse aan welke kant valt staat als kolom IsHoogNederland in de classificatie en niet hier.
					Tot #698 was dit de dieptelezing hierboven, NietOverstroombaar. Dat was een proxy: hoge grond was elke cel waar de maximumdieptekaart niets geeft. De twee geven landelijk bijna hetzelfde totaal, 1.820.435 tegen 1.821.012 ha, dus 577 ha verschil, terwijl er 588.279 ha van kant wisselt: 16,9 procent van het land. Vooral zeeklei telde in de dieptelezing voor 145.227 ha als hoge grond omdat de kaart daar leeg is, en van het dekzand viel 166.112 ha aan de lage kant.
					Waarom de fysische geografie en niet de diepte. Dit item heeft vier lezers. Via NbSOPToepassingsgebied/Hoog_NL bepaalt het (1) welke NbS-ontwikkelpakketten waar mogen landen, waar de HNL-pakketten groen maken en de LNL-pakketten water; (2) of het groen in een ontwikkelpakket als naaldbos of als loofbos in de koolstofindicator telt, zie #699; (3) of doorlatend groen in de waterbergingsindicator meetelt, want alleen op hoge grond infiltreert het; en (4) de trede IsHoogNL, die vandaag door geen enkele lopende variant wordt gebruikt. Alleen de eerste lezer heeft een overstromingskant, en die wordt in de zeef al apart en op de werkelijke diepte getoetst via Zeef_Wonen_perOP_T/Impl/BouwwijzeNietOverstromingsbestendig. Wat de HNL/LNL-splitsing daarbovenop doet is de keuze tussen groen en blauw, en dat is net als lezer 2 en 3 een bodem- en grondwatervraag.
					Waar de basiskaart geen hoofdklasse geeft valt hij terug op NietOverstroombaar. Dat is 19.491 ha, waarvan 1.321 ha bebouwd gebied: overwegend grote wateren en de rand langs kust en grens. De terugval is er zodat een ontbrekende polygoon geen cel van betekenis laat veranderen; een kale FALSE zou 11.812 ha stil naar laag Nederland verplaatsen.
					De terugval staat als IsDefined en niet als MakeDefined om de uitkomst heen, want dat laatste doet hier niets: Bool kent in GeoDMS geen null, dus een lookup op een null-index geeft FALSE en niet null, en MakeDefined vindt niets om te vervangen. De eerste opzet had die vorm en liet de terugval stil weg.";
		
		container NbSOPToepassingsgebied
		{
			attribute<bool> Hoog_NL (AdminDomain) := Omgeving/HogeGronden;
			attribute<bool> Laag_NL (AdminDomain) := !Hoog_NL;
			attribute<bool> Overal  (AdminDomain) := Hoog_NL || Laag_NL;
		}


		container Bebouwingstype_Veen_NbSGenuanceerd
		: StorageName = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Veen_NbSgenuanceerd_20260729.gpkg"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "TRUE"
		, DialogData = "rdc_meter"
		{
			unit<uint8> BebouwingstypeK := cat_range(0b, 4b)
			, Descr = "De vier categorieen van de bebouwingstypekaart veen (#614). Ze vallen een op een op een bouwregime, zie Bouwregime_rel: dat is de enige plek waar die vertaling staat."
			{
				attribute<string> Label : ['Aangepast bouwen','Slopen en op slot','Wonen op water','Zoals huidig'];
				attribute<string> name  := AsItemName(label);

				attribute<Classifications/Modellering/BouwregimeK> Bouwregime_rel := union_data(.
					, Classifications/Modellering/BouwregimeK/V/BouwenMetMaatregelen // aangepast bouwen: bouwen mag, maar alleen bodemdalingbestendig
					, Classifications/Modellering/BouwregimeK/V/Slopen              // slopen en op slot
					, Classifications/Modellering/BouwregimeK/V/BouwenMetMaatregelen // wonen op water: bouwen mag, maar alleen drijvend
					, Classifications/Modellering/BouwregimeK/V/Bouwen              // zoals huidig
				), Descr = "Welk bouwregime hoort bij welke categorie. Twee categorieen komen op BouwenMetMaatregelen uit; welke eis daar precies geldt staat niet hier maar in VariantData/<variant>/BouwwijzeEis, want dat is de bouwwijze-as en niet de regime-as.";

				container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
			}

			unit<uint32> bebouwingstype_nbsnuanc 
			{
				attribute<BebouwingstypeK> BebouwingstypeK_rel               := rlookup(LowerCase(bebouwingstype), LowerCase(BebouwingstypeK/label));
				attribute<.>            Per_AdminDomain  (AdminDomain) := poly2grid(geometry, AdminDomain);

				attribute<bool>         SlopenEnOpSlot   (AdminDomain) := BebouwingstypeK_rel[Per_AdminDomain] == BebouwingstypeK/v/Slopen_en_op_slot, IntegrityCheck = "all(IsDefined(BebouwingstypeK_rel) || !IsDefined(bebouwingstype) || bebouwingstype == '')", Descr = "Slopen en op slot uit het landschapstype veen (#614). Heette tot 31 augustus 2026 NietBouwen; die naam dekte de lading niet, want de categorie vraagt naast een bouwverbod ook sloop. Hernoemd op verzoek vanuit Deltares in #684. De IntegrityCheck bewaakt de categorie-lookup: een spelling die niet in BebouwingstypeK staat valt via de rlookup stil terug op zoals huidig, en dan verdwijnt een hele categorie zonder melding. Polygonen zonder waarde zijn wel toegestaan, want die horen volgens de levering als zoals huidig te tellen.";
				attribute<bool>         AangepastBouwen  (AdminDomain) := BebouwingstypeK_rel[Per_AdminDomain] == BebouwingstypeK/v/Aangepast_bouwen;
				attribute<bool>         WonenOpWater     (AdminDomain) := BebouwingstypeK_rel[Per_AdminDomain] == BebouwingstypeK/v/Wonen_op_water, Descr = "Gebieden waar het landschapstype veen alleen drijvend wonen toelaat. Zie #505.";

				attribute<Classifications/Modellering/BouwregimeK> Bouwregime (AdminDomain) := MakeDefined(BebouwingstypeK/Bouwregime_rel[BebouwingstypeK_rel[Per_AdminDomain]], Classifications/Modellering/BouwregimeK/V/Bouwen)
				, Descr = "Het bouwregime van deze cel volgens de bebouwingstypekaart veen. Buiten het ruimtebeslag van de levering, en op polygonen zonder waarde, valt hij op Bouwen terug; dat is wat de levering met zoals huidig bedoelt. Dit is wat VariantData/<variant>/Bouwregime voor het landschapstype Veen ophaalt.";
			}
		}		

		unit<uint32> KansrijkWoningbouw_Rivieren_NbSgenuanceerd
		:	StorageName     = "%RSo_DataDir%/Beleid/Overigen/AndersBouwen/Rivieren_KansrijkWoningbouw_NbSgenuanceerd_20260717.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	DialogType      = "Map"
		,	DialogData      = "geometry"
		,	Source          = "Deltares, team Rivieren NL2120. Oorspronkelijke bestandsnaam kansrijk_woningbouw.shp, geleverd op 2026-08-26 in NbSGenuanceerd.2.zip. De datum in de bestandsnaam is de laatste wijzigingsdatum van de dbf. De eerste levering, van 2026-08-25 in NBS_genuanceerd_voorBart.zip, miste de dbf en de prj en was daarmee geen leesbare shapefile; deze tweede levering is compleet en heeft dezelfde geometrie."
		,	Descr           = "Zeven met de hand getekende zoekgebieden waar woningbouw in het landschapstype Rivieren kansrijk is, samen 56.705 ha, van de Maasvallei tot de IJsseldelta. De levering heeft een enkel veld Id dat overal op nul staat, dus er valt niets aan te sturen: het zijn zeven vlakken zonder gradatie.
							Dit is geen restrictie maar een voorkeur: de kaart komt terecht in de trede voor wonen, en alleen in de variant NbSGenuanceerd. Zie #620.
							Gemeten op 25m telt het zoekgebied 56.702 ha. Daarvan ligt 17.268 ha binnen bestaand bebouwd gebied, waar de klasse BinnenUrbanContour in de trede toch al voorgaat, en 15.548 ha in de riviertrajecten en binnendijkse gebieden die via NietBouwen op slot gaan (#621), waar de zeef wint en de trede niet aan bod komt. Er blijft 24.113 ha over waar de voorkeur werkelijk stuurt."
		{
			attribute<rdc_meter> geometry        (poly);
			attribute<.>         Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			attribute<.>         Per_AllocDomain (AllocDomain) := poly2grid(geometry, AllocDomain);
			attribute<bool>      IsGebied        (AdminDomain) := IsDefined(Per_AdminDomain), Descr = "Ligt de allocatiecel in een kansrijk zoekgebied. Dit is wat de trede gebruikt, via Templates/VariantData_T/Trede/src/KansrijkWoningbouw.";
			parameter<ha>        Areaal                        := sum(IsDefined(Per_AdminDomain) ? AdminDomain/NrHaPerCell : 0[ha]), Descr = "Controlegetal. In de levering 56.705 ha, hier minus wat buiten het studiegebied valt en plus of min de rastering.";
		}
		
		attribute<Bool> N2K1000mBuffer0                   (AdminDomain) := ='potential(float32(SourceData/Omgevingsrecht/EU/Natura2000/Result_AdminDomain), /Geography/Distmatrices_'+AdminDomain_ref_short+'/pot1000m/Flat2) > 0f && !SourceData/Omgevingsrecht/EU/Natura2000/Result_AdminDomain', Descr = "1km buffer rond Natura2000 gebieden";

		parameter<String> FileName_GrootWater1500mBuffer := '%LocalDataProjDir%/BaseData/Omgeving/GrootWater1500mBuffer_BBG'+/ModelParameters/BBG_Year+'_'+/ModelParameters/StudyArea+'_'+/ModelParameters/Advanced/AdminDomain_ref+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft.";
		parameter<String> Fingerprint_GrootWater1500mBuffer :=
			  'bbg_year='          + /ModelParameters/BBG_Year
			+ ';buffer_m=1500'
			+ ';grootwater_flags=' + asList(string(/Classifications/Grondgebruik/CBSKlasse/IsGrootWater), ',')
			+ ';admin_grid='       + /ModelParameters/Advanced/AdminDomain_ref
			+ ';study_area='       + /ModelParameters/StudyArea
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. bbg_year kiest de landgebruikskaart waar IsGrootWater uit komt, en kiest via de CBSKlasse-alias ook de klassenlijst. buffer_m staat als vaste waarde, want de potential kiest zijn kernel via het itempad en niet via een parameter. grootwater_flags is de klassenvlag IsGrootWater per CBS-klasse: een gewijzigde vlag verandert de uitkomst zonder de bestandsnaam te raken. alloc_grid vangt dat 25m tegenover 100m een ander bestand onder dezelfde naam oplevert.";
		container Decoupling_GrootWater1500mBuffer := /Templates/DecoupledFile_T(FileName_GrootWater1500mBuffer, Fingerprint_GrootWater1500mBuffer);
		attribute<Bool> Calc_GrootWater1500mBuffer        (AdminDomain) := ='potential(float32(StartState/Landgebruik/IsGrootWater), /Geography/Distmatrices_'+AdminDomain_ref_short+'/pot1500m/Flat2) > 0f', Descr = "1.5km buffer rond groot water (meren en grote rivieren)";
		attribute<Bool> Make_GrootWater1500mBuffer        (AdminDomain) := Calc_GrootWater1500mBuffer, StorageName = "=FileName_GrootWater1500mBuffer", StorageType = "tif", ExplicitSuppliers = "Decoupling_GrootWater1500mBuffer/Write_Fingerprint", Descr = "Schrijft de buffer eenmalig weg. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<Bool> Read_GrootWater1500mBuffer        (AdminDomain) : StorageName = "=FileName_GrootWater1500mBuffer", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<Bool> GrootWater1500mBuffer             (AdminDomain) := = Decoupling_GrootWater1500mBuffer/MayReuse ? 'Read_GrootWater1500mBuffer' : 'Make_GrootWater1500mBuffer', Descr = "1.5km buffer rond groot water (meren en grote rivieren), ontkoppeld. Met een geldige fingerprint wordt de tif gelezen; anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_GrootWater1500mBuffer/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";

		parameter<String> FileName_N2K1000mBuffer := '%LocalDataProjDir%/BaseData/Omgeving/N2K1000mBuffer_N2K20241119_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "Het pad staat als eigen parameter en niet alleen als StorageName, omdat DecoupledFile_T het pad als gegeven nodig heeft.";
		parameter<String> Fingerprint_N2K1000mBuffer :=
			  'n2k_date=20241119'
			+ ';buffer_m=1000'
			+ ';admin_grid='  + /ModelParameters/Advanced/AdminDomain_ref
			+ ';study_area='  + /ModelParameters/StudyArea
			+ ';grootwater=[' + Fingerprint_GrootWater1500mBuffer + ']'
		, Descr = "De volledige lijst invoeren die de tif bepaalt, ook de waarden die al in de bestandsnaam zitten. n2k_date staat als vaste waarde omdat de datum hard in het pad van SourceData/Omgevingsrecht/EU/Natura2000_2024 zit; komt daar een nieuwe levering, pas dan ook deze sleutel aan. buffer_m staat als vaste waarde, want de potential kiest zijn kernel via het itempad. De buffer sluit groot water uit, dus de volledige fingerprint van GrootWater1500mBuffer telt hier genest mee.";
		container Decoupling_N2K1000mBuffer := /Templates/DecoupledFile_T(FileName_N2K1000mBuffer, Fingerprint_N2K1000mBuffer);
		attribute<Bool> Calc_N2K1000mBuffer               (AdminDomain) := N2K1000mBuffer0 && !GrootWater1500mBuffer, Descr = "1km buffer rond Natura2000 gebieden, exclusief groot water";
		attribute<Bool> Make_N2K1000mBuffer               (AdminDomain) := Calc_N2K1000mBuffer, StorageName = "=FileName_N2K1000mBuffer", StorageType = "tif", ExplicitSuppliers = "Decoupling_N2K1000mBuffer/Write_Fingerprint", Descr = "Schrijft de buffer eenmalig weg. Write_Fingerprint hangt als ExplicitSupplier aan dit Make-item zelf en niet aan een container, zodat het zijbestand ook meekomt wanneer een run dit item rechtstreeks aanspreekt.";
		attribute<Bool> Read_N2K1000mBuffer               (AdminDomain) : StorageName = "=FileName_N2K1000mBuffer", StorageType = "tif", StorageReadOnly = "TRUE";
		attribute<Bool> N2K1000mBuffer                    (AdminDomain) := = Decoupling_N2K1000mBuffer/MayReuse ? 'Read_N2K1000mBuffer' : 'Make_N2K1000mBuffer', Descr = "1km buffer rond Natura2000 gebieden, exclusief groot water, ontkoppeld. Met een geldige fingerprint wordt de tif gelezen; anders wordt er gerekend en geschreven, inclusief het zijbestand. Vraag Decoupling_N2K1000mBuffer/Explanation op om te zien waarom een bestand wel of niet hergebruikt wordt.";
		
		container Fractie_VerhardGroen_PerBuurtType
		{
			attribute<meter2> GroenOpp   (AdminDomain) := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/GroenOpp_AdminDomain;
			attribute<meter2> WaterOpp   (AdminDomain) := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/WaterOpp_AdminDomain;
			attribute<meter2> BruinOpp   (AdminDomain) := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/BruinOpp_AdminDomain;
			attribute<meter2> VerhardOpp (AdminDomain) := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/VerhardOpp_AdminDomain;
			attribute<meter2> Check      (AdminDomain) := add(GroenOpp, WaterOpp, BruinOpp, VerhardOpp) - AdminDomain/NrHaPerCell[meter2];
			
			unit<uint32> NettoBuurt := /SourceData/Vastgoed/Rudifun/Netto_Buurt
			{
				attribute<meter2>  Opp_geom                      := area(geometry, meter2_f64)[meter2];
				attribute<meter2>  GroenOpp                      := sum(../GroenOpp, Per_AdminDomain);
				attribute<meter2>  WaterOpp                      := sum(../WaterOpp, Per_AdminDomain);
				attribute<meter2>  BruinOpp                      := sum(../BruinOpp, Per_AdminDomain);
				attribute<meter2>  VerhardOpp                    := sum(../VerhardOpp, Per_AdminDomain);
				attribute<meter2>  TotalOpp                      := GroenOpp + WaterOpp + BruinOpp + VerhardOpp;
				
				attribute<float32> FractieGroen                  := GroenOpp / TotalOpp;
				attribute<float32> FractieWater                  := WaterOpp / TotalOpp;
				attribute<float32> FractieBruin                  := BruinOpp / TotalOpp;
				attribute<float32> FractieVerhard                := VerhardOpp / TotalOpp;
				
				attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			}
			
			unit<uint32> BrutoBuurt := /SourceData/Vastgoed/Rudifun/Bruto_Buurt
			{
				attribute<meter2>  Opp_geom                      := area(geometry, meter2_f64)[meter2];
				attribute<meter2>  GroenOpp                      := sum(../GroenOpp, Per_AdminDomain);
				attribute<meter2>  WaterOpp                      := sum(../WaterOpp, Per_AdminDomain);
				attribute<meter2>  BruinOpp                      := sum(../BruinOpp, Per_AdminDomain);
				attribute<meter2>  VerhardOpp                    := sum(../VerhardOpp, Per_AdminDomain);
				attribute<meter2>  TotalOpp                      := GroenOpp + WaterOpp + BruinOpp + VerhardOpp;
				
				attribute<float32> FractieGroen                  := GroenOpp / TotalOpp;
				attribute<float32> FractieWater                  := WaterOpp / TotalOpp;
				attribute<float32> FractieBruin                  := BruinOpp / TotalOpp;
				attribute<float32> FractieVerhard                := VerhardOpp / TotalOpp;
				
				attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
			}
			
			unit<uint32> TarraBuurt := /SourceData/Vastgoed/Rudifun/Bruto_Buurt
			{
				attribute<meter2>     GroenOpp                   := max_elem(BrutoBuurt/GroenOpp - NettoBuurt/GroenOpp[NettoBuurt_rel], 0f);
				attribute<meter2>     WaterOpp                   := max_elem(BrutoBuurt/WaterOpp - NettoBuurt/WaterOpp[NettoBuurt_rel], 0f);
				attribute<meter2>     BruinOpp                   := max_elem(BrutoBuurt/BruinOpp - NettoBuurt/BruinOpp[NettoBuurt_rel], 0f);
				attribute<meter2>     VerhardOpp                 := max_elem(BrutoBuurt/VerhardOpp - NettoBuurt/VerhardOpp[NettoBuurt_rel], 0f);
				attribute<meter2>     TotalOpp                   := GroenOpp + WaterOpp + BruinOpp + VerhardOpp;
				
				attribute<float32>    FractieGroen               := GroenOpp / TotalOpp;
				attribute<float32>    FractieWater               := WaterOpp / TotalOpp;
				attribute<float32>    FractieBruin               := BruinOpp / TotalOpp;
				attribute<float32>    FractieVerhard             := VerhardOpp / TotalOpp;
				attribute<float32>    Check                      := add(FractieGroen, FractieWater, FractieBruin, FractieVerhard);
				
				attribute<.> Per_AdminDomain (AdminDomain) := poly2grid(geometry, AdminDomain);
				
				attribute<NettoBuurt> NettoBuurt_rel             := rlookup(BU_CODE, NettoBuurt/BU_CODE);
				attribute<Provincie>  Provincie_rel              := rlookup(PV_CODE, Provincie/statcode);
				
				attribute<float32>    Mean_FractieGroen_Prov     (Provincie) := mean(FractieGroen, Provincie_rel);
				attribute<float32>    Mean_FractieWater_Prov     (Provincie) := mean(FractieWater, Provincie_rel);
				attribute<float32>    Mean_FractieBruin_Prov     (Provincie) := mean(FractieBruin, Provincie_rel);
				attribute<float32>    Mean_FractieVerhard_Prov   (Provincie) := mean(FractieVerhard, Provincie_rel);
				
				parameter<float32> Mean_FractieGroen   := mean(FractieGroen[Per_AdminDomain]);
				parameter<float32> Mean_FractieWater   := mean(FractieWater[Per_AdminDomain]);
				parameter<float32> Mean_FractieBruin   := mean(FractieBruin[Per_AdminDomain]);
				parameter<float32> Mean_FractieVerhard := mean(FractieVerhard[Per_AdminDomain]); // inclusief pandfootprint (voor zover relevant in tarra buurten)
			}
			
			container FractiesHoofdklassenPerBNSN := for_each_ne(Classifications/Grondgebruik/HoofdklasseK/name, 'HoofdklasseT('+string(id(Classifications/Grondgebruik/HoofdklasseK))+'[Classifications/Grondgebruik/HoofdklasseK])');
			
			Template HoofdklasseT
			{
				parameter<uint8> HoofdklasseK_id;
				//
				
				container FractiePerBNSN :=
					for_each_nedv(
						Landschap/BasiskaartNatuurlijkSysteemNederlandK/name,
						replace(
							'mean(
								SourceData/Landschap/BasiskaartNatuurlijkSysteemNederlandK/BNSN_rel_AdminDomain == Landschap/BasiskaartNatuurlijkSysteemNederlandK/v/'+Landschap/BasiskaartNatuurlijkSysteemNederlandK/name+' 
									? TarraBuurt/Fractie@[TarraBuurt/Per_AdminDomain]
									: null_f
							)',
							'@', Classifications/Grondgebruik/HoofdklasseK/name[HoofdklasseK_id]
						)
						, void
						, float32
					)
				{
					attribute<float32> Map (Landschap/BasiskaartNatuurlijkSysteemNederlandK) := = 'union_data(Landschap/BasiskaartNatuurlijkSysteemNederlandK,'+AsItemList('FractiePerBNSN/'+Landschap/BasiskaartNatuurlijkSysteemNederlandK/name)+')';
				}
			}
		}
	}
	
	#include<Suitabilities.dms>
	
	container Restricties
	{
		#include<Afleiding_Winkelcentra.dms>
	}
	
	#include<Zonneladder.dms>
}