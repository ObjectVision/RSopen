// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Specificeert de container 'MaxWoningDichtheid_T'.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template MaxWoningDichtheid_T
{
	//
	parameter<Classifications/Vastgoed/WP2xVSSH> id;
	attribute<Bool> IsWoonlocatie (AllocDomain);
	//
	
	parameter<String> name_short := Classifications/Vastgoed/WP2/name_short[Classifications/Vastgoed/WP2xVSSH/first_rel[id]];

	parameter<Woning_ha> MinimumUitMinimumOP := = 'min(ThisVariantClassifications/Vastgoed/OP/perWP2xVSSH/'+Classifications/Vastgoed/WP2xVSSH/name[id]+'/OP_sub/Dichtheid)';
	parameter<Woning_ha> Minimum  := MinimumUitMinimumOP; // was max_elem(MinimumUitMinimumOP, MinimumDichtheid_EG/MG); param verwijderd, zie issue #11
	parameter<String>    OP_sub_ref          := 'ThisVariantClassifications/Vastgoed/OP/perWP2xVSSH/'+Classifications/Vastgoed/WP2xVSSH/name[id]+'/OP_sub';
	parameter<UInt32>    AantalRijOP         := = 'sum(uint32(Classifications/Vastgoed/WP4/name[ThisVariantClassifications/Vastgoed/OP/WP4_rel['+OP_sub_ref+'/org_rel]] == '+quote('rijtjeswoning')+'))', Descr = "Het aantal rijpakketten in deze subsector.";
	parameter<Woning_ha> MinimumRijOP        := = 'min('+OP_sub_ref+'/Dichtheid * (Classifications/Vastgoed/WP4/name[ThisVariantClassifications/Vastgoed/OP/WP4_rel['+OP_sub_ref+'/org_rel]] == '+quote('rijtjeswoning')+' ? 1f : null_f))'
	, Descr = "De dichtheid van het minst dichte rijpakket van deze subsector. Zonder rijpakket geeft min geen null maar het grootste getal van een float32, daarom toetst MinimumKernrand eerst AantalRijOP.";
	parameter<Woning_ha> MinimumKernrand     := AantalRijOP > 0 ? max_elem(Minimum, MinimumRijOP) : Minimum
	, Descr = "Zo dicht mag een pakket aan de rand van een kern altijd, ook waar het basisjaar in de omgeving minder woningen per hectare heeft: het minst dichte rijpakket. Aan de kernrand komt de
				uitbreidingswijk met rijwoningen, en zonder deze grens sloot het omgevingsmaximum rij daar uit, zodat twee-onder-een-kap dezelfde grond kreeg (#847). Gelijk aan Minimum in een subsector zonder rijpakket.";
	
	parameter<Float32> DichtheidFactorOV              := = 'ThisVariantClassifications/VariantK/DichtheidFactorOV_'+name_short+'[0b]';
	parameter<Float32> DichtheidFactorWater           := = 'ThisVariantClassifications/VariantK/DichtheidFactorWater_'+name_short+'[0b]';
	parameter<Float32> DichtheidFactorGeneriek        := = 'ThisVariantClassifications/VariantK/DichtheidFactorGeneriek_'+name_short+'[0b]';
	parameter<Float32> DichtheidFactorBevKern100kPlus := = 'ThisVariantClassifications/VariantK/DichtheidFactorBevKern100kPlus_'+name_short+'[0b]';
	parameter<Float32> DichtheidFactorBevKern20kPlus  := = 'ThisVariantClassifications/VariantK/DichtheidFactorBevKern20kPlus_'+name_short+'[0b]';
	parameter<Float32> DichtheidFactorBevKern20kMin   := = 'ThisVariantClassifications/VariantK/DichtheidFactorBevKern20kMin_'+name_short+'[0b]';
	
	attribute<Float32> DichtheidFactor_AdminDomain (AdminDomain) := add(
		float32(/BaseData/Omgeving/OV_Reistijd/TotRailHalte/Smoothed)            * (DichtheidFactorOV - 1f),
		float32(/BaseData/StartState/Landgebruik/NabijGrootWaterInBBG/Smoothed) * (DichtheidFactorWater - 1f),
		switch(
			case(/BaseData/Omgeving/RondBevolkingskern/Is100kPlus, float32(/BaseData/Omgeving/RondBevolkingskern/Is100kPlus) * (DichtheidFactorBevKern100kPlus - 1f)),
			case(/BaseData/Omgeving/RondBevolkingskern/Is20kPlus,  float32(/BaseData/Omgeving/RondBevolkingskern/Is20kPlus)  * (DichtheidFactorBevKern20kPlus - 1f)),
			case(/BaseData/Omgeving/RondBevolkingskern/Is20kMin,   float32(/BaseData/Omgeving/RondBevolkingskern/Is20kMin)   * (DichtheidFactorBevKern20kMin - 1f)),
			const(0f, AdminDomain)
		),
		DichtheidFactorGeneriek - 1f,
		1f
	);
	attribute<Float32> DichtheidFactor (AllocDomain) := mean(DichtheidFactor_AdminDomain, AdminDomain/AllocDomain_rel), Descr = "De drie omgevingsfactoren staan sinds #759 op 25 meter. De maximale woningdichtheid is een blokgrootheid, dus de factor wordt hier over de zestien cellen van het blok gemiddeld.";
	
	attribute<Woning>    Src                   (CompactedAdminDomain) := /BaseData/StartState/StateBasisjaar/Src0/Wonen/WP1s/Totaal;
	attribute<Woning_ha> Dichtheid_AllocDomain (AllocDomain) := sum(Src, CompactedAdminDomain/AllocDomain_rel) / (float32(IsWoonlocatie) * AllocDomain/NrHaPerCell);
	attribute<Woning_ha> Dichtheid_Buurt       (AllocDomain) := ='mean(Dichtheid_AllocDomain, RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/buurt/Per_AllocDomain)[RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Buurt/Per_AllocDomain]';
	attribute<Woning_ha> Dichtheid_Wijk        (AllocDomain) := ='mean(Dichtheid_AllocDomain, RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Wijk/Per_AllocDomain)[RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Wijk/Per_AllocDomain]';
	attribute<Woning_ha> Dichtheid_Gemeente    (AllocDomain) := ='mean(Dichtheid_AllocDomain, RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Gemeente/Per_AllocDomain)[RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Gemeente/Per_AllocDomain]';
	attribute<Woning_ha> Dichtheid_NVM         (AllocDomain) := ='mean(Dichtheid_AllocDomain, RegioIndelingen/NVM/Per_AllocDomain)[RegioIndelingen/NVM/Per_AllocDomain]';
	attribute<Woning_ha> Dichtheid_COROP       (AllocDomain) := ='mean(Dichtheid_AllocDomain, RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/COROP/Per_AllocDomain)[RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/COROP/Per_AllocDomain]';
	attribute<Woning_ha> Dichtheid_Provincie   (AllocDomain) := ='mean(Dichtheid_AllocDomain, RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Provincie/Per_AllocDomain)[RegioIndelingen/cbs/Y'+string(ModelParameters/Model_StartYear)+'/Provincie/Per_AllocDomain]';
	attribute<Woning_ha> Max                   (AllocDomain) := max_elem(Dichtheid_AllocDomain, Dichtheid_Buurt, Dichtheid_Wijk, Dichtheid_Gemeente, Dichtheid_NVM, Dichtheid_COROP, Dichtheid_Provincie);
	attribute<Woning_ha> MaalFactor            (AllocDomain) := Max * DichtheidFactor;
	attribute<Woning_ha> ResultMaalFactor      (AllocDomain) := value(potential(MaalFactor, Geography/Distmatrices_100m/pot2000m/rev_dist_scaled / sum(Geography/Distmatrices_100m/pot2000m/rev_dist_scaled)), Woning_ha);
	attribute<Woning_ha> ResultNietMaalFactor  (AllocDomain) := value(potential(Max, Geography/Distmatrices_100m/pot2000m/rev_dist_scaled / sum(Geography/Distmatrices_100m/pot2000m/rev_dist_scaled)), Woning_ha);
	attribute<Woning_ha> Ondergrens            (AllocDomain) := mean((/BaseData/Omgeving/RondBevolkingskern/Is100kPlus || /BaseData/Omgeving/RondBevolkingskern/Is20kPlus || /BaseData/Omgeving/RondBevolkingskern/Is20kMin) ? MinimumKernrand : Minimum, AdminDomain/AllocDomain_rel)
	, Descr = "MinimumKernrand binnen de buffer van een kilometer rond de bebouwde kernen (BaseData/Omgeving/RondBevolkingskern), daarbuiten Minimum, gemiddeld over de zestien cellen van het blok zoals DichtheidFactor.";
	attribute<Woning_ha> Result                (AllocDomain) := Max_elem(ResultMaalFactor, Ondergrens);
}