Template CarbanStorageSequestration_T 
: using = "Classifications;SourceData/Landbouw;/Classifications/Grondgebruik/LGNKlasse"
, Descr = ""
{
	//
	parameter<String>  Zichtjaar_name;
	//
	
	parameter<string> StorageStr_stock_zichtjaar := IsStartYear 
		? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/CarbanStorageSequestration_stock_'+Zichtjaar_name+'_tonCO2_'+/ModelParameters/StudyArea+'.tif'
		: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/CarbanStorageSequestration_stock_'+Zichtjaar_name+'_tonCO2_'+/ModelParameters/StudyArea+'.tif';
		
	parameter<string> StorageStr_flow_zichtjaar := IsStartYear 
		? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/CarbanStorageSequestration_seq_ThisPeriod_'+Zichtjaar_name+'_tonCO2_'+/ModelParameters/StudyArea+'.tif'
		: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/CarbanStorageSequestration_seq_ThisPeriod_'+Zichtjaar_name+'_tonCO2_'+/ModelParameters/StudyArea+'.tif';
		
	parameter<string> StorageStr_flow_TovBasisjaar := IsStartYear 
		? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/CarbanStorageSequestration_stock_FromBaseYear_'+Zichtjaar_name+'_tonCO2_'+/ModelParameters/StudyArea+'.tif'
		: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/CarbanStorageSequestration_stock_FromBaseYear_'+Zichtjaar_name+'_tonCO2_'+/ModelParameters/StudyArea+'.tif';
	
	parameter<Bool>      IsStartYear         := lowercase(Zichtjaar_name) == lowercase('Basisjaar');
	parameter<Int16>     PrevZichtjaar_value := rjoin(lowercase(Zichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name), /Classifications/Time/Zichtjaar/PrevYearRange_rel);
	parameter<Int16>     Zichtjaar_value     := rjoin(lowercase(Zichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name), /Classifications/Time/Zichtjaar/YearRange_rel);
	parameter<Bool>      IsFirstAllocYear    := rjoin(lowercase(Zichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name), /Classifications/Time/Zichtjaar/IsFirstZichtjaar);
	parameter<jaar>      Periode             := Zichtjaar_Value[jaar] - PrevZichtjaar_Value[jaar];
	parameter<float32>   C_to_CO2            := 44f / 12f;   // ton C -> ton CO2
	
	unit<uint8> OP := = Zichtjaar_name+'/impl/StandVar/OP';
	unit<uint8> OPSubklasseK := Classifications/Grondgebruik/OPSubklasseK;
	
	container OP_Buurt := = Zichtjaar_name+'/impl/StandVar/OP_Buurt';
	
	attribute<bool> Hoog_NL (AdminDomain) := BaseData/Omgeving/NbSOPToepassingsgebied/Hoog_NL;
	
	container BaseYear
	{
		container Grondgebruik
		{
			attribute<LGNKlasse>   LGN (AdminDomain) := /SourceData/Grondgebruik/LGN/m25;
			attribute<CarbonClass> CC  (AdminDomain) := rjoin(LGN, CarbonClass/LGN_rel, id(CarbonClass));
		}
		
		container Carbon
		{
			container Stock
			{
				attribute<ton_ha> Max_ha    (AdminDomain) := CarbonClass/Cmax_ha[Grondgebruik/CC];
				attribute<ton_ha> Result_ha (AdminDomain) := const(0[ton_ha], AdminDomain); //Max_ha; //In werkelijkheid zit er al koostof in bodem en bomen/planten en wordt het maximum eerder bereikt. Van 0 uitgaan geeft dus een bovengrens van sequestratie. 
				attribute<ton>    Result    (AdminDomain) := Result_ha * AdminDomain/NrHaPerCell;
			}
		}
		
		container CO2
		{
			attribute<ton> Stock (AdminDomain) := Carbon/Stock/Result * C_to_CO2;
		}
	}
	
	container PrevZichtjaar := =IsFirstAllocYear || IsStartYear ? 'BaseYear' : 'PrevIndicatoren/CarbonStorageSequestration/Zichtjaar';
	
	container Zichtjaar
	{
		container Grondgebruik
		{
			attribute<CarbonClass> CC_Exogeen (AdminDomain) := =IsStartYear ? 'const(null_b, AdminDomain)' : 'ThisVariantData/ExogeenOpleggen/carbonclass_rel';
			attribute<CarbonClass> CC         (AdminDomain) := IsDefined(Stand/Subsector_rel) ? CarbonClass/v/Dichtbebouwde_stedelijke_gebieden : MakeDefined(CC_Exogeen, PrevZichtjaar/Grondgebruik/CC);
			
			attribute<OP> OP_rel (AdminDomain) := Stand/OP_rel;
			
			container FractiePerOPSubklasse := for_each_nedv(
				OPSubklasseK/name,
				'OP_Buurt/Terreinoppervlakte/Totaal/'+OPSubklasseK/SrcRef+'[float32] / OP_Buurt/Terreinoppervlakte/Totaal[float32]',
				OP,
				float32
			);
		}
		
		container Carbon
		{
			container Max
			{
				container UitAllocAlgemeen
				{
					attribute<ton_ha> Stock_ha               (AdminDomain) := CarbonClass/Cmax_ha[Grondgebruik/CC];
					attribute<ton_ha_jaarlijks> Flow_ha_jaar (AdminDomain) := CarbonClass/Cseq_ha[Grondgebruik/CC];
					attribute<ton_ha> Flow_ha                (AdminDomain) := Flow_ha_jaar * Periode;
				}
				
				container PerOPSubklasse := for_each_ne(OPSubklasseK/name, 'OPSubklasseT('+string(id(OPSubklasseK))+'[OPSubklasseK])')
				{
					container Totaal
					{
						attribute<ton_ha>           Stock_ha     (AdminDomain) := = 'add('+AsItemList('PerOPSubklasse/'+OPSubklasseK/name+'/Stock_ha')+')';
						attribute<ton_ha_jaarlijks> Flow_ha_jaar (AdminDomain) := = 'add('+AsItemList('PerOPSubklasse/'+OPSubklasseK/name+'/Flow_ha_jaar')+')';
						attribute<ton_ha>           Flow_ha      (AdminDomain) :=  Flow_ha_jaar * Periode;
					}
				}
				
				container Totaal
				{
					attribute<ton_ha>           Stock_ha     (AdminDomain) := IsDefined(Grondgebruik/OP_rel) ? PerOPSubklasse/Totaal/Stock_ha : UitAllocAlgemeen/Stock_ha;
					attribute<ton_ha_jaarlijks> Flow_ha_jaar (AdminDomain) := IsDefined(Grondgebruik/OP_rel) ? PerOPSubklasse/Totaal/Flow_ha_jaar : UitAllocAlgemeen/Flow_ha_jaar;
					attribute<ton_ha>           Flow_ha      (AdminDomain) := IsDefined(Grondgebruik/OP_rel) ? PerOPSubklasse/Totaal/Flow_ha : UitAllocAlgemeen/Flow_ha;
				}
				
				Template OPSubklasseT
				{
					//
					parameter<OPSubklasseK> id;
					//
					
					parameter<CarbonClass> CC_Hoog_NL       := OPSubklasseK/CarbonClass_rel_Hoog_NL[id];
					parameter<CarbonClass> CC_Laag_NL       := OPSubklasseK/CarbonClass_rel_Laag_NL[id];
					parameter<CarbonClass> CC_NbSOP_Hoog_NL := OPSubklasseK/CarbonClass_rel_NbSOP_Hoog_NL[id];
					parameter<CarbonClass> CC_NbSOP_Laag_NL := OPSubklasseK/CarbonClass_rel_NbSOP_Laag_NL[id];
					
					attribute<float32> Fractie (OP) := = 'Grondgebruik/FractiePerOPSubklasse/'+OPSubklasseK/name[id];
					
					attribute<ton_ha> Stock_ha_Hoog_NL (OP) := Fractie * (OP/IsNbSOP ? CarbonClass/Cmax_ha[CC_NbSOP_Hoog_NL] : CarbonClass/Cmax_ha[CC_Hoog_NL]);
					attribute<ton_ha> Stock_ha_Laag_NL (OP) := Fractie * (OP/IsNbSOP ? CarbonClass/Cmax_ha[CC_NbSOP_Laag_NL] : CarbonClass/Cmax_ha[CC_Laag_NL]);
					
					attribute<ton_ha_jaarlijks> Flow_ha_Hoog_NL (OP) := Fractie * (OP/IsNbSOP ? CarbonClass/Cseq_ha[CC_NbSOP_Hoog_NL] : CarbonClass/Cseq_ha[CC_Hoog_NL]);
					attribute<ton_ha_jaarlijks> Flow_ha_Laag_NL (OP) := Fractie * (OP/IsNbSOP ? CarbonClass/Cseq_ha[CC_NbSOP_Laag_NL] : CarbonClass/Cseq_ha[CC_Laag_NL]);
					
					attribute<ton_ha>           Stock_ha     (AdminDomain) := Hoog_NL ? Stock_ha_Hoog_NL[Stand/OP_rel] : Stock_ha_Laag_NL[Grondgebruik/OP_rel];
					attribute<ton_ha_jaarlijks> Flow_ha_jaar (AdminDomain) := Hoog_NL ? Flow_ha_Hoog_NL[Stand/OP_rel] : Flow_ha_Laag_NL[Grondgebruik/OP_rel];
				}
			}
			
			container Stock
			{
				attribute<ton_ha> Max_ha        (AdminDomain) := Max/Totaal/Stock_ha; //
				
				attribute<bool>   RuimteNeemtAf (AdminDomain) := Max_ha < PrevZichtjaar/Carbon/Stock/Result_ha; //
				attribute<ton_ha> Result_ha     (AdminDomain) := RuimteNeemtAf ? Max_ha : min_elem(PrevZichtjaar/Carbon/Stock/Result_ha + Flow/Max_ha, Max_ha); // Willen we bij afname echt meteen afboeken naar de nieuwe max? 
				attribute<ton>    Result        (AdminDomain) := Result_ha * AdminDomain/NrHaPerCell;
			}
			
			container Flow
			{
				attribute<ton_ha> Max_ha    (AdminDomain) := Max/Totaal/Flow_ha; //
				
				attribute<ton_ha> Result_ha (AdminDomain) := Stock/Result_ha - PrevZichtjaar/Carbon/Stock/Result_ha;
				attribute<ton>    Result    (AdminDomain) := Result_ha * AdminDomain/NrHaPerCell;
			}
		}
		
		container CO2
		{
			attribute<ton> Stock (AdminDomain) := Carbon/Stock/Result * C_to_CO2;
			attribute<ton> Flow  (AdminDomain) := Carbon/Flow/Result * C_to_CO2;
		}
	}
	
	attribute<ton> CO2FlowTovBasisjaar (AdminDomain) := Zichtjaar/CO2/Stock - BaseYear/CO2/Stock;
	
	attribute<ton> InRivierengebied (AdminDomain) := CO2FlowTovBasisjaar * IsDefined(/SourceData/RegioIndelingen/Landschappen/Rivierengebied_500m_buffer/StudyArea/Per_AdminDomain)[float32];
	
	attribute<ton> Write_CO2Stock_Zichtjaar   (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? Zichtjaar/CO2/Stock : null_f, StorageName = "=StorageStr_stock_zichtjaar", StorageType = "gdalwrite.grid";
	attribute<ton> Write_CO2Flow_Zichtjaar    (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? Zichtjaar/CO2/Flow : null_f, StorageName = "=StorageStr_flow_zichtjaar", StorageType = "gdalwrite.grid";
	attribute<ton> Write_CO2Flow_TovBasisjaar (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? CO2FlowTovBasisjaar : null_f, StorageName = "=StorageStr_flow_TovBasisjaar", StorageType = "gdalwrite.grid";
}
// }
	
	// attribute<CarbonClass>           LU_CC_Prevjaar_rel          (AdminDomain) := =IsStartYear ? 'LU_CC_Basisjaar_rel' : 'PrevIndicatoren/CarbonStorageSequestration/LU_CC_rel'; // CarbonClass vorige periode of basisjaar
	// attribute<CarbonClass>           LU_CC_Exogeen_rel           (AdminDomain) := =IsFirstAllocYear ? '/VariantData/'+Variant_name+'/ExogeenOpleggen/carbonclass_rel' : 'const(null_b, AdminDomain)'; // CarbonClass van evt exogeen opgelegd landgebruik
	
	// attribute<CarbonClass>           LU_CC_rel                   (AdminDomain) := IsDefined(Stand/Subsector_rel) ? CarbonClass/v/Dichtbebouwde_stedelijke_gebieden : MakeDefined(LU_CC_Exogeen_rel, LU_CC_Prevjaar_rel); // Definitieve CarbonClass in zichtjaar obv alloc resultaat (incl BAGNieuwbouw) > exo opgelegd > landgebruik basisjaar
	
	// attribute<bool>                  IsLUchanged                 (AdminDomain) := LU_CC_rel != LU_CC_Prevjaar_rel; // Is ruimtegebruik veranderd tov vorige zichtjaar?
	
	// // Carbon sequestration (= flow)
	// attribute<ton_ha_jaarlijks>      Cseq_Zichtjaar_jaarlijks    (AdminDomain) := =IsStartYear ? 'LU_CC_rel -> CarbonClass/Cseq_ha' : 'MakeDefined(WaarAllocWonen/Totaal/Cseq_ha, LU_CC_rel -> CarbonClass/Cseq_ha)'; // jaarlijkse sequestratie in betreffende periode (zichtjaar)
	// attribute<ton_ha>                Cseq_Zichtjaar              (AdminDomain) := Cseq_Zichtjaar_jaarlijks * Periode; // sequestratie in deze periode (zichtjaar)
	
	// // Carbon storage (= stock)
	// attribute<ton_ha>                Cmax_Basisjaar              (AdminDomain) := LU_CC_Basisjaar_rel -> CarbonClass/Cmax_ha; // Carbon stock max basisjaar (maximum gegeven landgebruiksklasse)
	// attribute<ton_ha>                Cmax_PrevExAllocWonen0      (AdminDomain) := LU_CC_Prevjaar_rel -> CarbonClass/Cmax_ha; // Carbon stock max vorige periode (tussenstap)
	// attribute<ton_ha>                Cmax_PrevExAllocWonen       (AdminDomain) := =IsStartYear ? 'Cmax_Basisjaar' : 'Cmax_PrevExAllocWonen0'; // Carbon stock max vorige periode
	// attribute<ton_ha>                Cmax_Prev                   (AdminDomain) := =IsFirstAllocYear ? 'Cmax_PrevExAllocWonen' : 'MakeDefined(PrevIndicatoren/CarbonStorageSequestration/WaarAllocWonen/Totaal/Cmax_ha, Cmax_PrevExAllocWonen)';
	// attribute<ton_ha>                Cmax_ZichtjaarExAllocWonen  (AdminDomain) := LU_CC_rel -> CarbonClass/Cmax_ha; // Carbon stock max zichtjaar
	// attribute<ton_ha>                Cmax_Zichtjaar              (AdminDomain) := =IsStartYear ? 'Cmax_ZichtjaarExAllocWonen' : 'MakeDefined(WaarAllocWonen/Totaal/Cmax_ha, Cmax_ZichtjaarExAllocWonen)';
	// attribute<ton_ha>                Cstock_Zichtjaar0           (AdminDomain) := min_elem(Cmax_Prev + Cseq_Zichtjaar, Cmax_Zichtjaar); // Minimum van max stock in zichtjaar en ie van vorige periode plus sequestratie in deze periode.
	// attribute<ton_ha>                Cstock_Zichtjaar            (AdminDomain) := IsLUchanged && Cmax_Zichtjaar <= Cmax_Prev // waar landgebruik is veranderd en max stock daarbij is afgenomen of gelijk is gebleven
																					// ? Cmax_Zichtjaar // dan nemen we de (lagere) max uit het zichtjaar (bij het nieuwe landgebruik)
																					// : Cstock_Zichtjaar0; // anders (waar landgebruik gelijk is gebleven en/of max stock (desondanks) is gegeroeid) pakken we het minimum van max stock in zichtjaar en ie van vorige periode plu seqyestratie in deze periode.
	// //
	// attribute<ton_ha>                CO2stock_ThisPeriod_ha      (AdminDomain) := Cstock_Zichtjaar * C_to_CO2;
	// attribute<ton>                   CO2stock_ThisPeriod         (AdminDomain) := CO2stock_ThisPeriod_ha * AdminDomain/NrHaPerCell;
	// attribute<ton>                   CO2stock_FromBaseYear       (AdminDomain) := CO2stock_ThisPeriod - ThisCasus/Basisjaar/CarbonStorageSequestration/CO2stock_ThisPeriod ;
	
	// // Carbon sequestration (= flow)
	// attribute<ton_ha>                Cseq_ThisPeriod_ha          (AdminDomain) := Cstock_Zichtjaar - Cmax_Prev;
	// attribute<ton_ha>                CO2seq_ThisPeriod_ha        (AdminDomain) := Cseq_ThisPeriod_ha   * C_to_CO2;
	// attribute<ton>                   CO2seq_ThisPeriod           (AdminDomain) := CO2seq_ThisPeriod_ha * AdminDomain/NrHaPerCell;
	
	// // Export
