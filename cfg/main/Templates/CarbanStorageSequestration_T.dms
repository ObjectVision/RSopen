	// attribute<ton>                   Write_CO2seq_ThisPeriod     (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? CO2seq_ThisPeriod : null_f, StorageName = "=StorageStr_seq_ThisPeriod", StorageType = "gdalwrite.grid";
	// attribute<ton>                   Write_CO2stock_FromBaseYear (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? CO2stock_FromBaseYear : null_f, StorageName = "=StorageStr_stock_FromBaseYear", StorageType = "gdalwrite.grid";
// }