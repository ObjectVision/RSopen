////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de zeef in de zichtjaren. Daarnaast verschil tussen deze beschikbaarheid in VariantData tov die in
// BaseData is dat deze op AllocDomain checks uitvoert en die in de BaseData op AdminDomain. Is de locatie
// restrictief voor deze sector/subsector in dit zichtjaar? Is de locatie restrictief, ook binnen plancapaciteit?
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Zeef_T //wordt aangeroepen in Zeef_Zichtjaar_T
: Descr = "Bepaal de zeef in de zichtjaren. Daarnaast verschil tussen deze beschikbaarheid in VariantData tov die in BaseData is dat deze op AllocDomain checks uitvoert en die in de BaseData op AdminDomain."
{
	unit<UInt32> VariantXSectorxSubsector;
	parameter<VariantXSectorxSubsector> id;
	container Analysis;
	parameter<String> Zichtjaar_name;
	//
	
	parameter<String>  name                                             := VariantXSectorxSubsector/combi_name[id];
	// parameter<ha>      MinimalLandAvailability                          := VariantK/MinimalLandAvailability[Variant_rel];
	parameter<ha>      MinimalLandAvailability_Landbouw                 := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector ? 'VariantK/MinimalLandAvailability_Landbouw[Variant_rel]' : '0[ha]';
	parameter<Float32> MinimumDichtheidToenameSector                    := ='VariantK/MinimumDichtheidToename'+Sector_name+'[Variant_rel]';
	parameter<String>  Variant_name                                     := VariantK/name[Variant_rel];
	parameter<String>  Sector_name                                      := lowercase(VariantXSectorxSubsector/Sector_name[id]);
	parameter<String>  Subsector_name                                   := VariantXSectorxSubsector/Subsector_name[id];
	parameter<Yr>      GeenSlooptotLeeftijd_BinnenHardePlancapaciteit   := /ModelParameters/Wonen/GeenSlooptotLeeftijd_BinnenHardePlancapaciteit;
	parameter<Yr>      GeenSlooptotLeeftijd_BuitenHardePlancapaciteit   := VariantK/GeenSlooptotLeeftijd_BuitenHardePlancapaciteit[Variant_rel];
	parameter<Bool>    IsHardePlannenGeldigInZeef                       := VariantK/HardePlannenGeldigInZeef[Variant_rel];
	parameter<Bool>    IsZachtePlannenGeldigInZeef                      := VariantK/ZachtePlannenGeldigInZeef[Variant_rel];
	parameter<Bool>    IsPlancapaciteitNogGeldig                        := ='uint32('+substr(Zichtjaar_name, 1, 4)+') <= uint32(/ModelParameters/Advanced/PlancapaciteitGeldigTotEnMet)', Descr = "Plannen hebben een beperkte looptijd: in zichtjaren na ModelParameters/Advanced/PlancapaciteitGeldigTotEnMet heffen harde en zachte plannen de zeef-restricties niet meer op.";
	
	attribute<Bool>    IsBeschikbaar             (CompactedAdminDomain) := !IsRestrictief;
	attribute<Bool>    IsRestrictief             (CompactedAdminDomain) := = 
		'OR(
			 IsRestrictief_OokBinnenPlancapaciteit[CompactedAdminDomain/CompactedAllocDomain_rel]
			,ThisVariant/Zeef/Basisjaar/'+Sector_name+'/'+Subsector_name+'/IsRestrictief'
			',Impl/TeHoogBouwjaarBinnenHardePlancapaciteit'
			',Impl/TeHoogBouwjaarBuitenHardePlancapaciteit' //Buiten-toets is gemaskeerd op harde plancapaciteit, zie Impl; cellen zonder panden hebben null PandLeeftijd en vallen bij beide toetsen op FALSE
			',IsRestrictief_DoorExogeenopleggen'
			',Impl/TeOndiepVoorWaterberging'
		')', Descr = "Is de locatie restrictief voor deze sector/subsector in dit zichtjaar?";
	
	//Geldt ook in plannen voor van betreffende sector
	attribute<Bool> IsRestrictief_DoorExogeenopleggen      (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, IsDefined(ExogeenOpleggen/Totaal))
	, Descr = "Op slot omdat het model hier een ander landgebruik oplegt. Dit is de as opleggen die de as op slot aanstuurt, en dat is bewust: waar nieuwe natuur komt hoort geen nieuwbouw. Geldt voor alle sectoren, anders dan de landschapsroute in Zeef_Basisjaar_T/OpSlotDoorLandschap die alleen wonen en werken sluit.

				Volgt precies wat er wordt opgelegd, en dus niet meer dan dat. Staat VariantK/ExogeenWaterOpleggen uit, dan zit
				de waterstroom niet in Totaal en sluit deze toets die cellen dus ook niet; daar moet NietBouwen het doen.
				Toen dit nog op ExogeenOpleggen/Natuur toetste terwijl Totaal ook water bevatte, kon er op exogeen opgelegd
				water gebouwd worden (#596); sindsdien loopt het over Totaal.";
	
	attribute<Bool> IsRestrictief_OokBinnenPlancapaciteit  (CompactedAllocDomain) := = Sector_name = lowercase('Wind') || Sector_name = lowercase('Zon')  || Sector_name = lowercase('Landbouw')  
																						? 'Impl/HeeftPandenInCelInBasisjaar' 
																						:  Sector_name = lowercase('Werken') 
																							? 'OR(Impl/TeKleineDichtheidsToenameSubsector, src/HeeftGeenRuimteOpBedrijventerrein)'
																							: 'Impl/TeKleineDichtheidsToenameSubsector', Descr = "Is de locatie restrictief, ook binnen plancapaciteit?";

	//De zichtjaar-zeef kent geen tak die alleen buiten plancapaciteit geldt. De enige toets die daarin zat was
	//MinimumSubsectorShare, en die is bij #670 verwijderd; de vol-toets op IBIS die er daarnaast in stond, staat
	//ook in IsRestrictief_OokBinnenPlancapaciteit en was daar een dubbeling. De basisjaar-zeef (Zeef_Basisjaar_T)
	//houdt zijn eigen buiten-plancapaciteit-tak wel, want daar hangen de restrictiekaarten aan.

	container Impl
	{
		attribute<Bool>    HeeftPandenInCelInBasisjaar             (CompactedAllocDomain) := (Sector_name == lowercase('Zon') || Sector_name == lowercase('Wind') || Sector_name == lowercase('Verblijfsrecreatie')) && src/HeeftPandenInCelInBasisjaar;
		attribute<Bool>    TeOndiepVoorWaterberging                (CompactedAdminDomain) := =
			Sector_name == lowercase('waterberging')
				? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, !/BaseData/Suitabilities/Waterberging/IsDiepGenoeg)'
				: 'const(FALSE, CompactedAdminDomain)'
		, Descr = "Haalt de cel de Minimum_Waterschijf niet, dan is hij niet beschikbaar voor waterberging: er past fysiek geen bergingsschijf van een meter in. Voor alle andere sectoren altijd FALSE.";
		attribute<Bool>    TeKleineDichtheidsToenameSubsector      (CompactedAllocDomain) := Sector_name == lowercase('Werken') && src/PotentieleDichtheidToenameSubsector <= MinimumDichtheidToenameSector; //<= conform de wonen-variant (Zeef_Wonen_perOP_T), zodat het grensgeval bij beide sectoren gelijk uitpakt (#604)
		// attribute<Bool>    GeeftOnvoldoendeRuimte                  (CompactedAllocDomain) := Src/PotentieleRuimte < MinimalLandAvailability;
		attribute<Bool>    TeHoogBouwjaarBinnenHardePlancapaciteit (CompactedAdminDomain) := src/PandLeeftijd < GeenSlooptotLeeftijd_BinnenHardePlancapaciteit[float32]; //geldt ook buiten harde plannen; daar overstemt de strengere Buiten-toets zolang Binnen <= Buiten
		attribute<Bool>    TeHoogBouwjaarBuitenHardePlancapaciteit (CompactedAdminDomain) := src/PandLeeftijd < GeenSlooptotLeeftijd_BuitenHardePlancapaciteit[float32] && !Src/HeeftHardePlannenDezeSector[CompactedAdminDomain/CompactedAllocDomain_rel];
	}
	
	container Src
	{
		attribute<Float32> PandLeeftijd                            (CompactedAdminDomain) := ='float32('+substr(Zichtjaar_name, 1,4)+') - ThisVariant/Zeef/Basisjaar/'+Sector_name+'/'+Subsector_name+'/Src/BouwjaarPand', Descr = "Leeftijd van het pand in het zichtjaar";
		attribute<Bool>    HeeftPandenInCelInBasisjaar             (CompactedAllocDomain) := = 'collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, /SourceData/Vastgoed/BAG/PerJaar/Y'+string(/ModelParameters/BAG_RecentYear)+'/pand/counts/Per_AllocDomain)[float32] > 0f', Descr = "Zijn er panden in de cel in het basisjaar?";
		
		attribute<Bool>    HeeftHardePlannenDezeSector             (CompactedAllocDomain) := =Sector_name == lowercase('Landbouw') ? 'const(FALSE, CompactedAllocDomain)' : 'IsHardePlannenGeldigInZeef && IsPlancapaciteitNogGeldig && Plannen/Per_CompactedAllocDomain/Hard/Result/'+Sector_name+'/'+Subsector_name, Descr = "Heeft de locatie harde plannen voor deze subsector. Zelfde GeldigInZeef-schakelaar als in de basisjaar-zeef (ontbrak hier), plus de vervaldatum PlancapaciteitGeldigTotEnMet.";
		attribute<Bool>    HeeftZachtePlannenDezeSector            (CompactedAllocDomain) := =Sector_name == lowercase('Landbouw') ? 'const(FALSE, CompactedAllocDomain)' : 'IsZachtePlannenGeldigInZeef && IsPlancapaciteitNogGeldig && Plannen/Per_CompactedAllocDomain/Zacht/Result/'+Sector_name+'/'+Subsector_name, Descr = "Heeft de locatie zachte plannen voor deze subsector. Zelfde GeldigInZeef-schakelaar als in de basisjaar-zeef (ontbrak hier), plus de vervaldatum PlancapaciteitGeldigTotEnMet.

				Geen consument meer in de zichtjaar-zeef sinds de buiten-plancapaciteit-tak bij #670 verviel; de sloopleeftijdstoets hangt aan de harde plannen. Blijft staan als leesbare tegenhanger van de harde variant en als haak voor een toets die zachte plannen wil vrijstellen.";
		
		attribute<Float32> PotentieleDichtheidToenameSubsector     (CompactedAllocDomain) := ='PotentieleState/'+Zichtjaar_name+'/Per_SectorxSubsectoren/'+Sector_name+'/'+Subsector_name+'/TovStateVoorAllocatie', Descr = "Potentiële dichtheidstoename van de subsector in deze cel in het zichtjaar";
		attribute<ha>      PotentieleRuimte                        (CompactedAllocDomain) := = 'sum(float32(ThisVariant/Zeef/Basisjaar/'+Sector_name+'/'+Subsector_name+'/IsBeschikbaar) * AdminDomain/NrHaPerCell, CompactedAdminDomain/CompactedAllocDomain_rel)', Descr = "Potentiële ruimte voor deze sector/subsector in deze cel in het zichtjaar";
		attribute<Bool>    GeeftOnvoldoendeRuimte_Landbouw         (CompactedAdminDomain) := (PotentieleRuimte < MinimalLandAvailability_Landbouw)[CompactedAdminDomain/CompactedAllocDomain_rel], Descr = "Geeft onvoldoende ruimte voor landbouw in deze cel in het zichtjaar";
	
		attribute<bool>    HeeftGeenRuimteOpBedrijventerrein       (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, /SourceData/Grondgebruik/IBIS/Result/IsVol_grid);
	}
}
