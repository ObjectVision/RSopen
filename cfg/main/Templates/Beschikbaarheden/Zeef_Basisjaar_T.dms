////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de zeef op AdminDomain. Dit is een eerste stap in de zeef procedure Deze restricties gelden overal, dus
// ook binnen plancapaciteit Deze restricties gelden overal, behalve binnen harde plancapaciteit
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Zeef_Basisjaar_T
: Descr = "Bepaal de zeef op AdminDomain. Dit is een eerste stap in de zeef procedure"
{
	//
	unit<UInt32> VariantXSectorxSubsector;
	parameter<VariantXSectorxSubsector> id;
	container VariantData;
	//
	
	parameter<String>  name                                             := VariantXSectorxSubsector/combi_name[id];
	parameter<String>  Variant_name                                     := VariantK/name[Variant_rel];
	parameter<String>  KlimaatScenario_ref                              := VariantK/KlimaatScenario_ref[Variant_rel];
	parameter<String>  ReserverenVoorRivierAfvoer_ref                   := VariantK/ReserverenVoorRivierAfvoer_ref[Variant_rel];
	parameter<Bool>    NietBouwenInNatuurorganisaties                   := VariantK/NietBouwenInNatuurorganisaties[Variant_rel];
	parameter<Bool>    NietBouwenInWaterschappen                        := VariantK/NietBouwenInWaterschappen[Variant_rel];
	parameter<Bool>    NietBouwenVerVanOV                               := VariantK/NietBouwenVerVanOV[Variant_rel];
	parameter<Bool>    BouwenInWoonlocatieNietVanGemeenteOfCorporatie   := VariantK/BouwenInWoonlocatieNietVanGemeenteOfCorporatie[Variant_rel];
	parameter<Bool>    NietBouwenOpZeehaven                             := VariantK/NietBouwenOpZeehaven[Variant_rel];
	parameter<Bool>    NietBouwenWaarSlap                               := VariantK/NietBouwenWaarSlap[Variant_rel];
	parameter<Bool>    NietBouwenWaarZettingsgevoelig                   := VariantK/NietBouwenWaarZettingsgevoelig[Variant_rel];
	parameter<Bool>    NietBouwenWaarNat                                := VariantK/NietBouwenWaarNat[Variant_rel];
	parameter<Bool>    NietBouwenWaarBeheerkostenInfraTeHoog            := VariantK/NietBouwenWaarBeheerkostenInfraTeHoog[Variant_rel];
	parameter<Bool>    NietBouwenInZeerMooiLandschap                    := = iif(lowercase(Sector_name) == lowercase('Wonen') || lowercase(Sector_name) == lowercase('Werken') || lowercase(Sector_name) == lowercase('Verblijfsrecreatie'), 'VariantK/NietBouwenInZeerMooiLandschap'+Sector_name+'[Variant_rel]', 'FALSE');
	parameter<Bool>    NietBouwenInMooiLandschap                        := VariantK/NietBouwenInMooiLandschap[Variant_rel];
	parameter<Bool>    RestrictiesOokGeldigBinnenHardePlancapaciteit    := VariantK/RestrictiesOokGeldigBinnenHardePlancapaciteit[Variant_rel];
	parameter<Bool>    ZeerHardOokGeldigBinnenHardePlancapaciteit       := VariantK/ZeerHardOokGeldigBinnenHardePlancapaciteit[Variant_rel];
	parameter<Bool>    NietBouwenInNatura2000Buffer                     := VariantK/NietBouwenInNatura2000Buffer[Variant_rel];
	parameter<Bool>    IsHardePlannenGeldigInZeef                       := VariantK/HardePlannenGeldigInZeef[Variant_rel];
	parameter<Bool>    IsZachtePlannenGeldigInZeef                      := VariantK/ZachtePlannenGeldigInZeef[Variant_rel];
	parameter<Bool>    HardePlannenGaanVoorOpLandschapsregime           := VariantK/HardePlannenGaanVoorOpLandschapsregime[Variant_rel];
	parameter<Bool>    ZachtePlannenGaanVoorOpLandschapsregime          := VariantK/ZachtePlannenGaanVoorOpLandschapsregime[Variant_rel];
	parameter<Energielabel> GeenSloopvanafELabel                        := VariantK/GeenSloopvanafELabel[Variant_rel];
	
	parameter<String> Sector_name    := VariantXSectorxSubsector/Sector_name[id];
	parameter<String> Subsector_name := VariantXSectorxSubsector/Subsector_name[id];
	
	parameter<Bool>   IsWerkenMaarGeenNijverheidEnLogistiek := lowercase(Sector_name) == lowercase('Werken') && !(lowercase(Subsector_name) == lowercase('Nijverheid') || lowercase(Subsector_name) == lowercase('Logistiek'));

	parameter<Bool>   SplitsZeerHardAf := ZeerHardOokGeldigBinnenHardePlancapaciteit
											&& lowercase(Sector_name) != lowercase('Wind')
											&& lowercase(Sector_name) != lowercase('Landbouw')
	, Descr = "Wordt de zeerharde restrictielaag apart behandeld van de overige hardheden (#686)? Zo ja, dan gaat de zeerharde laag via IsWettelijkVerbod naar de groep die overal geldt, en houdt de rest zijn vrijstelling binnen harde plancapaciteit.
				Wind valt erbuiten omdat de hele restrictietoets daar aan een eigen uitzondering hangt, namelijk dat er nog geen turbine staat, en die uitzondering hoort dan ook voor de zeerharde laag te gelden. Landbouw valt erbuiten omdat die sector helemaal geen restrictiekaarten heeft. Voor beide is er ook geen plancapaciteit, dus de vrijstelling waar dit over gaat speelt daar sowieso niet.";
	
	attribute<Bool>   IsBeschikbaar         (CompactedAdminDomain) := !IsRestrictief;
	attribute<Bool>   IsBeschikbaar_AdminDomain      (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, IsBeschikbaar, FALSE);
	attribute<Bool>   IsRestrictief         (CompactedAdminDomain) := IsRestrictief_BuitenPlancapaciteit || IsRestrictief_BuitenHardePlancapaciteit || IsRestrictief_Overal;

	attribute<Bool>   IsRestrictief_ZonderPlanvrijstelling (CompactedAdminDomain) :=
		IsRestrictief_BuitenPlancapaciteit_Bron || IsRestrictief_BuitenHardePlancapaciteit_Bron || IsRestrictief_Overal_Bron
	, Descr = "Dezelfde zeef als IsRestrictief, maar met alle drie de planvrijstellingen uit. Dit is wat er overblijft zodra de plannen verlopen zijn (#682).

				De basisjaar-zeef is zichtjaaronafhankelijk en kan ModelParameters/Advanced/PlancapaciteitGeldigTotEnMet dus zelf niet toepassen. Daarom levert hij beide uitkomsten en kiest Zeef_T er per zichtjaar een van, zie BasisjaarZeefItem daar. Dat scheelt een tweede instantiatie van dit hele sjabloon: de twee uitkomsten delen al hun bronitems en verschillen alleen in de drie maskers.

				De drie vrijstellingen die hier vervallen, in de volgorde van de drie termen hierboven: Impl/HeeftPlannenDezeSector op de groep die buiten alle plancapaciteit geldt, Impl/IsBeschermdDoorHardPlan op de groep die buiten harde plancapaciteit geldt, en Impl/IsBeschermdDoorPlanTegenLandschapsregime op het landschapsregime in de groep die overal geldt (#683). Elk van de drie hangt aan Impl/HeeftHardePlannenDezeSector of Impl/HeeftZachtePlannenDezeSector, dus dit item is per constructie gelijk aan IsRestrictief met die twee vlaggen op FALSE.

				Let op wat hier NIET in zit: de trede-voorrang van plancapaciteit in Templates/VariantData_T/Trede.dms en Templates/Allocatie/IterSubsector_T.dms. Die staat op AllocDomain en buiten de zeef, en blijft dus ook na de vervaldatum voorrang geven. Zie de restpunten bij #682.";

	// Geldt overal
	attribute<Bool> IsRestrictief_Overal (CompactedAdminDomain) :=
		OR(
			Impl/IsEvidentBenutBinnenPlancapaciteit,
			Impl/IsWettelijkVerbod,
			Impl/TeGevaarlijk,
			Impl/GeenToegestaneBouwwijzeVoldoet,
			Impl/OpSlotDoorLandschap,
			Impl/ReserverenVoorRivierAfvoer,
			Impl/IsAutowegInclKlaverbladen,
			Impl/IsDierentuinOpenluchtMuseum,
			Impl/IsStichtseRotonde
		), Descr = "Deze restricties gelden overal, dus ook binnen plancapaciteit. Een uitzondering sinds #683: OpSlotDoorLandschap draagt zijn eigen planvrijstelling mee, zie Impl/IsBeschermdDoorPlanTegenLandschapsregime"; //TeHoogBouwjaar wordt nu geregeld via zichtjaren met dynamische pand leeftijd. zie issue #277

	attribute<Bool> IsRestrictief_Overal_Bron (CompactedAdminDomain) := IsRestrictief_Overal || Impl/OpSlotDoorLandschap_Bron
	, Descr = "Dezelfde groep als IsRestrictief_Overal, maar met de planvrijstelling van #683 uit. De enige term die daar een vrijstelling draagt is OpSlotDoorLandschap, en die is per constructie een deelverzameling van OpSlotDoorLandschap_Bron; de vereniging met dat item is dus precies de ongemaskeerde groep. Zo staat de OR-lijst hierboven maar een keer in de configuratie.";

	// Alleen harde plancapaciteit wordt uitgezonderd
	attribute<Bool> IsRestrictief_BuitenHardePlancapaciteit_Bron (CompactedAdminDomain):=
		OR(
			Impl/TeHoogEnergielabel,
			Impl/TeSlap,
			Impl/TeNat,
			Impl/TeHogeBeheerKostenInfra,
			Impl/TeZettingsgevoelig,
			Impl/IsMooiLandschap,
			Impl/IsZeerMooiLandschap,
			Impl/IsInNatura2000Buffer,
			Impl/IsWoonlocatieNietVanGemeenteOfCorporatie,
			Impl/IsRestrictiefBuitenHardePlancapaciteit,
			Impl/IsMilieuCatBedrijvigheidNabij
		), Descr = "De restricties die buiten harde plancapaciteit gelden, nog zonder de vrijstelling. Apart gezet bij #682, zodat IsRestrictief_ZonderPlanvrijstelling dezelfde lijst kan gebruiken. Wat hier niet in zit is de zeerharde restrictielaag zodra VariantK/ZeerHardOokGeldigBinnenHardePlancapaciteit aanstaat; die gaat dan via IsWettelijkVerbod naar IsRestrictief_Overal (#686).";

	attribute<Bool> IsRestrictief_BuitenHardePlancapaciteit (CompactedAdminDomain):=
		IsRestrictief_BuitenHardePlancapaciteit_Bron && !Impl/IsBeschermdDoorHardPlan, Descr = "Deze restricties gelden overal, behalve binnen harde plancapaciteit.";

	// Zowel harde als zachte plancapaciteit wordt uitgezonderd
	attribute<Bool> IsRestrictief_BuitenPlancapaciteit_Bron (CompactedAdminDomain):=
		OR(
			Impl/IsEvidentBenutBuitenPlancapaciteit,
			Impl/IsEigendomVanNatuurOrganisatie,
			Impl/IsEigendomVanWaterschap,
			Impl/IsZeehaven,
			Impl/IsNietNabijOV,
			Impl/IsMilieuCatBedrijvigheidNabij
		), Descr = "De restricties die buiten alle plancapaciteit gelden, nog zonder de vrijstelling. Apart gezet bij #682, zodat IsRestrictief_ZonderPlanvrijstelling dezelfde lijst kan gebruiken.";

	attribute<Bool> IsRestrictief_BuitenPlancapaciteit (CompactedAdminDomain):=
		IsRestrictief_BuitenPlancapaciteit_Bron && !Impl/HeeftPlannenDezeSector, Descr = "Deze restricties gelden overal, behalve binnen plancapaciteit";
	

	parameter<Bool> IsSectorWerken := lowercase(Sector_name) == lowercase('Werken')
	, Descr = "Is dit een werksubsector? Alleen daar geldt de bouwwijzetoets hieronder; wonen heeft zijn eigen toets per ontwikkelpakket in Zeef_Wonen_perOP_T en de overige sectoren bouwen niets waar een bouwwijze bij hoort.";

	container BouwwijzeInput
	: Descr = "De invoer voor de bouwwijzekeuze van deze werksubsector (#727): wat de subsector toelaat als vlag per cel, en wat de plek eist. De tegenhanger van Zeef_Wonen_perOP_T/BouwwijzeInput, met de subsectorkolom in plaats van de OP-kolom.

				De twee veeneisen staan hier bewust op FALSE. De bebouwingstypekaart veen wijst aangepast bouwen en wonen op water aan voor woningen; wat een bedrijfspand op diezelfde plek moet doen is niet belegd, en #727 gaat over de overstromingsmaatregel. Zet dat er ooit bij, dan komen hier dezelfde twee eisen te staan als aan de wonen-kant, achter dezelfde schakelaar BouwwijzeVeenGeldtVoorOPs."
	{
		attribute<meter> Waterdiepte (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/Overstromingsdiepte);
		attribute<Bool>  GeenVeeneis (CompactedAdminDomain) := const(FALSE, CompactedAdminDomain);

		container Toegestaan :=
			for_each_nedv(
				  /Classifications/Modellering/BouwwijzeK/name
				, IsSectorWerken
					? 'const(/Classifications/Actor/Jobs6/Bouwwijze/Toegestaan/' + /Classifications/Modellering/BouwwijzeK/name + '[/Classifications/Actor/Jobs6/V/' + Subsector_name + '], CompactedAdminDomain)'
					: 'const(FALSE, CompactedAdminDomain)'
				, CompactedAdminDomain
				, bool
			)
		, Descr = "Per bouwwijze: laat deze subsector hem toe? Buiten werken staat hier overal FALSE; dat wordt nooit opgevraagd, want Impl/GeenToegestaneBouwwijzeVoldoet staat daar als meta-expressie op const(FALSE).";
	}

	container Bouwwijzekeuze := Templates/Beschikbaarheden/Bouwwijzekeuze_T(
		  BouwwijzeInput/Toegestaan
		, ThisVariant/BouwwijzeEis/Overstromingsbestendig
		, BouwwijzeInput/GeenVeeneis
		, BouwwijzeInput/GeenVeeneis
		, BouwwijzeInput/Waterdiepte
	), Descr = "De bouwwijzekeuze per cel voor deze werksubsector (#727). Hetzelfde sjabloon en dezelfde keuzeregel als aan de wonen-kant, dus de zeef en de schade-indicator kiezen per constructie dezelfde bouwwijze. De zeef leest GeenEnkeleVoldoet; de Gekozen-items staan klaar voor wie wil zien wat er op een beschikbare cel gebouwd zou worden.";
	container Impl
	{
		parameter<Bool>   IsThisSectorWonen             := lowercase(Sector_name) == lowercase('Wonen');
		parameter<Bool>   IsThisSectorWerken            := lowercase(Sector_name) == lowercase('Werken');
		parameter<Bool>   IsThisSectorVerblijfsrecreatie:= lowercase(Sector_name) == lowercase('Verblijfsrecreatie');
		parameter<Bool>   IsThisSectorZon               := lowercase(Sector_name) == lowercase('Zon');
		parameter<Bool>   IsThisSectorWind              := lowercase(Sector_name) == lowercase('Wind');
		parameter<Bool>   IsLandbouw                    := lowercase(Sector_name) == lowercase('Landbouw');
		parameter<Bool>   IsThisSectorWonenOfWerken     := IsThisSectorWonen || IsThisSectorWerken;
		parameter<String> EvidentBenutVariant           := ='VariantParameters/VariantK/EvidentBenutVariant_'+Sector_name+'[Variant_rel]';
		
		attribute<Bool> IsEvidentBenut_obv_BGT                     (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, EvidentBenut/IsEvidentBenut_AdminDomain), Descr = "Is de locatie reeds benut op basis van BGT (evident benut)";
		attribute<Bool> IsEvidentBenut_obv_BGT_wind                (CompactedAdminDomain) := =IsThisSectorWind ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/IsAutoweg/Per_AdminDomain || /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/IsSpoorbaan/Per_AdminDomain)' : 'const(FALSE,CompactedAdminDomain)', Descr = "Is de locatie reeds benut voor wind op basis van BGT (evident benut voor windturbines, dus autowegen en spoorbanen)";
		attribute<Bool> IsEvidentBenut_obv_BGT_zon                 (CompactedAdminDomain) := =IsThisSectorZon ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, EvidentBenut/IsEvidentBenutZon_AdminDomain)' : 'const(FALSE,CompactedAdminDomain)', Descr = "Is de locatie reeds benut voor zon op basis van BGT (evident benut voor zon, dus inclusief autowegen en spoorbanen waar zonnepanelen op kunnen liggen)";
		attribute<Bool> IsEvidentBenutBinnenPlancapaciteit_obv_BBG (CompactedAdminDomain) := ='VariantParameters/EvidentBenut/'+Sector_name+'/BinnenPlancapaciteit/'+EvidentBenutVariant+'[src/GrondgebruikBasisjaar]', Descr = "Is de locatie reeds benut binnen plancapaciteit op basis van BBG";
		attribute<Bool> IsEvidentBenutBuitenPlancapaciteit_obv_BBG (CompactedAdminDomain) := ='VariantParameters/EvidentBenut/'+Sector_name+'/BuitenPlancapaciteit/'+EvidentBenutVariant+'[src/GrondgebruikBasisjaar]', Descr = "Is de locatie reeds benut buiten plancapaciteit op basis van BBG";
		attribute<Bool> EvidentBenutLandbouw_obv_LGN               (CompactedAdminDomain) := =IsLandbouw ? 'VariantParameters/EvidentBenut/'+Sector_name+'/'+EvidentBenutVariant+'[src/LGNBasisjaar]' : 'const(FALSE,CompactedAdminDomain)', Descr = "Is de locatie reeds benut voor landbouw op basis van LGN";
		attribute<Bool> IsIJburg                                 (CompactedAdminDomain) := /SourceData/RegioIndelingen/LMSSubzone/IsIjburg2[/SourceData/RegioIndelingen/LMSSubzone/Per_CompactedAdminDomain], Descr = "Is de locatie in IJburg?";
		
		attribute<Bool> IsEvidentBenutBinnenPlancapaciteit         (CompactedAdminDomain) := 
			switch(
				case(IsThisSectorWind, (IsEvidentBenutBinnenPlancapaciteit_obv_BBG || IsEvidentBenut_obv_BGT_wind) && !src/IsIJburg)
				, (IsEvidentBenutBinnenPlancapaciteit_obv_BBG || IsEvidentBenut_obv_BGT) && !src/IsIJburg
			), Descr = "Is de locatie reeds benut binnen plancapaciteit, gebruik verschillende methodes afhankelijk van de sector. En corrigeer voor IJburg 2 (want dat is nog gedeeltelijk water)";
		
		attribute<Bool> IsEvidentBenutBuitenPlancapaciteit         (CompactedAdminDomain) := 
			switch(
				case(IsThisSectorWind, IsEvidentBenutBuitenPlancapaciteit_obv_BBG || IsEvidentBenut_obv_BGT_wind)
				,case(IsThisSectorZon, (IsEvidentBenutBuitenPlancapaciteit_obv_BBG || IsEvidentBenut_obv_BGT_zon) && !src/IsIJburg)
				,(IsEvidentBenutBuitenPlancapaciteit_obv_BBG || IsEvidentBenut_obv_BGT) && !src/IsIJburg
			), Descr = "Is de locatie reeds benut buiten plancapaciteit, gebruik verschillende methodes afhankelijk van de sector. En corrigeer voor IJburg 2 (want dat is nog gedeeltelijk water)";
		
		attribute<Bool> IsAutowegInclKlaverbladen                 (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/IsAutoweg/FixKlaverbladen/Per_AdminDomain), Descr = "Is de locatie een autoweg inclusief klaverbladen (dus ook de op- en afritten)";
		attribute<Bool> IsStichtseRotonde                         (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/NWB/Stichtse_Rotonde/Per_AdminDomain), Descr = "Is de locatie op de Stichtse Rotonde in Amersfoort. Dit is een unieke zeer grote rotonde met bos en heide erop.";
		attribute<Bool> IsDierentuinOpenluchtMuseum               (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BRT/IsDierentuinOpenluchtMuseum/Per_AdminDomain), Descr = "Is de locatie een dierentuin of openlucht museum.";
		attribute<Bool> IsEigendomVanNatuurOrganisatie            (CompactedAdminDomain) := (IsThisSectorWonenOfWerken || IsThisSectorVerblijfsrecreatie) && src/IsEigendomVanNatuurOrganisatie && NietBouwenInNatuurorganisaties, Descr = "Is de locatie eigendom van een natuurorganisatie en mag er niet gebouwd worden in natuurorganisaties";
		attribute<Bool> IsEigendomVanWaterschap                   (CompactedAdminDomain) := IsThisSectorWonenOfWerken && src/IsEigendomVanWaterschap && NietBouwenInWaterschappen, Descr = "Is de locatie eigendom van een waterschap en mag er niet gebouwd worden in waterschappen";
		attribute<Bool> TeSlap                                    (CompactedAdminDomain) := IsThisSectorWonenOfWerken && src/TeSlap                  && NietBouwenWaarSlap, Descr = "Is de locatie te slap om op te bouwen";
		attribute<Bool> TeZettingsgevoelig                        (CompactedAdminDomain) := IsThisSectorWonenOfWerken && src/TeZettingsgevoelig      && NietBouwenWaarZettingsgevoelig, Descr = "Is de locatie zettingsgevoelig om op te bouwen";
		attribute<Bool> TeNat                                     (CompactedAdminDomain) := IsThisSectorWonenOfWerken && src/TeNat                   && NietBouwenWaarNat, Descr = "Is de locatie te nat om op te bouwen";
		attribute<Bool> TeHogeBeheerKostenInfra                   (CompactedAdminDomain) := IsThisSectorWonenOfWerken && src/TeHogeBeheerKostenInfra && NietBouwenWaarBeheerkostenInfraTeHoog, Descr = "Zijn de beheer kosten van de infrastructuur te hoog om op te bouwen. Deze restrictie had als enige van de slappe-bodemrestricties geen variantschakelaar en stond dus in elke variant aan, terwijl NietBouwenWaarSlap en NietBouwenWaarZettingsgevoelig overal uit staan. Daarmee was dit feitelijk het enige slappe-bodemregime in het model. Nu schakelbaar, zodat de kostenbenadering uit #505 ertegen af te zetten is.";
		attribute<Bool> TeGevaarlijk                              (CompactedAdminDomain) := IsThisSectorWonenOfWerken && ThisVariant/Bouwregime/OpSlotDoorGevaarzone, Descr = "Is de locatie te gevaarlijk om op te bouwen (overstromingsgevaar)";
		attribute<Bool> GeenToegestaneBouwwijzeVoldoet            (CompactedAdminDomain) := =IsSectorWerken ? '../Bouwwijzekeuze/GeenEnkeleVoldoet' : 'const(FALSE, CompactedAdminDomain)'
		, Descr = "Geen van de bouwwijzen die deze werksubsector mag gebruiken kan op deze cel: waar het regime bouwen met maatregelen voorschrijft gaat de waterdiepte boven het dieptevermogen van elke toegestane bouwwijze uit. De tegenhanger van Zeef_Wonen_perOP_T/Impl/GeenToegestaneBouwwijzeVoldoet, uit hetzelfde sjabloon met dezelfde keuzeregel (#727).

											Waarom in IsRestrictief_Overal en niet in een groep met een planvrijstelling: aan de wonen-kant kent deze toets er ook geen. Een hard plan kan een gemeentelijk besluit opzij zetten, maar niet dat er water staat dat geen enkele constructie van deze subsector aankan.

											Waarom in de basisjaar-zeef en niet in de zichtjaar-zeef. Twee redenen, en de tweede is de zwaarste. De kolom van de subsector is statisch, en de dieptekaart en de gevaarzonering zijn dat per variant ook, dus de uitkomst verandert niet per zichtjaar en hoeft maar een keer per variant en subsector gerekend te worden.

											En hier hoort hij inhoudelijk thuis, bij de andere statische plekrestricties: TeGevaarlijk, OpSlotDoorLandschap, ReserverenVoorRivierAfvoer, TeSlap en TeNat staan allemaal in deze zeef. Dat is niet alleen netjes, het is nodig. PotentieleStates/PerSectorxSubsector_T maskeert zowel StandInBereik als Zichtjaar_BeschikbaarheidBasisjaar op IsBeschikbaar_basisjaar, en die twee zijn de noemer en de teller van de dichtheidstoets in Zeef_T. Zet je deze toets in de zichtjaar-zeef, dan rekent die toets potentieel en stand mee op deelcellen waar de subsector nooit kan bouwen, en dat is precies het verschil in deeloppervlak dat #713 daar heeft rechtgezet. In deze zeef lopen teller en noemer wel gelijk op: wat wegvalt is grond die deze subsector niet kan nemen en dus ook niet sloopt.

											Buiten werken staat hier const(FALSE) als meta-expressie, zodat de bouwwijzekeuze voor de andere sectoren niet in de boom komt.";
		attribute<Bool> OpSlotDoorLandschap_Bron (CompactedAdminDomain) := IsThisSectorWonenOfWerken && ThisVariant/Bouwregime/OpSlotDoorLandschap, Descr = "Het landschapsregime zonder de planvrijstelling van #683. Apart gezet bij #682, want zodra de plannen verlopen zijn is dit wat er van OpSlotDoorLandschap overblijft; zie IsRestrictief_Overal_Bron.";
		attribute<Bool> OpSlotDoorLandschap      (CompactedAdminDomain) := OpSlotDoorLandschap_Bron && !IsBeschermdDoorPlanTegenLandschapsregime, Descr = "Ligt de locatie in een gebied dat in een landschapstype natuur of water wordt, en gaat het daarom op slot. Nu gevuld vanuit veen (#614), kust (#623), zand (#630) en rivieren (#621).
																								Sinds #683 niet meer binnen plancapaciteit. Zie IsBeschermdDoorPlanTegenLandschapsregime hieronder voor de twee schakelaars die dat regelen; die staan in alle varianten aan, dus een hard of zacht plan gaat voor op het landschapsregime.

																								Dit zet alleen op slot en sloopt niets: de bestaande stand blijft staan tot container Sloop in VariantData er iets over zegt. Twee gebieden waar dat verschil zichtbaar wordt: bij rivieren gaat het hele ruimtebeslag op slot terwijl alleen het terrestrische deel wordt opgelegd, en bij zand gaat het beekdal op slot terwijl de levering de bebouwing juist wil sparen.

																								Let ook op de afbakening: deze toets sluit alleen wonen en werken. Verblijfsrecreatie, wind, zon, landbouw en waterberging mogen in een landschapsgebied nog gealloceerd worden, behalve waar de exogene oplegging ze via Zeef_T/IsRestrictief_DoorExogeenopleggen alsnog tegenhoudt.";
		attribute<Bool> IsMooiLandschap                           (CompactedAdminDomain) := (IsThisSectorWonenOfWerken || IsThisSectorVerblijfsrecreatie) && src/BelevingLandschapIsHoog && NietBouwenInMooiLandschap,  Descr = "Is de locatie in een mooi landschap en mag er niet gebouwd worden in mooi landschap";
		attribute<Bool> IsZeerMooiLandschap                       (CompactedAdminDomain) := (IsThisSectorWonenOfWerken || IsThisSectorVerblijfsrecreatie) && src/BelevingLandschapIsZeerHoog && NietBouwenInZeerMooiLandschap, Descr = "Is de locatie in een zeer mooi landschap en mag er niet gebouwd worden in zeer mooi landschap";
		attribute<Bool> IsInNatura2000Buffer                      (CompactedAdminDomain) := IsThisSectorWonenOfWerken && src/IsInNatura2000Buffer && NietBouwenInNatura2000Buffer, Descr = "Is de locatie in de bufferzone van Natura2000 en mag er niet gebouwd worden in deze bufferzone";
		attribute<Bool> IsNietNabijOV                             (CompactedAdminDomain) := (IsThisSectorWonen || IsWerkenMaarGeenNijverheidEnLogistiek) && src/IsNietNabijOV && NietBouwenVerVanOV, Descr = "Is de locatie niet nabij openbaar vervoer en mag er niet gebouwd worden ver van OV";
		attribute<Bool> IsWoonlocatieNietVanGemeenteOfCorporatie  (CompactedAdminDomain) := src/IsWoonlocatieNietVanGemeenteOfCorporatie && !BouwenInWoonlocatieNietVanGemeenteOfCorporatie, Descr = "Is de locatie een woonlocatie die niet van de gemeente of een woningcorporatie is en mag er niet gebouwd worden in deze woonlocaties";
		attribute<Bool> IsZeehaven                                (CompactedAdminDomain) := !(IsThisSectorWind || IsThisSectorZon) && src/IsZeehaven && NietBouwenOpZeehaven, Descr = "Is de locatie een zeehaven en mag er niet gebouwd worden in zeehavens (alleen relevant voor wind en zon, want die mogen wel in zeehavens)";
		attribute<Bool> ReserverenVoorRivierAfvoer                (CompactedAdminDomain) := IsThisSectorWonenOfWerken && Src/ReserverenVoorRivierAfvoer, Descr = "Moet er gereserveerd worden voor rivierafvoer";
		attribute<Bool> IsMilieuCatBedrijvigheidNabij             (CompactedAdminDomain) := IsThisSectorWonen && Src/IsRestrictief_obvMilieuCat_Wonen
																								|| (IsWerkenMaarGeenNijverheidEnLogistiek || IsThisSectorVerblijfsrecreatie) && Src/IsRestrictief_obvMilieuCat_GevoeligeWerkfuncties, Descr = "Is er een bedrijventerrein nabij met een te hoge milieucat? Wonen wordt geweerd rond terreinen met categorie 2 en hoger, milieugevoelige werkfuncties en verblijfsrecreatie alleen rond zware terreinen (categorie 4 en hoger), consistent met de buffer rond nieuw gealloceerde nijverheid en logistiek.";
		
		attribute<Bool> HeeftHardePlannenDezeSector               (CompactedAdminDomain) := =IsLandbouw ? 'const(FALSE, CompactedAdminDomain)' : 'IsHardePlannenGeldigInZeef && ThisVariant/Plannen/Per_CompactedAdminDomain/Hard/Result/'+Sector_name+'/'+Subsector_name, Descr = "Heeft de locatie harde plannen voor deze sector";
		attribute<Bool> HeeftZachtePlannenDezeSector              (CompactedAdminDomain) := =IsLandbouw ? 'const(FALSE, CompactedAdminDomain)' : 'IsZachtePlannenGeldigInZeef && ThisVariant/Plannen/Per_CompactedAdminDomain/Zacht/Result/'+Sector_name+'/'+Subsector_name, Descr = "Heeft de locatie zachte plannen voor deze sector";
		attribute<Bool> HeeftPlannenDezeSector                    (CompactedAdminDomain) := HeeftHardePlannenDezeSector || HeeftZachtePlannenDezeSector, Descr = "Heeft de locatie harde of zachte plannen voor deze sector";

		attribute<Bool> IsBeschermdDoorPlanTegenLandschapsregime  (CompactedAdminDomain) := (HeeftHardePlannenDezeSector && HardePlannenGaanVoorOpLandschapsregime) || (HeeftZachtePlannenDezeSector && ZachtePlannenGaanVoorOpLandschapsregime), Descr = "Vrijwaart een plan deze locatie van het bouwregime uit de landschapstoekomstbeelden (#683)?
																								Dit is de plek waar HardePlannenGaanVoorOpLandschapsregime en ZachtePlannenGaanVoorOpLandschapsregime werken, elk voor hun eigen hardheid. Beide staan in alle vier de varianten aan, dus zowel een hard als een zacht plan houdt het masker tegen.
																								Waarom dit apart staat van IsBeschermdDoorHardPlan: die vrijstelling geldt voor de hele groep IsRestrictief_BuitenHardePlancapaciteit en kent alleen harde plannen. Het landschapsregime zit in IsRestrictief_Overal, want buiten plancapaciteit hoort het wel overal te gelden, ook binnen de zeerharde route van #686.
																								De aanleiding is de schaal. Het masker beslaat in NbSGenuanceerd 635.990 hectare, 1,4 keer het bestaande bebouwde gebied en veertien keer de verstedelijking tot 2040, terwijl de landschapstoekomstbeelden op het niveau van hele polders, beekdalsystemen en riviertrajecten zijn getekend. Als zoekgebied is dat de juiste schaal, als harde uitsluiting binnen een vastgesteld plan niet.";

		attribute<Bool> IsBeschermdDoorHardPlan                   (CompactedAdminDomain) := HeeftHardePlannenDezeSector && !RestrictiesOokGeldigBinnenHardePlancapaciteit, Descr = "Vrijwaart een hard plan deze locatie van de restricties die alleen buiten harde plancapaciteit gelden?
																								Dit is de plek waar RestrictiesOokGeldigBinnenHardePlancapaciteit werkt. Sinds #686 heft die schakelaar de vrijstelling voor de hele groep op, dus ook voor de landschaps-, bodem- en eigendomstoetsen die in dezelfde OR-groep zitten. Daarvoor lichtte hij alleen de restrictiekaarten eruit en bleven de overige termen van diezelfde groep binnen een hard plan gewoon vrijgesteld, terwijl de wikipagina Beschikbaarheid hem beschreef als de schakelaar die de bescherming in het algemeen opheft. Hij staat in alle varianten op FALSE, dus de uitkomst verandert hier niet van.";

		attribute<Bool> TeHoogEnergielabel                        (CompactedAdminDomain) := src/Energielabel < GeenSloopvanafELabel, Descr = "Is het energielabel van de locatie te hoog om gesloopt te mogen worden";
		attribute<Bool> IsWettelijkVerbod                         (CompactedAdminDomain) := src/IsZeerHardeRestrictie, Descr = "De zeerharde restrictielaag, als die apart van de overige hardheden wordt behandeld (#686). Zit in IsRestrictief_Overal en geldt dus ook binnen harde plancapaciteit: een wettelijk verbod is niet iets wat een gemeentelijk plan opzij kan zetten.
																								Leeg zolang VariantK/ZeerHardOokGeldigBinnenHardePlancapaciteit uitstaat, en dan zit de zeerharde laag net als voorheen in IsRestrictiefBuitenHardePlancapaciteit hieronder. De twee samen dekken altijd precies de restrictiecombinatie van de variant; er valt niets tussenuit en niets telt dubbel.";
		attribute<Bool> IsRestrictiefBuitenHardePlancapaciteit    (CompactedAdminDomain) := = '(src/IsRestrictiefBuitenHardePlancapaciteit'+
			iif(
				lowercase(Sector_name) == lowercase('Wind')
				,'|| ThisVariant/Wind_restricties/IsNietToegestaan) && !ThisVariant/StateBasisjaar/Wind/Totaal > 0[MW]'
				,')'
			), Descr = "Zijn de restricties die buiten harde plancapaciteit gelden ook geldig buiten harde plancapaciteit. In het geval van wind komen er extra restricties bij.";
	}
	
	container Src := /BaseData
	{
		attribute<Bool>    IsIJburg                                 (CompactedAdminDomain) := /SourceData/RegioIndelingen/LMSSubzone/IsIjburg2[/SourceData/RegioIndelingen/LMSSubzone/Per_CompactedAdminDomain], Descr = "Is de locatie in IJburg? (want dat is nog gedeeltelijk water)";
		attribute<Bool>    IsZeehaven                               (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, StartState/Grondgebruik/Per_AdminDomain/IsZeehaven), Descr = "Is de locatie een zeehaven";
		attribute<Float32> BouwjaarPand                             (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain
																								, sum(float32(BAG_Modeljaar/pand/BepalingGebruiksdoel/PandenMetFunctie/Bouwjaar_trunc)[BAG_Modeljaar/pand/BepalingGebruiksdoel/PandenMetFunctie/ToedelingsMatrix/pand_rel] * BAG_Modeljaar/pand/BepalingGebruiksdoel/PandenMetFunctie/ToedelingsMatrix/ToedelingPand, BAG_Modeljaar/pand/BepalingGebruiksdoel/PandenMetFunctie/ToedelingsMatrix/AdminDomain_rel)
																								 / sum(BAG_Modeljaar/pand/BepalingGebruiksdoel/PandenMetFunctie/ToedelingsMatrix/ToedelingPand, BAG_Modeljaar/pand/BepalingGebruiksdoel/PandenMetFunctie/ToedelingsMatrix/AdminDomain_rel)), Descr = "som(bouwjaar * toedeling) / som(toedeling)", Descr = "Gemiddeld bouwjaar van panden in het AdminDomain";
		
		//#605: hier stond PandenInBasisjaar, een pandentoets gepoort op landbouw. Die hing sinds de merge van februari 2025 zonder afnemer in de boom: geen enkele OR-lijst in deze zeef riep hem aan, dus de landbouwzeef heeft in werkelijkheid geen pandentoets. De aangesloten pandentoets is Impl/HeeftPandenInCelInBasisjaar in Zeef_T, en die geldt alleen voor zon en wind. Of landbouw er een hoort te krijgen is een methodekeuze en geen bugfix: de wiki kent geen pandentoets voor landbouw, en MinimalLandAvailability_Landbouw van 0,60 ha per cel beantwoordt dezelfde vraag al en beter, want het erf hoort bij het agrarisch bedrijf. Zie #605.
		attribute<Bool>    IsEigendomVanNatuurOrganisatie           (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, StartState/Eigendom/VanNatuurOrganisatie), Descr = "Is de locatie eigendom van een natuurorganisatie";
		attribute<Bool>    IsEigendomVanWaterschap                  (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, StartState/Eigendom/VanWaterschap), Descr = "Is de locatie eigendom van een waterschap";
		attribute<Bool>    IsWoonlocatieNietVanGemeenteOfCorporatie (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, StartState/Grondgebruik/Per_AdminDomain/IsWoonlocatie && !(StartState/Eigendom/VanGemeente || StartState/Eigendom/VanWoningcooperatie)), Descr = "Is de locatie een woonlocatie die niet van de gemeente of een woningcorporatie is";
		
		// attribute<Bool>    ZeerNabijOV                              (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Omgeving/OV_Reistijd/ZeerNabijOV), Descr = "Is de locatie zeer nabij openbaar vervoer";
		// attribute<Bool>    NabijOV                                  (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Omgeving/OV_Reistijd/NabijOV), Descr = "Is de locatie nabij openbaar vervoer";
		// attribute<Bool>    BeperktNabijOV                           (CompactedAllocDomain) := collect_by_cond(CompactedAllocDomain, AllocDomain/IsCompactedDomain, Omgeving/OV_Reistijd/BeperktNabijOV), Descr = "Is de locatie beperkt nabij openbaar vervoer";
		attribute<Bool>    IsNietNabijOV                              (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Omgeving/OV_Reistijd/NietNabijOV[AdminDomain/AllocDomain_rel]), Descr = "Is de locatie niet nabij openbaar vervoer";
		
		attribute<Bool>    BelevingLandschapIsHoog                    (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Omgeving/BelevingLandschap/IsHoog[AdminDomain/AllocDomain_rel]), Descr = "Is de locatie in een landschap van hoog belevingsniveau";
		attribute<Bool>    BelevingLandschapIsZeerHoog                (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Omgeving/BelevingLandschap/IsZeerHoog[AdminDomain/AllocDomain_rel]), Descr = "Is de locatie in een landschap van zeer hoog belevingsniveau";
		attribute<Bool>    IsInNatura2000Buffer                       (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/N2K1000mBuffer), Descr = "Is de locatie in de bufferzone van Natura2000";
		attribute<Bool>    TeNat                                      (CompactedAdminDomain) := ='collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Water/TeNat/'+KlimaatScenario_ref+'/IsNat[AdminDomain/AllocDomain_rel])', Descr = "Is de locatie te nat om op te bouwen";
		attribute<Bool>    TeSlap                                     (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Water/TeSlap/Slap/IsSlap[AdminDomain/AllocDomain_rel]), Descr = "Is de locatie te slap om op te bouwen";
		attribute<Bool>    TeZettingsgevoelig                         (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Water/TeSlap/Zettingsgevoelig/IsZettingsgevoelig[AdminDomain/AllocDomain_rel]), Descr = "Is de locatie zettingsgevoelig om op te bouwen";
		attribute<Bool>    TeHogeBeheerKostenInfra                    (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Bodem/Bodemdaling/Bodemdaling_2016_2050_cm_1_25mtr > /ModelParameters/Wonen/MaxBodemdaling) && (TeSlap || TeZettingsgevoelig), Descr = "Zijn de beheer kosten van de infrastructuur te hoog om op te bouwen (op basis van bodemdaling)";
		attribute<Bool>    ReserverenVoorRivierAfvoer                 (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/RuimteVoorRivierafvoer/'+VariantK/ReserverenVoorRivierAfvoer_ref[Variant_rel]+'/Result && !Omgeving/BBG/Per_AdminDomain)', Descr = "Moet er krap gereserveerd worden voor rivierafvoer (gebiedsreservering of stroomvoerend deel rivierbed, maar niet op basis van BBG)";
		
		attribute<bool>    IsRestrictief_obvMilieuCat_Wonen           (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/IBIS/Result/RestrictiefWonen);
		attribute<bool>    IsRestrictief_obvMilieuCat_GevoeligeWerkfuncties (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/IBIS/Result/RestrictiefGevoeligeWerkfuncties);
		
		attribute<Classifications/Grondgebruik/LGNKlasse> LGNBasisjaar          (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/LGN/m25), Descr = "LGN klasse in het basisjaar";
		attribute<Classifications/Grondgebruik/CBSKlasse> GrondgebruikBasisjaar (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, StartState/Grondgebruik/Per_AdminDomain/gg_cbs), Descr = "CBS grondgebruik in het basisjaar";
		attribute<Vastgoed/Energielabel>                  Energielabel          (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/Vastgoed/Energielabels/Modus), Descr = "Energielabel van de panden in het AdminDomain (modus)";
		
		attribute<Bool>    IsRestrictiefBuitenHardePlancapaciteit     (CompactedAdminDomain) := =Impl/IsLandbouw ? 'const(FALSE, CompactedAdminDomain)' : 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ThisVariant/Restricties/'+Sector_name+'/'+(SplitsZeerHardAf ? 'Result_ExclZeerHard' : 'Result')+')', Descr = "Zijn er restricties die buiten harde plancapaciteit gelden voor deze sector. Zodra de zeerharde laag apart wordt behandeld (#686) leest dit item Result_ExclZeerHard en gaat de zeerharde laag via IsZeerHardeRestrictie hieronder een eigen weg.";
		attribute<Bool>    IsZeerHardeRestrictie                      (CompactedAdminDomain) := =SplitsZeerHardAf ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ThisVariant/Restricties/'+Sector_name+'/ZeerHard)' : 'const(FALSE, CompactedAdminDomain)', Descr = "De zeerharde restrictielaag van deze sector, alleen gevuld wanneer die apart van de overige hardheden wordt behandeld. Zie SplitsZeerHardAf voor waarom wind en landbouw hierbuiten vallen.";
	}
}


