// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de zeef voor wonen per subsector in de zichtjaren, op basis van de zeef per OP
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Zeef_Wonen_perSubsector_T //wordt aangeroepen in Zeef_Zichtjaar_T
: Descr = "Bepaal de zeef voor wonen per subsector in de zichtjaren, op basis van de zeef per OP"
{
	//
	parameter<String> Subsector_name;
	parameter<String> Zichtjaar_name;
	container Zeef;
	container Dichtheid;
	container Geschiktheid;
	//
	
	container CC_Vastgoed := ='ThisVariantClassifications/Vastgoed';
	
	unit<UInt8> OP_sub := ='CC_Vastgoed/OP/perWP2xVSSH/'+Subsector_name+'/OP_sub';
	
	container Zeef_perOP := for_each_ne(
		OP_sub/name
		,'Zeef_Wonen_perOP_T(
			  Subsector_name
			, '+string(id(OP_sub))+'[OP_sub]'+'
			, '+quote(OP_sub/name)+'
			, '+quote(OP_sub/WP2xVSSH_name)+'
			, '+quote(OP_sub/NbSOPToepassingsgebied_ref)+'
			, Zichtjaar_name
			, Zeef/'+Zichtjaar_name+'/SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar
			, '+string(uint32(OP_sub/IsHoogbouw))+'[bool]
			, OP_sub/Dichtheid['+string(id(OP_sub))+'[OP_sub]]
			, Dichtheid
			, Geschiktheid
		)'
	);

	parameter<String> Meting685 := =(
		  quote('op;is_nbsmax;is_nbsgenuanceerd;beschikbare_cellen;geen_toegestane_bouwwijze')
		+ AsList(
			  ' + ' + quote('|' + OP_sub/name + ';' + string(uint32(OP_sub/IsNbSMaxOP)) + ';' + string(uint32(OP_sub/IsNbSGenuanceerdOP)) + ';')
			+ ' + string(sum(uint32(Zeef_perOP/' + OP_sub/name + '/Beschikbaar_voorOP)))'
			+ ' + ' + quote(';')
			+ ' + string(sum(uint32(Zeef_perOP/' + OP_sub/name + '/Impl/GeenToegestaneBouwwijzeVoldoet)))'
			, ''
		)
	)
	, StorageName = "='%LocalDataProjDir%/Diagnose/685_'+Variant_name+'_'+Zichtjaar_name+'_'+Subsector_name+'.txt'"
	, StorageType = "str"
	, Descr = "Per ontwikkelpakket wat de zeef ermee doet, voor #685 en #712.

				#685 repareerde een dubbeling in de OR-lijst van MoetenWordenWeggezeefd waardoor de twaalf NbSGenuanceerd-pakketten in geen enkele variant werden weggezeefd. De toets: in BAU, BAU2 en NbSMax hoort elk pakket met is_nbsgenuanceerd 1 op nul beschikbare cellen te staan, en in NbSGenuanceerd hoort dat juist niet zo te zijn. Dezelfde regel geldt spiegelbeeldig voor is_nbsmax.

				geen_toegestane_bouwwijze verving bij #723 de kolommen veen_bodemdaling en veen_drijvend van #712: de drie bouwwijzetoetsen zijn een keuzeregel geworden en de zeef ziet alleen nog of geen enkele toegestane bouwwijze voldoet. In BAU en BAU2 telt de kolom alleen de dieptetoets, want BouwwijzeVeenGeldtVoorOPs staat daar uit; in de NbS-varianten tellen de veeneisen mee.";
}