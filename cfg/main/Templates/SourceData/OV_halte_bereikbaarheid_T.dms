// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Leest de reistijd naar de eerstvolgende OV-halte uit een raster, voor een combinatie van maat, hoofdvervoerwijze,
// OV-modaliteit en interval. Staat los in Templates omdat hij nergens anders thuishoort: de enige aanroeper zit in
// /SourceData/Diversen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template OV_halte_bereikbaarheid_T
: Descr = "Template om de bereikbaarheid van OV haltes te bepalen op basis van een raster met reistijden."
{
	//
	parameter<Classifications/bereikbaarheid/OV_halte_bereikbaarheidK/CombiK> id;
	unit<IPoint> domain;
	//
	
	parameter<String> SrcRef := '%RSo_DataDir%/Omgeving/OV_halte_bereikbaarheid/OD_korste_@Maat@_@HHMod@_eerstehaltevan_@OVMod@_@OVInt@.tif';
	
	attribute<min> Resultaat0_rdc_100m (/Geography/rdc_100m): StorageName =
		"= replace(SrcRef,
			'@Maat@',  Classifications/Bereikbaarheid/OV_halte_bereikbaarheidK/CombiK/MaatK_SrcRef[id],
			'@HHMod@', Classifications/Bereikbaarheid/OV_halte_bereikbaarheidK/CombiK/HhModK_SrcRef[id],
			'@OVMod@', Classifications/Bereikbaarheid/OV_halte_bereikbaarheidK/CombiK/OVModK_SrcRef[id],
			'@OVInt@', Classifications/Bereikbaarheid/OV_halte_bereikbaarheidK/CombiK/OVIntK_SrcRef[id]
		)";
	attribute<min> Resultaat0 (domain) := Resultaat0_rdc_100m[domain/rdc_100m_rel], Descr = "De reistijdtifs zijn geleverd op 100 meter. Ze worden op rdc_100m gelezen en hier op het gevraagde domein gezet, zodat Per_AdminDomain op 25 meter werkt zonder dat GDAL het raster stil resamplet (#759).";
	attribute<min> Resultaat (domain) := Resultaat0 == 0[min] ? 60[min] : Resultaat0;
}
