// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Unioned de geometrie van een laddertrede per provincie en splitst hem, zodat er geen overlappingen meer zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Union_T
: Descr = "Template om de geometrie van de laddertreden te unionen en splitsen zodat er geen overlappingen meer zijn."
{
	unit<UInt32> domain;
	attribute<rdc_meter> geometry (domain, poly);
	parameter<Classifications/Zonneladder/LadderTreden> Laddertrede_rel;
	//
	attribute<provincie> prov_rel (domain) := point_in_polygon(centroid_or_mid(geometry), provincie/geometry);
	
	unit<UInt32> unioned_domain := geos_split_union_polygon(geometry, prov_rel)
	{
		attribute<Classifications/Zonneladder/LadderTreden> Laddertrede_rel := const(../Laddertrede_rel, ., Classifications/Zonneladder/LadderTreden);
		attribute<Bool> Defined_per_rdc_10m           (rdc_10m) := IsDefined(poly2grid(geometry, rdc_10m));
		attribute<Bool> Defined_Per_AdminDomain0 (AdminDomain) := sum_uint32(Defined_per_rdc_10m, /Geography/rdc_10m/AdminDomain_rel) > 0;
		attribute<Bool> Defined_Per_AdminDomain  (AdminDomain) := Defined_Per_AdminDomain0 && !/BaseData/Omgeving/GrootWater1500mBuffer;
	}
	
	attribute<rdc_meter> unioned_geometry (unioned_domain, poly) := unioned_domain/geometry;
}
