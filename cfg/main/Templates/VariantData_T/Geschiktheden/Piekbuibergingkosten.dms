// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Berekening van de aanlegkosten van de piekbuibergingsmaatregelen per ontwikkelpakket.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Piekbuibergingkosten
: Descr = "De aanlegkosten van de piekbuibergingsmaatregelen die bij een ontwikkelpakket horen (#798): een nieuwe wijk legt zijn groene daken, halfverharding, holle wegen, wadi's en doorlatend groen
			aan als onderdeel van het pakket, dus die rekening hoort in het exploitatiesaldo. Gelezen door Templates/Suitabilities/Suitability_Wonen_perOP_T.dms. De maatregelen, de oppervlakken
			(OP_Buurt/Terreinoppervlakte) en de fracties uit VariantK zijn dezelfde als in de bergingsindicator (Templates/Indicatoren/Piekbuiberging/Aanbod/WaarAllocatieHeeftPlaatsgevonden.dms,
			container Wonen), anders meet de indicator een andere maatregel dan waarvoor de allocatie heeft betaald; daar per gealloceerde cel, hier per pakket, want het saldo moet bekend zijn voordat
			de allocatie kiest. Het kental is wel een ander: de indicator rekent met de volle aanlegprijs en deze post met de meerkosten boven de reguliere uitvoering, omdat het saldo de
			grondproductiekosten al aftrekt en die de gewone straat en het gewone gazon al dekken (Classifications/WaterretentieK/MeerkostenTovRegulier). De kosten staan per hectare terrein en worden
			bij de vertaling naar cellen met NrHaPerCell geschaald; doorlatend groen ligt alleen binnen NbSOPToepassingsgebied en staat daarom apart, met het masker. Geen opslagen BijkomendeKosten en
			WinstEnRisico, want die zijn opslag op de bouwsom van de woningen en dit is terreininrichting, en geen onderhoud, want dat valt bij de beheerder en staat als indicator naast de
			bergingsindicator."
{
	container OP_Buurt := ='ThisVariantClassifications/Vastgoed/OP_Buurt';

	container Kental
	: Descr = "De aanlegkentallen uit Classifications/WaterretentieK (#798), als losse parameters en niet als opzoeking in de formules, zodat in de formules hieronder te zien is welke maatregel er staat.
			Dit is MeerkostenTovRegulier en niet AanlegkostenInclOpslag, dus wat de maatregel extra kost boven de uitvoering die er zonder bergingsambitie zou liggen: het exploitatiesaldo trekt ook de
			grondproductiekosten af, en die dekken de straat die er sowieso komt. De bergingsindicator telt de volle prijs, want die vraagt wat er ligt; de twee bedragen horen te verschillen, en alleen
			bij de halfverharding en de wadi doen ze dat ook."
	{
		parameter<Eur_m2> GroenDak        := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/GroenDak];
		parameter<Eur_m2> GroenDakSchuin  := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/GroenDakSchuin], Descr = "Een groen dak op een schuin dak bergt niets maar kost wel hetzelfde, dus deze rij draagt hier wel een bedrag en in de bergingsindicator een capaciteit van nul.";
		parameter<Eur_m2> BlauwDak        := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/BlauwDak];
		parameter<Eur_m2> Halfverharding  := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/Halfverharding], Descr = "De enige rij waar het verschil met de volle prijs groot is: 100 euro per m2 voor de maatregel, waarvan 30 de reguliere bestrating is die de grondproductiekosten al dragen.";
		parameter<Eur_m2> HolleWeg        := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/HolleWeg];
		parameter<Eur_m2> Wadi            := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/Wadi];
		parameter<Eur_m2> DoorlatendGroen := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/DoorlatendGroen];
		parameter<Eur_m2> BergingOpWater  := /Classifications/WaterretentieK/MeerkostenTovRegulier[/Classifications/WaterretentieK/V/BergingOpWater], Descr = "Nul: peilopzet is een besluit van waterschap of gemeente en geen aanlegpost, zie de wikiregel Berging door de realisatie van extra berghoogte. De term staat er wel, zodat zichtbaar is dat de maatregel is meegewogen en niet vergeten.";
	}

	parameter<float32> FractieGroenDak                  := /VariantParameters/VariantK/FractieGroenDakNieuwbouw[Variant_rel];
	parameter<float32> FractieBlauwDak                  := /VariantParameters/VariantK/FractieBlauwDakNieuwbouw[Variant_rel];
	parameter<float32> FractieHalfverhardingUitgeefbaar := /VariantParameters/VariantK/FractieHalfverhardingNieuwbouwUitgeefbaar[Variant_rel];
	parameter<float32> FractieHalfverhardingOpenbaar    := /VariantParameters/VariantK/FractieHalfverhardingNieuwbouwOpenbaar[Variant_rel];
	parameter<float32> FractieHolleWeg                  := /VariantParameters/VariantK/FractieHolleWegNieuwbouwWijkweg[Variant_rel] * /ModelParameters/Piekbuiberging/AandeelWijkwegInOpenbareVerharding
	, Descr = "De fractie uit VariantK slaat op de wijkweg en wordt hier met AandeelWijkwegInOpenbareVerharding omgerekend naar de hele openbare verharding, precies zoals in de bergingsindicator (#757). Het ontwikkelpakket kent geen rijbaan apart.";
	parameter<float32> FractieWadiUitgeefbaar          := /VariantParameters/VariantK/FractieWadiNieuwbouwUitgeefbaarGras[Variant_rel];
	parameter<float32> FractieWadiOpenbaar             := /VariantParameters/VariantK/FractieWadiNieuwbouwOpenbaarGras[Variant_rel];
	parameter<float32> FractieDoorlatendGroen          := /VariantParameters/VariantK/FractieDoorlatendGroenNieuwbouw[Variant_rel];
	parameter<float32> FractieBergingOpWater           := /VariantParameters/VariantK/FractieBergingOpWaterNieuwbouw[Variant_rel];

	attribute<float32> FractiePlatDak (OP) := /ModelParameters/Piekbuiberging/Dakvorm/FractiePlatDak[OP/WP2_rel]
	, Descr = "Het platte aandeel van het dak volgens het woningtype van het pakket. Een pakket hoort bij een WP2xVSSH en is dus homogeen eengezins of meergezins, net als de modelnieuwbouwtak van de bergingsindicator.";

	container PerBuurt
	: Descr = "De aanlegkosten per pakket, in euro per hectare terrein, per maatregelgroep. De groepen volgen de containers van de bergingsindicator, zodat de twee naast elkaar te lezen zijn."
	{
		attribute<Terreinoppervlak> Dakoppervlak       (OP) := OP_Buurt/Terreinoppervlakte/Uitgeefbaar/GebouwVoetafdruk;
		attribute<Terreinoppervlak> DakoppervlakPlat   (OP) := Dakoppervlak * FractiePlatDak;
		attribute<Terreinoppervlak> DakoppervlakSchuin (OP) := Dakoppervlak - DakoppervlakPlat;

		attribute<Eur> Daken (OP) := add(
			  DakoppervlakPlat   * FractieGroenDak * Kental/GroenDak
			, DakoppervlakSchuin * FractieGroenDak * Kental/GroenDakSchuin
			, DakoppervlakPlat   * FractieBlauwDak * Kental/BlauwDak
		)
		, Descr = "Het groene dak ligt op het hele dak en het blauwe alleen op het platte deel, dezelfde drie termen als in de bergingsindicator (#746). Anders dan daar levert het schuine groene dak hier wel een bedrag, want het kost hetzelfde en bergt alleen niets.";

		attribute<Eur> VerhardUitgeefbaar (OP) := OP_Buurt/Terreinoppervlakte/Uitgeefbaar/Buitenruimte/Verhard * FractieHalfverhardingUitgeefbaar * Kental/Halfverharding;

		attribute<Eur> VerhardOpenbaar (OP) := OP_Buurt/Terreinoppervlakte/Openbaar/Verhard * (
			  FractieHalfverhardingOpenbaar * Kental/Halfverharding
			+ FractieHolleWeg               * Kental/HolleWeg
		)
		, Descr = "De halfverharding ligt op de hele openbare verharding en de holle weg op het wijkwegdeel ervan. Die twee delen dat oppervlak niet maar liggen erop, dus de bedragen tellen op; dat is dezelfde gelaagde lezing als in de bergingsindicator en in #757.";

		attribute<Eur> GrasWadi (OP) := add(
			  OP_Buurt/Terreinoppervlakte/Uitgeefbaar/Buitenruimte/Groen/Gras * FractieWadiUitgeefbaar * Kental/Wadi
			, OP_Buurt/Terreinoppervlakte/Openbaar/Groen/Gras                 * FractieWadiOpenbaar    * Kental/Wadi
		);

		attribute<Eur> Water (OP) := OP_Buurt/Terreinoppervlakte/Totaal/Water * FractieBergingOpWater * Kental/BergingOpWater;

		attribute<Eur> ExclDoorlatendGroen (OP) := add(Daken, VerhardUitgeefbaar, VerhardOpenbaar, GrasWadi, Water)
		, Descr = "Alles wat overal geldt. Doorlatend groen staat er niet in, want dat ligt alleen binnen NbSOPToepassingsgebied en dat is een eigenschap van de plek.";

		attribute<Terreinoppervlak> OverigGroen (OP) := OP_Buurt/Terreinoppervlakte/Totaal/Groen - OP_Buurt/Terreinoppervlakte/Totaal/Groen/Gras
		, Descr = "Boom en struik samen, het groen dat geen gras is. Daar ligt geen wadi, dus daar gaat de hele doorlatendgroenfractie overheen.";

		attribute<Eur> DoorlatendGroen (OP) := add(
			  OP_Buurt/Terreinoppervlakte/Uitgeefbaar/Buitenruimte/Groen/Gras * min_elem(1f - FractieWadiUitgeefbaar, FractieDoorlatendGroen)
			, OP_Buurt/Terreinoppervlakte/Openbaar/Groen/Gras                 * min_elem(1f - FractieWadiOpenbaar,    FractieDoorlatendGroen)
			, OverigGroen                                                     * FractieDoorlatendGroen
		) * Kental/DoorlatendGroen
		, Descr = "Op gras krijgt de wadi voorrang en houdt het doorlatend groen wat overblijft, met dezelfde min_elem als in de bergingsindicator; op boom en struik ligt geen wadi. Deze term geldt alleen waar het masker aanstaat, zie perOP hieronder.";
	}

	attribute<Bool> IsNbSOPToepassingsgebied (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/NbSOPToepassingsgebied/Hoog_NL)
	, Descr = "Waar doorlatend groen mag liggen. Dezelfde kaart die de bergingsindicator gebruikt om de fractie doorlatend groen aan of uit te zetten.";

	container perOP := for_each_nedv(
		  OP/name
		, '(PerBuurt/ExclDoorlatendGroen['+string(id(OP))+'[OP]] + PerBuurt/DoorlatendGroen['+string(id(OP))+'[OP]] * float32(IsNbSOPToepassingsgebied)) * AdminDomain/NrHaPerCell[float32]'
		, CompactedAdminDomain
		, Eur
	)
	, Descr = "De aanlegkosten van dit pakket op deze cel. De kosten per hectare zijn een eigenschap van het pakket, dus de cel voegt alleen de oppervlaktemaat toe en, voor doorlatend groen, of de maatregel daar mag liggen.";
}
