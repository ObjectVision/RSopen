// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Berekening van bouwkosten van potentiele ontwikkelpakketen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bouwkosten
: Descr = "Berekening van bouwkosten van potentiele ontwikkelpakketen."
{
	container perOP := for_each_nedv(
		  OP/name
		, 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, MakeDefined(BaseValues/'+OP/VSSH_name+', mean(BaseValues/'+OP/VSSH_name+')))' // prijs per m2 bvo; nodata (buiten landsdeel-polygonen) krijgt het landelijk gemiddelde i.p.v. 1 eur/m2 (#595)
				+ '* OP/Dichtheid['+string(id(OP))+'[OP]] * OP/BVOPerWoning['+string(id(OP))+'[OP]]' // totale bvo in OP per Terreinoppervlakte (e.g. 1 ha)
				+ '* AdminDomain/NrHaPerCell'                                                                                    // Aantal ha in cell
				+ (/ModelParameters/Wonen/BouwwijzeOpslagInBouwkosten ? '* BouwwijzeOpslag/'+OP/name+'/Keuze/GekozenKostenopslag' : '') // opslagfactor van de gekozen bouwwijze per cel (#505, #723); op FALSE staat er geen factor in de formule
				+ '* WoningtypeOpslag_perOP['+string(id(OP))+'[OP]]'                                                             // relatieve bouwkosten van het woningtype van dit OP (#673); genormaliseerd, dus mix-neutraal
				+ '* BouwlaagOpslag_perOP['+string(id(OP))+'[OP]]'                                                               // relatieve bouwkosten van de bouwlaagklasse (#673); 1,0 zolang de schakelaar uit staat
		, CompactedAdminDomain
		, Eur
	);
	
	container BouwwijzeInput
	: Descr = "De pakketonafhankelijke invoer voor de bouwwijzekeuze (#723): wat de plek eist. Dezelfde eisen als de zeef leest, zodat de opslag hoort bij de bouwwijze die daar ook gekozen wordt."
	{
		attribute<meter> Waterdiepte (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/Overstromingsdiepte);

		parameter<Bool> VeenGeldt := ='VariantParameters/VariantK/BouwwijzeVeenGeldtVoorOPs[VariantParameters/VariantK/V/'+Variant_name+']';

		attribute<Bool> EisBodemdalingbestendig (CompactedAdminDomain) := VeenGeldt ? BouwwijzeEis/Bodemdalingbestendig : const(FALSE, CompactedAdminDomain);
		attribute<Bool> EisDrijvend             (CompactedAdminDomain) := VeenGeldt ? BouwwijzeEis/Drijvend             : const(FALSE, CompactedAdminDomain);
	}

	Template BouwwijzeOpslag_perOP_T
	: Descr = "De bouwwijzekeuze en daarmee de kostenopslag per cel voor een ontwikkelpakket (#505, #723): de opslag hoort bij de bouwwijze die op de cel gekozen wordt, uit hetzelfde sjabloon waarmee de zeef toetst."
	{
		parameter<OP> OP_rel;
		//

		container Toegestaan :=
			for_each_nedv(
				  /Classifications/Modellering/BouwwijzeK/name
				, 'const(OP/Bouwwijze/Toegestaan/' + /Classifications/Modellering/BouwwijzeK/name + '[OP_rel], CompactedAdminDomain)'
				, CompactedAdminDomain
				, bool
			);

		container Keuze := Templates/Beschikbaarheden/Bouwwijzekeuze_T(
			  Toegestaan
			, BouwwijzeEis/Overstromingsbestendig
			, BouwwijzeInput/EisBodemdalingbestendig
			, BouwwijzeInput/EisDrijvend
			, BouwwijzeInput/Waterdiepte
		);
	}

	container BouwwijzeOpslag := = /ModelParameters/Wonen/BouwwijzeOpslagInBouwkosten
		? 'for_each_ne(OP/name, ' + quote('BouwwijzeOpslag_perOP_T(') + ' + string(id(OP)) + ' + quote('[OP])') + ')'
		: 'for_each_nedv(OP/name, ' + quote('1f') + ', void, Float32)'
	, Descr = "Per ontwikkelpakket de bouwwijzekeuze per cel, alleen opgebouwd als de schakelaar aanstaat. Op FALSE staat hier een rij losse parameters die nergens gelezen worden, want de formule in perOP laat de factor dan helemaal weg: dat is dezelfde uitkomst als het vermenigvuldigen met exact 1,0 van voor #723, zonder het werk.";
	
	attribute<Float32> WoningtypeOpslag_perOP (OP) :=
		  /ModelParameters/Wonen/Bouwkosten_Woningtype/Index_perWP4[OP/WP4_rel]
		/ /ModelParameters/Wonen/Bouwkosten_Woningtype/Normalisator_perVSSH[OP/VSSH_rel]
	, IntegrityCheck = "all(this > 0f)"
	, Descr = "De relatieve bouwkosten per m2 bvo van het woningtype van dit ontwikkelpakket, gedeeld door het gemiddelde van diezelfde verhouding binnen de huursector (#673), zodat een appartementengebouw
				per m2 bvo niet evenveel kost als een vrijstaande woning. Geen schakelaar, want dit is een verbetering en geen open aanname; de kentallen en de onderbouwing staan in
				ModelParameters/Wonen/Bouwkosten_Woningtype. De deling voorkomt dat de differentiatie boven op het CBS-kental komt en het landelijke kostenniveau optilt, en dat de type-mix die al in de
				CBS-as huur tegen koop zit een tweede keer wordt geteld. De IntegrityCheck vangt de stille null af: OP/WP4_rel is een rlookup op de tekstkolom van de pakkettentabel, en een typefout daar
				geeft zonder deze check een null die de hele bouwkostenkaart van dat pakket null maakt, waarna het pakket zonder foutmelding uit de ArgMax valt.";

	attribute<Float32> BouwlaagOpslag_perOP (OP) := const(1f, OP)
	, Descr = "Geen opslag naar het aantal bouwlagen (#673): binnen het bereik van deze pakkettentabel meten de bronnen geen stijging maar een vlakke tot licht dalende reeks, zie
				Classifications/Modellering/BouwlaagK, waar de klassen en de onderbouwing staan voor wie de opslag weer wil aansluiten. Geen dubbeltelling met de vormfactor:
				VormfactorHoogbouw maakt hoogbouw al ongunstiger, maar uitsluitend op de opbrengstenkant via een lagere dichtheid, en de bouwkostenpost per hectare is vormfactor-invariant, want Dichtheid
				maal BVOPerWoning is per definitie FSI maal Terreinoppervlakte.";

	unit<UInt32> BaseValues := ModelParameters/Wonen/Bouwkosten;
}