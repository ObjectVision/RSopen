// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Berekening van bouwkosten van potentiele ontwikkelpakketen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bouwkosten
: Descr = "Berekening van bouwkosten van potentiele ontwikkelpakketen."
{
	container perOP := for_each_nedv(
		  OP/name
		, 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, MakeDefined(BaseValues/'+OP/VSSH_name+', mean(BaseValues/'+OP/VSSH_name+')))' // prijs per m2 bvo; nodata (buiten landsdeel-polygonen) krijgt het landelijk gemiddelde i.p.v. 1 eur/m2 (#595)
				'* OP/Dichtheid['+string(id(OP))+'[OP]] * OP/BVOPerWoning['+string(id(OP))+'[OP]]' // totale bvo in OP per Terreinoppervlakte (e.g. 1 ha)
				'* AdminDomain/NrHaPerCell'                                                                                    // Aantal ha in cell
				'* BouwwijzeOpslag_perOP['+string(id(OP))+'[OP]]'                                                              // opslagfactor van de bouwwijze van dit OP (#505); 1,0 zolang de kentallen ontbreken
		, CompactedAdminDomain
		, Eur
	);
	
	attribute<Float32> BouwwijzeOpslag_perOP (OP) := = /ModelParameters/Wonen/BouwwijzeOpslagInBouwkosten
		? '/Classifications/Modellering/BouwwijzeK/Kostenopslag[OP/Bouwwijze]'
		: 'const(1f, OP)'
	, IntegrityCheck = "all(this > 0f)"
	, Descr = "De kostenopslag van de bouwwijze die bij dit ontwikkelpakket hoort. De bouwwijze hangt aan het OP en niet aan de cel, dus de opslag werkt per ontwikkelpakket en niet per locatie: dezelfde as die de zeef leest in Zeef_Wonen_perOP_T.

				Met de schakelaar uit staat hier overal een 1 en verandert de vermenigvuldiging in perOP niets, want vermenigvuldigen met exact 1,0 is in drijvende komma een identiteit. De keuze staat in een metascript-conditie en niet in een ternair over data, zodat er op FALSE letterlijk const(1f, OP) in de boom staat en de andere tak niet wordt uitgerekend.";
	
	unit<UInt32> BaseValues := ModelParameters/Wonen/Bouwkosten;
}