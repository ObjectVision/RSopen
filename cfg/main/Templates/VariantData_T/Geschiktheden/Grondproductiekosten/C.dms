////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de modelvarianten, onzekerheidsscenario's en combinaties daarvan voor de schatting van de
// grondproductiekosten. Unieke set van variabelen die in de verschillende modelvarianten voorkomen. Dit betreft
// de variabelen die als controlevariabelen zijn opgenomen in de modellen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container C
: Descr = "Bevat de modelvarianten, onzekerheidsscenario's en combinaties daarvan voor de schatting van de grondproductiekosten."
{
	unit<UInt32> GrondproductieVariabelen0 := = 'union_unit('+asItemList('ReadData/'+GrondproductieModelVarianten/name+'/ModelVariant')+')'
	{
		attribute<String> name := = 'union_data(.,'+asItemList('ReadData/'+GrondproductieModelVarianten/name+'/ModelVariant/variabele')+')';
	}
	
	unit<UInt32> GrondproductieVariabelen := unique(GrondproductieVariabelen0/name)
	, Descr = "Unieke set van variabelen die in de verschillende modelvarianten voorkomen."
	{
		attribute<String> name := values;
		
		attribute<Bool> IsControleVar :=
			id(.) == V/BerekeningssystematiekOnbekend ||
			id(.) == V/BronFakton                     ||
			id(.) == V/BoekwaardeOpgevoerd            ||
			id(.) == V/BoekwaardeOpgevoerdOnbekend    ||
			id(.) == V/OnVoorzienVerdeeld             ||
			id(.) == V/Vermenging, Descr = "Dit betreft de variabelen die als controlevariabelen zijn opgenomen in de modellen.";
		
		attribute<String> DefaultWaarde :=
			id(.) == V/Intercept            ? '1f' :
			id(.) == V/OmvangPlangebied     ? 'log(Grondproductiekosten/ReadData/LocatieVariabelen/OmvangPlangebied)':
			id(.) == V/Kaveldichtheid2018   ? 'Grondproductiekosten/ReadData/LocatieVariabelen/Kaveldichtheid' :
			id(.) == V/AndersBouwen         ? 'Grondproductiekosten/ReadData/LocatieVariabelen/AndersBouwen' :
			id(.) == V/Reistijd5kInw        ? 'Grondproductiekosten/ReadData/LocatieVariabelen/Reistijd5kInw' :
			id(.) == V/BoekwaardeOpgevoerd  ? '1f' :
			id(.) == V/BronFakton           ? '1f' :
			'0f', Descr = "Dit betreft de variabelen waarvoor de waarden (referentiewaarde of niet) duidelijk (gegeven) zijn. BronFakton staat hier alleen als terugvalwaarde: zolang hij hieronder als bronvariabele is
					aangemerkt komt zijn waarde uit de dimensie Onzekerheid2 en wordt deze regel niet gelezen; hij staat er zodat de variabele niet stil op de eindwaarde 0 valt als die aanmerking ooit vervalt.";

		attribute<Bool> IsOnzekereControleVar := id(.) == V/BronFakton, Descr = "De variabele die niet over de locatie gaat maar over de herkomst van de waarneming, en waarvan de waarde daarom uit de dimensie Onzekerheid2 komt. BronFakton scheidt de openbare
					exploitatieplannen van ruimtelijkeplannen.nl van de vertrouwelijke exploitaties uit de database van het bureau (correspondentie PBL en Fakton, september 2018); bij het voorspellen kies je
					met hem voor welk van beide soorten plannen je rekent, en die keuze geldt voor alle drie de componenten tegelijk. Een keuze per component op het teken van de coefficient zou voor een en
					hetzelfde plangebied de aanlegkosten van het ene soort plan optellen bij de plankosten van het andere.";
		
		attribute<String> Label := name;
		
		container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
	}
	
	unit<UInt32> GrondproductieModelVarianten := Classifications/Vastgoed/GrondproductieModelVarianten;
	
	unit<UInt8> Onzekerheid1: NrOfRows = 3
	, Descr = "Omvat onzekerheid o.b.v. standaardfout: lage, nominale en hoge coëfficiënt waarde."
	{
		attribute<String> name: ['Low', 'Nominaal', 'High'];
		attribute<String> CalcStr := union_data(., 'CoefficientStr+'+quote('-')+'+StderrorStr', 'CoefficientStr', 'CoefficientStr+'+quote('+')+'+StderrorStr');
	}
	
	unit<UInt8> Onzekerheid2: NrOfRows = 2
	, Descr = "Voor welk van de twee soorten grondexploitaties in de dataset wordt gerekend; zie IsOnzekereControleVar hierboven voor waar die tweedeling vandaan komt. Van de twee bronnen is Faktondatabase de goedkoopste. Er hangen geen bestandsnamen aan deze namen; de keuze staat in ModelParameters/Wonen/grondproductie_kosten_Variant."
	{
		attribute<String> name: ['Exploitatieplannen', 'Faktondatabase'];
		attribute<String> BronFaktonWaarde: ['0f', '1f'], Descr = "De waarde die de dummy BronFakton krijgt, als expressiestring voor T/CalculateCosts/VariableValue_ref. Openbare exploitatieplannen zijn de referentiecategorie van de schatting en dragen dus 0.";
	}
	
	unit<UInt32> Onzekerheid := combine(Onzekerheid1, Onzekerheid2)
	, Descr = "Combinatie van de twee onzekerheidsdimensies: coëfficiënt onzekerheid en onzekerheid in de controlevariabelen."
	{
		attribute<String> Onzekerheid1_name := Onzekerheid1/name[first_rel];
		attribute<String> Onzekerheid2_name := Onzekerheid2/name[second_rel];
		attribute<String> name := Onzekerheid1_name+'_'+Onzekerheid2_name;
	}
	
	unit<UInt32> Combi := combine(GrondproductieModelVarianten, Onzekerheid)
	, Descr = "Combinatie van de modelvarianten en de onzekerheidsscenario's."
	{
		attribute<String> GrondproductieModelVarianten_name := GrondproductieModelVarianten/name[first_rel];
		attribute<String> Onzekerheid_name := Onzekerheid/name[second_rel];
		attribute<String> name := GrondproductieModelVarianten_name+'/'+Onzekerheid_name;
		attribute<String> Label := GrondproductieModelVarianten_name+'_'+Onzekerheid_name;
	}
	
	unit<UInt32> Extent: NrOfRows = 3
	, Descr = "Omvat de drie verschillende extenties voor de grondproductiekosten: BinnenUrbanContour, BuitenUrbanContour en Totaal."
	{
		attribute<String> name: ['BinnenUrbanContour', 'BuitenUrbanContour', 'Totaal'];
		attribute<String> CalcStr: ['UrbanContour', '!UrbanContour', 'UrbanContour || !UrbanContour'];
	}
	
	unit<UInt32> Indicator: NrOfRows = 7
	, Descr = "Omvat de verschillende indicatoren die van de geschatte grondproductiekosten kunnen worden berekend."
	{
		attribute<String> name: ['mean', 'sd', 'min', 'rth_element_20', 'rth_element_50', 'rth_element_80', 'max'];
		attribute<String> Label := name, DialogType = "LabelText";
	}
	
	unit<UInt32> ExtentxIndicator := combine(Extent, Indicator)
	, Descr = "Combinatie van de extenties en de indicatoren."
	{
		attribute<String> Extent_name := Extent/name[first_rel];
		attribute<String> Indicator_name := Indicator/name[second_rel];
		attribute<String> name := Extent_name+'_'+Indicator_name;
	}
}