////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
//
// Template voor de economische berekening van de drie melkveeklassen (gg_vee_extensief, gg_vee, gg_vee_intensief), #780.
// Saldo per hectare = koeien per ha maal het KWIN-saldo per koe, plus de ruwvoerbalans, min de grondkosten per ha, min de
// mestafzet boven de gebruiksnorm, plus de GLB per ha. Parameters in ModelParameters/Landbouw/Melkvee_parameters.dms.
// Kapitalisatie en transitiekosten zijn identiek aan Akkerbouw_T.
//
// Tot 7 september 2026 stond hier het voedermodel uit LUS_AgriVali2011 (FCE, TotalFeed, Feed_concentrates, Holding_costs), met
// klasseparameters die uit PBL 2016 (Dalende bodems, stijgende kosten, tabel B6) bleken te komen. Zie #780 voor de herleiding.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Dairy_T : using = "Classifications/Landbouw"
{
	parameter<String>           LandbouwKlasse_name;
	//

	container                   ParametersKlasse              := ='/ModelParameters/Landbouw/per_ModelType/'+LandbouwKlasse_name;

	attribute<Eur_m2>           Totaal_NonAugmented      (rdc_25m) := Economic_performance/Net_revenues * Kapitalisatie/factor - Economic_performance/Conversion_costs
	, Descr = "Contante waarde van het saldo per hectare over de afschrijvingsperiode tegen de rentevoet van de boervariant, min de transitiekosten. Het saldo bevat geen arbeid (KWIN Veehouderij 2025-2026: berekende loonkosten ondernemer 79.800 per jaar), geen gebouwen (ligboxenstal 5.320 tot 9.370 per koeplaats bij 7 procent jaarkosten is 550 tot 1.000 per ha bij de referentiedichtheid, blz. 154 en 155), geen machines en geen rente over vee of omlopend kapitaal; BIN 2024 rekent voor kapitaal en prive 18,47 euro per 100 kg melk, met een kritieke melkprijs van 45,6 tot 49 cent. De gekapitaliseerde waarde is dus een bovengrens voor de betalingsbereidheid voor grond en geen winst. De niet-toegerekende kosten liggen voor melkvee per ha hoger dan voor akkerbouw, dus de vergelijking op saldo zet melkvee eerder te gunstig dan te ongunstig.";
	attribute<Eur_m2>           NPV                      (rdc_25m) := Economic_performance/Net_revenues * KapitalisatieMaatschappelijk/Factor - Economic_performance/Conversion_costs, Descr = "NPV";
	attribute<Eur_m2>           Totaal                   (rdc_25m) := Totaal_NonAugmented;
	attribute<Float32>          Suitability              (rdc_25m) := Totaal, Descr = "Uiteindelijke suitability die aan de alloc module wordt meegegeven.";
	attribute<Eur_m2_jaarlijks> NetRevenue               (rdc_25m) := Economic_performance/Net_revenues;

	container Kapitalisatie                := ='Kapitalisatie_T(LandbouwKlasses/V/'+LandbouwKlasse_name+', RentevoetDezeBoer, ModelParameters/Landbouw/afschrijvingsperiode)';
	container KapitalisatieMaatschappelijk := ='Kapitalisatie_T(LandbouwKlasses/V/'+LandbouwKlasse_name+', ModelParameters/Landbouw/Rentevoet, PeriodDuRation)';

	// ---- 1. bodem en dichtheid ----

	attribute</Classifications/Landbouw/Bodemtak> Bodemtak_rel (rdc_25m) := /SourceData/Landbouw/HELP/Bodemtak_rel;
	attribute<Bool>   HeeftBodem   (rdc_25m) := /SourceData/Landbouw/HELP/HeeftBodem;
	attribute<koe_ha> Koedichtheid (rdc_25m) := /ModelParameters/Landbouw/Melkvee/Dichtheid/D_ref[Bodemtak_rel] * ParametersKlasse/Koedichtheid_factor
	, Descr = "Melkkoeien per ha voor de geschiktheid: de referentiedichtheid per bodemtak maal de klassefactor (0 op natuurlijk grasland, 1 op productiegrasland). Dit is de aansluiting voor de CBS-koedichtheid per gemeente en het regime per variant uit het advies van 7 september 2026: vervang alleen de rechterkant.";
	parameter<Float32> NietNatuurlijk := ParametersKlasse/IsNatuurlijkGrasland ? 0f : 1f
	, Descr = "Nul op natuurlijk beheerd grasland, een op productiegrasland; schakelt mais en deep drainage uit op natuurlijk grasland. IsNatuurlijkGrasland is een parameter, dus alle keuzes hieronder zijn gewone iif-keuzes en geen meta-expressies.";

	// ---- 2. voeraanbod, ton droge stof per ha per jaar ----

	attribute<Ratio>            Aandeel_mais        (rdc_25m) := /ModelParameters/Landbouw/Melkvee/Grond/Aandeel_mais[Bodemtak_rel] * NietNatuurlijk;
	attribute<Ratio>            Aandeel_gras        (rdc_25m) := 1[Ratio] - Aandeel_mais;
	attribute<Float32>          YieldReduction_Gras (rdc_25m) := factoren/YieldReduction/Result/Gras, Descr = "Opbrengstderving gras uit de Water Wijzer Landbouw plus verzilting, als fractie tussen nul en een; Result garandeert dat met min_elem en een IntegrityCheck, dus hier is geen null-risico.";
	attribute<Float32>          YieldReduction_Mais (rdc_25m) := factoren/YieldReduction/Result/Mais;
	attribute<ton_ha_jaarlijks> DDGrassYield        (rdc_25m) := /Classifications/Landbouw/DeepDrainageK/DDGrassYield[DeepDrainageVariant] * /SourceData/Landbouw/HELP/DDPossible * NietNatuurlijk, Descr = "Extra grasopbrengst door deep drainage waar dat kan, alleen op productiegrasland.";
	attribute<ton_ha_jaarlijks> Grasopbrengst_netto (rdc_25m) := ParametersKlasse/IsNatuurlijkGrasland
																? /ModelParameters/Landbouw/Melkvee/Grond/Grasopbrengst_natuurlijk
																: /ModelParameters/Landbouw/Melkvee/Grond/Grasopbrengst_bruto[Bodemtak_rel] * /ModelParameters/Landbouw/Melkvee/Grond/Verlies_veld_inkuil * /ModelParameters/Landbouw/Melkvee/Grond/Verlies_beweiding + DDGrassYield
	, Descr = "Netto benutbare grasopbrengst per ha grasland bij derving nul: bruto opbrengst per bodemtak maal het veld- en inkuilverlies maal het beweidingsverlies, plus deep drainage; op natuurlijk grasland de netto opbrengst van de zoogkoeientabel.";
	attribute<ton_ha_jaarlijks> Gras_DM             (rdc_25m) := Grasopbrengst_netto * (1f - YieldReduction_Gras) * Aandeel_gras;
	attribute<ton_ha_jaarlijks> Mais_DM             (rdc_25m) := /ModelParameters/Landbouw/Melkvee/Grond/Maisopbrengst_bruto[Bodemtak_rel] * /ModelParameters/Landbouw/Melkvee/Grond/Verlies_inkuil_mais * (1f - YieldReduction_Mais) * Aandeel_mais;
	attribute<ton_ha_jaarlijks> Ruwvoer_aanbod      (rdc_25m) := Gras_DM + Mais_DM, Descr = "Eigen ruwvoer per ha van de klasse, na derving.";

	// ---- 3. saldo per hectare ----

	parameter<Eur_koe_jaarlijks> Saldo_dier_koe := /ModelParameters/Landbouw/Melkvee/Dier/Melk_per_koe * /ModelParameters/Landbouw/Melkvee/Dier/MilkPrice * /VariantParameters/VariantK/PriceMult_Melk[variant_rel]
	                                             + /ModelParameters/Landbouw/Melkvee/Dier/Omzet_en_aanwas - /ModelParameters/Landbouw/Melkvee/Dier/Dierkosten - /ModelParameters/Landbouw/Melkvee/Dier/Afrastering
	, Descr = "KWIN-saldo per melkkoe zonder de grondposten en zonder loonwerk: 9.000 kg maal 49 cent maal de prijsmultiplier, plus omzet en aanwas 465, min dierkosten 1.656, min afrastering 70; 3.149 bij PriceMult_Melk 1. Staat hier en niet in Melkvee_parameters omdat variant_rel hier bekend is.";

	attribute<Eur_Ha_jaarlijks> Saldo_dier       (rdc_25m) := Koedichtheid * Saldo_dier_koe;
	attribute<ton_ha_jaarlijks> Ruwvoer_behoefte (rdc_25m) := Koedichtheid * /ModelParameters/Landbouw/Melkvee/Dier/Ruwvoer_per_koe;
	attribute<ton_ha_jaarlijks> Ruwvoer_balans   (rdc_25m) := Ruwvoer_aanbod - Ruwvoer_behoefte, Descr = "Positief is een overschot dat wordt verkocht, negatief een tekort dat wordt gekocht.";
	parameter<Eur_ton>          Prijs_verkoop             := ParametersKlasse/IsNatuurlijkGrasland ? /ModelParameters/Landbouw/Melkvee/Grond/Prijs_natuurgras : /ModelParameters/Landbouw/Melkvee/Grond/Prijs_ruwvoer_verkoop;
	attribute<Eur_Ha_jaarlijks> Voerbalans       (rdc_25m) := max_elem(Ruwvoer_balans, 0[ton_ha_jaarlijks]) * Prijs_verkoop
	                                                        + min_elem(Ruwvoer_balans, 0[ton_ha_jaarlijks]) * /ModelParameters/Landbouw/Melkvee/Grond/Prijs_ruwvoer_aankoop
	, Descr = "Overschot verkocht als gras op stam (101 per ton ds, natuurgras 75), tekort gekocht als ingekuilde snijmais (160). Dit is het boersperspectief: de koedichtheid blijft staan en de opbrengstderving kost voeraankoop en geen koeien, want een ton ds derving kost 160 euro aankoop tegen circa 485 euro saldo per ton als de koe zou verdwijnen. Gevolg: melkvee is in de allocatie veel minder gevoelig voor de hydrologie dan akkerbouw; 30 procent derving kost gg_vee op klei circa 450 per ha en aardappelen circa 2.400. Dat is een keuze en geen bijproduct, zie #780 en de dervingsklassen in Diagnose/PerIssue/Diagnose780. Wie de geschiktheid op koeienafbouw wil laten rekenen vervangt Koedichtheid door min_elem(Koedichtheid, Ruwvoer_aanbod / Ruwvoer_per_koe); dat is de enige regel die dan verandert. Beide termen zijn gedefinieerd omdat Ruwvoer_balans gedefinieerd is; min_elem en max_elem met een null zouden anders stil de constante teruggeven.";

	parameter<Eur_Ha_jaarlijks> Graslandkosten_kv := /ModelParameters/Landbouw/Kostenvoet_InclusiefLoonwerk ? /ModelParameters/Landbouw/Melkvee/Grond/Graslandkosten_loonwerk : 0[Eur_Ha_jaarlijks];
	attribute<Eur_Ha_jaarlijks> Grondkosten      (rdc_25m) := (ParametersKlasse/IsNatuurlijkGrasland
	                                                             ? /ModelParameters/Landbouw/Melkvee/Grond/Graslandkosten_natuurlijk
	                                                             : /ModelParameters/Landbouw/Melkvee/Grond/Graslandkosten[Bodemtak_rel] + Graslandkosten_kv) * Aandeel_gras
	                                                        + (/ModelParameters/Landbouw/Melkvee/Grond/Maiskosten[Bodemtak_rel]
	                                                           + (/ModelParameters/Landbouw/Kostenvoet_InclusiefLoonwerk ? /ModelParameters/Landbouw/Melkvee/Grond/Maiskosten_loonwerk[Bodemtak_rel] : 0[Eur_Ha_jaarlijks])) * Aandeel_mais
	                                                        + /Classifications/Landbouw/DeepDrainageK/DD_costs[DeepDrainageVariant] * /SourceData/Landbouw/HELP/DDPossible * NietNatuurlijk
	, Descr = "Toegerekende grondkosten per ha: graslandkosten maal het grasaandeel plus maiskosten maal het maisaandeel, op de kostenvoet eigen mechanisatie; de loonwerkregels komen er alleen bij als Kostenvoet_InclusiefLoonwerk aan staat. Plus de kosten van deep drainage waar dat kan.";

	parameter<kg_ha_jaarlijks>  Gebruiksnorm_N            := 170[kg_ha_jaarlijks], Descr = "Gebruiksnorm dierlijke mest, vanaf 2026 overal 170 kg N per ha zonder derogatie (RVO). Constante in deze commit; commit 2 vervangt dit door de kolom in VariantK via Suitability_T.";
	parameter<Eur_m3>           Mestprijs                 := /ModelParameters/Landbouw/Beleid/Mestprijs_basisjaar, Descr = "Afzetprijs van rundveedrijfmest per m3. Basisjaarwaarde in deze commit; commit 2 vervangt dit door het pad per variant en zichtjaar uit Suitability_T.";
	attribute<kg_ha_jaarlijks>  N_productie      (rdc_25m) := Koedichtheid * /ModelParameters/Landbouw/Melkvee/Mest/N_excretie_per_koe;
	attribute<kg_ha_jaarlijks>  N_overschot      (rdc_25m) := max_elem(N_productie - Gebruiksnorm_N, 0[kg_ha_jaarlijks]);
	attribute<m3_ha_jaarlijks>  Mest_afvoer      (rdc_25m) := N_overschot / /ModelParameters/Landbouw/Melkvee/Mest/N_per_m3;
	attribute<Eur_Ha_jaarlijks> Mestafzetkosten  (rdc_25m) := Mest_afvoer * Mestprijs, Descr = "Afzet van de mest boven de gebruiksnorm: bij 1,48 koe per ha en 154,2 kg N per koe is dat 58 kg N, 14,5 m3 per ha.";

	parameter<Ratio>            GLB_factor                := ParametersKlasse/IsNatuurlijkGrasland ? /ModelParameters/Landbouw/Beleid/GLB_factor_extensief : 1[Ratio];
	parameter<Eur_Ha_jaarlijks> GLB_Diensten_extensief    := 0[Eur_Ha_jaarlijks], Descr = "Vergoeding voor diensten op natuurlijk grasland (ANLb, SNL). Nul in deze commit; commit 2 vervangt dit door het pad per variant en zichtjaar uit Suitability_T.";
	parameter<Eur_Ha_jaarlijks> Veen_vergoeding           := 0[Eur_Ha_jaarlijks], Descr = "Veenweidevergoeding op grasland. Nul in deze commit, want de 30 euro ANLb-veen zit nog in TotaalSubsidie van Suitability_T; commit 2 haalt hem daaruit en zet hem hier.";
	attribute<Eur_Ha_jaarlijks> Subsidie         (rdc_25m) := TotaalSubsidie * GLB_factor
	                                                        + (ParametersKlasse/IsNatuurlijkGrasland ? GLB_Diensten_extensief : 0[Eur_Ha_jaarlijks])
	                                                        + (IsVeenGrond ? Veen_vergoeding : 0[Eur_Ha_jaarlijks])
	, Descr = "GLB (hectaresteun plus eco-regeling, TotaalSubsidie uit Suitability_T) op de hele hectare, op natuurlijk grasland maal GLB_factor_extensief omdat BRP 332 niet subsidiabel is; diensten alleen op natuurlijk grasland; de veenvergoeding op veengrond voor beide graslandklassen en niet voor de akkerbouw, want ANLb-veen en de RVO-veenweideregeling zijn graslandpakketten. In deze commit staat de veenvergoeding nog in TotaalSubsidie zelf (30 euro op IsVeenGrond).";

	attribute<Eur_Ha_jaarlijks> Saldo_ha         (rdc_25m) := Saldo_dier + Voerbalans - Grondkosten - Mestafzetkosten + Subsidie
	, Descr = "Saldo per ha per jaar op de kostenvoet eigen mechanisatie: dier plus voerbalans min grondkosten min mestafzet plus GLB. Bij derving nul, GLB 345 en mestprijs 25 is dit op klei 4.167, op zand 4.218; natuurlijk grasland 653.";
	attribute<Eur_Ha_jaarlijks> Net_revenues_ha  (rdc_25m) := HeeftBodem ? Saldo_ha : 0[Eur_Ha_jaarlijks], Descr = "Nul op cellen zonder bodemcode (water, verhard, geen gegevens); dat is 0,05 procent van het landbouwareaal, gemeten op 7 september 2026.";
	attribute<Eur_m2_jaarlijks> Net_revenues     (rdc_25m) := Net_revenues_ha[Eur_m2_jaarlijks];

	container Economic_performance
	: Descr = "De koppeling naar Iter_Landbouw_T en Export.dms: Net_revenues en Conversion_costs staan hier omdat Totaal_NonAugmented, NPV en NetRevenue ze zo lezen, net als in Akkerbouw_T."
	{
		attribute<Eur_m2_jaarlijks> Net_revenues      (rdc_25m) := ../Net_revenues;
		attribute<Eur_m2>           Conversion_costs0 (rdc_25m) := = 'MakeDefined(FActoren/transitiekosten/'+ LandbouwKlasse_name + '[LU_ModelType/LandbouwK_rel[gg_LandbouwK]], /ModelParameters/Landbouw/Transitiekosten_src/Overigen__'+ LandbouwKlasse_name + ')[Eur_m2]';
		attribute<Eur_m2>           Conversion_costs  (rdc_25m) := = '(1f + /ModelParameters/Landbouw/ConversionCostPremium_'+/ModelParameters/Landbouw/Boervariant_name+') * Conversion_costs0';
	}
}
