// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Kapitaliseert een jaarlijkse stroom naar een contante waarde, met continue discontering over een gegeven periode.
// Staat bewust LOS in Templates en niet in Landbouw: hij wordt zowel vanuit Landbouw als vanuit
// Indicatoren/SOMERS_CO2_T aangeroepen, dus in een van beide containers zetten breekt de andere.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Kapitalisatie_T
{
	//
	parameter<LandbouwKlasses> ModelTypenr;
	parameter<jaarlijks> Rentevoet;
	parameter<jaar> Periode;
	//
	
	parameter<jaarlijks> disconteringssnelheid := log(1f + Rentevoet * 1[jaar])[jaarlijks];
	
	unit<UInt32> periodeK:  = range(uint32,0,uint32(Periode))
	{
		attribute<jaar>    jr := id(.)[jaar] + 1[jaar];
		attribute<Float32> logCWfactor := -disconteringssnelheid * jr;
		attribute<Float32> CWfactor := exp(logCWfactor);
	}
	
	parameter<jaar> factor := sum(periodeK/CWfactor)[jaar];
}
