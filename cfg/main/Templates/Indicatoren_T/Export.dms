////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Vier lagen, in deze volgorde: generates met een parameter per uitvoerbestand en een Generate_Alles die ze
// alle opsomt, Impl met de tussenberekeningen, Diagnose met de getallen die geen bestand schrijven, en de
// levering zelf: de kaarten en tabellen met een StorageName. Zie #779.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Export : using = "Classifications/Actor;SourceData"
{

	parameter<String> ExportZichtjaar := =quote(replace_value(expand(., '%env:ExportZichtjaar%'), 'env:ExportZichtjaar', last(/Classifications/Time/Zichtjaar/name)))
	, Descr = "Welk zichtjaar de indicatorenexport wegschrijft. Standaard het laatste zichtjaar; via de omgevingsvariabele ExportZichtjaar is een eerder zichtjaar te kiezen, zodat daar geen configuratiewijziging voor nodig is. Het basisjaar kan niet: elk exportitem leest ThisCasus/Zichtjaren/<jaar> en Zichtjaren sluit het basisjaar uit; de basisjaararealen lopen via Diagnose.";
	container generates
	: Descr = "Een parameter per uitvoerbestand van deze export, gegroepeerd per domein, met een verzamelparameter per domein onder Themas en een Generate_Alles die alles opsomt (#779). Een enkele
				parameter met alle leveranciers in een string slaagt of faalt als geheel, zodat een gefaalde controle op een tabel die geen enkele indicator voedt de complete export kost en er een halve set
				ligt waaraan niet te zien is welk bestand uit welke draai komt. GeoDmsRun neemt meerdere itempaden op de commandoregel en werkt ze na elkaar af, elk met een eigen Updating-paar in het log,
				en een item dat faalt laat de andere ongemoeid; de export is dus per bestand of per domein op te vragen en bij te draaien, bijvoorbeeld met
				/Indicatoren/<casus>/Zichtjaren/Export/generates/Themas/Koolstof. De domeinen zijn dezelfde als die van de containers verderop in dit bestand, maar dekken meer: een deel van de
				uitvoerbestanden wordt hier geschreven en de rest in de sjablonen onder Templates/Indicatoren, dus Koolstof en Sloop hebben hier wel een groep en geen container. Elke regel wijst met een
				volledig pad vanaf ThisCasus naar het item dat het bestand schrijft, ook waar dat item hier in Export staat, want een ongekwalificeerde naam in een ExplicitSuppliers wordt omhoog gezocht
				vanaf de container van het item en zou hier de gelijknamige parameter hiernaast vinden. Niet hierin: de legendas onder Legendas, die eenmaal per levering worden getrokken; de NPV-kaarten
				onder Impl/Zichtjaren, die alleen PostAllocAnalyses opvraagt; en de twee parameters onder AlleZichtjaren. Een gedeelde toeleverancier die faalt raakt nog steeds alles wat hem leest, maar je
				weet dan precies welk bestand ontbreekt."
	{
		parameter<string> Exportpad := 'ThisCasus/Zichtjaren/Export/'
		, Descr = "Volledig pad naar deze Export-container, zodat een supplier hieronder bij de kaart uitkomt en niet bij de gelijknamige parameter ernaast.";
		parameter<string> Jaarpad   := 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/'
		, Descr = "Volledig pad naar de indicatoren van het zichtjaar dat deze export wegschrijft, dus naar de instantie die ExportZichtjaar aanwijst.";

		// --- grondgebruik ---
		// Wat een cel IS en wat er sinds het basisjaar veranderd is, plus het areaal per klasse.
		parameter<string> Landgebruikskaart_bij_tov_PrevYear                        := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/Landgebruikskaart_bij_tov_PrevYear'";
		parameter<string> Landgebruikskaart_af_tov_PrevYear                         := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/Landgebruikskaart_af_tov_PrevYear'";
		parameter<string> Verstedelijking                                           := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/Verstedelijking'";
		parameter<string> VerstedelijkingInABCD                                     := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/VerstedelijkingInABCD'";
		parameter<string> Landgebruik_Areaal                                        := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/Landgebruik_Areaal'";
		parameter<string> LandgebruikskaartNL2120                                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'LandgebruikskaartNL2120/Write_Result_SA'";
		parameter<string> LandgebruikskaartHoofdklasse                              := 'Ready', ExplicitSuppliers = "=Jaarpad+'LandgebruikskaartNL2120/Write_Result_Hoofdklasse_SA'";
		parameter<string> LandgebruikNL2120_Areaal                                  := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/LandgebruikNL2120_Areaal'";
		parameter<string> LandgebruikHoofdklasse_Areaal                             := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/LandgebruikHoofdklasse_Areaal'";
		parameter<string> LandgebruikNatDroog_Areaal                                := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/LandgebruikNatDroog_Areaal'";
		// De basisjaartegenhangers van de drie arealentabellen (#828), in elke casusmap, zoals de twee basisjaarkaarten hieronder.
		parameter<string> LandgebruikNL2120_Areaal_Basisjaar                        := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/LandgebruikNL2120_Areaal_Basisjaar'";
		parameter<string> LandgebruikHoofdklasse_Areaal_Basisjaar                   := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/LandgebruikHoofdklasse_Areaal_Basisjaar'";
		parameter<string> LandgebruikNatDroog_Areaal_Basisjaar                      := 'Ready', ExplicitSuppliers = "=Exportpad+'Grondgebruik/LandgebruikNatDroog_Areaal_Basisjaar'";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> Verstedelijking_Zichtjaar                                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/Verstedelijking'";
		parameter<string> Basisjaar_LandgebruikskaartNL2120                         := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/LandgebruikskaartNL2120/Write_Result_SA'";
		parameter<string> Basisjaar_LandgebruikskaartHoofdklasse                    := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/LandgebruikskaartNL2120/Write_Result_Hoofdklasse_SA'";

		// --- wonen ---
		// De woningvoorraad: waar hij staat, wat hij waard is en wat hij kost om te bouwen.
		parameter<string> Dichtheid_Wonen                                           := 'Ready', ExplicitSuppliers = "=Exportpad+'Wonen/Dichtheid_Wonen'";
		parameter<string> PandFootprint_Wonen                                       := 'Ready', ExplicitSuppliers = "=Exportpad+'Wonen/PandFootprint_Wonen'";
		parameter<string> Bouwwijze_Areaal                                          := 'Ready', ExplicitSuppliers = "=Exportpad+'Wonen/Bouwwijze_Areaal'";
		parameter<string> Woningwaarde_Nieuwbouw                                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'Woningwaarde/Nieuwbouw'";
		parameter<string> Woningwaarde_Nieuwbouw_NCW                                := 'Ready', ExplicitSuppliers = "=Jaarpad+'Woningwaarde/Nieuwbouw_NCW'";
		parameter<string> KostenWoningbouw_Bouwkosten                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Bouwkosten'";
		parameter<string> KostenWoningbouw_Bouwkosten_NCW                           := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Bouwkosten_NCW'";
		parameter<string> KostenWoningbouw_MeerkostenBouwwijze                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/MeerkostenBouwwijze'";
		parameter<string> KostenWoningbouw_Bouwwijze                                := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Bouwwijze'";
		parameter<string> KostenWoningbouw_Regulier                                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Regulier'";
		parameter<string> KostenWoningbouw_Alternatief                              := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Alternatief'";
		parameter<string> KostenWoningbouw_MeerkostenBodemdaling                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/MeerkostenBodemdaling'";
		parameter<string> KostenWoningbouw_MeerkostenBodemdaling_NCW                := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/MeerkostenBodemdaling_NCW'";
		parameter<string> KostenWoningbouw_BeheerEnOnderhoud                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/BeheerEnOnderhoud'";
		parameter<string> KostenWoningbouw_Controle                                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Controle'";
		parameter<string> Grondexploitatie_Saldo                                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondexploitatie/Saldo'";
		// De vier posten van het saldo die een eigen tif dragen (#828); de andere vijf zijn uit KostenWoningbouw en Nieuwbouw_Ha af te leiden.
		parameter<string> Grondexploitatie_Post_Opbrengsten                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondexploitatie/PostenNieuwbouw/Opbrengsten'";
		parameter<string> Grondexploitatie_Post_Piekbuiberging                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondexploitatie/PostenNieuwbouw/Piekbuiberging'";
		parameter<string> Grondexploitatie_Post_Verwerving                          := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondexploitatie/PostenNieuwbouw/Verwerving'";
		parameter<string> Grondexploitatie_Post_Sloop                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondexploitatie/PostenNieuwbouw/Sloop'";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> Dichtheid_Wonen_Zichtjaar                                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'Dichtheid/Wonen/Per_AdminDomain'";
		parameter<string> KostenWoningbouw_Nieuwbouw_Ha                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Nieuwbouw_Ha'";
		parameter<string> KostenWoningbouw_Regulier_NCW                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/Regulier_NCW'";
		parameter<string> KostenWoningbouw_BeheerEnOnderhoud_NCW                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWoningbouw/BeheerEnOnderhoud_NCW'";
		parameter<string> Grondexploitatie_Nieuwbouw_Ha                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondexploitatie/Nieuwbouw_Ha'";
		parameter<string> Inbreiding_WoningenErbij                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'Inbreiding/WoningenErbij'";
		parameter<string> Inbreiding_BestaandBebouwdGebied                          := 'Ready', ExplicitSuppliers = "=Jaarpad+'Inbreiding/Schrijf/BestaandBebouwdGebied'";
		parameter<string> Inbreiding_BestaandGroenInBestaandBebouwdGebied           := 'Ready', ExplicitSuppliers = "=Jaarpad+'Inbreiding/Schrijf/BestaandGroenInBestaandBebouwdGebied'";

		// --- werken ---
		// De werklocaties: dichtheid, voetafdruk, de meerkosten tegen het water en de bereikbaarheid van banen.
		parameter<string> Dichtheid_Werken_Pandfootprint_ha                         := 'Ready', ExplicitSuppliers = "=Exportpad+'Werken/Dichtheid_Werken_Pandfootprint_ha'";
		parameter<string> Dichtheid_Werken_Banen_m2                                 := 'Ready', ExplicitSuppliers = "=Exportpad+'Werken/Dichtheid_Werken_Banen_m2'";
		parameter<string> PandFootprint_Werken                                      := 'Ready', ExplicitSuppliers = "=Exportpad+'Werken/PandFootprint_Werken'";
		parameter<string> KostenWerklocaties_Controle                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWerklocaties/Controle'";
		parameter<string> Bereikbaarheid_Banen                                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'Bereikbaarheid_Banen/Result'";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> Dichtheid_Werken_Banen_ha_Zichtjaar                       := 'Ready', ExplicitSuppliers = "=Jaarpad+'Dichtheid/Werken/Banen_ha/Per_AdminDomain'";
		parameter<string> Dichtheid_Werken_PandFootprint_ha_Zichtjaar               := 'Ready', ExplicitSuppliers = "=Jaarpad+'Dichtheid/Werken/PandFootprint_ha/Per_AdminDomain'";
		parameter<string> Dichtheid_Werken_Banen_m2_Zichtjaar                       := 'Ready', ExplicitSuppliers = "=Jaarpad+'Dichtheid/Werken/Banen_m2/Per_AdminDomain'";
		parameter<string> KostenWerklocaties_Werklocatie_Ha                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWerklocaties/Werklocatie_Ha'";
		parameter<string> KostenWerklocaties_MeerkostenOverstroming                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWerklocaties/MeerkostenOverstroming'";
		parameter<string> KostenWerklocaties_MeerkostenOverstroming_NCW             := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWerklocaties/MeerkostenOverstroming_NCW'";
		parameter<string> KostenWerklocaties_MeerkostenBodemdaling                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'KostenWerklocaties/MeerkostenBodemdaling'";

		// --- water ---
		// Verharding, piekbuiberging en overstromingsschade, plus de seizoensberging op veen. Verharding staat hier omdat hij de invoer van de piekbuikant is; wie hem als verstening leest, leest hem als grondgebruik.
		parameter<string> Verharding                                                := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Verharding'";
		parameter<string> Verharding_Zichtjaar                                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'Verharding/Result'"
		, Descr = "De verhardingskaart van het zichtjaar onder zijn eigen naam (Verharding_<jaar>_fractie), naast de exportkaart hierboven in de standmap. Een eigen regel en niet alleen een bijproduct van de piekbuiketen (#824); zie Mortaliteit_NDVI_500m.";
		parameter<string> Piekbuiberging_Ongedekt                                   := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Piekbuiberging_Ongedekt'";
		parameter<string> Piekbuiberging_Gedekt                                     := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Piekbuiberging_Gedekt'";
		parameter<string> Piekbuiberging_Dekkingsgraad                              := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Piekbuiberging_Dekkingsgraad'";
		parameter<string> Overstromingsschade_Hoofdwatersysteem_Binnendijks         := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Overstromingsschade_Hoofdwatersysteem_Binnendijks'";
		parameter<string> Overstromingsschade_Hoofdwatersysteem_Buitendijks         := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Overstromingsschade_Hoofdwatersysteem_Buitendijks'";
		parameter<string> Overstromingsschade_Regionaalwatersysteem_Binnendijks     := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/Overstromingsschade_Regionaalwatersysteem_Binnendijks'";
		parameter<string> WaterbergingVeen                                          := 'Ready', ExplicitSuppliers = "=Exportpad+'Water/WaterbergingVeen'";
		parameter<string> Overstromingsschade_Hoofdwatersysteem_Binnendijks_NCW     := 'Ready', ExplicitSuppliers = "=Jaarpad+'Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_NCW'";
		parameter<string> Overstromingsschade_Hoofdwatersysteem_Buitendijks_NCW     := 'Ready', ExplicitSuppliers = "=Jaarpad+'Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks_NCW'";
		parameter<string> Overstromingsschade_Regionaalwatersysteem_Binnendijks_NCW := 'Ready', ExplicitSuppliers = "=Jaarpad+'Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks_NCW'";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> Verharding_Werken_Verhard                                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'Verharding/Werken/Verhard'";
		parameter<string> Verharding_Werken_Allocatie                                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'Verharding/Werken/Schrijf_Allocatie'";
		parameter<string> Verharding_Verblijfsrecreatie_Verhard                       := 'Ready', ExplicitSuppliers = "=Jaarpad+'Verharding/Verblijfsrecreatie/Verhard'";
		parameter<string> Verharding_Verblijfsrecreatie_Allocatie                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'Verharding/Verblijfsrecreatie/Schrijf_Allocatie'";
		parameter<string> Piekbuiberging_PerGrid_Opgave                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/PerGrid/Opgave'";
		parameter<string> Piekbuiberging_PerGrid_Aanbod                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/PerGrid/Aanbod'";
		parameter<string> Piekbuiberging_PerGrid_AanbodBuitenUrbanContour             := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/PerGrid/AanbodBuitenUrbanContour'";
		parameter<string> Piekbuiberging_PerGrid_Ongedekt                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/PerGrid/Ongedekt'";
		parameter<string> Piekbuiberging_PerGrid_AanbodZonderOpgave                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/PerGrid/AanbodZonderOpgave'";
		parameter<string> Piekbuiberging_Kosten_Aanleg                                := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/Kosten/Aanleg'";
		parameter<string> Piekbuiberging_Kosten_OnderhoudPerJaar                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/Kosten/OnderhoudPerJaar'";
		parameter<string> Piekbuiberging_Kosten_Onderhoud_NCW                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'Piekbuiberging/Kosten/Onderhoud_NCW'";
		parameter<string> WaterbergingVeen_Zichtjaar                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/WaterbergingVeen'";
		parameter<string> Basisjaar_Overstromingsschade_Hoofdwatersysteem_Binnendijks := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks'";
		// De andere twee schadekaarten van het basisjaar (#828), voor de basisjaartabel in een tabelrun met TabellenUitExport aan; nominaal volstaat, want in het basisjaar is de contante waarde daaraan gelijk.
		parameter<string> Basisjaar_Overstromingsschade_Hoofdwatersysteem_Buitendijks := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks'";
		parameter<string> Basisjaar_Overstromingsschade_Regionaalwatersysteem_Binnendijks := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks'";

		// --- natuur ---
		// Natuur en groen, en wat groen oplevert: bereikbaarheid, woningwaarde en vermeden sterfte. De woningwaardekant staat hier en niet bij Wonen omdat de kaarten het effect VAN groen meten.
		parameter<string> BT_Exogeen                                                := 'Ready', ExplicitSuppliers = "=Exportpad+'Natuur/BT_Exogeen'";
		parameter<string> BT_Exogeen_Areaal                                         := 'Ready', ExplicitSuppliers = "=Exportpad+'Natuur/BT_Exogeen_Areaal'";
		parameter<string> NieuweNatuur                                              := 'Ready', ExplicitSuppliers = "=Exportpad+'Natuur/NieuweNatuur'";
		parameter<string> VerdwenenNatuur                                           := 'Ready', ExplicitSuppliers = "=Exportpad+'Natuur/VerdwenenNatuur'";
		parameter<string> BereikbaarheidGroen_BBG                                   := 'Ready', ExplicitSuppliers = "=Exportpad+'Natuur/BereikbaarheidGroen_BBG'";
		parameter<string> BereikbaarheidGroen_Fractie                               := 'Ready', ExplicitSuppliers = "=Exportpad+'Natuur/BereikbaarheidGroen_Fractie'";
		parameter<string> WaardeNabijheidGroen_Woningen                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen'";
		parameter<string> WaardeNabijheidGroen_BestaandeWoningen                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_BestaandeWoningen'";
		parameter<string> WaardeNabijheidGroen_NieuwbouwWoningen                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_NieuwbouwWoningen'";
		parameter<string> WaardeNabijheidGroen_Woningen_NCW                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen_NCW'";
		parameter<string> WaardeNabijheidGroen_BestaandeWoningen_NCW                := 'Ready', ExplicitSuppliers = "=Jaarpad+'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_BestaandeWoningen_NCW'";
		parameter<string> WaardeNabijheidGroen_NieuwbouwWoningen_NCW                := 'Ready', ExplicitSuppliers = "=Jaarpad+'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_NieuwbouwWoningen_NCW'";
		parameter<string> SterfteAfname_PerPeriode                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnamePerPeriode'";
		parameter<string> SterfteAfname_Cumulatief                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameCumulatief'";
		parameter<string> Mortaliteit_NDVI_500m                                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'SterfteAfnameDoorGroenToename/Zichtjaar/NDVI/Result'"
		, Descr = "De groenindex van het zichtjaar. Een eigen regel en niet alleen een bijproduct van de sterfteketen, die haar van het vorige zichtjaar leest, zodat een ontkoppelde reeks hem per zichtjaar schrijft (#824).";
		parameter<string> Mortaliteit_NDVI_VeranderingOpLocatie                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'SterfteAfnameDoorGroenToename/Zichtjaar/NDVI/VeranderingOpLocatie'"
		, Descr = "Zie Mortaliteit_NDVI_500m.";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> NieuweNatuur_Zichtjaar                                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/NieuweNatuur'";
		parameter<string> VerdwenenNatuur_Zichtjaar                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/VerdwenenNatuur'";
		parameter<string> SterfteAfname_ZittendeBewoners                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameZittendeBewoners'";
		parameter<string> SterfteAfname_NieuweBewoners                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameNieuweBewoners'";
		parameter<string> BereikbaarheidGroen_WoningenTotaal                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/Woningen0_Live'";
		parameter<string> BereikbaarheidGroen_WoningenGealloceerd                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/Woningen_Live'";
		parameter<string> BereikbaarheidGroen_Groen                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/Groen_Live'";
		parameter<string> BereikbaarheidGroen_GroenFractieCel                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/GroenFractieCel_Live'";
		parameter<string> BereikbaarheidGroen_Nationaal_TotaalExAgrarisch_Cumulatief := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator'";
		parameter<string> BereikbaarheidGroen_Nationaal_TotaalExAgrarisch_Drukte     := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator'";
		parameter<string> BereikbaarheidGroen_Nationaal_Totaal_Cumulatief            := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator'";
		parameter<string> BereikbaarheidGroen_Nationaal_Totaal_Drukte                := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator'";
		parameter<string> BereikbaarheidGroen_Nationaal_Fractie_Cumulatief           := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator'";
		parameter<string> BereikbaarheidGroen_Nationaal_Fractie_Drukte               := 'Ready', ExplicitSuppliers = "=Jaarpad+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator'";
		// Dezelfde zes kaarten voor het basisjaar (#828): in een tabelrun leest de landelijke groeninstantie haar kaart terug, dus de basisjaartabel heeft deze nodig.
		parameter<string> Basisjaar_BereikbaarheidGroen_Nationaal_TotaalExAgrarisch_Cumulatief       := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator'";
		parameter<string> Basisjaar_BereikbaarheidGroen_Nationaal_TotaalExAgrarisch_Drukte           := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator'";
		parameter<string> Basisjaar_BereikbaarheidGroen_Nationaal_Totaal_Cumulatief                  := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator'";
		parameter<string> Basisjaar_BereikbaarheidGroen_Nationaal_Totaal_Drukte                      := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator'";
		parameter<string> Basisjaar_BereikbaarheidGroen_Nationaal_Fractie_Cumulatief                 := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator'";
		parameter<string> Basisjaar_BereikbaarheidGroen_Nationaal_Fractie_Drukte                     := 'Ready', ExplicitSuppliers = "='ThisCasus/Basisjaar/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator'";

		// --- landbouw ---
		// Wat de landbouwgrond waard is, en wat de landbouw kwijtraakt. Ook de drie kaarten die een andere bestemming op vruchtbare landbouwgrond meten staan hier: die bestaan om het verlies te tellen, en waar verstedelijking, natuur of waterberging landt staat al los in het eigen domein.
		parameter<string> NettoOpbrengst_Landbouw                                   := 'Ready', ExplicitSuppliers = "=Exportpad+'Landbouw/NettoOpbrengst_Landbouw'";
		parameter<string> NPV_Landbouw                                              := 'Ready', ExplicitSuppliers = "=Exportpad+'Landbouw/NPV_Landbouw'";
		parameter<string> VerstedelijkingOpVruchtbareLandbouwgronden                := 'Ready', ExplicitSuppliers = "=Exportpad+'Landbouw/VerstedelijkingOpVruchtbareLandbouwgronden'";
		parameter<string> NieuweNatuurOpVruchtbareLandbouwgronden                   := 'Ready', ExplicitSuppliers = "=Exportpad+'Landbouw/NieuweNatuurOpVruchtbareLandbouwgronden'";
		parameter<string> WaterbergingVeenOpVruchtbareLandbouwgronden               := 'Ready', ExplicitSuppliers = "=Exportpad+'Landbouw/WaterbergingVeenOpVruchtbareLandbouwgronden'";
		parameter<string> VerdwenenLandbouw                                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/VerdwenenLandbouw'";
		parameter<string> VerdwenenVruchtbareLandbouw                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/VerdwenenVruchtbareLandbouw'";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> Landbouw_Ha                                               := 'Ready', ExplicitSuppliers = "=Exportpad+'Landbouw/Landbouw_Ha'";
		parameter<string> VerstedelijkingOpVruchtbareLandbouwgronden_Zichtjaar      := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/VerstedelijkingOpVruchtbareLandbouwgronden'";
		parameter<string> NieuweNatuurOpVruchtbareLandbouwgronden_Zichtjaar         := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/NieuweNatuurOpVruchtbareLandbouwgronden'";
		parameter<string> WaterbergingVeenOpVruchtbareLandbouwgronden_Zichtjaar     := 'Ready', ExplicitSuppliers = "=Jaarpad+'Grondgebruik/Verandering/Schrijf/WaterbergingVeenOpVruchtbareLandbouwgronden'";

		// --- koolstof ---
		// De koolstofboekhouding en de veenemissies volgens SOMERS.
		parameter<string> CO2Stock_Zichtjaar                                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Write_CO2Stock_Zichtjaar'";
		parameter<string> CO2Flow_Zichtjaar                                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Write_CO2Flow_Zichtjaar'";
		parameter<string> CO2Flow_TovBasisjaar                                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar'";
		parameter<string> CO2Ongedekt_Cumulatief                                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief'";
		parameter<string> SOMERS_CO2_Minimum                                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'SOMERS_CO2_laagveen/Emissies/Minimum/Write_Result_SA'";
		parameter<string> SOMERS_CO2_Mediaan                                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA'";
		parameter<string> SOMERS_CO2_Maximum                                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'SOMERS_CO2_laagveen/Emissies/Maximum/Write_Result_SA'";
		parameter<string> Methaan                                                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'Methaan/Write_Result_SA'";
		// Sinds #824 ook de kaarten die de tabellen met ModelParameters/TabellenUitExport aan teruglezen. Waar de export een gelijknamige kaart in de standmap schrijft, draagt de regel _Zichtjaar achter de naam.
		parameter<string> CO2_PerBron_Vastlegging                                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Vastlegging'";
		parameter<string> CO2_PerBron_Afboeking                                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Afboeking'";
		parameter<string> CO2_PerBron_Oxidatie_SOMERS                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Oxidatie_SOMERS'";
		parameter<string> CO2_PerBron_Oxidatie_EF                                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Oxidatie_EF'";
		parameter<string> CO2_PerBron_Oxidatie_Veenkental                           := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Oxidatie_Veenkental'";
		parameter<string> CO2_PerBron_Totaal                                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Totaal'";
		parameter<string> CO2_PerBron_Ongedekt_SOMERS                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Ongedekt_SOMERS'";
		parameter<string> CO2_PerBron_Ongedekt_EF                                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Ongedekt_EF'";
		parameter<string> CO2_PerBron_Ongedekt_Veenkental                           := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/PerBron/Ongedekt_Veenkental'";
		parameter<string> CO2_Stock_Bovenlaag                                       := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/Stock_Bovenlaag'";
		parameter<string> CO2_Stock_Veenreserve                                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'CarbonStorageSequestration/Zichtjaar/CO2/Stock_Veenreserve'";
		parameter<string> Methaan_Jaarlijks                                         := 'Ready', ExplicitSuppliers = "=Jaarpad+'Methaan/Jaarlijks'";

		// --- sloop ---
		// De drie sloopoorzaken van #658, elk met woningen, banen en de twee kostenposten, nominaal en als netto contante waarde. Sloop kruist wonen, werken, natuur en water en is daarom een eigen domein: het is de uitkomst van een ingreep en niet van een sector.
		parameter<string> Sloop_NieuweNatuur_Woningen                               := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanNieuweNatuur/GesloopteWoningen'";
		parameter<string> Sloop_NieuweNatuur_Banen                                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanNieuweNatuur/GesloopteBanen'";
		parameter<string> Sloop_NieuweNatuur_Uitkoopkosten                          := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten'";
		parameter<string> Sloop_NieuweNatuur_Sloopkosten                            := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanNieuweNatuur/Sloopkosten'";
		parameter<string> Sloop_NieuweNatuur_Uitkoopkosten_NCW                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_NCW'";
		parameter<string> Sloop_NieuweNatuur_Sloopkosten_NCW                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanNieuweNatuur/Sloopkosten_NCW'";
		parameter<string> Sloop_WaterbergingVeen_Woningen                           := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanWaterbergingVeen/GesloopteWoningen'";
		parameter<string> Sloop_WaterbergingVeen_Banen                              := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanWaterbergingVeen/GesloopteBanen'";
		parameter<string> Sloop_WaterbergingVeen_Uitkoopkosten                      := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten'";
		parameter<string> Sloop_WaterbergingVeen_Sloopkosten                        := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanWaterbergingVeen/Sloopkosten'";
		parameter<string> Sloop_WaterbergingVeen_Uitkoopkosten_NCW                  := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_NCW'";
		parameter<string> Sloop_WaterbergingVeen_Sloopkosten_NCW                    := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_NCW'";
		parameter<string> Sloop_OverigeBouwstenen_Woningen                          := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanOverigeBouwstenen/GesloopteWoningen'";
		parameter<string> Sloop_OverigeBouwstenen_Banen                             := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanOverigeBouwstenen/GesloopteBanen'";
		parameter<string> Sloop_OverigeBouwstenen_Uitkoopkosten                     := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten'";
		parameter<string> Sloop_OverigeBouwstenen_Sloopkosten                       := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten'";
		parameter<string> Sloop_OverigeBouwstenen_Uitkoopkosten_NCW                 := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_NCW'";
		parameter<string> Sloop_OverigeBouwstenen_Sloopkosten_NCW                   := 'Ready', ExplicitSuppliers = "=Jaarpad+'SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_NCW'";

		// --- ketens tussen de zichtjaren (#824) ---
		parameter<string> Ketens := 'Ready', ExplicitSuppliers = "=Jaarpad+'Ketens/Schrijf/Alles'"
		, Descr = "Schrijft de ketentifs van dit zichtjaar: wat de cumulatieve indicatoren van het volgende zichtjaar nodig hebben, zie Templates/Indicatoren/Ketens.dms. Met ModelParameters/IndicatorenOntkoppeld op TRUE leest het volgende zichtjaar die tifs in plaats van dit zichtjaar opnieuw te rekenen.";
		parameter<string> Tijdreeks := 'Ready', ExplicitSuppliers = "=Jaarpad+'Tijdreeks'"
		, Descr = "Wat een tussenliggend zichtjaar schrijft in een ontkoppelde reeks, zie Tijdreeks in Templates/Indicatoren/Ketens.dms; hier als ingang op ExportZichtjaar. RunIndicatoren.ps1 roept de zichtjaren rechtstreeks aan, elk in een eigen proces.";

		// --- tabellen ---
		// De tabellen die over alle domeinen tegelijk gaan: de indicatorentabel landsdekkend en per regio, en de claimrealisatie per allocatieniveau.
		// De twee tabellen worden aangewezen via een kolom en niet via de unit Tabel zelf. Een unit als expliciete
		// leverancier laat GeoDMS de hele boom onder die unit bijwerken, en Tabel is een alias van de regio-indeling:
		// op de landschapsindeling loopt die boom via LandschapsRegio en de aliascontainer BronRiv door tot in de
		// rivierenbron en de pandenset van de BAG, en werkt dan ook AfleidingPandType/Write_WP5 bij, de schrijver van de
		// WP5-mmd die het proces al leest. Dat kostte per run 34 minuten wachten of een hang (#823). Een kolom aanwijzen
		// schrijft dezelfde csv, want de storage is de unit, maar raakt de boom eronder niet.
		parameter<string> Indicatoren_PerIndeling                                   := 'Ready', ExplicitSuppliers = "=Exportpad+'Tabellen/PerIndeling/Tabel/Regio_name'";
		parameter<string> Indicatoren_PerNederland                                  := 'Ready', ExplicitSuppliers = "=Exportpad+'Tabellen/PerNederland/Tabel/Regio_name'";
		parameter<string> Basisjaar_Indicatoren_PerIndeling                         := 'Ready', ExplicitSuppliers = "=Exportpad+'Tabellen/PerIndeling_Basisjaar/Tabel/Regio_name'"
		, Descr = "De basisjaartabel op de regio-indeling (#828), om dezelfde reden via een kolom aangewezen als de twee tabellen hierboven.";
		parameter<string> Basisjaar_Indicatoren_PerNederland                        := 'Ready', ExplicitSuppliers = "=Exportpad+'Tabellen/PerNederland_Basisjaar/Tabel/Regio_name'";
		parameter<string> Claims_Reeks                                              := 'Ready', ExplicitSuppliers = "=Exportpad+'Tabellen/Claims_Reeks/Tabel'"
		, Descr = "De claimreeks van het scenario over alle zichtjaren, landelijk (#828).";
		parameter<string> ClaimRealisatie_Landbouw                                  := 'Ready'
		, ExplicitSuppliers = "=Exportpad+'Tabellen/ClaimRealisatie_Landbouw/Tabel'"
		, Descr = "De claimrealisatie van de landbouw, per provincie en per gewasklasse. Zie Tabellen/ClaimRealisatie_Landbouw voor waarom dit niet in ClaimRealisatie past.";
		parameter<string> ClaimRealisatie_Veen                                      := 'Ready'
		, ExplicitSuppliers = "=Exportpad+'Tabellen/ClaimRealisatie_Veen/Tabel;'+Exportpad+'Tabellen/ClaimRealisatie_Veen/Tabel_NL'"
		, Descr = "De claimrealisatie van de waterbergingsopgave, per deelgebied en landelijk (#797). Zie Tabellen/ClaimRealisatie_Veen voor waarom dit niet in ClaimRealisatie hieronder past.";
		parameter<string> ClaimRealisatie                                           := 'Ready'
		, ExplicitSuppliers = "=AsList(Exportpad+'Tabellen/ClaimRealisatie_PerNiveau/'+Tabellen/ClaimNiveau/values+'/Tabel', ';')+';'+Exportpad+'Tabellen/ClaimRealisatie_PerNiveau/Nederland/Tabel'"
		, Descr = "De claimtabellen van alle niveaus in een keer. Welke niveaus dat zijn hangt af van Tabellen/ClaimNiveau, dus dit is de enige regel hier die niet op een vast aantal bestanden staat.";

		container Themas
		: Descr = "Een domein in een aanroep, voor wanneer een levering op een enkel onderwerp moet worden bijgedraaid, bijvoorbeeld nadat er aan de koolstofkant iets is veranderd. Generate_Alles hieronder
				noemt bewust de items zelf en niet deze negen, zodat de ketting van leveranciers een stap diep blijft; deze parameters zijn een tweede ingang op dezelfde items en geen tussenlaag."
		{
			parameter<string> Grondgebruik := 'Ready', ExplicitSuppliers = "Landgebruikskaart_bij_tov_PrevYear;Landgebruikskaart_af_tov_PrevYear;Verstedelijking;VerstedelijkingInABCD;Landgebruik_Areaal;LandgebruikskaartNL2120;LandgebruikskaartHoofdklasse;LandgebruikNL2120_Areaal;LandgebruikHoofdklasse_Areaal;LandgebruikNatDroog_Areaal;LandgebruikNL2120_Areaal_Basisjaar;LandgebruikHoofdklasse_Areaal_Basisjaar;LandgebruikNatDroog_Areaal_Basisjaar;Verstedelijking_Zichtjaar;Basisjaar_LandgebruikskaartNL2120;Basisjaar_LandgebruikskaartHoofdklasse";
			parameter<string> Wonen        := 'Ready', ExplicitSuppliers = "Dichtheid_Wonen;PandFootprint_Wonen;Bouwwijze_Areaal;Woningwaarde_Nieuwbouw;Woningwaarde_Nieuwbouw_NCW;KostenWoningbouw_Bouwkosten;KostenWoningbouw_Bouwkosten_NCW;KostenWoningbouw_MeerkostenBouwwijze;KostenWoningbouw_Bouwwijze;KostenWoningbouw_Regulier;KostenWoningbouw_Alternatief;KostenWoningbouw_MeerkostenBodemdaling;KostenWoningbouw_MeerkostenBodemdaling_NCW;KostenWoningbouw_BeheerEnOnderhoud;KostenWoningbouw_Controle;Grondexploitatie_Saldo;Dichtheid_Wonen_Zichtjaar;KostenWoningbouw_Nieuwbouw_Ha;KostenWoningbouw_Regulier_NCW;KostenWoningbouw_BeheerEnOnderhoud_NCW;Grondexploitatie_Nieuwbouw_Ha;Inbreiding_WoningenErbij;Inbreiding_BestaandBebouwdGebied;Inbreiding_BestaandGroenInBestaandBebouwdGebied;Grondexploitatie_Post_Opbrengsten;Grondexploitatie_Post_Piekbuiberging;Grondexploitatie_Post_Verwerving;Grondexploitatie_Post_Sloop";
