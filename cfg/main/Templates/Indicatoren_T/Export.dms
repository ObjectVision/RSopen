		, Descr = "De acht tabellen die over alle domeinen tegelijk gaan, dezelfde als Themas/Tabellen (#824); sinds #828 ook de twee basisjaartabellen en de claimreeks.";

		parameter<string> Alles_lijst := Kaarten_lijst + ';' + Tabellen_lijst
		, Descr = "De namen hierboven als een enkele string, zodat Generate_Alles hem alleen nog hoeft te noemen. Staat apart omdat een string-parameter in seconden op te vragen is: wie wil weten wat deze export schrijft vraagt dit item op, en hoeft daar geen bestand voor te laten rekenen.";

		parameter<string> Generate_Kaarten := 'Ready', ExplicitSuppliers = "=Kaarten_lijst"
		, Descr = "Alle kaarten en arealentabellen van deze export in een aanroep, zonder de vijf tabellen van Tabellen_lijst (#824). De eerste van de twee stappen van RunIndicatoren.ps1 -TabellenUitExport, altijd met ModelParameters/TabellenUitExport uit.";

		parameter<string> Generate_Alles := 'Ready', ExplicitSuppliers = "=Alles_lijst"
		, Descr = "Alle uitvoerbestanden van deze export in een aanroep. Dit is wat Generate_Indicatoren hieronder opvraagt, en daarmee wat RunIndicatoren.ps1 en RunZichtjaren.cmd draaien.";

		container AlleZichtjaren
		: Descr = "De twee triggers die niet over ExportZichtjaar gaan maar over alle zichtjaren tegelijk. Ze staan bewust buiten Generate_Alles: een gewone indicatorenrun schrijft een zichtjaar, en deze twee schrijven de hele reeks. Met de hand aan te roepen wanneer de koolstof- of veenkaarten van alle zichtjaren opnieuw moeten."
		{
			parameter<string> CarbonStorageSequestration           := 'Ready', ExplicitSuppliers = "=AsList(Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Stock_Zichtjaar;'+Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Flow_Zichtjaar;'+Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar;'+Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief', ';')"
			, Descr = "Trekt alle vier de koolstofkaarten voor alle zichtjaren. Write_CO2Ongedekt_Cumulatief hoort altijd samen met Write_CO2Flow_TovBasisjaar getrokken te worden (#733): zonder die kaart is niet te zien hoeveel SOMERS-uitstoot buiten het saldo is gebleven.";
			parameter<string> SOMERS_CO2_laagveen_Emissies_Mediaan := 'Ready', ExplicitSuppliers = "=AsList(Classifications/Time/Zichtjaar/name+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA', ';')";
		}
	}


	container Impl
	{
		attribute<Ha>   Basisjaar_Areaal_perHoofdklasse       (/Classifications/Grondgebruik/LU_Hoofdklasse) := pcount(ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA)[float32] * rdc_25m/NrHaPerCell; 
		attribute<Ha>   Zichtjaar_Areaal_perHoofdklasse       (/Classifications/Grondgebruik/LU_Hoofdklasse) := ='pcount(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA)[float32] * rdc_25m/NrHaPerCell'; 
		
		parameter<Ha>   Basisjaar_Areaal_Landbouw                     := sum(/Classifications/Grondgebruik/LU_Hoofdklasse/IsLandbouw ? Basisjaar_Areaal_perHoofdklasse : 0[Ha]);
		parameter<Ha>   Zichtjaar_Areaal_Landbouw                     := sum(/Classifications/Grondgebruik/LU_Hoofdklasse/IsLandbouw ? Zichtjaar_Areaal_perHoofdklasse : 0[Ha]);
		
		container Basisjaar_NettoOpbrengsten_perLandbouwK :=
			for_each_nedv(
				/Classifications/Actor/LandbouwKlasses/Actief/name
				, '/BaseData/StartState/Landgebruik/LandbouwK_rel == /Classifications/Actor/LandbouwKlasses/V/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'
						? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'/NetRevenue * 1[jaar]
						: 0[Eur_m2]'
				, rdc_25m
				, Eur_m2
			)
		{
			attribute<Eur_m2> Totaal_Landbouw (rdc_25m) := ='add('+asItemList(/Classifications/Actor/LandbouwKlasses/Actief/name)+')';
			parameter<Eur_ha> Gemiddeld_perHa           := sum(Totaal_Landbouw) / sum(IsDefined(/BaseData/StartState/Landgebruik/LandbouwK_rel)[float32]) / rdc_25m/NrHaPerCell * 1[meter2];
			parameter<Eur>    Totaal_Studiegebied       := sum(value(IsDefined(/BaseData/StartState/Landgebruik/LandbouwK_rel),Ha)[meter2] * Totaal_Landbouw);
		}
		
		container Zichtjaar_NettoOpbrengsten_perLandbouwK :=
			for_each_nedv(
				/Classifications/Actor/LandbouwKlasses/Actief/name
				, 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Subsector_rel == /Classifications/Actor/Sector/xSubsector/V/Landbouw_'+/Classifications/Actor/LandbouwKlasses/Actief/name+'
						? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'/NetRevenue * 1[jaar]
						: 0[Eur_m2]'
				, rdc_25m
				, Eur_m2
			)
		, Descr = "Het saldo van een jaar per klasse, op de cellen waar de landgebruikskaart van het exportzichtjaar die klasse draagt. NetRevenue is een stroom per jaar en wordt hier met maal 1 jaar een
					bedrag, dus dit is de opbrengst van dat ene zichtjaar en geen contante waarde over een reeks jaren. De bron onder de kaart Landbouw/NettoOpbrengst_Landbouw en de twee bijbehorende
					tabelkolommen (#794), naast de NPV, die dezelfde stroom kapitaliseert en er de transitiekosten van aftrekt; zie Landbouw/NPV_Landbouw voor waarom die twee ver uit elkaar liggen."
		{
			attribute<Eur_m2> Totaal_Landbouw (rdc_25m) := ='add('+asItemList(/Classifications/Actor/LandbouwKlasses/Actief/name)+')';
			parameter<Eur_ha> Gemiddeld_perHa           := ='sum(Totaal_Landbouw) / sum(/Classifications/Actor/Sector/xSubsector/IsLandbouw[ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Subsector_rel][float32]) / rdc_25m/NrHaPerCell * 1[meter2]';
			parameter<Eur>    Totaal_Studiegebied       := ='sum(value(/Classifications/Actor/Sector/xSubsector/IsLandbouw[ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Subsector_rel],Ha)[meter2] * Totaal_Landbouw)';

			attribute<Eur>    Totaal (rdc_25m) := ='add('+AsItemList(/Classifications/Actor/LandbouwKlasses/Actief/name+'[Eur_ha] * rdc_25m/NrHaPerCell')+')'
			, Descr = "De klassen samengevoegd tot een bedrag per cel, van euro per hectare naar euro per cel. Met merge en niet met de add van Totaal_Landbouw hierboven: merge volgt de landgebruikskaart en houdt daarmee de cellen buiten het studiegebied leeg, terwijl add daar nul zou neerzetten. Voor een kaart is dat verschil zichtbaar, en het maakt deze kaart optelbaar naast NPV_Landbouw, die dezelfde vorm heeft.";
		}
		
		//transitie matrix
		unit<UInt32> Hoofdklasse_Transities := combine(/Classifications/Grondgebruik/LU_Hoofdklasse, /Classifications/Grondgebruik/LU_Hoofdklasse)
		{
			attribute<UInt32> from_TransCode := uint32(first_rel) + 1;
			attribute<String> from_name      := /Classifications/Grondgebruik/LU_Hoofdklasse/name[first_rel];
			attribute<UInt32> to_TransCode   := (uint32(second_rel) + 1) * 100;
			attribute<String> to_name        := /Classifications/Grondgebruik/LU_Hoofdklasse/name[second_rel];
			attribute<UInt32> TransCode      := from_TransCode + to_TransCode;
			attribute<String> Label          := from_name + '_' + to_name;
			
			attribute<UInt32> count          := pcount(LU_Mutatie)[uint32];
		}
		
		attribute<uint32>                 LU_Basisjaar (rdc_25m) := uint32(ThisCasus/basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA) + 1;
		attribute<uint32>                 LU_Zichtjaar (rdc_25m) := ='(uint32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA) + 1)  * 100';
		attribute<Hoofdklasse_Transities> LU_Mutatie   (rdc_25m) := rlookup(LU_Basisjaar + LU_Zichtjaar, Hoofdklasse_Transities/TransCode);
		
		container Basisjaar_NPV_perLandbouwK :=
			for_each_nedv(
				/Classifications/Actor/LandbouwKlasses/Actief/name
				, '/BaseData/StartState/Landgebruik/LandbouwK_rel == /Classifications/Actor/LandbouwKlasses/V/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'
						? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'/NPV 
						: 0[Eur_m2]'
				, rdc_25m
				, Eur_m2
			);
		
		container Zichtjaren := for_each_ne(/Classifications/Time/Zichtjaar/name, 'ZichtjaarT('+string(id(/Classifications/Time/Zichtjaar))+'[/Classifications/Time/Zichtjaar])');
		
		Template ZichtjaarT
		{
			//
			parameter</Classifications/Time/Zichtjaar> id;
			//
			
			parameter<String> Zichtjaar_name := /Classifications/Time/Zichtjaar/name[id];
			
			container NPV_perLandbouwK :=
				for_each_nedv(
					/Classifications/Actor/LandbouwKlasses/Actief/name
					, 'ThisCasus/Zichtjaren/'+Zichtjaar_name+'/Stand/Subsector_rel == /Classifications/Actor/Sector/xSubsector/V/Landbouw_'+/Classifications/Actor/LandbouwKlasses/Actief/name+'
							? ThisVariantData/Suitability/'+Zichtjaar_name+'/Landbouw/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'/NPV
							: 0[Eur_m2]'
					, rdc_25m
					, Eur_m2
				)
			{
				attribute<Eur> Totaal (rdc_25m) := ='add('+AsItemList(/Classifications/Actor/LandbouwKlasses/Actief/name+'[Eur_ha] * rdc_25m/NrHaPerCell')+')', 
				// StorageName = "='%LocalDataProjDir%/Indicatoren/NPV/'+Casus_name +'/'+BoerVariant_name+'/'+BeregeningScenario_name+'/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
				StorageName = "='%LocalDataProjDir%/Indicatoren/NPV/'+Casus_name +'/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
			}
			
		}
		
		container Zichtjaar_NPV_perLandbouwK :=
			for_each_nedv(
				/Classifications/Actor/LandbouwKlasses/Actief/name
				, 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Subsector_rel == /Classifications/Actor/Sector/xSubsector/V/Landbouw_'+/Classifications/Actor/LandbouwKlasses/Actief/name+'
						? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_LandbouwKlasse/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'/NPV
						: 0[Eur_m2]'
				, rdc_25m
				, Eur_m2
			)
		, Descr = "De contante waarde van het landbouwsaldo per klasse, op de cellen waar de landgebruikskaart van het exportzichtjaar die klasse draagt: de bron onder de kaart Landbouw/NPV_Landbouw en de drie
					landbouwkolommen van de indicatorentabel (#794). Geen voorwaarde op HasLandbouwSector: die hoort bij de Augmented-variant hieronder, die de schaduwprijzen van de landbouwallocatie optelt en
					zonder die allocatie niet bestaat, terwijl de gewone NPV alleen de geschiktheid leest, die in Suitability_Zichtjaar_T onvoorwaardelijk wordt gemaakt. Wat de kaart meet is niet wat de
					allocatie heeft gedaan, maar wat de landbouwgrond die er in dit zichtjaar ligt volgens het model waard is."
		{
			attribute<Eur> Totaal (rdc_25m) := ='add('+AsItemList(/Classifications/Actor/LandbouwKlasses/Actief/name+'[Eur_ha] * rdc_25m/NrHaPerCell')+')'
			, Descr = "De klassen samengevoegd tot een bedrag per cel: per cel de NPV van de klasse die de landgebruikskaart daar draagt, van euro per hectare naar euro per cel. Nul op elke cel zonder landbouw. Dezelfde formule als Zichtjaren/<zichtjaar>/NPV_perLandbouwK/Totaal, die op een eigen pad staat omdat PostAllocAnalyses/PeilOptimalisatie die bestanden per scenario en variant terugleest.";

			attribute<Ha> Landbouw_Ha (rdc_25m) := ='float32(/Classifications/Actor/Sector/xSubsector/IsLandbouw[ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Subsector_rel]) * rdc_25m/NrHaPerCell'
			, Descr = "Het landbouwareaal per cel, als noemer onder de NPV per hectare in de indicatorentabel. Staat hier zodat teller en noemer dezelfde landgebruikskaart lezen: een cel telt mee in de noemer precies wanneer hij in Totaal een bedrag kan dragen.";
		}
		
		// -- de bron van de landbouwkolommen van de indicatorentabel (#824) --
		// Met ModelParameters/TabellenUitExport aan lezen de vijf landbouwkolommen de drie kaarten terug die de container
		// Landbouw schrijft, in plaats van de opbrengsten per klasse hierboven opnieuw te rekenen.
		container Lees
		: Descr = "De drie landbouwkaarten van het exportzichtjaar, teruggelezen met dezelfde bestandsnamen als de schrijvers in de container Landbouw (#824)."
		{
			attribute<Eur> NettoOpbrengst (rdc_25m) : StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NettoOpbrengst_Landbouw')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
			attribute<Eur> NPV            (rdc_25m) : StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NPV_Landbouw')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
			attribute<Ha>  Landbouw_Ha    (rdc_25m) : StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landbouw_Ha')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		}
		container Live
		{
			attribute<Eur> NettoOpbrengst (rdc_25m) := Impl/Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal;
			attribute<Eur> NPV            (rdc_25m) := Impl/Zichtjaar_NPV_perLandbouwK/Totaal;
			attribute<Ha>  Landbouw_Ha    (rdc_25m) := Impl/Zichtjaar_NPV_perLandbouwK/Landbouw_Ha;
		}
		container Bron := = /ModelParameters/TabellenUitExport ? 'Lees' : 'Live'
		, Descr = "Waar de landbouwkolommen van de indicatorentabel hun cellen vandaan halen: Live (berekend) of Lees (de export van dit zichtjaar teruggelezen), gestuurd door ModelParameters/TabellenUitExport (#824).";
		
		attribute<Ha> Verandering_Areaal_perHoofdklasse (/Classifications/Grondgebruik/LU_Hoofdklasse) := Zichtjaar_Areaal_perHoofdklasse - Basisjaar_Areaal_perHoofdklasse;
	}

	
	container Diagnose
	: Descr = "Getallen die niet de deur uit gaan: geen enkel item hieronder heeft een StorageName, en geen enkel item hieronder staat in generates (#779). Ze zijn er om naar te kijken, in de GUI of met
				een losse aanroep. De transitiematrix hoort hier het nadrukkelijkst thuis: een kruistabel van beginklasse bij eindklasse, bedoeld om te lezen en niet om te leveren; wat er per klasse
				geleverd wordt is het areaal, als tabel Landgebruik_Areaal onderaan dit bestand."
	{
		// Veranderingen totaal areaal sector landbouw 
		parameter<Ha>     Verandering_Areaal_Landbouw                    := impl/Zichtjaar_Areaal_Landbouw - impl/Basisjaar_Areaal_Landbouw;
	
		// Verandering netto opbrengsten in euro’s (bedrijfwinst) tussen basisjaar en zichtjaar
		parameter<Eur_ha> Verandering_NettoOpbrengst_gemid_perHa         := impl/Zichtjaar_NettoOpbrengsten_perLandbouwK/Gemiddeld_perHa - impl/Basisjaar_NettoOpbrengsten_perLandbouwK/Gemiddeld_perHa;
		parameter<Eur>    Verandering_NettoOpbrengst_Totaal_Studiegebied := impl/Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal_Studiegebied - impl/Basisjaar_NettoOpbrengsten_perLandbouwK/Totaal_Studiegebied;
	
		// CO2 emissies, mton en eur, via prijs
		parameter<ton_jaarlijks>    Basisjaar_CO2_Uitstoot     := ='sum(ThisCasus/Basisjaar/SOMERS_CO2_laagveen/Emissies/Mediaan/Jaarlijks)[ton_jaarlijks]';
		parameter<ton>              Cumulatief_CO2_Uitstoot    := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Cumulatief_sindsStartyear)[ton]';
		parameter<Eur>              Cumulatief_CO2_kosten_laag := Cumulatief_CO2_Uitstoot * /ModelParameters/Landbouw/CO2_prijs_minimum; 
		parameter<Eur>              Cumulatief_CO2_kosten_hoog := Cumulatief_CO2_Uitstoot * /ModelParameters/Landbouw/CO2_prijs_maximum;

		container Transitie_Matrix := 
			for_each_nedv(
				/Classifications/Grondgebruik/LU_Hoofdklasse/name
				, 'impl/Hoofdklasse_Transities/count[
														value(
															uint32(id(/Classifications/Grondgebruik/LU_Hoofdklasse)) * uint32(#/Classifications/Grondgebruik/LU_Hoofdklasse) + '+string(id(/Classifications/Grondgebruik/LU_Hoofdklasse))+'
														, impl/Hoofdklasse_Transities
														)
													][uint8]'
				, /Classifications/Grondgebruik/LU_Hoofdklasse
				, uint8
			)
		{
			attribute<string> from  (/Classifications/Grondgebruik/LU_Hoofdklasse) := /Classifications/Grondgebruik/LU_Hoofdklasse/name;
		}
	
		container mean_NPV_obv_LUbasisjaar_perLBK :=
			for_each_nedv(
				LandbouwKlasses/name
				, 'mean(impl/Basisjaar_NPV_perLandbouwK/Landbouw_'+LandbouwKlasses/name+')'
				, void
				, Eur_m2
			);
		
		container mean_NPV_obv_LU_Zichtjaar_perLBK_zonderAugm :=
			for_each_nedv(
				LandbouwKlasses/name
				, 'mean(impl/Zichtjaar_NPV_perLandbouwK/Landbouw_'+LandbouwKlasses/name+')'
				, void
				, Eur_m2
			);
	
		// container mean_NPV_obv_LU_Zichtjaar_perLBK_Augmented :=
			// for_each_nedv(
				// LandbouwKlasses/name
				// , 'mean(impl/Zichtjaar_NPV_Augmented_perLandbouwK/Landbouw_'+LandbouwKlasses/name+')'
				// , void
				// , Eur_m2
			// );
	
		// container Bereikbaarheid_GroenWater 
		// {
			// parameter<String> Param_Afstand := 'Tot300m'; //opties: Tot500m Tot1000m
			// parameter<String> Param_Type    := 'Aanwezig'; //opties: Aanwezig Beschikbaar Bereikbaar
		
			// unit<UInt8> GroenWaterK := ThisCasus/Zichtjaren/Basisjaar/BereikbaarheidGroen/GroenWaterK;
		
			// container Basisjaar := 
				// for_each_nedv(
					// GroenWaterK/name
					// , 'ThisCasus/Zichtjaren/Basisjaar/BereikbaarheidGroen/Afstanden/'+Param_Afstand+'/AggrGroenKlassen/'+GroenWaterK/name+'/Indicatoren/'+Param_Type+'/Groen/Aggregated/PerWoning'
					// , void
					// , m2_Woning
				// );
			// container Zichtjaar := 
				// for_each_nedv(
					// GroenWaterK/name
					// , 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/Afstanden/'+Param_Afstand+'/AggrGroenKlassen/'+GroenWaterK/name+'/Indicatoren/'+Param_Type+'/Groen/Aggregated/PerWoning'
					// , void
					// , m2_Woning
				// );
		// }
	}

	
	parameter<string> Generate_Indicatoren := generates/Generate_Alles
	, Descr = "Alias van generates/Generate_Alles, zodat batch/RunIndicatoren.ps1 en batch/RunZichtjaren.cmd ongewijzigd blijven werken (#779). Hier stond de lijst zelf, als een enkele string met alle leveranciers achter elkaar; die staat nu regel voor regel in generates bovenaan dit bestand, met een naam per uitvoerbestand, zodat de export ook per bestand is aan te roepen.";

	
	parameter<string> AllocatieFileName := replace(
		ModelParameters/Advanced/AllocatieFileName
		, '@CASUS@', Casus_name
		, '@JAAR@', ExportZichtjaar
		, '@SA@', ModelParameters/StudyArea
		, '@SS@', string(#/Classifications/Actor/Sector/xSubsector)
	);

	container Grondgebruik
	: Descr = "Wat een cel is en wat er sinds het basisjaar aan veranderd is (#779): de twee verschilkaarten met het vorige zichtjaar, de verstedelijking, en de arealen per klasse als tabel. De kaarten
				zelf staan in Templates/Indicatoren/Landgebruikskaart en gaan via generates/LandgebruikskaartNL2120 en generates/LandgebruikskaartHoofdklasse mee; de tabellen met de arealen worden hier
				gemaakt."
	{
		attribute</Classifications/Grondgebruik/LU_NL2120> Landgebruikskaart_bij_tov_PrevYear (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Result_bij_tov_PrevYear'        , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruikskaart_bij_tov_PrevYear')", StorageType = "gdalwrite.grid";
		attribute</Classifications/Grondgebruik/LU_NL2120> Landgebruikskaart_af_tov_PrevYear  (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Result_af_tov_PrevYear'         , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruikskaart_af_tov_PrevYear')", StorageType = "gdalwrite.grid";
		attribute<bool>                                    Verstedelijking                    (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/Verstedelijking', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Verstedelijking')", StorageType = "tif";
		attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> VerstedelijkingInABCD              (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerstedelijkingInABCD'   , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'VerstedelijkingInABCD')", StorageType = "gdalwrite.grid"
		, Descr = "De waarde-eenheid staat met een leidende slash omdat de container Grondgebruik waarin deze kaart sinds #779 zit, de ongekwalificeerde naam Grondgebruik afschermt: die zou dan naar deze container zelf wijzen in plaats van naar SourceData.";

		unit<uint8> Landgebruik_Areaal := /Classifications/Grondgebruik/LU_Hoofdklasse
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruik_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "De tabelkant van de landgebruikskaart (#658). Die kaart is een klasse per cel en aggregeert dus niet naar een getal per regio, maar naar een areaal per klasse. Deze tabel stond wel in de boom, als Impl/Basisjaar_Areaal_perHoofdklasse en Impl/Zichtjaar_Areaal_perHoofdklasse, maar werd nergens weggeschreven."
		{
			attribute<String> Klasse      := /Classifications/Grondgebruik/LU_Hoofdklasse/name;
			attribute<Ha>     Basisjaar   := Impl/Basisjaar_Areaal_perHoofdklasse;
			attribute<Ha>     Zichtjaar   := Impl/Zichtjaar_Areaal_perHoofdklasse;
			attribute<Ha>     Verandering := Impl/Verandering_Areaal_perHoofdklasse;
		}

		unit<uint8> LandgebruikNL2120_Areaal := /Classifications/Grondgebruik/LU_NL2120
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikNL2120_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "De grondbalanstabel van #783: het areaal per klasse van de gedetailleerde landgebruikskaart, landelijk en per landschapsgebied. De sectoren met hun verhardingsonderverdeling, en daaronder de
					natuurbeheertypen, de landbouwtypen en de LGN-klassen van de stand-administratie. De vier landschappen van #760 overlappen elkaar en dekken samen niet heel Nederland, dus de kolommen tellen
					niet op tot de kolom Nederland; de kolom Geen_landschap maakt het verschil zichtbaar, zodat elke hectare ergens terugkomt."
		{
			attribute<String> Klasse         := /Classifications/Grondgebruik/LU_NL2120/Label;
			attribute<Ha>     Nederland      := ='pcount(TRUE ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Kust           := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Rivieren       := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Veen           := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Zand           := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Geen_landschap := ='pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
		}

		unit<uint8> LandgebruikHoofdklasse_Areaal := /Classifications/Grondgebruik/LU_Hoofdklasse
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikHoofdklasse_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "Dezelfde tabel op de kaartindeling van #783: natuur naar natuurtype, landbouw naar hoofdgroep, en stedelijk groen, infrastructuur en overig als eigen groepen. De vier landschappen van #760
					overlappen elkaar en dekken samen niet heel Nederland, dus de kolommen tellen niet op tot de kolom Nederland; de kolom Geen_landschap maakt het verschil zichtbaar."
		{
			attribute<String> Klasse         := /Classifications/Grondgebruik/LU_Hoofdklasse/Label;
			attribute<Ha>     Nederland      := ='pcount(TRUE ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Kust           := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Rivieren       := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Veen           := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Zand           := ='pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
			attribute<Ha>     Geen_landschap := ='pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell';
		}

		unit<uint8> LandgebruikNatDroog_Areaal := /Classifications/Grondgebruik/NatDroogK
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikNatDroog_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "De natuur van LandgebruikNL2120_Areaal samengevat tot nat, droog en nog om te vormen, met dezelfde kolommen (#828). De tweedeling staat op de klasse (LU_NL2120/NatDroogK_rel), dus de
					drie regels tellen op tot het natuurdeel van LandgebruikHoofdklasse_Areaal, water inbegrepen. Het resultatenrapport 1.0 telde alleen de klassen met een beheertype; de LGN-natuurklassen
					zonder beheertype vielen daar buiten de tweedeling."
		{
			attribute<String> Klasse         := /Classifications/Grondgebruik/NatDroogK/Label;
			attribute<Ha>     Nederland      := ='sum(pcount(TRUE ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel)';
			attribute<Ha>     Kust           := ='sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel)';
			attribute<Ha>     Rivieren       := ='sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel)';
			attribute<Ha>     Veen           := ='sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel)';
			attribute<Ha>     Zand           := ='sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel)';
			attribute<Ha>     Geen_landschap := ='sum(pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel)';
		}

		// De basisjaartegenhangers van de drie arealentabellen hierboven (#828): dezelfde regels en kolommen, gelezen uit de
		// basisjaarkaart die de export als Basisjaar_LandgebruikskaartNL2120 en Basisjaar_LandgebruikskaartHoofdklasse
		// meeschrijft. Het basisjaar is variantonafhankelijk, dus de vier casussen schrijven dezelfde tabel; hij staat in
		// elke casusmap zodat een levering per casus compleet is. Landgebruik_Areaal draagt het basisjaar al als kolom,
		// maar alleen landelijk; hier ook per landschapsgebied.
		unit<uint8> LandgebruikNL2120_Areaal_Basisjaar := /Classifications/Grondgebruik/LU_NL2120
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikNL2120_Areaal_Basisjaar', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "LandgebruikNL2120_Areaal voor het basisjaar, uit ThisCasus/Basisjaar/LandgebruikskaartNL2120. Zelfde kolommen als de zichtjaartabel, zodat de twee regel voor regel naast elkaar te leggen zijn."
		{
			attribute<String> Klasse         := /Classifications/Grondgebruik/LU_NL2120/Label;
			attribute<Ha>     Nederland      := pcount(TRUE ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Kust           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Rivieren       := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Veen           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Zand           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Geen_landschap := pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
		}

		unit<uint8> LandgebruikHoofdklasse_Areaal_Basisjaar := /Classifications/Grondgebruik/LU_Hoofdklasse
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikHoofdklasse_Areaal_Basisjaar', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "LandgebruikHoofdklasse_Areaal voor het basisjaar, uit ThisCasus/Basisjaar/LandgebruikskaartNL2120. De tabel die het resultatenrapport 1.0 als ArealenBasisjaar uit de geleverde basisjaarkaart telde."
		{
			attribute<String> Klasse         := /Classifications/Grondgebruik/LU_Hoofdklasse/Label;
			attribute<Ha>     Nederland      := pcount(TRUE ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Kust           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Rivieren       := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Veen           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Zand           := pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
			attribute<Ha>     Geen_landschap := pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_Hoofdklasse_SA : null_b)[float32] * rdc_25m/NrHaPerCell;
		}

		unit<uint8> LandgebruikNatDroog_Areaal_Basisjaar := /Classifications/Grondgebruik/NatDroogK
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikNatDroog_Areaal_Basisjaar', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "LandgebruikNatDroog_Areaal voor het basisjaar, uit ThisCasus/Basisjaar/LandgebruikskaartNL2120."
		{
			attribute<String> Klasse         := /Classifications/Grondgebruik/NatDroogK/Label;
			attribute<Ha>     Nederland      := sum(pcount(TRUE ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel);
			attribute<Ha>     Kust           := sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel);
			attribute<Ha>     Rivieren       := sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel);
			attribute<Ha>     Veen           := sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsVeen ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel);
			attribute<Ha>     Zand           := sum(pcount(/SourceData/Landschap/Landschapsgebieden/Impl/IsZand ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel);
			attribute<Ha>     Geen_landschap := sum(pcount(!(/SourceData/Landschap/Landschapsgebieden/Impl/IsKust || /SourceData/Landschap/Landschapsgebieden/Impl/IsRivieren || /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen || /SourceData/Landschap/Landschapsgebieden/Impl/IsZand) ? ThisCasus/Basisjaar/LandgebruikskaartNL2120/Bron_Result_SA : null_b)[float32] * rdc_25m/NrHaPerCell, /Classifications/Grondgebruik/LU_NL2120/NatDroogK_rel);
		}

	}

	container Wonen
	: Descr = "De woningvoorraad: waar hij staat en hoe dicht, hoeveel vierkante meter pand er ligt, en met welke bouwwijze de nieuwbouw is neergezet (#779). De woningwaarde en de kostenposten van de woningbouw staan in Templates/Indicatoren/Woningwaarde.dms en KostenWoningbouw.dms; ze horen bij dit domein en staan in generates onder wonen."
	{
	
		attribute<Woning_ha>                              Dichtheid_Wonen                    (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Wonen/Per_AdminDomain'                  , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Dichtheid_Wonen')", StorageType = "gdalwrite.grid";
		// De voetafdruk van wonen en van werken in vierkante meters per cel. Beide werden al berekend in
		// Templates/Indicatoren.dms maar stonden in geen enkele export; team Veen vraagt er expliciet om
		// voor de bodemdalingskant.
		attribute<meter2>                                 PandFootprint_Wonen                (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/PandFootprint_Wonen'                          , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'PandFootprint_Wonen')", StorageType = "gdalwrite.grid";

		unit<uint32> Bouwwijze_Areaal := /Classifications/Modellering/BouwwijzeK
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Bouwwijze_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "De tabelkant van de bouwwijzekaart (#763): hoeveel hectare nieuwbouw er per bouwwijze staat. Net als bij het landgebruik aggregeert een klasse per cel niet naar een getal per regio maar naar
					een areaal per klasse, dus staat dit los van de indicatorentabel. Het antwoord op de vraag hoeveel er aangepast is gebouwd: de drie bodemdalingbestendige bouwwijzen zijn ophogen, funderen op
					palen en drijvend; wat dat extra kost staat als KostenWoningbouw_MeerkostenBouwwijze in de indicatorentabel. Alleen de cellen waar sinds het basisjaar netto woningen zijn bijgekomen tellen
					mee, want de bouwwijze van bestaande bebouwing kent het model niet."
		{
			attribute<String> Bouwwijze    := /Classifications/Modellering/BouwwijzeK/name;
			attribute<Ha>     Nieuwbouw_Ha := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/Nieuwbouw_Ha_perBouwwijze';
		}
	}

	container Werken
	: Descr = "De werklocaties: dichtheid naar voetafdruk en naar banen, en de voetafdruk zelf (#779). De meerkosten tegen het water en de bereikbaarheid van banen staan in Templates/Indicatoren en horen in generates bij dit domein."
	{
		attribute<m2_ha>                                  Dichtheid_Werken_Pandfootprint_ha  (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/PandFootprint_ha/Per_AdminDomain', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Dichtheid_Werken_Pandfootprint_ha')", StorageType = "gdalwrite.grid";
		attribute<job_m2PandFootprint>                    Dichtheid_Werken_Banen_m2          (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/Banen_m2/Per_AdminDomain'        , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Dichtheid_Werken_Banen_m2')", StorageType = "gdalwrite.grid";
		attribute<meter2>                                 PandFootprint_Werken               (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/PandFootprint_Werken'                         , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'PandFootprint_Werken')", StorageType = "gdalwrite.grid";
	}

	container Water
	: Descr = "Verharding, piekbuiberging, overstromingsschade en de seizoensberging op veen (#779). Verharding staat hier omdat hij de invoer van de piekbuikant is; wie hem als verstening leest hoort hem bij grondgebruik. De drie NCW-varianten van de overstromingsschade staan in Templates/Indicatoren en horen in generates bij dit domein."
	{
		attribute<float32>                                Verharding                         (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Result'                                , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Verharding')", StorageType = "gdalwrite.grid";
		// De drie piekbuikaarten liggen als enige export niet op het AdminDomain van 25 meter maar op het blok
		// van Basisjaar/Piekbuiberging/Grid_ref, nu 500 meter. Vierhonderd cellen van de buurkaarten passen in
		// een cel hiervan, dus de blokmaat hoort in de bestandsnaam; zonder dat wordt zo'n kaart naast de andere
		// gelegd en per cel gecombineerd, en dat levert onzin op. Zie #720.
		attribute<Meter3>  Piekbuiberging_Ongedekt                               (ThisCasus/Basisjaar/Piekbuiberging/Grid) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerGrid/Ongedekt', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Piekbuiberging_Ongedekt_m3_per'+ThisCasus/Basisjaar/Piekbuiberging/Grid_ref)", StorageType = "gdalwrite.grid";
		attribute<Meter3>  Piekbuiberging_Gedekt                                 (ThisCasus/Basisjaar/Piekbuiberging/Grid) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerGrid/Gedekt'  , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Piekbuiberging_Gedekt_m3_per'+ThisCasus/Basisjaar/Piekbuiberging/Grid_ref)"  , StorageType = "gdalwrite.grid", Descr = "De keerzijde van Ongedekt: waar de opgave wel wordt gedekt. Een gewone rasterexport naast de andere, en niet een StorageName op PerGrid/Afname in de indicator zelf, want een item dat in geen enkele ExplicitSuppliers voorkomt wordt nooit geschreven (#720).";
		attribute<float32> Piekbuiberging_Dekkingsgraad                          (ThisCasus/Basisjaar/Piekbuiberging/Grid) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerGrid/Dekkingsgraad', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Piekbuiberging_Dekkingsgraad_per'+ThisCasus/Basisjaar/Piekbuiberging/Grid_ref)", StorageType = "gdalwrite.grid", Descr = "Gedekt gedeeld door de opgave, per blok. Gevraagd als kaartbeeld bij de oplevering van 3 september; de tabelkolom bestond al, de kaart niet. Ligt op hetzelfde blok als de twee kaarten hierboven. Lees hem niet los van Dekkingsgraad_Ongeklemd in de tabel: deze kaart is de ondergrens van de bandbreedte, waarbij berging alleen zijn eigen blok bedient. Zie #720 en #741.";
		attribute<Eur>     Overstromingsschade_Hoofdwatersysteem_Binnendijks     (AdminDomain)                             := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks'      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Overstromingsschade_Hoofdwatersysteem_Binnendijks')", StorageType = "gdalwrite.grid";
		attribute<Eur>     Overstromingsschade_Hoofdwatersysteem_Buitendijks     (AdminDomain)                             := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks'      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Overstromingsschade_Hoofdwatersysteem_Buitendijks')", StorageType = "gdalwrite.grid";
		attribute<Eur>     Overstromingsschade_Regionaalwatersysteem_Binnendijks (AdminDomain)                             := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks'      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Overstromingsschade_Regionaalwatersysteem_Binnendijks')", StorageType = "gdalwrite.grid";
		attribute<bool>    WaterbergingVeen                                      (AdminDomain)                             := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeen', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'WaterbergingVeen')", StorageType = "tif";
	}

	container Natuur
	: Descr = "Natuur en groen, en wat groen oplevert (#779): de natuurbouwstenen die de variant oplegt, de nieuwe en verdwenen natuur, en de twee bereikbaarheidsmaten. De waardering van groen in de
				woningprijs en de vermeden sterfte staan in Templates/Indicatoren en horen in generates bij dit domein en niet bij wonen: die kaarten meten het effect van groen, niet de woningvoorraad."
	{
		// De natuurbouwstenen zoals de landschapsteams ze hebben aangeleverd, voor ze in de landgebruikskaart
		// worden samengevoegd met de bestaande natuur. Dit is dus wat de variant oplegt en niet wat er in het
		// basisjaar al stond; in het basisjaar is de kaart daarom leeg.
		attribute</Classifications/Grondgebruik/INL_Beheertype> BT_Exogeen                         (AdminDomain) := = ExportZichtjaar == 'Basisjaar' ? 'const(null_b, AdminDomain, /Classifications/Grondgebruik/INL_Beheertype)' : 'ThisVariantData/ExogeenOpleggen/Beheertype'
		, Descr = "Het beheertype van exogeen opgelegde natuur en water, per variant, na het opleggingsmasker, uit ThisVariantData/ExogeenOpleggen/Beheertype. In het basisjaar leeg: daar wordt nog niets opgelegd."
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'BT_Exogeen')", StorageType = "gdalwrite.grid";

		unit<uint8> BT_Exogeen_Areaal := /Classifications/Grondgebruik/INL_Beheertype
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'BT_Exogeen_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
		, Descr = "De tabelkant van BT_Exogeen: hoeveel hectare de landschapsteams per natuurbeheertype opleggen. Gevraagd bij de oplevering van 3 september, naast de kaart. Dit telt alleen de oplegging van de variant en niet de natuur die er in het basisjaar al lag; in het basisjaar is de kolom daarom nul. Wie het totale natuurareaal wil heeft LandgebruikNL2120_Areaal nodig, waar de bestaande natuur wel in zit."
		{
			attribute<String> Beheertype := /Classifications/Grondgebruik/INL_Beheertype/Label;
			attribute<Ha>     Zichtjaar  := pcount(BT_Exogeen)[float32] * rdc_25m/NrHaPerCell
			, Descr = "Telt de kaart hierboven en niet opnieuw de bron, zodat kaart en tabel per constructie hetzelfde zeggen.";
		}
		attribute<bool>      NieuweNatuur                (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuur', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NieuweNatuur')", StorageType = "tif";
		attribute<bool>      VerdwenenNatuur             (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenNatuur', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'VerdwenenNatuur')", StorageType = "tif";
		attribute<m2_woning> BereikbaarheidGroen_BBG     (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'BereikbaarheidGroen')", StorageType = "gdalwrite.grid";
		attribute<meter2>    BereikbaarheidGroen_Fractie (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Groenaanbod/Indicator', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'BereikbaarheidGroen_Fractie')", StorageType = "gdalwrite.grid", Descr = "De fractiebenadering uit #717: het groene deel van elke cel telt, inclusief het groen en water binnen ontwikkelpakketten, zonder de parkgroendrempels. De klassevariant hierboven blijft bestaan maar gaat op verzoek van Deltares niet mee in leveringen zolang #717 open staat.";
	}

	container Landbouw
	: Descr = "Wat de landbouwgrond waard is en wat de landbouw kwijtraakt (#779, #794). De kruisingen zijn een andere bestemming die op vruchtbare landbouwgrond landt; ze staan hier en niet bij
				verstedelijking, natuur of water omdat ze bestaan om het verlies aan landbouwgrond te tellen. De twee kaarten met verdwenen landbouw staan in Templates/Indicatoren/Grondgebruik.dms en horen
				in generates ook bij dit domein."
	{
		attribute<Eur>                                    NettoOpbrengst_Landbouw                    (rdc_25m) := Impl/Zichtjaar_NettoOpbrengsten_perLandbouwK/Totaal, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NettoOpbrengst_Landbouw')", StorageType = "gdalwrite.grid"
		, Descr = "Het netto landbouwsaldo van dit zichtjaar per cel, in euro (#794): per cel het saldo van de landbouwklasse die de landgebruikskaart daar draagt, nul waar geen landbouw ligt. De
					opbrengstenmaat, een stroom van een jaar zonder transitiekosten en zonder een keuze voor een horizon, naast NPV_Landbouw, die diezelfde stroom kapitaliseert en er de omschakelkosten van
					aftrekt en daardoor negatief uitkomt. Het saldo staat op de kostenvoet eigen mechanisatie, dus zonder arbeid, machines, gebouwen en bewaring, en is daarmee geen winst en geen inkomen; zie
					Templates/Landbouw en de bronnen in Akkerbouw_T en Dairy_T.";

		attribute<Eur>                                    NPV_Landbouw                               (rdc_25m) := Impl/Zichtjaar_NPV_perLandbouwK/Totaal, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NPV_Landbouw')", StorageType = "gdalwrite.grid"
		, Descr = "De netto landbouwopbrengst per cel als contante waarde in euro, gevraagd vanuit Deltares in #794: per cel de NPV van de landbouwklasse die de landgebruikskaart van dit zichtjaar daar draagt,
					nul waar geen landbouw ligt. Wat erin zit staat in Templates/Landbouw: het saldo per jaar maal de maatschappelijke kapitalisatiefactor, min de transitiekosten, op de kostenvoet eigen
					mechanisatie, dus een bovengrens voor de betalingsbereidheid voor grond en geen winst. De uitkomst is negatief, en dat ligt aan de opzet van de NPV en niet aan de grond: de transitiekosten
					worden eenmalig en voluit afgetrokken, terwijl het saldo maar over de lengte van het zichtjaarinterval wordt gekapitaliseerd (KapitalisatieMaatschappelijk gebruikt PeriodDuRation). Dat is te
					verdedigen voor de allocatie, waar alleen het verschil tussen klassen op dezelfde cel telt, maar niet voor een tabel die het bedrag als niveau leest; wie de opbrengst zelf wil hebben neemt
					Impl/Zichtjaar_NettoOpbrengsten_perLandbouwK (#794). Deze kaart ligt op rdc_25m en niet op AdminDomain, net als alles onder Templates/Landbouw; met AdminDomain op 100m valt de configuratie
					hard om, want de hele landbouwtak rekent op 25 meter. Dezelfde inhoud ligt ook onder Indicatoren/NPV, geschreven door Impl/Zichtjaren/<zichtjaar>/NPV_perLandbouwK/Totaal, dat
					PostAllocAnalyses/PeilOptimalisatie terugleest.";

		attribute<Ha>                                     Landbouw_Ha                                (rdc_25m) := Impl/Zichtjaar_NPV_perLandbouwK/Landbouw_Ha, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landbouw_Ha')", StorageType = "gdalwrite.grid"
		, Descr = "Het landbouwareaal per cel in hectare, de noemer onder de twee kolommen per hectare in de indicatorentabel. Een cel telt mee als de stand van dit zichtjaar er een landbouwsubsector draagt, dus op dezelfde cellen waarop NPV_Landbouw een bedrag kan dragen. Staat sinds #824 als kaart, zodat een tabelrun met ModelParameters/TabellenUitExport aan hem kan teruglezen.";

		attribute<bool> VerstedelijkingOpVruchtbareLandbouwgronden  (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'VerstedelijkingOpVruchtbareLandbouwgronden')", StorageType = "tif";
		attribute<bool> NieuweNatuurOpVruchtbareLandbouwgronden     (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NieuweNatuurOpVruchtbareLandbouwgronden')", StorageType = "tif";
		attribute<bool> WaterbergingVeenOpVruchtbareLandbouwgronden (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'WaterbergingVeenOpVruchtbareLandbouwgronden')", StorageType = "tif";
	}

	container Tabellen
	: Descr = "De tabellen die over alle domeinen tegelijk gaan (#779): de indicatorentabel als sjabloon, twee keer neergezet, en de claimrealisatie per allocatieniveau. Een kolom in deze tabellen hoort bij een domein, de tabel als geheel niet."
	{
	
		template RegionaleIndicatoren_T
		: Descr = "De tabelkant van de export, als sjabloon zodat hij twee keer kan worden neergezet: een keer landsdekkend en een keer op de gekozen regio-indeling (#705). De drie tekstparameters regelen waar
					de kolommen hun getal halen: elke indicator rekent een waarde per regio en een landelijk totaal uit, X_Per_Regio tegenover X_Per_NL, en voor de landelijke tabel wordt dat totaal, een
					parameter zonder domein, met union_data op de enkele regel van de NL-indeling gezet; vandaar Voor en Sluit. De kolommen die zelf sommeren over Regio/Per_AdminDomain_Fijn volgen vanzelf de
					indeling die hier wordt meegegeven."
		{
			parameter<String> RegioPad;
			parameter<String> Voor;
			parameter<String> NaamAggr;
			parameter<String> Sluit;
			parameter<String> AggrContainer;
			parameter<String> GroenPadExpr;
			parameter<String> TabelNaam;

			unit<uint32> Regio := =RegioPad;

			attribute<String> GroenPad (Regio) := =GroenPadExpr
			, Descr = "Waar de bereikbaarheid van groen per regel vandaan komt. Die indicator rekent per regio een eigen gemiddelde uit en is dus niet op te tellen; voor de landsdekkende tabel wijst dit naar de instantie Nationaal, die het gemiddelde over heel Nederland neemt.";

			unit<uint32> Tabel := Regio
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', TabelNaam, '.tif', '.csv')", StorageType = "gdalwrite.vect"
			, Descr = "De tabelkant van de export (#658): naast elke grid-indicator hierboven staat hier dezelfde indicator geaggregeerd naar de regio-indeling uit ModelParameters/Advanced. In de productierun
						staat die op NL, dus is dit een tabel van een regel met alle indicatoren naast elkaar. Niet hierin: claimrealisatie, die per allocatieregio van de betreffende sector hoort en in
						ClaimRealisatie/Per_AllocRegio zit, en de landgebruikskaart, die als klasse per cel naar een areaal per klasse aggregeert (Impl/Zichtjaar_Areaal_perHoofdklasse en Diagnose/Transitie_Matrix).
						Een kolom die door een uitgeschakelde sector leeg blijft, zoals verblijfsrecreatie, komt als lege kolom mee: de kolommen liggen vast, zodat twee runs naast elkaar te leggen zijn."
			{
				attribute<String>    Regio_name                                                      := Regio/name;

				// --- stand ---
				// De voorraad zelf naast de dichtheden (#828): het aantal woningen en banen in de stand van het zichtjaar, dezelfde grootheid als Wonen_stand en Werken_stand in de claimtabellen maar op de indicatorregio.
				attribute<Woning>    Stand_Woningen                                                  := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Aantal_Woningen_Totaal, Regio/Per_AdminDomain_Fijn)', Descr = "De woningvoorraad in het zichtjaar, uit de stand die de allocatie heeft weggeschreven.";
				attribute<Job>       Stand_Banen                                                     := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Stand/Aantal_Banen_Totaal, Regio/Per_AdminDomain_Fijn)', Descr = "De banen in het zichtjaar, uit dezelfde stand.";

				// --- dichtheid ---
				attribute<Woning_ha> Dichtheid_Wonen                                                 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Wonen/'+NaamAggr+Sluit;
				attribute<Job_ha>    Dichtheid_Werken_Banen_ha                                       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/Banen_ha/'+NaamAggr+Sluit;
				attribute<m2_ha>     Dichtheid_Werken_PandFootprint_ha                               := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/PandFootprint_ha/'+NaamAggr+Sluit;
				attribute<job_m2PandFootprint> Dichtheid_Werken_Banen_m2                             := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/Banen_m2/'+NaamAggr+Sluit;

				// --- verharding ---
				attribute<float32>   Verharding                                                      := ='mean(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Bron_Result, Regio/Per_AdminDomain_Fijn)', Descr = "Gemiddelde verharde fractie per cel over de regio, uit dezelfde samengestelde kaart die als grid wordt geexporteerd.";
				attribute<m2_ha>     Verharding_Werken                                               := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Werken/'+NaamAggr+Sluit;
				attribute<m2_ha>     Verharding_Verblijfsrecreatie                                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Verblijfsrecreatie/'+NaamAggr+Sluit;

				// --- piekbuiberging ---
				// Hoeveel van de piekbuiopgave in bestaand bebouwd gebied wordt gedekt door blauw-groene
				// maatregelen. Niet te verwarren met de sector Waterberging verderop in deze tabel, die als
				// WaterbergingVeen in hectare staat: dat is seizoensberging in het landelijk gebied en telt hier
				// per constructie niet mee. Beide heetten tot #720 waterberging.
				//
				// Dekkingsgraad is Gedekt gedeeld door Opgave, en dat is het getal dat in een beleidstekst wordt
				// overgenomen. Lees het nooit los van Dekkingsgraad_Ongeklemd ernaast: opgave en aanbod worden per
				// blok van 500 meter weggestreept en aanbod boven de blokopgave vervalt, wat op Y2120 bijna de helft
				// van het aanbod is. De twee kolommen zijn de onder- en bovengrens van dezelfde uitkomst.
				//
				// Piekbuiberging_Aanbod_m3 is sinds #741 van betekenis veranderd zonder van naam te veranderen. Hij
				// telde alle bergingscapaciteit en telt nu alleen de capaciteit binnen bestaand bebouwd gebied, want
				// de opgave stond daar al op gemaskeerd. Het getal wordt daarmee kleiner en de dekkingsgraad ook. Wat
				// eruit valt staat als Piekbuiberging_AanbodBuitenUrbanContour_m3 ernaast, dus de oude kolom is terug te
				// krijgen door die twee op te tellen. Leg leveringen van voor en na #741 daarom niet naast elkaar
				// zonder die optelling.
				attribute<Meter3>  Piekbuiberging_Opgave_m3                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Opgave'+Sluit;
				attribute<Meter3>  Piekbuiberging_Aanbod_m3                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Aanbod'+Sluit;
				attribute<Meter3>  Piekbuiberging_AanbodBuitenUrbanContour_m3 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/AanbodBuitenUrbanContour'+Sluit;
				attribute<Meter3>  Piekbuiberging_Gedekt_m3                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Gedekt'+Sluit;
				attribute<Meter3>  Piekbuiberging_Ongedekt_m3                 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Ongedekt'+Sluit;
				attribute<Meter3>  Piekbuiberging_AanbodZonderOpgave_m3       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/AanbodZonderOpgave'+Sluit;
				attribute<float32> Piekbuiberging_Dekkingsgraad               := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Dekkingsgraad'+Sluit;
				attribute<float32> Piekbuiberging_Dekkingsgraad_Ongeklemd     := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Dekkingsgraad_Ongeklemd'+Sluit;
				// Dezelfde balans bij de bui van eens per 100 jaar, 70 mm in 2 uur (#828), tegen hetzelfde aanbod; de vijf kolommen hierboven staan op de bui van
				// ModelParameters/Piekbuiberging/Kans_ref, in de productierun 1000. Staat Kans_ref op 100, dan herhalen deze kolommen die van hierboven.
				attribute<Meter3>  Piekbuiberging_Opgave_T100_m3              := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Opgave_T100'+Sluit, Descr = "De opgave bij de bui van eens per 100 jaar; de opgave van Kans_ref 1000 is ruim veertig procent groter (#741).";
				attribute<Meter3>  Piekbuiberging_Gedekt_T100_m3              := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Gedekt_T100'+Sluit;
				attribute<Meter3>  Piekbuiberging_Ongedekt_T100_m3            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Ongedekt_T100'+Sluit;
				attribute<float32> Piekbuiberging_Dekkingsgraad_T100          := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Dekkingsgraad_T100'+Sluit;
				attribute<float32> Piekbuiberging_Dekkingsgraad_Ongeklemd_T100 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Dekkingsgraad_Ongeklemd_T100'+Sluit;
				// De drie kostenkolommen staan er sinds #798. Aanlegkosten is een voorraadgrootheid, dus de kosten van alle
				// maatregelen die er in dit zichtjaar liggen, en niet wat er in deze periode bij kwam. Ze tellen bestaand
				// gebied, wonen, werken en verblijfsrecreatie samen. Onderhoud staat per jaar en als netto contante waarde
				// ernaast; tel die twee nooit bij de aanlegkosten op, dat zijn verschillende grootheden. Van deze drie zit
				// alleen de nieuwbouwtak in het exploitatiesaldo, op de meerkosten tegenover regulier bouw- en woonrijp
				// maken (#798); de indicator telt de volle aanlegkosten.
				attribute<Eur>           Piekbuiberging_Aanlegkosten_Eur                                 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Aanlegkosten'+Sluit;
				attribute<Eur_jaarlijks> Piekbuiberging_Onderhoudskosten_Eur_per_jaar                    := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/OnderhoudskostenPerJaar'+Sluit;
				attribute<Eur>           Piekbuiberging_Onderhoudskosten_NCW_Eur                         := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/'+AggrContainer+'/Onderhoudskosten_NCW'+Sluit;

				// --- overstromingsschade ---
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks                := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_'+NaamAggr+Sluit;
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Buitendijks                := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks_'+NaamAggr+Sluit;
				attribute<Eur>       Overstromingsschade_Regionaalwatersysteem_Binnendijks            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks_'+NaamAggr+Sluit;
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks_NCW            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_NCW_'+NaamAggr+Sluit;
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Buitendijks_NCW            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks_NCW_'+NaamAggr+Sluit;
				attribute<Eur>       Overstromingsschade_Regionaalwatersysteem_Binnendijks_NCW        := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks_NCW_'+NaamAggr+Sluit;
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks_tov_basisjaar  := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_tov_basisjaar/'+NaamAggr+Sluit;

				// --- kosten van de overstromingsmaatregel op werklocaties (#727) ---
				attribute<Eur>       KostenWerklocaties_MeerkostenOverstroming                       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/'+NaamAggr+'/MeerkostenOverstroming'+Sluit, Descr = "Wat de gealloceerde werklocaties aan extra ophoging tegen het water kosten, nominaal. De tegenhanger van de korting die diezelfde cellen sinds #727 in de overstromingsschade krijgen.";
				attribute<Eur>       KostenWerklocaties_MeerkostenOverstroming_NCW                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/'+NaamAggr+'/MeerkostenOverstroming_NCW'+Sluit;
				attribute<Eur>       KostenWerklocaties_MeerkostenBodemdaling                        := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/'+NaamAggr+'/MeerkostenBodemdaling'+Sluit, Descr = "Wat de bodemdaling aan ophoging kost op de gealloceerde werklocaties, nominaal (#828): alleen het zandpakket, tegen het ophoogtarief van bijlage E; zie Templates/Indicatoren/KostenWerklocaties.dms.";
				attribute<Ha>        KostenWerklocaties_Werklocatie_Ha                               := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/'+NaamAggr+'/Werklocatie_Ha'+Sluit, Descr = "Controlegetal: over hoeveel hectare de post hierboven is geboekt.";

				// --- kosten van de woningbouw (#505, #763) ---
				// De posten van KostenWoningbouw stonden tot #763 alleen als kaart en als controlebestand in
				// de export, terwijl de indicator de regionale en de landelijke sommen allang uitrekende. De
				// eerste twee gaan over het gebouw, de rest over het terrein eronder en het onderhoud erna.
				attribute<Eur>       KostenWoningbouw_Bouwkosten                                     := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/Bouwkosten'+Sluit, Descr = "De bouwkosten van de gealloceerde nieuwbouw, dus van de woningen zelf. Sinds #763 in de export; de post zat daarvoor alleen in het exploitatiesaldo van de allocatie.";
				attribute<Eur>       KostenWoningbouw_Bouwkosten_NCW                                 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/Bouwkosten_NCW'+Sluit;
				attribute<Eur>       KostenWoningbouw_MeerkostenBouwwijze                            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/MeerkostenBouwwijze'+Sluit, Descr = "Het deel van die bouwkosten dat aan de gekozen bouwwijze hangt, dus wat aangepast bouwen boven op een gewone woning kost. Staat op nul zolang BouwwijzeK/Kostenopslag op 1,0 staat en BouwwijzeOpslagInBouwkosten uit staat, zie #505 en #723. De hectares per bouwwijze staan in Bouwwijze_Areaal.";
				attribute<Eur>       KostenWoningbouw_Regulier                                       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/Regulier'+Sluit, Descr = "De grondproductiekosten van de ontwikkelaar: bouw- en woonrijp maken, bovenwijkse voorzieningen en het planproces.";
				attribute<Eur>       KostenWoningbouw_Regulier_NCW                                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/Regulier_NCW'+Sluit;
				attribute<Eur>       KostenWoningbouw_MeerkostenBodemdaling                          := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/MeerkostenBodemdaling'+Sluit, Descr = "Wat er bovenop komt doordat de ondergrond zakt, uit bijlage E van het landelijk afwegingskader. Hangt aan de bodemdalingsopgave van de plek en niet aan de categorie uit de bebouwingstypekaart.";
				attribute<Eur>       KostenWoningbouw_MeerkostenBodemdaling_NCW                      := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/MeerkostenBodemdaling_NCW'+Sluit;
				attribute<Eur>       KostenWoningbouw_BeheerEnOnderhoud                              := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/BeheerEnOnderhoud'+Sluit, Descr = "Het onderhoud aan de openbare ruimte over honderd jaar, netto contante waarde vanaf oplevering. Valt bij de gemeente en zit daarom niet in het exploitatiesaldo.";
				attribute<Eur>       KostenWoningbouw_BeheerEnOnderhoud_NCW                          := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/BeheerEnOnderhoud_NCW'+Sluit, Descr = "Let op de dubbele verdiscontering in de betekenis: het bedrag zelf is al een contante waarde over honderd jaar, en wordt hier nog eens teruggerekend van het bouwjaar naar het basisjaar.";
				attribute<Ha>        KostenWoningbouw_Nieuwbouw_Ha                                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/'+NaamAggr+'/Nieuwbouw_Ha'+Sluit, Descr = "Controlegetal: over hoeveel hectare de posten hierboven zijn geboekt.";

				// --- bereikbaarheid van groen ---
				attribute<meter2>    BereikbaarheidGroen_BBG_Tot300m_ExAgr_Groenaanbod_over_woning   := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')';
				attribute<meter2>    BereikbaarheidGroen_BBG_Tot300m_Groenaanbod_over_woning         := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')';
				attribute<m2_Woning> BereikbaarheidGroen_BBG_Tot300m_ExAgr_DrukteCorr_PerWoning      := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';
				attribute<m2_Woning> BereikbaarheidGroen_BBG_Tot300m_DrukteCorr_PerWoning            := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';
				attribute<meter2>    BereikbaarheidGroen_Fractie_Tot300m_Groenaanbod_over_woning     := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')', Descr = "Fractiebenadering (#717). Geen ExAgr-tegenhanger: de fractietak kent geen agrarische uitsluiting, want de hedonische natuurdefinitie regelt zelf al wat meetelt.";
				attribute<m2_Woning> BereikbaarheidGroen_Fractie_Tot300m_DrukteCorr_PerWoning        := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')', Descr = "Fractiebenadering, druktegecorrigeerd (#717).";

				// --- bereikbaarheid van banen (#632, #797) ---
				// Het bewonersgewogen gemiddelde aantal decayed bereikbare banen per vervoerstype. Dat is een
				// gemiddelde per woning en dus niet op te tellen; de aggregatie staat in
				// Templates/Indicatoren/Bereikbaarheid, container PerIndicatorRegio.
				attribute<Job>       Bereikbaarheid_Banen_OV                                         := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_W_OV_W_'+NaamAggr+Sluit;
				attribute<Job>       Bereikbaarheid_Banen_Fiets                                      := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_BB_'+NaamAggr+Sluit;
				attribute<Job>       Bereikbaarheid_Banen_Auto                                       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_CAR_'+NaamAggr+Sluit;

				// --- grondgebruik: verandering ten opzichte van het basisjaar ---
				attribute<ha>        Verstedelijking                                                 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/Verstedelijking/'+NaamAggr+Sluit;
				attribute<ha>        VerstedelijkingOpVruchtbareLandbouwgronden                      := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/'+NaamAggr+Sluit;
				// Inbreidingsaandeel per regio. Stond alleen als landelijke parameter in Indicatoren/Inbreiding en
				// kwam daardoor niet in deze tabel. Teller en noemer allebei bruto: met het netto verschil kantelt
				// de maat zodra er ergens gesloopt wordt en kan hij negatief worden, zie #639. Een regio zonder
				// nieuwe woningen geeft een lege cel, want dan is er geen aandeel te bepalen.
				attribute<float32> FractieWoningenErbijInBestaandBebouwdGebied       := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/Bron/WoningenErbij * float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/Bron/BestaandBebouwdGebied), Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/Bron/WoningenErbij, Regio/Per_AdminDomain_Fijn)[float32]';
				attribute<float32> FractieWoningenErbijInBestaandGroenInUrbanContour := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/Bron/WoningenErbij * float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/Bron/BestaandGroenInBestaandBebouwdGebied), Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/Bron/WoningenErbij, Regio/Per_AdminDomain_Fijn)[float32]';
				attribute<ha>      NieuweNatuur                                      := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuur/'+NaamAggr+Sluit;
				attribute<ha>      NieuweNatuurOpVruchtbareLandbouwgronden           := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/'+NaamAggr+Sluit;
				attribute<ha>      VerdwenenNatuur                                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenNatuur/'+NaamAggr+Sluit;
				attribute<ha>      WaterbergingVeen                                  := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeen/'+NaamAggr+Sluit;
				attribute<ha>      WaterbergingVeenOpVruchtbareLandbouwgronden       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/'+NaamAggr+Sluit;
				attribute<ha>      VerdwenenLandbouw                                 := ='sum(float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/Bron/VerdwenenLandbouw) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn)';
				attribute<ha>      VerdwenenVruchtbareLandbouw                       := ='sum(float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/Bron/VerdwenenVruchtbareLandbouw) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn)';

				// --- landbouw: wat de grond die er ligt waard is (#794) ---
				// De tabelkant van de kaart Landbouw/NPV_Landbouw. Deze drie sommeren zelf over
				// Regio/Per_AdminDomain_Fijn en hebben Voor, NaamAggr en Sluit dus niet nodig; ze volgen
				// vanzelf de indeling die het sjabloon meekrijgt, en komen daarmee zowel landsdekkend
				// als per landschapsgebied uit een run. Het volledige pad vanaf ThisCasus staat er
				// omdat een kale naam Impl omhoog wordt gezocht vanaf Tabel.
				attribute<Eur>       Landbouw_NettoOpbrengst                                         := ='sum(ThisCasus/Zichtjaren/Export/Impl/Bron/NettoOpbrengst, Regio/Per_AdminDomain_Fijn)', Descr = "Het netto landbouwsaldo van dit zichtjaar over alle landbouwcellen van de regio. De opbrengstenmaat: een stroom van een jaar, zonder transitiekosten. Op de kostenvoet eigen mechanisatie, dus geen winst en geen inkomen.";
				attribute<Eur_ha>    Landbouw_NettoOpbrengst_perHa                                   := ='sum(ThisCasus/Zichtjaren/Export/Impl/Bron/NettoOpbrengst, Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/Export/Impl/Bron/Landbouw_Ha, Regio/Per_AdminDomain_Fijn)', Descr = "Het saldo per hectare landbouw, het getal dat tussen landschappen te vergelijken valt. Een regio zonder landbouw geeft een lege cel. Rekent teller en noemer zelf uit over Impl en deelt niet
							de twee buurkolommen: een csv-container registreert belang op al zijn kolommen tegelijk, en een verwijzing naar een zus in dezelfde container maakt daar een kring van (Cannot start
							ChangeInterest while doing ChangeInterest), waarna de hele tabel niet wordt geschreven. Verwijs in deze tabel dus nooit naar een andere kolom; haal alles uit Impl.";
				attribute<Eur>       Landbouw_NPV                                                    := ='sum(ThisCasus/Zichtjaren/Export/Impl/Bron/NPV, Regio/Per_AdminDomain_Fijn)', Descr = "De contante waarde van het landbouwsaldo over alle landbouwcellen van de regio. Bevat de transitiekosten en kapitaliseert over de lengte van het zichtjaarinterval, en komt daardoor negatief uit; lees hem naast Landbouw_NettoOpbrengst en zie de kaart Landbouw/NPV_Landbouw voor de meting.";
				attribute<Ha>        Landbouw_Areaal                                                 := ='sum(ThisCasus/Zichtjaren/Export/Impl/Bron/Landbouw_Ha, Regio/Per_AdminDomain_Fijn)', Descr = "Het landbouwareaal waarover de kolom hiervoor is geboekt, uit dezelfde landgebruikskaart. Staat er als noemer en als controlegetal: een NPV die tussen twee varianten verschuift is pas te duiden naast het areaal waarop hij rust.";
				attribute<Eur_ha>    Landbouw_NPV_perHa                                              := ='sum(ThisCasus/Zichtjaren/Export/Impl/Bron/NPV, Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/Export/Impl/Bron/Landbouw_Ha, Regio/Per_AdminDomain_Fijn)', Descr = "Het saldo per hectare landbouw, het getal dat tussen landschappen te vergelijken valt. Een regio zonder landbouw geeft een lege cel. Rekent teller en noemer zelf uit over Impl en deelt niet
							de twee buurkolommen: een csv-container registreert belang op al zijn kolommen tegelijk, en een verwijzing naar een zus in dezelfde container maakt daar een kring van (Cannot start
							ChangeInterest while doing ChangeInterest), waarna de hele tabel niet wordt geschreven. Verwijs in deze tabel dus nooit naar een andere kolom; haal alles uit Impl.";

				// --- sloop, uitgesplitst naar de drie oorzaken uit #658 ---
				attribute<Woning>    Sloop_NieuweNatuur_Woningen                                     := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/GesloopteWoningen_'+NaamAggr+Sluit;
				attribute<Job>       Sloop_NieuweNatuur_Banen                                        := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/GesloopteBanen_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_NieuweNatuur_Uitkoopkosten                                := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_NieuweNatuur_Sloopkosten                                  := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Sloopkosten_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_NieuweNatuur_Uitkoopkosten_NCW                            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_NCW_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_NieuweNatuur_Sloopkosten_NCW                              := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Sloopkosten_NCW_'+NaamAggr+Sluit;

				attribute<Woning>    Sloop_WaterbergingVeen_Woningen                                 := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/GesloopteWoningen_'+NaamAggr+Sluit;
				attribute<Job>       Sloop_WaterbergingVeen_Banen                                    := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/GesloopteBanen_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_WaterbergingVeen_Uitkoopkosten                            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_WaterbergingVeen_Sloopkosten                              := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_WaterbergingVeen_Uitkoopkosten_NCW                        := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_NCW_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_WaterbergingVeen_Sloopkosten_NCW                          := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_NCW_'+NaamAggr+Sluit;

				attribute<Woning>    Sloop_OverigeBouwstenen_Woningen                                := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/GesloopteWoningen_'+NaamAggr+Sluit;
				attribute<Job>       Sloop_OverigeBouwstenen_Banen                                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/GesloopteBanen_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_OverigeBouwstenen_Uitkoopkosten                           := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_OverigeBouwstenen_Sloopkosten                             := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_OverigeBouwstenen_Uitkoopkosten_NCW                       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_NCW_'+NaamAggr+Sluit;
				attribute<Eur>       Sloop_OverigeBouwstenen_Sloopkosten_NCW                         := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_NCW_'+NaamAggr+Sluit;

				// --- de drie sloopoorzaken bij elkaar (#658, #797) ---
				// Mag zonder meer opgeteld worden omdat de maskers in Sloopmaskers elkaar uitsluiten; de
				// IntegrityCheck op Sloopmaskers/AantalOorzaken bewaakt dat. Staat als eigen kolom zodat de
				// ontvanger het totaal niet uit zes kolommen hoeft op te tellen.
				attribute<Woning>  SloopTotaal_Woningen                                            := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopTotaal/GesloopteWoningen_'+NaamAggr+Sluit;
				attribute<Job>     SloopTotaal_Banen                                               := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopTotaal/GesloopteBanen_'+NaamAggr+Sluit;
				attribute<Eur>     SloopTotaal_Uitkoopkosten                                       := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopTotaal/Uitkoopkosten_'+NaamAggr+Sluit;
				attribute<Eur>     SloopTotaal_Sloopkosten                                         := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopTotaal/Sloopkosten_'+NaamAggr+Sluit;
				attribute<Eur>     SloopTotaal_Uitkoopkosten_NCW                                   := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopTotaal/Uitkoopkosten_NCW_'+NaamAggr+Sluit;
				attribute<Eur>     SloopTotaal_Sloopkosten_NCW                                     := =Voor+'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopTotaal/Sloopkosten_NCW_'+NaamAggr+Sluit;

				// --- woningwaarde en de waardering van groen in de nabijheid ---
				attribute<Eur>       Woningwaarde_Nieuwbouw                                          := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Woningwaarde/Bron/Nieuwbouw, Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       Woningwaarde_Nieuwbouw_NCW                                      := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Woningwaarde/Bron/Nieuwbouw_NCW, Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       Grondexploitatie_Saldo                                          := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Saldo, Regio/Per_AdminDomain_Fijn)', Descr = "Het exploitatiesaldo van de nieuwbouw die het model zelf heeft gealloceerd, opgeteld over de cellen waar sinds het basisjaar netto woningen zijn bijgekomen, zonder de BAG-nieuwbouw van #550 (#799). Negatief is een tekort. Zie Templates/Indicatoren.dms, container Grondexploitatie, voor de keuzes die erin zitten.";
				attribute<Eur_ha>    Grondexploitatie_Saldo_perHa                                    := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Saldo, Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Nieuwbouw_Ha, Regio/Per_AdminDomain_Fijn)', Descr = "Hetzelfde saldo per hectare nieuwbouw, met als noemer de hectares waarover het saldo is geboekt (KostenWoningbouw_Nieuwbouw_Ha min de BAG-nieuwbouw). Rekent zelf beide sommen uit en leest geen buurkolom, zie #794.";
				// De negen posten van het saldo (#828), elk op dezelfde voet als het saldo: opbrengsten min de acht kostenposten is Grondexploitatie_Saldo. De drie posten die ook als
				// KostenWoningbouw_* in deze tabel staan zijn hier kleiner, want die kolommen tellen de BAG-nieuwbouw mee, waarover geen saldo is geboekt.
				attribute<Eur>       Grondexploitatie_Post_Opbrengsten                               := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Opbrengsten, Regio/Per_AdminDomain_Fijn)', Descr = "De opbrengstterm van het saldo: de marktwaarde van het gealloceerde pakket met de pakketweging in de prijs, netto van btw; niet Woningwaarde_Nieuwbouw.";
				attribute<Eur>       Grondexploitatie_Post_Bouwsom                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Bouwsom, Regio/Per_AdminDomain_Fijn)', Descr = "Gelijk aan KostenWoningbouw_Bouwkosten zonder de BAG-nieuwbouw.";
				attribute<Eur>       Grondexploitatie_Post_BijkomendeKosten                          := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_BijkomendeKosten, Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       Grondexploitatie_Post_WinstEnRisico                             := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_WinstEnRisico, Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       Grondexploitatie_Post_Grondproductie                            := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Grondproductie, Regio/Per_AdminDomain_Fijn)', Descr = "Gelijk aan KostenWoningbouw_Regulier zonder de BAG-nieuwbouw.";
				attribute<Eur>       Grondexploitatie_Post_Bodemdaling                               := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Bodemdaling, Regio/Per_AdminDomain_Fijn)', Descr = "Gelijk aan KostenWoningbouw_MeerkostenBodemdaling zonder de BAG-nieuwbouw; nul in een variant met BodemdalingkostenInSaldo op FALSE.";
				attribute<Eur>       Grondexploitatie_Post_Piekbuiberging                            := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Piekbuiberging, Regio/Per_AdminDomain_Fijn)', Descr = "De aanlegkosten van de bergingsmaatregelen van het gealloceerde pakket (#798).";
				attribute<Eur>       Grondexploitatie_Post_Verwerving                                := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Verwerving, Regio/Per_AdminDomain_Fijn)', Descr = "Woningen na funderingsafwaardering, niet-woningen en grond.";
				attribute<Eur>       Grondexploitatie_Post_Sloop                                     := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondexploitatie/Bron/Post_Sloop, Regio/Per_AdminDomain_Fijn)', Descr = "De sloop van wat er op de bebouwde cel stond; niet de sloop voor de bouwstenen.";
				attribute<Eur>       WaardeNabijheidGroen_Woningen                                   := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/Bron/WaardeVeranderingDoorGroenVerandering_Woningen, 0[Eur]), Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       WaardeNabijheidGroen_BestaandeWoningen                          := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/Bron/WaardeVeranderingDoorGroenVerandering_BestaandeWoningen, 0[Eur]), Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       WaardeNabijheidGroen_NieuwbouwWoningen                          := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/Bron/WaardeVeranderingDoorGroenVerandering_NieuwbouwWoningen, 0[Eur]), Regio/Per_AdminDomain_Fijn)';
				attribute<Eur>       WaardeNabijheidGroen_Woningen_NCW                               := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/Bron/WaardeVeranderingDoorGroenVerandering_Woningen_NCW, 0[Eur]), Regio/Per_AdminDomain_Fijn)';

				// --- vermeden sterfte door meer groen ---
				attribute<Persoon>   SterfteAfname_PerPeriode                                        := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/Bron/AfnamePerPeriode, Regio/Per_AdminDomain_Fijn)';
				attribute<Persoon>   SterfteAfname_Cumulatief                                        := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/Bron/AfnameCumulatief, Regio/Per_AdminDomain_Fijn)';
				// De twee termen waaruit SterfteAfname_PerPeriode is opgebouwd, apart, omdat ze een verschillend
				// verhaal vertellen. Zittend meet de verandering op de eigen locatie sinds het basisjaar en is dus
				// het effect van vergroening. Nieuw vergelijkt de nieuwe woning met de bewonersgewogen gemiddelde
				// groenindex van een woning in het basisjaar, en is structureel negatief zodra nieuwbouw compacter
				// is dan de bestaande voorraad. Zonder deze splitsing is een negatief totaal niet uit te leggen.
				attribute<Persoon>   SterfteAfname_PerPeriode_ZittendeBewoners                       := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/Bron/AfnameZittendeBewoners, Regio/Per_AdminDomain_Fijn)';
				attribute<Persoon>   SterfteAfname_PerPeriode_NieuweBewoners                         := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/Bron/AfnameNieuweBewoners, Regio/Per_AdminDomain_Fijn)';

				// --- koolstof ---
				attribute<ton>       CO2Stock_Zichtjaar                                              := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Stock_Zichtjaar, Regio/Per_AdminDomain_Fijn)', Descr = "De totale voorraad over beide pools: de bovenste 30 cm uit de bodemkoolstofkaart plus de veenkoolstof daaronder. De twee staan hieronder apart, en dat is nodig om deze kolom te kunnen lezen; zie daar.";
				// #736: de twee pools apart, want anders leest deze kolom als koolstof die op het spel staat. De veenreserve is
				// sinds die ronde de hele veenkolom onder de bovenste 30 cm in plaats van de schijf boven de basisjaar-GLG, en
				// daarmee gaat hij landelijk van 218 naar 863 Mton CO2. Van die reserve wordt binnen de horizon maar een derde
				// aangesproken: BAU verbruikt op de veenweide 0,54 van de 1,75 m die onder de toplaag ligt. Een lezer die alleen
				// het totaal ziet, ziet die verschuiving aan voor een verandering in wat er kan vrijkomen.
				attribute<ton>       CO2Stock_Zichtjaar_Bovenlaag                                    := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/Stock_Bovenlaag, Regio/Per_AdminDomain_Fijn)', Descr = "Alleen de bovenste 30 cm plus biomassa, dus de voorraad zoals de indicator hem voor #657 rapporteerde. Dit is de pool waar een landgebruiksverandering op aangrijpt.";
				attribute<ton>       CO2Stock_Zichtjaar_Veenreserve                                  := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/Stock_Veenreserve, Regio/Per_AdminDomain_Fijn)', Descr = "Alleen de veenkoolstof onder de bovenste 30 cm. Deze pool wordt uitsluitend door veenoxidatie aangesproken en verandert niet bij een landgebruiksverandering; wat er binnen de horizon van af gaat is het verschil met het basisjaar.";
				attribute<ton>       CO2Flow_Zichtjaar                                               := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Flow_Zichtjaar, Regio/Per_AdminDomain_Fijn)';
				attribute<ton>       CO2Flow_TovBasisjaar                                            := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Flow_TovBasisjaar, Regio/Per_AdminDomain_Fijn)';
				// #733: de kolom hierboven is op een laat zichtjaar niet los te lezen. De koolstofboekhouding kan niet meer verliezen
				// dan er in de voorraad ligt, dus zodra een veenweidecel leeg is stopt haar bijdrage aan het verlies terwijl SOMERS
				// er uitstoot blijft rapporteren. In BAU op 2120 gaat het om 96,1 Mton CO2 landelijk, genoeg om het saldo van min 89
				// naar plus 7 te tillen. Deze twee kolommen zetten dat erbij: hoeveel er buiten de boekhouding is gebleven, en wat
				// het saldo zou zijn als die post onverkort was geboekt.
				attribute<ton> CO2Ongedekt_Cumulatief            := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Ongedekt_Cumulatief, Regio/Per_AdminDomain_Fijn)', Descr = "Veenoxidatie die SOMERS sinds het basisjaar rapporteert terwijl de koolstofvoorraad van die cel al leeg was. Nul op alle zichtjaren waar de voorraad de vraag nog kon dragen.";
				attribute<ton> CO2Flow_TovBasisjaar_InclOngedekt := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Flow_TovBasisjaar, Regio/Per_AdminDomain_Fijn) - sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Ongedekt_Cumulatief, Regio/Per_AdminDomain_Fijn)', Descr = "Het koolstofsaldo met de ongedekte post als verlies meegeteld. Uitdrukkelijk niet de indicator, want veen dat er niet ligt oxideert niet; de kolom staat er als ondergrens naast zodat de bandbreedte tussen de koolstofindicator en de SOMERS-indicator zichtbaar is (#733).";

				// #758: de vraag vanuit Deltares om de verschillende bronnen en typen oxidatie los weg te schrijven plus een
				// totaal, met de eis dat ze niet dubbeltellen. Deze vijf kolommen tellen per regel op tot CO2Flow_Zichtjaar
				// hierboven, en dus niet tot CO2Flow_TovBasisjaar: het zijn de posten van dit zichtjaar en niet de stand
				// sinds het basisjaar. Wie het cumulatieve beeld wil telt de zichtjaren van deze regio bij elkaar op; die
				// som is per constructie CO2Flow_TovBasisjaar van het laatste zichtjaar. De sluitcontrole zit in het model
				// zelf, op Zichtjaar/Carbon/Herkomst/Totaal_ha.
				// Het teken is dat van de bijdrage aan het saldo: vastlegging positief, de vier andere posten negatief.
				attribute<ton>       CO2Flow_Zichtjaar_Vastlegging                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Vastlegging, Regio/Per_AdminDomain_Fijn)', Descr = "Vastlegging in dit zichtjaar. Alleen op cellen waar de koolstofklasse sinds het basisjaar is veranderd en waar geen veenoxidatie loopt (#737).";
				attribute<ton>       CO2Flow_Zichtjaar_Afboeking                                     := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Afboeking, Regio/Per_AdminDomain_Fijn)', Descr = "Afboeking naar het klassemaximum, dus het verlies bij een verandering naar een landgebruik dat de bodem afdekt of afgraaft. Dit is de post van bebouwen en infrastructuur, niet die van veen.";
				attribute<ton>       CO2Flow_Zichtjaar_Oxidatie_SOMERS                               := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Oxidatie_SOMERS, Regio/Per_AdminDomain_Fijn)', Descr = "Veenoxidatie op de SOMERS-veenweidepercelen, voor zover de voorraad en de veenreserve hem konden dragen. Wat daarboven uitkwam staat in CO2Ongedekt_Zichtjaar_SOMERS.";
				attribute<ton>       CO2Flow_Zichtjaar_Oxidatie_EF                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Oxidatie_EF, Regio/Per_AdminDomain_Fijn)', Descr = "Veenoxidatie op de veen- en moerige gronden buiten de SOMERS-percelen, met de emissiefactor uit EF_low_nl_2025.csv.";
				attribute<ton>       CO2Flow_Zichtjaar_Oxidatie_Veenkental                           := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Oxidatie_Veenkental, Regio/Per_AdminDomain_Fijn)', Descr = "Veenoxidatie volgens de kentallen van team Veen, die in de NbS-varianten in de plaats van SOMERS komen. Nul in BAU en BAU2, en nul als Koolstof_VeenVastleggingUitBouwstenen uitstaat.";
				attribute<ton>       CO2Flow_Zichtjaar_PerBronTotaal                                 := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Totaal, Regio/Per_AdminDomain_Fijn)', Descr = "De vijf kolommen hierboven bij elkaar. Deze kolom staat er als controle naast: hij hoort per regel gelijk te zijn aan CO2Flow_Zichtjaar, en is dat niet, dan is er een term in de voorraadbalans die niet in de uitsplitsing zit.";
				// Dezelfde uitsplitsing voor de ongedekte post van #733. Deze drie horen niet bij de vijf hierboven opgeteld
				// te worden: het is oxidatie die wel is gevraagd maar die de voorraad niet kon dragen, dus geen verandering
				// van de voorraad. Ze tellen samen op tot het verschil tussen CO2Ongedekt_Cumulatief van dit zichtjaar en
				// dat van het vorige.
				attribute<ton>       CO2Ongedekt_Zichtjaar_SOMERS                                    := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Ongedekt_SOMERS, Regio/Per_AdminDomain_Fijn)';
				attribute<ton>       CO2Ongedekt_Zichtjaar_EF                                        := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Ongedekt_EF, Regio/Per_AdminDomain_Fijn)';
				attribute<ton>       CO2Ongedekt_Zichtjaar_Veenkental                                := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/PerBron_Ongedekt_Veenkental, Regio/Per_AdminDomain_Fijn)';

				// --- veenemissies volgens SOMERS, cumulatief sinds het basisjaar ---
				attribute<kg>        SOMERS_CO2_Cumulatief_Minimum                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Minimum/Bron_Cumulatief, Regio/Per_AdminDomain_Fijn)';
				attribute<kg>        SOMERS_CO2_Cumulatief_Mediaan                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Bron_Cumulatief, Regio/Per_AdminDomain_Fijn)';
				attribute<kg>        SOMERS_CO2_Cumulatief_Maximum                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Maximum/Bron_Cumulatief, Regio/Per_AdminDomain_Fijn)';

				// --- methaan uit natte veenbodems (#657, #797) ---
				// In ton CO2-equivalent. Staat naast de CO2-kolommen en telt daar niet in mee: wie een totaal in
				// CO2-equivalent wil moet Methaan_Cumulatief zelf bij CO2Flow_TovBasisjaar optellen.
				attribute<mton>      Methaan_Jaarlijks                                               := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Methaan/Bron_Jaarlijks * 1[jaar], Regio/Per_AdminDomain_Fijn)[mton]', Descr = "De uitstoot in dit zichtjaar als jaarwaarde. De vermenigvuldiging met een jaar brengt de eenheid van een stroom naar een hoeveelheid; het getal blijft een jaarwaarde.";
				attribute<mton>      Methaan_Cumulatief                                              := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Methaan/Bron_Cumulatief, Regio/Per_AdminDomain_Fijn)[mton]', Descr = "Cumulatief sinds het basisjaar, dezelfde grootheid als de kaart Methaan.";

				// --- broeikasgassen samen, in megaton CO2-equivalent (#828) ---
				// De optelling die het resultatenrapport 1.0 zelf maakte: de koolstofstroom (ton CO2, negatief is verlies van voorraad) en het methaan (ton CO2-equivalent, positief is emissie)
				// op een teken gebracht, emissie positief. Lachgas zit er niet in. Elke kolom rekent zijn eigen sommen en leest geen buurkolom (#794).
				attribute<mton>      CO2eq_Netto_Cumulatief                                          := ='(-sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Flow_TovBasisjaar, Regio/Per_AdminDomain_Fijn))[mton] + sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Methaan/Bron_Cumulatief, Regio/Per_AdminDomain_Fijn)[mton]', Descr = "De netto broeikasgasemissie sinds het basisjaar: min CO2Flow_TovBasisjaar plus Methaan_Cumulatief, in megaton CO2-equivalent. Positief is emissie, negatief is netto vastlegging.";
				attribute<mton>      CO2eq_Netto_Cumulatief_InclOngedekt                             := ='(-(sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Flow_TovBasisjaar, Regio/Per_AdminDomain_Fijn) - sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Bron/CO2Ongedekt_Cumulatief, Regio/Per_AdminDomain_Fijn)))[mton] + sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Methaan/Bron_Cumulatief, Regio/Per_AdminDomain_Fijn)[mton]', Descr = "Dezelfde som met de ongedekte veenoxidatie als verlies meegeteld: min CO2Flow_TovBasisjaar_InclOngedekt plus Methaan_Cumulatief. Net als die kolom een ondergrens van het saldo en niet de indicator (#733).";
			}
		}

		container PerIndeling := RegionaleIndicatoren_T(
			  /ModelParameters/Advanced/IndicatorRegio_path
			, ''
			, 'Per_Regio'
			, ''
			, 'PerRegio'
			, "'obv_BBG/PerRegios/'+Regio/name"
			, 'Indicatoren_'+/ModelParameters/Advanced/IndicatorRegio_ref
		), Descr = "De tabel op de regio-indeling uit ModelParameters/Advanced/IndicatorRegio_ref. Voor de landschappen is dat uitsluitend een van de vier aangeleverde gebieden van #760
					(Indicatoren_Landschap_Kust.csv en verder, een run per gebied); de partitie van #705 is geen optie meer. Die gebieden overlappen elkaar, dus de vier tabellen tellen niet op tot
					NationaleIndicatoren.";

		container PerNederland := RegionaleIndicatoren_T(
			  '/SourceData/RegioIndelingen/NL'
			, 'union_data(Regio,'
			, 'Per_NL'
			, ')'
			, 'PerNL'
			, "const('obv_BBG/PerRegios/Nationaal', Regio)"
			, 'NationaleIndicatoren'
		), Descr = "Dezelfde tabel, altijd landsdekkend en niet afhankelijk van een parameter. Op verzoek vanuit Deltares bij #705: een run levert voortaan hoe dan ook de landelijke getallen op, en daarnaast de gekozen regionale doorsnede.";


		template BasisjaarIndicatoren_T
		: Descr = "De basisjaartegenhanger van RegionaleIndicatoren_T (#828): de indicatoren die in het basisjaar een betekenis hebben, met dezelfde kolomnamen en rekenregels, zodat het basisjaar naast een
					zichtjaar te leggen is; niet erin wat een verandering, een cumulatief of een contante waarde sinds het basisjaar is, en de claimrealisatie. Twee instanties, zoals de zichtjaartabel; IsNL
					kiest bij de items die als Per_NL en Per_Regio klaarstaan, en Cel_rel is de partitie waarover de andere kolommen aggregeren. Waar het basisjaar een Bron-container heeft (overstromingsschade, de
					landelijke groenbereikbaarheid) leest de tabel die, zodat een tabelrun met ModelParameters/TabellenUitExport de basisjaarkaarten terugleest die generates meeschrijft; de rest rekent
					levend. De banenbereikbaarheid komt uit de StartYear-kant van het exportzichtjaar."
		{
			parameter<String> RegioPad;
			parameter<Bool>   IsNL;
			parameter<String> GroenPadExpr;
			parameter<String> TabelNaam;

			unit<uint32> Regio := =RegioPad;

			attribute<Regio>  Cel_rel  (AdminDomain) := Regio/Per_AdminDomain_Fijn
			, Descr = "De partitie waarover de somkolommen van RegionaleIndicatoren_T aggregeren (#748), ook voor de landelijke instantie: RegioIndelingen/NL is een indeling van een regio. Zo tellen basisjaar en zichtjaar over dezelfde cellen; de coarse Per_AdminDomain van de claimtabellen telt aan de kust 1.198 cellen meer.";
			attribute<String> GroenPad (Regio)       := =GroenPadExpr;

			unit<uint32> Tabel := Regio
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', TabelNaam, '.tif', '.csv')", StorageType = "gdalwrite.vect"
			, Descr = "De basisjaartabel, een regel per regio."
			{
				attribute<String>    Regio_name                                                      := Regio/name;

				// --- stand ---
				attribute<Woning>    Stand_Woningen                                                  := sum(ThisCasus/Basisjaar/Stand/Aantal_Woningen_Totaal, Cel_rel);
				attribute<Job>       Stand_Banen                                                     := sum(ThisCasus/Basisjaar/Stand/Aantal_Banen_Totaal, Cel_rel);

				// --- dichtheid: het gemiddelde van de celdichtheid over de cellen met woningen of banen, zoals Per_Regio in Dichtheid.dms ---
				attribute<Woning_ha> Dichtheid_Wonen                                                 := mean(ThisCasus/Basisjaar/Dichtheid/Wonen/Per_AdminDomain, Cel_rel), Descr = "Het basisjaar heeft een eigen Dichtheid.dms (Templates/Indicatoren_T/Basisjaar) zonder schrijver: de dichtheid over de cellen met meer dan een woning, waar het zichtjaar de cellen neemt waar de allocatie wonen heeft gezet.";
				attribute<Job_ha>    Dichtheid_Werken_Banen_ha                                       := mean(ThisCasus/Basisjaar/Dichtheid/Werken/Banen_ha/Per_AdminDomain, Cel_rel);
				attribute<m2_ha>     Dichtheid_Werken_PandFootprint_ha                               := mean(ThisCasus/Basisjaar/Dichtheid/Werken/PandFootprint_ha/Per_AdminDomain, Cel_rel);
				attribute<job_m2PandFootprint> Dichtheid_Werken_Banen_m2                             := mean(ThisCasus/Basisjaar/Dichtheid/Werken/Banen_m2/Per_AdminDomain, Cel_rel);

				// --- verharding ---
				attribute<float32>   Verharding                                                      := mean(AdminDomain/IsCompactedDomain ? MakeDefined(ThisCasus/Basisjaar/Verharding/Result, 0f) : null_f, Cel_rel), Descr = "Gemiddelde verharde fractie per cel over de regio binnen het studiegebied. Een lege basisjaarcel telt als onverhard, zoals in het zichtjaar: daar krijgt een onveranderde cel het celgemiddelde van dezelfde kaart, en dat is nul waar de kaart leeg is; zonder MakeDefined komt het gemiddelde landelijk op 0,60 in plaats van rond 0,15. De begrenzing op het studiegebied is nodig omdat de landschapsgebieden tot op zee lopen en de basisjaarkaart daar niet leeg is: zonder die begrenzing kwam Kust op 0,34 in plaats van 0,15.";

				// --- piekbuiberging: alleen de opgave, want aanbod, gedekt en dekkingsgraad bestaan in het basisjaar niet, de bestaande capaciteit geldt daar als verbruikt ---
				attribute<Meter3>    Piekbuiberging_Opgave_m3                                        := = IsNL ? 'union_data(Regio, sum(ThisCasus/Basisjaar/Piekbuiberging/PerGrid/Opgave))'      : 'ThisCasus/Basisjaar/Piekbuiberging/PerRegio/Opgave';
				attribute<Meter3>    Piekbuiberging_Opgave_T100_m3                                   := = IsNL ? 'union_data(Regio, sum(ThisCasus/Basisjaar/Piekbuiberging/PerGrid/Opgave_T100))' : 'ThisCasus/Basisjaar/Piekbuiberging/PerRegio/Opgave_T100';

				// --- bereikbaarheid van groen, met dezelfde padkeuze als de zichtjaartabel ---
				attribute<meter2   > BereikbaarheidGroen_BBG_Tot300m_ExAgr_Groenaanbod_over_woning   := ='union_data(Regio,'+AsList('ThisCasus/Basisjaar/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')';
				attribute<meter2   > BereikbaarheidGroen_BBG_Tot300m_Groenaanbod_over_woning         := ='union_data(Regio,'+AsList('ThisCasus/Basisjaar/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')';
				attribute<m2_Woning> BereikbaarheidGroen_BBG_Tot300m_ExAgr_DrukteCorr_PerWoning      := ='union_data(Regio,'+AsList('ThisCasus/Basisjaar/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';
				attribute<m2_Woning> BereikbaarheidGroen_BBG_Tot300m_DrukteCorr_PerWoning            := ='union_data(Regio,'+AsList('ThisCasus/Basisjaar/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';
				attribute<meter2   > BereikbaarheidGroen_Fractie_Tot300m_Groenaanbod_over_woning     := ='union_data(Regio,'+AsList('ThisCasus/Basisjaar/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')', Descr = "Fractiebenadering (#717); in het basisjaar op de natuur- en watercel van de LGN-groenfracties, zie Basisjaar/BereikbaarheidGroen/GroenFractieCel.";
				attribute<m2_Woning> BereikbaarheidGroen_Fractie_Tot300m_DrukteCorr_PerWoning        := ='union_data(Regio,'+AsList('ThisCasus/Basisjaar/BereikbaarheidGroen/'+GroenPad+'/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';

				// --- bereikbaarheid van banen: de StartYear-kant van het exportzichtjaar, bewonersgewogen met de woningen van het basisjaar ---
				attribute<Job>       Bereikbaarheid_Banen_OV                                         := = IsNL ? 'union_data(Regio, ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_W_OV_W_StartYear_Per_NL)' : 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_W_OV_W_StartYear_Per_Regio';
				attribute<Job>       Bereikbaarheid_Banen_Fiets                                      := = IsNL ? 'union_data(Regio, ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_BB_StartYear_Per_NL)' : 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_BB_StartYear_Per_Regio';
				attribute<Job>       Bereikbaarheid_Banen_Auto                                       := = IsNL ? 'union_data(Regio, ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_CAR_StartYear_Per_NL)' : 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/PerIndicatorRegio/Banen_CAR_StartYear_Per_Regio';

				// --- overstromingsschade, nominaal; in het basisjaar is de contante waarde daaraan gelijk ---
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks               := sum(ThisCasus/Basisjaar/Overstromingsschade/Resultaat/Bron/Result_Hoofdwatersysteem_Binnendijks,     Cel_rel);
				attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Buitendijks               := sum(ThisCasus/Basisjaar/Overstromingsschade/Resultaat/Bron/Result_Hoofdwatersysteem_Buitendijks,     Cel_rel);
				attribute<Eur>       Overstromingsschade_Regionaalwatersysteem_Binnendijks           := sum(ThisCasus/Basisjaar/Overstromingsschade/Resultaat/Bron/Result_Regionaalwatersysteem_Binnendijks, Cel_rel);
			}
		}

		container PerIndeling_Basisjaar := BasisjaarIndicatoren_T(
			  /ModelParameters/Advanced/IndicatorRegio_path
			, FALSE
			, "'obv_BBG/PerRegios/'+Regio/name"
			, 'Basisjaar_Indicatoren_'+/ModelParameters/Advanced/IndicatorRegio_ref
		), Descr = "De basisjaartabel op de regio-indeling uit ModelParameters/Advanced/IndicatorRegio_ref, naast PerIndeling.";

		container PerNederland_Basisjaar := BasisjaarIndicatoren_T(
			  '/SourceData/RegioIndelingen/NL'
			, TRUE
			, "const('obv_BBG/PerRegios/Nationaal', Regio)"
			, 'Basisjaar_NationaleIndicatoren'
		), Descr = "De basisjaartabel landsdekkend, naast PerNederland.";


		// Claimrealisatie per allocatieregio, gevraagd vanuit Deltares bij de bespreking van de
		// productierun. Bewust een eigen tabel per schaalniveau en geen kolom in RegionaleIndicatoren:
		// de claim hoort per allocatieregio van de betreffende sector, en dat is een andere doorsnede
		// dan de indicatorenregio. Juist het verschil tussen de niveaus maakt overflow zichtbaar. Zit
		// een regio op NVM-niveau boven de 1 terwijl COROP eromheen op 1 uitkomt, dan is de claim
		// binnen die grotere regio verschoven en niet landelijk overschreden.
		// Alleen de indelingen waarop wonen wordt gealloceerd, plus het landelijke totaal. Werken
		// gebruikt dezelfde drie indelingen. Waterbergingsregio hoort er nadrukkelijk NIET bij: daar
		// wordt waterberging op geclaimd en niet wonen of werken, en de wonen- en werkenclaim bestaat
		// daar dus niet als bronbestand. Een for_each over alle Uq_AllocRegios liep daarop vast met
		// een GDAL-fout op een niet bestaande Wonen.csv.
		unit<uint8> ClaimNiveau := unique(
			ModelParameters/SectorAllocRegio/AllocRegio_name[ModelParameters/SectorAllocRegio/WonenAllocRegio/org_rel]
		);

		container ClaimRealisatie_PerNiveau :=
			for_each_ne(
				  ClaimNiveau/values
				, 'ClaimRealisatie_Niveau_T(' + quote(ClaimNiveau/values) + ')'
			)
		{
			container Nederland := ClaimRealisatie_Niveau_T('Nederland');
		}

		Template ClaimRealisatie_Niveau_T
		{
			parameter<String> Niveau_name;
			///
			container Bron := ='ThisCasus/Zichtjaren/' + ExportZichtjaar + '/ClaimRealisatie/Per_AllocRegio/' + Niveau_name;

			unit<uint32> Tabel := Bron/ClaimRegio
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'ClaimRealisatie_' + Niveau_name, '.tif', '.csv')"
			, StorageType = "gdalwrite.vect"
			, Descr = "Gerealiseerde stand gedeeld door de claim, per regio van deze indeling. Een waarde onder 1 betekent dat de claim niet is gehaald, boven 1 dat er meer is gealloceerd dan gevraagd."
			{
				attribute<String>  Regio_name              := Bron/ClaimRegio/name;
				// Leeg laten waar er geen claim is, in plaats van een ratio van nul te tonen. Een nul leest
				// als een meting en nodigt niet uit om de claimkolom ernaast te bekijken; een leeg veld wel.
				attribute<float32> Wonen_realisatie        := Bron/Impl/Claims/Aantal_Woningen_Totaal > 0[Woning] ? Bron/Claim_realisatie/Wonen/Totaal : null_f;
				attribute<float32> Werken_realisatie       := Bron/Impl/Claims/Banen_Totaal > 0[Job] ? Bron/Claim_realisatie/Werken/Totaal : null_f;
				attribute<Woning>  Wonen_claim             := Bron/Impl/Claims/Aantal_Woningen_Totaal;
				attribute<Woning>  Wonen_stand             := Bron/Impl/Stand_PerAllocRegio/Aantal_Woningen_Totaal;
				attribute<Job>     Werken_claim            := Bron/Impl/Claims/Banen_Totaal;
				attribute<Job>     Werken_stand            := Bron/Impl/Stand_PerAllocRegio/Banen_Totaal;
				// De stand van het basisjaar op dezelfde regio's (#828), zodat de groei tot het zichtjaar per regio uit deze tabel te lezen is.
				attribute<Woning>  Wonen_stand_Basisjaar   := sum(ThisCasus/Basisjaar/Stand/Aantal_Woningen_Totaal, Bron/ClaimRegio/Per_AdminDomain), Descr = "De woningen in het basisjaar op deze regio, uit dezelfde basisjaarstand als het vertrekpunt van de allocatie.";
				attribute<Job>     Werken_stand_Basisjaar  := sum(ThisCasus/Basisjaar/Stand/Aantal_Banen_Totaal,    Bron/ClaimRegio/Per_AdminDomain), Descr = "De banen in het basisjaar op deze regio.";
			}
		}

		container Claims_Reeks
		: Descr = "De ruimtevraag van het scenario als reeks (#828): de woningclaim per segment en de banenclaim voor elk zichtjaar, landelijk, met de stand van het basisjaar als eerste regel. De claims komen
					uit dezelfde items die de allocatie leest (Impl/Claims/AllocRegios/NL van elk zichtjaar) en hangen niet van de allocatie af, dus deze tabel leest alle zichtjaren zonder de ketens te raken; vanaf
					ModelParameters/Advanced/FromWhichDoWeKeepTIGRISconstant loopt de reeks vlak. Landbouw en waterberging staan er niet in: die claims zijn banden per provincie en opgaven per deelgebied, zie
					ClaimRealisatie_Landbouw en ClaimRealisatie_Veen."
		{
			unit<uint8> BasisjaarRij : NrOfRows = 1 { attribute<String> name : ['Basisjaar']; }
			unit<uint8> Jaar := union_unit_uint8(BasisjaarRij, /Classifications/Time/Zichtjaar)
			{
				attribute<String> name := union_data(., BasisjaarRij/name, /Classifications/Time/Zichtjaar/name);
			}

			container Waarden
			: Descr = "De kolommen, berekend buiten de schrijvende unit, om dezelfde reden als bij ClaimRealisatie_Landbouw."
			{
				parameter<String> ClaimsPerZichtjaar := 'union_data(/Classifications/Time/Zichtjaar, ' + AsList('sum(ThisCasus/Zichtjaren/' + /Classifications/Time/Zichtjaar/name + '/Impl/Claims/AllocRegios/NL/@S@)', ', ') + ')'
				, Descr = "De claim per zichtjaar als attribuut op Zichtjaar, met @S@ als plaatshouder voor het pad van de claim; eerst als parameter, want een string die over de zichtjaren loopt kan niet in dezelfde expressie ook over de segmenten lopen (domeinen).";
				container PerSegment :=
					for_each_nedv(
						  /Classifications/Vastgoed/WP2xVSSH/name
						, 'union_data(Jaar, sum(ThisCasus/Basisjaar/Stand/Aantal_Woningen_' + /Classifications/Vastgoed/WP2xVSSH/name + ', /SourceData/RegioIndelingen/NL/Per_AdminDomain), ' + replace(ClaimsPerZichtjaar, '@S@', 'Wonen/' + /Classifications/Vastgoed/WP2xVSSH/name) + ')'
						, Jaar
						, Woning
					), Descr = "Per woningsegment: de basisjaarstand op de eerste regel en daarna de claim per zichtjaar. De basisjaarstand telt over de NL-claimregio (RegioIndelingen/NL/Per_AdminDomain), dezelfde cellen als Wonen_stand_Basisjaar in ClaimRealisatie_Nederland.";
				attribute<Woning> Wonen_Totaal  (Jaar) := ='add(' + AsItemList('PerSegment/' + /Classifications/Vastgoed/WP2xVSSH/name) + ')';
				attribute<Job>    Werken_Totaal (Jaar) := ='union_data(Jaar, sum(ThisCasus/Basisjaar/Stand/Aantal_Banen_Totaal, /SourceData/RegioIndelingen/NL/Per_AdminDomain), ' + replace(ClaimsPerZichtjaar, '@S@', 'Werken/Totaal') + ')';
			}

			unit<uint8> Tabel := Jaar
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Claims_Reeks', '.tif', '.csv')"
			, StorageType = "gdalwrite.vect"
			, Descr = "Een regel per jaar: eerst de stand van het basisjaar, daarna de claim per zichtjaar; de kolom Soort zegt welke van de twee een regel is."
			{
				attribute<String> Jaar_name                    := Jaar/name;
				attribute<String> Soort                        := union_data(Jaar, const('stand', BasisjaarRij), const('claim', /Classifications/Time/Zichtjaar));
				attribute<Woning> Wonen_eengezins_VrijeSector  := Waarden/PerSegment/eengezins_VrijeSector;
				attribute<Woning> Wonen_eengezins_SocialeHuur  := Waarden/PerSegment/eengezins_SocialeHuur;
				attribute<Woning> Wonen_meergezins_VrijeSector := Waarden/PerSegment/meergezins_VrijeSector;
				attribute<Woning> Wonen_meergezins_SocialeHuur := Waarden/PerSegment/meergezins_SocialeHuur;
				attribute<Woning> Wonen_Totaal                 := Waarden/Wonen_Totaal;
				attribute<Job>    Werken_Totaal                := Waarden/Werken_Totaal;
			}
		}


		container ClaimRealisatie_Landbouw
		: Descr = "De claimrealisatie van de landbouw, per provincie en per gewasklasse. Een eigen container, want de claimrealisatie van wonen en werken loopt via ClaimRealisatie/Claim_realisatie en daar komt
					landbouw niet in voor: Classifications/Actor/LandbouwK draagt HasClaims op FALSE terwijl HasAlloc op TRUE staat, zodat landbouw buiten StandVar/Claims_sub en dus buiten Impl/Claims,
					Impl/MinClaims en Impl/MaxClaims valt; die vlag omzetten zou Claims_sub in het hele model verbreden. Deze container leest de landbouwclaims daarom rechtstreeks bij hun bron,
					Impl/Claims/AllocRegios/Provincie/Landbouw, en de gerealiseerde hectares uit de standtelling per allocatieregio. Twee verhoudingen, want landbouw krijgt geen doel maar een band, een
					ondergrens en een bovengrens per klasse per regio (ModelParameters/Landbouw/claims_conservatief): boven 1 tegen de minclaim en onder 1 tegen de maxclaim zit de klasse binnen haar band, en
					alleen onder 1 tegen de minclaim of boven 1 tegen de maxclaim is een overschrijding. Lang en niet breed: een regel per provincie per klasse met vijf kolommen, want dit is een
					controle-uitdraai en geen indicatorentabel die naast een andere run gelegd moet worden."
		{
			unit<uint8> Klasse := /Classifications/Actor/LandbouwKlasses/Actief
			, Descr = "De klassen die als subsector meedoen, dus zonder de exotische gewassen zolang ExotenActief uit staat. Volgt daarmee vanzelf wat er werkelijk gealloceerd wordt.";

			container Bron      := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/ClaimRealisatie/Per_AllocRegio/Provincie';
			container Claimbron := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Impl/Claims/AllocRegios/Provincie/Landbouw';

			container Waarden
			: Descr = "De kolommen, berekend buiten de schrijvende unit. Dat is geen opsmuk: met de kolommen rechtstreeks op de tabel start de CSV-schrijver tijdens het berekenen van de eerste kolom, en GeoDMS weigert dan een geneste ValidationAndCommit met de melding 'check for recursive dependencies'. Die melding wijst naar een kringverwijzing die er niet is. Rekenen en schrijven gescheiden houden lost het op."
			{
				unit<uint32> Domein := ='union_unit('+AsList(const('Bron/ClaimRegio', Klasse), ',')+')'
				, Descr = "Een blok per klasse, en binnen een blok een regel per provincie. Expliciet een unie en geen combine, want bij een unie ligt de volgorde van de blokken vast en hoeft de lezer niet te weten welke as het snelst loopt.";

				attribute<String>  Regio_name  (Domein) := ='union_data(Domein, '+AsList(const('Bron/ClaimRegio/name', Klasse), ',')+')';
				attribute<String>  Klasse_name (Domein) := ='union_data(Domein, '+AsList('const('+quote(Klasse/name)+', Bron/ClaimRegio)', ',')+')';
				attribute<Ha>      Stand_ha    (Domein) := ='union_data(Domein, '+AsList('Bron/Impl/Stand_PerAllocRegio/Aantal_Ha_'+Klasse/name, ',')+')'
				, Descr = "Het gerealiseerde areaal van deze klasse in deze provincie, uit de standtelling per allocatieregio.";
				attribute<Ha>      MinClaim_ha (Domein) := ='union_data(Domein, '+AsList('Claimbron/MinClaims/'+Klasse/name, ',')+')';
				attribute<Ha>      MaxClaim_ha (Domein) := ='union_data(Domein, '+AsList('Claimbron/MaxClaims/'+Klasse/name, ',')+')';

				// Leeg laten waar de grens nul is, zoals bij de wonen- en werkenkolommen: een nul leest als een meting
				// en nodigt niet uit om de claimkolom ernaast te bekijken.
				attribute<float32> Realisatie_tov_MinClaim (Domein) := MinClaim_ha > 0[Ha] ? Stand_ha / MinClaim_ha : null_f;
				attribute<float32> Realisatie_tov_MaxClaim (Domein) := MaxClaim_ha > 0[Ha] ? Stand_ha / MaxClaim_ha : null_f;
			}

			unit<uint32> Tabel := Waarden/Domein
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'ClaimRealisatie_Landbouw', '.tif', '.csv')"
			, StorageType = "gdalwrite.vect"
			, Descr = "De uitdraai zelf: een dunne schil om Waarden, zodat de schrijver niets meer hoeft te berekenen."
			{
				attribute<String>  Regio_name              := Waarden/Regio_name;
				attribute<String>  Klasse_name             := Waarden/Klasse_name;
				attribute<Ha>      Stand_ha                := Waarden/Stand_ha;
				attribute<Ha>      MinClaim_ha             := Waarden/MinClaim_ha;
				attribute<Ha>      MaxClaim_ha             := Waarden/MaxClaim_ha;
				attribute<float32> Realisatie_tov_MinClaim := Waarden/Realisatie_tov_MinClaim;
				attribute<float32> Realisatie_tov_MaxClaim := Waarden/Realisatie_tov_MaxClaim;
			}
		}
		container ClaimRealisatie_Veen
		: Descr = "De claimrealisatie van de waterbergingsopgave in het veen, gevraagd in #797. Los van ClaimRealisatie_PerNiveau hierboven, want dat kent alleen de indelingen waarop wonen wordt gealloceerd en
					de wonen- en werkenclaim bestaat niet op de waterbergingsregio's; deze container leest alleen de waterbergingskolom. Twee tabellen: per deelgebied komen de opgave en de gerealiseerde berging
					rechtstreeks uit ClaimRealisatie/Per_AllocRegio/Waterbergingsregio, en het landelijke getal is de som over die deelgebieden en niet de NL-instantie van de claim, want de aangeleverde reeks
					van #575 staat per deelgebied en koppelt op naam. De eenheid is kubieke meter bergingsopgave, zie Templates/Claims/ZichtjaarXScenarioxAllocRegios/Waterberging. In een variant met
					VariantK/WaterbergingClaimActief op FALSE staat de opgave op nul en blijft de realisatiekolom leeg (#664)."
		{
			container Bron := ='ThisCasus/Zichtjaren/' + ExportZichtjaar + '/ClaimRealisatie/Per_AllocRegio/Waterbergingsregio';

			unit<uint32> Tabel := Bron/ClaimRegio
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'ClaimRealisatie_WaterbergingVeen', '.tif', '.csv')"
			, StorageType = "gdalwrite.vect"
			, Descr = "Per waterbergingsdeelgebied de opgave, de gerealiseerde berging en hun verhouding."
			{
				attribute<String>  Regio_name              := Bron/ClaimRegio/name;
				attribute<Meter3>  Waterberging_claim      := Bron/Impl/Claims/meter3_Waterberging;
				attribute<Meter3>  Waterberging_stand      := Bron/Impl/Stand_PerAllocRegio/meter3_Waterberging;
				// Leeg laten waar er geen opgave is, om dezelfde reden als bij de wonen- en werkenkolommen
				// hierboven: een nul leest als een meting en nodigt niet uit om de claimkolom te bekijken.
				attribute<float32> Waterberging_realisatie := Bron/Impl/Claims/meter3_Waterberging > 0[Meter3] ? Bron/Impl/Stand_PerAllocRegio/meter3_Waterberging / Bron/Impl/Claims/meter3_Waterberging : null_f;
			}

			unit<uint32> Tabel_NL := /SourceData/RegioIndelingen/NL
			, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'ClaimRealisatie_WaterbergingVeen_NL', '.tif', '.csv')"
			, StorageType = "gdalwrite.vect"
			, Descr = "Hetzelfde landsdekkend: de som over de deelgebieden, zodat de landelijke realisatie in een getal staat."
			{
				attribute<String>  Regio_name              := /SourceData/RegioIndelingen/NL/name;
				attribute<Meter3>  Waterberging_claim      := union_data(Tabel_NL, sum(Bron/Impl/Claims/meter3_Waterberging));
				attribute<Meter3>  Waterberging_stand      := union_data(Tabel_NL, sum(Bron/Impl/Stand_PerAllocRegio/meter3_Waterberging));
				attribute<float32> Waterberging_realisatie := union_data(Tabel_NL, sum(Bron/Impl/Claims/meter3_Waterberging) > 0[Meter3] ? sum(Bron/Impl/Stand_PerAllocRegio/meter3_Waterberging) / sum(Bron/Impl/Claims/meter3_Waterberging) : null_f);
			}
		}
	}


	container Legendas: Descr = "De klassenamen bij de kaarten die een classificatie als waardenunit hebben. Een GeoTIFF draagt alleen het getal, dus zonder deze tabellen is een klassekaart bij de ontvanger niet te lezen;
				MaakOplevering.ps1 zet ze als <bestandsnaam>_meta.txt naast de kaart waar ze bij horen. Buiten Generate_Indicatoren: de inhoud hangt alleen van de classificaties af en niet van een casus of
				een zichtjaar, dus eenmaal per levering trekken volstaat, en een fout hierin mag een indicatorenrun niet omver halen."
	{

		container LU_NL2120_Relaties
		: Descr = "De relaties van elke klasse van LU_NL2120 naar de classificaties waaruit zij is opgebouwd, als hulpitems voor LU_NL2120_Legenda hieronder. Apart van de exporteenheid, want een kolom van een gdalwrite-eenheid mag niet naar een zuster in dezelfde eenheid verwijzen (Cannot start ValidationAndCommit while doing ValidationAndCommit)."
		{
			unit<uint8> LU := /Classifications/Grondgebruik/LU_NL2120;

			attribute</Classifications/Grondgebruik/LU_Hoofdklasse>     Hoofdklasse_rel      (LU) := /Classifications/Grondgebruik/LU_NL2120/Hoofdklasse_rel;
			attribute</Classifications/Grondgebruik/SectorVerhardingK>  SectorVerharding_rel (LU) := /Classifications/Grondgebruik/LU_NL2120/SectorVerhardingK_rel;
			attribute</Classifications/Grondgebruik/LandgebruikType>    LandgebruikType_rel  (LU) := /Classifications/Grondgebruik/LU_NL2120/LandgebruikType_rel;
			attribute</Classifications/Grondgebruik/INL_Beheertype>     Beheertype_rel       (LU) := /Classifications/Grondgebruik/LandgebruikType/INL_Beheertype_rel[LandgebruikType_rel];
			attribute</Classifications/Grondgebruik/NatuurType>         Natuurtype_rel       (LU) := IsDefined(Beheertype_rel)
				? /Classifications/Grondgebruik/INL_Beheertype/NatuurType_rel[Beheertype_rel]
				: rlookup(substr(/Classifications/Grondgebruik/LU_Hoofdklasse/name[Hoofdklasse_rel], 0, 3), /Classifications/Grondgebruik/NatuurType/code)
			, Descr = "De natuurhoofdgroep: van het beheertype zelf, en voor de LGN-natuurklassen zonder beheertype van de hoofdklasse waar de kaart ze onder toont. Leeg buiten de natuur.";
			attribute</Classifications/Grondgebruik/LandbouwType>       Landbouwtype_rel     (LU) := /Classifications/Grondgebruik/LandgebruikType/LandbouwType_afgeleid[LandgebruikType_rel]
			, Descr = "Het landbouwtype, ook voor de LGN-klassen die er een dragen (LandgebruikType/LandbouwType_afgeleid).";
			attribute</Classifications/Grondgebruik/LGNKlasse>          LGN_rel              (LU) := /Classifications/Grondgebruik/LandgebruikType/LGNKlasse_rel[LandgebruikType_rel]
			, Descr = "De LGN-klasse van het derde deel, alleen voor de rijen die zelf een LGN-klasse zijn.";
			attribute</Classifications/Grondgebruik/LGNKlasse>          LGN_proxy_rel        (LU) := /Classifications/Grondgebruik/LandgebruikType/LGNKlasse_proxy[LandgebruikType_rel]
			, Descr = "De best passende LGN-klasse van elk landgebruikstype, waarlangs de koolstofklasse en de groenindexband op het type komen (LandgebruikType/LGNKlasse_proxy).";
		}

		unit<uint8>  LU_NL2120_Legenda := /Classifications/Grondgebruik/LU_NL2120
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/LU_NL2120.csv'", StorageType = "gdalwrite.vect"
		, Descr = "De legenda van LandgebruikskaartNL2120 met de classificaties waaruit elke klasse is opgebouwd. Gevraagd door team natuur en team landbouw na het resultatenrapport 1.0: naast id, name en label de kleur, de hoofdklasse van de 43-klassenkaart met naam en label, de sector en verhardingsklasse van het eerste deel, het landgebruikstype met zijn deel, het natuurbeheertype met code, naam en natuurtype (hoofdgroep), de tweedeling nat en droog, het landbouwtype, de LGN-klasse en de LGN-proxy (de LGN-klasse die elk type in het model vertegenwoordigt, voor koolstof en groenindex). Een lege cel betekent dat die relatie voor de klasse niet bestaat; de LGN-natuurklassen zonder beheertype krijgen hun natuurtype en nat of droog via de hoofdklasse. De relaties zelf staan in LU_NL2120_Relaties."
		{
			attribute<uint32> id    := uint32(id(.));
			attribute<String> name  := /Classifications/Grondgebruik/LU_NL2120/name;
			attribute<String> label := /Classifications/Grondgebruik/LU_NL2120/Label;
			attribute<uint32> r     := /Classifications/Grondgebruik/LU_NL2120/BrushColor % 256;
			attribute<uint32> g     := (/Classifications/Grondgebruik/LU_NL2120/BrushColor / 256) % 256;
			attribute<uint32> b     := (/Classifications/Grondgebruik/LU_NL2120/BrushColor / 65536) % 256;

			attribute<uint32> Hoofdklasse_id    := uint32(LU_NL2120_Relaties/Hoofdklasse_rel);
			attribute<String> Hoofdklasse_name  := /Classifications/Grondgebruik/LU_Hoofdklasse/name[LU_NL2120_Relaties/Hoofdklasse_rel];
			attribute<String> Hoofdklasse_label := /Classifications/Grondgebruik/LU_Hoofdklasse/Label[LU_NL2120_Relaties/Hoofdklasse_rel];

			attribute<String> Sector_name       := MakeDefined(/Classifications/Grondgebruik/SectorVerhardingK/Sector_name[LU_NL2120_Relaties/SectorVerharding_rel], '');
			attribute<String> Verharding_name   := MakeDefined(/Classifications/Grondgebruik/VerhardingK/name[/Classifications/Grondgebruik/SectorVerhardingK/Verharding_rel[LU_NL2120_Relaties/SectorVerharding_rel]], '');
			attribute<String> Verharding_label  := MakeDefined(/Classifications/Grondgebruik/VerhardingK/Label[/Classifications/Grondgebruik/SectorVerhardingK/Verharding_rel[LU_NL2120_Relaties/SectorVerharding_rel]], '');

			attribute<uint32> LandgebruikType_id    := uint32(LU_NL2120_Relaties/LandgebruikType_rel);
			attribute<String> LandgebruikType_name  := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/name[LU_NL2120_Relaties/LandgebruikType_rel], '');
			attribute<String> LandgebruikType_deel  := MakeDefined(/Classifications/Grondgebruik/LandgebruikType/Deel/name[/Classifications/Grondgebruik/LandgebruikType/Deel_rel[LU_NL2120_Relaties/LandgebruikType_rel]], '');

			attribute<uint32> Beheertype_id      := uint32(LU_NL2120_Relaties/Beheertype_rel);
			attribute<String> Beheertype_code    := MakeDefined(/Classifications/Grondgebruik/INL_Beheertype/code[LU_NL2120_Relaties/Beheertype_rel], '');
			attribute<String> Beheertype_naam    := MakeDefined(/Classifications/Grondgebruik/INL_Beheertype/naam[LU_NL2120_Relaties/Beheertype_rel], '');
			attribute<String> Beheertype_label   := MakeDefined(/Classifications/Grondgebruik/INL_Beheertype/Label[LU_NL2120_Relaties/Beheertype_rel], '');

			attribute<String> Natuurtype_code  := MakeDefined(/Classifications/Grondgebruik/NatuurType/code[LU_NL2120_Relaties/Natuurtype_rel], '');
			attribute<String> Natuurtype_name  := MakeDefined(/Classifications/Grondgebruik/NatuurType/name[LU_NL2120_Relaties/Natuurtype_rel], '');
			attribute<String> Natuurtype_label := MakeDefined(/Classifications/Grondgebruik/NatuurType/Label[LU_NL2120_Relaties/Natuurtype_rel], '');
			attribute<String> Nat_of_droog     := /Classifications/Grondgebruik/LU_NL2120/NatDroog
			, Descr = "Nat of droog volgens de tweedeling uit het resultatenrapport 1.0 (LU_NL2120/IsNat en IsDroog, op beheertype of anders op de hoofdgroep); leeg buiten de natuur en voor N00. Dezelfde kolom als waarop Grondgebruik/LandgebruikNatDroog_Areaal telt (#828).";

			attribute<uint32> Landbouwtype_id    := uint32(LU_NL2120_Relaties/Landbouwtype_rel);
			attribute<String> Landbouwtype_name  := MakeDefined(/Classifications/Grondgebruik/LandbouwType/name[LU_NL2120_Relaties/Landbouwtype_rel], '');
			attribute<String> Landbouwtype_label := MakeDefined(/Classifications/Grondgebruik/LandbouwType/Label[LU_NL2120_Relaties/Landbouwtype_rel], '');

			attribute<String> BRP_jaargang    := const(/ModelParameters/BRP_Year, .), Descr = "Het jaar van de Basisregistratie Gewaspercelen waarop de landbouwtypen rusten; een andere jaargang kan andere gewascodes hebben.";
			attribute<String> LGN_jaargang    := const(/ModelParameters/LGN_Year, .), Descr = "De jaargang van het Landelijk Grondgebruiksbestand waarop de LGN-klassen en de LGN-proxy rusten; een andere jaargang kan een andere klassenindeling hebben.";
			attribute<uint16> LGN_code        := /Classifications/Grondgebruik/LGNKlasse/code[LU_NL2120_Relaties/LGN_rel];
			attribute<String> LGN_naam        := MakeDefined(/Classifications/Grondgebruik/LGNKlasse/naam[LU_NL2120_Relaties/LGN_rel], '');
			attribute<String> LGN_label       := MakeDefined(/Classifications/Grondgebruik/LGNKlasse/Label[LU_NL2120_Relaties/LGN_rel], '');
			attribute<uint16> LGN_proxy_code  := /Classifications/Grondgebruik/LGNKlasse/code[LU_NL2120_Relaties/LGN_proxy_rel];
			attribute<String> LGN_proxy_naam  := MakeDefined(/Classifications/Grondgebruik/LGNKlasse/naam[LU_NL2120_Relaties/LGN_proxy_rel], '');
			attribute<String> LGN_proxy_label := MakeDefined(/Classifications/Grondgebruik/LGNKlasse/Label[LU_NL2120_Relaties/LGN_proxy_rel], '');
		}
		unit<uint16> BRPGewasType_Legenda := /Classifications/Landbouw/BRPGewasType
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/BRPGewasType.csv'", StorageType = "gdalwrite.vect"
		, Descr = "De koppeltabel van de BRP-gewascodes naar de vijftien landbouwtypen van de landgebruikskaart, met de gewasnaam zoals de BRP hem levert (Classifications/Landbouw/BRPGewasType). Gevraagd door team landbouw bij de legenda van LandgebruikskaartNL2120: de landbouwtypen zijn RS-klassen en geen BRP-labels, en deze tabel zegt welke gewassen in elk type vallen. Een lege Landbouwtype-kolom betekent dat het model het gewas niet als landbouw meeneemt."
		{
			attribute<uint32> id                 := uint32(id(.));
			attribute<String> BRP_jaargang       := const(/ModelParameters/BRP_Year, .);
			attribute<Int32>  gewascode          := /Classifications/Landbouw/BRPGewasType/code;
			attribute<String> gewas              := /Classifications/Landbouw/BRPGewasType/gewas;
			attribute<uint32> Landbouwtype_id    := uint32(/Classifications/Landbouw/BRPGewasType/LandbouwType_rel);
			attribute<String> Landbouwtype_name  := MakeDefined(/Classifications/Grondgebruik/LandbouwType/name[/Classifications/Landbouw/BRPGewasType/LandbouwType_rel], '');
			attribute<String> Landbouwtype_label := MakeDefined(/Classifications/Grondgebruik/LandbouwType/Label[/Classifications/Landbouw/BRPGewasType/LandbouwType_rel], '');
			attribute<String> Allocatieklasse    := /Classifications/Landbouw/BRPGewasType/LandbouwK, Descr = "De gewasklasse van de landbouwallocatie (Actor/LandbouwKlasses) waar de code op valt; leeg voor de codes die de allocatie niet kent.";
		}
		unit<uint8>  LU_Hoofdklasse_Legenda := /Classifications/Grondgebruik/LU_Hoofdklasse
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/LU_Hoofdklasse.csv'", StorageType = "gdalwrite.vect"
		, Descr = "De legenda bij de kaart in hoofdklassen en bij de arealentabellen die op die indeling staan (#783). Zonder deze tabel draagt de tif alleen het klassenummer."
		{
			attribute<uint32> id    := uint32(id(.));
			attribute<String> label := /Classifications/Grondgebruik/LU_Hoofdklasse/Label;
		}
		unit<uint8>  INL_Beheertype_Legenda := /Classifications/Grondgebruik/INL_Beheertype
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/INL_Beheertype.csv'", StorageType = "gdalwrite.vect"
		, Descr = "De legenda bij BT_Exogeen en bij de arealentabel per beheertype, met de code, het natuurtype (hoofdgroep), de tweedeling nat en droog en de kleur; dezelfde kolommen als de natuurrijen van LU_NL2120_Legenda."
		{
			attribute<uint32> id               := uint32(id(.));
			attribute<String> name             := AsItemName(/Classifications/Grondgebruik/INL_Beheertype/code), Descr = "De itemnaam op de code, zoals INL_Beheertype/V_obvCode en de natuurrijen van LU_NL2120 (daar met Natuur_ ervoor).";
			attribute<String> label            := /Classifications/Grondgebruik/INL_Beheertype/Label;
			attribute<String> code             := /Classifications/Grondgebruik/INL_Beheertype/code;
			attribute<String> naam             := /Classifications/Grondgebruik/INL_Beheertype/naam;
			attribute<uint32> r                := /Classifications/Grondgebruik/INL_Beheertype/r;
			attribute<uint32> g                := /Classifications/Grondgebruik/INL_Beheertype/g;
			attribute<uint32> b                := /Classifications/Grondgebruik/INL_Beheertype/b;
			attribute<String> Natuurtype_code  := /Classifications/Grondgebruik/NatuurType/code[/Classifications/Grondgebruik/INL_Beheertype/NatuurType_rel];
			attribute<String> Natuurtype_name  := /Classifications/Grondgebruik/NatuurType/name[/Classifications/Grondgebruik/INL_Beheertype/NatuurType_rel];
			attribute<String> Natuurtype_label := /Classifications/Grondgebruik/NatuurType/Label[/Classifications/Grondgebruik/INL_Beheertype/NatuurType_rel];
			attribute<String> Nat_of_droog     := /Classifications/Grondgebruik/INL_Beheertype/NatDroog;
			attribute<String> LHMType          := /Classifications/Grondgebruik/INL_Beheertype/LHMType_name;
			attribute<Bool>   IsWater          := /Classifications/Grondgebruik/INL_Beheertype/IsWater;
		}
		unit<uint8>  ABCD_subK_Legenda := /SourceData/Grondgebruik/ABCD/ABCD_subK
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/ABCD_subK.csv'", StorageType = "gdalwrite.vect"
		{
			attribute<uint32> id    := uint32(id(.));
			attribute<String> label := /SourceData/Grondgebruik/ABCD/ABCD_subK/name;
		}
		unit<uint32> BouwwijzeK_Legenda := /Classifications/Modellering/BouwwijzeK
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/BouwwijzeK.csv'", StorageType = "gdalwrite.vect"
		{
			attribute<uint32> id    := uint32(id(.));
			attribute<String> label := /Classifications/Modellering/BouwwijzeK/name;
		}
		unit<uint8>  InrichtingsalternatiefK_Legenda := /Classifications/Modellering/InrichtingsalternatiefK
		, StorageName = "='%LocalDataProjDir%/Indicatoren/Legendas/InrichtingsalternatiefK.csv'", StorageType = "gdalwrite.vect"
		{
			attribute<uint32> id    := uint32(id(.));
			attribute<String> label := /Classifications/Modellering/InrichtingsalternatiefK/name;
		}
		parameter<String> Schrijf := 'Ready'
		, ExplicitSuppliers = "LU_NL2120_Legenda;BRPGewasType_Legenda;LU_Hoofdklasse_Legenda;INL_Beheertype_Legenda;ABCD_subK_Legenda;BouwwijzeK_Legenda;InrichtingsalternatiefK_Legenda"
		, Descr = "Trekt alle legenda's in een aanroep.";
	}
}
