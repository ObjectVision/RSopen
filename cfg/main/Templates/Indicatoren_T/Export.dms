				+ ';Overstromingsschade_Hoofdwatersysteem_Buitendijks_NCW'
				+ ';Overstromingsschade_Regionaalwatersysteem_Binnendijks_NCW'
				+ ';BT_Exogeen'
				+ ';BT_Exogeen_Areaal'
				+ ';NieuweNatuur'
				+ ';VerdwenenNatuur'
				+ ';BereikbaarheidGroen_BBG'
				+ ';BereikbaarheidGroen_Fractie'
				+ ';WaardeNabijheidGroen_Woningen'
				+ ';WaardeNabijheidGroen_BestaandeWoningen'
				+ ';WaardeNabijheidGroen_NieuwbouwWoningen'
				+ ';WaardeNabijheidGroen_Woningen_NCW'
				+ ';WaardeNabijheidGroen_BestaandeWoningen_NCW'
				+ ';WaardeNabijheidGroen_NieuwbouwWoningen_NCW'
