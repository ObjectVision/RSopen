// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Impl, Transitie_Matrix, mean_NPV_obv_LUbasisjaar_perLBK,
// mean_NPV_obv_LU_Zichtjaar_perLBK_zonderAugm.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Export : using = "Classifications/Actor;SourceData"
{
	parameter<String> ExportZichtjaar := =quote(replace_value(expand(., '%env:ExportZichtjaar%'), 'env:ExportZichtjaar', last(/Classifications/Time/Zichtjaar/name)))
	, Descr = "Welk zichtjaar de indicatorenexport wegschrijft. Standaard het laatste zichtjaar; via de omgevingsvariabele ExportZichtjaar is een eerder zichtjaar of Basisjaar te kiezen, zodat daar geen configuratiewijziging meer voor nodig is.";
	
	container generates
	{	
		parameter<string> CarbonStorageSequestration           := 'Ready', explicitsuppliers = "=AsList(Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Stock_Zichtjaar;'+Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Flow_Zichtjaar;'+Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar;'+Classifications/Time/Zichtjaar/name+'/CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief', ';')"
		, Descr = "Trekt alle vier de koolstofkaarten voor alle zichtjaren. De vierde, Write_CO2Ongedekt_Cumulatief, is er sinds #733 bij gekomen en hoort altijd samen met Write_CO2Flow_TovBasisjaar getrokken te worden: zonder die kaart is niet te zien hoeveel SOMERS-uitstoot buiten het saldo is gebleven. Hier stond een verwijzing naar Write_Result_SA, en dat item bestaat niet onder CarbonStorageSequestration; de drie heten Write_CO2Stock_Zichtjaar, Write_CO2Flow_Zichtjaar en Write_CO2Flow_TovBasisjaar. Deze trigger deed daardoor niets, en omdat Generate_Indicatoren alleen de laatste van de drie noemt bleven de bestanden van de eerste twee staan zoals een eerdere run ze had achtergelaten.";
		parameter<string> SOMERS_CO2_laagveen_Emissies_Mediaan := 'Ready', explicitsuppliers = "=AsList(Classifications/Time/Zichtjaar/name+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA', ';')";
	}

	container Impl
	{
		attribute<Ha>   Basisjaar_Areaal_perLUMT       (LU_ModelType) := pcount(ThisCasus/Basisjaar/Landgebruikskaart/Result_SA)[float32] * rdc_25m/NrHaPerCell; 
		attribute<Ha>   Zichtjaar_Areaal_perLUMT       (LU_ModelType) := ='pcount(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA)[float32] * rdc_25m/NrHaPerCell'; 
		
		parameter<Ha>   Basisjaar_Areaal_Landbouw                     := sum(LU_ModelType/IsLandbouw ? Basisjaar_Areaal_perLUMT : 0[Ha]);
		parameter<Ha>   Zichtjaar_Areaal_Landbouw                     := sum(LU_ModelType/IsLandbouw ? Zichtjaar_Areaal_perLUMT : 0[Ha]);
		
		container Basisjaar_NettoOpbrengsten_perLUMT :=
			for_each_nedv(
				LU_ModelType/Label
				, LU_ModelType/IsLandbouw 
						? 'ThisCasus/Basisjaar/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/Label+'
							? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_ModelType/'+LU_ModelType/Subsector_name+'/NetRevenue * 1[jaar]
							: 0[Eur_m2]'
						: 'const(0[Eur_m2], rdc_25m)'
				, rdc_25m
				, Eur_m2
			)
		{
			attribute<Eur_m2> Totaal_Landbouw (rdc_25m) := ='add('+asItemList(LU_ModelType/Label)+')';
			parameter<Eur_ha> Gemiddeld_perHa           := sum(Totaal_Landbouw) / sum(LU_ModelType/IsLandbouw[ThisCasus/Basisjaar/Landgebruikskaart/Result_SA][float32]) / rdc_25m/NrHaPerCell * 1[meter2];
			parameter<Eur>    Totaal_Studiegebied       := sum(value(LU_ModelType/IsLandbouw[ThisCasus/Basisjaar/Landgebruikskaart/Result_SA],Ha)[meter2] * Totaal_Landbouw);
		}
		
		container Zichtjaar_NettoOpbrengsten_perLUMT :=
			for_each_nedv(
				LU_ModelType/Label
				, LU_ModelType/IsLandbouw 
						? 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/Label+'
							? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_ModelType/'+LU_ModelType/Subsector_name+'/NetRevenue * 1[jaar]
							: 0[Eur_m2]'
						: 'const(0[Eur_m2], rdc_25m)'
				, rdc_25m
				, Eur_m2
			)
		{
			attribute<Eur_m2> Totaal_Landbouw (rdc_25m) := ='add('+asItemList(LU_ModelType/Label)+')';
			parameter<Eur_ha> Gemiddeld_perHa           := ='sum(Totaal_Landbouw) / sum(LU_ModelType/IsLandbouw[ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA][float32]) / rdc_25m/NrHaPerCell * 1[meter2]';
			parameter<Eur>    Totaal_Studiegebied       := ='sum(value(LU_ModelType/IsLandbouw[ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA],Ha)[meter2] * Totaal_Landbouw)';
		}
		
		//transitie matrix
		unit<UInt32> LU_ModelType_Transities := combine(Actor/LU_ModelType, Actor/LU_ModelType)
		{
			attribute<UInt32> from_TransCode := uint32(first_rel) + 1;
			attribute<String> from_name      := Actor/LU_ModelType/nameshort[first_rel];
			attribute<UInt32> to_TransCode   := (uint32(second_rel) + 1) * 100;
			attribute<String> to_name        := Actor/LU_ModelType/nameshort[second_rel];
			attribute<UInt32> TransCode      := from_TransCode + to_TransCode;
			attribute<String> Label          := from_name + '_' + to_name;
			
			attribute<UInt32> count          := pcount(LU_Mutatie)[uint32];
		}
		
		// unit<uint32> Transitie_Matrix_Array := Actor/LU_ModelType
		// {
			// attribute<string> from_name           := Actor/LU_ModelType/nameshort;
			// attribute<string> count_list          := AsList(string(LU_ModelType_Transities/count), ';', LU_ModelType_Transities/first_rel);
		// }
		
		// unit<uint32> Transitie_Header : nrofrows = 1
		// {
			// attribute<string> to_name          := AsList(Actor/LU_ModelType/nameshort, ';', const(0[.],Actor/LU_ModelType));
		// }
		
		// unit<uint32> Transitie_Matrix_met_header := union_unit(Transitie_Header, Transitie_Matrix_Array) 
		// {
			// attribute<string> from_name          := union_data(., const('',Transitie_Header), Transitie_Matrix_Array/from_name);
			// attribute<string> values             := union_data(., Transitie_Header/to_name, Transitie_Matrix_Array/count_list);
		// }
		
		
		attribute<uint32> LU_Basisjaar (rdc_25m) := uint32(ThisCasus/Zichtjaren/basisjaar/Landgebruikskaart/Result_SA) + 1;
		attribute<uint32> LU_Zichtjaar (rdc_25m) := ='(uint32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA) + 1)  * 100';
		attribute<LU_ModelType_Transities> LU_Mutatie   (rdc_25m) := rlookup(LU_Basisjaar + LU_Zichtjaar, LU_ModelType_Transities/TransCode);
		
		container Basisjaar_NPV_perLUMT :=
			for_each_nedv(
				LU_ModelType/Label
				, LU_ModelType/IsLandbouw 
						? 'ThisCasus/Zichtjaren/Basisjaar/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/Label+'
							? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_ModelType/'+LU_ModelType/Subsector_name+'/NPV 
							: 0[Eur_m2]'
						: 'const(0[Eur_m2], rdc_25m)'
				, rdc_25m
				, Eur_m2
			);
		
		container Zichtjaren := for_each_ne(/Classifications/Time/Zichtjaar/name, 'ZichtjaarT('+string(id(/Classifications/Time/Zichtjaar))+'[/Classifications/Time/Zichtjaar])');
		
		Template ZichtjaarT
		{
			//
			parameter</Classifications/Time/Zichtjaar> id;
			//
			
			parameter<String> Zichtjaar_name := /Classifications/Time/Zichtjaar/name[id];
			
			container NPV_perLUMT :=
				for_each_nedv(
					LU_ModelType/Label
					, LU_ModelType/IsLandbouw 
							? 'ThisCasus/Zichtjaren/'+Zichtjaar_name+'/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/Label+'
								? ThisVariantData/Suitability/'+Zichtjaar_name+'/Landbouw/per_ModelType/'+LU_ModelType/Subsector_name+'/NPV
								: 0[Eur_m2]'
							: 'const(0[Eur_m2], rdc_25m)'
					, rdc_25m
					, Eur_m2
				)
			{
				attribute<Eur> Totaal (rdc_25m) := ='merge(ThisCasus/Zichtjaren/'+Zichtjaar_name+'/Landgebruikskaart/Result_SA, Eur, '+AsItemList(LU_ModelType/label+'[Eur_ha] * rdc_25m/NrHaPerCell')+')', 
				// StorageName = "='%LocalDataProjDir%/Indicatoren/NPV/'+Casus_name +'/'+BoerVariant_name+'/'+BeregeningScenario_name+'/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
				StorageName = "='%LocalDataProjDir%/Indicatoren/NPV/'+Casus_name +'/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
			}
			
			// container Zichtjaar_NPV_Augmented_perLUMT :=
				// for_each_nedvat(
					// LU_ModelType/label
					// , LU_ModelType/IsLandbouw && /VariantParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
							// ? 'ThisCasus/Zichtjaren/'+Zichtjaar_name+'/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/Label+'
								// ? ThisVariantData/Suitability/'+Zichtjaar_name+'/Landbouw/per_ModelType/'+LU_ModelType/Subsector_name+'/NPV 
									// + float32(Allocatie/Zichtjaren/'+Zichtjaar_name+'/Sequences/Seq_0/SectorAllocRegios/Landbouw_Provincie/Iters_Landbouw/Iter_0/Allocatie/shadow_Prices/'+LU_ModelType/Subsector_name+'[/SourceData/RegioIndelingen/CBS/Gekozen/Provincie/StudyArea/V/Friesland])
								// : 0[Eur_m2]'
							// : 'const(0[Eur_m2], rdc_25m)'
					// , rdc_25m
					// , Eur_m2
					// , '%LocalDataProjDir%/Indicatoren/NPV_Augmented/'+Casus_name +'/'+BoerVariantK/name[ModelParameters//BoerVariant_rel]+'_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
					// , 'gdalwrite.grid'
				// );
		}
		
		container Zichtjaar_NPV_perLUMT :=
			for_each_nedv(
				LU_ModelType/label
				, LU_ModelType/IsLandbouw && ModelParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
						? 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/label+'
							? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_ModelType/'+LU_ModelType/subsector_name+'/NPV 
							: 0[Eur_m2]'
						: 'const(0[Eur_m2], rdc_25m)'
				, rdc_25m
				, Eur_m2
			);
		
		// container Zichtjaar_NPV_Augmented_perLUMT :=
			// for_each_nedv(
				// LU_ModelType/label
				// , LU_ModelType/IsLandbouw && /VariantParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
						// ? 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA == LU_ModelType/v/'+LU_ModelType/label+'
							// ? ThisVariantData/Suitability/'+ExportZichtjaar+'/Landbouw/per_ModelType/'+LU_ModelType/subsector_name+'/NPV 
								// + float32(Allocatie/Zichtjaren/'+ExportZichtjaar+'/Sequences/Seq_0/SectorAllocRegios/Landbouw_Provincie/Iters_Landbouw/Iter_0/Allocatie/shadow_prices/'+LU_ModelType/subsector_name+'[/SourceData/RegioIndelingen/CBS/Gekozen/Provincie/StudyArea/V/Friesland])
							// : 0[Eur_m2]'
						// : 'const(0[Eur_m2], rdc_25m)'
				// , rdc_25m
				// , Eur_m2
			// );
	}
	
	// Veranderingen totaal areaal alle klassen (LUmodeltypes)
	attribute<Ha>     Verandering_Areaal_perLUMT      (LU_ModelType) := impl/Zichtjaar_Areaal_perLUMT - impl/Basisjaar_Areaal_perLUMT;
	
	// Veranderingen totaal areaal sector landbouw 
	parameter<Ha>     Verandering_Areaal_Landbouw                    := impl/Zichtjaar_Areaal_Landbouw - impl/Basisjaar_Areaal_Landbouw;
	
	// Verandering netto opbrengsten in euro’s (bedrijfwinst) tussen basisjaar en zichtjaar
	parameter<Eur_ha> Verandering_NettoOpbrengst_gemid_perHa         := impl/Zichtjaar_NettoOpbrengsten_perLUMT/Gemiddeld_perHa - impl/Basisjaar_NettoOpbrengsten_perLUMT/Gemiddeld_perHa;
	parameter<Eur>    Verandering_NettoOpbrengst_Totaal_Studiegebied := impl/Zichtjaar_NettoOpbrengsten_perLUMT/Totaal_Studiegebied - impl/Basisjaar_NettoOpbrengsten_perLUMT/Totaal_Studiegebied;
	
	// CO2 emissies, mton en eur, via prijs
	parameter<ton_jaarlijks>    Basisjaar_CO2_Uitstoot     := ='sum(ThisCasus/Basisjaar/SOMERS_CO2_laagveen/Emissies/Mediaan/Jaarlijks)[ton_jaarlijks]';
	parameter<ton>              Cumulatief_CO2_Uitstoot    := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Cumulatief_sindsStartyear)[ton]';
	parameter<Eur>              Cumulatief_CO2_kosten_laag := Cumulatief_CO2_Uitstoot * /ModelParameters/Landbouw/CO2_prijs_minimum; 
	parameter<Eur>              Cumulatief_CO2_kosten_hoog := Cumulatief_CO2_Uitstoot * /ModelParameters/Landbouw/CO2_prijs_maximum;

	container Transitie_Matrix := 
		for_each_nedv(
			Actor/LU_ModelType/nameshort
			, 'impl/LU_ModelType_Transities/count[
													value(
														uint32(id(Actor/LU_ModelType)) * uint32(#Actor/LU_ModelType) + '+string(id(Actor/LU_ModelType))+'
													, impl/LU_ModelType_Transities
													)
												][uint8]'
			, Actor/LU_ModelType
			, uint8
		)
	{
		attribute<string> from  (Actor/LU_ModelType) := Actor/LU_ModelType/nameshort;
	}
	
	container mean_NPV_obv_LUbasisjaar_perLBK :=
		for_each_nedv(
			LandbouwKlasses/name
			, 'mean(impl/Basisjaar_NPV_perLUMT/Landbouw_'+LandbouwKlasses/name+')'
			, void
			, Eur_m2
		);
		
	container mean_NPV_obv_LU_Zichtjaar_perLBK_zonderAugm :=
		for_each_nedv(
			LandbouwKlasses/name
			, 'mean(impl/Zichtjaar_NPV_perLUMT/Landbouw_'+LandbouwKlasses/name+')'
			, void
			, Eur_m2
		);
	
	// container mean_NPV_obv_LU_Zichtjaar_perLBK_Augmented :=
		// for_each_nedv(
			// LandbouwKlasses/name
			// , 'mean(impl/Zichtjaar_NPV_Augmented_perLUMT/Landbouw_'+LandbouwKlasses/name+')'
			// , void
			// , Eur_m2
		// );
	
	// container Bereikbaarheid_GroenWater 
	// {
		// parameter<String> Param_Afstand := 'Tot300m'; //opties: Tot500m Tot1000m
		// parameter<String> Param_Type    := 'Aanwezig'; //opties: Aanwezig Beschikbaar Bereikbaar
		
		// unit<UInt8> GroenWaterK := ThisCasus/Zichtjaren/Basisjaar/BereikbaarheidGroen/GroenWaterK;
		
		// container Basisjaar := 
			// for_each_nedv(
				// GroenWaterK/name
				// , 'ThisCasus/Zichtjaren/Basisjaar/BereikbaarheidGroen/Afstanden/'+Param_Afstand+'/AggrGroenKlassen/'+GroenWaterK/name+'/Indicatoren/'+Param_Type+'/Groen/Aggregated/PerWoning'
				// , void
				// , m2_Woning
			// );
		// container Zichtjaar := 
			// for_each_nedv(
				// GroenWaterK/name
				// , 'ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/Afstanden/'+Param_Afstand+'/AggrGroenKlassen/'+GroenWaterK/name+'/Indicatoren/'+Param_Type+'/Groen/Aggregated/PerWoning'
				// , void
				// , m2_Woning
			// );
	// }
	
	//export attributen ProvNH
	attribute<Woning_ha>                              Dichtheid_Wonen                    (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Wonen/Per_AdminDomain'                  , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Dichtheid_Wonen')", StorageType = "gdalwrite.grid";
	attribute<m2_ha>                                  Dichtheid_Werken_Pandfootprint_ha  (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/PandFootprint_ha/Per_AdminDomain', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Dichtheid_Werken_Pandfootprint_ha')", StorageType = "gdalwrite.grid";
	attribute<job_m2PandFootprint>                    Dichtheid_Werken_Banen_m2          (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/Banen_m2/Per_AdminDomain'        , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Dichtheid_Werken_Banen_m2')", StorageType = "gdalwrite.grid";
	attribute<float32>                                Verharding                         (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Result'                                , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Verharding')", StorageType = "gdalwrite.grid";
	// De twee piekbuikaarten liggen als enige export niet op het AdminDomain van 25 meter maar op het blok
	// van Basisjaar/Piekbuiberging/Grid_ref, nu 500 meter. Vierhonderd cellen van de buurkaarten passen in
	// een cel hiervan, dus de blokmaat hoort in de bestandsnaam; zonder dat wordt zo'n kaart naast de andere
	// gelegd en per cel gecombineerd, en dat levert onzin op. Zie #720.
	attribute<Meter3>                                 Piekbuiberging_Ongedekt (ThisCasus/Basisjaar/Piekbuiberging/Grid) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerGrid/Ongedekt', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Piekbuiberging_Ongedekt_m3_per'+ThisCasus/Basisjaar/Piekbuiberging/Grid_ref)", StorageType = "gdalwrite.grid";
	attribute<Meter3>                                 Piekbuiberging_Gedekt   (ThisCasus/Basisjaar/Piekbuiberging/Grid) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerGrid/Gedekt'  , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Piekbuiberging_Gedekt_m3_per'+ThisCasus/Basisjaar/Piekbuiberging/Grid_ref)"  , StorageType = "gdalwrite.grid", Descr = "De keerzijde van Ongedekt: waar de opgave wel wordt gedekt. Stond tot #720 als StorageName op PerGrid/Afname in de indicator zelf, maar dat item kwam in geen enkele ExplicitSuppliers voor, dus het bestand is nooit geschreven. Nu een gewone rasterexport naast de andere.";
	attribute<Eur>                                    Overstromingsschade_Hoofdwatersysteem_Binnendijks     (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks'      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Overstromingsschade_Hoofdwatersysteem_Binnendijks')", StorageType = "gdalwrite.grid";
	attribute<Eur>                                    Overstromingsschade_Hoofdwatersysteem_Buitendijks     (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks'      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Overstromingsschade_Hoofdwatersysteem_Buitendijks')", StorageType = "gdalwrite.grid";
	attribute<Eur>                                    Overstromingsschade_Regionaalwatersysteem_Binnendijks (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks'      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Overstromingsschade_Regionaalwatersysteem_Binnendijks')", StorageType = "gdalwrite.grid";
	attribute<m2_woning>                              BereikbaarheidGroen_BBG            (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'BereikbaarheidGroen')", StorageType = "gdalwrite.grid";
	attribute<meter2>                                 BereikbaarheidGroen_Fractie        (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Groenaanbod/Indicator', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'BereikbaarheidGroen_Fractie')", StorageType = "gdalwrite.grid", Descr = "De fractiebenadering uit #717: het groene deel van elke cel telt, inclusief het groen en water binnen ontwikkelpakketten, zonder de parkgroendrempels. De klassevariant hierboven blijft bestaan maar gaat op verzoek van Deltares niet mee in leveringen zolang #717 open staat.";
	attribute<LU_ModelType>                           Landgebruikskaart                  (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_SA'                      , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruikskaart')", StorageType = "gdalwrite.grid";
	attribute<LU_ModelType>                           Landgebruikskaart_bij_tov_PrevYear (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_bij_tov_PrevYear'        , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruikskaart_bij_tov_PrevYear')", StorageType = "gdalwrite.grid";
	attribute<LU_ModelType>                           Landgebruikskaart_af_tov_PrevYear  (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Landgebruikskaart/Result_af_tov_PrevYear'         , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruikskaart_af_tov_PrevYear')", StorageType = "gdalwrite.grid";
	attribute<Grondgebruik/ABCD/ABCD_subK>            VerstedelijkingInABCD              (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerstedelijkingInABCD'   , StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'VerstedelijkingInABCD')", StorageType = "gdalwrite.grid";
	attribute<bool>                                    Verstedelijking                            (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/Verstedelijking', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Verstedelijking')", StorageType = "tif";
	attribute<bool>                                    VerstedelijkingOpVruchtbareLandbouwgronden (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'VerstedelijkingOpVruchtbareLandbouwgronden')", StorageType = "tif";
	attribute<bool>                                    NieuweNatuur                               (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuur', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NieuweNatuur')", StorageType = "tif";
	attribute<bool>                                    NieuweNatuurOpVruchtbareLandbouwgronden    (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'NieuweNatuurOpVruchtbareLandbouwgronden')", StorageType = "tif";
	attribute<bool>                                    VerdwenenNatuur                            (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenNatuur', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'VerdwenenNatuur')", StorageType = "tif";
	attribute<bool>                                    WaterbergingVeen                           (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeen', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'WaterbergingVeen')", StorageType = "tif";
	attribute<bool>                                    WaterbergingVeenOpVruchtbareLandbouwgronden (AdminDomain) := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden', StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'WaterbergingVeenOpVruchtbareLandbouwgronden')", StorageType = "tif";
	
	parameter<string> Generate_Indicatoren := 'Ready'
	, ExplicitSuppliers = "='RegionaleIndicatoren;Landgebruik_Areaal;LandgebruikNL2120_Areaal;Dichtheid_Wonen;Dichtheid_Werken_Pandfootprint_ha;Dichtheid_Werken_Banen_m2;Verharding;Piekbuiberging_Ongedekt;Piekbuiberging_Gedekt;Overstromingsschade_Hoofdwatersysteem_Binnendijks;Overstromingsschade_Hoofdwatersysteem_Buitendijks;Overstromingsschade_Regionaalwatersysteem_Binnendijks;BereikbaarheidGroen_BBG;BereikbaarheidGroen_Fractie;Landgebruikskaart;Landgebruikskaart_bij_tov_PrevYear;Landgebruikskaart_af_tov_PrevYear;VerstedelijkingInABCD;Verstedelijking;VerstedelijkingOpVruchtbareLandbouwgronden;NieuweNatuur;NieuweNatuurOpVruchtbareLandbouwgronden;VerdwenenNatuur;WaterbergingVeen;WaterbergingVeenOpVruchtbareLandbouwgronden' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Sloopkosten' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/GesloopteWoningen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Sloopkosten' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/GesloopteWoningen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_BestaandeWoningen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_NieuwbouwWoningen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Woningwaarde/Nieuwbouw' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnamePerPeriode' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameCumulatief' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Stock_Zichtjaar' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Flow_Zichtjaar' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Minimum/Write_Result_SA' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Maximum/Write_Result_SA' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Write_Result_SA' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenLandbouw' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Sloopkosten_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_BestaandeWoningen_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_NieuwbouwWoningen_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Woningwaarde/Nieuwbouw_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/GesloopteBanen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/GesloopteBanen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/GesloopteWoningen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/GesloopteBanen' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/Alternatief' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/Regulier' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/MeerkostenBodemdaling' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/BeheerEnOnderhoud' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/MeerkostenBodemdaling_NCW' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWoningbouw/Controle' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/Controle' + ';ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Bereikbaarheid_Banen/Result' + ';' + AsList('ClaimRealisatie_PerNiveau/'+ClaimNiveau/values+'/Tabel', ';') + ';ClaimRealisatie_PerNiveau/Nederland/Tabel'";
	
	parameter<string> AllocatieFileName := replace(
		ModelParameters/Advanced/AllocatieFileName
		, '@CASUS@', Casus_name
		, '@JAAR@', ExportZichtjaar
		, '@SA@', ModelParameters/StudyArea
		, '@SS@', string(#/Classifications/Actor/Sector/xSubsector)
	);
	
	unit<uint32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path
	, Descr = "De regio-indeling waarop de indicatorentabel aggregeert, uit ModelParameters/Advanced (#658). Stond hier tot dan hard op Provincie/StudyArea. Dezelfde indeling die de indicatoren zelf voor hun Per_Regio gebruiken, zodat de kolommen hieronder allemaal over dezelfde regels gaan.";

	unit<uint32> RegionaleIndicatoren := Regio
	, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'RegionaleIndicatoren', '.tif', '.csv')", StorageType = "gdalwrite.vect"
	, Descr = "De tabelkant van de export (#658): naast elke grid-indicator hierboven staat hier dezelfde indicator geaggregeerd naar de regio-indeling uit ModelParameters/Advanced. In de productierun staat die op NL, dus is dit een tabel van een regel met alle indicatoren naast elkaar.

				Twee dingen staan er bewust niet in. Claimrealisatie hoort per allocatieregio van de betreffende sector en zit in ClaimRealisatie/Per_AllocRegio. En de landgebruikskaart is een klasse per cel; die aggregeert naar een areaal per klasse en niet naar een getal per regio, en staat als Impl/Zichtjaar_Areaal_perLUMT en Transitie_Matrix hierboven.

				Een kolom die door een uitgeschakelde sector leeg blijft, zoals verblijfsrecreatie, komt als lege kolom mee. Dat is bedoeld: de kolommen liggen vast, zodat twee runs naast elkaar te leggen zijn."
	{
		attribute<String>    Regio_name                                                      := Regio/name;

		// --- dichtheid ---
		attribute<Woning_ha> Dichtheid_Wonen                                                 := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Wonen/Per_Regio';
		attribute<Job_ha>    Dichtheid_Werken_Banen_ha                                       := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/Banen_ha/Per_Regio';
		attribute<m2_ha>     Dichtheid_Werken_PandFootprint_ha                               := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/PandFootprint_ha/Per_Regio';
		attribute<job_m2PandFootprint> Dichtheid_Werken_Banen_m2                             := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Dichtheid/Werken/Banen_m2/Per_Regio';

		// --- verharding ---
		attribute<float32>   Verharding                                                      := ='mean(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Result, Regio/Per_AdminDomain_Fijn)', Descr = "Gemiddelde verharde fractie per cel over de regio, uit dezelfde samengestelde kaart die als grid wordt geexporteerd.";
		attribute<m2_ha>     Verharding_Werken                                               := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Werken/Per_Regio';
		attribute<m2_ha>     Verharding_Verblijfsrecreatie                                   := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Verharding/Verblijfsrecreatie/Per_Regio';

		// --- piekbuiberging ---
		// Hoeveel van de piekbuiopgave in bestaand bebouwd gebied wordt gedekt door blauw-groene
		// maatregelen. Niet te verwarren met de sector Waterberging verderop in deze tabel, die als
		// WaterbergingVeen in hectare staat: dat is seizoensberging in het landelijk gebied en telt hier
		// per constructie niet mee. Beide heetten tot #720 waterberging.
		//
		// Dekkingsgraad is Gedekt gedeeld door Opgave, en dat is het getal dat in een beleidstekst wordt
		// overgenomen. Lees het nooit los van Dekkingsgraad_Ongeklemd ernaast: opgave en aanbod worden per
		// blok van 500 meter weggestreept en aanbod boven de blokopgave vervalt, wat op Y2120 bijna de helft
		// van het aanbod is. De twee kolommen zijn de onder- en bovengrens van dezelfde uitkomst.
		//
		// Piekbuiberging_Aanbod_m3 is sinds #741 van betekenis veranderd zonder van naam te veranderen. Hij
		// telde alle bergingscapaciteit en telt nu alleen de capaciteit binnen bestaand bebouwd gebied, want
		// de opgave stond daar al op gemaskeerd. Het getal wordt daarmee kleiner en de dekkingsgraad ook. Wat
		// eruit valt staat als Piekbuiberging_AanbodBuitenBBG_m3 ernaast, dus de oude kolom is terug te
		// krijgen door die twee op te tellen. Leg leveringen van voor en na #741 daarom niet naast elkaar
		// zonder die optelling.
		attribute<Meter3>    Piekbuiberging_Opgave_m3                                        := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/Opgave';
		attribute<Meter3>    Piekbuiberging_Aanbod_m3                                        := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/Aanbod';
		attribute<Meter3>    Piekbuiberging_AanbodBuitenBBG_m3                               := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/AanbodBuitenBBG';
		attribute<Meter3>    Piekbuiberging_Gedekt_m3                                        := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/Gedekt';
		attribute<Meter3>    Piekbuiberging_Ongedekt_m3                                      := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/Ongedekt';
		attribute<Meter3>    Piekbuiberging_AanbodZonderOpgave_m3                            := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/AanbodZonderOpgave';
		attribute<float32>   Piekbuiberging_Dekkingsgraad                                    := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/Dekkingsgraad';
		attribute<float32>   Piekbuiberging_Dekkingsgraad_Ongeklemd                          := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Piekbuiberging/PerRegio/Dekkingsgraad_Ongeklemd';

		// --- overstromingsschade ---
		attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks                := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_Per_Regio';
		attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Buitendijks                := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks_Per_Regio';
		attribute<Eur>       Overstromingsschade_Regionaalwatersysteem_Binnendijks            := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks_Per_Regio';
		attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks_NCW            := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_NCW_Per_Regio';
		attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Buitendijks_NCW            := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Buitendijks_NCW_Per_Regio';
		attribute<Eur>       Overstromingsschade_Regionaalwatersysteem_Binnendijks_NCW        := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Regionaalwatersysteem_Binnendijks_NCW_Per_Regio';
		attribute<Eur>       Overstromingsschade_Hoofdwatersysteem_Binnendijks_tov_basisjaar  := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Overstromingsschade/Resultaat/Result_Hoofdwatersysteem_Binnendijks_tov_basisjaar/Per_Regio';

		// --- kosten van de overstromingsmaatregel op werklocaties (#727) ---
		attribute<Eur>       KostenWerklocaties_MeerkostenOverstroming                       := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/Per_Regio/MeerkostenOverstroming', Descr = "Wat de gealloceerde werklocaties aan extra ophoging tegen het water kosten, nominaal. De tegenhanger van de korting die diezelfde cellen sinds #727 in de overstromingsschade krijgen.";
		attribute<Eur>       KostenWerklocaties_MeerkostenOverstroming_NCW                   := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/Per_Regio/MeerkostenOverstroming_NCW';
		attribute<Ha>        KostenWerklocaties_Werklocatie_Ha                               := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/KostenWerklocaties/Per_Regio/Werklocatie_Ha', Descr = "Controlegetal: over hoeveel hectare de post hierboven is geboekt.";

		// --- bereikbaarheid van groen ---
		attribute<meter2>    BereikbaarheidGroen_BBG_Tot300m_ExAgr_Groenaanbod_over_woning   := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/'+Regio/name+'/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')';
		attribute<meter2>    BereikbaarheidGroen_BBG_Tot300m_Groenaanbod_over_woning         := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/'+Regio/name+'/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')';
		attribute<m2_Woning> BereikbaarheidGroen_BBG_Tot300m_ExAgr_DrukteCorr_PerWoning      := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/'+Regio/name+'/Afstanden/Tot300m/AggrGroenKlassen/TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';
		attribute<m2_Woning> BereikbaarheidGroen_BBG_Tot300m_DrukteCorr_PerWoning            := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/'+Regio/name+'/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')';
		attribute<meter2>    BereikbaarheidGroen_Fractie_Tot300m_Groenaanbod_over_woning     := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/'+Regio/name+'/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Cumulatief_Groenaanbod_over_woningen/Indicator_Aggregated', ',')+')', Descr = "Fractiebenadering (#717). Geen ExAgr-tegenhanger: de fractietak kent geen agrarische uitsluiting, want de hedonische natuurdefinitie regelt zelf al wat meetelt.";
		attribute<m2_Woning> BereikbaarheidGroen_Fractie_Tot300m_DrukteCorr_PerWoning        := ='union_data(Regio,'+AsList('ThisCasus/Zichtjaren/'+ExportZichtjaar+'/BereikbaarheidGroen/obv_BBG/PerRegios/'+Regio/name+'/Afstanden/Tot300m/AggrGroenKlassen/Fractie/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated', ',')+')', Descr = "Fractiebenadering, druktegecorrigeerd (#717).";

		// --- grondgebruik: verandering ten opzichte van het basisjaar ---
		attribute<ha>        Verstedelijking                                                 := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/Verstedelijking/Per_Regio';
		attribute<ha>        VerstedelijkingOpVruchtbareLandbouwgronden                      := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_Regio';
		// Inbreidingsaandeel per regio. Stond alleen als landelijke parameter in Indicatoren/Inbreiding en
		// kwam daardoor niet in deze tabel. Teller en noemer allebei bruto: met het netto verschil kantelt
		// de maat zodra er ergens gesloopt wordt en kan hij negatief worden, zie #639. Een regio zonder
		// nieuwe woningen geeft een lege cel, want dan is er geen aandeel te bepalen.
		attribute<float32>   FractieWoningenErbijInBestaandBebouwdGebied                     := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/WoningenErbij * float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/BestaandBebouwdGebied), Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/WoningenErbij, Regio/Per_AdminDomain_Fijn)[float32]';
		attribute<float32>   FractieWoningenErbijInBestaandGroenInBBG                        := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/WoningenErbij * float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/BestaandGroenInBestaandBebouwdGebied), Regio/Per_AdminDomain_Fijn) / sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Inbreiding/WoningenErbij, Regio/Per_AdminDomain_Fijn)[float32]';
		attribute<ha>        NieuweNatuur                                                    := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuur/Per_Regio';
		attribute<ha>        NieuweNatuurOpVruchtbareLandbouwgronden                         := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_Regio';
		attribute<ha>        VerdwenenNatuur                                                 := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenNatuur/Per_Regio';
		attribute<ha>        WaterbergingVeen                                                := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeen/Per_Regio';
		attribute<ha>        WaterbergingVeenOpVruchtbareLandbouwgronden                     := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_Regio';
		attribute<ha>        VerdwenenLandbouw                                               := ='sum(float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenLandbouw) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn)';
		attribute<ha>        VerdwenenVruchtbareLandbouw                                     := ='sum(float32(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn)';

		// --- sloop, uitgesplitst naar de drie oorzaken uit #658 ---
		attribute<Woning>    Sloop_NieuweNatuur_Woningen                                     := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/GesloopteWoningen_Per_Regio';
		attribute<Job>       Sloop_NieuweNatuur_Banen                                        := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/GesloopteBanen_Per_Regio';
		attribute<Eur>       Sloop_NieuweNatuur_Uitkoopkosten                                := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_Per_Regio';
		attribute<Eur>       Sloop_NieuweNatuur_Sloopkosten                                  := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Sloopkosten_Per_Regio';
		attribute<Eur>       Sloop_NieuweNatuur_Uitkoopkosten_NCW                            := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_NCW_Per_Regio';
		attribute<Eur>       Sloop_NieuweNatuur_Sloopkosten_NCW                              := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanNieuweNatuur/Sloopkosten_NCW_Per_Regio';

		attribute<Woning>    Sloop_WaterbergingVeen_Woningen                                 := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/GesloopteWoningen_Per_Regio';
		attribute<Job>       Sloop_WaterbergingVeen_Banen                                    := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/GesloopteBanen_Per_Regio';
		attribute<Eur>       Sloop_WaterbergingVeen_Uitkoopkosten                            := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_Per_Regio';
		attribute<Eur>       Sloop_WaterbergingVeen_Sloopkosten                              := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_Per_Regio';
		attribute<Eur>       Sloop_WaterbergingVeen_Uitkoopkosten_NCW                        := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_NCW_Per_Regio';
		attribute<Eur>       Sloop_WaterbergingVeen_Sloopkosten_NCW                          := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_NCW_Per_Regio';

		attribute<Woning>    Sloop_OverigeBouwstenen_Woningen                                := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/GesloopteWoningen_Per_Regio';
		attribute<Job>       Sloop_OverigeBouwstenen_Banen                                   := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/GesloopteBanen_Per_Regio';
		attribute<Eur>       Sloop_OverigeBouwstenen_Uitkoopkosten                           := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_Per_Regio';
		attribute<Eur>       Sloop_OverigeBouwstenen_Sloopkosten                             := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_Per_Regio';
		attribute<Eur>       Sloop_OverigeBouwstenen_Uitkoopkosten_NCW                       := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_NCW_Per_Regio';
		attribute<Eur>       Sloop_OverigeBouwstenen_Sloopkosten_NCW                         := ='ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_NCW_Per_Regio';

		// --- woningwaarde en de waardering van groen in de nabijheid ---
		attribute<Eur>       Woningwaarde_Nieuwbouw                                          := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Woningwaarde/Nieuwbouw, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>       Woningwaarde_Nieuwbouw_NCW                                      := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/Woningwaarde/Nieuwbouw_NCW, Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>       WaardeNabijheidGroen_Woningen                                   := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen, 0[Eur]), Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>       WaardeNabijheidGroen_BestaandeWoningen                          := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_BestaandeWoningen, 0[Eur]), Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>       WaardeNabijheidGroen_NieuwbouwWoningen                          := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_NieuwbouwWoningen, 0[Eur]), Regio/Per_AdminDomain_Fijn)';
		attribute<Eur>       WaardeNabijheidGroen_Woningen_NCW                               := ='sum(MakeDefined(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen_NCW, 0[Eur]), Regio/Per_AdminDomain_Fijn)';

		// --- vermeden sterfte door meer groen ---
		attribute<Persoon>   SterfteAfname_PerPeriode                                        := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnamePerPeriode, Regio/Per_AdminDomain_Fijn)';
		attribute<Persoon>   SterfteAfname_Cumulatief                                        := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameCumulatief, Regio/Per_AdminDomain_Fijn)';
		// De twee termen waaruit SterfteAfname_PerPeriode is opgebouwd, apart, omdat ze een verschillend
		// verhaal vertellen. Zittend meet de verandering op de eigen locatie sinds het basisjaar en is dus
		// het effect van vergroening. Nieuw vergelijkt de nieuwe woning met de bewonersgewogen gemiddelde
		// groenindex van een woning in het basisjaar, en is structureel negatief zodra nieuwbouw compacter
		// is dan de bestaande voorraad. Zonder deze splitsing is een negatief totaal niet uit te leggen.
		attribute<Persoon>   SterfteAfname_PerPeriode_ZittendeBewoners                       := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameZittendeBewoners, Regio/Per_AdminDomain_Fijn)';
		attribute<Persoon>   SterfteAfname_PerPeriode_NieuweBewoners                         := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameNieuweBewoners, Regio/Per_AdminDomain_Fijn)';

		// --- koolstof ---
		attribute<ton>       CO2Stock_Zichtjaar                                              := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Stock_Zichtjaar, Regio/Per_AdminDomain_Fijn)', Descr = "De totale voorraad over beide pools: de bovenste 30 cm uit de bodemkoolstofkaart plus de veenkoolstof daaronder. De twee staan hieronder apart, en dat is nodig om deze kolom te kunnen lezen; zie daar.";
		// #736: de twee pools apart, want anders leest deze kolom als koolstof die op het spel staat. De veenreserve is
		// sinds die ronde de hele veenkolom onder de bovenste 30 cm in plaats van de schijf boven de basisjaar-GLG, en
		// daarmee gaat hij landelijk van 218 naar 863 Mton CO2. Van die reserve wordt binnen de horizon maar een derde
		// aangesproken: BAU verbruikt op de veenweide 0,54 van de 1,75 m die onder de toplaag ligt. Een lezer die alleen
		// het totaal ziet, ziet die verschuiving aan voor een verandering in wat er kan vrijkomen.
		attribute<ton>       CO2Stock_Zichtjaar_Bovenlaag                                    := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Zichtjaar/CO2/Stock_Bovenlaag, Regio/Per_AdminDomain_Fijn)', Descr = "Alleen de bovenste 30 cm plus biomassa, dus de voorraad zoals de indicator hem voor #657 rapporteerde. Dit is de pool waar een landgebruiksverandering op aangrijpt.";
		attribute<ton>       CO2Stock_Zichtjaar_Veenreserve                                  := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Zichtjaar/CO2/Stock_Veenreserve, Regio/Per_AdminDomain_Fijn)', Descr = "Alleen de veenkoolstof onder de bovenste 30 cm. Deze pool wordt uitsluitend door veenoxidatie aangesproken en verandert niet bij een landgebruiksverandering; wat er binnen de horizon van af gaat is het verschil met het basisjaar.";
		attribute<ton>       CO2Flow_Zichtjaar                                               := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Flow_Zichtjaar, Regio/Per_AdminDomain_Fijn)';
		attribute<ton>       CO2Flow_TovBasisjaar                                            := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar, Regio/Per_AdminDomain_Fijn)';
		// #733: de kolom hierboven is op een laat zichtjaar niet los te lezen. De koolstofboekhouding kan niet meer verliezen
		// dan er in de voorraad ligt, dus zodra een veenweidecel leeg is stopt haar bijdrage aan het verlies terwijl SOMERS
		// er uitstoot blijft rapporteren. In BAU op 2120 gaat het om 96,1 Mton CO2 landelijk, genoeg om het saldo van min 89
		// naar plus 7 te tillen. Deze twee kolommen zetten dat erbij: hoeveel er buiten de boekhouding is gebleven, en wat
		// het saldo zou zijn als die post onverkort was geboekt.
		attribute<ton>       CO2Ongedekt_Cumulatief                                          := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief, Regio/Per_AdminDomain_Fijn)', Descr = "Veenoxidatie die SOMERS sinds het basisjaar rapporteert terwijl de koolstofvoorraad van die cel al leeg was. Nul op alle zichtjaren waar de voorraad de vraag nog kon dragen.";
		attribute<ton>       CO2Flow_TovBasisjaar_InclOngedekt                                := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar, Regio/Per_AdminDomain_Fijn) - sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief, Regio/Per_AdminDomain_Fijn)', Descr = "Het koolstofsaldo met de ongedekte post als verlies meegeteld. Uitdrukkelijk niet de indicator, want veen dat er niet ligt oxideert niet; de kolom staat er als ondergrens naast zodat de bandbreedte tussen de koolstofindicator en de SOMERS-indicator zichtbaar is (#733).";

		// --- veenemissies volgens SOMERS, cumulatief sinds het basisjaar ---
		attribute<kg>        SOMERS_CO2_Cumulatief_Minimum                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Minimum/Write_Result_SA, Regio/Per_AdminDomain_Fijn)';
		attribute<kg>        SOMERS_CO2_Cumulatief_Mediaan                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA, Regio/Per_AdminDomain_Fijn)';
		attribute<kg>        SOMERS_CO2_Cumulatief_Maximum                                   := ='sum(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/SOMERS_CO2_laagveen/Emissies/Maximum/Write_Result_SA, Regio/Per_AdminDomain_Fijn)';
	}

	// Claimrealisatie per allocatieregio, gevraagd vanuit Deltares bij de bespreking van de
	// productierun. Bewust een eigen tabel per schaalniveau en geen kolom in RegionaleIndicatoren:
	// de claim hoort per allocatieregio van de betreffende sector, en dat is een andere doorsnede
	// dan de indicatorenregio. Juist het verschil tussen de niveaus maakt overflow zichtbaar. Zit
	// een regio op NVM-niveau boven de 1 terwijl COROP eromheen op 1 uitkomt, dan is de claim
	// binnen die grotere regio verschoven en niet landelijk overschreden.
	// Alleen de indelingen waarop wonen wordt gealloceerd, plus het landelijke totaal. Werken
	// gebruikt dezelfde drie indelingen. Waterbergingsregio hoort er nadrukkelijk NIET bij: daar
	// wordt waterberging op geclaimd en niet wonen of werken, en de wonen- en werkenclaim bestaat
	// daar dus niet als bronbestand. Een for_each over alle Uq_AllocRegios liep daarop vast met
	// een GDAL-fout op een niet bestaande Wonen.csv.
	unit<uint8> ClaimNiveau := unique(
		ModelParameters/SectorAllocRegio/AllocRegio_name[ModelParameters/SectorAllocRegio/WonenAllocRegio/org_rel]
	);

	container ClaimRealisatie_PerNiveau :=
		for_each_ne(
			  ClaimNiveau/values
			, 'ClaimRealisatie_Niveau_T(' + quote(ClaimNiveau/values) + ')'
		)
	{
		container Nederland := ClaimRealisatie_Niveau_T('Nederland');
	}

	Template ClaimRealisatie_Niveau_T
	{
		parameter<String> Niveau_name;
		///
		container Bron := ='ThisCasus/Zichtjaren/' + ExportZichtjaar + '/ClaimRealisatie/Per_AllocRegio/' + Niveau_name;

		unit<uint32> Tabel := Bron/ClaimRegio
		, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'ClaimRealisatie_' + Niveau_name, '.tif', '.csv')"
		, StorageType = "gdalwrite.vect"
		, Descr = "Gerealiseerde stand gedeeld door de claim, per regio van deze indeling. Een waarde onder 1 betekent dat de claim niet is gehaald, boven 1 dat er meer is gealloceerd dan gevraagd."
		{
			attribute<String>  Regio_name              := Bron/ClaimRegio/name;
			// Leeg laten waar er geen claim is, in plaats van een ratio van nul te tonen. Een nul leest
			// als een meting en nodigt niet uit om de claimkolom ernaast te bekijken; een leeg veld wel.
			attribute<float32> Wonen_realisatie        := Bron/Impl/Claims/Aantal_Woningen_Totaal > 0[Woning] ? Bron/Claim_realisatie/Wonen/Totaal : null_f;
			attribute<float32> Werken_realisatie       := Bron/Impl/Claims/Banen_Totaal > 0[Job] ? Bron/Claim_realisatie/Werken/Totaal : null_f;
			attribute<Woning>  Wonen_claim             := Bron/Impl/Claims/Aantal_Woningen_Totaal;
			attribute<Woning>  Wonen_stand             := Bron/Impl/Stand_PerAllocRegio/Aantal_Woningen_Totaal;
			attribute<Job>     Werken_claim            := Bron/Impl/Claims/Banen_Totaal;
			attribute<Job>     Werken_stand            := Bron/Impl/Stand_PerAllocRegio/Banen_Totaal;
		}
	}

	unit<uint8> Landgebruik_Areaal := Actor/LU_ModelType
	, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'Landgebruik_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
	, Descr = "De tabelkant van de landgebruikskaart (#658). Die kaart is een klasse per cel en aggregeert dus niet naar een getal per regio, maar naar een areaal per klasse. Deze tabel stond wel in de boom, als Impl/Basisjaar_Areaal_perLUMT en Impl/Zichtjaar_Areaal_perLUMT, maar werd nergens weggeschreven."
	{
		attribute<String> Klasse      := Actor/LU_ModelType/name;
		attribute<Ha>     Basisjaar   := Impl/Basisjaar_Areaal_perLUMT;
		attribute<Ha>     Zichtjaar   := Impl/Zichtjaar_Areaal_perLUMT;
		attribute<Ha>     Verandering := Verandering_Areaal_perLUMT;
	}

	unit<uint8> LandgebruikNL2120_Areaal := /Classifications/Grondgebruik/LU_NL2120
	, StorageName = "=replace(AllocatieFileName,'Allocatie', 'Indicatoren', '@STANDPATH@', 'LandgebruikNL2120_Areaal', '.tif', '.csv')", StorageType = "gdalwrite.vect"
	, Descr = "Idem voor de NL2120-landgebruikskaart met haar 92 klassen (#633): het areaal per klasse in het zichtjaar. De kaart zelf gaat als grid mee via LandgebruikskaartNL2120/Write_Result_SA."
	{
		attribute<String> Klasse    := /Classifications/Grondgebruik/LU_NL2120/name;
		attribute<Ha>     Zichtjaar := ='pcount(ThisCasus/Zichtjaren/'+ExportZichtjaar+'/LandgebruikskaartNL2120/Write_Result_SA)[float32] * rdc_25m/NrHaPerCell';
	}
}
