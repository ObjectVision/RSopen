////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// SSM Model van Deltares nagebouwd in RuimteScanner; Slager, K. (2016). Technische documentatie SSM2015:
// functionele en technische ontwerpkeuzen. Deltares rapportage 1230095-004-HYE-0009 dd. november 2016 Het
// registratiesysteem SOMERS (Subsurface Organic Matter Emission RegistRation System) is ontwikkeld om de
// landelijke CO2-uitstoot reductie in het veenweidegebied jaarlijks bij te houden. Met SOMERS 2.0 zijn
// rekenregels opgesteld om de toekomstige uitstoot te bepalen onder gestandaardiseerde omstandigheden.
// Groenaanbod = Totale oppervlakte groen (m²) binnen de gegeven straal rond cellen waar woningen aanwezig zijn.
// Cumulatief_Groenaanbod_over_woningen = Totale oppervlakte groen binnen de gegeven straal maal het aantal
// woningen in die cel (m²). In dichtgebouwd gebied nieuw groen toevoegen, maak je veel mensen gelukkig mee.
// Echter, ze realiseren zich dan niet dat je het moet delen met al die andere mensen (indicator 3).
// Drukte_gecorrigeerd_groenaanbod_per_woning = Som van drukte-gecorrigeerde groenbijdragen binnen de gegeven
// straal, waarbij per groencel het aanwezige groen wordt gewogen naar het aantal omliggende woningen (m² per
// woning). Laadt via #include: Dichtheid.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Basisjaar 
{
	parameter<string> Zichtjaar_name        := 'Basisjaar';
	
	container         ThisYear              := .;
	
	unit<UInt8>       Subsector             := Classifications/Actor/Sector/xSubsector;
	unit<UInt8>       OP                    := ThisVariantClassifications/Vastgoed/OP;
	unit<UInt8>       WP2                   := Classifications/Vastgoed/WP2;
	unit<UInt8>       WP4                   := Classifications/Vastgoed/WP4;
	unit<UInt8>       WP2xVSSH              := Classifications/Vastgoed/WP2xVSSH;
	unit<UInt8>       vbo_gebruiksdoel_plus := Classifications/Vastgoed/vbo_gebruiksdoel_plus;
	
	container impl
	{
		unit<UInt8> StandVar  := ThisVariantClassifications/StandVar
		{
			attribute<String> quantity_name := is_quantity ? name : '';
			unit<UInt8> OP := ThisVariantClassifications/StandVar/OP;
			container OP_Buurt := ='ThisVariantClassifications/Vastgoed/OP_Buurt';
		}
		
		unit<UInt8> StandVar_Prep  := ThisVariantClassifications/StandVar_Prep;
	}
	
	container Stand :=
		for_each_nedvn(
			impl/StandVar_Prep/name
			, '/BaseData/StartState/StateBasisjaar/State/'+impl/StandVar_Prep/path
			, AdminDomain
			, impl/StandVar_Prep
			, impl/StandVar_Prep/unit_name
		)
	{
		attribute<impl/StandVar/OP>        OP_rel            (AdminDomain) := const(value(0/0, impl/StandVar/OP), AdminDomain);
		attribute<Actor/Sector/xSubsector> SubSector_rel     (AdminDomain) := const(value(0/0, Actor/Sector/xSubsector), AdminDomain);
		attribute<Actor/Sector>            Sector_rel        (AdminDomain) := Actor/Sector/XSubsector/Sector_rel[Subsector_rel];
		attribute<Woning> Aantal_Woningen_Totaal             (AdminDomain) := = 'add('+asItemList('Aantal_Woningen_'+/Classifications/Vastgoed/WP2xVSSH/name)+')';
		attribute<Job>    Aantal_Banen_Totaal                (AdminDomain) := = 'add('+asItemList('Banen_'+/Classifications/Actor/Jobs6/name)+')';
		attribute<meter2> m2PandFootprint_Totaal             (AdminDomain) := ='add('+asItemList('m2PandFootprint_'+/Classifications/Actor/Jobs6/name)+')';
		
		attribute<meter2> Gebruiksopp_Eengezins              (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Gebruiksoppervlak/per_WP2_perAdminDomain/Eengezins);
		attribute<meter2> Gebruiksopp_Meergezins             (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Gebruiksoppervlak/per_WP2_perAdminDomain/Meergezins);
		attribute<meter2> Gebruiksopp_Nijverheid             (AdminDomain) := Gebruiksoppervlak/per_Jobs6_perAdminDomain/Nijverheid;
		attribute<meter2> Gebruiksopp_Logistiek              (AdminDomain) := Gebruiksoppervlak/per_Jobs6_perAdminDomain/Logistiek;
		attribute<meter2> Gebruiksopp_Detailhandel           (AdminDomain) := Gebruiksoppervlak/per_Jobs6_perAdminDomain/Detailhandel;
		attribute<meter2> Gebruiksopp_Ov_consumentendiensten (AdminDomain) := Gebruiksoppervlak/per_Jobs6_perAdminDomain/Ov_consumentendiensten;
		attribute<meter2> Gebruiksopp_Zak_dienstverlening    (AdminDomain) := Gebruiksoppervlak/per_Jobs6_perAdminDomain/Zak_dienstverlening;
		attribute<meter2> Gebruiksopp_Overheid_kw_diensten   (AdminDomain) := Gebruiksoppervlak/per_Jobs6_perAdminDomain/Overheid_kw_diensten;
		
		attribute<meter2> PandFootprint_Wonen                (AdminDomain) := /BaseData/StartState/StateBasisjaar/State/Wonen/Footprint;
		attribute<meter2> PandFootprint_Werken               (AdminDomain) := /BaseData/StartState/StateBasisjaar/State/PandFootprint/Totaal;
		attribute<meter2> PandFootprint_Verblijfsrecreatie   (AdminDomain) :=
			= ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector
				? '/BaseData/StartState/StateBasisjaar/State/Verblijfsrecreatie/Footprint'
				: 'const(0[meter2], AdminDomain)'
		, Descr = "Zonder de sector verblijfsrecreatie schrijft StateBasisjaar deze standvariabele niet weg, en gaat de IntegrityCheck tegen een volledig lege read af. Zie de gelijknamige indicator in Templates/Indicatoren.dms voor de redenering.";
		
		container Aantal_Woningen_WP4   := /BaseData/StartState/StateBasisjaar/Src0/Wonen/WP4;
		container Gebruiksoppervlak_WP4 := /BaseData/StartState/StateBasisjaar/Src0/Wonen/WP4_opp;
	}
	
	container Stand_PerAllocRegio :=
		for_each_nedvn(
			impl/StandVar_Prep/name
			, 'sum((Stand/'+impl/StandVar_Prep/name+'), /SourceData/RegioIndelingen/NVM/Per_AdminDomain)'
			, /SourceData/RegioIndelingen/NVM
			//, 'sum((Stand/'+impl/StandVar_Prep/name+'), /SourceData/RegioIndelingen/COROP/Per_AdminDomain)'
			//, /SourceData/RegioIndelingen/COROP
			, impl/StandVar_Prep
			, impl/StandVar_Prep/unit_name
		);
		
	// container Stand_metBAGnb_PerAllocRegio :=
		// for_each_nedvn(
			// StandVar_Prep/name
			// , 'sum((/Allocatie/StartState_metBAGnieuwbouw/'+StandVar_Prep/path+'), /SourceData/RegioIndelingen/NVM/Per_CompactedAdminDomain)'
			// , /SourceData/RegioIndelingen/NVM
			// , StandVar_Prep
			// , StandVar_Prep/unit_name
		// );
	
	container Gebruiksoppervlak
	{
		unit<UInt32> pand     := ='/SourceData/Vastgoed/BAG/PerJaar/Y'+string(ModelParameters/Model_StartYear)+'/pand';
		
		container per_Gebruiksdoel_perAdminDomain :=
			for_each_nedv(
				vbo_gebruiksdoel_plus/name
				, 'sum(pand/Oppervlaktes/VBOopp_perGebruiksdoel_uniek/'+vbo_gebruiksdoel_plus/name+'[pand/ToedelingsMatrix/Pand_rel] * pand/ToedelingsMatrix/ToedelingPand, pand/ToedelingsMatrix/AdminDomain_rel)'
				, AdminDomain
				, meter2
			), Descr = "Gebruikt de unieke telling zodat vbo's met meerdere gerelateerde panden niet dubbel meetellen in het gebruiksoppervlak per cel.";
		
		container per_Jobs6_perAdminDomain := 
			for_each_nedv(
				Actor/Jobs6/name
				, replace(Actor/Jobs6/vbo_gebruiksdoel_plus_ref, '@', 'per_Gebruiksdoel_perAdminDomain/','#', '')
				, AdminDomain
				, meter2
			);
		
		container per_WP2_perAdminDomain := /BaseData/StartState/StateBasisjaar/Src0/Wonen/WP2_opp; 
		container per_WP4_perAdminDomain := /BaseData/StartState/StateBasisjaar/Src0/Wonen/WP4_opp; 
		
		container per_WP2xVSSH_perAdminDomain := 
			for_each_nedv(
				WP2xVSSH/name
				, 'recollect_by_cond(AdminDomain/IsCompactedDomain, /BaseData/StartState/Verdeling_VSSH/Uitsmeren_WP2_'+WP2xVSSH/VSSH_name+'/'+WP2xVSSH/WP_name+'/VBOopp_Per_CompactedAdminDomain)'
				, AdminDomain
				, meter2
			);
	}
	
	#include<Dichtheid.dms>
	
	container Grondgebruik
	{
		attribute<Classifications/Grondgebruik/CBSKlasse/Aggr/Groen> Groen      (AdminDomain) := invert(/Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/org_rel)[/BaseData/StartState/Grondgebruik/Per_AdminDomain/gg_CBS/Per_Aggr];
		attribute<Classifications/Actor/Sector>                      Sector_rel (AllocDomain) := Classifications/Grondgebruik/CBSKlasse/Sector_rel[/BaseData/StartState/Grondgebruik/Per_AllocDomain/Basisjaar];
		
		attribute<Classifications/Actor/LU_ModelType>                gg_basis   (AdminDomain) := /BaseData/StartState/Grondgebruik/Per_AdminDomain/gg_basis;
		
		container Verandering
		{
			unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;
			
			attribute<bool> Verstedelijking (AdminDomain) := const(false, AdminDomain)
			{
				attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain);
				parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			}
			
			attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> VerstedelijkingInABCD (AdminDomain) := const(null_b, AdminDomain);
			
			attribute<bool> VerstedelijkingOpVruchtbareLandbouwgronden (AdminDomain) := VerstedelijkingInABCD == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A
			{
				attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain);
				parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			}
			
			// In het basisjaar is er per definitie nog geen nieuwe natuur; de items bestaan hier zodat de paden gelijk zijn aan die van de zichtjaren.
			attribute<bool> NieuweNatuur (AdminDomain) := const(false, AdminDomain)
			{
				attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain);
				parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			}
			
			attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> NieuweNatuurInABCD (AdminDomain) := const(null_b, AdminDomain);
			
			attribute<bool> NieuweNatuurOpVruchtbareLandbouwgronden (AdminDomain) := NieuweNatuurInABCD == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A
			{
				attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain);
				parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			}
			
			// In het basisjaar is er nog geen waterberging gealloceerd; de items bestaan hier zodat de paden gelijk zijn aan die van de zichtjaren.
			attribute<bool> WaterbergingVeen (AdminDomain) := const(false, AdminDomain)
			{
				attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain);
				parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			}
			
			attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> WaterbergingVeenInABCD (AdminDomain) := const(null_b, AdminDomain);
			
			attribute<bool> WaterbergingVeenOpVruchtbareLandbouwgronden (AdminDomain) := WaterbergingVeenInABCD == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A
			{
				attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain);
				parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			}
		}
	}
	
	container Landgebruikskaart := Templates/Indicatoren/Landgebruikskaart/Make_Landgebruikskaart_T(Zichtjaar_name, Stand);
	container LandgebruikskaartNL2120 := Templates/Indicatoren/Landgebruikskaart/Make_LandgebruikskaartNL2120_T(Zichtjaar_name, Landgebruikskaart), Descr = "Tweede landgebruikskaart naast Landgebruikskaart, met landbouw als een klasse en natuur uitgesplitst naar beheertype. Zie #633.";
	
	// N.B. Dit is de potentiële schade bij een diepte vanaf kleine kans (= 1/1000 jaar of hoger). Zie: https://www.klimaateffectatlas.nl/nl/overstromingsdiepte
	container Overstromingsschade := Templates/Indicatoren/SSM2017_Overstromingsschades_T(Zichtjaar_name), Descr = "SSM Model van Deltares nagebouwd in RuimteScanner; Slager, K. (2016). Technische documentatie SSM2015: functionele en technische ontwerpkeuzen. Deltares rapportage 1230095-004-HYE-0009 dd. november 2016 ";
	
	container SOMERS_CO2_laagveen := Templates/Indicatoren/SOMERS_CO2_T(Zichtjaar_name), Descr = "Het registratiesysteem SOMERS (Subsurface Organic Matter Emission RegistRation System) is ontwikkeld om de landelijke CO2-uitstoot reductie in het veenweidegebied jaarlijks bij te houden. Met SOMERS 2.0 zijn rekenregels opgesteld om de toekomstige uitstoot te bepalen onder gestandaardiseerde omstandigheden.", URL = "https://www.nobveenweiden.nl/bevindingen-rekenregels/";
	container CarbonStorageSequestration := Templates/Indicatoren/CarbonStorageSequestration_T(Zichtjaar_name), Descr = "";
	
	container BereikbaarheidGroen
	{
		parameter<Woning_ha> MaxWoningenInGroen                 := 5[Woning_ha];
		parameter<ha>        MinimumAaneengeslotenOppervlakte   := 1[Ha];
		attribute<Woning>    Woningen0             (AdminDomain) := Stand/Aantal_Woningen_Totaal[Woning];
		attribute<Woning>    Woningen              (AdminDomain) := Woningen0;
		
		parameter<meter2>    MinimumOppervlakteInCelOmMeeTeDoen := 100[meter2];
		parameter<Float32>   FractieGroenWerken                 := 1f - min_elem(VariantParameters/FractiesGroenInWerken/Default/Verhard * VariantParameters/VariantK/VerhardingTovDefault[Variant_rel], 1f);
		parameter<Float32>   FractieGroenVerblijfsrecreatie     := 1f - min_elem(VariantParameters/FractiesGroenInVerblijfsrecreatie/Default/Verhard * VariantParameters/VariantK/VerhardingTovDefault[Variant_rel], 1f);
		
		unit<UInt32> Regio  := =/ModelParameters/Advanced/IndicatorRegio_path;
		unit<uint8>  GroenK := /Classifications/Grondgebruik/CBSKlasse/Aggr/Groen;
		
		unit<uint8> Indicator : NrOfRows = 3 
		, Descr = "Groenaanbod = Totale oppervlakte groen (m²) binnen de gegeven straal rond cellen waar woningen aanwezig zijn.
					Cumulatief_Groenaanbod_over_woningen = Totale oppervlakte groen binnen de gegeven straal maal het aantal woningen in die cel (m²). In dichtgebouwd gebied nieuw groen toevoegen, maak je veel mensen gelukkig mee. Echter, ze realiseren zich dan niet dat je het moet delen met al die andere mensen (indicator 3).
					Drukte_gecorrigeerd_groenaanbod_per_woning = Som van drukte-gecorrigeerde groenbijdragen binnen de gegeven straal, waarbij per groencel het aanwezige groen wordt gewogen naar het aantal omliggende woningen (m² per woning)."
		{
			attribute<string> name: 
			[
				 'Groenaanbod'                                  // Totale oppervlakte groen (m²) binnen de gegeven straal rond cellen waar woningen aanwezig zijn.
				,'Cumulatief_Groenaanbod_over_woningen'         // Totale oppervlakte groen binnen de gegeven straal maal het aantal woningen in die cel (m²). In dichtgebouwd gebied nieuw groen toevoegen, maak je veel mensen gelukkig mee. Echter, ze realiseren zich dan niet dat je het moet delen met al die andere mensen (indicator 3).
				,'Drukte_gecorrigeerd_groenaanbod_per_woning'   // Som van drukte-gecorrigeerde groenbijdragen binnen de gegeven straal, waarbij per groencel het aanwezige groen wordt gewogen naar het aantal omliggende woningen (m² per woning).
			];
			
			attribute<string> IndicatorExpr : 
			[
				 'Som_GroenInOmgeving_metWoning'                          
				,'Som_GroenInOmgeving_metWoning * WoningenInThisStRegio_ge1 / 1[woning]' 
				,'Som_AanwezigGroenPerWoning' 
			];
			
			attribute<string> ValuesUnit : 
			[
				 'meter2' 
				,'meter2' 
				,'m2_Woning' 
			];
		}
		
		container InDezeStudie := obv_BBG;
		
		container obv_BBG := Templates/Indicatoren/BereikbaarheidGroenBBG_T(..);
		container obv_BGT := Templates/Indicatoren/BereikbaarheidGroenBGT_T(..);
	}
	
	container Verharding
	{
		attribute<meter2>   VerhardOpp_CopernicusBGTcombi   (AdminDomain) := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData/VerhardOpp_AdminDomain;
		attribute<meter2>   VerhardOpp_Copernicus           (AdminDomain) := /SourceData/Grondgebruik/Imperviousness_Map/InProcent[Ratio] * AdminDomain/NrMeter2PerCell;
		attribute<meter2>   Diff                            (AdminDomain) := VerhardOpp_Copernicus - VerhardOpp_CopernicusBGTcombi;
		attribute<float32>  Result                          (AdminDomain) := VerhardOpp_CopernicusBGTcombi / AdminDomain/NrMeter2PerCell, StorageName = "='%LocalDataProjDir%/Indicatoren/Basisjaar/Verharding_Basisjaar_fractie_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
	}
	
	container Waterberging
	{
		parameter<string> Grid_ref := '500m'; // 100m, 500m
		parameter<string> Kans_ref := '1000'; // 100, 1000
		
		unit<IPoint> Grid  := = '/Geography/rdc_'+Grid_ref;
		
		attribute<Meter>  WaterdiepteBijHevigeNeerslag (AdminDomain) := = '/SourceData/Water/WaterdiepteBijHevigeNeerslag_T'+Kans_ref;
		attribute<bool> BestaandBebouwdGebied          (AdminDomain) := /BaseData/Omgeving/BBGSamengesteld; // @Jip, waarom nergens BBG woongebied? 
		attribute<Meter3> Vraag                        (AdminDomain) := WaterdiepteBijHevigeNeerslag * AdminDomain/NrMeter2PerCell * float32(BestaandBebouwdGebied);
		attribute<Meter3> Restvraag                    (AdminDomain) := Vraag; // We gaan ervan uit dat evt bestaande capaciteit al 'verbruikt' is. Er is dus geen (extra) 'aanbod'
		
		container PerGrid
		{
			attribute<Meter3> Vraag             (Grid) := ='sum(../Vraag, AdminDomain/rdc_'+Grid_ref+'_rel)';
			attribute<Meter3> RestVraag         (Grid) := ='sum(../RestVraag, AdminDomain/rdc_'+Grid_ref+'_rel)';
			attribute<Meter3> RestvraagPositief (Grid) := max_elem(Restvraag, 0[meter3]);
		}
		
		container PerRegio
		{
			unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path
			{
				attribute<.> Per_Grid (Grid) := ='modus(Regio/Per_AdminDomain, AdminDomain/rdc_'+Grid_ref+'_rel)'
				, Descr = "Regio van het blok, als meest voorkomende regio van de onderliggende cellen. Tot #705 kwam dit uit poly2grid op de regiogeometrie; met modus volgt het blok altijd dezelfde kaart als de celaggregaties, en kan ook een indeling zonder geometry meedoen, zoals Landschap.";
			}
			
			attribute<Meter3> Vraag             (Regio) := sum(PerGrid/Vraag, Regio/Per_Grid);
			attribute<Meter3> RestVraag         (Regio) := sum(PerGrid/RestVraag, Regio/Per_Grid);
			attribute<Meter3> RestvraagPositief (Regio) := sum(PerGrid/RestvraagPositief, Regio/Per_Grid);
		}
	}
	
	container Mortaliteit : using = "Classifications/Grondgebruik"
	{
		parameter<string> StorageStr := lowercase(Zichtjaar_name) == lowercase('Basisjaar') 
		? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/SterfgevallenPerJaarDoorGroen_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
		: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SterfgevallenPerJaarDoorGroen_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
		
		// #484: waargenomen bevolking en sterfte per buurt, uit de CBS Kerncijfers wijken en buurten. Hier staan de
		// twee grootheden waarmee de indicator een verandering van de groenindex omrekent naar sterfgevallen:
		// hoeveel bewoners er in een cel wonen en hoe groot hun kans op overlijden is. De zichtjaren verwijzen
		// hiernaar, zodat de aggregatie per buurt eenmaal per casus gebeurt en zichtjaren onderling vergelijkbaar
		// blijven: alleen de woningvoorraad en de groenindex lopen in de tijd, de sterftekans per buurt niet.
		// Terug naar landelijke gemiddelden kan zonder schakelaar: Sterfte_KrimpGewicht heel hoog zetten laat elke
		// buurt naar het landelijke sterftecijfer krimpen, en onder- en bovengrens gelijk zetten geeft overal
		// dezelfde huishoudensgrootte.
		container Demografie
		: Descr = "Bewoners en sterftekans per cel in het basisjaar, afgeleid uit de CBS Kerncijfers wijken en buurten."
		{
			unit<UInt32> BuurtDomain := /SourceData/Bevolking/Buurt/Domain;

			attribute<Woning>         Woningen_PerBuurt     (BuurtDomain) := sum(Stand/Aantal_Woningen_Totaal, BuurtDomain/Per_AdminDomain), Descr = "De woningvoorraad van het model, opgeteld per buurt.";
			parameter<Persoon_Woning> PersonenPerWoning_NL                := /SourceData/Bevolking/Inwoners_NL / sum(Woningen_PerBuurt), Descr = "Landelijke huishoudensgrootte volgens dezelfde deling: CBS-inwonertal gedeeld door de modelwoningvoorraad. Vangnet voor buurten en cellen waar de deling per buurt niets oplevert.";

			attribute<Persoon_Woning> HuishoudensgrootteRuw (BuurtDomain) := /SourceData/Bevolking/Buurt/Inwoners / Woningen_PerBuurt, Descr = "Het CBS-inwonertal van de buurt gedeeld door de modelwoningvoorraad van diezelfde buurt.";
			attribute<Persoon_Woning> Huishoudensgrootte    (BuurtDomain) :=
				Woningen_PerBuurt > 0[Woning] && /SourceData/Bevolking/Buurt/Inwoners > 0[Persoon]
				? min_elem(max_elem(HuishoudensgrootteRuw, /ModelParameters/Wonen/PersonenPerWoning_Ondergrens), /ModelParameters/Wonen/PersonenPerWoning_Bovengrens)
				: PersonenPerWoning_NL
			, Descr = "Begrensd, want in buurten waar het model weinig woningen kent en het CBS veel inwoners telt loopt de ruwe verhouding sterk op. Buurten zonder woningen of zonder inwoners krijgen het landelijke cijfer.";

			attribute<Persoon_Woning> PersonenPerWoning (AdminDomain) := MakeDefined(Huishoudensgrootte[BuurtDomain/Per_AdminDomain], PersonenPerWoning_NL), Descr = "Cellen buiten elke buurt, aan de randen van de op 100 meter gerasterde buurtindeling, krijgen het landelijke cijfer.";
			attribute<jaarlijks>      Sterftekans       (AdminDomain) := /SourceData/Bevolking/Per_AdminDomain/Sterftekans;

			attribute<Persoon>           Bewoners             (AdminDomain) := Stand/Aantal_Woningen_Totaal * PersonenPerWoning;
			attribute<Persoon_jaarlijks> SterfgevallenPerJaar (AdminDomain) := Sterftekans * Bewoners, StorageName = "=replace(StorageStr, 'SterfgevallenPerJaarDoorGroen_@V@', 'SterfgevallenPerJaar_waargenomen')", StorageType = "gdalwrite.grid", Descr = "De waargenomen sterfte, uitgesmeerd over de woningen in de buurt. Dit is geen modeluitkomst maar de CBS-sterfte op de kaart; de indicator rekent er de verandering door groen bovenop.";

			parameter<Persoon>           Bewoners_Totaal             := sum(Bewoners), IntegrityCheck = "abs(Bewoners_Totaal - /SourceData/Bevolking/Inwoners_NL) < 0.05f * /SourceData/Bevolking/Inwoners_NL", Descr = "Controle: de bewoners van het model horen op te tellen tot ongeveer de landelijke bevolking (CBS 2024: 17,9 miljoen). Faalt dit, dan is de koppeling van de KWB-tabel aan de buurtindeling stuk of is de woningvoorraad ingrijpend veranderd.";
			parameter<Persoon_jaarlijks> SterfgevallenPerJaar_Totaal := sum(SterfgevallenPerJaar), IntegrityCheck = "abs(SterfgevallenPerJaar_Totaal - /SourceData/Bevolking/Sterfgevallen_NL) < 0.05f * /SourceData/Bevolking/Sterfgevallen_NL", Descr = "Controle: de gemodelleerde sterfte in het basisjaar hoort op te tellen tot ongeveer het landelijke sterftecijfer (CBS 2024: 172.165 per jaar).";
		}

		parameter<string> StorageStrNDVI := replace(StorageStr, 'SterfgevallenPerJaarDoorGroen_@V@', 'NDVI_500m_@V@'), Descr = "Eigen bestandsnaam voor de NDVI-kaarten. Die schreven eerder naar de sterfgevallen-naam, waarbij NDVI_500m en NDVI_max_500m elkaars bestand overschreven.";

		attribute<LGNKlasse> LGN (AdminDomain) :=  /SourceData/Grondgebruik/LGN/m25;

		attribute<bool>      ExcludedLGNK (AdminDomain) := LGNKlasse/ndvi_excl[LGN];
		attribute<float32>   NDVI_min     (AdminDomain) := ExcludedLGNK ? null_f : LGNKlasse/ndvi_min[LGN];
		attribute<float32>   NDVI_mid     (AdminDomain) := ExcludedLGNK ? null_f : LGNKlasse/ndvi_mid[LGN];
		attribute<float32>   NDVI_max     (AdminDomain) := ExcludedLGNK ? null_f : LGNKlasse/ndvi_max[LGN];
		
		attribute<float32>   NDVI_min_500m (AdminDomain) := potential(NDVI_min, /Geography/Distmatrices_25m/pot500m/Flat2) / potential(float32(IsDefined(NDVI_min)), /Geography/Distmatrices_25m/pot500m/Flat2), StorageName = "=replace(StorageStrNDVI, '@V@', 'min')", StorageType = "gdalwrite.grid";
		attribute<float32>   NDVI_mid_500m (AdminDomain) := potential(NDVI_mid, /Geography/Distmatrices_25m/pot500m/Flat2) / potential(float32(IsDefined(NDVI_mid)), /Geography/Distmatrices_25m/pot500m/Flat2), StorageName = "=replace(StorageStrNDVI, '@V@', 'mid')", StorageType = "gdalwrite.grid";
		attribute<float32>   NDVI_max_500m (AdminDomain) := potential(NDVI_max, /Geography/Distmatrices_25m/pot500m/Flat2) / potential(float32(IsDefined(NDVI_max)), /Geography/Distmatrices_25m/pot500m/Flat2), StorageName = "=replace(StorageStrNDVI, '@V@', 'max')", StorageType = "gdalwrite.grid";
		attribute<float32>   NDVI_500m     (AdminDomain) := ='NDVI_'+Modelparameters/Wonen/NDVI_basisjaar_ref+'_500m', StorageName = "=replace(StorageStrNDVI, '@V@', 'keuze')", StorageType = "gdalwrite.grid", Descr = "De variant die in ModelParameters/Wonen/NDVI_basisjaar_ref is gekozen.";
	}
}