container Dichtheid
{
	container Voorraad := Templates/Indicatoren/DichtheidVoorraad_T(Zichtjaar_name), Descr = "De dichtheid van wonen en werken in de hele voorraad van het basisjaar, uit hetzelfde sjabloon als de zichtjaren (#439). Een dichtheid van de nieuwbouw, zoals Dichtheid/Wonen en Dichtheid/Werken in een zichtjaar, heeft het basisjaar niet.";
}