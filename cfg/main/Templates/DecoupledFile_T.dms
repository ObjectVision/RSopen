////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaalt of een ontkoppeld bestand hergebruikt mag worden of opnieuw gemaakt moet worden. Naast het
// ontkoppelde bestand zelf komt een zijbestand met dezelfde naam plus .params.txt, waarin de waarden staan die
// de uitkomst bepalen. Klopt dat zijbestand niet meer met de huidige instellingen, dan wordt het bestand
// opnieuw gemaakt en overschreven. Het zijbestand ontstaat pas nadat het bestand zelf er staat; de items die
// het bestand schrijven worden als Writers meegegeven en zijn de leveranciers van het zijbestand.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template DecoupledFile_T
: Descr = "Bepaalt of een ontkoppeld bestand hergebruikt mag worden of opnieuw gemaakt moet worden. Gebruik: instantieer naast het bestand dat je ontkoppelt en geef drie dingen mee, het volledige pad
			(dezelfde expressie als de StorageName), een fingerprint, en Writers, de naam van het item dat het bestand schrijft, gezien vanuit de container waarin je dit sjabloon zet; schrijft de gebruiker meer
			dan een bestand of een mmd met meer attributen, noem ze dan alle, gescheiden door een puntkomma, en noem data-items en nooit een container of een unit, want een container als leverancier werkt de hele
			boom eronder bij. Zet de gebruikerskant daarna als drieslag neer: attribute<...> Write_X met de StorageName, attribute<...> Make_X := Write_X met ExplicitSuppliers = Decoupling_X/Write_Fingerprint,
			en attribute<...> X := =!<Iets>Ontkoppeld ? Calc_X : Decoupling_X/MayReuse ? Read_X : Make_X. Die volgorde is geen vormkwestie. GeoDMS werkt een leverancier bij voordat het item zelf wordt
			uitgerekend, dus hangt de kaart onder het zijbestand en niet andersom; stond Write_Fingerprint als leverancier aan het schrijvende item zelf, dan ontstond het zijbestand aan het begin van de rekentijd
			en liet een run die daarin afbreekt een nieuwe fingerprint naast het oude bestand achter, dat de volgende run dan als geldig leest (#837). De fingerprint: zet hierin alle waarden die de uitkomst
			bepalen, ook de waarden die al in de bestandsnaam zitten, bewust dubbelop, zodat de regel geen uitzonderingen kent en het zijbestand een compleet leesbaar verslag is van waar het bestand
			vandaan komt; dus niet alleen ModelParameters, maar ook variantinstellingen, klassenindelingen en de datum of versie van de brondata, want een vergeten determinant laat het model
			stilzwijgend een verouderd bestand gebruiken, en dat is erger dan altijd opnieuw rekenen. Engelse sleutelnamen, gescheiden door een puntkomma, in de vorm sleutel=waarde, bijvoorbeeld
			bgt_date=20260819;study_area=Nederland;variant=BAU. Veiligheid: het mechanisme faalt de goede kant op. Ontbreekt het zijbestand, dan wordt teruggevallen op cfg/no_fingerprint.txt en klopt de
			vergelijking nooit, dus wordt er opnieuw gerekend; ontbreekt het bestand zelf, idem; en een Writers die niet oplost valt op bij het rekenen, met exit 1 en ExplicitSupplier niet gevonden, zonder dat
			er een zijbestand ontstaat. ModelParameters/AlwaysRemakeDecoupledFiles zet het hergebruik in een keer helemaal uit."
{
	parameter<String> FileName;
	parameter<String> Fingerprint;
	parameter<String> Writers;
	//

	parameter<String> FullPath
		:= expand(., FileName)
	, Descr = "Het pad met placeholders al ingevuld. ExistingFile vergelijkt met volledige paden, dus expanderen is nodig voordat je kunt vergelijken.";

	parameter<String> FingerprintFile := FullPath + '.params.txt';

	parameter<Bool>   FileExists
		:= ExistingFile('#missing#', FullPath) == FullPath
	, Descr = "ExistingFile geeft het tweede argument terug als dat bestand benaderbaar is, en anders het eerste. Gelijk aan FullPath betekent dus dat het bestand er staat.";

	parameter<String> StoredFingerprint
		:	StorageName     = "=ExistingFile('%projDir%/cfg/no_fingerprint.txt', FingerprintFile)"
		,	StorageType     = "str"
		,	StorageReadOnly = "True"
		,	Descr = "De fingerprint van de vorige keer. De ExistingFile eromheen is geen franje: zonder die terugval bindt GeoDMS storage aan een bestand dat er niet is en loopt het model vast in plaats van opnieuw te rekenen.";

	parameter<Bool>   IsValid  := FileExists && StoredFingerprint == Fingerprint;
	parameter<Bool>   MayReuse := IsValid && !ModelParameters/AlwaysRemakeDecoupledFiles;

	parameter<String> WriterPaths
		:= '../' + replace(Writers, ';', ';../')
	, Descr = "De schrijvers als pad vanaf dit sjabloon gezien. Writers staat in de taal van de gebruiker, dus relatief aan de container waarin het sjabloon staat; een leveranciersverwijzing wordt
				vanaf deze container opgelost, en daarom komt er een niveau omhoog voor.";

	parameter<String> Write_Fingerprint
		:= Fingerprint
	,	StorageName = "=FingerprintFile", StorageType = "str"
	,	ExplicitSuppliers = "=WriterPaths"
	,	Descr = "Hang dit als ExplicitSupplier aan het Make-item. De schrijvers van het bestand hangen op hun beurt onder dit item, zodat het zijbestand pas ontstaat als het bestand er staat en een
				afgebroken run geen geldige fingerprint naast een oud bestand achterlaat (#837).";

	parameter<String> Explanation
		:= 'file=' + FullPath
		+ ' | exists=' + string(FileExists)
		+ ' | stored=[' + StoredFingerprint + ']'
		+ ' | current=[' + Fingerprint + ']'
		+ ' | may_reuse=' + string(MayReuse)
	, Descr = "Vraag dit item op als je wilt weten waarom een bestand wel of niet opnieuw gemaakt wordt.";
}
