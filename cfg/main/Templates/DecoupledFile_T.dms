////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaalt of een ontkoppeld bestand hergebruikt mag worden of opnieuw gemaakt moet worden. De naam van het
// bestand draagt een hash van 8 tekens over de fingerprint, dus elke stand van de invoer krijgt een eigen bestand en
// een wissel van variant overschrijft niets. Naast het bestand komt een zijbestand met dezelfde naam plus .params.txt,
// waarin de waarden staan die de uitkomst bepalen. Het zijbestand ontstaat pas nadat het bestand zelf er staat; de
// items die het bestand schrijven worden als Writers meegegeven en zijn de leveranciers van het zijbestand.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template DecoupledFile_T
: Descr = "Bepaalt of een ontkoppeld bestand hergebruikt mag worden of opnieuw gemaakt moet worden. Gebruik: instantieer naast het bestand dat je ontkoppelt en geef drie dingen mee, het pad zonder hash,
			een fingerprint, en Writers, de naam van het item dat het bestand schrijft, gezien vanuit de container waarin je dit sjabloon zet; schrijft de gebruiker meer dan een bestand of een mmd met meer
			attributen, noem ze dan alle, gescheiden door een puntkomma, en noem data-items en nooit een container of een unit, want een container als leverancier werkt de hele boom eronder bij. Zet de
			gebruikerskant daarna als drieslag neer: attribute<...> Write_X met StorageName = Decoupling_X/StorageFile, attribute<...> Make_X := Write_X met ExplicitSuppliers = Decoupling_X/Write_Fingerprint,
			attribute<...> Read_X met dezelfde StorageName, en attribute<...> X := =!<Iets>Ontkoppeld ? Calc_X : Decoupling_X/MayReuse ? Read_X : Make_X. Schrijft de gebruiker een set bestanden onder een
			fingerprint, geef dan het pad van een van hen mee als peilstok en zet StorageSuffix in de naam van alle bestanden, voor de extensie. Die volgorde van bestand en zijbestand is geen vormkwestie.
			GeoDMS werkt een leverancier bij voordat het item zelf wordt uitgerekend, dus hangt de kaart onder het zijbestand en niet andersom; stond Write_Fingerprint als leverancier aan het schrijvende
			item zelf, dan ontstond het zijbestand aan het begin van de rekentijd en liet een run die daarin afbreekt een geldige fingerprint naast een halve kaart achter (#837). De fingerprint: zet hierin
			alle waarden die de uitkomst bepalen, ook de waarden die al in het pad zitten, bewust dubbelop, zodat de regel geen uitzonderingen kent en het zijbestand een compleet leesbaar verslag is van
			waar het bestand vandaan komt; dus niet alleen ModelParameters, maar ook variantinstellingen, klassenindelingen en de datum of versie van de brondata, want een vergeten determinant laat het
			model stilzwijgend een verouderd bestand gebruiken, en dat is erger dan altijd opnieuw rekenen. Engelse sleutelnamen, gescheiden door een puntkomma, in de vorm sleutel=waarde, bijvoorbeeld
			bgt_date=20260819;study_area=Nederland;variant=BAU. Veiligheid: het mechanisme faalt de goede kant op. Ontbreekt het zijbestand, dan wordt teruggevallen op cfg/no_fingerprint.txt en klopt de
			vergelijking nooit, dus wordt er opnieuw gerekend; ontbreekt het bestand zelf, idem; een Writers die niet oplost valt op bij het rekenen, met exit 1 en ExplicitSupplier niet gevonden, zonder dat
			er een zijbestand ontstaat; en een te lang pad of een afwijkende fingerprint onder dezelfde naam geeft een fout voordat er iets gelezen of geschreven wordt, zie PathGate en NameGate.
			ModelParameters/AlwaysRemakeDecoupledFiles zet het hergebruik in een keer helemaal uit. Bestanden op de share hebben geen sjabloon en geen hash: die dragen hun jaargang of datum in de naam."
{
	parameter<String> FileName;
	parameter<String> Fingerprint;
	parameter<String> Writers;
	//

	container Hash
	: Descr = "Een hash van 8 hexadecimale tekens over de fingerprint: de som over de tekens van code(teken) maal 16807 tot de macht positie, modulo 2^31 - 1. Alleen rekenen met gehele getallen, dus gelijk over
				GeoDMS-versies heen, en dezelfde formule als StringHash_T in NetworkModel_PBL (NetworkModel_PBL#118), daar tot 2047 tekens en hier tot 32.767, omdat een fingerprint met klassenreeksen langer is
				dan 2047. De code van een teken is zijn plaats in Alphabet plus 1, en 0 voor een teken dat er niet in staat, zoals een enkel aanhalingsteken of een byte van een letter met accent;
				een botsing die daardoor of door toeval ontstaat, geeft een fout in NameGate en geen verkeerd bestand."
	{
		parameter<String> Alphabet  := ' !"#$%&()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~';
		parameter<UInt64> P         := uint64(2147483647), Descr = "2^31 - 1, een priemgetal.";
		parameter<UInt64> B         := uint64(16807), Descr = "Een primitieve wortel modulo P, dus de machten verschillen.";

		unit<UInt32> Chars := range(uint32, 0, strlen(Alphabet))
		{
			attribute<String> Char := substr(const(Alphabet, .), id(.), 1);
		}

		parameter<UInt64> B1        := B;
		parameter<UInt64> B2        := B1    * B1    % P;
		parameter<UInt64> B4        := B2    * B2    % P;
		parameter<UInt64> B8        := B4    * B4    % P;
		parameter<UInt64> B16       := B8    * B8    % P;
		parameter<UInt64> B32       := B16   * B16   % P;
		parameter<UInt64> B64       := B32   * B32   % P;
		parameter<UInt64> B128      := B64   * B64   % P;
		parameter<UInt64> B256      := B128  * B128  % P;
		parameter<UInt64> B512      := B256  * B256  % P;
		parameter<UInt64> B1024     := B512  * B512  % P;
		parameter<UInt64> B2048     := B1024 * B1024 % P;
		parameter<UInt64> B4096     := B2048 * B2048 % P;
		parameter<UInt64> B8192     := B4096 * B4096 % P;
		parameter<UInt64> B16384    := B8192 * B8192 % P;

		unit<UInt32> Pos := range(uint32, 0, strlen(Fingerprint))
		{
			attribute<String> Char := substr(const(Fingerprint, .), id(.), 1);
			attribute<UInt64> Code := uint64(MakeDefined(rlookup(Char, Chars/Char) + 1, 0));
			attribute<UInt64> W0   :=        ((id(.) /     1) % 2 == 1 ? B1     : uint64(1));
			attribute<UInt64> W1   := W0   * ((id(.) /     2) % 2 == 1 ? B2     : uint64(1)) % P;
			attribute<UInt64> W2   := W1   * ((id(.) /     4) % 2 == 1 ? B4     : uint64(1)) % P;
			attribute<UInt64> W3   := W2   * ((id(.) /     8) % 2 == 1 ? B8     : uint64(1)) % P;
			attribute<UInt64> W4   := W3   * ((id(.) /    16) % 2 == 1 ? B16    : uint64(1)) % P;
			attribute<UInt64> W5   := W4   * ((id(.) /    32) % 2 == 1 ? B32    : uint64(1)) % P;
			attribute<UInt64> W6   := W5   * ((id(.) /    64) % 2 == 1 ? B64    : uint64(1)) % P;
			attribute<UInt64> W7   := W6   * ((id(.) /   128) % 2 == 1 ? B128   : uint64(1)) % P;
			attribute<UInt64> W8   := W7   * ((id(.) /   256) % 2 == 1 ? B256   : uint64(1)) % P;
			attribute<UInt64> W9   := W8   * ((id(.) /   512) % 2 == 1 ? B512   : uint64(1)) % P;
			attribute<UInt64> W10  := W9   * ((id(.) /  1024) % 2 == 1 ? B1024  : uint64(1)) % P;
			attribute<UInt64> W11  := W10  * ((id(.) /  2048) % 2 == 1 ? B2048  : uint64(1)) % P;
			attribute<UInt64> W12  := W11  * ((id(.) /  4096) % 2 == 1 ? B4096  : uint64(1)) % P;
			attribute<UInt64> W13  := W12  * ((id(.) /  8192) % 2 == 1 ? B8192  : uint64(1)) % P;
			attribute<UInt64> W    := W13  * ((id(.) / 16384) % 2 == 1 ? B16384 : uint64(1)) % P, Descr = "16807 tot de macht positie, modulo P.";
			attribute<UInt64> Term := Code * W;
		}

		parameter<UInt32> Value     := uint32(sum(Pos/Term) % P), IntegrityCheck = "strlen(Fingerprint) < 32768", Descr = "De machten hierboven lopen tot 2^15, dus een langere fingerprint past niet.";
		parameter<String> HexDigits := '0123456789abcdef';
		parameter<String> Hex       :=
			  substr(HexDigits, (Value / 268435456) % 16, 1) + substr(HexDigits, (Value / 16777216) % 16, 1)
			+ substr(HexDigits, (Value /   1048576) % 16, 1) + substr(HexDigits, (Value /    65536) % 16, 1)
			+ substr(HexDigits, (Value /      4096) % 16, 1) + substr(HexDigits, (Value /      256) % 16, 1)
			+ substr(HexDigits, (Value /        16) % 16, 1) + substr(HexDigits,  Value             % 16, 1);
	}

	parameter<UInt32> ExtensionPos
		:= strrpos(FileName, '.')
	, IntegrityCheck = "this > strrpos(FileName, '/')"
	, Descr = "De punt voor de extensie, want de hash komt daarvoor. Zonder extensie valt dit om, want dan zou de hash in een mapnaam terechtkomen.";

	parameter<String> HashedFileName
		:= substr(FileName, 0, ExtensionPos) + '_' + Hash/Hex + substr(FileName, ExtensionPos, strlen(FileName))
	, Descr = "Het pad met de hash voor de extensie, bijvoorbeeld Sloopkosten_Woningen_Y2023_Nederland_1a2b3c4d.tif.";

	parameter<String> FullPath
		:= expand(., HashedFileName)
	, Descr = "Het pad met placeholders al ingevuld. ExistingFile vergelijkt met volledige paden, dus expanderen is nodig voordat je kunt vergelijken.";

	parameter<String> FingerprintFile := FullPath + '.params.txt';

	parameter<Bool>   FileExists
		:= ExistingFile('#missing#', FullPath) == FullPath
	, Descr = "ExistingFile geeft het tweede argument terug als dat bestand benaderbaar is, en anders het eerste. Gelijk aan FullPath betekent dus dat het bestand er staat.";

	parameter<Bool>   FingerprintFileExists := ExistingFile('#missing#', FingerprintFile) == FingerprintFile;

	parameter<String> StoredFingerprint
		:	StorageName     = "=ExistingFile('%projDir%/cfg/no_fingerprint.txt', FingerprintFile)"
		,	StorageType     = "str"
		,	StorageReadOnly = "True"
		,	Descr = "De fingerprint van de vorige keer. De ExistingFile eromheen is geen franje: zonder die terugval bindt GeoDMS storage aan een bestand dat er niet is en loopt het model vast in plaats van opnieuw te rekenen.";

	parameter<UInt32> PathLength
		:= strlen(FullPath) + /ModelParameters/MaxSubPathLength
	, Descr = "De lengte van het langste pad dat bij dit bestand hoort, zie ModelParameters/MaxSubPathLength.";

	parameter<String> PathGate
		:= PathLength <= /ModelParameters/MaxPathLength ? 'ok' : 'too long'
	, IntegrityCheck = "PathLength <= /ModelParameters/MaxPathLength"
	, Descr = "Een fout als het pad te lang wordt voor Windows, voordat er iets gelezen of geschreven wordt. Kort dan de naam van de map boven cfg in, die de LocalData bepaalt.";

	parameter<String> NameGate
		:= !FingerprintFileExists || StoredFingerprint == Fingerprint ? 'ok' : 'other fingerprint'
	, IntegrityCheck = "!FingerprintFileExists || StoredFingerprint == Fingerprint"
	, Descr = "Een fout als er onder deze naam een andere fingerprint staat, voordat er iets gelezen of geschreven wordt. Dat is een botsing van de hash of een met de hand gewijzigd zijbestand; Explanation zet de
				twee fingerprints naast elkaar. Verwijder het bestand en zijn zijbestand als het zijbestand niet klopt. Een bestand zonder zijbestand is geen fout: daar is een run afgebroken, en dat wordt opnieuw gemaakt.";

	parameter<Bool>   IsAllowed := PathGate == 'ok' && NameGate == 'ok';

	parameter<String> StorageFile
		:= IsAllowed ? HashedFileName : ''
	, Descr = "Wat de schrijver en de lezer als StorageName gebruiken. Via IsAllowed, zodat een te lang pad of een afwijkende fingerprint ook een schrijver en een lezer tegenhoudt die zonder MayReuse worden aangeroepen.";

	parameter<String> StorageSuffix
		:= IsAllowed ? '_' + Hash/Hex : ''
	, Descr = "Hetzelfde voor een set bestanden onder een fingerprint: de hash die elk bestand van de set voor zijn extensie krijgt.";

	parameter<Bool>   IsValid  := FileExists && StoredFingerprint == Fingerprint;
	parameter<Bool>   MayReuse := IsAllowed && IsValid && !/ModelParameters/AlwaysRemakeDecoupledFiles;

	parameter<String> WriterPaths
		:= '../' + replace(Writers, ';', ';../')
	, Descr = "De schrijvers als pad vanaf dit sjabloon gezien. Writers staat in de taal van de gebruiker, dus relatief aan de container waarin het sjabloon staat; een leveranciersverwijzing wordt
				vanaf deze container opgelost, en daarom komt er een niveau omhoog voor.";

	parameter<String> Write_Fingerprint
		:= Fingerprint
	,	StorageName = "=FingerprintFile", StorageType = "str"
	,	ExplicitSuppliers = "=WriterPaths"
	,	Descr = "Hang dit als ExplicitSupplier aan het Make-item. De schrijvers van het bestand hangen op hun beurt onder dit item, zodat het zijbestand pas ontstaat als het bestand er staat en een
				afgebroken run geen geldige fingerprint naast een halve kaart achterlaat (#837).";

	parameter<String> Explanation
		:= 'file=' + FullPath
		+ ' | exists=' + string(FileExists)
		+ ' | stored=[' + StoredFingerprint + ']'
		+ ' | current=[' + Fingerprint + ']'
		+ ' | path_length=' + string(PathLength)
		+ ' | may_reuse=' + string(IsValid && !/ModelParameters/AlwaysRemakeDecoupledFiles)
	, Descr = "Vraag dit item op als je wilt weten waarom een bestand wel of niet opnieuw gemaakt wordt. Het staat los van PathGate en NameGate, zodat het ook werkt als een van beide de run tegenhoudt.";
}
