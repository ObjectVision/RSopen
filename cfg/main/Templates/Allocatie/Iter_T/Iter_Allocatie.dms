////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Container waar de daadwerkelijke allocatie in deze iteratie wordt gekozen. Per subsector per cel of de
// geschiktheid boven de afkapgrens ligt. Per subsector per cel de geschiktheid, maar dan 0 als die onder de
// afkapgrens ligt.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Allocatie
: Descr = "Container waar de daadwerkelijke allocatie in deze iteratie wordt gekozen."
{
	parameter<String> sector_domain_name := 'CompactedAdminDomain';
	unit<uint64>      sector_domain      := =sector_domain_name;
	
	container GeschikthedenLiggenBovenAfkapgrenzen :=
		for_each_nedv(
			Subsector/name
			, 'Subsectoren/'+Subsector/name+'/'+sector_domain_name+'/Geschiktheid[uint64] > uint64(Subsectoren/'+Subsector/name+'/AllocRegio/Afkapgrens)[AllocRegio/per_'+sector_domain_name+']'
			, sector_domain
			, bool
		), Descr = "Per subsector per cel of de geschiktheid boven de afkapgrens ligt.";
		
	container GeschikthedenBovenAfkapgrenzen :=
		for_each_nedv(
			Subsector/name
			, 'GeschikthedenLiggenBovenAfkapgrenzen/'+Subsector/name+'
				? Subsectoren/'+Subsector/name+'/'+sector_domain_name+'/Geschiktheid_VoorSubsectorKeuze
				: null_f'
			, sector_domain
			, float32
		), Descr = "Per subsector per cel de score voor de onderlinge subsectorkeuze, of null als die onder de afkapgrens ligt. Voor werken is dit trede-prioriteit plus kans (lexicografisch, ModelParameters/Werken/TredePrioriteitInSubsectorKeuze); voor de overige sectoren de kale geschiktheid, zoals voorheen."
	{
		attribute<Bool> AnyDefined (sector_domain) := = 'OR('+asItemList('IsDefined('+Subsector/name+')')+')';
	}
	
	attribute<Subsector> Resultaat (sector_domain) := = 'GeschikthedenBovenAfkapgrenzen/AnyDefined 
																	? ArgMax('+asItemList('GeschikthedenBovenAfkapgrenzen/'+Subsector/name)+')[Subsector] 
																	: (0/0)[Subsector]', Descr = "De subsector met de hoogste geschiktheid, of undefined als er geen geschiktheid boven de afkapgrens ligt.";
	
	attribute<OP> Resultaat_OP (CompactedAdminDomain) := = lowercase(Sector_name) == lowercase('Wonen')
		? 'merge(value(Resultaat[CompactedAdminDomain/'+sector_domain_name+'_rel], UInt16), OP ,'+asItemList('Subsectoren/'+Subsector/name+'/CompactedAdminDomain/Geschiktheid_ArgMax_OP')+')'
		: 'const(null_b, CompactedAdminDomain, OP)', Descr = "De OP van de subsector die in deze cel het hoogst scoort, of undefined als er geen subsector is.";
	
	attribute<Bool>              Beschikbaar                  (CompactedAdminDomain) := = 'merge(value(Resultaat, UInt16), bool,'+asItemList('Subsectoren/'+Subsector/name+'/CompactedAdminDomain/Beschikbaar')+')', Descr = "Is deze cel ook daadwerkelijk beschikbaar voor allocatie.";
	attribute<OP>                per_OP_initial               (CompactedAdminDomain) := Beschikbaar ? Resultaat_OP : (0/0)[OP], Descr = "De OP van de gealloceerde subsector, of undefined als deze toch niet beschikbaar bleek te zijn.";
	attribute<Sector/xSubsector> per_SectorxSubsector_initial (CompactedAdminDomain) := Beschikbaar ? Subsector/SectorxSubSector_rel[Resultaat] : (0/0)[Sector/xSubsector], Descr = "De SectorxSubsector van de gealloceerde subsector, of undefined als deze toch niet beschikbaar bleek te zijn.";
	attribute<Sector/xSubsector> per_SectorxSubsector_recoll           (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, per_SectorxSubsector_initial);
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Methodiek om smalle linten eruit te filteren, bijvoorbeeld volbouwen van kleinere wegen in de stad.
	
	// Stap 0: waar kijken de vormtoetsen naar? Alleen naar deze iteratie, of ook naar wat er dit zichtjaar al ligt.
attribute<Bool>              AlGealloceerdVoorDitZichtjaar         (AdminDomain) := Context/ThisZichtjaar/AlGealloceerdVoorDitZichtjaar
, Descr = "Wat er bij de start van dit zichtjaar al gealloceerd was, dus in eerdere zichtjaren. Dat telt bewust NIET mee in de vormtoetsen: aangroeien mag binnen een zichtjaar, niet over zichtjaren heen, anders werkt het model zich over een reeks zichtjaren cel voor cel het landschap in. Staat op zichtjaarniveau omdat het binnen een zichtjaar constant is.";

attribute<Bool>              Gealloceerd_DitZichtjaar_AlleSectoren (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, IsDefined(StateVoorAllocatie/SubSector_rel)), FALSE) && !AlGealloceerdVoorDitZichtjaar, Descr = "Alles wat dit zichtjaar al gealloceerd is, door welke sector dan ook. Een woning naast een nieuw bedrijventerrein is geen versnipperde ontwikkeling, dus die mag aanhechten.";

attribute<Bool>              Gealloceerd_DitZichtjaar_EigenSector  (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, MakeDefined(IsDefined(StateVoorAllocatie/SubSector_rel) && lowercase(Sector/xSubsector/Sector_name[StateVoorAllocatie/SubSector_rel]) == lowercase(Sector_name), FALSE)), FALSE) && !AlGealloceerdVoorDitZichtjaar, Descr = "Alleen wat deze sector dit zichtjaar zelf gealloceerd heeft.";

attribute<Bool>              Gealloceerd_EerdereIters              (AdminDomain) := =lowercase(Sector_name) == lowercase('waterberging')
																						? 'Gealloceerd_DitZichtjaar_EigenSector'
																						: 'Gealloceerd_DitZichtjaar_AlleSectoren'
, Descr = "Waterberging telt alleen zijn eigen cellen mee: de minimale clusteromvang is daar een functionele eis, want een bergingsgebied moet zelf groot genoeg zijn om water vast te houden, en dat wordt niet anders van woningen ernaast. Voor de overige sectoren gaat het om versnippering in het landschap, en dan telt elke nieuwe ontwikkeling van dit zichtjaar als aanhechting.";

attribute<Bool>              Gealloceerd_Basis                     (AdminDomain) := IsDefined(per_SectorxSubsector_recoll) || Gealloceerd_EerdereIters
, Descr = "De verzameling waarop de erosie, de dilatie en de districten bepaald worden: de cellen van deze iteratie plus alles wat er dit zichtjaar al ligt, zodat een cluster kan aangroeien. De bestaande bebouwing uit het basisjaar telt hier nooit in mee: zou dat wel zo zijn, dan haalt elke losse cel naast een dorp de toets en is de minimale clusteromvang betekenisloos.";

// Stap 1: Erosie - cel overleeft alleen als alle 8 buren ook gealloceerd zijn
parameter<float32>           BuurCellenEis                                       := ='ModelParameters/MorfologischeCleaning_BuurCellen_'+Sector_name, Descr = "De minimale beukmaat voor deze sector. Staat per sector omdat een bedrijventerrein van 50 meter breed vreemd is en een woonstraat van 50 meter niet.";
attribute<bool>              Eroded                                (AdminDomain) := potential(float32(Gealloceerd_Basis), Distmatrices_25m/pot25m/binair) >= BuurCellenEis + 1f, Descr = "Cel overleeft alleen als een parameteriseerd aantal buren ook gealloceerd zijn.";
// Stap 2: Dilatie - een cel hoort bij het geopende resultaat als minstens een buur de erosie overleefde
attribute<Bool>              Dilated                               (AdminDomain) := potential(float32(Eroded), Distmatrices_25m/pot25m/binair) >= 1f, Descr = "Cel hoort bij het geopende resultaat als minstens een buurcel de erosie overleefde.";
// Stap 3: Originele allocatie AND binnen gedilateerd gebied
attribute<Bool>              Cleaned                               (AdminDomain) := Gealloceerd_Basis && Dilated, Descr = "Originele allocatie AND binnen gedilateerd gebied.";
attribute<bool>              IsAfgewezen_dmv_Morfologie            (AdminDomain) := IsDefined(per_SectorxSubsector_recoll) && NOT(Cleaned), Descr = "Afgewezen door morfologische cleaning. Alleen cellen van deze iteratie kunnen worden afgewezen; wat al gealloceerd was blijft staan.";

unit<uint32> VindAangeslotenCellen := district_8(Cleaned), Descr = "Districten van aaneengesloten gealloceerde cellen."
	{
		attribute<ha>   Oppervlakte                          (AdminDomain) := (pcount(Districts)[float32] * AdminDomain/NrHaPerCell)[Districts];
		attribute<bool> IsNonGroup                           (AdminDomain) := Oppervlakte == const(max(Oppervlakte), AdminDomain) && max(Oppervlakte) >= 0.5f * rdc_meter/areaal; 
		
		parameter<bool> IsWaterbergingSector                               := lowercase(sector_name) == lowercase('waterberging');
		attribute<bool> IsWoonkern                           (AdminDomain) := /SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain;
		parameter<ha>   Minimum_alloc_group_size_Binnenstedelijk           := ='ModelParameters/minimum_alloc_group_size_Binnenstedelijk_'+sector_name;
		parameter<ha>   Minimum_alloc_group_size_Buitenstedelijk           := ='ModelParameters/minimum_alloc_group_size_Buitenstedelijk_'+sector_name;
		
		attribute<bool> IsAllocGroupLargeEnough_Generiek     (AdminDomain) := IsWoonkern
																				? Oppervlakte >= Minimum_alloc_group_size_Binnenstedelijk && NOT(IsNonGroup)
																				: Oppervlakte >= Minimum_alloc_group_size_Buitenstedelijk && NOT(IsNonGroup);
		attribute<bool> IsAllocGroupLargeEnough_Waterberging (AdminDomain) := ='Oppervlakte >= ModelParameters/Minimum_alloc_group_size_Waterberging && NOT(IsNonGroup)';
		attribute<bool> IsAllocGroupLargeEnough              (AdminDomain) := =IsWaterbergingSector ? 'IsAllocGroupLargeEnough_Waterberging' : 'IsAllocGroupLargeEnough_Generiek';
		
		attribute<bool> IsAfgewezen_Generiek                 (AdminDomain) := Cleaned && IsDefined(per_SectorxSubsector_recoll) && (IsWoonkern //Cleaned-conditie: alleen daadwerkelijk gealloceerde cellen afwijzen; anders worden ook kleine niet-gealloceerde gaten (FALSE-districten) cumulatief uitgesloten (#594). De extra conditie op per_SectorxSubsector_recoll houdt cellen uit eerdere iteraties buiten de afwijzing wanneer ClusterToetsCumulatief aanstaat.
																				? Oppervlakte < Minimum_alloc_group_size_Binnenstedelijk && NOT(IsNonGroup)
																				: Oppervlakte < Minimum_alloc_group_size_Buitenstedelijk && NOT(IsNonGroup));
		attribute<bool> IsAfgewezen_Waterberging             (AdminDomain) := ='Cleaned && IsDefined(per_SectorxSubsector_recoll) && Oppervlakte < ModelParameters/Minimum_alloc_group_size_Waterberging && NOT(IsNonGroup)';
		attribute<bool> IsAfgewezen                          (AdminDomain) := =IsWaterbergingSector ? 'IsAfgewezen_Waterberging' : 'IsAfgewezen_Generiek';
	}
	
	attribute<bool>              IsAllocGroupLargeEnough (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, VindAangeslotenCellen/IsAllocGroupLargeEnough);
attribute<bool>              IsAfgewezen             (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, VindAangeslotenCellen/IsAfgewezen) 
																					||  collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, IsAfgewezen_dmv_Morfologie);
	
attribute<bool>              IsAfgewezen_Cumulatief  (CompactedAdminDomain):= = Context/IsFirstIter ? 'IsAfgewezen' : Context/PrevItername+'/Allocatie/IsAfgewezen_Cumulatief || IsAfgewezen', Descr = "Cumulatieve afwijzing over iteraties.";
	
attribute<Sector/xSubsector> per_SectorxSubsector    (CompactedAdminDomain) := IsDefined(per_SectorxSubsector_initial) && IsAllocGroupLargeEnough ? per_SectorxSubsector_initial : null_b, Descr = "SectorxSubsector na controle op groepsgrootte.";
attribute<OP>                per_OP                  (CompactedAdminDomain) := IsDefined(per_OP_initial) && IsAllocGroupLargeEnough ? per_OP_initial : null_b, Descr = "OP na controle op groepsgrootte.";
	
	
}