////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Hier worden de onderdelen voor de subsectoren j bepaald (voor enkel wonen); i.e. beschikbaarheid, suitability
// S_ij, restclaim C_jr, zaaglijn Z_ij. Voor de wiskundige beschrijving zie de URL. Op AdminDomain niveau wordt
// de geschiktheid en beschikbaarheid opgehaald/bepaald. Welk OP, wanneer beschikbaar in land unit i, heeft de
// hoogste suitability S_ij? Dit is gedefinieerd in OP_subdomain, dat is de set van OP die bij de subsector horen
// die in deze template overwogen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template IterSubsector_T_Wonen
: Descr = "Hier worden de onderdelen voor de subsectoren j bepaald (voor enkel wonen); i.e. beschikbaarheid, suitability S_ij, restclaim C_jr, zaaglijn Z_ij. Voor de wiskundige beschrijving zie de URL."
, URL = "https://github.com/ObjectVision/RSopen/wiki/Allocatie-procedure-in-formules"
{
	//
	parameter<Subsector> id;
	unit<UInt8>          Subsector;
	container            StateVoorAllocatie;
	container            Context0;
	//
	
	container Context := Context0
	{
		container ThisSubsector := ..;
	}
	
	parameter<String> name                      := Subsector/name[id];
	parameter<String> Subsector_name            := Subsector/name[id], Descr = "Dezelfde waarde als name, onder een naam die in een subcontainer niet door de eigen-naam-eigenschap wordt afgeschermd; zie IterSubsector_T.";
	parameter<String> Subsector_pathname        := Subsector/Sector_name_Thisname[id];
	parameter<String> Zichtjaar_name            := Context/ThisZichtjaar/name;
	parameter<String> AllocRegio_name           := Context/ThisSectorAllocRegio/AllocRegio_name;

	parameter</Classifications/Vastgoed/WP2xVSSH> WP2xVSSH_rel := rlookup(lowercase(Subsector_name), lowercase(/Classifications/Vastgoed/WP2xVSSH/name));
	parameter<Bool>   IsVrijeSector             := /Classifications/Vastgoed/WP2xVSSH/VSSH_rel[WP2xVSSH_rel] == /Classifications/Vastgoed/VSSH/V/VrijeSector;
	parameter<Bool>   VolgtVrijeSector          := !IsVrijeSector && /ModelParameters/Wonen/SocialeHuur/Bonus > 0f, Descr = "Volgt deze subsector in haar rangorde de nieuwbouw van de vrije sector van dit zichtjaar (#528)? De sociale huur, zolang de bonus in ModelParameters/Wonen/SocialeHuur aanstaat; de vrije sector nooit.";
	parameter<Bool>   HeeftQuotum               := /Classifications/Vastgoed/WP2xVSSH/WP2_rel[WP2xVSSH_rel] == /Classifications/Vastgoed/WP2/V/eengezins
	, Descr = "Geldt hier het quotum per woningtype (#847)? Voor eengezins op elke allocatieregio van wonen, in elke sequentie, met het gebouwde aandeel van de indeling van die regio. Alleen op de
				eerste regio liet de overloop naar COROP en provincie het type vrij, en dat werd bijna altijd rij. Voor meergezins kiest de cel het pakket met het hoogste saldo. Geen schakelaar meer (#870): zonder quotum wijkt de typemix van de eengezinsnieuwbouw landelijk 0,26 af van de bouwpraktijk tegen 0,05 met quotum, ook met de reparaties van #858, #859 en #862.";

	parameter<Bool>   IsPlancapaciteitNogGeldig := ='uint32('+substr(Zichtjaar_name, 1, 4)+') <= uint32(/ModelParameters/Advanced/PlancapaciteitGeldigTotEnMet)', Descr = "Dezelfde vervaldatum als in Templates/Beschikbaarheden/Zeef_T, hier voor de trede (#739).";
	parameter<String> TredeWortel               := 'Context/ThisZichtjaar/Impl/TredeDynamischeUrbanContour'
	, Descr = "Waar de trede-opbouw van dit zichtjaar staat (#749): de opbouw in dit zichtjaar zelf, waarin het bebouwd gebied is aangegroeid met een schijf rond wat er in eerdere zichtjaren is gealloceerd; de statische opbouw in VariantData is het startpunt.";

	parameter<Bool>   PlancapaciteitVervallen   := !IsPlancapaciteitNogGeldig;
	parameter<String> TredeContainer            := PlancapaciteitVervallen ? 'SectorxSubsectoren_ZonderPlancapaciteit' : 'SectorxSubsectoren'
	, Descr = "Welke van de twee trede-opbouwen dit zichtjaar gebruikt (#739): de opbouw op de volle bron, of die op de bron waarin de plancapaciteit is platgelegd. De tredes worden
				zichtjaaronafhankelijk gebouwd, dus staan beide opbouwen klaar en valt de keuze hier, zoals Zeef_T/BasisjaarZeefItem dat voor de zeef doet (#682); tot en met
				PlancapaciteitGeldigTotEnMet in ModelParameters/Advanced wijst dit naar SectorxSubsectoren, en de opbouw die niet gekozen wordt komt niet in de boom.";

	unit<UInt32>      TredeK                    := =TredeWortel+'/'+TredeContainer+'/'+Subsector_pathname+'/Impl/Klasse';
	unit<UInt8>       OP_subdomain              := ='OP/perWP2xVSSH/'+Context/ThisSubsector/name+'/OP_sub';
	unit<UInt8>       OP_sub_NoData             := ='OP/perWP2xVSSH/'+Context/ThisSubsector/name+'/OP_sub_NoData';
	
	container GeschiktheidExpr
	: Descr = "Stringexpressies die de geschiktheid per OP opbouwen. Ze staan hier apart omdat ArgMax en max_elem exact dezelfde expressie moeten gebruiken: lopen die uit elkaar, dan hoort de gerapporteerde geschiktheid niet meer bij het gekozen OP."
	{
		attribute<String> Geschiktheid_perOP_expr (OP_subdomain) :=
			'ThisVariantData/Zeef/'+Zichtjaar_name+'/'+Subsector_pathname+'/Zeef_perOP/'+OP/name[OP_subdomain/org_rel]+'/Beschikbaar_voorOP'
			+ '? ThisVariantData/Suitability/'+Zichtjaar_name+'/'+Subsector_pathname+'/perOP/'+OP/name[OP_subdomain/org_rel]+'/Totaal'
			+ ' + MakeDefined(ThisVariantData/Suitability/'+Zichtjaar_name+'/'+Subsector_pathname+'/perOP/'+OP/name[OP_subdomain/org_rel]+'/Opbrengsten * Context/ThisZichtjaar/Impl/GroenNabijheid/Prijsopslag_perWP4/'+OP/WP4_name[OP_subdomain/org_rel]+', 0f)'
			+ ': (0f/0f)'
		, Descr = "Het exploitatiesaldo van dit OP in deze cel, gecorrigeerd voor de natuur en het water die er aan het begin van dit zichtjaar liggen (#637). De groentermen zitten multiplicatief in de
				hedonische prijs, dus opbrengsten maal (1 + opslag) min kosten is hetzelfde als de prijs opnieuw rekenen met de nieuwe fracties; alleen de opbrengsten worden gecorrigeerd. De opslag is nul
				in het eerste zichtjaar en waar de fracties niet zijn veranderd. De MakeDefined om de correctieterm heen houdt de null-afhandeling intact: alleen Totaal bepaalt of een cel
				undefined is (#598), zodat de IJburg2-proxycellen zonder opbrengsten niet uit de allocatie vallen.";
	}
	
	unit<uint64> CompactedAdminDomain := Geography/CompactedAdminDomain
	, Descr = "Op AdminDomain niveau wordt de geschiktheid en beschikbaarheid opgehaald/bepaald."
	{
		attribute<OP_subdomain> Geschiktheid_ArgMax_OP_sub          :=
			= HeeftQuotum
				? 'Quotum/ArgMax_OP_sub'
				: 'ArgMax_ifdefined('+asItemList(GeschiktheidExpr/Geschiktheid_perOP_expr)+')[OP_subdomain]', Descr = "Welk OP, wanneer beschikbaar in land unit i, heeft de hoogste suitability S_ij? Dit is gedefinieerd in OP_subdomain, dat is de set van OP die bij de subsector horen die in deze template overwogen. Met quotum het pakket van de groep die de cel kiest.";
			
		attribute<Float32>      Geschiktheid_MaxElem_OP_sub         :=
			='max_elem('+asItemList(GeschiktheidExpr/Geschiktheid_perOP_expr)+')', Descr = "Wat is de suitability S_ij die hoort bij het OP die is gevonden in Geschiktheid_ArgMax_OP_sub?";
		
		attribute<OP>           Geschiktheid_ArgMax_OP              := Geschiktheid_ArgMax_OP_sub -> org_rel, Descr = "Vertaling van OP_subdomain naar OP, om te kunnen gebruiken in vergelijking tussen subsectoren.";
		attribute<Bool>         Beschikbaar_OPs                     := = 'OR('+asList('ThisVariantData/Zeef/'+Zichtjaar_name+'/'+Subsector_pathname+'/Zeef_perOP/'+OP_subdomain/name+'/Beschikbaar_voorOP', ',')+')', Descr = "Is land unit i beschikbaar voor tenminste een van alle OPs?";
		attribute<Bool>         Beschikbaar_Init                    := Beschikbaar_OPs
		                                                               && !/Classifications/Actor/Sector/xSubsector/LegtCelVast[StateVoorAllocatie/SubSector_rel]
		                                                               && !RestrictiesVoorSectorenAlsGevolgVanVervuilendWerken/IsNietToegestaan
		                                                               && !ExtraRestrictieDoorHuidigeZonneweide
		                                                               && !RestrictiesVoorSectorenAlsGevolgVanWind/Restrictief_voor_kwestbare_gebouwen, Descr = "Is land unit i beschikbaar voor een OP en niet al eerder dit of vorige zichtjaren gealloceerd, en niet niet nog een additionele restrictie door wind allocatie?";
		
		attribute<Bool>         Beschikbaar_NaAfgewezenClusters     := ='Beschikbaar_Init && NOT('+Context/PrevItername+'/Allocatie/IsAfgewezen_Cumulatief)'
		, Descr = "Een afgewezen cel blijft de rest van deze sector-allocregio uitgesloten. Twee mildere varianten zijn geprobeerd en allebei afgevallen, zie ObjectVision/RSopen#643: terugkomen zodra er een gealloceerde buur is laat de allocatie volledig vastlopen, en terugkomen zodra de erosiedrempel gehaald zou worden levert per saldo niets op.";
		attribute<Bool>         Beschikbaar                         := = Context/ThisIter_rel >= ModelParameters/Advanced/IterVanafWaarWeAfgewezenCellenUitsluitenInAlloc
		                                                               ? 'Beschikbaar_NaAfgewezenClusters'
		                                                               : 'Beschikbaar_Init';
		
		attribute<Float32>      PotentieleStateNaAllocatie          := MakeDefined(OP/Dichtheid[Geschiktheid_ArgMax_OP], 0f) * float32(Beschikbaar) * AdminDomain/NrHaPerCell, Descr = "Zoek bij het OP met die kan en de hoogste S heeft de bijbehorende dichtheid op, check nog eens op beschikbaarheid, en vertaal dichtheid per ha naar AdminDomain naar ", IntegrityCheck = "Check_of_IsBestOPOokDaarBeschikbaar";
		attribute<Bool>         Check_of_IsBestOPOokDaarBeschikbaar := ='IsNull(Geschiktheid_ArgMax_OP_sub)' //of er niks in die cell
		                                                               '|| OR('+asItemList('Geschiktheid_ArgMax_OP_sub == '+string(id(OP_subdomain))+'[OP_subdomain]' //of de gekozen OP daar ook mag.
		                                                                       '&& ThisVariantData/Zeef/'+Zichtjaar_name+'/'+Subsector_pathname+'/Zeef_perOP/'+OP_subdomain/name+'/Beschikbaar_voorOP')+')', Descr = "Extra check of voor de gekozen OP die land unit i daadwerkelijk beschikbaar is.";
		
		attribute<Float32>      Geschiktheid_Cleaned                := Geschiktheid_MaxElem_OP_sub == 0f ? null_f : Geschiktheid_MaxElem_OP_sub, Descr = "Als de geschiktheid 0 is, willen we dit undefined hebben.";
		attribute<Float32>      Geschiktheid_VoorSubsectorKeuze     := = HeeftQuotum ? 'Quotum/Geschiktheid_VoorSubsectorKeuze' : 'Geschiktheid_Cleaned', Descr = "Score voor de keuze tussen subsectoren in Iter_Allocatie; voor wonen de kale geschiktheid, met quotum die van het pakket van de groep die de cel kiest (de werken-variant telt hier de plancapaciteit-prioriteit bij op).";
		attribute<UInt32>       Geschiktheid_Ordered                := invert(index(Geschiktheid_Cleaned))[uint32], Descr = "In het allocatie proces moet de geschiktheid gesorteerd worden, zodat er greedy vanaf de meest geschikte locatie gealloceerd wordt.";
		attribute<Float32>      VolgScore                           := = VolgtVrijeSector ? 'Context/ThisIter/VrijeSectorNieuwbouw/Score' : 'const(0f, CompactedAdminDomain)', Descr = "Het deel van de bonus dat voor de cel geldt, naar de vrije-sectornieuwbouw van dit zichtjaar binnen Straal (#528). Alleen gevuld voor een subsector die volgt; de telling zelf staat per iteratie in Iter_T.";
		attribute<UInt32>       Geschiktheid_Rang                   := = VolgtVrijeSector ? 'Geschiktheid_Ordered + uint32(float32(Geschiktheid_Ordered) * /ModelParameters/Wonen/SocialeHuur/Bonus * VolgScore)' : 'Geschiktheid_Ordered'
		, Descr = "De rang waarmee de cel de zaaglijn in gaat: de rang van het saldo, voor een volgende subsector verhoogd met de bonus maal de score van de cel (#528). Zonder bonus letterlijk Geschiktheid_Ordered, zodat de uitkomst dan tot op de bit die van voor #528 is.";
		parameter<Uint64>       Geschiktheid_Ordered_range          := Uint64(max(Geschiktheid_Rang)+100), Descr = "Wat is de maximale rang, plus een getal wat er voor zorgt dat er later geen dubbele waarden kunnen voorkomen.";
		attribute<UInt32>       TredeScore                          := (#TredeK - 1) - collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, TredeK/Per_AdminDomain)
																, Descr = "Tredes introduceren een volgordelijkheid in groepen cellen, zodat onafhankelijk van de geschiktheid sommige groepen cellen boven andere geplaatst worden, bijvoorbeeld dichtbij een
																		OV-knooppunt. Hier wordt die volgorde voorbereid, met een check of de maximale waarde van een trede kleiner of gelijk is aan de cardinaliteit van de tredes. De IntegrityCheck toetst exact de
																		term die hierboven wordt afgetrokken, TredeK/Per_AdminDomain over CompactedAdminDomain, en niet de AllocDomain-variant: dat zijn verschillende verzamelingen cellen, en een toets op de andere
																		kan slagen terwijl de aftrekking onder nul gaat en in UInt32 omslaat (#605).", IntegrityCheck = "max(collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, TredeK/Per_AdminDomain)) < #TredeK";
		attribute<Uint64>       Geschiktheid                        := Uint64(Beschikbaar) * (Uint64(TredeScore) * Geschiktheid_Ordered_range + Uint64(Geschiktheid_Rang)), Descr = "Hier wordt de sorteerde geschiktheid gecombineerd met de tredescores tot een aangepaste geschiktheid in groepen per trede.";
		attribute<Bool>         LigtBovenAfkapgrens                 := = HeeftQuotum
		                                                               ? 'Quotum/LigtBovenAfkapgrens'
		                                                               : 'Geschiktheid > AllocRegio/Afkapgrens[AllocRegio/per_CompactedAdminDomain]', Descr = "Wil deze subsector de cel in deze iteratie hebben? Zonder quotum ligt de geschiktheid boven de zaaglijn van de regio, met quotum boven die van een van de woningtypegroepen. Iter_Allocatie kiest daarna tussen de subsectoren.";
	}

	container Quotum
	: Descr = "Het quotum per woningtype binnen eengezins (#847), alleen in gebruik als HeeftQuotum. De restclaim van deze subsector wordt per regio verdeeld over de groepen uit
				ModelParameters/Wonen/WoningtypeEengezins naar het gebouwde aandeel, en elke groep krijgt een eigen zaaglijn over de pakketten van haar type. Binnen een iteratie kiest een groep alleen uit de
				cellen die de groepen ervoor hebben laten liggen, zodat geen cel naar twee groepen gaat. Het vrijstaande deel van de eengezinsclaim van sociale huur en vrije sector samen komt bij de vrije sector.
				Waar de grond opraakt, schuift SchaarseGrond een deel van het vrijstaande doel naar de groep die per woning de minste grond vraagt."
	{
		unit<UInt8>             Groep                                := /ModelParameters/Wonen/WoningtypeEengezins/Groep;

		attribute<Groep>        Groep_rel_perOP       (OP_subdomain) := rlookup(OP/WP4_rel[OP_subdomain/org_rel], Groep/WP4_rel), Descr = "De groep van elk pakket van deze subsector, naar zijn woningtype.";
		attribute<UInt32>       AantalPakketten              (Groep) := uint32(pcount(Groep_rel_perOP));

		unit<UInt8> ActieveGroep := select_with_org_rel(HeeftQuotum && AantalPakketten > 0 && (IsVrijeSector || !Groep/AlleenVrijeSector))
		, Descr = "De groepen die deze subsector vult: met een pakket van dat type in de set van de subsector, en een groep die alleen de vrije sector vult alleen bij de vrije sector. Leeg zonder quotum, zodat er dan niets wordt aangemaakt."
		{
			attribute<String> name        := Groep/name[org_rel];
			attribute<Bool>   IsExclusief := Groep/AlleenVrijeSector[org_rel];
			attribute<Bool>   Wijkt       := Groep/WijktOpSchaarseGrond[org_rel];
			attribute<String> Vorige_name := id(.) == 0b ? '' : name[id(.) - min_elem(id(.), 1b)], Descr = "De groep die binnen een iteratie voor deze groep kiest; leeg voor de eerste.";
		}
		parameter<UInt32>       AantalNietExclusief                  := sum(uint32(!ActieveGroep/IsExclusief));
		parameter<Bool>         Verschuift                           := HeeftQuotum && sum(uint32(ActieveGroep/Wijkt)) > 0 && sum(uint32(!ActieveGroep/Wijkt)) > 0
		, Descr = "Kan deze subsector op schaarse grond doel van groep naar groep verschuiven: is er een groep die wijkt en een die het deel kan krijgen? Alleen de vrije sector, want sociale huur vult geen vrijstaande groep.";

		unit<UInt8> OntvangendeGroep := select_with_org_rel(!ActieveGroep/Wijkt)
		, Descr = "De groepen die het deel van een wijkende groep kunnen krijgen; per regio krijgt de groep die per woning de minste grond vraagt het (SchaarseGrond/Ontvanger)."
		{
			attribute<String> name := ActieveGroep/name[org_rel];
		}
		attribute<Float32>      AandeelWijkend          (AllocRegio) := ='const(0f, AllocRegio)'+AsList(ActieveGroep/Wijkt ? ' + Groepen/'+ActieveGroep/name+'/Aandeel' : '', '');

		unit<UInt8> EengezinsSubsector := select_with_org_rel(/Classifications/Vastgoed/WP2xVSSH/WP2_rel == /Classifications/Vastgoed/WP2/V/eengezins)
		{
			attribute<String> name := /Classifications/Vastgoed/WP2xVSSH/name[org_rel];
		}

		attribute<Bool>         IsNieuw       (CompactedAdminDomain) := IsDefined(StateVoorAllocatie/OP_rel) && IsNull(Context/ThisSectorAllocRegio/StateVoorAllocatie/OP_rel)
		, Descr = "Draagt de cel een pakket dat zij aan het begin van deze sectorallocregio nog niet droeg? Dan is zij in een eerdere iteratie van deze regel gealloceerd.";

		attribute<Float32>      Gealloceerd             (AllocRegio) := ='sum(StateVoorAllocatie/'+Subsector_pathname+' * float32(IsNieuw), AllocRegio/Per_CompactedAdminDomain)'
		, Descr = "De woningen van deze subsector die deze sectorallocregio al heeft gealloceerd.";
		attribute<Float32>      Doel                    (AllocRegio) := max_elem(AllocRegio/RestClaim + Gealloceerd, 0f)
		, Descr = "Wat deze subsector in deze sectorallocregio bouwt: de restclaim plus wat al gealloceerd is, dus de restclaim aan het begin van de regel plus wat er sindsdien is gesloopt.";
		attribute<Float32>      DoelEengezins           (AllocRegio) := ='add('+AsItemList('Context/ThisIter/Subsectoren/'+EengezinsSubsector/name+'/Quotum/Doel')+')'
		, Descr = "Het doel van vrije sector en sociale huur samen, waarover het aandeel van een groep die alleen de vrije sector vult wordt genomen.";

		attribute<Float32>      AandeelExclusief        (AllocRegio) := ='const(0f, AllocRegio)'+AsList(ActieveGroep/IsExclusief ? ' + Groepen/'+ActieveGroep/name+'/Aandeel' : '', '');
		attribute<Float32>      AandeelNietExclusief    (AllocRegio) := ='const(0f, AllocRegio)'+AsList(ActieveGroep/IsExclusief ? '' : ' + Groepen/'+ActieveGroep/name+'/Aandeel', '');
		attribute<Float32>      DoelExclusief           (AllocRegio) := min_elem(AandeelExclusief * DoelEengezins, Doel)
		, Descr = "Het deel voor de groepen die alleen de vrije sector vult: hun aandeel in het eengezinsdoel van vrije sector en sociale huur samen, begrensd op het doel van deze subsector. Nul bij sociale huur.";

		container               Groepen                              :=
			for_each_ne(
				ActieveGroep/name
				, 'Groep_T('+string(ActieveGroep/org_rel)+'[Groep], '+quote(ActieveGroep/Vorige_name)+')'
			), Descr = "Per groep een zaaglijn over de pakketten van haar type, in de volgorde van ActieveGroep.";

		attribute<OP_subdomain> ArgMax_OP_sub (CompactedAdminDomain) := =AsList('Groepen/'+ActieveGroep/name+'/Boven ? Groepen/'+ActieveGroep/name+'/ArgMax_OP_sub : ', '')+'const(0b/0b, CompactedAdminDomain, OP_subdomain)'
		, Descr = "Het pakket van de groep die de cel kiest; null waar geen groep haar kiest.";
		attribute<Float32>      Geschiktheid_VoorSubsectorKeuze (CompactedAdminDomain) := =AsList('Groepen/'+ActieveGroep/name+'/Boven ? Groepen/'+ActieveGroep/name+'/Geschiktheid_Cleaned : ', '')+'null_f'
		, Descr = "Het saldo van dat pakket, voor de keuze tussen subsectoren in Iter_Allocatie.";
		attribute<Bool>         LigtBovenAfkapgrens (CompactedAdminDomain) := ='const(FALSE, CompactedAdminDomain)'+AsList(' || Groepen/'+ActieveGroep/name+'/Boven', '')
		, Descr = "Ligt de cel boven de zaaglijn van een van de groepen? De groepen sluiten elkaar per cel uit, dus het is er hooguit een.";

		container SchaarseGrond
		: Descr = "Het quotum op schaarse grond (#847; welke groep wijkt staat in ModelParameters/Wonen/WoningtypeEengezins/Groep/WijktOpSchaarseGrond). Elke iteratie wordt de restclaim van elke woonsubsector en woningtypegroep omgerekend
					naar hectares met de dichtheid die haar pakketten halen op de grond waar zij kan landen, en opgeteld tot het ruimtebeslag van wonen. Dat gaat tegen de bruikbare grond in. Komt het
					ruimtebeslag hoger uit, dan gaat een deel van de restclaim van de wijkende groepen naar de ontvanger tot het past, maar niet meer dan de wijkende groepen nog moeten bouwen en de
					ontvanger nog kwijt kan. De verschuiving telt op over de iteraties van de sectorallocregio en gaat niet terug, want de grond raakt alleen op; met grond genoeg is zij nul."
		{
			attribute<Float32>      Potentieel                 (AllocRegio) := = HeeftQuotum ? 'const(0f, AllocRegio)' : 'sum(CompactedAdminDomain/PotentieleStateNaAllocatie, AllocRegio/Per_CompactedAdminDomain)'
			, Descr = "Zonder quotum de woningen die de beste pakketten van deze subsector op alle beschikbare cellen samen zouden zetten. Met quotum niet nodig, en daar hangt PotentieleStateNaAllocatie van de zaaglijnen af.";
			attribute<Ha>           Ruimtebeslag               (AllocRegio) := = HeeftQuotum
			                                                                      ? 'const(0[Ha], AllocRegio)'+AsList(' + Groepen/'+ActieveGroep/name+'/Ruimtebeslag', '')
			                                                                      : '(Potentieel > 0f ? max_elem(AllocRegio/RestClaim, 0f) * AllocRegio/Beschikbaar[float32] / Potentieel : 0f) * 1[Ha]'
			, Descr = "De hectares die de restclaim van deze subsector vraagt: met quotum de som over de groepen, zonder quotum de restclaim gedeeld door de woningen per hectare op de beschikbare grond.";
			attribute<Ha>           RuimtebeslagWonen          (AllocRegio) := ='const(0[Ha], AllocRegio)'+AsList(' + Context/ThisIter/Subsectoren/'+Subsector/name+'/Quotum/SchaarseGrond/Ruimtebeslag', '')
			, Descr = "Het ruimtebeslag van alle woonsubsectoren samen, want ze dingen naar dezelfde grond.";

			attribute<Bool>         Beschikbaar      (CompactedAdminDomain) := ='const(FALSE, CompactedAdminDomain)'+AsList(' || Context/ThisIter/Subsectoren/'+Subsector/name+'/CompactedAdminDomain/Beschikbaar', '')
			, Descr = "De cellen die in deze iteratie voor ten minste een woonsubsector beschikbaar zijn.";
			attribute<Bool>         Basis                     (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Beschikbaar, FALSE) || Context/ThisIter/Allocatie/Gealloceerd_EerdereIters
			, Descr = "De verzameling waarop de vormtoets hier rekent: alle beschikbare cellen alsof ze bebouwd worden, plus wat er dit zichtjaar al ligt, zoals Iter_Allocatie/Gealloceerd_Basis.";
			attribute<Bool>         Geerodeerd                (AdminDomain) := potential(float32(Basis), /Geography/Distmatrices_25m/pot25m/binair) >= /ModelParameters/Advanced/MorfologischeCleaning_BuurCellen_Wonen + 1f;
			attribute<Bool>         Opgeschoond               (AdminDomain) := Basis && potential(float32(Geerodeerd), /Geography/Distmatrices_25m/pot25m/binair) >= 1f, Descr = "De erosie en dilatie van Iter_Allocatie, met de beukmaat van wonen.";
			unit<UInt32>            Cluster                                 := district_8(Opgeschoond)
			{
				attribute<Ha>       Oppervlakte               (AdminDomain) := (pcount(Districts)[float32] * AdminDomain/NrHaPerCell)[Districts];
			}
			attribute<Bool>         Bruikbaar                 (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Beschikbaar, FALSE)
			                                                                   && (Context/ThisIter/Allocatie/IsVrijgekomenPerceel || Opgeschoond && (/SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain
			                                                                       ? Cluster/Oppervlakte >= /ModelParameters/Advanced/Minimum_alloc_group_size_Binnenstedelijk_Wonen
			                                                                       : Cluster/Oppervlakte >= /ModelParameters/Advanced/Minimum_alloc_group_size_Buitenstedelijk_Wonen))
			, Descr = "De beschikbare cellen die door de vormtoets van Iter_Allocatie zouden komen als alles bebouwd wordt: in een opgeschoond cluster dat groot genoeg is, of op een vrijgekomen perceel.
						Fragmenten die de toets nooit halen tellen niet als grond, want een volle regio kan daar niet op bouwen.";
			attribute<Bool>         Bruikbaar_c      (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Bruikbaar);
			attribute<Ha>           Bruikbaar_ha               (AllocRegio) := sum_uint32(Bruikbaar_c, AllocRegio/Per_CompactedAdminDomain)[float32] * AdminDomain/NrHaPerCell;
			attribute<Ha>           Tekort                     (AllocRegio) := max_elem(RuimtebeslagWonen - Bruikbaar_ha, 0[Ha]), Descr = "Hoeveel hectare het ruimtebeslag van wonen boven de bruikbare grond uitkomt.";

			attribute<Float32>      RestClaimWijkend           (AllocRegio) := ='const(0f, AllocRegio)'+AsList(ActieveGroep/Wijkt ? ' + max_elem(Groepen/'+ActieveGroep/name+'/RestClaimVorige, 0f)' : '', '');
			attribute<Ha>           RuimtebeslagWijkend        (AllocRegio) := ='const(0[Ha], AllocRegio)'+AsList(ActieveGroep/Wijkt ? ' + Groepen/'+ActieveGroep/name+'/Ruimtebeslag' : '', '');
			attribute<OntvangendeGroep> Ontvanger              (AllocRegio) := = #OntvangendeGroep <= 1
			                                                                      ? 'const(0b, AllocRegio, OntvangendeGroep)'
			                                                                      : 'ArgMax('+AsItemList('(Groepen/'+OntvangendeGroep/name+'/Over > 0f ? MakeDefined(Groepen/'+OntvangendeGroep/name+'/Dichtheid, 0f) : 0f)')+')[OntvangendeGroep]'
			, Descr = "De groep die per woning de minste grond vraagt: de hoogste dichtheid op de grond waar zij kan landen, onder de groepen die daar nog woningen kwijt kunnen. Dat kan per iteratie wisselen.";
			attribute<Float32>      DichtheidOntvanger         (AllocRegio) := ='const(0f, AllocRegio)'+AsList(' + float32(Ontvanger == '+string(id(OntvangendeGroep))+'[OntvangendeGroep]) * MakeDefined(Groepen/'+OntvangendeGroep/name+'/Dichtheid, 0f)', '');
			attribute<Float32>      RuimteOntvanger            (AllocRegio) := ='const(0f, AllocRegio)'+AsList(' + float32(Ontvanger == '+string(id(OntvangendeGroep))+'[OntvangendeGroep]) * Groepen/'+OntvangendeGroep/name+'/Over', '');
			attribute<Float32>      BesparingPerWoning         (AllocRegio) := RestClaimWijkend > 0f && DichtheidOntvanger > 0f ? RuimtebeslagWijkend[float32] / RestClaimWijkend - 1f / DichtheidOntvanger : 0f
			, Descr = "De hectares die een woning minder vraagt als zij bij de ontvanger komt in plaats van bij de wijkende groepen.";
			attribute<Float32>      Erbij                      (AllocRegio) := BesparingPerWoning > 0f ? min_elem(min_elem(Tekort[float32] / BesparingPerWoning, RestClaimWijkend), RuimteOntvanger) : 0f
			, Descr = "De woningen die in deze iteratie van de wijkende groepen naar de ontvanger gaan: zoveel dat het ruimtebeslag van wonen op de bruikbare grond past.";
			attribute<Float32>      Vorige                     (AllocRegio) := = Context/IsFirstIter ? 'const(0f, AllocRegio)' : Context/PrevItername+'/Subsectoren/'+Subsector_name+'/Quotum/SchaarseGrond/Verschuiving'
			, Descr = "De verschuiving tot en met de vorige iteratie van deze sectorallocregio; nul in de eerste.";
			attribute<Float32>      Verschuiving               (AllocRegio) := Vorige + Erbij, Descr = "De woningen die tot en met deze iteratie van de wijkende groepen zijn verschoven; elke ontvangende groep houdt bij wat zij ervan kreeg (Groep_T/Ontvangen).";
		}

		Template Groep_T
		{
			parameter<Groep>  Groep_rel;
			parameter<String> Vorige_name;
			//

			parameter<String>       Groep_name                                  := Groep/name[Groep_rel];
			parameter<Bool>         IsExclusief                                 := Groep/AlleenVrijeSector[Groep_rel];

			unit<UInt8> OP_groep := select_with_org_rel(Groep_rel_perOP == Groep_rel)
			, Descr = "De pakketten van deze subsector met het woningtype van deze groep."
			{
				attribute<String> Expr := GeschiktheidExpr/Geschiktheid_perOP_expr[org_rel];
			}

			attribute<OP_groep>     ArgMax_OP_groep      (CompactedAdminDomain) := ='ArgMax_ifdefined('+AsItemList(OP_groep/Expr)+')[OP_groep]', Descr = "Het pakket van deze groep met het hoogste saldo; dezelfde expressies als het pakket zonder quotum, beperkt tot de groep.";
			attribute<OP_subdomain> ArgMax_OP_sub        (CompactedAdminDomain) := ArgMax_OP_groep -> org_rel;
			attribute<Float32>      MaxElem              (CompactedAdminDomain) := ='max_elem('+AsItemList(OP_groep/Expr)+')';
			attribute<Float32>      Geschiktheid_Cleaned (CompactedAdminDomain) := MaxElem == 0f ? null_f : MaxElem;
			attribute<UInt32>       Geschiktheid_Ordered (CompactedAdminDomain) := invert(index(Geschiktheid_Cleaned))[uint32], Descr = "De rang van het saldo, iteratie-invariant zoals CompactedAdminDomain/Geschiktheid_Ordered; de beschikbaarheid telt pas mee in Geschiktheid.";
			attribute<UInt32>       Geschiktheid_Rang    (CompactedAdminDomain) := = VolgtVrijeSector ? 'Geschiktheid_Ordered + uint32(float32(Geschiktheid_Ordered) * /ModelParameters/Wonen/SocialeHuur/Bonus * CompactedAdminDomain/VolgScore)' : 'Geschiktheid_Ordered', Descr = "De rang met de bonus naar de score van de cel, zoals CompactedAdminDomain/Geschiktheid_Rang (#528).";
			parameter<UInt64>       Geschiktheid_Ordered_range                  := UInt64(max(Geschiktheid_Rang)+100);

			attribute<Bool>         BezetVoor            (CompactedAdminDomain) := = Vorige_name == '' ? 'const(FALSE, CompactedAdminDomain)' : 'Groepen/'+Vorige_name+'/BezetNa', Descr = "De cellen die een eerdere groep in deze iteratie al kiest.";
			attribute<Bool>         Beschikbaar          (CompactedAdminDomain) := CompactedAdminDomain/Beschikbaar && IsDefined(ArgMax_OP_groep) && !BezetVoor, Descr = "Beschikbaar voor deze subsector, met een beschikbaar pakket van deze groep, en niet al door een eerdere groep gekozen.";
			attribute<UInt64>       Geschiktheid         (CompactedAdminDomain) := UInt64(Beschikbaar) * (UInt64(CompactedAdminDomain/TredeScore) * Geschiktheid_Ordered_range + UInt64(Geschiktheid_Rang)), Descr = "Dezelfde opbouw als CompactedAdminDomain/Geschiktheid: eerst de trede, daarbinnen het saldo.";
			attribute<Float32>      PotentieleStateNaAllocatie (CompactedAdminDomain) := MakeDefined(OP/Dichtheid[ArgMax_OP_sub -> org_rel], 0f) * float32(Beschikbaar) * AdminDomain/NrHaPerCell, Descr = "De woningen die het pakket van deze groep op de cel zet.";

			attribute<Float32>      Aandeel                        (AllocRegio) := ='/BaseData/StartState/WoningtypeEengezins/PerIndeling/'+AllocRegio_name+'/Aandeel/'+Groep_name+AllocRegio_StudyArea_orgrel, Descr = "Het gebouwde aandeel van deze groep in de eengezinsnieuwbouw van de regio.";
			attribute<Float32>      DoelAandeel                    (AllocRegio) := = IsExclusief
			                                                                       ? '(Quotum/AandeelExclusief > 0f ? Aandeel / Quotum/AandeelExclusief : 0f) * Quotum/DoelExclusief'
			                                                                       : '(Quotum/AandeelNietExclusief > 0f ? Aandeel / Quotum/AandeelNietExclusief : 1f / float32(Quotum/AantalNietExclusief)) * (Quotum/Doel - Quotum/DoelExclusief)'
			, Descr = "Het deel van het doel van deze subsector voor deze groep naar het gebouwde aandeel: een groep die alleen de vrije sector vult deelt in DoelExclusief, de andere groepen delen de rest naar hun onderlinge aandeel.";
			parameter<Bool>         Wijkt                                       := Groep/WijktOpSchaarseGrond[Groep_rel];
			parameter<OntvangendeGroep> Ontvanger_id                            := rlookup(Groep_name, OntvangendeGroep/name), Descr = "Deze groep in OntvangendeGroep; leeg voor een groep die wijkt.";
			attribute<Float32>      DeelWijkend                    (AllocRegio) := Quotum/AandeelWijkend > 0f ? Aandeel / Quotum/AandeelWijkend : 0f, Descr = "Voor een wijkende groep: haar deel van SchaarseGrond/Verschuiving, naar haar aandeel onder de wijkende groepen.";
			attribute<Float32>      OntvangenVorige                (AllocRegio) := = Context/IsFirstIter ? 'const(0f, AllocRegio)' : Context/PrevItername+'/Subsectoren/'+Subsector_name+'/Quotum/Groepen/'+Groep_name+'/Ontvangen';
			attribute<Float32>      Ontvangen                      (AllocRegio) := OntvangenVorige + float32(Quotum/SchaarseGrond/Ontvanger == Ontvanger_id) * Quotum/SchaarseGrond/Erbij
			, Descr = "De woningen die deze groep tot en met deze iteratie van de wijkende groepen kreeg; nul voor een wijkende groep, want die staat niet in OntvangendeGroep.";
			attribute<Float32>      DoelVorige                     (AllocRegio) := = !Quotum/Verschuift ? 'DoelAandeel' : Wijkt ? 'DoelAandeel - DeelWijkend * Quotum/SchaarseGrond/Vorige' : 'DoelAandeel + OntvangenVorige'
			, Descr = "Het doel met de verschuiving tot en met de vorige iteratie, waarop deze iteratie het ruimtebeslag meet.";
			attribute<Float32>      Doel                           (AllocRegio) := = !Quotum/Verschuift ? 'DoelAandeel' : Wijkt ? 'DoelAandeel - DeelWijkend * Quotum/SchaarseGrond/Verschuiving' : 'DoelAandeel + Ontvangen'
			, Descr = "Het doel van deze groep: het deel naar het gebouwde aandeel, met de verschuiving op schaarse grond. Waar niets verschuift, of met de schakelaar uit, is het DoelAandeel.";
			attribute<Float32>      Gealloceerd                    (AllocRegio) := ='sum(StateVoorAllocatie/'+Subsector_pathname+' * float32(Quotum/IsNieuw && OP/WP4_rel[StateVoorAllocatie/OP_rel] == Groep/WP4_rel[Groep_rel]), AllocRegio/Per_CompactedAdminDomain)'
			, Descr = "De woningen van deze groep die deze sectorallocregio al heeft gealloceerd.";
			attribute<Float32>      RestClaim                      (AllocRegio) := Doel - Gealloceerd;
			attribute<Float32>      RestClaimVorige                (AllocRegio) := DoelVorige - Gealloceerd;

			attribute<Bool>         Kan                  (CompactedAdminDomain) := CompactedAdminDomain/Beschikbaar && IsDefined(ArgMax_OP_groep)
			, Descr = "Kan deze groep de cel nemen, wat de groepen ervoor in deze iteratie ook kiezen? De grondmaat van SchaarseGrond; die mag niet van de zaaglijnen afhangen, want het doel hangt van haar af.";
			attribute<Ha>           Kan_ha                         (AllocRegio) := sum_uint32(Kan, AllocRegio/Per_CompactedAdminDomain)[float32] * AdminDomain/NrHaPerCell;
			attribute<Float32>      Capaciteit                     (AllocRegio) := sum(MakeDefined(OP/Dichtheid[ArgMax_OP_sub -> org_rel], 0f) * float32(Kan) * AdminDomain/NrHaPerCell, AllocRegio/Per_CompactedAdminDomain), Descr = "De woningen die het beste pakket van deze groep op al die cellen samen zou zetten.";
			attribute<Float32>      Dichtheid                      (AllocRegio) := Kan_ha > 0[Ha] ? Capaciteit / Kan_ha[float32] : null_f, Descr = "De woningen per hectare die deze groep in de regio haalt, gemiddeld over de grond waar zij kan landen.";
			attribute<Ha>           Ruimtebeslag                   (AllocRegio) := (Dichtheid > 0f ? max_elem(RestClaimVorige, 0f) / Dichtheid : 0f) * 1[Ha], Descr = "De hectares die de restclaim van deze groep vraagt.";
			attribute<Float32>      CapaciteitBruikbaar            (AllocRegio) := sum(MakeDefined(OP/Dichtheid[ArgMax_OP_sub -> org_rel], 0f) * float32(Kan && Quotum/SchaarseGrond/Bruikbaar_c) * AdminDomain/NrHaPerCell, AllocRegio/Per_CompactedAdminDomain), Descr = "Hetzelfde als Capaciteit, op de bruikbare grond van SchaarseGrond.";
			attribute<Float32>      Over                           (AllocRegio) := max_elem(CapaciteitBruikbaar - max_elem(RestClaimVorige, 0f), 0f), Descr = "Hoeveel woningen deze groep op haar bruikbare grond nog kwijt kan boven haar eigen restclaim; zoveel kan zij als ontvanger hooguit krijgen.";

			attribute<Ha>           Beschikbaar_ha                 (AllocRegio) := sum_uint32(Beschikbaar, AllocRegio/Per_CompactedAdminDomain)[float32] * AdminDomain/NrHaPerCell;
			attribute<Bool>         GeenRuimteOfRestclaim          (AllocRegio) := Beschikbaar_ha == 0[ha] || RestClaim <= 0[float32];
			parameter<UInt64>       MaxGeschiktheid_value                       := max(Geschiktheid);
			attribute<UInt64>       Afkapgrens0                    (AllocRegio) := MaxGeschiktheid_value - nth_element_weighted(
			                                                                               MaxGeschiktheid_value - Geschiktheid
			                                                                               , max_elem(RestClaim, 0f)
			                                                                               , PotentieleStateNaAllocatie
			                                                                               , collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, AllocRegio/Per_AdminDomain)
			                                                                       ), Descr = "De zaaglijn van deze groep, zoals AllocRegio/Afkapgrens0 voor de subsector.";
			attribute<UInt64>       Afkapgrens                     (AllocRegio) := GeenRuimteOfRestclaim ? null_u64 : MakeDefined(Afkapgrens0, 0u64);

			attribute<Bool>         Boven                (CompactedAdminDomain) := Geschiktheid > Afkapgrens[AllocRegio/Per_CompactedAdminDomain], Descr = "Kiest deze groep de cel?";
			attribute<Bool>         BezetNa              (CompactedAdminDomain) := BezetVoor || Boven;
		}
	}
	
	unit<UInt32> AllocRegio := Context/ThisSectorAllocRegio/AllocRegio
	, Descr = ""
	{
		attribute<Float32> RestClaim             := = replace(
		                                                'ThisVariantData/Claims/'+Scenario_name+'/Zichtjaren/@Z@/SectorAllocRegios/@AS@/@S@'+AllocRegio_StudyArea_orgrel+' - sum(StateVoorAllocatie/@SP@, Per_CompactedAdminDomain)',
		                                                '@Z@' , Zichtjaar_name,
		                                                '@AS@', Context/ThisSectorAllocRegio/name,
		                                                '@S@' , Context/ThisSubsector/name,
		                                                '@SP@', Subsector_pathname
		                                            ), Descr = "Hier de restclaim C_jr bepaald, door van de claim voor deze regio en subsector de stand voor deze allocatie stap af te trekken.";
		
		attribute<Ha>      Beschikbaar           := sum_uint32(CompactedAdminDomain/Beschikbaar, Per_CompactedAdminDomain)[float32] * AdminDomain/NrHaPerCell, Descr = "Aggregatie van beschikbaarheid in AdminDomain middels R_ir uitgedrukt in hectare.";
		attribute<Bool>    GeenRuimteOfRestclaim := Beschikbaar == 0[ha] || RestClaim <= 0[float32], Descr = "Is geen ruimte in deze regio, of er geen of een negatieve restclaim?";
		
		attribute<UInt64>  MaxGeschiktheid       := max(CompactedAdminDomain/Geschiktheid, collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, AllocRegio/Per_AdminDomain)), Descr = "Wat is de maximale geschiktheid in deze regio?";
		parameter<UInt64>  MaxGeschiktheid_value := max(CompactedAdminDomain/Geschiktheid), Descr = "Overall maximale geschiktheid.";
		
		attribute<UInt64>  Afkapgrens0           := MaxGeschiktheid_value - nth_element_weighted(                 // omkering
		                                                    MaxGeschiktheid_value - CompactedAdminDomain/Geschiktheid                              // rank
		                                                    , max_elem(RestClaim, 0f)                                                              // target
		                                                    , CompactedAdminDomain/PotentieleStateNaAllocatie                                      // weight, hier geen potentiele delta gebruikt; evt sloop van deze subsector heralloceren we in volgende iteraties
		                                                    , collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain // R_ir
		                                                    )
		                                            ), Descr = "hier wordt de zaaglijn Z_ij bepaald.";
		
		attribute<UInt64>  Afkapgrens            := GeenRuimteOfRestclaim ? null_u64 : MakeDefined(Afkapgrens0, 0u64), Descr = "Als er uberhaupt geen ruimte of restclaim is voor deze regio, dan mag de zaaglijn undefined zijn. Anders neem je de zaaglijn. Echter, de zaaglijn kan undefined zijn als de niet genoeg cellen beschikbaar zijn om de claim te realisteren. In dat geval wordt de zaagzlijn zo gezet dat alle cellen daarin vallen.";
	}
}