// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Voorbereiding state voor allocatie, met name het opstellen van de update expressies voor de verschillende
// sectoren De expressie die gebruikt wordt om de state te updaten voor deze sector/subsector in deze regio
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template StatePrep_T
: Descr = "Voorbereiding state voor allocatie, met name het opstellen van de update expressies voor de verschillende sectoren"
{
	parameter<Sector/xSubsector> id;
	container ThisIter;
	//
	
	parameter<String> Expr := = 'lowercase(ThisIter/Context/ThisSectorAllocRegio/Sector_name) == '+Quote(lowercase(Sector/xSubsector/Sector_name)[id])+' && lowercase(ThisIter/Context/ThisSectorAllocRegio/Sector_name) == lowercase(''Landbouw'')
									? ThisCasus/Impl/Update_Expr_DiscrAlloc
									: lowercase(ThisIter/Context/ThisSectorAllocRegio/Sector_name) == '+lowercase(Quote(Sector/xSubsector/Sector_name[id]))+'
										? ThisCasus/Impl/Update_Expr 
										: '+VerdringingsTak, Descr = "De expressie die gebruikt wordt om de state te updaten voor deze sector/subsector in deze regio";
	
	parameter<String> VerdringingsTak := Sector/xSubsector/IsVerzorgendWerken[id]
		? 'lowercase(ThisIter/Context/ThisSectorAllocRegio/Sector_name) != lowercase(''Wonen'')
				? ThisCasus/Impl/Verdring_Expr
				: /ModelParameters/Werken/VerzorgendInWoonOP
					? (/ModelParameters/Werken/VerzorgendBlijftBijWoningbouw ? ThisCasus/Impl/BehoudPlusOP_Expr : ThisCasus/Impl/VerdringPlusOP_Expr)
					: (/ModelParameters/Werken/VerzorgendBlijftBijWoningbouw ? ThisCasus/Impl/Behoud_Expr      : ThisCasus/Impl/Verdring_Expr)'
		: 'ThisCasus/Impl/Verdring_Expr'
	, Descr = "Wat er met de stand van deze subsector gebeurt wanneer een andere sector de cel wint. Standaard verdringing, dus slopen. Voor de verzorgende werksubsectoren zijn er uitzonderingen wanneer wonen de winnende sector is, de twee maatregelen van #710: VerzorgendBlijftBijWoningbouw laat staan wat er stond, VerzorgendInWoonOP legt de bezetting van het ontwikkelpakket als ondergrens ernaast, en samen doen ze allebei. Staan ze allebei uit, dan is dit gewoon verdringing.

				De keuze staat hier als losse tak omdat de subsector al bij het bouwen van de configuratie vastligt terwijl de winnende sector pas tijdens de allocatie bekend is. Dat is ook precies waarom de takken als tekst worden gekozen en niet als berekening: alleen de gekozen tak belandt in de expressie van Result, zodat de OP-tak met zijn verwijzing naar Allocatie/per_OP nooit wordt geparseerd in een blok waar wonen niet de winnende sector is en die per_OP dus niet bestaat.";
	
	unit<Float32> ValuesUnit := = Sector/xSubsector/ValUnit_ref[id];
	attribute<ValuesUnit> Result (CompactedAdminDomain) := = replace(Expr, '@S@', Sector/xSubsector/Sector_name[id], '@SS@', Sector/xSubsector/Subsector_name[id]), Descr = "De expressie die gebruikt wordt om de state te updaten voor deze sector/subsector in deze regio";
}