// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Extra restricties door wind allocatie zijn nodig wanneer er in voorgaande stappen wind is Gealloceerd. Dus in
// seq0 is dat nooit het geval, want wind komt als laatste. En als er uberhaupt geen wind gealloceerd wordt.
// Wanneer er geen wind wordt gealloceerd, en huidige windmolen voor altijd blijven staan, moeten we die wel
// netjes uitsluiten van voor nieuwe wonen/werken/verblijfsrec allocatie Wanneer er geen zon wordt gealloceerd,
// en huidige zonneweide voor altijd blijven staan, moeten we die wel netjes uitsluiten van voor nieuwe
// wonen/werken/verblijfsrec allocatie
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Sequence_T : using = "Classifications/modellering;Classifications/Actor"
{
	//
	parameter<Sequence> id;
	container StateVoorAllocatie;
	container Context0;
	parameter<Bool> IsSeq0;
	unit<UInt8> SectorAllocRegio;
	unit<UInt8> Sequence;
	container Impl0;
	//
	
	parameter<String> name := Sequence/name[id];
	
	container Context := Context0
	{
		container ThisSequence := ..;
		parameter<String> ThisSequencename := Sequence/name[id];
	}
	
	parameter<Bool> ExtraRestrictieDoorWindAllocatieNodig                       := lowercase(name) != lowercase('Seq_0') && ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector, Descr = "Extra restricties door wind allocatie zijn nodig wanneer er in voorgaande stappen wind is Gealloceerd. Dus in seq0 is dat nooit het geval, want wind komt als laatste. En als er uberhaupt geen wind gealloceerd wordt.";
	parameter<Bool> ExtraRestrictieDoorHuidigeWindNodig                         := NOT(ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector), Descr = "Wanneer er geen wind wordt gealloceerd, en huidige windmolen voor altijd blijven staan, moeten we die wel netjes uitsluiten van voor nieuwe wonen/werken/verblijfsrec allocatie";
	attribute<Bool> ExtraRestrictieDoorHuidigeZonneweide (CompactedAdminDomain) := =NOT(ModelParameters/SectorAllocRegio/Uq_Sectors/HasZonSector)
																					? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/StartState/StateBasisjaar/Src/Zon/Totaal > 0[MW])'
																					: 'const(FALSE, CompactedAdminDomain)', Descr = "Wanneer er geen zon wordt gealloceerd, en huidige zonneweide voor altijd blijven staan, moeten we die wel netjes uitsluiten van voor nieuwe wonen/werken/verblijfsrec allocatie";
	
	//extra restrictie voor de allocatie van nieuwe windturbines! Oftewel, niet de restrictie voor andere sectoren. 
	attribute<Bool> ExtraRestrictieDoorWindAllocatie     (CompactedAdminDomain) := =ExtraRestrictieDoorWindAllocatieNodig
																					? 'Impl/ExtraRestrictieDoorWindAllocatie/IsNietToegestaan'
																					: ExtraRestrictieDoorHuidigeWindNodig
																						? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ThisVariantData/Wind_restricties/Dynamisch/Bestaande_turbines/IsNietToegestaan_basis)'
																						: 'const(FALSE, CompactedAdminDomain)';
	
	container Impl := Impl0
	{
		container ExtraRestrictieDoorWindAllocatie
		{
			parameter<String> Gealloceerd_str                         := ExtraRestrictieDoorWindAllocatieNodig
																			? 'StateVoorAllocatie/Wind/Totaal > 0f'
																			: 'const(FALSE, CompactedAdminDomain)';
			attribute<Bool> Gealloceerd        (CompactedAdminDomain) := = Gealloceerd_str;
			attribute<Bool> Gealloceerd_buffer (CompactedAdminDomain) := = ExtraRestrictieDoorWindAllocatieNodig
																			? 'Buffer/proximity_res'
																			: 'const(FALSE, CompactedAdminDomain)';
			
			container Buffer := ='Templates/Allocatie/Buffer_gridcel_T(Gealloceerd,  ModelParameters/Wind/AantalKeerWerpafstandRestrictieHuidigeTurbines[float64] * ThisVariantClassifications/WindTurbineType/RotorDiameter[float64])';
			
			attribute<Bool> IsNietToegestaan (CompactedAdminDomain) := Gealloceerd_buffer;
		}
	}
	
	parameter<Bool> IsSkeletonZichtjaar := Context/ThisZichtjaar/IsSkeletonZichtjaar, Descr = "Draait het zichtjaar waar deze sequentie in zit in de verkorte opzet? Zie ModelParameters/Skeleton.";

	attribute<UInt8> AantalItersDitJaar (SectorAllocRegio) :=
		  IsSkeletonZichtjaar
			? SectorAllocRegio/ItersNaXZichtjaar
			: IsSeq0
				? SectorAllocRegio/AantalIters
				: SectorAllocRegio/AantalItersInLaterSeq
	, Descr = "Het aantal iteraties dat elke sectorallocregio in deze sequentie krijgt.

				In een skeleton-zichtjaar geldt de kolom ItersNaXZichtjaar voor beide sequenties, en niet de gewone kolommen. Dat is bedoeld: een regel die dan met een iteratie draait hoort dat in de eerste en in de vervolgsequentie te doen, anders krijgt de vervolgsequentie er via AantalItersInLaterSeq alsnog vijf.

				Een nul uit die kolom wordt hier nooit doorgegeven. SectorAllocRegio_T maakt van dat aantal een Iter-unit met range(uint8, 0b, AantalIters), en die zou dan leeg zijn waarna last() op niets uitkomt. Regels met nul worden een niveau lager overgeslagen, in StateNaAllocatie, en krijgen hier de max_elem eronder als ondergrens zodat de aanroep geldig blijft.";

	container SectorAllocRegios :=
		for_each_ne(
			SectorAllocRegio/name
			,'SectorAllocRegio_T(
				SectorAllocRegio
				,'+string(id(SectorAllocRegio))+'[SectorAllocRegio]
				,'+SectorAllocRegio/PrevState+'
				, Context
				, '+string(max_elem(AantalItersDitJaar, 1b))+'[uint8]
				, Impl
			)'
		), Descr = "Maakt voor elke SectorAllocRegio een SectorAllocRegio_T-instantie aan (met de betreffende referentie, id, PrevState, Context, aantal iteraties en implementation-overrides). Latere sequenties krijgen AantalItersInLaterSeq; tot augustus 2026 werd hier voor elke sequentie AantalIters doorgegeven en was die tabelkolom dode configuratie.

					Sinds september 2026 loopt het aantal via AantalItersDitJaar, dat in een skeleton-zichtjaar de kolom ItersNaXZichtjaar volgt. De max_elem op 1 is een vangnet, geen keuze: een overgeslagen regel houdt hier formeel een iteratie zodat de Iter-unit geldig blijft, maar die iteratie wordt nooit uitgerekend omdat StateNaAllocatie voor die regel de NoAlloc-tak kiest en niets de container Iters dan opvraagt.";
	
	container StateNaAllocatie := = #SectorAllocRegio > 0 ? 'SectorAllocRegios/'+last(SectorAllocRegio/name)+'/StateNaAllocatie' : 'StateVoorAllocatie', Descr = "Dit verwijst naar de StateNaAllocatie van de laatste verwerkte regio of naar StateVoorAllocatie als er geen regio's zijn.";
}