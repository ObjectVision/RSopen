////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Een zichtjaar binnen een allocatiecasus, met daarin de state voor en na allocatie, en de sequenties om
// verdringing in latere jaren te kunnen heralloceren. noemer voor verandering door van werkdichtheid (banen/cel)
// in bestaand gebied. Eenheid is job, maar Impliciet aantal jobs per cell. Dus dichtheid. uitkomst in job/m2,
// factor gaat over groei m2/job. Src=job/m2
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Zichtjaar_T
: Descr = "Een zichtjaar binnen een allocatiecasus, met daarin de state voor en na allocatie, en de sequenties om verdringing in latere jaren te kunnen heralloceren."
{
	parameter<String> name;
	container         StateVoorAllocatie0;
	container         Impl0;
	//
	parameter<YearRange> Zichtjaar_value := rjoin(lowercase(name), lowercase(Time/Zichtjaar/name), Time/Zichtjaar/YearRange_rel);
	unit<UInt8>          LandgebruikType := /Classifications/Grondgebruik/LandgebruikType, Descr = "De classificatie van de stand-administratie landgebruik (#751) onder de korte naam die StateVoorAllocatie/Landgebruik en Impl/GroenNabijheid/Bron gebruiken; de using van Templates opent Classifications/Grondgebruik niet.";
	unit<UInt32>         WonenRegio      := = '/SourceData/' + /ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_path, Descr = "De fijnste indeling waarop wonen alloceert, uit de eerste woonregel van ModelParameters/SectorAllocRegio (#392).";
	unit<UInt32>         WerkenRegio     := = '/SourceData/' + /ModelParameters/SectorAllocRegio/WerkenEersteAllocRegio_path, Descr = "De fijnste indeling waarop werken alloceert, uit de eerste werkregel van ModelParameters/SectorAllocRegio (#392).";

	container StateVoorAllocatie := StateVoorAllocatie0
	{
		container Landgebruik
		: Descr = "De stand-administratie landgebruik waarmee dit zichtjaar de allocatie in gaat (#751). In het eerste zichtjaar landt hier de exogene oplegging: elke cel die een beheertype of een landbouwklasse krijgt opgelegd, krijgt dat type in de state, met dit zichtjaar als jaar van verandering. Daarna wordt alleen doorgegeven; de iteratie zet het jaar bij de eerste allocatie van een cel. Dezelfde plek en dezelfde eenmaligheid als het legen van de woningvoorraad in Wonen hieronder."
		{
			parameter<Bool> IsEersteZichtjaar                      := first(lowercase(Time/Zichtjaar/name)) == lowercase(name);
			parameter<Yr>   Jaar                                   := UInt16(right(name, 4))[Yr];
			attribute<LandgebruikType> Exo (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, MakeDefined(LandgebruikType/Van_INL[ThisVariantData/ExogeenOpleggen/Beheertype], LandgebruikType/Van_LandbouwType[ThisVariantData/ExogeenOpleggen/LandbouwType_rel])), Descr = "Wat de oplegging deze cel aan type geeft: het beheertype van de natuur- en waterstroom, anders het landbouwtype van de landbouwstroom, anders niets.";
			attribute<LandgebruikType> Type (CompactedAdminDomain) := = IsEersteZichtjaar ? 'MakeDefined(Exo, StateVoorAllocatie0/Landgebruik/Type)' : 'StateVoorAllocatie0/Landgebruik/Type';
			attribute<Yr>   JaarVerandering (CompactedAdminDomain) := = IsEersteZichtjaar ? 'IsDefined(Exo) ? Jaar : StateVoorAllocatie0/Landgebruik/JaarVerandering' : 'StateVoorAllocatie0/Landgebruik/JaarVerandering';
		}

		attribute<bool>    WordtGesloopt   (CompactedAdminDomain) := ='/VariantData/'+variant_name+'/Sloop/Totaal', Descr = "Wijkt de bestaande bebouwing in deze cel? Een verwijzing en geen eigen som: de vraag wordt beantwoord in VariantData/<variant>/Sloop, waar ook staat hoe sloop zich verhoudt tot opleggen en tot op slot zetten. Hier stond dezelfde expressie los opgeschreven, naast een tweede kopie in Templates/Indicatoren, en de twee heetten net niet hetzelfde.";
		attribute<Bool>    DoorAllocatieGegeven (CompactedAdminDomain) := MakeDefined(StateVoorAllocatie0/Landgebruik/JaarVerandering, 0[Yr]) > UInt16(/ModelParameters/Model_StartYear)[Yr], Descr = "Draagt de cel een label dat de allocatie zelf gaf? Een label uit de startstand heeft het basisjaar als jaar van verandering, een label van de allocatie het zichtjaar waarin het gegeven is.";
		attribute<Bool>    IsNijverheid    (CompactedAdminDomain) := StateVoorAllocatie0/SubSector_rel == /Classifications/Actor/Sector/xSubsector/v/Werken_Nijverheid && DoorAllocatieGegeven;
		attribute<Bool>    IsLogistiek     (CompactedAdminDomain) := StateVoorAllocatie0/SubSector_rel == /Classifications/Actor/Sector/xSubsector/v/Werken_Logistiek && DoorAllocatieGegeven;
		container          BufferNijverheid                       := /Templates/Allocatie/Buffer_gridcel_T(IsNijverheid, /ModelParameters/Wonen/MilieuCat/Buffer_rond_Nijverheid[float64]);
		container          BufferLogistiek                        := /Templates/Allocatie/Buffer_gridcel_T(IsLogistiek, /ModelParameters/Wonen/MilieuCat/Buffer_rond_Logistiek[float64]);
		attribute<Bool>    KanWonenTerug   (CompactedAdminDomain) := = 'ThisVariantData/Zeef/' + name + '/Wonen/Beschikbaar'
		                                                             + (ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector ? ' && !BufferNijverheid/proximity_res && !BufferLogistiek/proximity_res' : '')
		, Descr = "Mag er na de sloop weer wonen komen? De zeef van wonen laat de cel toe voor minstens een pakket, en de cel ligt niet in de buffer rond nijverheid of logistiek die de allocatie zelf heeft gegeven, dezelfde buffer die de allocatie van wonen in elke stap oplegt (SectorAllocRegio_T/RestrictiesVoorSectorenAlsGevolgVanVervuilendWerken).";
		attribute<Float32> StandVoorHerontwikkeling  (WonenRegio) := ='add(' + asList('sum(StateVoorAllocatie0/Wonen/' + WP2xVSSH/name + ', WonenRegio/Per_CompactedAdminDomain)', ',') + ')', Descr = "De woningvoorraad per regio van wonen aan het begin van het zichtjaar, voordat de herontwikkeling iets sloopt.";
		attribute<Bool>    RegioHeeftVraag (CompactedAdminDomain) := MakeDefined(RestClaims/Wonen/Totaal_Claim[WonenRegio/Per_CompactedAdminDomain] > StandVoorHerontwikkeling[WonenRegio/Per_CompactedAdminDomain], FALSE), Descr = "Haalt de regio van wonen van de cel zijn claim voor wonen nog niet? Verdichtende sloop-nieuwbouw voegt woningen toe en vraagt dus vraag. In een regio die zijn claim al haalt gaat geen perceel plat, want de allocatie zou er niets terugbouwen; na 2060, als de claims stilstaan, blijft zo'n regio constant (#869).";
		attribute<Bool>    Herontwikkeling (CompactedAdminDomain) := = ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector
		                                                             ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ThisVariantData/Herontwikkelingskans/PerZichtjaar/' + name + '/IsVrij_AdminDomain) && !MakeDefined(/Classifications/Actor/Sector/xSubsector/LegtCelVast[StateVoorAllocatie0/SubSector_rel], FALSE) && KanWonenTerug && RegioHeeftVraag'
		                                                             : 'const(FALSE, CompactedAdminDomain)'
		, Descr = "Wordt de cel in dit zichtjaar herontwikkeld (#869)? De cel ligt op een perceel dat de herontwikkelingskans uiterlijk in dit zichtjaar vrij liet, draagt nog geen label dat hem vastlegt, wonen mag er terugkomen (KanWonenTerug), en de regio heeft nog vraag naar woningen (RegioHeeftVraag). De
					kans is geschat op wat er in de BAG werkelijk is gesloopt en met meer woningen teruggebouwd, dus een vrij perceel wordt gesloopt voordat de allocatie begint: de woningen gaan uit de stand,
					de restclaim van de regio stijgt met hetzelfde aantal, en de allocatie bouwt ze terug, bij voorkeur op het perceel zelf (bovenaan de ladder, vrij van de vormtoets, van de zeefdrempel en
					van de eis van tien procent dichtheidstoename) en anders elders in de regio. Een cel waar wonen niet terug mag komen blijft staan, want de allocatie zou er niets terugbouwen. Een perceel dat in een eerder zichtjaar is geleegd en nog niet bebouwd blijft leeg en bovenaan de ladder.";
		attribute<Bool>    WordtGeleegd    (CompactedAdminDomain) := (first(lowercase(Time/Zichtjaar/name)) == lowercase(name) && WordtGesloopt) || Herontwikkeling, Descr = "Gaan de woningen en hun footprint in deze cel voor de allocatie van dit zichtjaar op nul? In het eerste zichtjaar door de opgelegde sloop van de variant, in elk zichtjaar door de herontwikkelingskans.";

		container Wonen := 
			for_each_nedv(
				WP2xVSSH/name
				, (ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector) //om te kunnen rekenen zonder wonen als sectorAllocRegio
					? 'WordtGeleegd
						? 0[Woning]
						: StateVoorAllocatie0/Wonen/'+WP2xVSSH/name
					: 'StateVoorAllocatie0/Wonen/'+WP2xVSSH/name
				, CompactedAdminDomain
				, Woning
			), Descr = "De woningvoorraad waarmee dit zichtjaar de allocatie in gaat. In het eerste zichtjaar worden de cellen uit WordtGesloopt geleegd, en in elk zichtjaar de cellen van de percelen die de herontwikkelingskans in dat zichtjaar vrij laat (Herontwikkeling, #869); de zeef houdt de opgelegde sloop daarna leeg, en een vrijgekomen perceel staat bovenaan de ladder tot het bebouwd is."
		{
			attribute<Woning> Totaal (CompactedAdminDomain) := ='add('+asItemList(WP2xVSSH/name)+')';
			attribute<m2PandFootprint> Footprint (CompactedAdminDomain) := = (ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector)
			                                                               ? 'WordtGeleegd ? 0[m2PandFootprint] : StateVoorAllocatie0/Wonen/Footprint'
			                                                               : 'StateVoorAllocatie0/Wonen/Footprint'; //footprint mee legen met de woningen in de gesloopte cellen (#596)
		}
		
		container Werkdichtheid
		: Descr = "De aanpassing van de werkdichtheid in de bestaande cellen voordat werken alloceert (#784): de banen per cel gedeeld door 1 plus de groeifactor van het ruimtebeslag per baan maal Impl/AantalJarenWerkGroeiAanpassing. Wat de aanpassing
					toevoegt, wordt per regio van werken begrensd op het tekort vlak voor de aanpassing, de claim min de banen na de BAG-nieuwbouw (#922), want banen gaan in het model niet weg en zonder die
					begrenzing kwam de stand boven de claim waar die minder groeit dan de aanpassing. Wat de aanpassing weghaalt, blijft onbegrensd. De claim van de verzorgende subsectoren volgt de woningen,
					en die van dit zichtjaar zijn op dit moment nog niet gealloceerd; daarom begrenst dit op de claim met de woningen van voor de allocatie (Werken_VoorAllocatie in de claims)."
		{
			container VoorAanpassing :=
				for_each_nedv(
					Jobs6/name
					, Impl/IsEersteZichtjaar //legen alleen in het eerste zichtjaar, conform wonen; daarna houdt de zeef deze cellen leeg (#596)
						? 'WordtGesloopt ? 0[Job] : MakeDefined(StateVoorAllocatie0/Werken/'+Jobs6/name+', 0[Job])'
						: 'MakeDefined(StateVoorAllocatie0/Werken/'+Jobs6/name+', 0[Job])'
					, CompactedAdminDomain
					, job
				), Descr = "De banen per cel na de BAG-nieuwbouw en voor de aanpassing; in het eerste zichtjaar zonder de cellen uit WordtGesloopt.";
			container Aangepast :=
				for_each_nedv(
					Jobs6/name
					, 'MakeDefined(VoorAanpassing/'+Jobs6/name+' / (1f + (VariantParameters/VariantK/GroeiFootprintPerBaan_'+Jobs6/name+'[VariantParameters/VariantK/V/'+Variant_name+'] * Impl/AantalJarenWerkGroeiAanpassing)), 0[Job])'
					, CompactedAdminDomain
					, job
				), Descr = "De banen per cel na de aanpassing, nog zonder begrenzing.";
			container Erbij :=
				for_each_nedv(
					Jobs6/name
					, 'max_elem(Aangepast/'+Jobs6/name+' - VoorAanpassing/'+Jobs6/name+', 0[Job])'
					, CompactedAdminDomain
					, job
				), Descr = "Wat de aanpassing per cel toevoegt; nul bij een subsector waar de aanpassing banen weghaalt.";
			container Claim :=
				for_each_nedv(
					Jobs6/name
					, replace('ThisVariantData/Claims/'+Scenario_name+'/Zichtjaren/@Z@/AllocRegios/'+/ModelParameters/SectorAllocRegio/WerkenEersteAllocRegio_name+'/Werken_VoorAllocatie/'+Jobs6/name, '@Z@', Context/ThisZichtjaar_name)
					, WerkenRegio
					, job
				), Descr = "De banenclaim per regio van werken, met de woningen van voor de allocatie van dit zichtjaar.";
			container Tekort :=
				for_each_nedv(
					Jobs6/name
					, 'max_elem(Claim/'+Jobs6/name+' - sum(VoorAanpassing/'+Jobs6/name+', WerkenRegio/Per_CompactedAdminDomain), 0[Job])'
					, WerkenRegio
					, job
				), Descr = "De claim min de banen voor de aanpassing, per regio van werken en nooit negatief.";
			container Deel :=
				for_each_nedv(
					Jobs6/name
					, 'MakeDefined(min_elem(float32(Tekort/'+Jobs6/name+') / float32(sum(Erbij/'+Jobs6/name+', WerkenRegio/Per_CompactedAdminDomain)), 1f), 1f)'
					, WerkenRegio
					, Float32
				), Descr = "Het deel van wat de aanpassing in de regio toevoegt dat binnen het tekort past, hooguit 1; ook 1 waar de aanpassing niets toevoegt.";
		}

		container          Werken0                                :=
			for_each_nedv(
				Jobs6/name
				, NOT(ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector) //om te kunnen rekenen zonder werken als sectorAllocRegio
					? 'const(0[Job], CompactedAdminDomain)'
					: 'Werkdichtheid/Aangepast/'+Jobs6/name+' - (1f - MakeDefined(Werkdichtheid/Deel/'+Jobs6/name+'[WerkenRegio/Per_CompactedAdminDomain], 1f)) * Werkdichtheid/Erbij/'+Jobs6/name
				, CompactedAdminDomain
				, job
			), Descr = "De banen per bestaande cel waarmee werken dit zichtjaar de allocatie in gaat: na de aanpassing van de werkdichtheid, met wat die toevoegt begrensd op het tekort van de regio (Werkdichtheid, #922). Een cel buiten de regio's van werken houdt de aanpassing zonder begrenzing.";
		
		container Werken := Werken0, Descr = "uitkomst in job/m2, factor gaat over groei m2/job. Src=job/m2"
		{
			attribute<job> Zak_dienstverlening (CompactedAdminDomain) := Werken0/Zak_dienstverlening, Descr = "Ongewijzigd: de bureaudeling verhoogt niet het aantal kantoorbanen per bestaande cel (#668), want het aantal banen is exogeen en de
						claimvariabele, dus bureaudeling hoort de ruimtevraag van dezelfde banen te verlagen. Die werking loopt langs de dichtheid, zie de kantoor-override in Templates/Densities/DichtheidZichtjaar_T (#590).";
		}

		container          PandFootprint                          :=
			for_each_nedv(
				Jobs6/name
				, (ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector) && first(lowercase(Time/Zichtjaar/name)) == lowercase(name)
					? 'WordtGesloopt
						? 0[m2PandFootprint]
						: StateVoorAllocatie0/PandFootprint/'+Jobs6/name
					: 'StateVoorAllocatie0/PandFootprint/'+Jobs6/name
				, CompactedAdminDomain
				, m2PandFootprint
			), Descr = "Werk-pandfootprint mee legen met de banen in de gesloopte cellen (#596).";

		parameter<String>  Legen_Expr                             := first(lowercase(Time/Zichtjaar/name)) == lowercase(name) ? 'WordtGesloopt ? 0[float32] : ' : '', Descr = "Het begin van de expressie voor verblijfsrecreatie en zon hieronder: legen alleen in het eerste zichtjaar, conform wonen (#596).";
		container          Verblijfsrecreatie                     := = ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector
		                                                             ? 'for_each_nedv(VerblijfsrecreatieK/Subsector_name, '+quote(Legen_Expr+'StateVoorAllocatie0/Verblijfsrecreatie/')+'+VerblijfsrecreatieK/Subsector_name, CompactedAdminDomain, float32)'
		                                                             : '/Templates/Leeg'
		, Descr = "Verblijfsrecreatie mee legen in de gesloopte cellen, conform wonen en werken (#596). Leeg zonder de sector, want dan bestaat VerblijfsrecreatieK niet (pbl-nl/model-RSopen#53).";

		container Wind
		: Descr = "Windmolens in dit zichtjaar. Twee dingen kunnen ze wegnemen: de afschrijving op leeftijd en de sloop, net als bij wonen, werken, verblijfsrecreatie en zon; zonder de sloop bleef een turbine staan in een cel waar nieuwe natuur werd opgelegd, telde hij mee als gerealiseerd vermogen in de restclaim en legde hij met zijn werpafstandsbuffer ruimte vast."
		{
			attribute<Bool>  MoetWindmolenAfgebrokenWorden (CompactedAdminDomain) := jaartal_ingebruikname_0 + ModelParameters/Wind/WindmolenAfschrijving < UInt16(right(name, 4)), Descr = "Als de jaartal ingebruikname + afschrijving kleiner is dan het zichtjaar, moet de windmolen worden afgebroken";
			attribute<Yr>    jaartal_ingebruikname_0 (CompactedAdminDomain) := StateVoorAllocatie0/Wind/jaartal_ingebruikname, Descr = "Het jaartal van ingebruikname van de windmolen in het vorige zichtjaar";
			attribute<Bool>  WijktVoorSloop        (CompactedAdminDomain) := WordtGesloopt && first(lowercase(Time/Zichtjaar/name)) == lowercase(name), Descr = "Wijkt de turbine voor de sloop? Alleen in het eerste zichtjaar, conform de andere sectoren; daarna houdt de zeef de cel leeg.";
			attribute<Yr>    jaartal_ingebruikname (CompactedAdminDomain) := WijktVoorSloop ? (0/0)[Yr] : ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector && MoetWindmolenAfgebrokenWorden ? (0/0)[Yr] : jaartal_ingebruikname_0, Descr = "Het jaartal van ingebruikname van de windmolen in dit zichtjaar, of undefined als de windmolen is afgebroken";
			attribute<MW>    Totaal                (CompactedAdminDomain) := =NOT(ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector)
			                                                                 ? 'WijktVoorSloop ? 0[MW] : collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/StartState/StateBasisjaar/src/Wind/Totaal)'
			                                                                 : 'WijktVoorSloop || ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector && MoetWindmolenAfgebrokenWorden
			                                                                     ? 0[MW]
			                                                                     : StateVoorAllocatie0/Wind/Totaal', Descr = "Het totaal vermogen aan windmolens in dit zichtjaar, of 0 als de windmolen is afgebroken";
			attribute<Meter> MaxWerpafstandNom     (CompactedAdminDomain) := WijktVoorSloop || ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector && MoetWindmolenAfgebrokenWorden ? null_f[Meter] : StateVoorAllocatie0/Wind/MaxWerpafstandNom, Descr = "De max werpafstand van de windmolen in dit zichtjaar, of undefined als de windmolen is afgebroken";
			attribute<Meter> Ashoogte              (CompactedAdminDomain) := WijktVoorSloop || ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector && MoetWindmolenAfgebrokenWorden ? null_f[Meter] : StateVoorAllocatie0/Wind/Ashoogte, Descr = "De Ashoogte van de windmolen in dit zichtjaar, of undefined als de windmolen is afgebroken";
			attribute<Meter> Rotordiameter         (CompactedAdminDomain) := WijktVoorSloop || ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector && MoetWindmolenAfgebrokenWorden ? null_f[Meter] : StateVoorAllocatie0/Wind/Rotordiameter, Descr = "De Rotordiameter van de windmolen in dit zichtjaar, of undefined als de windmolen is afgebroken";
		}

		container          Zon                                    := = ModelParameters/SectorAllocRegio/Uq_Sectors/HasZonSector
		                                                             ? 'for_each_nedv(ZonK/Subsector_name, '+quote(Legen_Expr+'StateVoorAllocatie0/Zon/')+'+ZonK/Subsector_name, CompactedAdminDomain, float32)'
		                                                             : '/Templates/Leeg'
		, Descr = "Zonnevelden mee legen in de gesloopte cellen, conform wonen en werken (#596). Leeg zonder de sector, want dan bestaat ZonK niet (pbl-nl/model-RSopen#53).";

		
		container RestClaims
		: Descr = "Claim, stand voor allocatie en het verschil daartussen, per regio van de eerste allocatiestap (#392) en per subsector. Waar de restclaim negatief is, was de claim al gehaald voordat er ook maar iets gealloceerd werd, en zegt de claimrealisatie van dit zichtjaar niets over de allocatie. Dat gebeurt als het basisjaar van de claims ouder is dan de waargenomen voorraad. Uitgebreid vanuit twee debugregels, zie #639."
		{
			container Wonen
			{
				container          Claim                         :=
					for_each_nedv(
						WP2xVSSH/name
						, replace('ThisVariantData/Claims/'+Scenario_name+'/Zichtjaren/@Z@/SectorAllocRegios/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_name+'_Wonen/'+WP2xVSSH/name, '@Z@', Context/ThisZichtjaar_name)
						, WonenRegio
						, float32
					);
				container          Stand                         :=
					for_each_nedv(
						WP2xVSSH/name
						, 'sum(StateVoorAllocatie/Wonen/'+WP2xVSSH/name+', WonenRegio/Per_CompactedAdminDomain)'
						, WonenRegio
						, float32
					);
				container          RestClaim                     :=
					for_each_nedv(
						WP2xVSSH/name
						, 'Claim/'+WP2xVSSH/name+' - Stand/'+WP2xVSSH/name
						, WonenRegio
						, float32
					);
				container          Startstand                    :=
					for_each_nedv(
						WP2xVSSH/name
						, 'value(ThisCasus/StartState_metBAGnieuwbouw/Wonen/'+WP2xVSSH/name+', float32)'
						, CompactedAdminDomain
						, float32
					), Descr = "De woningen per cel en subsector in de startstand met BAG-nieuwbouw. De allocatie meet daarmee per regio van de fijnste ronde van wonen het overschot dat er al stond voordat er gealloceerd werd, en telt het via de cellen op naar de regio's van elke ronde (#879, #899, IterSubsector_T_Wonen/AllocRegio/BestaandOverschot).";

				attribute<Float32> Totaal_Claim     (WonenRegio) := = replace('ThisVariantData/Claims/'+Scenario_name+'/Zichtjaren/@Z@/SectorAllocRegios/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_name+'_Wonen/Totaal','@Z@' , Context/ThisZichtjaar_name);
				attribute<Float32> Totaal_Stand     (WonenRegio) := sum(StateVoorAllocatie/Wonen/Totaal, WonenRegio/Per_CompactedAdminDomain);
				attribute<Float32> Totaal_RestClaim (WonenRegio) := Totaal_Claim - Totaal_Stand;

				parameter<Float32> NrRegiosAlGehaald             := sum(float32(Totaal_RestClaim <= 0f)), Descr = "Aantal regio's waar de claim voor de allocatie al gehaald was.";
				parameter<Float32> NrRegios                      := sum(float32(IsDefined(Totaal_Claim)));
			}

			container Werken
			{
				container          Claim                          :=
					for_each_nedv(
						Jobs6/name
						, replace('ThisVariantData/Claims/'+Scenario_name+'/Zichtjaren/@Z@/AllocRegios/'+/ModelParameters/SectorAllocRegio/WerkenEersteAllocRegio_name+'/Werken/'+Jobs6/name, '@Z@', Context/ThisZichtjaar_name)
						, WerkenRegio
						, float32
					), Descr = "De banenclaim zoals de indicatoren hem lezen, AllocRegios/<regio>/Werken en niet SectorAllocRegios: met ModelParameters/ClaimBasisjaar/VerdelingVerzorgend op Woningen hangt die van de allocatie van dit zichtjaar af, en deze kant leest de woningen dan uit het weggeschreven bestand (Impl/WoningenVoorWerken).";
				container          Stand                          :=
					for_each_nedv(
						Jobs6/name
						, 'sum(StateVoorAllocatie/Werken/'+Jobs6/name+', WerkenRegio/Per_CompactedAdminDomain)'
						, WerkenRegio
						, float32
					);
				container          RestClaim                      :=
					for_each_nedv(
						Jobs6/name
						, 'Claim/'+Jobs6/name+' - Stand/'+Jobs6/name
						, WerkenRegio
						, float32
					);

				attribute<Float32> Totaal_Claim     (WerkenRegio) := ='add('+asItemList('Claim/'+Jobs6/name)+')';
				attribute<Float32> Totaal_Stand     (WerkenRegio) := ='add('+asItemList('Stand/'+Jobs6/name)+')';
				attribute<Float32> Totaal_RestClaim (WerkenRegio) := Totaal_Claim - Totaal_Stand;

				parameter<Float32> NrRegiosAlGehaald              := sum(float32(Totaal_RestClaim <= 0f)), Descr = "Aantal regio's waar de claim voor de allocatie al gehaald was.";
				parameter<Float32> NrRegios                       := sum(float32(IsDefined(Totaal_Claim)));
			}
		}
	}
	


	container Context
	{
		container         ThisZichtjaar      := ..;
		parameter<String> ThisZichtjaar_name := ../name;
	}
	
	container Sequences :=
		for_each_ne(
			Sequence_later/name
			, 'Sequence_T('
				+string(id(Sequence_later))+'[Sequence_later]'                           // sequence id
				', '+Sequence_later/PrevName+'/StateNaAllocatie'                         // container indicating the prev states
				', Context'                                                              // context folder from previous step
				', FALSE'                                                                // bool whether first sequence
				', ModelParameters/SectorAllocRegio/SectorAllocRegio_LaterSeq' // unit with sector alloc regio set
				', Sequence_later'                                                       // unit of single first sequence or later sequences
				', Impl'                                                                 // Impl folder from previous step
			')'
		), Descr = "Sequences zijn nodig om verdrongen wooneenheden, banen etc in een sequentie in een volgende sequentie te heralloceren, voor zover de verdringing restclaims opleverede"
	{
		container Seq_0 := Sequence_T(
		                       0[Sequence_first]                             // sequence id
		                       , StateVoorAllocatie                          // container indicating the prev states
		                       , Context                                     // context folder from previous step
		                       , TRUE                                        // bool whether first sequence
		                       , ModelParameters/SectorAllocRegio  // unit with sector alloc regio set
		                       , Sequence_first                              // unit of single first sequence or later sequences
		                       , Impl                                        // Impl folder from previous step
		                   ), Descr = "Eerste sequentie, die werkt op basis van de state voor allocatie";
		
		container LastSequence := =last(Sequence_later/name)
		{
			container StateNaAllocatie := =last(Sequence_later/name)+'/StateNaAllocatie';
		}
	}
	
	
	container Impl := Impl0
	{
		parameter<String> Generate                       := 'Allocatie'+name, ExplicitSuppliers = "=asList('WriteStand/'+StandVar/path, ';')+';WriteStand/Legenda'+Extra_str+Extra_werken+Extra_herkomst+Extra_prev", Descr = "Generate-parameter die het wegschrijven van de standbestanden van dit zichtjaar aanstuurt. WriteStand/Legenda staat er onvoorwaardelijk bij en niet in Extra_str, want die is voor het
					voorwaardelijke geval en de legenda hangt niet aan een sector; het pad wijst naar het kind zelf en niet naar de container, want ExplicitSuppliers op een container lift niet mee wanneer je
					een los kind opvraagt. Zonder deze regel wordt het zijbestand nooit geschreven, en de leeskant weigert een stand zonder kloppend zijbestand (#721).";
		
		parameter<string> Extra_str                      := (/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? ';WriteStand/wonen/Footprint' : '') + (/ModelParameters/SectorAllocRegio/Uq_Sectors/HasStedelijkGroenSector ? ';WriteStand/StedelijkGroen/ParkMogelijk;WriteStand/StedelijkGroen/KernVoorClaim' : '');
		parameter<string> Extra_werken                   := /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector && lowercase(/ModelParameters/ClaimBasisjaar/VerdelingVerzorgend) == 'woningen' ? ';WoningenVoorWerken/Write/Woningen' : '', Descr = "Schrijft de woningen per gemeente mee waaruit de verzorgende banen van dit zichtjaar hun verdeling halen, zie WoningenVoorWerken.";
		parameter<string> Extra_herkomst                 := (/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector || /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector ? ';Herkomst/Kaart;Herkomst/Legenda' : '') + (/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? ';Herkomst/Wonen/Tabel/groei_woningen' : '') + (/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector ? ';Herkomst/Werken/Tabel/groei_banen' : ''), Descr = "Schrijft mee in welk zichtjaar en in welke regel van de allocatievolgorde de nieuwe cellen van wonen en werken hun pakket kregen (Herkomst).";
		parameter<Bool>   IsEersteZichtjaar              := first(lowercase(Time/Zichtjaar/name)) == lowercase(name);
		parameter<String> PrevZichtjaar_name             := rjoin(lowercase(name), lowercase(Time/Zichtjaar/name), Time/Zichtjaar/PrevName);
		parameter<string> Extra_prev                     := Ontkoppeld || IsEersteZichtjaar ? '' : ';'+PrevZichtjaar_name+'/Impl/Generate', Descr = "Trekt in de gekoppelde stand het Generate van het vorige zichtjaar mee, en daarmee diens WriteStand/Legenda. Zonder deze term krijgt alleen het zichtjaar dat werkelijk wordt opgevraagd een
					legenda: de eerdere zichtjaren komen langs de dataketen voorbij en hun stand-tifs worden geschreven, maar ExplicitSuppliers vuurt daar niet, want die hangt aan Generate en niet aan de
					tif-items, en de leeskant weigert zo'n stand (#721, #732). Het pad staat ongekwalificeerd en niet met ..-stappen, want een ExplicitSupplier wordt omhoog gezocht vanaf de container van het
					item; de ketting is transitief. Ontkoppeld blijft de term leeg: de zichtjaren lezen elkaars stand dan van schijf, en wie in die stand alle zichtjaren wil roept ze per jaar aan, zoals
					batch/RunAllocatie.ps1 doet.";
		parameter<Bool>   Ontkoppeld                     := ='ModelParameters/StandAllocatieOntkoppeld', Descr = "Of de stand allocatie ontkoppeld is van de sector allocatie. Als dat zo is, worden de stand bestanden eerst ingelezen, gecompacteerd, en na de sector allocatie weer teruggeschreven. Als dat niet zo is, worden de stand bestanden direct overschreven.";
		
		unit<UInt8>       StandVar                       := ='ThisVariantClassifications/StandVar';
		parameter<string> AllocatieFileName              := replace(ModelParameters/Advanced/AllocatieFileName, '@CASUS@', Casus_name, '@JAAR@', name, '@SA@', ModelParameters/StudyArea, '@SS@', string(#/Classifications/Actor/Sector/xSubsector));
		parameter<string> LegendaFileName                := replace(AllocatieFileName, '@STANDPATH@', 'OP_rel') + '.params.txt', Descr = "Het zijbestand naast de OP_rel-tif met de legenda van de positionele standkolommen, zie WriteStand/Legenda.";
		parameter<String> LegendaVerwacht                := 'op_set=' + AsList(ThisVariantClassifications/Vastgoed/OP/name, ',') + ';subsector_set=' + AsList(/Classifications/Actor/Sector/xSubsector/name, ',') + ';landgebruik_set=' + AsList(/Classifications/Grondgebruik/LandgebruikType/name, ','), Descr = "De legenda van de twee positionele standkolommen (#721): welke namen er achter de nummers van OP_rel en SubSector_rel zitten, in setvolgorde. Wordt naast de OP_rel-tif geschreven en bij het inlezen vergeleken met de dan geldende sets, zodat een stand met een andere setindeling hard faalt in plaats van stil naar de verkeerde pakketten te wijzen.";
		
		parameter<Bool>   IsSkeletonZichtjaar            := /ModelParameters/Advanced/Skeleton/Actief && Zichtjaar_value >= /ModelParameters/Advanced/Skeleton/VanafZichtjaar, Descr = "Draait dit zichtjaar in de verkorte opzet? Zo ja, dan bepaalt de kolom ItersNaXZichtjaar per sectorallocregio of hij overgeslagen wordt en met hoeveel iteraties hij anders draait; zie
					ModelParameters/Advanced/Skeleton. Deze voorwaarde komt alleen uit de configuratie en Time/Zichtjaar en niet uit een berekende grootheid zoals de restclaim, want de boomvorm van een zichtjaar hangt
					ervan af en een voorwaarde die eerst gerekend moet worden maakt het uitklappen van de treeview in de GUI even duur als een run (dezelfde reden dat het dynamische stopcriterium in Iter_T
					uitstaat).";
		
		parameter<Jaar>   AantalJarenWerkGroeiAanpassing := Zichtjaar_value > ModelParameters/Werken/Groeifactor/JaarVanafWaarGeenWerkdichtheidMeerAangepastWordt
		                                                    ? 0[jaar]
		                                                    : ModelParameters/Werken/Groeifactor/Groeifactor_WanneerToepassen * (Zichtjaar_value - rjoin(lowercase(name), lowercase(Time/Zichtjaar/name), Time/Zichtjaar/PrevYearRange_rel))[Jaar];
	
		container ReadStand_UNCHECKED :=
			for_each_ndvna(
				 StandVar/path
				, AdminDomain
				, StandVar
				, StandVar/unit_name
				, replace(AllocatieFileName, '@STANDPATH@', StandVar/path)
			), StorageReadOnly = "True", Descr = "This tif file could potentially contain only zeros or undefined values. To check for this eventuality, the container following this one checks for this."
		{
			container wonen
			{
				attribute<m2PandFootprint> Footprint (AdminDomain) : StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Wonen/Footprint')", StorageType = "gdal.grid", StorageReadOnly = "true";
			}
		}

		container ReadStand :=
			for_each_neidvn(
				 StandVar/path
				, 'ReadStand_UNCHECKED/'+StandVar/path
				, StandVar/IsLandbouw || StandVar/IsStedelijkGroen || (NOT(/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector) && StandVar/name == 'OP_rel') ? '' : 'not(all(IsNull(this))) && not(all(IsZero(this)))' + (StandVar/name == 'OP_rel' || StandVar/name == 'SubSector_rel' || StandVar/name == 'Landgebruik_Type' ? ' && LegendaKlopt' : '') + (StandVar/name == 'SubSector_rel' && /ModelParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector ? ' && LandbouwStandKlopt' : '')
				, AdminDomain
				, StandVar
				, StandVar/unit_name
			), StorageReadOnly = "True", Descr = "De gecontroleerde leeskant. Elke standkaart moet minstens een gevulde en niet-nulle cel dragen, en de twee positionele kolommen moeten een kloppende legenda naast zich hebben (#721). De
					landbouwstandkaarten zijn van de toets per kaart vrijgesteld, want een gewas mag in een zichtjaar legitiem op nul uitkomen; de landbouwkant wordt als geheel getoetst met LandbouwStandKlopt
					hieronder, gehangen aan SubSector_rel, omdat een toets die naar label of stand apart kijkt het geval van #803 (labelkaart vol, standkaarten leeg) niet ziet. Dezelfde toets staat aan de
					schrijfkant, zie WriteStand."
		{
			parameter<String>  LegendaGelezen     : StorageName = "=ExistingFile('%projDir%/cfg/no_fingerprint.txt', LegendaFileName)", StorageType = "str", StorageReadOnly = "True"
			, Descr = "De legenda zoals die naast de ingelezen OP_rel-tif staat. Ontbreekt het zijbestand, dan valt dit terug op cfg/no_fingerprint.txt en klopt de vergelijking nooit; een stand van voor #721 faalt dus hard in plaats van stil verkeerd te wijzen.";
			parameter<Bool>    LegendaKlopt       := LegendaGelezen == LegendaVerwacht, Descr = "Wijzen de nummers in de ingelezen stand naar dezelfde sets als de lopende configuratie? Getoetst via de IntegrityCheck op OP_rel en SubSector_rel hierboven.";

			parameter<Float32> LandbouwStand_ha   := = /ModelParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
			                                         ? 'add('+AsList('sum(MakeDefined(ReadStand_UNCHECKED/Landbouw/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'[float32], 0f))', ',')+')'
			                                         : '0f'
			, Descr = "De landbouwstandkaarten van deze stand bij elkaar opgeteld, dimensieloos in hectare gerekend.";

			parameter<Float32> LandbouwLabel_ha   := = /ModelParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
			                                         ? 'sum(/Classifications/Actor/Sector/xSubsector/IsLandbouw[ReadStand_UNCHECKED/SubSector_rel] ? AdminDomain/NrHaPerCell[float32] : 0f)'
			                                         : '0f'
			, Descr = "Het areaal dat SubSector_rel in diezelfde stand als landbouw aanwijst.";

			parameter<Bool>    LandbouwStandKlopt := LandbouwStand_ha >= 0.99f * LandbouwLabel_ha, Descr = "Draagt elke cel met een landbouwlabel ook hectares in de standkaarten? De invariant die #803 brak. Label en hoeveelheid komen uit dezelfde allocatiestap, dus de som van de standkaarten hoort
						minstens gelijk te zijn aan het gelabelde areaal; groter mag, want exogeen opgelegde landbouw krijgt wel hectares maar geen label. De ondergrens staat op 99 procent en niet op gelijk, omdat
						beide sommen over tientallen miljoenen cellen in float32 worden opgeteld en een paar promille uit elkaar kunnen lopen; het gat dat de toets moet vangen is van een andere orde.";

			container wonen
			{
				attribute<Woning> Aantal_Woningen_Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP2xVSSH/name)+')';
				attribute<Woning> Aantal_Woningen_Totaal_NVM     (NVM) := sum(Aantal_Woningen_Totaal, NVM/Per_AdminDomain);
				attribute<m2PandFootprint> Footprint (AdminDomain) := ReadStand_UNCHECKED/Wonen/Footprint;
			}
		}

		container ReadStand_Compacted := 
			for_each_nedvn(
				StandVar/path
				, 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ReadStand/'+StandVar/path+')'
				, CompactedAdminDomain
				, StandVar
				, StandVar/unit_name
			), Descr = "Stand bestanden gecompacteerd naar het compacted admin domain, om daarna in het compacted admin domain de sector allocatie uit te voeren."
		{
			container wonen
			{
				attribute<m2PandFootprint> Footprint (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ReadStand/Wonen/Footprint);
			}
		}
		
		container FootprintEindejaars
		: Descr = "Einde-jaars afleiding van de footprints, ter vervanging van de keten door alle iteratielagen heen. De iteratie-updates in Allocatie_T/Impl worden tijdens de allocatie nooit opgevraagd; pas
						bij het wegschrijven van de stand zou die keten van circa 135 lagen over het hele domein worden uitgerekend. Omdat een cel binnen een zichtjaar hoogstens een keer gealloceerd wordt, is de
						eindfootprint direct af te leiden: niet dit jaar gealloceerd geeft de beginstand van het zichtjaar (inclusief de sloopleging in het eerste zichtjaar), wel gealloceerd geeft voor werken de
						footprint-per-baan van dit zichtjaar maal de eindstand van de winnende subsector (nul voor de andere subsectoren, de verdringing), en voor wonen de gebouwvoetafdruk van het gealloceerde
						ontwikkelpakket. Bewijs hieronder toetst de equivalentie met de iteratieketen (#716). CalcStand_Compacted leest voor werken deze afleiding en voor wonen nog de iteratieketen."
		{
			attribute<Bool> GealloceerdDitZichtjaar (CompactedAdminDomain) := /Classifications/Actor/Sector/xSubsector/LegtCelVast[Sequences/LastSequence/StateNaAllocatie/SubSector_rel] && !/Classifications/Actor/Sector/xSubsector/LegtCelVast[StateVoorAllocatie/SubSector_rel], Descr = "Cellen die een sector dit zichtjaar heeft gewonnen en vastgelegd: aan het eind een label dat de cel vastlegt, aan het begin nog niet. Een gewas telt niet, want landbouw verdringt niets (StatePrep_T/VerdringingsTak). Op alle andere cellen dragen de footprints de beginstand door.";

			container       PandFootprint :=
				for_each_nedv(
					Jobs6/name
					, replace(
						  replace('!GealloceerdDitZichtjaar ? StateVoorAllocatie/PandFootprint/@SS@ : Sequences/LastSequence/StateNaAllocatie/SubSector_rel == Sector/xSubsector/v/Werken_@SS@ ? min_elem(MakeDefined(ThisVariantData/Density/PerZichtjaar/@Y@/src/Werken/PandFootprint_perJob/Subsectoren/@SS@[CompactedAdminDomain/CompactedAllocDomain_rel], 0[m2PandFootprint_job]) * Sequences/LastSequence/StateNaAllocatie/Werken/@SS@, AdminDomain/NrMeter2PerCell[m2PandFootprint]) : @REST@', '@REST@', Jobs6/IsVerzorgend
							? 'Wonen/WonenWonDitZichtjaar ? StateVoorAllocatie/PandFootprint/@SS@ : 0[m2PandFootprint]'
							: '0[m2PandFootprint]')
						, '@Y@', Context/ThisZichtjaar_name
						, '@SS@', Jobs6/name)
					, CompactedAdminDomain
					, m2PandFootprint
				), Descr = "Zelfde termen als Update_PandFootprint_Expr, maar dan een keer op de eindstand, in drie gevallen. Niet dit zichtjaar gealloceerd: de beginstand blijft staan. Deze werksubsector wint de cel:
						de footprint-per-baan van dit zichtjaar maal de eindstand banen, begrensd op het celoppervlak, exact wat de allocatie er in de winnende iteratie neerzette; de MakeDefined om de
						dichtheidsopzoeking heen spiegelt die in Update_PandFootprint_Expr, want de dichtheid is buiten de CBS-buurtkaart null. De begrenzing op AdminDomain/NrMeter2PerCell staat er omdat de startstand
						ook op het celoppervlak begrenst en de omgevingsdichtheid in vierkante meter per baan op een cel met een groot pand veel ruimer is dan de werkelijkheid daar, zodat verdikking anders in de
						breedte gaat in plaats van in de hoogte (#716); de begrenzing staat per subsector en niet op de celsom, net als in de startstand. Een ander wint de cel: nul, want de allocatie is celexclusief,
						behalve voor een verzorgende subsector op een cel die wonen wint; daar blijft de beginstand staan, zoals Iter_T met Behoud_Expr doet (#710).";

			container Wonen
			{
				attribute<Bool> WonenWonDitZichtjaar (CompactedAdminDomain) := GealloceerdDitZichtjaar && lowercase(Sector/xSubsector/Sector_name[Sequences/LastSequence/StateNaAllocatie/SubSector_rel]) == lowercase('Wonen'), Descr = "Heeft wonen deze cel dit zichtjaar gewonnen? GealloceerdDitZichtjaar alleen is niet genoeg, want die is sectorneutraal.";

				attribute<m2PandFootprint> Footprint (CompactedAdminDomain) := !GealloceerdDitZichtjaar
				                                                               ? StateVoorAllocatie/Wonen/Footprint
				                                                               : WonenWonDitZichtjaar
				                                                                   ? MakeDefined(ThisVariantClassifications/Vastgoed/OP_buurt/Terreinoppervlakte/Uitgeefbaar/GebouwVoetafdruk[Sequences/LastSequence/StateNaAllocatie/OP_rel] /  1[Terreinoppervlak] * AdminDomain/NrHaPerCell /  1[ha] * 1[m2PandFootprint], 0[m2PandFootprint])
				                                                                   : 0[m2PandFootprint]
				, Descr = "Zelfde term als Update_WoonFootprint_Expr op de eindstand: op een cel die wonen dit zichtjaar wint is OP_rel het pakket van dit zichtjaar; wint een andere sector, dan gaat de voetafdruk
						expliciet naar nul, de verdringing; anders blijft de beginstand staan. De tak hangt aan WonenWonDitZichtjaar en niet aan het sectorneutrale GealloceerdDitZichtjaar, want OP_rel is in Iter_T
						eerste-wint en een cel die aan het begin van het zichtjaar wel een pakket draagt maar geen subsector houdt bij een werkallocatie het oude pakket; een sectorneutrale vlag zou daar een
						woonvoetafdruk op een vers werkterrein zetten. Op zo'n cel die wonen wint rekent deze term met het oude pakket en de iteratieketen met het nieuwe; zie Bewijs.";
			}

			container Bewijs
			: Descr = "Eenmalige equivalentietoets van de einde-jaars afleiding tegen de iteratieketen: per werksubsector en voor wonen het maximale absolute verschil. Vraag Write op; de vergelijking dwingt beide ketens af binnen een proces. Zolang deze toets niet exact nul heeft opgeleverd, blijft CalcStand_Compacted op de iteratieketen staan."
			{
				container         PerSubsector       :=
					for_each_nedv(
						Jobs6/name
						, 'max(abs(MakeDefined(PandFootprint/'+Jobs6/name+', -999999f[m2PandFootprint]) - MakeDefined(Sequences/LastSequence/StateNaAllocatie/PandFootprint/'+Jobs6/name+', -999999f[m2PandFootprint])))'
						, void
						, m2PandFootprint
					);
				parameter<m2PandFootprint> MaxVerschil_Wonen := max(abs(MakeDefined(Wonen/Footprint, -999999f[m2PandFootprint]) - MakeDefined(Sequences/LastSequence/StateNaAllocatie/Wonen/Footprint, -999999f[m2PandFootprint])));
				container         OmvangPerSubsector :=
					for_each_nedv(
						Jobs6/name
						, 'sum(abs(MakeDefined(PandFootprint/'+Jobs6/name+', 0[m2PandFootprint]) - MakeDefined(Sequences/LastSequence/StateNaAllocatie/PandFootprint/'+Jobs6/name+', 0[m2PandFootprint])))'
						, void
						, m2PandFootprint
					), Descr = "De som van het absolute verschil over alle cellen, naast het maximum hierboven. Het maximum zegt hoe erg het op de ergste cel is, deze som zegt hoeveel vierkante meter er in totaal verkeerd wordt weggeschreven. Nodig om te kunnen beoordelen of een run overgedaan moet worden.";

				container         CellenPerSubsector :=
					for_each_nedv(
						Jobs6/name
						, 'sum(uint32(abs(MakeDefined(PandFootprint/'+Jobs6/name+', 0[m2PandFootprint]) - MakeDefined(Sequences/LastSequence/StateNaAllocatie/PandFootprint/'+Jobs6/name+', 0[m2PandFootprint])) > 0.01[m2PandFootprint]))'
						, void
						, uint32
					), Descr = "Op hoeveel cellen de twee ketens meer dan een honderdste vierkante meter uit elkaar lopen. De drempel houdt float32-ruis buiten de telling.";

				parameter<m2PandFootprint> TotaalFootprint_Keten := =asList('sum(MakeDefined(Sequences/LastSequence/StateNaAllocatie/PandFootprint/'+Jobs6/name+', 0[m2PandFootprint]))', ' + '), Descr = "De totale weggeschreven werkvoetafdruk volgens de iteratieketen, als noemer bij de som hierboven.";


				container         SplitsPerSubsector :=
					for_each_nedv(
						Jobs6/name
						, replace(
							  'string(sum(uint32(Verschil/D_@SS@ >  0.01[m2PandFootprint])))'
							+ '+ '';'' + string(sum(uint32(Verschil/D_@SS@ < -0.01[m2PandFootprint])))'
							+ '+ '';'' + string(sum(max_elem(Verschil/D_@SS@,  0[m2PandFootprint])))'
							+ '+ '';'' + string(sum(max_elem(-Verschil/D_@SS@, 0[m2PandFootprint])))'
							+ '+ '';'' + string(sum(uint32(abs(Verschil/D_@SS@) > 0.01[m2PandFootprint] && Wonen/WonenWonDitZichtjaar)))'
							+ '+ '';'' + string(sum(uint32(abs(Verschil/D_@SS@) > 0.01[m2PandFootprint] && GealloceerdDitZichtjaar && !Wonen/WonenWonDitZichtjaar)))'
							+ '+ '';'' + string(sum(uint32(abs(Verschil/D_@SS@) > 0.01[m2PandFootprint] && !GealloceerdDitZichtjaar)))'
							, '@SS@', Jobs6/name)
						, void
						, String
					);

				container         Verschil           :=
					for_each_nedv(
						'D_'+Jobs6/name
						, replace('MakeDefined(PandFootprint/@SS@, 0[m2PandFootprint]) - MakeDefined(Sequences/LastSequence/StateNaAllocatie/PandFootprint/@SS@, 0[m2PandFootprint])'
							, '@SS@', Jobs6/name)
						, CompactedAdminDomain
						, m2PandFootprint
					);

				parameter<String> WriteSplits        :=
					= quote('subsector;cellen_afleiding_hoger;cellen_afleiding_lager;som_hoger_m2;som_lager_m2;cellen_wonen_won;cellen_anders_gealloceerd;cellen_niet_gealloceerd')
					+ ' + ' + asList(quote('|'+Jobs6/name+';')+' + SplitsPerSubsector/'+Jobs6/name, ' + ')
				, StorageName = "='%LocalDataProjDir%/Diagnose/FootprintEindejaars_Splits_'+Casus_name+'_'+Context/ThisZichtjaar_name+'.txt'"
				, StorageType = "str"
				, Descr = "Waar een restverschil tussen de twee ketens vandaan komt: het verschil gesplitst naar teken, zodat blijkt of de afleiding te hoog of te laag zit, en naar wie de cel dit zichtjaar heeft
						gewonnen. Zit het op cellen die wonen won, dan is er nog een geval van de familie van #716; zit het op cellen die niet dit zichtjaar zijn gealloceerd, dan gaat het om de doorgedragen
						beginstand en de begrenzing op het celoppervlak.";

				parameter<String> Write              := = asList('string(PerSubsector/'+Jobs6/name+')', ' + '';'' + ') + ' + '';'' + string(MaxVerschil_Wonen)'
				, StorageName = "='%LocalDataProjDir%/Diagnose/FootprintEindejaars_Bewijs_'+Casus_name+'_'+Context/ThisZichtjaar_name+'.txt'"
				, StorageType = "str"
				;

				parameter<String> WriteOmvang        :=
					= quote('subsector;max_m2;som_m2;cellen|')
					+ ' + ' + asList('string('+quote(Jobs6/name+';')+' + string(PerSubsector/'+Jobs6/name+') + '+quote(';')+' + string(OmvangPerSubsector/'+Jobs6/name+') + '+quote(';')+' + string(CellenPerSubsector/'+Jobs6/name+'))', ' + '+quote('|')+' + ')
					+ ' + ' + quote('|totaal_keten_m2;') + ' + string(TotaalFootprint_Keten)'
				, StorageName = "='%LocalDataProjDir%/Diagnose/FootprintEindejaars_Omvang_'+Casus_name+'_'+Context/ThisZichtjaar_name+'.txt'"
				, StorageType = "str"
				, Descr = "Per subsector het maximum, de som van de absolute verschillen en het aantal afwijkende cellen, plus de totale weggeschreven werkvoetafdruk als noemer. Write hierboven zegt of de twee
						ketens uit elkaar lopen, deze uitdraai zegt hoeveel. Lees hem als een toename per zichtjaar en niet als een opgelopen fout: beide ketens dragen op een cel die dit zichtjaar niet is
						gealloceerd dezelfde StateVoorAllocatie door, dus een verschil uit een eerder zichtjaar valt hier weg, en een zichtjaar waarin niets meer wordt gealloceerd geeft nul. Meet in een zichtjaar
						waarin wonen nog bouwt."
				, Descr = "Zeven getallen, allemaal exact nul als de afleiding klopt: het maximale absolute verschil tussen FootprintEindejaars en de iteratieketen per werksubsector en voor wonen. De twee oorzaken die
						deze toets heeft gevonden staan in #716: een nullek in Update_PandFootprint_Expr (float32(FALSE) maal null geeft null en geen nul) en een woontak die aan het sectorneutrale
						GealloceerdDitZichtjaar hing. Voor wonen blijft een verschil van precies een pakketwisseling mogelijk op cellen die aan het begin van het zichtjaar een pakket dragen zonder subsector, want
						OP_rel is eerste-wint en de keten leest per_OP; zie de Descr van WoonFootprint.";
			}
		}

		container CalcStand_Compacted :=
			for_each_nedvn(
				StandVar/path
				, substr(StandVar/path, 0, 14) == 'PandFootprint/'
					? 'FootprintEindejaars/'+StandVar/path
					: 'Sequences/LastSequence/StateNaAllocatie/'+StandVar/path
				, CompactedAdminDomain
				, StandVar
				, StandVar/unit_name
			), Descr = "De gealloceerde waarden in het compacted admin domain, na de sectorallocatie. De zes pandvoetafdrukken van werken lopen langs FootprintEindejaars in plaats van langs de iteratieketen; dat
				scheelt het leeuwendeel van de schrijfstaart, want die ketens van circa 135 lagen werden tijdens de allocatie nooit opgevraagd en pas hier over het hele domein uitgerekend, en de
				equivalentie is met Bewijs aangetoond (#716). De woonvoetafdruk blijft op de iteratieketen: daar is de afleiding niet aantoonbaar gelijk zolang niet besloten is wat OP_rel hoort te zijn op
				een cel die opnieuw wordt gealloceerd."
		{
			container wonen
			{
				attribute<m2PandFootprint> Footprint (CompactedAdminDomain) := Sequences/LastSequence/StateNaAllocatie/Wonen/Footprint;
			}
		}

		container CalcStand :=
			for_each_nedvn(
				StandVar/path
				, StandVar/name == 'SubSector_rel' || StandVar/name == 'OP_rel'
					? 'recollect_by_cond(AdminDomain/IsCompactedDomain, CalcStand_Compacted/'+StandVar/path+', (0 / 0) [scope(StandVar, '+StandVar/unit_name+')])'
					: '(AdminDomain/IsCompactedDomain || !/Geography/rdc_meter/IsStudyArea_AdminDomain)'
						+ ' ? recollect_by_cond(AdminDomain/IsCompactedDomain, CalcStand_Compacted/'+StandVar/path+', (0 / 0) [scope(StandVar, '+StandVar/unit_name+')])'
						+ ' : /BaseData/StartState/StateBasisjaar/State/'+StandVar/path
				, AdminDomain
				, StandVar
				,StandVar/unit_name
		), Descr = "De gealloceerde waarden terug in het volledige admin domain. Een cel in het studiegebied waarvan de 100-metercel buiten het gecomprimeerde domein valt, langs de kust, de grote wateren en de
					landsgrens, wordt niet gealloceerd en houdt daarom de waarde van het basisjaar, zodat het landgebruikstype en de banen daar niet verdwijnen (#826). OP_rel en SubSector_rel zijn labels
					van de allocatie en blijven daar leeg, net als alles buiten het studiegebied."
		{
			container wonen
			{
				attribute<m2PandFootprint> Footprint (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, CalcStand_Compacted/Wonen/Footprint);
			}
		}
		
		container WriteStand :=
			for_each_neidvnat(
				StandVar/path
				, 'CalcStand/'+StandVar/path
				, StandVar/IsLandbouw || StandVar/IsStedelijkGroen || (NOT(/Modelparameters/SectorAllocRegio/Uq_Sectors/HasWonenSector) && StandVar/name == 'OP_rel') ? '' : 'not(all(IsNull(this))) && not(all(IsZero(this)))' + (StandVar/name == 'SubSector_rel' && /Modelparameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector ? ' && LandbouwStandKlopt' : '')
				, AdminDomain
				, StandVar
				, StandVar/unit_name
				, replace(AllocatieFileName, '@STANDPATH@', StandVar/path)
				, 'gdalwrite.grid'
			), Descr = "Write the calculated stand file back to a tif file, but only if the stand file is not completely empty or undefined. De landbouwstandkaarten worden niet per kaart getoetst maar als geheel,
					met LandbouwStandKlopt hieronder, gehangen aan SubSector_rel; zie de Descr van ReadStand: een enkel gewas mag legitiem op nul uitkomen, en #803 was het geval waarin het label vol stond en de
					stand leeg was."
		{
			parameter<String>  Legenda            := LegendaVerwacht
			, StorageName = "=LegendaFileName", StorageType = "str"
			, Descr = "Schrijft de legenda van de positionele standkolommen naast de OP_rel-tif, zie LegendaVerwacht. Hoort bij elke WriteStand-aanroep mee te gaan; de leeskant weigert een stand zonder kloppend zijbestand.";

			parameter<Float32> LandbouwStand_ha   := = /Modelparameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
			                                         ? 'add('+AsList('sum(MakeDefined(CalcStand/Landbouw/'+/Classifications/Actor/LandbouwKlasses/Actief/name+'[float32], 0f))', ',')+')'
			                                         : '0f'
			, Descr = "De landbouwstandkaarten die dit zichtjaar wegschrijft, bij elkaar opgeteld en dimensieloos in hectare gerekend.";

			parameter<Float32> LandbouwLabel_ha   := = /Modelparameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector
			                                         ? 'sum(/Classifications/Actor/Sector/xSubsector/IsLandbouw[CalcStand/SubSector_rel] ? AdminDomain/NrHaPerCell[float32] : 0f)'
			                                         : '0f'
			, Descr = "Het areaal dat SubSector_rel in diezelfde stand als landbouw aanwijst.";

			parameter<Bool>    LandbouwStandKlopt := LandbouwStand_ha >= 0.99f * LandbouwLabel_ha, Descr = "Dezelfde invariant als aan de leeskant, maar dan op wat deze run wegschrijft; zie ReadStand/LandbouwStandKlopt voor de onderbouwing en voor de reden dat de ondergrens op 99 procent staat.";

			container wonen
			{
				attribute<m2PandFootprint> Footprint (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'CalcStand/Wonen/Footprint' : 'const(null_f, AdminDomain, m2PandFootprint)', StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Wonen/Footprint')", StorageType = "gdalwrite.grid";
			}

			container StedelijkGroen
			: Descr = "Twee kaarten van nieuw stedelijk groen voor de indicator van de bereikbaarheid van groen, die het tekort telt dat met de regels van #480 niet op te lossen is (Templates/Indicatoren/BereikbaarheidGroen_T/Normtoets/TekortOnoplosbaar). Geen stand: het volgende zichtjaar leest ze niet."
			{
				attribute<UInt8> ParkMogelijk  (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasStedelijkGroenSector ? 'UInt8(StedelijkGroenClaim/NaAllocatie/IsParkMogelijk)' : 'const(0b, AdminDomain)', StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'StedelijkGroen/ParkMogelijk')", StorageType = "gdalwrite.grid", Descr = "1 waar na de allocatie nog een park kan komen, zie StedelijkGroenClaim/NaAllocatie.";
				attribute<UInt8> KernVoorClaim (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasStedelijkGroenSector ? 'UInt8(StedelijkGroenClaim/IsKernVoorClaim)' : 'const(0b, AdminDomain)', StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'StedelijkGroen/KernVoorClaim')", StorageType = "gdalwrite.grid", Descr = "1 in de kernen waarvan de claim van dit zichtjaar het tekort telt, zie StedelijkGroenClaim/IsKernVoorClaim.";
			}

		}

		container Herkomst
		: Descr = "In welk zichtjaar en in welke regel van de allocatievolgorde elke nieuwe cel van wonen en werken zijn pakket kreeg, als kaart over alle zichtjaren en per sector als tabel per regio van de fijnste
					indeling (pbl-nl/model-RSopen#4, #904). Een woningcel is nieuw in een regel als hij aan het eind ervan een ontwikkelpakket draagt dat hij aan het begin niet droeg, een werkcel als hij aan
					het eind een werksubsector heeft die hij aan het begin niet had, want een werkcel draagt zelden een ontwikkelpakket. Wat een latere sequentie erbij zet, hoort bij de eerste regel van zijn
					sector, want alleen die draait daar mee. De tabellen verdelen de groei van de stand per cel over de regels, met eigen rijen voor wat er op cellen zonder nieuw pakket bijkomt of afgaat en
					voor wat er aan het begin van het zichtjaar al verandert; de rijen van een regio samen zijn de groei vanaf de stand waarmee het zichtjaar begint. In het eerste zichtjaar bevat die
					stand al de BAG-nieuwbouw na het basisjaar (StartState_metBAGnieuwbouw), dus die telt in de tabellen niet mee."
		{
			unit<UInt8> Regel := /ModelParameters/SectorAllocRegio/WonenWerkenAllocRegio
			{
				attribute<String>                        name       := /ModelParameters/SectorAllocRegio/name[org_rel];
				attribute</Classifications/Actor/Sector> Sector_rel := /ModelParameters/SectorAllocRegio/Sector_rel[org_rel];
				attribute<String>                        Pad        := 'Sequences/Seq_0/SectorAllocRegios/'+name;
				attribute<String>                        IsNieuw_expr := Sector_rel == /Classifications/Actor/Sector/V/Wonen
					? 'IsDefined('+Pad+'/StateNaAllocatie/OP_rel) && IsNull('+Pad+'/StateVoorAllocatie/OP_rel)'
					: '/Classifications/Actor/Sector/xSubsector/Sector_rel['+Pad+'/StateNaAllocatie/SubSector_rel] == '+string(Sector_rel)+'[/Classifications/Actor/Sector] && (IsNull('+Pad+'/StateVoorAllocatie/SubSector_rel) ? TRUE : '+Pad+'/StateNaAllocatie/SubSector_rel != '+Pad+'/StateVoorAllocatie/SubSector_rel)'
				, Descr = "Wanneer een cel in de regel een pakket krijgt: bij wonen een nieuw ontwikkelpakket, bij werken een nieuwe werksubsector.";
			}
			container IsNieuw := for_each_nedv(Regel/name, Regel/IsNieuw_expr, CompactedAdminDomain, Bool), Descr = "Per regel van wonen en werken in de eerste sequentie de cellen die in die regel een pakket kregen.";

			attribute</Classifications/Actor/Sector> SectorNu (CompactedAdminDomain) := /Classifications/Actor/Sector/xSubsector/Sector_rel[Sequences/LastSequence/StateNaAllocatie/SubSector_rel], Descr = "De sector van de cel aan het eind van het zichtjaar.";
			attribute<Regel>   EersteRegel      (/Classifications/Actor/Sector) := first(id(Regel), Regel/Sector_rel), Descr = "De eerste regel van elke sector; daar hoort een cel bij die zijn pakket in een latere sequentie kreeg.";
			attribute<Bool>    IsNieuwZichtjaar (CompactedAdminDomain) := IsDefined(EersteRegel[SectorNu])
			                                                              && (SectorNu == /Classifications/Actor/Sector/V/Wonen
			                                                                 ? IsDefined(Sequences/LastSequence/StateNaAllocatie/OP_rel) && IsNull(StateVoorAllocatie/OP_rel)
			                                                                 : (IsNull(StateVoorAllocatie/SubSector_rel) ? TRUE : Sequences/LastSequence/StateNaAllocatie/SubSector_rel != StateVoorAllocatie/SubSector_rel))
			, Descr = "Kreeg de cel dit zichtjaar een pakket van wonen of werken, met dezelfde maat als in IsNieuw?";
			attribute<Regel>   RegelNu          (CompactedAdminDomain) := = 'IsNieuwZichtjaar ? (' + AsList('IsNieuw/'+Regel/name+' && SectorNu == '+string(Regel/Sector_rel)+'[/Classifications/Actor/Sector] ? '+string(id(Regel))+'[Regel] : ', '') + 'EersteRegel[SectorNu]) : null_b'
			, Descr = "De regel van de sector van nu waarin de cel dit zichtjaar zijn pakket kreeg; leeg voor een cel die geen nieuwe cel van wonen of werken is.";
			attribute<Float32> GroeiWonen       (CompactedAdminDomain) := = 'add('+AsItemList('MakeDefined(float32(Sequences/LastSequence/StateNaAllocatie/Wonen/'+/Classifications/Vastgoed/WP2xVSSH/name+'), 0f) - MakeDefined(float32(StateVoorAllocatie/Wonen/'+/Classifications/Vastgoed/WP2xVSSH/name+'), 0f)')+')', Descr = "De woningen die de cel in de allocatie van dit zichtjaar erbij kreeg, over de vier woningtypen; negatief bij verdringing.";
			attribute<Float32> GroeiWerken      (CompactedAdminDomain) := = 'add('+AsItemList('MakeDefined(float32(Sequences/LastSequence/StateNaAllocatie/Werken/'+Jobs6/name+'), 0f) - MakeDefined(float32(StateVoorAllocatie/Werken/'+Jobs6/name+'), 0f)')+')', Descr = "De banen die de cel in de allocatie van dit zichtjaar erbij kreeg, over de werksubsectoren; negatief bij verdringing.";
			attribute<Float32> GroeiWonenVoorAllocatie  (CompactedAdminDomain) := = 'add('+AsItemList('MakeDefined(float32(StateVoorAllocatie/Wonen/'+/Classifications/Vastgoed/WP2xVSSH/name+'), 0f) - MakeDefined(float32(StateVoorAllocatie0/Wonen/'+/Classifications/Vastgoed/WP2xVSSH/name+'), 0f)')+')', Descr = "De woningen die aan het begin van het zichtjaar afgaan, voordat de allocatie begint: in het eerste zichtjaar de gesloopte cellen en in elk zichtjaar de cellen die de herontwikkelingskans vrijlaat.";
			attribute<Float32> GroeiWerkenVoorAllocatie (CompactedAdminDomain) := = 'add('+AsItemList('MakeDefined(float32(StateVoorAllocatie/Werken/'+Jobs6/name+'), 0f) - MakeDefined(float32(StateVoorAllocatie0/Werken/'+Jobs6/name+'), 0f)')+')', Descr = "De banen die aan het begin van het zichtjaar bijkomen of afgaan, voordat de allocatie begint: de aanpassing van het aantal banen per bestaande cel aan de verandering van de voetafdruk per baan, en in het eerste zichtjaar de gesloopte cellen.";

			unit<UInt8>        ZichtjaarRegel := Impl0/ZichtjaarSectorAllocRegio;
			parameter</Classifications/Time/Zichtjaar> Zichtjaar_rel := rlookup(lowercase(Context/ThisZichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name));
			attribute<ZichtjaarRegel> RegelVorig (CompactedAdminDomain) := = IsEersteZichtjaar ? 'const(null_b, CompactedAdminDomain, ZichtjaarRegel)'
			                                                              : Ontkoppeld ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, ReadVorig/Kaart)'
			                                                              : PrevZichtjaar_name+'/Impl/Herkomst/RegelTotNu'
			, Descr = "RegelTotNu van het vorige zichtjaar; ontkoppeld uit zijn bestand, zodat de allocatie van dat zichtjaar niet opnieuw wordt gerekend.";
			container ReadVorig
			{
				attribute<ZichtjaarRegel> Kaart (AdminDomain) : StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Herkomst/ZichtjaarSectorAllocRegio', 'Stand'+Context/ThisZichtjaar_name+'/', 'Stand'+PrevZichtjaar_name+'/')", StorageType = "gdal.grid", StorageReadOnly = "true";
			}
			attribute<ZichtjaarRegel> Kandidaat  (CompactedAdminDomain) := MakeDefined(combine_data(ZichtjaarRegel, const(Zichtjaar_rel, CompactedAdminDomain), RegelNu), RegelVorig), Descr = "Het nummer van dit zichtjaar voor een nieuwe cel, anders dat van het vorige zichtjaar.";
			attribute<ZichtjaarRegel> RegelTotNu (CompactedAdminDomain) := Regel/Sector_rel[ZichtjaarRegel/second_rel[Kandidaat]] == SectorNu ? Kandidaat : null_b
			, Descr = "Het zichtjaar en de regel waarin de cel tot en met dit zichtjaar voor het laatst een pakket kreeg; leeg als de cel nu bij een andere sector hoort of nooit een nieuw pakket van wonen of werken kreeg.";
			attribute<ZichtjaarRegel> Kaart (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, RegelTotNu), StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Herkomst/ZichtjaarSectorAllocRegio')", StorageType = "gdalwrite.grid", Descr = "Per cel een nummer voor de combinatie van zichtjaar en regel, over alle zichtjaren tot en met dit zichtjaar (#904).";
			parameter<String>  Legenda := AsList(string(id(ZichtjaarRegel))+'='+ZichtjaarRegel/name, ';'), StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Herkomst/ZichtjaarSectorAllocRegio', '.tif', '_legenda.txt')", StorageType = "str", Descr = "Welk nummer in de kaart bij welke combinatie van zichtjaar en regel hoort.";

			container Wonen
			: Descr = "De groei van de woningstand per regio van de fijnste woonindeling, per regel van wonen."
			{
				unit<UInt8> SectorRegel := select_with_org_rel(Regel/Sector_rel == /Classifications/Actor/Sector/V/Wonen)
				{
					attribute<String> name := Regel/name[org_rel];
				}
				container PerRegel :=
					for_each_nedv(
						SectorRegel/name
						, 'sum(GroeiWonen * float32(MakeDefined(RegelNu == '+string(SectorRegel/org_rel)+'[Regel], FALSE)), WonenRegio/Per_CompactedAdminDomain)'
						, WonenRegio
						, Float32
					), Descr = "De groei per regio op de cellen die in de regel hun pakket kregen.";
				attribute<Float32> ZonderNieuwPakket (WonenRegio) := sum(GroeiWonen * float32(IsNull(rlookup(RegelNu, SectorRegel/org_rel))), WonenRegio/Per_CompactedAdminDomain), Descr = "Wat er per regio in de allocatie bijkomt of afgaat op cellen zonder nieuw pakket van wonen, vooral door verdringing.";
				attribute<Float32> VoorAllocatie     (WonenRegio) := sum(GroeiWonenVoorAllocatie, WonenRegio/Per_CompactedAdminDomain), Descr = "Wat er per regio aan het begin van het zichtjaar afgaat, voordat de allocatie begint.";

				unit<UInt32> Tabel := ='union_unit('+AsList(const('WonenRegio', SectorRegel), ',')+', WonenRegio, WonenRegio)'
				, StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Herkomst/SectorAllocRegio_Wonen', '.tif', '.csv')", StorageType = "gdalwrite.vect"
				, Descr = "Een rij per regio en per regel, met de groei op de cellen die in die regel hun pakket kregen, en per regio een rij ZonderNieuwPakket en een rij VoorAllocatie; de rijen van een regio samen zijn de groei van de woningstand vanaf de stand waarmee het zichtjaar begint. De kolommen lezen alleen buiten de tabel, anders valt het schrijven om."
				{
					attribute<String>  regio_naam     := ='union_data(., '+AsList(const('WonenRegio/name', SectorRegel), ',')+', WonenRegio/name, WonenRegio/name)';
					attribute<String>  allocatieregel := ='union_data(., '+AsList('const('+quote(SectorRegel/name)+', WonenRegio)', ',')+', const('+quote('ZonderNieuwPakket')+', WonenRegio), const('+quote('VoorAllocatie')+', WonenRegio))';
					attribute<Float32> groei_woningen := ='union_data(., '+AsList('PerRegel/'+SectorRegel/name, ',')+', ZonderNieuwPakket, VoorAllocatie)';
				}
			}

			container Werken
			: Descr = "De groei van de banen per regio van de fijnste werkindeling, per regel van werken."
			{
				unit<UInt8> SectorRegel := select_with_org_rel(Regel/Sector_rel == /Classifications/Actor/Sector/V/Werken)
				{
					attribute<String> name := Regel/name[org_rel];
				}
				container PerRegel :=
					for_each_nedv(
						SectorRegel/name
						, 'sum(GroeiWerken * float32(MakeDefined(RegelNu == '+string(SectorRegel/org_rel)+'[Regel], FALSE)), WerkenRegio/Per_CompactedAdminDomain)'
						, WerkenRegio
						, Float32
					), Descr = "De groei per regio op de cellen die in de regel hun pakket kregen.";
				attribute<Float32> ZonderNieuwPakket (WerkenRegio) := sum(GroeiWerken * float32(IsNull(rlookup(RegelNu, SectorRegel/org_rel))), WerkenRegio/Per_CompactedAdminDomain), Descr = "Wat er per regio in de allocatie bijkomt of afgaat op cellen zonder nieuw pakket van werken: banen op bestaande werkcellen, op woningcellen en op cellen zonder werksubsector, en verdringing.";
				attribute<Float32> VoorAllocatie     (WerkenRegio) := sum(GroeiWerkenVoorAllocatie, WerkenRegio/Per_CompactedAdminDomain), Descr = "Wat er per regio aan het begin van het zichtjaar bijkomt of afgaat, voordat de allocatie begint.";

				unit<UInt32> Tabel := ='union_unit('+AsList(const('WerkenRegio', SectorRegel), ',')+', WerkenRegio, WerkenRegio)'
				, StorageName = "=replace(AllocatieFileName, '@STANDPATH@', 'Herkomst/SectorAllocRegio_Werken', '.tif', '.csv')", StorageType = "gdalwrite.vect"
				, Descr = "Een rij per regio en per regel, met de groei op de cellen die in die regel hun pakket kregen, en per regio een rij ZonderNieuwPakket en een rij VoorAllocatie; de rijen van een regio samen zijn de groei van de banen vanaf de stand waarmee het zichtjaar begint. De kolommen lezen alleen buiten de tabel, anders valt het schrijven om."
				{
					attribute<String>  regio_naam     := ='union_data(., '+AsList(const('WerkenRegio/name', SectorRegel), ',')+', WerkenRegio/name, WerkenRegio/name)';
					attribute<String>  allocatieregel := ='union_data(., '+AsList('const('+quote(SectorRegel/name)+', WerkenRegio)', ',')+', const('+quote('ZonderNieuwPakket')+', WerkenRegio), const('+quote('VoorAllocatie')+', WerkenRegio))';
					attribute<Float32> groei_banen    := ='union_data(., '+AsList('PerRegel/'+SectorRegel/name, ',')+', ZonderNieuwPakket, VoorAllocatie)';
				}
			}
		}
			
		container WriteStand_Compacted := 
			for_each_nedvn(
				StandVar/path
				, 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, WriteStand/'+StandVar/path+')'
				, CompactedAdminDomain
				, StandVar
				, StandVar/unit_name
			), Descr = "De gealloceerde waarden in het compacted admin domain, na de sector allocatie, via conversie van Compacted naar Uncompacted zodat het ook weggeschreven wordt."
		{
			container wonen
			{
				attribute<m2PandFootprint> Footprint (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, WriteStand/Wonen/Footprint);
			}
		}

		container WoningenVoorWerken
		: Descr = "De woningen per gemeente nadat wonen in de eerste sequentie van dit zichtjaar is gealloceerd en voordat werken begint; daaruit halen de verzorgende banen hun verdeling
					(ModelParameters/ClaimBasisjaar/VerdelingVerzorgend). De eerste sequentie en niet de laatste, want in de latere sequenties hangt wonen al van de allocatie van werken af. De allocatie
					leest Calc. Wie de claim daarbuiten leest, zoals de indicatoren en de diagnose, leest Bron, en dat is in de ontkoppelde stand het bestand dat Generate naast de standkaarten schrijft,
					zodat de woonallocatie daar niet opnieuw wordt gerekend."
		{
			unit<UInt32>      Gemeente           := /PrivData/TrendBasisjaar/Gemeente;
			parameter<String> FileName           := replace(replace(AllocatieFileName, '@STANDPATH@', 'WoningenVoorWerken'), '.tif', '.csv');
			parameter<String> State              := 'Sequences/Seq_0/SectorAllocRegios/'+/ModelParameters/SectorAllocRegio/WerkenEersteAllocRegio_name+'_Werken/StateVoorAllocatie/Wonen/';
			attribute<Woning> Calc    (Gemeente) := ='sum(add('+AsList(State+WP2xVSSH/name, ',')+'), Gemeente/Per_CompactedAdminDomain)';
			attribute<Woning> Bron    (Gemeente) := = Ontkoppeld ? 'Read/Woningen' : 'Calc';
			attribute<Woning> VoorAllocatie (Gemeente) := ='sum(add('+AsList('StateVoorAllocatie0/Wonen/'+WP2xVSSH/name, ',')+'), Gemeente/Per_CompactedAdminDomain)', Descr = "De woningen per gemeente aan het begin van dit zichtjaar, voordat wonen alloceert. Daarmee begrenst StateVoorAllocatie/Werkdichtheid de aanpassing van de werkdichtheid op de claim die op dat moment bekend is (#922).";

			container Write
			: StorageName = "=FileName", StorageType = "gdalwrite.vect"
			{
				attribute<Woning> Woningen (Gemeente) := Calc, ExplicitSuppliers = "gem_nr";
				attribute<UInt32> gem_nr   (Gemeente) := Gemeente/gem_nr;
			}
			container Read
			: StorageName = "=FileName", StorageType = "gdal.vect", StorageReadOnly = "TRUE"
			{
				attribute<Woning> Woningen (Gemeente);
				attribute<UInt32> gem_nr   (Gemeente);
			}
		}

		attribute<Bool>   AlGealloceerdVoorDitZichtjaar (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, /Classifications/Actor/Sector/xSubsector/LegtCelVast[StateVoorAllocatie/SubSector_rel]), Descr = "Wat er bij de start van dit zichtjaar al lag: wat eerdere zichtjaren alloceerden, en in het eerste zichtjaar de BAG-nieuwbouw, die in StartState_metBAGnieuwbouw een label krijgt. De vormtoetsen in Iter_Allocatie trekken dit eraf, zodat clusters binnen een zichtjaar kunnen aangroeien maar niet over zichtjaren heen (#643); de BAG-nieuwbouw tellen ze via IsBAGnieuwbouw weer mee (#899). Staat hier en niet in de iteratie zelf, want binnen een zichtjaar is dit constant.";
		attribute<Bool>   IsBAGnieuwbouw   (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, /Classifications/Actor/Sector/xSubsector/LegtCelVast[ThisCasus/StartState_metBAGnieuwbouw/SubSector_rel]), Descr = "De cellen die in de startstand een label voor BAG-nieuwbouw hebben (StartState_metBAGnieuwbouw). De vormtoetsen in Iter_Allocatie tellen ze in elk zichtjaar mee, voor de beukmaat en de clusteromvang, zodat een open cel in een wijk van de laatste jaren als inbreiding gebouwd kan worden (#899).";

		container TredeDynamischeUrbanContour
		: Descr = "De trede-ladders van dit zichtjaar, opgebouwd op een bestaand bebouwd gebied dat meegroeit met wat het model in eerdere zichtjaren heeft gebouwd (#749), voor zover dat aan een woonkern vastzit (#862). Hier en niet in VariantData, want de
					UrbanContour van 2060 hangt af van wat er in 2050 is gealloceerd en VariantData is op het basisjaar geankerd; dit is de enige plek waar de vorige zichtjaarstand beschikbaar is, via
					StateVoorAllocatie0. De ladder zelf, de unit met zijn treden, blijft gedeeld in VariantParameters/Tredes; hier gebeurt per zichtjaar alleen de toewijzing van cellen aan klassen, per as
					opgebouwd (#775)."
		{
			attribute<Bool> IsModelNieuwbouw    (CompactedAdminDomain) := IsDefined(StateVoorAllocatie0/SubSector_rel) && /Classifications/Actor/Sector/xSubsector/TeltAlsBebouwdGebied[StateVoorAllocatie0/SubSector_rel], Descr = "Cellen met een label voor wonen of werken aan het begin van dit zichtjaar. SubSector_rel is eerste-wint en wordt over de zichtjaren heen nooit gewist, dus dit is de cumulatieve nieuwbouw tot en met het vorige zichtjaar: wat de allocatie gaf en de BAG-nieuwbouw uit de startstand (StartState_metBAGnieuwbouw), die in het eerste zichtjaar al een label heeft.";

			attribute<Bool> IsModelNieuwbouw_AdminDomain (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, IsModelNieuwbouw, FALSE);
			attribute<Bool> IsModelNieuwbouwWonen_AdminDomain (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, IsModelNieuwbouw && (/Classifications/Actor/Sector/IsWonen[/Classifications/Actor/Sector/xSubsector/Sector_rel])[StateVoorAllocatie0/SubSector_rel], FALSE), Descr = "Het deel van die nieuwbouw met een label voor wonen.";

			attribute<Bool> Koppelgebied                 (AdminDomain) := = 'potential(float32(IsModelNieuwbouw_AdminDomain || /BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain), /Geography/Distmatrices_'+/Geography/AdminDomain_ref_short+'/pot'+string(uint32(/ModelParameters/Wonen/Uitbreiding/KoppelStraal / 1[meter]))+'m/Flat2) > 0f', Descr = "De nieuwbouw en de BRT-woonkernen, verbreed met ModelParameters/Wonen/Uitbreiding/KoppelStraal, zodat nieuwbouw die met een smalle tussenruimte (een weg, een sloot) aan een kern of aan andere nieuwbouw ligt in hetzelfde cluster valt (#862).";
			unit<UInt32>    Cluster                                    := district_8(Koppelgebied), Descr = "De aaneengesloten delen van Koppelgebied (#862)."
			{
				attribute<Bool> HeeftWoonkern := sum(uint32(/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain), Districts) > 0, Descr = "Bevat het cluster een cel van een BRT-woonkern?";
			}
			attribute<Bool> IsAangeslotenNieuwbouw       (AdminDomain) := IsModelNieuwbouw_AdminDomain && Cluster/HeeftWoonkern[Cluster/Districts], Descr = "De nieuwbouw die in een cluster met een BRT-woonkern ligt (#862). Een cluster dat over de zichtjaren vanaf een kern doorgroeit blijft meetellen; een los cluster in het buitengebied, zoals BAG-nieuwbouw op een erf of een opnieuw bebouwd vrijgekomen perceel, telt niet mee en wordt zo geen nieuwe kern.";
			attribute<Bool> Aangroei                     (AdminDomain) := potential(float32(IsAangeslotenNieuwbouw), /Geography/Distmatrices_25m/pot100m/Flat2) > 0f, Descr = "De schijf van 100 meter rond de nieuwbouw die aan een kern vastzit. Honderd meter is een AllocDomain-cel, dus dit is precies 'direct aangrenzend op de resolutie waarop gealloceerd wordt'. Ruimer werkt niet: een schijf van 500 meter rond het bestaande bebouwde gebied voegt al 862.700 hectare toe, bijna tweemaal dat gebied zelf, en dan betekent binnenstedelijk niets meer.";
			attribute<Bool> AangroeiWonen                (AdminDomain) := potential(float32(IsAangeslotenNieuwbouw && IsModelNieuwbouwWonen_AdminDomain), /Geography/Distmatrices_25m/pot100m/Flat2) > 0f, Descr = "Dezelfde schijf rond alleen de woningbouw daarvan: de aansluitende schijf groeit mee met wonen en niet met werken (#862), zodat een werklocatie aan de rand van een kern de woonuitbreiding niet naar zich toe trekt.";

			attribute<Bool> UrbanContour_AdminDomain     (AdminDomain) := /BaseData/Omgeving/BebouwdGebied/UrbanContour || Aangroei;
			attribute<Bool> BinnenUrbanContour           (AdminDomain) := UrbanContour_AdminDomain;
			attribute<Bool> BuitenUrbanContour           (AdminDomain) := !BinnenUrbanContour;
			attribute<Bool> AansluitendAanUrbanContour   (AdminDomain) := = '!BinnenUrbanContour && potential(float32(/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain || AangroeiWonen), /Geography/Distmatrices_'+/Geography/AdminDomain_ref_short+'/pot'+string(uint32(/ModelParameters/Wonen/Uitbreiding/AansluitStraal / 1[meter]))+'m/Flat2) > 0f', Descr = "De aansluitende schijf van dit zichtjaar (#862), rond de BRT-woonkernen aangegroeid met de woningbouw van eerdere zichtjaren die aan een kern vastzit.";
			attribute<Bool> AanDeBeurt                   (AdminDomain) := = 'ThisVariantData/Herontwikkelingskans/PerZichtjaar/' + name + '/IsVrij_AdminDomain', Descr = "De cellen met woningen van de percelen die de herontwikkelingskans van wonen uiterlijk in dit zichtjaar vrij laat (#869): de bovenste as van de woonladders (VariantParameters/Tredes/impl/HerontwikkelingK), zodat de allocatie een vrijgekomen perceel bebouwt voordat hij elders uitbreidt.";
			attribute<Bool> NietAanDeBeurt               (AdminDomain) := !AanDeBeurt;

			container src := ThisVariantData/Trede/src
			, Descr = "De trede-bron van dit zichtjaar: alles geerfd van VariantData, met alleen de drie UrbanContour-vlaggen (binnen, aansluitend, buiten; #862) en de twee herontwikkelingsvlaggen (#869) vervangen. Meer hoeft er niet overschreven te worden, want geen enkel ander item in die bron leest die vlaggen."
			{
				attribute<Bool> BinnenUrbanContour         (AdminDomain) := ../BinnenUrbanContour;
				attribute<Bool> BuitenUrbanContour         (AdminDomain) := ../BuitenUrbanContour;
				attribute<Bool> AansluitendAanUrbanContour (AdminDomain) := ../AansluitendAanUrbanContour;
				attribute<Bool> AanDeBeurt                 (AdminDomain) := ../AanDeBeurt;
				attribute<Bool> NietAanDeBeurt             (AdminDomain) := ../NietAanDeBeurt;
			}

			container src_ZonderPlancapaciteit := ThisVariantData/Trede/src_ZonderPlancapaciteit
			, Descr = "Dezelfde ingreep op de bron waarin de plancapaciteit is platgelegd (#739), zodat de opbouw na de vervaldatum van de plancapaciteit dezelfde aangroei en dezelfde vrijgekomen percelen ziet."
			{
				attribute<Bool> BinnenUrbanContour         (AdminDomain) := ../BinnenUrbanContour;
				attribute<Bool> BuitenUrbanContour         (AdminDomain) := ../BuitenUrbanContour;
				attribute<Bool> AansluitendAanUrbanContour (AdminDomain) := ../AansluitendAanUrbanContour;
				attribute<Bool> AanDeBeurt                 (AdminDomain) := ../AanDeBeurt;
				attribute<Bool> NietAanDeBeurt             (AdminDomain) := ../NietAanDeBeurt;
			}

			container src_Werken := ThisVariantData/Trede/src
			, Descr = "De trede-bron van werken: als src, maar binnen de contour valt alleen de begrenzing van BegrenzingBebouwdGebied_jaar en niet de schijf van 100 m rond eerdere nieuwbouw (#911). Als trede legde die schijf de diensten in stroken van 100 m langs de nieuwbouw van het vorige zichtjaar; de nabijheid van nieuwbouw telt voor werken via de afstand tot de contour en het buurtaandeel overig bebouwd in WerkenGeschiktheid."
			{
				attribute<Bool> BinnenUrbanContour         (AdminDomain) := /BaseData/Omgeving/BebouwdGebied/UrbanContour;
				attribute<Bool> BuitenUrbanContour         (AdminDomain) := !BinnenUrbanContour;
				attribute<Bool> AansluitendAanUrbanContour (AdminDomain) := ../AansluitendAanUrbanContour;
				attribute<Bool> AanDeBeurt                 (AdminDomain) := ../AanDeBeurt;
				attribute<Bool> NietAanDeBeurt             (AdminDomain) := ../NietAanDeBeurt;
			}

			container src_ZonderPlancapaciteit_Werken := ThisVariantData/Trede/src_ZonderPlancapaciteit
			, Descr = "Dezelfde trede-bron van werken op de bron waarin de plancapaciteit is platgelegd (#739)."
			{
				attribute<Bool> BinnenUrbanContour         (AdminDomain) := /BaseData/Omgeving/BebouwdGebied/UrbanContour;
				attribute<Bool> BuitenUrbanContour         (AdminDomain) := !BinnenUrbanContour;
				attribute<Bool> AansluitendAanUrbanContour (AdminDomain) := ../AansluitendAanUrbanContour;
				attribute<Bool> AanDeBeurt                 (AdminDomain) := ../AanDeBeurt;
				attribute<Bool> NietAanDeBeurt             (AdminDomain) := ../NietAanDeBeurt;
			}

			parameter<Bool> TredesetBekend                             := ThisVariantData/Trede/TredesetBekend, Descr = "Voor de IntegrityCheck op Trede_T/Tredeset in de ladders hieronder, zoals in VariantData/Trede.";

			container       SectorxSubsectoren                         :=
				for_each_ne(
					Sector/xSubsector/name
					, Sector/xSubsector/IsLandbouw ? '/Templates/Leeg' : 'Templates/VariantData/Trede_T('+string(id(Sector/xSubsector))+'[Sector/xSubsector], '+(Sector/IsWerken[Sector/xSubsector/Sector_rel] ? 'src_Werken' : 'src')+')'
				);

			container       SectorxSubsectoren_ZonderPlancapaciteit    :=
				for_each_ne(
					Sector/xSubsector/name
					, Sector/xSubsector/IsLandbouw ? '/Templates/Leeg' : 'Templates/VariantData/Trede_T('+string(id(Sector/xSubsector))+'[Sector/xSubsector], '+(Sector/IsWerken[Sector/xSubsector/Sector_rel] ? 'src_ZonderPlancapaciteit_Werken' : 'src_ZonderPlancapaciteit')+')'
				);
		}		

		container GroenNabijheid
		: Descr = "Hedonische natuur- en waternabijheid aan het begin van dit zichtjaar, als correctie op de geschiktheid voor wonen (#637). De prijsindex waardeert natuur in de schijf 0-2500m en water in de schijf 0-500m (#481, #566), maar de opbrengsten per ontwikkelpakket zijn gerekend met de basisjaar-fracties. Hier wordt bepaald hoeveel die fracties inmiddels zijn veranderd. Wat in een zichtjaar wordt gebouwd, is gebouwd in de periode ervoor, en kan dus niet beprijsd zijn met natuur die in diezelfde periode is aangelegd; daarom telt alleen wat aan het begin van het zichtjaar al ligt. Daarmee is er ook geen endogeniteit binnen het zichtjaar: de kaart ligt vast voordat de eerste iteratie begint."
		{
			unit<UInt8>     OP                 := ThisVariantClassifications/Vastgoed/OP;
			unit<UInt8>     WP4                := /Classifications/Vastgoed/WP4;

			parameter<bool> IsEersteZichtjaar  := first(lowercase(Time/Zichtjaar/name)) == lowercase(name), Descr = "Is dit het eerste zichtjaar? Dan is er nog niets gerealiseerd dat hier mee kan tellen: de exogene oplegging gebeurt in dit zichtjaar, de BAG-nieuwbouw uit StartState_metBAGnieuwbouw is gebouwd in deze periode, en gealloceerd is er nog niets. De fracties zijn dan gelijk aan het basisjaar en de geschiktheid verandert niet ten opzichte van de situatie voor #637.";

			container Bron
			: Descr = "De stand aan het begin van dit zichtjaar, als invoer voor het gedeelde groenfracties-sjabloon."
			{
				attribute<bool>   IsBAGnieuwbouwWonen (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, ThisCasus/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/IsBAGnieuwbouwWonen), Descr = "BAG-nieuwbouwcel (issue #550): heeft wel een gematchte OP_rel maar geen fysieke OP-inrichting; houdt daarom de basisjaarwaarden.";
				attribute<OP>     OP_rel              (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, StateVoorAllocatie/OP_rel), Descr = "Het ontwikkelpakket dat in een eerder zichtjaar in deze cel is gealloceerd.";
				attribute<bool>   IsOPCel             (AdminDomain) := = IsEersteZichtjaar ? 'const(FALSE, AdminDomain)' : 'IsDefined(OP_rel) && !IsBAGnieuwbouwWonen', Descr = "Cel waar de allocatie een ontwikkelpakket fysiek heeft ingericht; die inrichting bepaalt dan de natuur- en watercelwaarde.";
				attribute<Sector> Sector_Mutatie      (AdminDomain) := = IsEersteZichtjaar ? 'const(null_b, AdminDomain, Sector)' : 'Sector/xSubsector/Sector_rel[recollect_by_cond(AdminDomain/IsCompactedDomain, StateVoorAllocatie/SubSector_rel)]', Descr = "Welke sector de allocatie hier in een eerder zichtjaar heeft neergezet, anders leeg. SubSector_rel is alleen gevuld waar de allocatie sinds het basisjaar heeft toegeslagen. In het eerste zichtjaar staat hier alleen de BAG-nieuwbouw, en die is gebouwd in dezelfde periode als waarover dit zichtjaar alloceert, dus die telt nog niet mee.";
				attribute<LandgebruikType> Type_Mutatie (AdminDomain) := = IsEersteZichtjaar ? 'const(null_b, AdminDomain, /Classifications/Grondgebruik/LandgebruikType)' : 'MakeDefined(/Classifications/Grondgebruik/LandgebruikType/Van_INL[ThisVariantData/ExogeenOpleggen/Beheertype_Kaart], /Classifications/Grondgebruik/LandgebruikType/Van_LandbouwType[ThisVariantData/ExogeenOpleggen/LandbouwType_rel])', Descr = "Welk landgebruikstype de variant hier exogeen oplegt, als type uit de stand-administratie en niet als klasse van de landgebruikskaart. Natuur en water komen langs Beheertype_Kaart, de landbouwstroom van de veenbouwstenen langs LandbouwType_rel; dat zijn dezelfde twee stromen die samen ExogeenOpleggen/Totaal vormen.";

				// De drie hedonische vlaggen die het gedeelde sjabloon verwacht. De oplegging gaat voor de allocatie, net als in de landgebruikskaart. Natuur en water komen van het type, want dat zegt wat de cel is;
				// waterberging en landbouw komen van de sector, want dat zegt wie de cel bezet. Tot 8 september 2026 liep dit alles via een LU_ModelType, die beide vragen met een klasse beantwoordde en daarmee het beheertype van de natuur plat sloeg tot een enkele LGN-code.
				attribute<bool>   IsMutatie           (AdminDomain) := IsDefined(Type_Mutatie) || IsDefined(Sector_Mutatie);
				attribute<bool>   Mutatie_IsNatuur    (AdminDomain) := /Classifications/Grondgebruik/LandgebruikType/IsNatuur_hedonisch[Type_Mutatie];
				attribute<bool>   Mutatie_IsWater     (AdminDomain) := IsDefined(Type_Mutatie) ? /Classifications/Grondgebruik/LandgebruikType/IsWater_hedonisch[Type_Mutatie] : Sector/IsWaterberging[Sector_Mutatie];
				attribute<bool>   Mutatie_IsLandbouw  (AdminDomain) := IsDefined(Type_Mutatie) ? /Classifications/Grondgebruik/LandgebruikType/IsLandbouw[Type_Mutatie] : Sector/IsLandbouw[Sector_Mutatie];
				attribute<bool>   Mutatie_IsStedelijkGroen (AdminDomain) := !IsDefined(Type_Mutatie) && MakeDefined(Sector/IsStedelijkGroen[Sector_Mutatie], FALSE), Descr = "Heeft de allocatie hier nieuw stedelijk groen aangelegd (#480)? Een oplegging gaat voor, zoals bij de andere vlaggen.";
			}

			container       Fracties           := Templates/Suitabilities/Groenfracties_T(Bron), Descr = "Zelfde sjabloon, zelfde definities en zelfde noemers als de indicator WaardeNabijheidGroen (#566), maar dan gevoed met de beginstand in plaats van de eindstand.";

			container       Prijsopslag_perWP4 :=
				for_each_nedv(
					WP4/name
					, IsEersteZichtjaar
						? 'const(0f, CompactedAdminDomain)'
						: 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Fracties/Prijsopslag_perWP4/'+WP4/name+')'
					, CompactedAdminDomain
					, float32
				), Descr = "De relatieve prijsverandering per woningtype op het compacted domain, klaar voor gebruik in de geschiktheid voor wonen (IterSubsector_T_Wonen). In het eerste zichtjaar expliciet nul, zodat de dure schijfberekening daar helemaal niet hoeft te draaien.";
		}

		container StedelijkGroenClaim
		: Descr = "De claim en de geschiktheid van nieuw stedelijk groen in dit zichtjaar (#480). De claim, per NVM-regio in hectare, is de stand van het nieuwe groen aan het begin van het zichtjaar plus het deel van het groentekort dat dit
					zichtjaar moet oplossen, en dan alleen het tekort in kernen vanaf ModelParameters/StedelijkGroen/MinInwonersWoonkern inwoners. Het tekort is dat van de normtoets van ModelParameters/Indicatoren/Groennorm (Templates/Indicatoren/BereikbaarheidGroen_T/Normtoets), hier gerekend op de stand aan
					het begin van het zichtjaar en met dezelfde drie maten voor het groen van een cel. Templates/Claims/ZichtjaarXScenarioxAllocRegios/StedelijkGroen leest Totaal; de allocatie trekt er de
					stand weer af, dus wat ze dit zichtjaar aanlegt is het deel van het tekort. Wat ze niet kwijt kan, blijft in het tekort van het volgende zichtjaar staan."
		{
			parameter<String>    Kern              := Normtoets/Kern, Descr = "De schijf van de straal, hemelsbreed, zoals in de normtoets.";
			attribute<Woning>    Woningen          (AdminDomain) := ='MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, add('+asItemList('StateVoorAllocatie0/Wonen/'+WP2xVSSH/name)+')), 0[Woning])', Descr = "Alle woningen van de cel aan het begin van het zichtjaar, van voor het legen van de percelen voor herontwikkeling (#869): wie daar woont, telt mee, want na de allocatie staan er weer woningen.";
			attribute</Classifications/Grondgebruik/CBSKlasse/Aggr/Groen> GroenInBasisjaar (AdminDomain) := invert(/Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/org_rel)[/Classifications/Grondgebruik/CBSKlasse/Aggr_rel[/BaseData/StartState/Bodemstatistiek/gg_CBS]]
			, Descr = "De groenklasse van het basisjaar, dezelfde als Templates/Indicatoren/Landgebruikskaart/Make_LandgebruikskaartNL2120_T/GroenInBasisjaar.";
			attribute<Bool>      IsVastgelegd      (AdminDomain) := MakeDefined(/Classifications/Actor/Sector/xSubsector/LegtCelVast[recollect_by_cond(AdminDomain/IsCompactedDomain, StateVoorAllocatie/SubSector_rel)], FALSE), Descr = "Heeft de allocatie de cel sinds het basisjaar vastgelegd? Dan is zijn groen van het basisjaar weg, zoals in GroenInZichtjaar van de landgebruikskaart.";
			attribute<Bool>      IsGroenKlasse     (AdminDomain) := IsDefined(GroenInBasisjaar) && GroenInBasisjaar != /Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/V/overige_agrarisch_gebruik && !IsVastgelegd, Descr = "De klassetak van de normtoets.";
			attribute<Float32>   Fractie           (AdminDomain) := max_elem(float32(IsGroenKlasse), MakeDefined(GroenNabijheid/Fracties/NatuurCel, 0f), MakeDefined(GroenNabijheid/Fracties/OpenbaarGroenCel, 0f)), Descr = "Het groene deel van de cel, de ruimste van de drie maten van de normtoets.";
			container            Normtoets         := Templates/Indicatoren/Groennormtoets_T(Woningen, Fractie), Descr = "Hetzelfde sjabloon als de normtoets van de indicator, zodat de claim het tekort oplost dat de indicator meet.";
			attribute<meter2>    Tekort            (AdminDomain) := Normtoets/Tekort, Descr = "Het groentekort van de woningen in de cel aan het begin van het zichtjaar.";
			parameter<String>    KoppelKern        := '/Geography/Distmatrices_'+/Geography/AdminDomain_ref_short+'/pot'+string(uint32(/ModelParameters/Wonen/Uitbreiding/KoppelStraal / 1[meter]))+'m/Flat2', Descr = "De schijf van ModelParameters/Wonen/Uitbreiding/KoppelStraal, dezelfde als in TredeDynamischeUrbanContour/Koppelgebied.";
			attribute<Bool>      Nieuwbouwgebied   (AdminDomain) := ='potential(float32(TredeDynamischeUrbanContour/IsModelNieuwbouw_AdminDomain && !/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain), '+KoppelKern+') > 0f && !/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain'
			, Descr = "De nieuwbouw buiten de BRT-woonkernen, verbreed met de koppelstraal zodat een wijk over een weg of sloot heen een geheel blijft.";
			unit<UInt32>         Nieuwbouwwijk     := district_8(Nieuwbouwgebied), Descr = "De aaneengesloten delen van Nieuwbouwgebied.";
			attribute<Float32>   KernInwonersOmgeving (AdminDomain) := ='potential(float32(/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain), '+KoppelKern+') > 0f ? potential(float32(MakeDefined(/BaseData/Grondgebruik/BRT/IsWoonkern/Inwoners_Per_AdminDomain, 0)), '+KoppelKern+') / potential(float32(/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain), '+KoppelKern+') : 0f'
			, Descr = "Het gemiddelde aantal inwoners van de woonkerncellen binnen de koppelstraal; nul als er geen woonkern binnen die straal ligt.";
			attribute<UInt32>    InwonersWoonkern  (AdminDomain) := /BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain ? MakeDefined(/BaseData/Grondgebruik/BRT/IsWoonkern/Inwoners_Per_AdminDomain, 0) : Nieuwbouwgebied ? uint32(max(KernInwonersOmgeving, Nieuwbouwwijk/Districts)[Nieuwbouwwijk/Districts]) : 0
			, Descr = "De inwoners van de woonkern bij de cel. In een BRT-woonkern zijn dat de inwoners van die kern zelf, zodat een dorp of voorstad die tegen een stad aan ligt als zichzelf telt. In een nieuwbouwwijk buiten de woonkernen zijn het de inwoners van de grootste kern waar de wijk aan vastzit, zodat een nieuwe wijk aan een stad als die stad telt. Elders nul (#480).";
			attribute<Bool>      IsKernVoorClaim   (AdminDomain) := InwonersWoonkern >= /ModelParameters/StedelijkGroen/MinInwonersWoonkern
			, Descr = "Ligt de cel in een kern met minstens ModelParameters/StedelijkGroen/MinInwonersWoonkern inwoners? Alleen het tekort daar wordt claim. Ook weggeschreven naast de stand, zodat de indicator het tekort in dezelfde kernen telt (WriteStand/StedelijkGroen/KernVoorClaim).";
			attribute<meter2>    TekortVoorClaim   (AdminDomain) := IsKernVoorClaim ? Tekort : 0[meter2]
			, Descr = "Het tekort dat nieuw stedelijk groen moet oplossen: alleen dat van woningen in een kern met minstens ModelParameters/StedelijkGroen/MinInwonersWoonkern inwoners. Het tekort van dorpen en het buitengebied blijft in de indicator staan, maar wordt geen claim.";

			parameter<Float32>   Jaar              := float32(Zichtjaar_value);
			parameter<Float32>   VorigJaar         := float32(rjoin(lowercase(name), lowercase(Time/Zichtjaar/name), Time/Zichtjaar/PrevYearRange_rel)), Descr = "Het vorige zichtjaar, of het basisjaar voor het eerste zichtjaar.";
			parameter<Float32>   WegIn             := float32(VariantParameters/VariantK/StedelijkGroenTekortWegIn[Variant_rel]);
			parameter<Float32>   Aandeel           := Jaar >= WegIn ? 1f : (Jaar - VorigJaar) / (WegIn - VorigJaar)
			, Descr = "Het deel van het tekort aan het begin van het zichtjaar dat dit zichtjaar moet oplossen: tot VariantK/StedelijkGroenTekortWegIn een even groot deel per jaar van wat nog openstaat, daarna alles.";

			attribute<Ha>        Stand             (NVM) := sum(StateVoorAllocatie/StedelijkGroen/Totaal, NVM/Per_CompactedAdminDomain), Descr = "Het nieuwe stedelijk groen dat er aan het begin van het zichtjaar al ligt.";
			attribute<Ha>        TekortHa          (NVM) := convert(sum(collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, TekortVoorClaim), NVM/Per_CompactedAdminDomain), Ha), Descr = "Het groentekort in de kernen van de regio aan het begin van het zichtjaar, een ondergrens voor het groen dat erbij moet.";
			parameter<String>    ClaimWijze        := VariantParameters/VariantK/StedelijkGroenClaimWijze[Variant_rel], Descr = "Hoe de claim wordt bepaald (VariantK/StedelijkGroenClaimWijze): TekortWeg of TekortGelijk; bij Geen leest de claim Totaal niet.";
			attribute<Ha>        TekortBasisjaarHa (NVM) := = ClaimWijze == 'TekortGelijk' ? '/Allocatie/'+Casus_name+'/Zichtjaren/'+first(Time/Zichtjaar/name)+'/Impl/StedelijkGroenClaim/TekortHa' : 'const(0[Ha], NVM)'
			, Descr = "Het groentekort in de kernen van de regio aan het begin van het eerste zichtjaar, dus op de stand van het basisjaar; alleen gerekend bij de claimwijze TekortGelijk.";
			attribute<Ha>        Totaal            (NVM) := = ClaimWijze == 'TekortGelijk' ? 'Stand + max_elem(TekortHa - TekortBasisjaarHa, 0[Ha])' : 'Stand + Aandeel * TekortHa'
			, Descr = "De stand van het nieuwe groen die aan het eind van het zichtjaar hoort te liggen. Bij TekortWeg de stand plus het deel van het tekort dat dit zichtjaar moet oplossen (Aandeel); bij TekortGelijk de stand plus wat het tekort boven dat van het basisjaar uitkomt, zodat het tekort niet groeit (#906).";

			attribute<Bool>      IsWater           (CompactedAdminDomain) := MakeDefined(LandgebruikType/IsWater[StateVoorAllocatie/Landgebruik/Type], FALSE), Descr = "Water in het landgebruik aan het begin van het zichtjaar.";
			attribute<Bool>      IsWaterKasOfHoofdinfra (CompactedAdminDomain) := IsWater || MakeDefined(LandgebruikType/LandbouwType_afgeleid[StateVoorAllocatie/Landgebruik/Type] == /Classifications/Grondgebruik/LandbouwType/V/Glastuinbouw, FALSE) || MakeDefined(LandgebruikType/LGNKlasse_rel[StateVoorAllocatie/Landgebruik/Type] == /Classifications/Grondgebruik/LGNKlasse/V/hoofdinfrastructuur_en_Spoorbaanlichamen, FALSE)
			, Descr = "Water, glastuinbouw of hoofdinfrastructuur en spoorbaanlichamen (LGN-klasse 251) in het landgebruik aan het begin van het zichtjaar. Een park op water levert geen groen op, en een kas kost in de verwerving vaak alleen de agrarische grondprijs, want de kas zelf telt alleen mee als de BAG op het perceel een verblijfsobject heeft (#891); zonder deze uitsluiting wint zo'n kas het van de akker ernaast. De zeef houdt geen van drieën tegen: de lijst van evident benut laat kassen open, een deel van het water staat op de kaart van evident benut als een andere klasse, en de berm van een hoofdweg krijgt daar pas de klasse hoofdweg als de BGT-weg meer dan de halve cel dekt.";
			attribute<Bool>      HeeftBanen        (AdminDomain) := ='MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, add('+asItemList('StateVoorAllocatie0/Werken/'+Jobs6/name)+') > 0[Job]), FALSE)'
			, Descr = "Staan er aan het begin van het zichtjaar banen op de cel, van voor het legen van de percelen voor herontwikkeling? Een park zou ze verdringen, en de allocatie van werken zet ze niet allemaal elders terug (#480); daarom alleen als de baat de kosten dekt (BaatDektKosten, #906).";
			attribute<Bool>      LangsHoofdinfra   (AdminDomain) := /BaseData/Grondgebruik/BRT/LangsHoofdinfra/Per_AdminDomain
			, Descr = "Ligt de cel in de band langs een autosnelweg, hoofdweg of spoorlijn? Een strook groen daar is geen park (#480).";
			attribute<Bool>      HeeftWoningen     (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, StateVoorAllocatie/Wonen/Totaal > 0[Woning]), FALSE)
			, Descr = "Staan er aan het begin van het zichtjaar woningen op de cel, na het legen van de percelen voor herontwikkeling? Op een perceel dat de herontwikkelingskans heeft geleegd (StateVoorAllocatie/Herontwikkeling, #869) niet meer: daar gaan de woningen hoe dan ook weg, de restclaim van wonen stijgt met hetzelfde aantal en ze komen elders in de regio terug, dus een park kost er geen woningen (#906).";
			parameter<Bool>      HardePlannenGelden := VariantParameters/VariantK/HardePlannenGeldigInZeef[Variant_rel] && uint32(Zichtjaar_value) <= uint32(/ModelParameters/Advanced/PlancapaciteitGeldigTotEnMet), Descr = "Gelden de harde plannen in dit zichtjaar, met dezelfde schakelaar en vervaldatum als in de zeef (Templates/Beschikbaarheden/Zeef_T/Src/HeeftHardePlannenDezeSector).";
			attribute<Bool>      InHardPlan        (AdminDomain) := HardePlannenGelden && MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantData/Plannen/Per_CompactedAdminDomain/Hard/Result/AnyWonen || ThisVariantData/Plannen/Per_CompactedAdminDomain/Hard/Result/AnyWerken), FALSE)
			, Descr = "Ligt de cel in harde plancapaciteit voor wonen of werken? Daar ligt vast dat er woningen of bedrijven komen, en omdat stedelijk groen voor wonen en werken alloceert, zou een park die plek anders innemen (#906).";
			attribute<Bool>      IsOpenVoorPark    (AdminDomain) := ='MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, !/Classifications/Actor/Sector/xSubsector/LegtCelVast[StateVoorAllocatie/SubSector_rel] && !IsWaterKasOfHoofdinfra), FALSE) && !IsGroenKlasse && !LangsHoofdinfra && !InHardPlan'
			, Descr = "De regels die voor elke cel gelden: de cel is aan het begin van het zichtjaar niet vastgelegd, zoals in Beschikbaar_Init van Templates/Allocatie/IterSubsector_T, hij is geen water, kas of hoofdinfrastructuur, hij is volgens de CBS-kaart van het basisjaar nog geen groen, want een park lost daar geen tekort op, hij ligt niet in de band langs een grote weg of spoorlijn (#480) en niet in harde plancapaciteit voor wonen of werken (#906).";
			attribute<Bool>      IsVrijeGrond      (AdminDomain) := ='IsOpenVoorPark && !HeeftBanen && !HeeftWoningen && MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantData/PotentieleState/'+Context/ThisZichtjaar_name+'/per_SectorxSubsectoren/StedelijkGroen/Totaal/IsBeschikbaar_zichtjaar), FALSE)'
			, Descr = "Grond zonder woningen of banen waar de zeef van stedelijk groen een park toelaat. Daar komt een park zonder afweging tegen wat er staat, want er hoeft niemand te wijken; ook op een perceel dat de herontwikkeling heeft geleegd (#480, #906).";
			attribute<Bool>      IsBebouwd         (AdminDomain) := ='IsOpenVoorPark && (HeeftBanen || HeeftWoningen) && MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantData/Zeef/'+Context/ThisZichtjaar_name+'/SectorxSubsectoren/StedelijkGroen/Totaal/IsBeschikbaar_BijAfweging), FALSE)'
			, Descr = "Een cel met woningen of banen die de zeef voor een afweging openlaat (Templates/Beschikbaarheden/Zeef_T/IsBeschikbaar_BijAfweging). Daar komt alleen een park als de baat de kosten dekt (BaatDektKosten, #906).";
			parameter<Eur_m2>    BaatPerM2Tekort   := VariantParameters/VariantK/StedelijkGroenBaatPerM2Tekort[Variant_rel][Eur_m2];
			attribute<meter2>    TekortBinnenStraal (AdminDomain) := ='potential(TekortVoorClaim, ' + Kern + ')[meter2]', Descr = "Het hele tekort dat meetelt voor de claim van de woningen binnen de straal van de cel, wat een park hier hooguit kan oplossen.";
			attribute<Bool>      SluitAanOpGroen   (AdminDomain) := potential(float32(IsBestaandGroenOfWater), /Geography/Distmatrices_25m/pot25m/binair) > 0f && !IsBestaandGroenOfWater
			, Descr = "Grenst de cel aan bestaand groen, natuur of water (IsBestaandGroenOfWater), met dezelfde buren als de vormtoets? Dan krijgen de baat en de geschiktheid de opslag van ModelParameters/StedelijkGroen/OpslagAansluitenBestaandGroen.";
			parameter<Float32>   Opslag            := 1f + /ModelParameters/StedelijkGroen/OpslagAansluitenBestaandGroen;
			attribute<Eur>       Baat              (AdminDomain) := min_elem(TekortBinnenStraal, AdminDomain/NrMeter2PerCell) * BaatPerM2Tekort * (SluitAanOpGroen ? Opslag : 1f)
			, Descr = "Wat een park op deze cel oplevert: het tekort dat hij kan oplossen maal VariantK/StedelijkGroenBaatPerM2Tekort, met de opslag als de cel op bestaand groen aansluit (SluitAanOpGroen). Een m2 park lost hooguit een m2 tekort op, dus niet meer dan het oppervlak van de cel, en niet meer dan er binnen de straal tekort is.";
			attribute<Eur>       KostenWoningen    (CompactedAdminDomain) := ='collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, HeeftWoningen ? MakeDefined(/BaseData/Suitabilities/Wonen/Opstalkosten/PerZichtjaar/'+Context/ThisZichtjaar_name+'/Verwerving_Woningen/Result, 0[Eur]) + MakeDefined(/BaseData/Suitabilities/Wonen/Opstalkosten/Sloop_Woningen/Result, 0[Eur]) : 0[Eur])'
			, Descr = "Verwerven en slopen van de woningen op de cel, uitgesmeerd over het perceel zoals bij wonen, met de vervangingsfactor van het zichtjaar; nul waar de herontwikkeling de woningen al heeft weggehaald.";
			attribute<Bool>      BaatDektKosten    (AdminDomain) := BaatPerM2Tekort > 0[Eur_m2] && Baat >= recollect_by_cond(AdminDomain/IsCompactedDomain, Kosten, 0[Eur])
			, Descr = "Weegt de baat van een park op tegen de kosten van verwerving en sloop van wat er staat (Kosten)? Alleen dan mogen woningen of banen voor een park wijken; ze gaan uit de stand en hun claim blijft staan, zodat wonen en werken, die na stedelijk groen alloceren, ze elders in de regio kunnen terugzetten (#906).";
			attribute<Bool>      IsKandidaat       (AdminDomain) := IsVrijeGrond || (IsBebouwd && BaatDektKosten)
			, Descr = "Kan hier nieuw stedelijk groen komen? Op vrije grond altijd (IsVrijeGrond), op een cel met woningen of banen alleen als de baat de kosten dekt (IsBebouwd, BaatDektKosten).";
			attribute<Float32>   KandidatenInOmgeving (AdminDomain) := ='potential(float32(IsKandidaat), ' + Kern + ')', Descr = "Het aantal kandidaatcellen binnen de straal van de cel.";
			attribute<meter2>    TekortPerKandidaat (AdminDomain) := KandidatenInOmgeving > 0f ? TekortVoorClaim / KandidatenInOmgeving : 0[meter2], Descr = "Het tekort van de woningen in de cel dat meetelt voor de claim, gelijk verdeeld over de kandidaatcellen binnen de straal.";
			attribute<meter2>    TekortInOmgeving  (AdminDomain) := ='IsKandidaat ? potential(TekortPerKandidaat, ' + Kern + ')[meter2] : 0[meter2]'
			, Descr = "Het deel van het groentekort binnen de straal dat deze cel krijgt: elke woningcel verdeelt zijn tekort over de kandidaatcellen in zijn omgeving, zoals de normtoets het groen van een cel over de woningen eromheen verdeelt. Over alle kandidaatcellen opgeteld telt het tekort zo een keer, en een cel bij een handvol woningen krijgt alleen hun kleine tekort.";
			attribute<Bool>      IsGeschikt        (AdminDomain) := TekortInOmgeving >= /ModelParameters/StedelijkGroen/MinTekortAandeelVanCel * AdminDomain/NrMeter2PerCell
			, Descr = "Lost een park op deze cel genoeg tekort op? Alleen als het tekort dat de cel in totaal toebedeeld krijgt minstens ModelParameters/StedelijkGroen/MinTekortAandeelVanCel van zijn oppervlak is. Wat op de geschikte cellen niet past, blijft tekort.";
			attribute<Eur>       Grond             (CompactedAdminDomain) := MakeDefined(/ModelParameters/Wonen/Grondwaarde/PerKlasse[collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/StartState/Bodemstatistiek/gg_CBS)] * AdminDomain/NrHaPerCell, 0[Eur])
			, Descr = "De verwerving van de grond, met de grondwaarde per bodemgebruiksklasse die ook het exploitatiesaldo van wonen gebruikt (ModelParameters/Wonen/Grondwaarde).";
			attribute<Eur>       Opstal            (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Opstalkosten/Verwerving_NietWoningen/Result + /BaseData/Suitabilities/Wonen/Opstalkosten/Sloop_NietWoningen/Result)
			, Descr = "Verwerven en slopen van wat er niet om te wonen staat, zoals een bedrijfspand, uitgesmeerd over het perceel zoals bij wonen (#861). De woningen staan in KostenWoningen.";
			attribute<Eur>       Kosten            (CompactedAdminDomain) := (KostenWoningen > 0[Eur] ? 0[Eur] : Grond) + Opstal + KostenWoningen
			, Descr = "Wat een park op deze cel kost aan verwerving en sloop. Waar woningen worden verworven, zit de grond al in hun hedonische waarde en telt hij niet apart, zoals in de verwerving van Templates/Indicatoren.";
			attribute<Float32>   Geschiktheid      (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, IsGeschikt) && Kosten > 0[Eur] ? float32(collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, TekortInOmgeving)) / float32(Kosten) * (collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, SluitAanOpGroen) ? Opslag : 1f) : null_f
			, Descr = "De geschiktheid voor nieuw stedelijk groen: het deel van het groentekort dat de cel krijgt per euro aan verwerving, dus vierkante meter tekort per euro, met de opslag als de cel op bestaand groen aansluit (SluitAanOpGroen); leeg waar de cel niet geschikt is. De claim legt al vast hoeveel hectare er komt, dus de geschiktheid hoeft alleen te zeggen waar die hectares het meeste tekort per euro oplossen. De aanleg van het park telt niet mee, want die kost per hectare overal hetzelfde. Ook de waarde van de cel voor wonen telt niet mee; die rekent pas de allocatie van wonen, per pakket. Gelezen door Templates/Allocatie/IterSubsector_T, dat een lege geschiktheid hier als onbeschikbaar telt.";

			attribute<Bool>      IsBestaandGroenOfWater (AdminDomain) := IsGroenKlasse || recollect_by_cond(AdminDomain/IsCompactedDomain, IsWater, FALSE) || GroenNabijheid/Bron/Mutatie_IsNatuur || GroenNabijheid/Bron/Mutatie_IsWater || GroenNabijheid/Bron/Mutatie_IsStedelijkGroen
			, Descr = "Groen, natuur of water aan het begin van het zichtjaar: groen volgens de CBS-kaart van het basisjaar, water in het landgebruik, en wat er in eerdere zichtjaren als natuur, water, waterberging of stedelijk groen bij kwam. Telt mee voor de omvang in de vormtoets van stedelijk groen als ModelParameters/StedelijkGroen/VormtoetsTeltBestaandGroenEnWater aanstaat (#906).";
			attribute<Bool>      BestaandGroenInVormtoets (AdminDomain) := /ModelParameters/StedelijkGroen/VormtoetsTeltBestaandGroenEnWater && IsBestaandGroenOfWater, Descr = "Het bestaande groen en water dat de vormtoets van stedelijk groen meetelt voor de minimale omvang en niet voor de breedte, in OmvangBasis van Templates/Allocatie/Iter_T/Iter_Allocatie en van NaAllocatie hieronder.";

			container NaAllocatie
			: Descr = "De grond waar na de allocatie van dit zichtjaar nog een park kan komen, voor het tekort dat met de regels van #480 niet op te lossen is (Templates/Indicatoren/BereikbaarheidGroen_T/Normtoets/TekortOnoplosbaar). Dat is de geschikte grond van dit zichtjaar die de allocatie niet
						heeft vastgelegd, en daarvan alleen wat de vormtoets haalt als die grond in een keer helemaal park wordt. De vormtoets is een kopie van die in Templates/Allocatie/Iter_T/Iter_Allocatie voor stedelijk groen, met het groen dat er dit zichtjaar al is aangelegd als aanhechting; een wijziging daar hoort hier ook."
			{
				attribute<Bool>    IsVastgelegd   (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, /Classifications/Actor/Sector/xSubsector/LegtCelVast[WriteStand_Compacted/SubSector_rel], FALSE), Descr = "Heeft de allocatie de cel tot en met dit zichtjaar vastgelegd, voor welke sector ook? Leest de schrijfkant van de stand en niet StateNaAllocatie, want die leest in de ontkoppelde stand de tifs terug die dit proces nog moet schrijven.";
				attribute<Bool>    IsVrij         (AdminDomain) := IsGeschikt && !IsVastgelegd, Descr = "Grond die aan het begin van het zichtjaar geschikt was voor een park en na de allocatie nog vrij is.";
				attribute<Bool>    IsNieuwGroen   (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, IsDefined(WriteStand_Compacted/SubSector_rel) && lowercase(/Classifications/Actor/Sector/xSubsector/Sector_name[WriteStand_Compacted/SubSector_rel]) == lowercase('StedelijkGroen'), FALSE) && !AlGealloceerdVoorDitZichtjaar, Descr = "Het stedelijk groen dat dit zichtjaar is aangelegd.";
				attribute<Bool>    Basis          (AdminDomain) := IsVrij || IsNieuwGroen, Descr = "De vrije grond plus het stedelijk groen van dit zichtjaar, zoals Gealloceerd_Basis in Iter_Allocatie voor stedelijk groen: een park moet zelf breed en groot genoeg zijn, en wat er voor andere sectoren of als BAG-nieuwbouw naast ligt telt niet mee (#906).";
				attribute<Bool>    Eroded         (AdminDomain) := potential(float32(Basis), /Geography/Distmatrices_25m/pot25m/binair) >= /ModelParameters/Advanced/MorfologischeCleaning_BuurCellen_StedelijkGroen + 1f, Descr = "De breedte-eis van de vormtoets: de cel en minstens zoveel buren als MorfologischeCleaning_BuurCellen_StedelijkGroen liggen in Basis.";
				attribute<Bool>    Dilated        (AdminDomain) := potential(float32(Eroded), /Geography/Distmatrices_25m/pot25m/binair) >= 1f, Descr = "Een cel met een buur die de breedte-eis haalt.";
				attribute<Bool>    Cleaned        (AdminDomain) := Basis && Dilated, Descr = "De cellen van Basis die de breedte-eis halen.";
				attribute<Bool>    OmvangBasis    (AdminDomain) := Cleaned || BestaandGroenInVormtoets, Descr = "De cellen waarop de omvang bepaald wordt, zoals OmvangBasis in Iter_Allocatie: wat de breedte-eis haalt, plus het bestaande groen en water als de vormtoets dat meetelt (#906).";
				unit<UInt32>       Park           := district_8(OmvangBasis), Descr = "De aaneengesloten stukken van OmvangBasis, met 8-connectiviteit zoals in de vormtoets."
				{
					attribute<ha>  Oppervlakte    := pcount(Districts)[float32] * AdminDomain/NrHaPerCell;
				}
				attribute<Bool>    IsParkMogelijk (AdminDomain) := IsVrij && Cleaned && Park/Oppervlakte[Park/Districts] >= (/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain ? /ModelParameters/Advanced/Minimum_alloc_group_size_Binnenstedelijk_StedelijkGroen : /ModelParameters/Advanced/Minimum_alloc_group_size_Buitenstedelijk_StedelijkGroen)
				, Descr = "Kan hier na de allocatie nog een park komen? De cel is vrij, haalt de breedte-eis en ligt in een stuk dat de minimale omvang haalt, in een woonkern Minimum_alloc_group_size_Binnenstedelijk_StedelijkGroen en daarbuiten Minimum_alloc_group_size_Buitenstedelijk_StedelijkGroen. Weggeschreven als WriteStand/StedelijkGroen/ParkMogelijk.";
			}
		}

		container WerkenGeschiktheid
		: Descr = "Werken-geschiktheid met de landgebruiksaandelen van het begin van dit zichtjaar (#647, analoog aan GroenNabijheid #637). De logit is geschat op start-of-period landgebruik: de aandelen
							wonen, natuur en water in de cel en het buurtaandeel overig bebouwd (1000 m) worden bijgewerkt met wat het model sinds het basisjaar heeft gealloceerd of exogeen opgelegd, beginstand van het
							zichtjaar, dus geen endogeniteit binnen het zichtjaar. Nieuw werken telt via het buurtaandeel mee en trekt zo vervolgallocaties aan. Bouwterrein en de UAI blijven statisch, daarvoor is geen
							modelbron, en de IBIS-werklocaties ook: nieuw werken buiten IBIS wordt geen IBIS (#708). Alleen toevoegingen tellen; wat een cel voorheen was wordt niet van de statische aandelen afgetrokken, want nieuw gebruik landt vrijwel altijd op cellen die aan geen van deze
							aandelen bijdroegen. In het eerste zichtjaar is de kaart exact de statische kaart."
		{
			parameter<bool> IsEersteZichtjaar := Impl/GroenNabijheid/IsEersteZichtjaar;

			container Bron
			: Descr = "Zelfde beginstand-bron als GroenNabijheid (#637): het nieuwe landgebruik waar dat sinds het basisjaar is veranderd, anders null."
			{
				// doelklassen conform de gg-indeling van de logit: wonen naar residential, werken naar otherbuiltup (telt alleen via de 1000m-buurtterm), natuur naar nature, water inclusief waterberging naar unavailable. Wie de cel bezet komt van de sector, wat de cel is van het type; zie GroenNabijheid/Bron.
				attribute<float32> NieuwResidential  (AdminDomain) := float32(Sector/IsWonen[Impl/GroenNabijheid/Bron/Sector_Mutatie] && !IsDefined(Impl/GroenNabijheid/Bron/Type_Mutatie));
				attribute<float32> NieuwOtherBuiltup (AdminDomain) := float32(Sector/IsWerken[Impl/GroenNabijheid/Bron/Sector_Mutatie] && !IsDefined(Impl/GroenNabijheid/Bron/Type_Mutatie));
				attribute<float32> NieuwNature       (AdminDomain) := float32(Impl/GroenNabijheid/Bron/Mutatie_IsNatuur);
				attribute<float32> NieuwWater        (AdminDomain) := float32(Impl/GroenNabijheid/Bron/Mutatie_IsWater);
			}

			container Deltas
			: Descr = "Toename van de aandelen per 100m-cel (het schattingsgrid), en van het buurtaandeel overig bebouwd met exact dezelfde kernel en noemer als de statische variabele (BaseData/Grondgebruik/BBG Avg_shr_LUType_neigh r1000)."
			{
				attribute<float32> dResidential          (rdc_100m) := mean(Bron/NieuwResidential,  AdminDomain/rdc_100m_rel);
				attribute<float32> dOtherBuiltup         (rdc_100m) := mean(Bron/NieuwOtherBuiltup, AdminDomain/rdc_100m_rel);
				attribute<float32> dNature               (rdc_100m) := mean(Bron/NieuwNature,       AdminDomain/rdc_100m_rel);
				attribute<float32> dWater                (rdc_100m) := mean(Bron/NieuwWater,        AdminDomain/rdc_100m_rel);
				attribute<float32> dOtherBuiltup_ngh1000 (rdc_100m) := rdc_100m/IsStudyArea	? potential(dOtherBuiltup * float32(rdc_100m/IsStudyArea), /Geography/Distmatrices/Impl_100m/pot1000m/PotRange/neighbourhood) / potential(float32(rdc_100m/IsStudyArea), /Geography/Distmatrices/Impl_100m/pot1000m/PotRange/neighbourhood) : 0f;
				attribute<float32> dLnAfstandUrbanContour (rdc_100m) := float32(log(AfstandTotUrbanContour/Afstand_km / 1[km]) - log(/BaseData/Omgeving/BebouwdGebied/AfstandTotUrbanContour/Afstand_km / 1[km])), Descr = "Hoeveel de logaritme van de afstand tot de contour sinds de statische kaart is afgenomen door nieuwbouw; nul of negatief, want de contour groeit alleen (#911).";
			}

			container AfstandTotUrbanContour := /BaseData/Omgeving/BebouwdGebied/AfstandTot_T(/BaseData/Omgeving/BebouwdGebied/UrbanContour || Impl/TredeDynamischeUrbanContour/IsAangeslotenNieuwbouw), Descr = "De afstand tot het bebouwd gebied aan het begin van dit zichtjaar: de begrenzing van BegrenzingBebouwdGebied_jaar plus de nieuwbouw van eerdere zichtjaren die aan een woonkern vastzit (#862), zodat de contourterm meegroeit met wat het model bouwt (#911).";

			container       PerSector         := for_each_ne(Jobs6/name, 'PerSector_T('+quote(Jobs6/name)+')'), Descr = "Bijgewerkte kans per Jobs6-sector; zelfde MNL-formule als de statische kaart, met de coefficienten uit dezelfde CSV.";

			Template PerSector_T
			{
				parameter<String>  Sectorname;

				attribute<Float32> raw                 (AdminDomain) := ='MakeDefined(
				                                                        /BaseData/Suitabilities/Werken/ProbabilityMap_perSector/'+Sectorname+'/raw
				                                                        + Deltas/dResidential[AdminDomain/rdc_100m_rel]          * /BaseData/Suitabilities/Werken/ReadCoefficients/'+Sectorname+'/Result/lu_share_residential
				                                                        + Deltas/dNature[AdminDomain/rdc_100m_rel]               * /BaseData/Suitabilities/Werken/ReadCoefficients/'+Sectorname+'/Result/lu_share_nature
				                                                        + Deltas/dWater[AdminDomain/rdc_100m_rel]                * /BaseData/Suitabilities/Werken/ReadCoefficients/'+Sectorname+'/Result/lu_share_unavailable
				                                                        + Deltas/dOtherBuiltup_ngh1000[AdminDomain/rdc_100m_rel] * /BaseData/Suitabilities/Werken/ReadCoefficients/'+Sectorname+'/Result/avgshr_otherbuiltup_1000m
				                                                        + Deltas/dLnAfstandUrbanContour[AdminDomain/rdc_100m_rel] * /BaseData/Suitabilities/Werken/ReadCoefficients/'+Sectorname+'/Result/ln_dist_urbancontour
				                                                        , -1e9f)', Descr = "Statische raw plus de coefficient maal de toename van elk aandeel sinds het basisjaar en maal de afname van de logaritme van de afstand tot de contour. Nodata blijft -1e9 (kans 0, #599).";
				attribute<Float32> noemer              (AdminDomain) := ='1f + ' + asList('exp(PerSector/'+Jobs6/name+'/raw)', ' + ');
				attribute<Float32> exponentiated       (AdminDomain) := exp(raw) / noemer;
				attribute<Float32> raw_ordinaal        (AdminDomain) := raw <= -1e8f ? null_f : raw, Descr = "Nodata wordt null zodat die cellen nooit in de kandidaatset komen (#599), conform de statische raw_ordinaal.";

				parameter<bool>    GebruikStatisch                   := IsEersteZichtjaar, Descr = "In het eerste zichtjaar zijn de mutaties per definitie leeg en hoeft de dynamische berekening niet te draaien.";

				attribute<Float32> Totaal     (CompactedAdminDomain) := = GebruikStatisch
				                                                        ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Werken/ProbabilityMap_perSector/'+Sectorname+'/exponentiated)'
				                                                        : 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, exponentiated)', Descr = "MNL-kans: statisch of per zichtjaar bijgewerkt. Gebruikt voor de keuze tussen subsectoren; de allocatie-input is Totaal_raw.";
				attribute<Float32> Totaal_raw (CompactedAdminDomain) := = GebruikStatisch
				                                                        ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Werken/ProbabilityMap_perSector/'+Sectorname+'/raw_ordinaal)'
				                                                        : 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, raw_ordinaal)', Descr = "Raw-nut met null voor nodata: statisch of per zichtjaar bijgewerkt. De allocatie-input, want binnen een subsector telt alleen de rangorde en de MNL-noemer verstoort die.";
			}
		}

		container VerblijfsrecreatieGeschiktheid
		: Descr = "Geschiktheid voor verblijfsrecreatie met de logies van het begin van dit zichtjaar (#649), zoals WerkenGeschiktheid. De logit is geschat op de logies aan het begin van de periode;
							de statische kaart neemt die uit de basisjaarstand. Hier tellen de objecten die het model sinds het basisjaar heeft gebouwd mee, met de gemiddelde voetafdruk per object, zodat nieuwe
							verblijfsrecreatie de cellen eromheen geschikter maakt. In het eerste zichtjaar is de kaart exact de statische kaart."
		{
			parameter<bool>    IsEersteZichtjaar              := Impl/GroenNabijheid/IsEersteZichtjaar;
			parameter<bool>    HeeftSector                    := ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector;
			container          Statisch                       := /BaseData/Suitabilities/Verblijfsrecreatie/ProbabilityMap_Verblijfsrecreatie/Variant_Dist_1000m_Neighbourhood;

			parameter<Float32> VoetafdrukPerObject            := = HeeftSector
			                                                     ? 'value(sum(MakeDefined(/BaseData/StartState/StateBasisjaar/State/Verblijfsrecreatie/Footprint, 0[meter2])), Float32) / value(sum(MakeDefined(/BaseData/StartState/StateBasisjaar/State/Verblijfsrecreatie/Totaal, 0f)), Float32)'
			                                                     : '0f'
			, Descr = "Gemiddelde voetafdruk van logies per object in de basisjaarstand, in m2: de voetafdruk die een gebouwd object aan de logiesterm toevoegt.";
			attribute<Float32> ObjectenErbij    (AdminDomain) := = HeeftSector
			                                                     ? 'max_elem(MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, StateVoorAllocatie0/Verblijfsrecreatie/Totaal), 0f) - MakeDefined(value(/BaseData/StartState/StateBasisjaar/State/Verblijfsrecreatie/Totaal, Float32), 0f), 0f)'
			                                                     : 'const(0f, AdminDomain)'
			, Descr = "Objecten verblijfsrecreatie die er aan het begin van dit zichtjaar meer staan dan in het basisjaar. Alleen toevoegingen tellen, zoals bij werken.";
			attribute<Float32> Logies_100m         (rdc_100m) := Statisch/Logies_100m + value(sum(ObjectenErbij, AdminDomain/rdc_100m_rel), Float32) * VoetafdrukPerObject;
			attribute<Float32> Logies_Venster_100m (rdc_100m) := Logies_100m + potential(Logies_100m, /Geography/Distmatrices/Impl_100m/pot100m/PotRange/neighbourhood), Descr = "Zelfde venster als de statische kaart: de cel zelf en de acht cellen eromheen.";
			attribute<Float32> Delta_raw           (rdc_100m) := (log(1f + Logies_100m) - log(1f + Statisch/Logies_100m)) * Statisch/Coef/ln_vr_bag
			                                                     + (log(1f + Logies_Venster_100m) - log(1f + Statisch/Logies_Venster_100m)) * Statisch/Coef/ln_vr_venster_bag
			, Descr = "Wat de logit erbij krijgt door de logies die sinds het basisjaar zijn gebouwd.";
			attribute<Float32> raw              (AdminDomain) := Statisch/raw + Delta_raw[AdminDomain/rdc_100m_rel], Descr = "Statische raw plus de toename van de logiesterm. Nodata blijft rond -1e9 (kans 0, #599).";
			attribute<Float32> exponentiated    (AdminDomain) := AdminDomain/IsStudyArea ? exp(raw) / (1f + exp(raw)) : 0f;
			attribute<Float32> Totaal  (CompactedAdminDomain) := = IsEersteZichtjaar
			                                                     ? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Statisch/exponentiated)'
			                                                     : 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, exponentiated)', Descr = "De kans op verblijfsrecreatie: statisch in het eerste zichtjaar, daarna met de logies van het begin van het zichtjaar. De allocatie-input van verblijfsrecreatie (IterSubsector_T).";
		}
	}
	
	container StateNaAllocatie := = Impl/Ontkoppeld ? 'Impl/ReadStand_Compacted' : 'Impl/WriteStand_Compacted'
	{
		container WindPath := = Impl/Ontkoppeld && ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector
		                      ? 'Impl/ReadStand_Compacted/Wind'
		                      : ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector
		                          ? 'Impl/WriteStand_Compacted/Wind'
		                          : 'StateVoorAllocatie/Wind'
		, Descr = "De turbines na de allocatie. Zonder windsector alloceert het model geen wind en staan er na de allocatie dezelfde turbines als ervoor; de stand zelf heeft dan geen windvariabelen.";
		container Wind := WindPath
		{
			unit<uint64> Objects := select_with_attr_by_cond(WindPath, WindPath/Totaal > 0f)
			{
				attribute<rdc_meter> geometry :=  collect_by_cond(., WindPath/Totaal > 0f, CompactedAdminDomain/point)
				{
					parameter<meter> SymbolWorldSize := 10[meter] , DialogType = "SymbolWorldSize  ";
					parameter<int16> SymbolIndex     := 83s       , DialogType = "SymbolIndex";
				}
			}
		}
	}
}