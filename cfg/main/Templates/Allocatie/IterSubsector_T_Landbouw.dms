////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Beschikbaar voor allocatie in dit zichtjaar, en waar de cel geen blokkerende functie draagt, geen extra
// restricties vanwege windmolens, niet vanwege huidige zonneweides en of de minimal landavailability gehaald
// wordt. Een cel die al landbouw is doet elk zichtjaar opnieuw mee, want het gewas mag wisselen; zie #803.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template IterSubsector_T_Landbouw
{
	parameter<Subsector> id;
	unit<UInt8> Subsector;
	container StateVoorAllocatie;
	container Context0;
	//
	
	container Context := Context0
	{
		container ThisSubsector := ..;
	}
	
	parameter<String> name               := Subsector/name[id];
	parameter<String> Subsector_pathname := Subsector/Sector_name_Thisname[id];
	parameter<String> Zichtjaar_name     := Context/ThisZichtjaar/name;
	parameter<String> AllocRegio_name    := Context/ThisSectorAllocRegio/AllocRegio_name;
	
	unit<uint64> CompactedAdminDomain := Geography/CompactedAdminDomain
	{ 
		attribute<Bool>    Beschikbaar                     := = 'ThisVariantData/PotentieleState/'+Zichtjaar_name+'/per_SectorxSubsectoren/'+Subsector_pathname+'/IsBeschikbaar_zichtjaar 
																		&& (IsNull(StateVoorAllocatie/SubSector_rel) || /Classifications/Actor/Sector/xSubsector/IsLandbouw[StateVoorAllocatie/SubSector_rel]) 
																		&& !ExtraRestrictieDoorHuidigeZonneweide 
																		&& !GeeftOnvoldoendeRuimte_Landbouw', Descr = "Beschikbaar voor allocatie in dit zichtjaar: wat de zeef van dit zichtjaar overlaat, geen blokkerende functie op de cel, geen extra restrictie door een huidige zonneweide, en genoeg ruimte volgens de schijftoets MinimalLandAvailability_Landbouw.

					De tweede regel wijkt af van IterSubsector_T, en dat is de reparatie van #803. Daar staat IsNull(SubSector_rel), dus een cel die ooit is gealloceerd doet nooit meer mee. Voor wonen en werken klopt dat, want wat gebouwd is blijft staan. Voor landbouw niet: elk zichtjaar kiest opnieuw welk gewas er ligt, en de landbouwstand is geen voorraad maar de uitkomst van dat ene zichtjaar, want Update_Expr_DiscrAlloc in Allocatie_T draagt niets over uit de ingangsstand.

					Met de harde IsNull alloceerde het eerste zichtjaar het hele landbouwareaal en was er daarna geen cel meer vrij. Gemeten in de productierun van 9 september 2026, BAU: de elf standkaarten samen 1.869.372 ha in Y2040, 37.005 ha in Y2050 en 0,25 ha in Y2120, terwijl het door SubSector_rel gelabelde landbouwareaal per zichtjaar precies met die bedragen opliep, tot het basisjaarareaal van 1.910.708 ha. Dat optellen is de vingerafdruk: elke cel werd hoogstens een keer gealloceerd.

					De drie gevallen. Geen label betekent nog niets gealloceerd, dus beschikbaar. Een landbouwlabel uit een eerder zichtjaar is weer beschikbaar, want het gewas mag wisselen. Een stedelijk, natuur- of waterbergingslabel blokkeert, ook als het uit dit zichtjaar komt, want die sectoren gaan in de volgorde voor. Dat het oude landbouwlabel het nieuwe daarna niet overschaduwt regelt Iter_Landbouw_T/StateNaAllocatie1/Subsector_rel.

					De vorm is een OR met een IsNull ervoor en geen MakeDefined om de opzoeking heen, en dat is geen stijlkwestie. Een opzoeking met een lege index levert op een booleaanse kolom FALSE op en geen null, dus MakeDefined(IsLandbouw[SubSector_rel], TRUE) doet niets en zet de poort juist overal dicht. Gemeten op 9 september 2026 in een losse dms op GeoDms20.17.0.m, met drie rijen: een landbouwlabel, een ander label en een lege. De kale opzoeking geeft TRUE, FALSE, FALSE en de MakeDefined-vorm hetzelfde, terwijl IsNull(rel) || IsLandbouw[rel] TRUE, FALSE, TRUE geeft. De MakeDefined-vorm heeft in de allocatie ook echt gestaan en viel meteen om: Y2040 alloceerde nul hectare en de lege-kaarttoets op WriteStand/SubSector_rel gaf exit 1.";
																		// && !ExtraRestrictieDoorWindAllocatie  //vgm is dit niet nodig voor landbouw allocatie!
																		
																		
		attribute<Bool>    GeeftOnvoldoendeRuimte_Landbouw := = 'ThisVariantData/Zeef/'+Zichtjaar_name+'/SectorxSubsectoren/'+Subsector_pathname+'/src/GeeftOnvoldoendeRuimte_Landbouw';
	}
}