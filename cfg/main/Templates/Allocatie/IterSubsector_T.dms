////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Op AdminDomain niveau wordt de geschiktheid en beschikbaarheid opgehaald/bepaald. Is land unit i beschikbaar
// en niet al eerder dit of vorige zichtjaren gealloceerd, en niet niet nog een additionele restrictie door wind
// allocatie? Wat is de toegestane dichtheid D voor deze subsector per land unit i, check nog eens op
// beschikbaarheid.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template IterSubsector_T
{
	//
	parameter<Subsector> id;
	unit<UInt8> Subsector;
	container StateVoorAllocatie;
	container Context0;
	//
	
	container Context := Context0
	{
		container ThisSubsector := ..;
	}
	
	parameter<String> name               := Subsector/name[id];
	parameter<String> Subsector_name     := Subsector/name[id], Descr = "Dezelfde waarde als name hierboven, maar onder een naam die niet door de eigen-naam-eigenschap van een subcontainer wordt afgeschermd. Binnen CompactedAdminDomain levert een kale name de containernaam op en niet de subsector, dus alles wat daar de subsectornaam nodig heeft gebruikt deze parameter.";
	parameter<String> Subsector_pathname := Subsector/Sector_name_Thisname[id];
	parameter<String> Zichtjaar_name     := Context/ThisZichtjaar/name;
	parameter<String> AllocRegio_name    := Context/ThisSectorAllocRegio/AllocRegio_name;
	
	parameter<Bool>   IsPlancapaciteitNogGeldig := ='uint32('+substr(Zichtjaar_name, 1, 4)+') <= uint32(/ModelParameters/Advanced/PlancapaciteitGeldigTotEnMet)', Descr = "Dezelfde vervaldatum als in Templates/Beschikbaarheden/Zeef_T, hier voor de trede (#739).";
	parameter<String> TredeContainer            := /ModelParameters/Advanced/TredeVolgtPlancapaciteitVervaldatum && !IsPlancapaciteitNogGeldig
													? 'SectorxSubsectoren_ZonderPlancapaciteit'
													: 'SectorxSubsectoren'
	, Descr = "Welke van de twee trede-opbouwen dit zichtjaar gebruikt (#739). De tredes worden in VariantData gebouwd en kennen het zichtjaar niet, dus staan er twee klaar en valt de keuze hier, net zoals Zeef_T/BasisjaarZeefItem dat sinds #682 voor de zeef doet.

				Met TredeVolgtPlancapaciteitVervaldatum uit wijst dit altijd naar SectorxSubsectoren en komt de tweede opbouw niet in de boom.";

	parameter<String> TredeSrc                  := /ModelParameters/Advanced/TredeVolgtPlancapaciteitVervaldatum && !IsPlancapaciteitNogGeldig
													? 'src_ZonderPlancapaciteit'
													: 'src'
	, Descr = "Dezelfde keuze een laag lager, voor de tweede plek waar plancapaciteit voorrang geeft: SubsectorKeuzePrioriteit hieronder, de keuze tussen werksubsectoren die dezelfde cel boven hun zaaglijn hebben. Na de vervaldatum leest die de bron waarin geen cel in een plan ligt, zodat de prioriteit terugvalt op de stimuli en op de bestaande kantoorcel.";

	unit<UInt32> TredeK := = 'ThisVariantData/Trede/'+TredeContainer+'/'+Subsector_pathname+'/impl/Klasse';
	
	unit<uint64> CompactedAdminDomain := Geography/CompactedAdminDomain
	, Descr = "Op AdminDomain niveau wordt de geschiktheid en beschikbaarheid opgehaald/bepaald."
	{
		attribute<Bool>         Beschikbaar_Init                    := = 'ThisVariantData/PotentieleState/'+Zichtjaar_name+'/per_SectorxSubsectoren/'+Subsector_pathname+'/IsBeschikbaar_zichtjaar 
																			&& !(IsDefined(StateVoorAllocatie/SubSector_rel)) 
																			&& !RestrictiesVoorSectorenAlsGevolgVanWind/Restrictief_voor_beperkt_kwestbare_gebouwen 
																			&& !ExtraRestrictieDoorNieuwVervuilendWerken
																			&& !ExtraRestrictieVoorVervuilendWerkNabijWonen
																			&& !ExtraRestrictieDoorHuidigeZonneweide', Descr = "Is land unit i beschikbaar en niet al eerder dit of vorige zichtjaren gealloceerd, en niet niet nog een additionele restrictie door wind allocatie?

																			De term over SubSector_rel is meer dan een filter. Dat veld staat eerste-wint in Iter_T.dms:129 en wordt over de zichtjaren heen nooit gewist, dus wat het model eenmaal heeft gebouwd is de rest van de reeks onbeschikbaar. Daarmee is modelnieuwbouw onbeperkt beschermd terwijl de bestaande voorraad in de zeef een aflopende bescherming van 55 jaar kent, en die asymmetrie is de kern van #735.

																			Wie hem wil opheffen moet meer meenemen dan deze regel. Vier mechanismen leunen op de invariant dat een cel hoogstens een keer wordt gealloceerd: OP_rel is eerste-wint (Iter_T.dms:130), SubSector_rel zelf ook, Zichtjaar_T/FootprintEindejaars/GealloceerdDitZichtjaar eist een lege ingangswaarde, en Indicatoren/SloopNieuwbouwWonen telt nieuwbouw en sloop uit precies datzelfde verschil. Op een heralloceerde cel wijzen pakket en subsector daardoor naar de vorige toestand terwijl de hoeveelheden de nieuwe volgen, draagt de werk-pandvoetafdruk de oude waarde door, en tellen sloop en nieuwbouw als nul.

																			Daar komt de kostenkant bij. Verwervings- en sloopkosten in het exploitatiesaldo hangen aan de BAG van het basisjaar (BaseData/Suitabilities/Verwervingskosten.dms en BaseData/Suitabilities.dms), dus wat het model zelf bouwt heeft verwervingswaarde nul en sloopkosten nul. Vrijgegeven modelnieuwbouw zou daarmee de goedkoopste herontwikkelgrond van het land zijn en als eerste aan de beurt komen, precies omgekeerd aan de bedoeling.

																			Gemeten in BAU op de opgeleverde standrasters van 401f7b5e: een leeftijdsregel van 55 jaar op de allocatie zelf zou 52.047 ha vrijgeven in Y2100, 78.504 ha in Y2110 en 104.044 ha in Y2120, terwijl het model in die drie zichtjaren samen 7 cellen nieuw alloceert. Uitstellen kost in deze reeks dus niets. Zie #735.";
		
		attribute<Bool>         Beschikbaar_NaAfgewezenClusters     := ='Beschikbaar_Init && NOT('+Context/PrevItername+'/Allocatie/IsAfgewezen_Cumulatief)'
		, Descr = "Een afgewezen cel blijft de rest van deze sector-allocregio uitgesloten. Twee mildere varianten zijn geprobeerd en allebei afgevallen, zie ObjectVision/RSopen#643: terugkomen zodra er een gealloceerde buur is laat de allocatie volledig vastlopen, en terugkomen zodra de erosiedrempel gehaald zou worden levert per saldo niets op.";
		attribute<Bool>         Beschikbaar                         := = Context/ThisIter_rel >= ModelParameters/Advanced/IterVanafWaarWeAfgewezenCellenUitsluitenInAlloc
																			? 'Beschikbaar_NaAfgewezenClusters'
																			: 'Beschikbaar_Init';
	
		attribute<Float32>      PotentieleStateNaAllocatie := = 'ThisVariantData/PotentieleState/'+Zichtjaar_name+'/per_SectorxSubsectoren/'+Subsector_pathname+'/Zichtjaar * float32(Beschikbaar)', Descr = "Wat is de toegestane dichtheid D voor deze subsector per land unit i, check nog eens op beschikbaarheid.";
		
		parameter<bool>         IsSubsectorZelfVervuilendWerk            := lowercase(Subsector_name) == lowercase('nijverheid') || lowercase(Subsector_name) == lowercase('logistiek'), Descr = "Rond vervuilende werk locaties een buffer zodat daar bijv geen woningen of winkels komen.";
		parameter<bool>         IsSubsectorMilieuOngevoelig              := lowercase(Subsector_pathname) == lowercase('Waterberging/Totaal'), Descr = "Waterberging is geen milieugevoelige functie en mag dus wel direct naast nieuw vervuilend werk landen; de generieke vervuilend-werkbuffer geldt daar niet.";
		attribute<bool>         ExtraRestrictieDoorNieuwVervuilendWerken := =IsSubsectorZelfVervuilendWerk || IsSubsectorMilieuOngevoelig ? 'const(FALSE, .)' : 'RestrictiesVoorSectorenAlsGevolgVanVervuilendWerken/IsNietToegestaan', Descr = "Rond vervuilende werk locaties een buffer zodat daar bijv geen woningen of winkels komen.";
		attribute<bool>         ExtraRestrictieVoorVervuilendWerkNabijWonen := =IsSubsectorZelfVervuilendWerk ? 'RestrictiesVoorSectorenAlsGevolgVanVervuilendWerken/NietToegestaanVoor'+Subsector_name : 'const(FALSE, .)', Descr = "Omgekeerde milieuzonering: nieuwe nijverheid en logistiek houden zelf afstand tot bestaand en eerder gealloceerd wonen, met dezelfde VNG-bufferafstand als andersom.";
	
		parameter<bool>         IsWerkenSubsector          := lowercase(substr(Subsector_pathname, 0, 7)) == lowercase('Werken/'), Descr = "Werken-subsectoren gebruiken de geschiktheid uit het zichtjaar (Zichtjaar_T/WerkenGeschiktheid, #647); die valt zelf terug op de statische kaart wanneer ModelParameters/Werken/GeschiktheidDynamisch uit staat of in het eerste zichtjaar.";
		attribute<Float32>      Geschiktheid_Statisch      := = IsWerkenSubsector
																? (/ModelParameters/Werken/GeschiktheidAlsRaw
																	? 'Context/ThisZichtjaar/WerkenGeschiktheid/PerSector/'+Subsector_name+'/Totaal_raw'
																	: 'Context/ThisZichtjaar/WerkenGeschiktheid/PerSector/'+Subsector_name+'/Totaal')
																: 'ThisVariantData/Suitability/'+Zichtjaar_name+'/'+Subsector_pathname, Descr = "Geschiktheid S_ij zonder beschikbaarheidsmask. De mask zat hier tot augustus 2026 in (maal Beschikbaar), maar Beschikbaar hangt via de cumulatieve afwijzing aan de vorige iteratie, en daarmee was ook de sortering hieronder elke iteratie een nieuwe expressie: zes subsectoren maal vijftien iteraties maal vier blokken sorteringen over het hele compacted domain per zichtjaarproces. Zonder de mask is deze keten iteratie-invariant en deelt GeoDMS haar via expressie-identiteit over alle iteraties en blokken, zoals bij wonen (IterSubsector_T_Wonen sorteert de ongemaskeerde Geschiktheid_MaxElem_OP_sub) al jaren het geval is. De beschikbaarheid telt uitsluitend nog mee in de eindterm Geschiktheid. Voor werken standaard het raw-nut (GeschiktheidAlsRaw): binnen een subsector telt alleen de rangorde, en de MNL-noemer drukt cellen die voor meerdere sectoren aantrekkelijk zijn ten onrechte omlaag; de sectorconcurrentie wordt al apart beslist. Nodata is in Totaal_raw null (nooit kandidaat, #599). Let op: elke nieuwe term die Context/PrevItername of StateVoorAllocatie aanraakt breekt de deling stilletjes en kost dan direct tientallen seconden per iteratie.";
		attribute<Float32>      SubsectorKeuzePrioriteit   := = IsWerkenSubsector && /ModelParameters/Werken/TredePrioriteitInSubsectorKeuze
																? (lowercase(Subsector_name) == lowercase('Zak_dienstverlening') && /ModelParameters/Werken/KantoorVerdikkingInBestaand ? 'ThisVariantData/Trede/'+TredeSrc+'/BinnenBestaandKantoor[AllocDomain_rel] ? 4f : ' : '')
																+ 'ThisVariantData/Trede/'+TredeSrc+'/BinnenHardePlancapaciteitWerken_'+Subsector_name+'[AllocDomain_rel] ? 3f
																	: ThisVariantData/Trede/'+TredeSrc+'/BinnenZachtePlancapaciteitWerken_'+Subsector_name+'[AllocDomain_rel] ? 2f
																	: ThisVariantData/Trede/'+TredeSrc+'/BinnenStimuliWerken[AllocDomain_rel] ? 1f : 0f'
																: 'const(0f, .)', Descr = "Plancapaciteit- en stimuliprioriteit van deze cel voor deze subsector (KanOp-gefilterd): 3 = binnen harde plannen, 2 = binnen zachte plannen, 1 = binnen stimuli, 0 = anders; 4 = bestaande dominante kantoorcel voor zakelijke dienstverlening als KantoorVerdikkingInBestaand aanstaat (#668), zodat kantoor zijn eigen cellen vasthoudt in de subsectorkeuze. Uniform over de zes werksubsectoren, dus bruikbaar in de onderlinge vergelijking waar de tredescores zelf niet vergelijkbaar zijn (verschillend aantal treden per subsector).";
		attribute<Float32>      Geschiktheid_VoorSubsectorKeuze := = IsWerkenSubsector
																? 'IsDefined(Geschiktheid_Cleaned) ? SubsectorKeuzePrioriteit + Context/ThisZichtjaar/WerkenGeschiktheid/PerSector/'+Subsector_name+'/Totaal : null_f'
																: 'Geschiktheid_Cleaned', Descr = "Score voor de keuze tussen subsectoren die dezelfde cel boven hun zaaglijn hebben (Iter_Allocatie ArgMax). Voor werken lexicografisch: eerst de plancapaciteit-prioriteit, daarbinnen de MNL-kans (die ligt in [0,1), dus de prioriteit domineert). Zo kan een subsector met lage trede maar hoge kans niet langer een cel afpakken van een subsector met harde plannen daar.";
		attribute<Float32>      Geschiktheid_Cleaned       := Geschiktheid_Statisch == 0f ? null_f : Geschiktheid_Statisch, Descr = "Als de geschiktheid 0 is, willen we dit undefined hebben. Sorteert sinds de hoist de statische geschiktheid, dus ook cellen die (nog) niet beschikbaar zijn krijgen een rang; hun eindscore blijft 0 via de mask in Geschiktheid, en de zaaglijn weegt met het al gemaskeerde PotentieleStateNaAllocatie, dus de selectie onder beschikbare cellen is gelijk aan voorheen.";
		attribute<UInt32>       Geschiktheid_Ordered       := invert(index(Geschiktheid_Cleaned))[uint32], Descr = "In het allocatie proces moet de geschiktheid gesorteerd worden, zodat er greedy vanaf de meest geschikte locatie gealloceerd wordt.";
		parameter<Uint64>       Geschiktheid_Ordered_range := Uint64(max(Geschiktheid_Ordered)+100), Descr = "Wat is de maximale geschiktheid, plus een getal wat er voor zorgt dat er later geen dubbele waarden kunnen voorkomen.";
		attribute<UInt32>       TredeScore                 := (#TredeK - 1) - collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, TredeK/Per_AdminDomain)
																, Descr = "Tredes introduceren een volgordelijkheid in groepen cellen. Zodat onafhankelijk van de geschiktheid sommige groepen cellen boven andere geplaatst moeten worden.
																		Bijvoorbeeld dichtbij een OV-knooppunt. Hier wordt deze volgordelijkheid voorbereid. Met een check of de maximale waarde van een trede wel kleiner of gelijk is aan de cardinaliteit van de tredes. Is dit niet het geval, dan moet je meer onderzoek uitvoeren.

														De IntegrityCheck toetst exact de term die hierboven wordt afgetrokken. Tot #605 stond hij op TredeK/Per_AllocDomain over CompactedAllocDomain terwijl de aftrekking TredeK/Per_AdminDomain over CompactedAdminDomain gebruikt. Dat zijn twee verschillende verzamelingen cellen, dus de toets kon slagen terwijl de aftrekking onder nul ging en in UInt32 omsloeg naar een enorme TredeScore.", IntegrityCheck = "max(collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, TredeK/Per_AdminDomain)) < #TredeK";
		attribute<Uint64>       Geschiktheid               := Uint64(Beschikbaar) * (Uint64(TredeScore) * Geschiktheid_Ordered_range + Uint64(Geschiktheid_Ordered)), Descr = "Hier wordt de sorteerde geschiktheid gecombineerd met de tredescores tot een aangepaste geschiktheid in groepen per trede.";
	}

	unit<UInt32> AllocRegio := Context/ThisSectorAllocRegio/AllocRegio
	{
		attribute<Float32> RestClaim := = replace( 
			'ThisVariantData/Claims/'+Scenario_name+'/Zichtjaren/@Z@/SectorAllocRegios/@AS@/@S@'+AllocRegio_StudyArea_orgrel+' - sum(StateVoorAllocatie/@SP@, Per_CompactedAdminDomain)',
			'@Z@' , Zichtjaar_name,
			'@AS@', Context/ThisSectorAllocRegio/name,
			'@S@' , Context/ThisSubsector/name,
			'@SP@', Subsector_pathname
		), Descr = "Hier de restclaim C_jr bepaald, door van de claim voor deze regio en subsector de stand voor deze allocatie stap af te trekken.";
		
		attribute<Ha>     Beschikbaar           := sum_uint32(CompactedAdminDomain/Beschikbaar, Per_CompactedAdminDomain)[float32] * AdminDomain/NrHaPerCell, Descr = "Aggregatie van beschikbaarheid in AdminDomain middels R_ir uitgedrukt in hectare.";
		attribute<Bool>   GeenRuimteOfRestclaim := Beschikbaar == 0[ha] || RestClaim <= 0[float32], Descr = "Is geen ruimte in deze regio, of er geen of een negatieve restclaim?";
		
		attribute<Uint64> MaxGeschiktheid       := max(CompactedAdminDomain/Geschiktheid, collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, AllocRegio/Per_AdminDomain)), Descr = "Wat is de maximale geschiktheid in deze regio?";
		parameter<Uint64> MaxGeschiktheid_value := max(CompactedAdminDomain/Geschiktheid), Descr = "Overall maximale geschiktheid.";
		
		attribute<Uint64> Afkapgrens0 := MaxGeschiktheid_value - nth_element_weighted(                // omkering
				MaxGeschiktheid_value - CompactedAdminDomain/Geschiktheid,                            // rank
				max_elem(RestClaim, 0f),                                                              // target
				CompactedAdminDomain/PotentieleStateNaAllocatie,                                      // weight, hier geen potentiele delta gebruikt; evt sloop van deze subsector heralloceren we in volgende iteraties
				collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Per_AdminDomain) // R_ir
		), Descr = "hier wordt de zaaglijn Z_ij bepaald.";
		
		attribute<Uint64> Afkapgrens := GeenRuimteOfRestclaim ? null_u64 : MakeDefined(Afkapgrens0, 0u64), Descr = "Als er uberhaupt geen ruimte of restclaim is voor deze regio, dan mag de zaaglijn undefined zijn. Anders neem je de zaaglijn. Echter, de zaaglijn kan undefined zijn als de niet genoeg cellen beschikbaar zijn om de claim te realisteren. In dat geval wordt de zaagzlijn zo gezet dat alle cellen daarin vallen.";
	}
}
