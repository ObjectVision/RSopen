// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Legt een buffer rond cellen, op basis van de gridcelgrootte. Wordt in de allocatie gebruikt om afstand te houden
// tot vervuilende bedrijvigheid en tot windturbines.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Buffer_gridcel_T // voor buffer points bepaling 
: Descr = "Template om een buffer rondom punten te maken op basis van de gridcelgrootte."
{
	attribute<Bool>    TeBufferen_src (CompactedAdminDomain);
	parameter<Float64> buffersize;
	///
	attribute<Bool>  TeBufferen (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, TeBufferen_src);
	parameter<Int16> gridbuffersize := roundup(buffersize / AdminDomain/gridsize)[int16];
	
	//bovengrens van range is exclusief, dus +1s zodat de kernel de volle bufferafstand haalt (was een cel te klein; conventie conform Geography/Distmatrices)
	unit<SPoint> kernel_buffer  := range(spoint, point_yx(-gridbuffersize, -gridbuffersize), point_yx(gridbuffersize +1s, gridbuffersize +1s))
	{
		attribute<UInt32>  dist     := dist2(point_yx(0s, 0s, .), uint32);
		attribute<Float32> distMatr := dist <= uint32(sqr(gridbuffersize)) ? 1f : 0f;
	}
	attribute<Float32> proximity_arg          (AdminDomain) := float32(TeBufferen), Descr = "1 als er iets te bufferen is, anders 0";
	parameter<Bool> IsErIetsTeBufferen                      := sum_uint32(TeBufferen) != 0, Descr = "Check of er uberhaupt iets te bufferen is, anders bufferberekening overslaan";
	attribute<Bool> proximity_res_AdminDomain (AdminDomain) := IsErIetsTeBufferen ? potential(proximity_arg, kernel_buffer/distMatr)  > 0.5f : const(FALSE, AdminDomain), Descr = "True als er iets te bufferen is en de potential kernel buffer > 0.5 is. Anders false";
	attribute<Bool> proximity_res    (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, proximity_res_AdminDomain), Descr = "Resultaat in compacted domain";
}
