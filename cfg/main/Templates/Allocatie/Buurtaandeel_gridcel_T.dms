// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaalt per cel welk deel van de omliggende cellen binnen een straal een kenmerk heeft. Wordt in de allocatie
// gebruikt om aaneengesloten woongebied te onderscheiden van losse woningen in het buitengebied.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Buurtaandeel_gridcel_T
: Descr = "Template om per cel het aandeel cellen met een kenmerk binnen een straal te bepalen, op basis van de gridcelgrootte."
{
	attribute<Bool>    TeTellen_src (CompactedAdminDomain);
	parameter<Float64> straal;
	///
	attribute<Bool>  TeTellen (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, TeTellen_src);
	parameter<Int16> gridstraal := roundup(straal / AdminDomain/gridsize)[int16];
	
	//bovengrens van range is exclusief, dus +1s zodat de kernel de volle straal haalt, conform Buffer_gridcel_T en Geography/Distmatrices
	unit<SPoint> kernel_schijf := range(spoint, point_yx(-gridstraal, -gridstraal), point_yx(gridstraal +1s, gridstraal +1s))
	{
		attribute<UInt32>  dist     := dist2(point_yx(0s, 0s, .), uint32);
		attribute<Float32> distMatr := dist <= uint32(sqr(gridstraal)) ? 1f : 0f;
	}
	
	attribute<Float32> teller_arg (AdminDomain) := float32(TeTellen), Descr = "1 waar het kenmerk geldt, anders 0";
	attribute<Float32> noemer_arg (AdminDomain) := float32(AdminDomain/IsCompactedDomain), Descr = "Alleen cellen binnen het studiegebied tellen mee in de noemer, zodat het aandeel langs de kust en de landsgrens niet verdund wordt door zee en buitenland.";
	
	attribute<Float32> aandeel_res_AdminDomain (AdminDomain) := potential(teller_arg, kernel_schijf/distMatr) / max_elem(potential(noemer_arg, kernel_schijf/distMatr), 1f), Descr = "Aandeel van de cellen binnen het studiegebied binnen de straal dat het kenmerk heeft.";
	attribute<Float32> aandeel_res    (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, aandeel_res_AdminDomain), Descr = "Resultaat in compacted domain";
}
