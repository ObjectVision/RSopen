// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Template voor een iteratie binnen een allocatieproces. Het iteratienummer, beginnend bij 0. container met
// stand variabelen aan het begin van de allocatie in deze iteratie. Laadt via #include: Iter_Allocatie.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Iter_T
: Descr = "Template voor een iteratie binnen een allocatieproces."
{
	parameter<Iter> id : Descr = "Het iteratienummer, beginnend bij 0.";
	container StateVoorAllocatie : Descr = "container met stand variabelen aan het begin van de allocatie in deze iteratie.";
	container Context0 : Descr = "Context van de iteratie, met daarin de ThisIter container die naar deze Iter verwijst.";
	unit<UInt8> Iter : Descr = "unit met iters";
	container Impl0 : Descr = "container met implementatiegegevens voor de iteratie.";
	parameter<Bool> IsEnkelIter : Descr = "Is dit een enkelvoudige iteratie, dus zonder vervolg iteraties.";
	//
	
	parameter<String> name := Iter/name[id];
	
	container StartCalc0 : Descr = "Constructie voor PhaseContainers, deze string naam wordt dat 'gestart' alvorens iets anders te doen, en pas wanneer voorgaande stappen afgerond zijn."
	{parameter<String> IterName := Context/ThisZichtjaar_name+', '+Context/ThisSequencename+', '+Context/ThisSectorAllocRegioname+', '+Context/ThisItername;}
	container StartCalc := PhaseContainer(StartCalc0, 'Start calculating results for '+StartCalc0/IterName);

	container Context := Context0
	{
		container ThisIter := ..;
		parameter<String> ThisItername   := Iter/name[id];
		parameter<Iter>   ThisIter_rel   := id;
		parameter<String> PrevItername   := Iter/PrevName[id];
		parameter<bool>   IsFirstIter    := ThisIter_rel == 0b;
	}
	
	unit<UInt8>  Subsector  := Context/ThisSectorAllocRegio/Subsector;
	unit<UInt32> AllocRegio := Context/ThisSectorAllocRegio/AllocRegio;
	unit<UInt8> StandVar   := ='ThisVariantClassifications/StandVar';
	// unit<UInt8>  OP         := CaseClassifications/Vastgoed/OP;
	
	container Subsectoren :=
		for_each_ne(
			 Subsector/name
			,lowercase(Sector_name) == lowercase('Wonen')
				? 'IterSubsector_T_Wonen('+string(id(Subsector))+'[Subsector],Subsector,StateVoorAllocatie,Context)'
				: lowercase(Sector_name) == lowercase('Wind')
					? 'IterSubsector_T_Wind('+string(id(Subsector))+'[Subsector],Subsector,StateVoorAllocatie,Context)'
					: 'IterSubsector_T('+string(id(Subsector))+'[Subsector],Subsector,StateVoorAllocatie,Context)'
	), Descr = "Er zijn drie soorten IterSubsector templates, omdat voor wonen er een module over OP's nodig is, voor wind een deel over stempels, en voor de overige sectoren is het wel generiek.";
	
	#include<Iter_Allocatie.dms>
	
	attribute<Bool> IsNuGealloceerd (CompactedAdminDomain) := IsDefined(Allocatie/per_SectorxSubsector), Descr = "Geeft aan of er in deze iteratie voor deze cel iets gealloceerd is.";
	
	container Impl := Impl0
	{
		// parameter<Bool> HasNoAllocInCurrentIter := NOT(any(!IsDefined(StateVoorAllocatie/SubSector_rel) && IsDefined(StateNaAllocatie/SubSector_rel)));
		// parameter<Bool> HasNoRestClaim := RestClaim_NaAlloc == 0f;
		
		// parameter<String> RestClaim_NaAlloc_str := asList(
			// replace(
			// 'abs(sum(VariantData/Claims/@Z@/SectorAllocRegios/@AS@/@S@) - sum(StateNaAllocatie/@SP@))',
			// '@Z@' , Context/ThisZichtjaar/name,
			// '@AS@', Context/ThisSectorAllocRegio/name,
			// '@S@', Subsector/name,
			// '@SP@', Subsector/Sector_name_Thisname
			// )
		// , ' + ');
		
		// parameter<Float32> RestClaim_NaAlloc := =RestClaim_NaAlloc_str;
		
		// parameter<String> StopCriterium_NoAlloc    := 'any(HasNoAllocInCurrentIter)';
		// parameter<String> StopCriterium_NoClaim    := 'HasNoRestClaim';
		// parameter<Bool>   PrevStop                 := = lowercase(Context/PrevItername) == lowercase('Start') ? 'FALSE' : Context/PrevItername+'/Impl/StopCriterium';
		// parameter<String> DynamicStopCriterium_str := PrevStop ? 'TRUE' : StopCriterium_NoClaim +' || '+StopCriterium_NoAlloc;
		// parameter<Bool>   DynamicStopCriterium     := = DynamicStopCriterium_str;
		// parameter<Bool>   StopCriterium            := DynamicStopCriterium;
			
	
		parameter<Bool> StopCriterium       := StaticStopCriterium;
		parameter<Bool> StaticStopCriterium := IsEnkelIter ? TRUE : uint8(id) == uint8(#Iter) - 1b, Descr = "Is dit de laatste iteratie van het eigen blok? Toetste tot augustus 2026 tegen Default_NrOfIters, waardoor elke per-regel afwijking van dat aantal (kolommen AantalIters en AantalItersInLaterSeq) de IntegrityCheck op StateNaAllocatie brak.";
	}
	
	parameter<Bool> BehoudVerzorgendBijWonen := /ModelParameters/Werken/VerzorgendBlijftBijWoningbouw && lowercase(Sector_name) == lowercase('Wonen')
	, Descr = "Wint wonen deze cellen, en blijft de verzorgende werkgelegenheid dan staan in plaats van gesloopt te worden? Stuurt de pandvoetafdruk langs Behoud_Expr in plaats van Verdring_Expr, zodat die de stand volgt die StatePrep_T/VerdringingsTak laat staan (#710).";
	
	container StateNaAllocatie0 := 
		for_each_ne(
			Sector/xSubsector/name
			, 'StatePrep_T('+string(id(Sector/xSubsector))+'[Sector/xSubsector], Context/ThisIter)'
		), Descr = "Voorbereiden van de stand variabelen na allocatie, door de waarden uit de stand variabelen voor allocatie over te nemen."
	{
		container Wonen
		{
			attribute<m2PandFootprint> Footprint            (CompactedAdminDomain) := =
				lowercase(Sector_name) == lowercase('Wonen') 
					? Impl/Update_WoonFootprint_Expr
					: replace(Impl/Verdring_Expr
								, '@S@', 'Wonen'
								, '@SS@', 'Footprint'
							);
		}

		container PandFootprint :=
			for_each_nedv(
				Jobs6/name
				, lowercase(Sector_name) == lowercase('Werken') 
					? replace(Impl/Update_PandFootprint_Expr,'@Y@', Context/ThisZichtjaar/name, '@SS@', Jobs6/name)
					: replace(BehoudVerzorgendBijWonen && Jobs6/IsVerzorgend ? Impl/Behoud_Expr : Impl/Verdring_Expr, '@S@', 'PandFootprint', '@SS@', Jobs6/name)
				, CompactedAdminDomain
				, m2PandFootprint
			);
	}
	
	container StateNaAllocatie1 :=
		for_each_neidv(
			Sector/xSubsector/name
			, 'StateNaAllocatie0/'+Sector/xSubsector/name+'/Result'
			, 'IsDefined(StateNaAllocatie0/'+Sector/xSubsector/name+'/Result)'
			, CompactedAdminDomain
			, float32
		), Descr = "De resultaten van de verschillende subsectoren worden samengevoegd in één container. Als er voor een subsector niets gealloceerd is, bestaat die container niet en wordt die dus ook niet meegenomen."
	{
		attribute<Sector/xSubsector> SubSector_rel (CompactedAdminDomain) := MakeDefined(Allocatie/per_SectorxSubsector, StateVoorAllocatie/SubSector_rel)
		, Descr = "Het label na deze iteratie: wat deze allocatie neerzet wint, en waar zij niets neerzet blijft staan wat er stond.

					Dit stond tot 9 september 2026 andersom, met de ingangsstand voorop. Dat was hetzelfde antwoord zolang een cel hoogstens een keer gealloceerd kon worden, want dan is hoogstens een van de twee gevuld. Sinds #803 is een cel met een landbouwlabel weer beschikbaar, en dan zijn ze allebei gevuld: het gewas van het vorige zichtjaar en de woning of het bedrijf dat deze allocatie er neerzet. De nieuwe functie hoort dan te winnen, anders blijft de cel gewas heten terwijl er woningen op staan.

					Voor de sectoren die hun cellen wel vastleggen verandert er niets. Die alloceren alleen op cellen die vrij zijn, dus per_SectorxSubsector is daar alleen gevuld waar de ingangsstand leeg was of een gewas droeg. De volgorde van de twee argumenten kan daar dus geen verschil maken.

					OP_rel hieronder blijft eerste-wint en dat mag: de invariant die daar beschreven staat leunt erop dat een gevulde OP_rel een gevuld label impliceert, en de landbouwallocatie raakt OP_rel niet aan. Een cel met een gewas draagt dus nooit een ontwikkelpakket.";
		attribute<OP>                OP_rel        (CompactedAdminDomain) := MakeDefined(StateVoorAllocatie/OP_rel       , Allocatie/per_OP)
		, Descr = "Eerste-wint, en dat mag hier omdat de invariant geldt dat een gedefinieerde OP_rel een gedefinieerde SubSector_rel impliceert. Is per_OP gedefinieerd, dan was de cel Beschikbaar, dus was StateVoorAllocatie/SubSector_rel leeg, dus was StateVoorAllocatie/OP_rel dat ook, en levert de MakeDefined gewoon per_OP. Waar per_OP null is geven eerste-wint en laatste-wint allebei de oude waarde. De invariant wordt bewaakt in Allocatie_T/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/OP_rel; ga daarheen voordat je deze regel verandert.";
		
		container Wonen
		{
			attribute<m2PandFootprint> Footprint            (CompactedAdminDomain) := StateNaAllocatie0/Wonen/Footprint;
		}
		
		container PandFootprint :=
			for_each_nedv(
				Jobs6/name
				, 'StateNaAllocatie0/PandFootprint/'+Jobs6/name
				, CompactedAdminDomain
				, m2PandFootprint
			);
		
		container Wind
		{
			attribute<Yr>    Jaartal_ingebruikname (CompactedAdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'Allocatie/per_SectorxSubsector == Sector/xSubsector/V/Wind_Totaal ? UInt16(right(Context/ThisZichtjaar/name,4))[Yr] : StateVoorAllocatie/Wind/jaartal_ingebruikname' : 'StateVoorAllocatie/Wind/jaartal_ingebruikname';
			attribute<Meter> Ashoogte              (CompactedAdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'Allocatie/per_SectorxSubsector == Sector/xSubsector/V/Wind_Totaal ? ThisVariantClassifications/WindTurbineType/Ashoogte : StateVoorAllocatie/Wind/Ashoogte' : 'StateVoorAllocatie/Wind/Ashoogte';
			attribute<Meter> Rotordiameter         (CompactedAdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'Allocatie/per_SectorxSubsector == Sector/xSubsector/V/Wind_Totaal ? ThisVariantClassifications/WindTurbineType/Rotordiameter : StateVoorAllocatie/Wind/Rotordiameter' : 'StateVoorAllocatie/Wind/Rotordiameter';
			attribute<Meter> MaxWerpAfstandNom     (CompactedAdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'Allocatie/per_SectorxSubsector == Sector/xSubsector/V/Wind_Totaal ? ThisVariantClassifications/WindTurbineType/MaxWerpAfstandNom : StateVoorAllocatie/Wind/MaxWerpAfstandNom' : 'StateVoorAllocatie/Wind/MaxWerpAfstandNom';
		}

		container Landgebruik
		: Descr = "De stand-administratie landgebruik door de iteratie heen (#751). Het type verandert hier niet: een cel die wonen wordt houdt haar type, en SubSector_rel zegt dat ze bezet is. JaarVerandering wordt het lopende zichtjaar zodra een cel voor het eerst wordt gealloceerd, naar het patroon van Wind/Jaartal_ingebruikname."
		{
			attribute</Classifications/Grondgebruik/LandgebruikType> Type            (CompactedAdminDomain) := StateVoorAllocatie/Landgebruik/Type;
			attribute<Yr>              JaarVerandering (CompactedAdminDomain) := IsDefined(Allocatie/per_SectorxSubsector) ? UInt16(right(Context/ThisZichtjaar/name,4))[Yr] : StateVoorAllocatie/Landgebruik/JaarVerandering
			, Descr = "Het jaar waarin deze cel van functie veranderde: dit zichtjaar zodra deze allocatie de cel neemt, anders blijft staan wat er stond.

						De tweede voorwaarde, dat de ingangsstand nog leeg moest zijn, is met #803 vervallen. Die was overbodig zolang een cel hoogstens een keer gealloceerd kon worden, en werd onjuist toen een cel met een gewas weer beschikbaar werd: bouwt het model daar in 2060 woningen, dan is dat een verandering van functie en hoort 2060 er te staan en niet het jaar waarin de landbouwallocatie dat gewas koos.";
		}
	}

	container StateNaAllocatie2 :=
		for_each_nedvn(
			StandVar/Path
			, 'value(StateNaAllocatie1/'+StandVar/Path + ', scope(StandVar, '+StandVar/unit_name+'))'
			, CompactedAdminDomain
			, StandVar
			, StandVar/unit_name
		), Descr = "De stand variabelen na allocatie worden klaargezet in de juiste eenheden en met de juiste namen."
	{
		container Wonen
		{
			attribute<m2PandFootprint> Footprint              (CompactedAdminDomain) := StateNaAllocatie1/Wonen/Footprint;
			attribute<Woning>          Aantal_Woningen_Totaal (CompactedAdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'add('+asItemList(Classifications/Vastgoed/WP2xVSSH/name)+')' : 'const(0[woning], CompactedAdminDomain)';
		}
	}
	
	container StateNaAllocatie := PhaseContainer(StateNaAllocatie2, 'Results for '+string(StartCalc/IterName)+' are finished calculating');

	container Stand_PerAllocRegio := 
		for_each_nedvn(
			StandVar/Path
			, 'sum(StateNaAllocatie/'+StandVar/Path+', AllocRegio/Per_CompactedAdminDomain)'
			, AllocRegio
			, StandVar
			, StandVar/unit_name
		), Descr = "De stand variabelen na allocatie worden opgeteld per allocatieregio."
	{
		container wonen
		{
			attribute<Woning> Aantal_Woningen_Totaal (AllocRegio) := = 'add('+asItemList(Classifications/Vastgoed/WP2xVSSH/name)+')';
		}
	}
	
	container ClaimRealisatieNaAlloc := 
		for_each_nedv(
			Actor/Sector/xSubsector/StandVar_Path
			, replace(
				'Stand_PerAllocRegio/@SP@ / ThisVariantData/Claims/@SC@/Zichtjaren/@Z@/SectorAllocRegios/@AS@/@S@'+AllocRegio_StudyArea_orgrel+'',
				'@Z@' , Context/ThisZichtjaar_name,
				'@AS@', Context/ThisSectorAllocRegio/name,
				'@S@' , Actor/Sector/xSubsector/Subsector_name,
				'@SC@', Scenario_name,
				'@SP@', Actor/Sector/xSubsector/StandVar_Path)
			, AllocRegio
			, Float32
		)
	{
		container Wonen
		{
			attribute<Float32>          Totaal        (AllocRegio) := =replace(
				'Stand_PerAllocRegio/wonen/Aantal_Woningen_Totaal / ThisVariantData/Claims/@SC@/Zichtjaren/@Z@/SectorAllocRegios/@AS@/Totaal'+AllocRegio_StudyArea_orgrel+'',
				'@Z@' , Context/ThisZichtjaar_name,
				'@AS@', Context/ThisSectorAllocRegio/name,
				'@SC@', scenario_name
				);
		}
	}
}
