// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// yield reduction tbv HELP yield reduction berekening Uiteindelijke suitability die aan de alloc module wordt
// meegegeven. Laadt via #include: Dairy_T.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landbouw : using = "Classifications/Landbouw;Classifications/Actor"
{
	#include<Kapitalisatie_T.dms>

	Template Suitability_T
	{
		//
		parameter<String> Zichtjaar_name;
		parameter<String> Waterbeheeroptie_name;  //fka DeepDrainageVariant_name
		//
		
		// parameter<string> BeregeningsScenario := VariantParameters/VariantK/BeregeningsScenario[variant_rel];

		parameter<YearRange>     StartYear                := rjoin(lowercase(Zichtjaar_name), lowercase(Zichtjaar/name), Zichtjaar/PrevYearRange_rel);
		parameter<YearRange>     EndYear                  := rjoin(lowercase(Zichtjaar_name), lowercase(Zichtjaar/name), Zichtjaar/YearRange_rel);

		parameter<string>        KlimaatZichtjaar         := /classifications/Landbouw/WWL_Zichtjaren/label[min_index(abs(int32(/classifications/Landbouw/WWL_Zichtjaren/jaar) - int32(EndYear)))];
		parameter<DeepDrainageK> DeepDrainageVariant      := ='WaterbeheerOpties/DeepDrainageK_rel[WaterbeheerOpties/v/'+Waterbeheeroptie_name+']';
		parameter<Jaar>          PeriodDuRation           := (EndYear - StartYear)[jaar];
		parameter<Int16>         StYrPhoenix              := int16(round(float32(StartYear)/10f) * 10i);
		parameter<String>        StYrPhoenixStr           := rjoin(StYrPhoenix, Phoenix/Zichtjaar/StartYearPhoenix, Phoenix/Zichtjaar/namePhoenix);
		parameter<String>        EndYrPhoenixStr          := rjoin(EndYear, Phoenix/Zichtjaar/EndYearPhoenix, Phoenix/Zichtjaar/namePhoenix);
		attribute<LU_ModelType>  gg_LandbouwK   (rdc_25m) := /BaseData/StartState/Landgebruik/LU_Landbouw;
		attribute<Bool>          gg_IsStedelijk (rdc_25m) := /BaseData/StartState/Landgebruik/IsWoonlocatie || /BaseData/StartState/Landgebruik/IsWerklocatie;
		
		attribute<HELPbodems>    BodemType      (rdc_25m) := /SourceData/Landbouw/HELP/HELPbodemsNL;
		unit<UInt8>              ModelType                := LandbouwKlasses;
		parameter<Float32>       RentevoetDezeBoer        := = 'ModelParameters/Landbouw/Rentevoet_'+/ModelParameters/Landbouw/Boervariant_name;
		
		attribute<bool>          IsVeenGrond    (rdc_25m) := /sourcedata/Landbouw/Peat_thickness > 0.5[meter]; //to do: is dit een juiste rekenregel? betere data? wat gebruikt overheid?
		
		parameter<Eur_Ha_jaarlijks> GLB_EcoRegeling_Verwacht := VariantParameters/VariantK/GLB_EcoRegeling_Fractie_Goud[variant_rel]   * VariantParameters/VariantK/GLB_EcoRegeling_Bedrag_Goud[variant_rel]
																  + VariantParameters/VariantK/GLB_EcoRegeling_Fractie_Zilver[variant_rel] * VariantParameters/VariantK/GLB_EcoRegeling_Bedrag_Zilver[variant_rel]
																  + VariantParameters/VariantK/GLB_EcoRegeling_Fractie_Brons[variant_rel]  * VariantParameters/VariantK/GLB_EcoRegeling_Bedrag_Brons[variant_rel];

		attribute<Eur_Ha_jaarlijks> ANLb_veen_Verwacht (rdc_25m) := IsVeengrond ? VariantParameters/VariantK/ANLb_veen_Fractie[variant_rel] * VariantParameters/VariantK/ANLb_veen_Bedrag[variant_rel] : 0[Eur_Ha_jaarlijks];
		attribute<Eur_Ha_jaarlijks> TotaalSubsidie     (rdc_25m) := VariantParameters/VariantK/GLB_Basispremie[variant_rel] + GLB_EcoRegeling_Verwacht + ANLb_veen_Verwacht;
		
		container Factoren 
		{
			container Transitiekosten := 
				for_each_nedv(
					LandbouwKlasses/name
					, 'ModelParameters/Landbouw/Transitiekosten/'+ LandbouwKlasses/name
					, LandbouwKlasses
					, EUR_ha
				);
			
			container YieldReduction : Descr = "yield reduction"
			{
				attribute<Bool> AangetastVerziltGebied (rdc_25m) := /SourceData/Landbouw/Verzilting/AangetastVerziltGebied;
				
				parameter<Float32> MateAantastingVerziltingZichtjaar := lowercase(Zichtjaar_name) == lowercase('Y2030')
					? ModelParameters/Landbouw/Verzilt_OpbrengstDerving_Y2030 
					: ModelParameters/Landbouw/Verzilt_OpbrengstDerving_Y2030 == 1f
						? ModelParameters/Landbouw/Verzilt_OpbrengstDerving
						: (float32(EndYear - 2030[YearRange]) / 10f) * (ModelParameters/Landbouw/Verzilt_OpbrengstDerving / (float32(ModelParameters/Model_FinalYear - 2030[YearRange]) / 10f)); 
				
				container Result :=
					for_each_neidv(
						 GewasSoortYR/name
						,'min_elem('+GewasSoortYR/YR_bron+'/'+GewasSoortYR/name+' + float32(AangetastVerziltGebied) * MateAantastingVerziltingZichtjaar * float32('+string(GewasSoortYR/AantastingDoorVerzilt)+'), 1f)'
						,'all(!IsDefined(this) || (this >= 0f && this <= 1f))'
						, rdc_25m
						, float32
					)
				, Descr = "De opbrengstderving per gewas, als fractie tussen nul en een, plus het verziltingseffect.

							De min_elem kapt aan de bovenkant af op een. Aan de onderkant staat met opzet geen max_elem maar een IntegrityCheck, want een negatieve opbrengstderving is geen waarde die je stil wilt afronden: hij betekent dat er ergens een NoData-vlag als getal is meegerekend. Die situatie heeft tot 5 september 2026 bestaan, zie de toelichting bij Exotisch, en zij was in de uitkomst niet zichtbaar omdat de claimplafonds de gevolgen opvingen. Deze check is daar de kanarie voor.";
				
				container WWL := 
					for_each_nedv(
						WWL_GewasSoort/name
						, 'MakeDefined(/SourceData/Landbouw/Yield_Reduction/WWL_'+Variant_name+'/'+WWL_GewasSoort/name+' / 100f, ModelParameters/Landbouw/YieldReduction_NoData)'
						, rdc_25m
						, float32
					);
					
				container WWL2 := 
					for_each_nedv(
						Classifications/Landbouw/BeregeningsScenarioGewassen/name
						, 'MakeDefined(
							/SourceData/Landbouw/Yield_Reduction/BeregeningScenario_Lokaal_WWL/'+Variant_name+'/'+/ModelParameters/Landbouw/BeregeningScenario_name+'/Read/'+Classifications/Landbouw/BeregeningsScenarioGewassen/name+',
							MakeDefined(
								mean(/SourceData/Landbouw/Yield_Reduction/BeregeningScenario_Lokaal_WWL/'+Variant_name+'/'+/ModelParameters/Landbouw/BeregeningScenario_name+'/Read/'+Classifications/Landbouw/BeregeningsScenarioGewassen/name+', rdc_25m/rdc_500m_rel)[rdc_25m/rdc_500m_rel],
								mean(/SourceData/Landbouw/Yield_Reduction/BeregeningScenario_Lokaal_WWL/'+Variant_name+'/'+/ModelParameters/Landbouw/BeregeningScenario_name+'/Read/'+Classifications/Landbouw/BeregeningsScenarioGewassen/name+')
							)
						) / 100f'
						, rdc_25m
						, float32
					);

				container WWL_dyn :=  
					for_each_nedv( 
						/SourceData/Landbouw/Yield_Reduction/WWL_relatie_database/WWL_Gewassen/GeneriekeNaam
						, '/SourceData/Landbouw/Yield_Reduction/OpbrengstenDerving_Dynamisch/'+Variant_name+'/'+KlimaatZichtjaar+'/'+/SourceData/Landbouw/Yield_Reduction/WWL_relatie_database/WWL_Gewassen/name+'/OpbrengstDerving'
						, rdc_25m
						, float32
					);
				
				container Exotisch :=
					for_each_nedv(
						Exotische_GewasSoort/name
						, '1f - /SourceData/Landbouw/WUR_Kansenkaarten/PerVariant/'+variant_name+'/Kansenkaarten/'+Exotische_GewasSoort/name
						, rdc_25m
						, float32
					)
				, Descr = "Opbrengstderving voor de gewassen zonder WWL-curve, afgeleid uit de WUR-kansenkaarten.

							Hier stond tot 5 september 2026 een MakeDefined naar ModelParameters/Landbouw/YieldReduction_NoData, en dat is min 99.999. Gemeten op zichtjaar 2040 van BAU droeg 97,3 procent van de cellen die waarde, want de kansenkaarten dekken maar een fractie van het land. Verderop staat ActualYield = MaxYield * (1 - YieldReduction) * Rotation, dus min 99.999 werd daar een opbrengstfactor van honderdduizend. Voor cranberry gaf dat ruim een miljard euro bruto-opbrengst per hectare op vrijwel heel Nederland, en die vijf gewassen hadden daarmee overal de hoogste geschiktheid van alle dertien. Alleen hun maximumclaim hield ze tegen: Cranberry, Rijst en Yacon kwamen alle drie op de hectare nauwkeurig op hun plafond uit, net als Rietteelt en Moerasbomen.

							Zonder de MakeDefined blijft een ontbrekende kansenkaart een null, en die wordt in Result opgevangen door de afkapping min_elem(..., 1f). LET OP dat dat de werkzame route is en niet null-propagatie: min_elem(null, 1f) geeft 1 en geen null. De opbrengstderving wordt daar dus 100 procent, ActualYield wordt nul, en het gewas houdt alleen zijn productiekosten over. Voor cranberry is dat ongeveer min 4.800 euro per hectare, dus de allocator kiest hem daar niet, en dat is wat een ontbrekende kansenkaart hoort te betekenen: dit gewas kan hier niet.

							Gemeten op 5 september 2026: de kansenkaart van cranberry heeft 141.717.600 nulls op 145.600.000 cellen, dus 97,3 procent zonder waarde, en de 2,7 procent die wel een waarde heeft ligt tussen 0,53 en 0,87. Result/Cranberry heeft daarna nul nulls en een gemiddelde van 0,983.

							WIE DE min_elem WEGHAALT verandert dus stil het gedrag: dan komt de null wel bij ActualYield en NetRevenue_ha, en laat max_elem_ifdefined in Akkerbouw_T het gewas vallen. De uitkomst is voor een klasse met een gewas dezelfde, maar voor Rietteelt, die twee gewassen heeft, niet: daar bepaalt de max_elem over riet en lisdodde welke van de twee wint, en een nul telt anders dan een null.

							LET OP, dit blijft een categoriefout die alleen kleiner is gemaakt. Een kansenkaart zegt of een gewas ergens kan staan, niet welke fractie van de maximale opbrengst het haalt. Zolang 1 min kans als opbrengstderving wordt gelezen, staat er een geschiktheidsindex op de plaats van een opbrengstfractie. De nette oplossing is de kaart als beschikbaarheidsmasker gebruiken en de opbrengst apart schatten; dat vraagt een uitspraak van WUR over de opbrengst van deze gewassen."; 
				
				container YieldReduction_HELP := 
					for_each_nedv(
						HELP_GewasSoort/name
						, 'MakeDefined(HELP_StartYr/YieldReduction/'+HELP_GewasSoort/name+'/Result + HELP_EndYr/YieldReduction/'+HELP_GewasSoort/name+'/Result / 2f, ModelParameters/Landbouw/YieldReduction_NoData)' 
						, rdc_25m
						, float32
					);
				
				container HELP_StartYr := HELP_Year_T(StYrPhoenixStr), Descr = "tbv HELP yield reduction berekening";
				container HELP_EndYr   := HELP_Year_T(EndYrPhoenixStr), Descr = "tbv HELP yield reduction berekening";
				
				Template HELP_Year_T : Descr = "tbv HELP yield reduction berekening"
				{
					//
					parameter<String> Year;
					//
					
					container Peil := 
						for_each_ne(
							PeilK/name
							, 'Peil_T('+string(id(PeilK))+'[PeilK])'
						);
					
					container YieldReduction := 
						for_each_ne(
							HELP_GewasSoort/name
							, 'YieldReduction_T(HELP_GewasSoort/V/'+HELP_GewasSoort/name+')'
						);
					
					Template Peil_T
					{
						//
						parameter<PeilK> id;
						//
						parameter<String> Peilname                    := PeilK/name[id];  
						
						attribute<UInt32> ResultDDOption   (rdc_25m) := ='/SourceData/Landbouw/HELP/'+Peilname+'_merged_'+VariantK/PeilStrategie[/Variant_rel]+'_DD/'+Year+'[rdc_25m/rdc_100m_rel]';
						attribute<UInt32> ResultNoDDOption (rdc_25m) := ='/SourceData/Landbouw/HELP/'+Peilname+'_merged_'+VariantK/PeilStrategie[/Variant_rel]+'_NoDD/'+Year+'[rdc_25m/rdc_100m_rel]';
						attribute<UInt32> Result           (rdc_25m) := /SourceData/Landbouw/DDPossible ? ResultDDOption: ResultNoDDOption;
					}
					
					Template YieldReduction_T
					{
						//
						parameter<HELP_GewasSoort> id;
						//
						
						attribute<String> code (rdc_25m) :=
							HELP_GewasSoort/HELP_Code[id] + '_' +
							HELPbodems/code[BodemType] + '_'+
							GLGHelpKlasse/code[Peil/GLG/Result] + '-' +
							GHGHelpKlasse/code[Peil/GHG/Result];
						
						attribute<Float32> result (rdc_25m) :=
								rjoin(
									  code
									, OpbrengstDerving/code
									, OpbrengstDerving/TS
								);
					}
				}
			}
		}
		
		container per_ModelType := 
			for_each_ne(
				LandbouwKlasses/name
				, LandbouwKlasses/Templatetype+'_T('+quote(LandbouwKlasses/name)+')'
			), using = "ModelParameters/Landbouw"
		{
			container NonLandbouw
			{
				attribute<Eur_m2>           Totaal (rdc_25m) := const(0[Eur_m2], rdc_25m);
				attribute<Eur_m2>           NPV    (rdc_25m) := Totaal;
				
				attribute<Float32>          Suitability (rdc_25m) := Totaal, Descr = "Uiteindelijke suitability die aan de alloc module wordt meegegeven.";
			}
		}
	}
	
	#include<Dairy_T.dms>
	#include<Akkerbouw_T.dms>
}