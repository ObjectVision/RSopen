// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De rekenkern voor de kosten van bouwen op een bodemdalingsgevoelige ondergrond (#505).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Bodemdalingkosten_T
: Descr = "De aanlegkosten per inrichtingsalternatief, de goedkoopste daarvan, de meerkosten ten opzichte van de zandgrondreferentie en het bijbehorende onderhoud, in euro per hectare terrein.

			Het sjabloon krijgt de grondgebruikverdeling binnen als zes attributen op AdminDomain, in m2 per hectare terrein. Dat maakt twee aanroepen mogelijk met precies dezelfde formules:

			Per ontwikkelpakket, met const-attributen, voor het exploitatiesaldo. Daar moeten alle pakketten naast elkaar staan omdat de geschiktheid ze vergelijkt.

			Een keer per cel, met de verdeling van het pakket dat er daadwerkelijk is gealloceerd, voor de indicator. Die aanroep is 53 keer goedkoper dan per pakket rekenen en achteraf selecteren.

			De kengetallen, de locatiegebonden tarieven en de beschikbaarheid komen uit BaseData/Suitabilities/Wonen/Bodemdalingkosten en staan bewust buiten dit sjabloon: ze hangen niet van het pakket af en hoeven dus maar een keer over het domein te worden uitgerekend."
{
	//
	attribute<Terreinoppervlak> m2_Bebouwing      (AdminDomain);
	attribute<Terreinoppervlak> m2_Tuin           (AdminDomain);
	attribute<Terreinoppervlak> m2_Straat         (AdminDomain);
	attribute<Terreinoppervlak> m2_Park           (AdminDomain);
	attribute<Terreinoppervlak> m2_OpenbareRuimte (AdminDomain);
	attribute<Terreinoppervlak> m2_Water          (AdminDomain);
	//

	container Src := /BaseData/Suitabilities/Wonen/Bodemdalingkosten;
	unit<UInt8> Alt := /Classifications/Modellering/InrichtingsalternatiefK;

	attribute<Terreinoppervlak> m2_WaterDrijvend (AdminDomain) := add(m2_Water, m2_Tuin, m2_Park)
	,	Descr = "Bij drijvend bouwen worden de tuinen en parken volledig vervangen door water, zie D.2.6 van het rapport.";

	container Alternatief
	: Descr = "De aanlegkosten per alternatief, in euro per hectare terrein, exclusief de opslag van 19 procent. Elke regel is een inrichtingselement maal zijn tarief; welke posten meedoen volgt de kruisjes in de tabellen E-1 tot en met E-8."
	{
		attribute<Eur_Ha> A_IntegraalOphogen (AdminDomain) := (
			  m2_Bebouwing      * (Src/Tarief/Ophogen + Src/Tarief/Paal)
			+ m2_Tuin           * (Src/Tarief/Ophogen + Src/Kengetallen/InrichtenGroen)
			+ m2_Straat         * (Src/Tarief/Ophogen + Src/Kengetallen/Verharding + Src/Kengetallen/Riolering)
			+ m2_Park           * (Src/Tarief/Ophogen + Src/Kengetallen/InrichtenPark)
			+ m2_OpenbareRuimte * (Src/Tarief/Ophogen + Src/Kengetallen/InrichtenGroen)
			+ m2_Water          *  Src/Tarief/Ophogen
			)[Eur] / 1[Ha];

		attribute<Eur_Ha> B_PartieelOphogen (AdminDomain) := (
			  m2_Bebouwing      * (Src/Tarief/Ophogen + Src/Tarief/Paal)
			+ m2_Tuin           *  Src/Kengetallen/InrichtenGroen
			+ m2_Straat         * (Src/Tarief/Ophogen + Src/Kengetallen/Verharding + Src/Kengetallen/Riolering)
			+ m2_Park           *  Src/Kengetallen/InrichtenPark
			+ m2_OpenbareRuimte * (Src/Tarief/Ophogen + Src/Kengetallen/InrichtenGroen)
			+ m2_Water          *  0[Eur_m2]
			)[Eur] / 1[Ha]
		,	Descr = "Partieel ophogen laat tuinen, parken en water op het oorspronkelijke materiaal liggen en hoogt alleen bebouwing, straten en de overige openbare ruimte op. Daarmee is dit alternatief per constructie nooit duurder dan integraal ophogen: het is A min drie posten. Dat het in de praktijk vrijwel altijd wint is dus geen artefact van de implementatie maar van de kengetallen. Zie #505.";

		attribute<Eur_Ha> C_OphogenMet120cmZand (AdminDomain) := (
			  m2_Bebouwing      * (Src/Tarief/OphogenC + Src/Tarief/Paal)
			+ m2_Tuin           * (Src/Tarief/OphogenC + Src/Kengetallen/InrichtenGroen)
			+ m2_Straat         * (Src/Tarief/OphogenC + Src/Kengetallen/Verharding + Src/Kengetallen/Riolering)
			+ m2_Park           * (Src/Tarief/OphogenC + Src/Kengetallen/InrichtenPark)
			+ m2_OpenbareRuimte * (Src/Tarief/OphogenC + Src/Kengetallen/InrichtenGroen)
			+ m2_Water          *  Src/Tarief/OphogenC
			)[Eur] / 1[Ha];

		attribute<Eur_Ha> D_LichtOphoogmateriaal (AdminDomain) := (
			  m2_Bebouwing      * (Src/Tarief/EPS + Src/Tarief/Paal)
			+ m2_Tuin           * (Src/Tarief/EPS + Src/Kengetallen/InrichtenGroen)
			+ m2_Straat         * (Src/Tarief/EPS + Src/Kengetallen/Verharding + Src/Kengetallen/Riolering)
			+ m2_Park           * (Src/Tarief/EPS + Src/Kengetallen/InrichtenPark)
			+ m2_OpenbareRuimte * (Src/Tarief/EPS + Src/Kengetallen/InrichtenGroen)
			+ m2_Water          *  0[Eur_m2]
			)[Eur] / 1[Ha];

		attribute<Eur_Ha> E_AllesFunderen (AdminDomain) := (
			  m2_Bebouwing      *  Src/Tarief/Paal
			+ m2_Tuin           * (Src/Kengetallen/Betonconstructie + Src/Kengetallen/InrichtenGroen)
			+ m2_Straat         * (Src/Kengetallen/BetonEnVerharding + Src/Tarief/VerhardingE + Src/Kengetallen/Riolering + Src/Tarief/Paal)
			+ m2_Park           * (Src/Kengetallen/Betonconstructie + Src/Kengetallen/InrichtenPark + Src/Tarief/Paal)
			+ m2_OpenbareRuimte * (Src/Kengetallen/Betonconstructie + Src/Kengetallen/InrichtenGroen + Src/Tarief/Paal)
			+ m2_Water          *  0[Eur_m2]
			)[Eur] / 1[Ha]
		,	Descr = "Uitzondering op het funderen is het water in de openbare ruimte, zie D.2.5 van het rapport.";

		attribute<Eur_Ha> F_DrijvendBouwen (AdminDomain) := (
			  m2_Bebouwing      * (Src/Kengetallen/Afgraven_vast + Src/Kengetallen/Drijfconstructie)
			+ m2_Straat         * (Src/Kengetallen/Verharding + Src/Kengetallen/Riolering + Src/Kengetallen/Steigers)
			+ m2_OpenbareRuimte *  Src/Kengetallen/InrichtenGroen
			+ m2_WaterDrijvend  *  Src/Tarief/AfgravenD
			)[Eur] / 1[Ha]
		,	Descr = "Bij drijvend bouwen worden tuinen en parken vervangen door water, dat afgegraven moet worden. De ophoogzandposten voor het wegtalud uit E-4, E-5 en E-7 zijn niet meegenomen: die staan per m3 en vragen een dijkgeometrie die RSopen niet kent. Zie de aannamelijst bij #505.";
	}

	attribute<Eur_Ha> Goedkoopste (AdminDomain) :=
		min_elem(
			 Src/Beschikbaar/A ? Alternatief/A_IntegraalOphogen     : null_f
			,Src/Beschikbaar/B ? Alternatief/B_PartieelOphogen      : null_f
			,Src/Beschikbaar/C ? Alternatief/C_OphogenMet120cmZand  : null_f
			,Src/Beschikbaar/D ? Alternatief/D_LichtOphoogmateriaal : null_f
			,Src/Beschikbaar/E ? Alternatief/E_AllesFunderen        : null_f
			,Src/Beschikbaar/F ? Alternatief/F_DrijvendBouwen       : null_f
		)
	,	Descr = "De goedkoopste van de toegestane alternatieven. Nooit middelen over alternatieven: de extreme afgraafdieptes tot 251 meter op de zandgronden zijn geen fout maar het rapport dat drijvend bouwen daar onbetaalbaar maakt, en met een minimum valt dat alternatief daar vanzelf af in plaats van het gemiddelde te vergiftigen.";

	attribute<Alt> Keuze (AdminDomain) :=
		  Goedkoopste == Alternatief/A_IntegraalOphogen     ? Alt/V/A_IntegraalOphogen
		: Goedkoopste == Alternatief/B_PartieelOphogen      ? Alt/V/B_PartieelOphogen
		: Goedkoopste == Alternatief/C_OphogenMet120cmZand  ? Alt/V/C_OphogenMet120cmZand
		: Goedkoopste == Alternatief/D_LichtOphoogmateriaal ? Alt/V/D_LichtOphoogmateriaal
		: Goedkoopste == Alternatief/E_AllesFunderen        ? Alt/V/E_AllesFunderen
		: Alt/V/F_DrijvendBouwen
	,	Descr = "Welk alternatief het goedkoopst uitkomt. Voor kaartbeeld, diagnose en de keuze van de onderhoudspost.";

	attribute<Eur_Ha> Referentie (AdminDomain) := (
		  m2_Bebouwing      *  Src/Tarief/OphogenRef
		+ m2_Tuin           * (Src/Tarief/OphogenRef + Src/Kengetallen/InrichtenGroen)
		+ m2_Straat         * (Src/Tarief/OphogenRef + Src/Kengetallen/Verharding + Src/Kengetallen/Riolering)
		+ m2_Park           * (Src/Tarief/OphogenRef + Src/Kengetallen/InrichtenPark)
		+ m2_OpenbareRuimte * (Src/Tarief/OphogenRef + Src/Kengetallen/InrichtenGroen)
		+ m2_Water          *  Src/Tarief/OphogenRef
		)[Eur] / 1[Ha]
	,	Descr = "Integraal ophogen op een locatie zonder bodemdalingsopgave: de minimale ophoging van 0,20 meter die de eis maaiveld plus 20 cm oplegt, en geen heipalen. Dat is het nulpunt waartegen de meerkosten worden gemeten, en het is dezelfde referentie die het rapport gebruikt als het de kaarten relatief ten opzichte van de Brabantse zandgronden toont.

				Omdat de vlakke posten hier net zo goed in zitten, vallen verharding, riolering en het inrichten van groen tegen elkaar weg zolang ophogen wint. Wat overblijft is de extra ophoging plus de heipalen, en voor de alternatieven D, E en F ook hun eigen constructieposten.";

	attribute<Eur_Ha> Meerkosten (AdminDomain) := max_elem((Goedkoopste - Referentie) * Src/Kengetallen/Opslag, 0[Eur_Ha])
	,	Descr = "De meerkosten ten opzichte van de zandgrondreferentie, met de opslag van 19 procent voor algemene kosten, uitvoeringskosten en winst en risico. Begrensd op nul: een locatie kan niet goedkoper zijn dan de referentie, want die staat al op de minimale ophoging zonder palen.";

	container Onderhoud
	: Descr = "Beheer en onderhoud over honderd jaar, netto contante waarde, uit tabel E-9. Deze post gaat NIET in het exploitatiesaldo: hij valt bij de gemeente en niet bij de ontwikkelaar. Hij staat hier om als maatschappelijke indicator te kunnen worden uitgelezen.

				Let op wat tabel E-9 wel en niet onderscheidt. De tarieven zijn gelijk voor alle zes de alternatieven; het verschil zit alleen in welke elementen er zijn en in twee posten die alleen bij drijvend bouwen spelen, de steigers en het baggeren. Tussen integraal en partieel ophogen maakt de tabel dus geen enkel verschil, terwijl juist daar het argument ligt: een niet opgehoogde tuin op veen zakt weg en moet periodiek terug omhoog. Dat kengetal geeft het rapport niet, en daarom kan deze post de keuze tussen A en B ook niet rechtzetten. Zie #505.

				Voetnoot 16 bij de tabel meldt dat voor het alternatief met 1,20 meter zand de onderhoudskosten wel per pixel zijn bepaald, uit de zettingssnelheid, met een reconstructie bij 40 cm zetting. Dat raster is niet geleverd, dus die dynamiek zit hier niet in en alternatief C krijgt hetzelfde onderhoud als de rest."
	{
		attribute<Eur_Ha> AndersDanDrijvend (AdminDomain) := (
			  m2_Tuin           * Src/Kengetallen/Onderhoud_Groen
			+ m2_Park           * Src/Kengetallen/Onderhoud_Groen
			+ m2_OpenbareRuimte * Src/Kengetallen/Onderhoud_Groen
			+ m2_Straat         * (Src/Kengetallen/Onderhoud_Verharding + Src/Kengetallen/Onderhoud_Riolering)
			)[Eur] / 1[Ha];

		attribute<Eur_Ha> Drijvend (AdminDomain) := (
			  m2_OpenbareRuimte * Src/Kengetallen/Onderhoud_Groen
			+ m2_Straat         * (Src/Kengetallen/Onderhoud_Riolering + Src/Kengetallen/Onderhoud_Steigers)
			+ m2_WaterDrijvend  *  Src/Kengetallen/Onderhoud_Water
			)[Eur] / 1[Ha]
		,	Descr = "Bij drijvend bouwen zijn tuinen en parken water geworden, staan er steigers, en heeft de verharding volgens tabel E-9 geen onderhoudspost. Dat laatste is opvallend naast een aanlegpost voor verharding van 75 euro; de tabel kruist bij straten verharding alleen A tot en met E aan, terwijl bij wegen verharding ook F is aangekruist. Omdat straten, wegen en parkeervakken hier samengevoegd zijn, moest een van beide rijen gekozen worden en dat is de straatrij geworden.";

		attribute<Eur_Ha> Totaal (AdminDomain) := Keuze == Alt/V/F_DrijvendBouwen ? Drijvend : AndersDanDrijvend
		,	Descr = "Het onderhoud dat hoort bij het alternatief dat op deze plek het goedkoopst in aanleg is.";
	}
}
