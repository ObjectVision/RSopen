// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de woningwaarde per woningtype (i.e. WP4) in het basisjaar ten behoeve van de verwervingskosten.
// Eén integrale hedonische formule met alle termen onder elkaar, in dezelfde stijl als
// Woningwaarde_OP_T/Prijs_perWoning00 (de eerdere opsplitsing in Pand/Generiek/Locatie is vervallen, #566).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Woningwaarde_perWoningType_T
: Descr = "Bepaal de woningwaarde per woningtype (i.e. WP4) in het basisjaar ten behoeve van de verwervingskosten"
{
	parameter<WP4> WP4_id;
	//

	parameter<String> WP4_name := WP4/name[WP4_id];

	attribute<Float32> LnSizeTerm (AdminDomain) := =
		replace(
			'log(MakeDefined(@BAG@/'+WP4_name+' / 1[m2_vbo] / max_elem(MakeDefined(@CNT@/'+WP4_name+'[float32], 1f), 1f), 1f)) * @C@/lnsize'
			,'@BAG@', '/SourceData/Vastgoed/BAG/PerJaar/Y'+string(/ModelParameters/BAG_RecentYear)+'/VBO/Per_Gebruiksdoel/woon/Select/Oppervlaktes/per_WP4_AdminDomain'
			,'@CNT@', '/SourceData/Vastgoed/BAG/PerJaar/Y'+string(/ModelParameters/BAG_RecentYear)+'/VBO/Per_Gebruiksdoel/woon/Select/Counts/per_WP4_AdminDomain'
			,'@C@',   '/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+WP4_name+'/Result'
		), Descr = "De lnsize-term: gemiddelde BAG-woonoppervlakte per woning van de bestaande voorraad van dit WP4 per cel, maal de lnsize-coefficient. Oppervlaktes/per_WP4_AdminDomain is de SOM over alle VBO's in de cel, dus delen door Counts/per_WP4_AdminDomain geeft het gemiddelde per woning; zonder die deling schaalt de prijs mee met het aantal woningen in de cel (aantal^lnsize) en kwam de voorraadwaarde 4,3x te hoog uit (gemeten 2026-08-21). Apart item omdat hij ook de guard is: cellen zonder voorraad (MakeDefined -> log(1) = 0) krijgen prijs 0.";

	attribute<Float32> Basisjaar (AdminDomain) := =
		replace(
			'LnSizeTerm > 0f'
			'	? exp('
					'@C@/Constant'
					'+ LnSizeTerm'                                                                       // BAG-woonoppervlakte van de bestaande voorraad
//					Woonpand (regiogemiddelde kenmerken van de bestaande voorraad)
					'+ log(max_elem(MakeDefined(@RAT@/'+WP4_name+'_lotsize[float32], @NAT@/lotsize[WP4_id]), 1f)) * MakeDefined(@C@/lnlotsize, 0f)'  // #676: de vier regionale kenmerken ontbreken samen waar de NVM in die regio geen transacties van dit woningtype kent, en een null maakt via de som de hele prijs undefined. Terugval op het landelijk gemiddelde; de afkapping op 1 m2 houdt daarnaast log(0) uit de som.
					'+ MakeDefined(@RAT@/'+WP4_name+'_d_highrise[float32],  @NAT@/d_highrise[WP4_id])  * MakeDefined(@C@/d_highrise, 0f)'
					'+ MakeDefined(@RAT@/'+WP4_name+'_nrooms[float32],      @NAT@/nrooms[WP4_id])      * @C@/nrooms'
					'+ MakeDefined(@RAT@/'+WP4_name+'_d_maintgood[float32], @NAT@/d_maintgood[WP4_id]) * @C@/d_maintgood'
					'+ 1f                                                 * @C@/Y'+ModelParameters/NVM_coeff_Year+
//					Locatie
					'+ value(@LOC@/UAI_2012_network,float32)              * @C@/uai_2012'
					'+ log(value(@LOC@/tt_500kinhab_min,float32))         * @C@/lntt_500k_2024'
					'+ log(value(@LOC@/tt_OVknooppunten_min,float32))     * @C@/lntt_ovknoop'
//					Groen/water, basisjaar-bevroren (RSopen #566/#481)
					'+ value(@LOC@/fr_natuur_tot2500m,float32)            * MakeDefined(@C@/fr_natuur_tot2500m, 0f)'
					'+ value(@LOC@/fr_water_500m,float32)                 * MakeDefined(@C@/fr_water_500m, 0f)'
				')[Eur_Woning]'
			'	: 0[Eur_Woning]'

			,'@C@',   '/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+WP4_name+'/Result'
			,'@RAT@', '/BaseData/Suitabilities/Wonen/RegionalAvgCharacteristics/perWP4/RegionalAvgCharacteristics'
			,'@NAT@', '/BaseData/Suitabilities/Wonen/RegionalAvgCharacteristics/perWP4/NationalAvgCharacteristics'
			,'@LOC@', '/SourceData/Diversen/Per_AdminDomain'
		), Descr = "De totale hedonische woningprijs van de bestaande voorraad in het basisjaar, voor cellen met voorraad van dit WP4.";
}
