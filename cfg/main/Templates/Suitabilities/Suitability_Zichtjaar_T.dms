// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de geschiktheid in de zichtjaren voor alle sectoren/subsectoren Bepaal de geschiktheid voor wonen per
// subsector in de zichtjaren, op basis van de geschiktheid per OP De geschiktheid voor wonen per OP
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Suitability_Zichtjaar_T
: Descr = "Bepaal de geschiktheid in de zichtjaren voor alle sectoren/subsectoren"
{
	parameter<String>    name;
	parameter<YearRange> zichtjaar_value;
	//
	
	unit<UInt8> OP := ='ThisVariantClassifications/Vastgoed/OP';

	container Wonen := 
		for_each_ne(
			Vastgoed/WP2xVSSH/name
			, 'Suitability_Wonen_perSubsector_T('+quote(Vastgoed/WP2xVSSH/name)+')'
		), Descr = "Bepaal de geschiktheid voor wonen per subsector in de zichtjaren, op basis van de geschiktheid per OP"
	{
		container perOP := 
			for_each_nedv(
				OP/name
				, 'Wonen/'+OP/WP2xVSSH_name+'/perOP/'+OP/name+'/Totaal'
				, CompactedAdminDomain
				, float32
			), Descr = "De geschiktheid voor wonen per OP";
	}
	
	container Werken :=
		for_each_nedv(
			Actor/Jobs6/name
			, 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, BaseData/Suitabilities/Werken/ProbabilityMap_perSector/'+Actor/Jobs6/name+'/exponentiated)'
			, CompactedAdminDomain
			, float32
		), Descr = "Geschiktheid voor werken per sector";
	
	container Verblijfsrecreatie
	{
		attribute<Float32> Totaal (CompactedAdminDomain):= collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, BaseData/Suitabilities/Verblijfsrecreatie/ProbabilityMap_Verblijfsrecreatie/Variant_Dist_1000m_Neighbourhood/exponentiated), Descr = "Geschiktheid voor verblijfsrecreatie in compacted alloc dommain. Obv probability map uit studie VU.";
	}
	
	container Waterberging
	: Descr = "Geschiktheid voor waterberging: de variant-onafhankelijke criteria uit BaseData/Suitabilities/Waterberging worden hier per variant gewogen tot een totaal."
	{
		attribute<Float32> Depth_Norm        (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/Depth_Norm),        Descr = "Genormaliseerde waterdiepte in compacted domain.";
		attribute<Float32> InvUAI_Norm       (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/InvUAI_Norm),       Descr = "Inverse urban attractivity index in compacted domain.";
		attribute<Float32> IsMeer_Nabij_Norm (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsMeer_Nabij_Norm), Descr = "Genormaliseerde nabijheid van bestaande meren in compacted domain.";
		attribute<Float32> IsVeen_Nabij_Norm (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsVeen_Nabij_Norm), Descr = "Genormaliseerde nabijheid van veengebieden in compacted domain.";
		attribute<Float32> Kwel_Norm         (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/Kwel_Norm),         Descr = "Genormaliseerde kwel in compacted domain; telt positief mee.";
		attribute<Float32> Wegzijging_Norm   (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/Wegzijging_Norm),   Descr = "Genormaliseerde wegzijging in compacted domain; telt negatief mee.";
		attribute<Bool>    IsDiepGenoeg      (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg),      Descr = "Voldoet de waterschijf aan ModelParameters/Waterberging/Minimum_Waterschijf?";

		attribute<Float32> Totaal (CompactedAdminDomain) :=
			IsDiepGenoeg
			?	    Depth_Norm        * /VariantParameters/VariantK/Weight_Depth_Waterberging     [Variant_rel]
				  + InvUAI_Norm       * /VariantParameters/VariantK/Weight_UAI_Waterberging       [Variant_rel]
				  + IsMeer_Nabij_Norm * /VariantParameters/VariantK/Weight_Lake_Waterberging      [Variant_rel]
				  + IsVeen_Nabij_Norm * /VariantParameters/VariantK/Weight_Peat_Waterberging      [Variant_rel]
				  + Kwel_Norm         * /VariantParameters/VariantK/Weight_Kwel_Waterberging      [Variant_rel]
				  - Wegzijging_Norm   * /VariantParameters/VariantK/Weight_Wegzijging_Waterberging[Variant_rel]
			:	0f
		, Descr = "Geschiktheid voor waterberging in compacted admindomain. Gewichten per variant (VariantK/Weight_*_Waterberging); wegzijging telt negatief; locaties met een waterschijf kleiner dan ModelParameters/Waterberging/Minimum_Waterschijf krijgen geschiktheid 0.";
	}
	
	container Wind
	{
		attribute<Float32> Totaal (CompactedAdminDomain):= collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wind/Result), Descr = "Geschiktheid voor wind op basis van beleving landschap. Inverse, dus hoe lager de beleving hoe hoger de geschiktheid.";
	}
	
	container Zon
	{
		attribute<Float32> Totaal (CompactedAdminDomain):= collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Zon/Result), Descr = "Geschiktheid voor zon op basis van beleving landschap. Inverse, dus hoe lager de beleving hoe hoger de geschiktheid.";
	}
	
	container Landbouw := ='Templates/Landbouw/Suitability_T('+quote(name)+', /VariantParameters/VariantK/Waterbeheeroptie[Variant_rel])', Descr = "Bepaal de geschiktheid voor landbouw in de zichtjaren";
}