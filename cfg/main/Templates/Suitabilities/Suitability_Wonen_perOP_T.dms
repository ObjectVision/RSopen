////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de geschiktheid voor wonen per OP in de zichtjaren Potentiele opbrengsten van een pakket Woningen De
// geschatte grondproductiekosten op die locatie
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Suitability_Wonen_perOP_T
: Descr = "Bepaal de geschiktheid voor wonen per OP in de zichtjaren"
{
	parameter<String> OP_name;
	//
	
	attribute<Float32> Marktwaarde (CompactedAdminDomain) := ='src/Wonen/Opbrengsten_perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De marktwaarde van een pakket Woningen op deze cel, dus de prijs die de koper betaalt. Gemaskeerd met beschikbaarheid, net als de kostenposten, zodat niet-beschikbare cellen saldo 0 hebben i.p.v. de bruto opbrengst (#597).";

	attribute<Float32> Opbrengsten (CompactedAdminDomain) := Marktwaarde * /ModelParameters/Wonen/Exploitatieposten/OpbrengstFactor
	, Descr = "Wat de ontwikkelaar van die marktwaarde overhoudt, en dus de opbrengstterm van de exploitatie. Tot #672 was dit de marktwaarde zelf, terwijl een nieuwbouwwoning vrij op naam wordt verkocht en de ontwikkelaar de btw over die prijs afdraagt.

			De correctie zit hier en niet in Woningwaarde, want daar is de marktwaarde de gevraagde grootheid: de indicator Woningwaarde/Nieuwbouw hoort de waarde van het vastgoed te tellen en niet de netto-opbrengst van de bouwer. Het scheelt bovendien dat de 53 Opbrengsten_perOP-tifs per opbrengstenset niet opnieuw hoeven te worden gemaakt.

			Zie /ModelParameters/Wonen/Exploitatieposten voor de bron en de bandbreedte.";
	
	attribute<Eur> Grondproductiekosten (CompactedAdminDomain) :=
		='collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, src/Wonen/Grondproductiekosten/Results/Totaal/'+/ModelParameters/Wonen/grondproductie_kosten_Variant+') 
		* float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar) * AdminDomain/NrHaPerCell', Descr = "De geschatte grondproductiekosten op die locatie";
		
	attribute<Eur> Bouwkosten (CompactedAdminDomain) := ='src/Wonen/Bouwkosten/perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De geschatte bouwkosten van een pakket Woningen. Gemaskeerd met beschikbaarheid, consistent met de overige posten (#597).

			Dit is de BOUWSOM en niet het totaal van de bouwkosten: het kental is CBS 83673NED, gedefinieerd als de materiaal- en arbeidskosten van het bouwwerk, exclusief btw. Honoraria, leges, rente en onvoorzien zitten er niet in; die staan sinds #672 in BijkomendeKosten hieronder.";

	attribute<Eur> BijkomendeKosten (CompactedAdminDomain) := Bouwkosten * /ModelParameters/Wonen/Exploitatieposten/BijkomendeKostenOpslag
	, Descr = "Honoraria, advies en onderzoek, projectorganisatie, leges, kwaliteitsborging, rente tijdens de bouw, voorzieningen en onvoorzien (#672). Als opslag op de bouwsom, want zo meet de bron ze. Erft de maskering van Bouwkosten, dus niet-beschikbare cellen blijven op nul. Zie /ModelParameters/Wonen/Exploitatieposten.";

	attribute<Eur> WinstEnRisico (CompactedAdminDomain) := (Bouwkosten + BijkomendeKosten) * /ModelParameters/Wonen/Exploitatieposten/WinstEnRisicoFractie
	, Descr = "De winst- en risicovergoeding van de ontwikkelaar, over de vastgoedinvestering (#672). Niet te verwarren met de staartkosten van de aannemer, die al in de bouwsom zitten. Erft de maskering van Bouwkosten. Zie /ModelParameters/Wonen/Exploitatieposten voor waarom dit de zwakst onderbouwde van de drie parameters is.";

	attribute<Eur> Bodemdalingkosten (CompactedAdminDomain) := ='src/Wonen/Bodemdalingkosten/perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De meerkosten van bouwen op een bodemdalingsgevoelige ondergrond ten opzichte van de zandgrondreferentie, per ontwikkelpakket en per cel (#505). Staat op nul in varianten met VariantK/BodemdalingkostenInSaldo op FALSE; daar draagt de dummy AndersBouwen in de grondproductiekosten het bodemeffect, zoals voor #505.

			Alleen de aanlegkosten zitten hierin, want alleen die komen bij de ontwikkelaar terecht. Beheer en onderhoud, die in de levenscycluskosten van het rapport wel meelopen, vallen bij de gemeente en horen thuis in een maatschappelijke indicator en niet in dit saldo.";
	
	attribute<Eur> Piekbuibergingkosten (CompactedAdminDomain) := ='src/Wonen/Piekbuibergingkosten/perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar) * float32(/ModelParameters/Piekbuiberging/KostenInExploitatiesaldo)', Descr = "De aanlegkosten van de piekbuibergingsmaatregelen die bij dit pakket horen (#798): groene en blauwe daken, halfverharding, holle wegen, wadi's en doorlatend groen. Een nieuwe wijk legt die aan als onderdeel van de ontwikkeling, dus de rekening hoort in dit saldo en stuurt de allocatie. Berekend per pakket in Templates/VariantData_T/Geschiktheden/Piekbuibergingkosten.dms, op dezelfde oppervlakken en met dezelfde variantfracties als de bergingsindicator.

			Gemaskeerd met beschikbaarheid, net als de andere posten (#597). Staat op nul als ModelParameters/Piekbuiberging/KostenInExploitatiesaldo op FALSE staat.

			Alleen aanleg. Het onderhoud valt bij de beheerder en niet bij de ontwikkelaar, en staat als indicator naast de bergingsindicator; dezelfde afweging als bij Bodemdalingkosten hierboven en bij BeheerEnOnderhoud in Templates/Indicatoren/KostenWoningbouw.dms. Deze post draagt ook de opslagen BijkomendeKosten en WinstEnRisico niet, want die zijn gedefinieerd op de bouwsom van de woningen en dit is terreininrichting.";
	
	container Verwervingskosten : Descr = "de kosten van het opkopen van het huidige opstal."
	{
		attribute<Eur> Woningen0 (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Verwervingskosten/Woningen/Totaal) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		
		container Funderingsschade
		{
			attribute<Eur> Src                (CompactedAdminDomain) := /SourceData/Vastgoed/Funderingsschade/per_pand/k; // per woning afgekapt op P99 met herverdeling binnen de buurt (#408); de oude per-pand-cap op P95 is vervallen
			
			// De schade valt in JaarWaarinFunderingschadeZichtbaar en wordt van daaruit contant gemaakt naar het basisjaar (#651).
			// Sinds #651 loopt dat via het gedeelde sjabloon, zodat hier en in de indicator dezelfde voeten en dezelfde
			// termijnstructuur gelden. Zolang dat jaar gelijk is aan Model_StartYear is de horizon nul en de factor 1.
			container Verdiscontering := Templates/Verdiscontering_Horizon_T(float32((VariantParameters/VariantK/JaarWaarinFunderingschadeZichtbaar[Variant_rel] - ModelParameters/Model_StartYear) / 1[YearRange])[jaar]);
			
			attribute<Eur> Herstelkosten      (CompactedAdminDomain) := = VariantParameters/VariantK/FunderingschadeWordtHersteld[Variant_rel]  // We gaan ervanuit dat deze geincasseerd worden, ongeacht evt sloop in een zichtjaar
																				? 'Src * Verdiscontering/Factor'
																				: 'const(0[Eur], CompactedAdminDomain)';

			attribute<Eur> Waardevermindering (CompactedAdminDomain) :=	= VariantParameters/VariantK/FunderingschadeWordtHersteld[Variant_rel] // We gaan ervan uit dat deze niet groter kan zijn dan de bestaande woningwaarde
																				? 'const(0[Eur], CompactedAdminDomain)'
					 															: 'min_elem(Src, Woningen0) * Verdiscontering/Factor';
		}

		attribute<Eur> Woningen      (CompactedAdminDomain) := max_elem(Woningen0 - Funderingsschade/Waardevermindering, 0[Eur]);
		attribute<Eur> Niet_Woningen (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Verwervingskosten/Niet_Woningen/Totaal) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		attribute<Eur> Grond         (CompactedAdminDomain) := = /ModelParameters/Wonen/Grondwaarde/GrondwaardeInSaldo
			? ('(Woningen0 > 0[Eur] ? 0[Eur] : /ModelParameters/Wonen/Grondwaarde/PerKlasse[collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/StartState/Bodemstatistiek/gg_CBS)] * AdminDomain/NrHaPerCell) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)')
			: 'const(0[Eur], CompactedAdminDomain)'
		, Descr = "De verwervingskosten van de grond zelf (#787). Tot september 2026 ontbrak deze post en was onbebouwde grond dus gratis, terwijl woningen hun grond wel betaalden via de WOZ. De voorwaarde op Woningen0 voorkomt dat de grond onder een woning twee keer wordt gerekend.

						De maskering met IsBeschikbaar_zichtjaar is er in #672 bijgekomen. Zonder haar was dit de enige post in het saldo die ook op een niet-beschikbare cel een bedrag droeg, zodat elke niet-beschikbare cel een saldo kreeg van precies min de grondwaarde en dus negatief werd. Op de allocatie had dat geen invloed, want Beschikbaar_voorOP toetst daarnaast op Beschikbaar_src, maar op elke meting wel: een telling op de zeefpoort Impl/ExploitatieSaldo telde dan de sectorbeschikbaarheid mee als saldo-uitval. Zo kwam de meting in #792 op 78 procent uitval uit. Zie #597 voor de afspraak dat alle posten op dezelfde manier worden gemaskeerd.

						Zie ModelParameters/Wonen/Grondwaarde voor de prijzen, de bronnen en wat je van deze post mag verwachten. Kort: hij haalt de zwakste marge weg en verzet de rangorde nauwelijks, want de sprong van gebruikswaarde naar residuele waarde is een factor tien tot twintig.";

		attribute<Eur> Totaal        (CompactedAdminDomain) := Woningen + Niet_Woningen + Grond;
	}
	
	container Sloopkosten : Descr = "de kosten van het slopen van het huidige opstal."
	{
		attribute<Eur> Woningen      (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Sloopkosten/Totaal)      * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		attribute<Eur> Niet_Woningen (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Sloopkosten/Totaal_Niet_Woningen) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		attribute<Eur> Totaal        (CompactedAdminDomain) := Woningen + Niet_Woningen;
	}
	
	container ControleBodemdaling
	: Descr = "Verzet de bodemdalingspost de locatiekeuze, of valt hij weg tegen de spreiding in het saldo? Dat is de kernvraag van #505, en hij is te beantwoorden zonder een tweede allocatie te draaien.

				De post gaat lineair het saldo in, dus het saldo zonder die post is exact het saldo plus de post. Beide standen komen dus uit een enkele doorrekening, en het verschil is niet benaderd maar exact.

				De allocator kiest de hoogste saldi, dus wat telt is niet de hoogte van de post maar of hij de rangorde verandert. Deze container neemt van beide standen de bovenste K cellen, met K als aandeel van de kandidaten, en meet hoeveel daarvan dezelfde zijn. Een overlap van 100 procent betekent dat de post niets verzet; hoe lager, hoe meer locaties er anders uitpakken.

				Alleen voor diagnose; niets in de keten hangt eraan. Vraag hem voor een pakket op waarvan het saldo ergens positief is, anders is de bovenste K leeg."
	{
		attribute<Eur> Saldo_met    (CompactedAdminDomain) := ExploitatieSaldo, Descr = "Zoals het model rekent.";
		attribute<Eur> Saldo_zonder (CompactedAdminDomain) := ExploitatieSaldo + Bodemdalingkosten, Descr = "Het tegenfeitelijke saldo zonder de bodemdalingspost. Optellen mag omdat de post er als losse aftrekpost in gaat en met dezelfde beschikbaarheid is gemaskeerd.";

		parameter<Eur> Drempel_met_2pct    := rth_element(Saldo_met,    0.98f);
		parameter<Eur> Drempel_zonder_2pct := rth_element(Saldo_zonder, 0.98f);
		parameter<Eur> Drempel_met_5pct    := rth_element(Saldo_met,    0.95f);
		parameter<Eur> Drempel_zonder_5pct := rth_element(Saldo_zonder, 0.95f);

		parameter<UInt32> n_met_2pct   := sum(uint32(Saldo_met >= Drempel_met_2pct));
		parameter<UInt32> n_beide_2pct := sum(uint32(Saldo_met >= Drempel_met_2pct && Saldo_zonder >= Drempel_zonder_2pct));
		parameter<UInt32> n_met_5pct   := sum(uint32(Saldo_met >= Drempel_met_5pct));
		parameter<UInt32> n_beide_5pct := sum(uint32(Saldo_met >= Drempel_met_5pct && Saldo_zonder >= Drempel_zonder_5pct));

		parameter<String> Waarden :=
			  'Verzet de bodemdalingspost de locatiekeuze? Variant ' + Variant_name + ', pakket ' + OP_name + '\n'
			+ '  post mediaan over cellen met saldo, euro per cel ' + string(rth_element(Bodemdalingkosten, 0.5f)) + '\n'
			+ '  post p95                                        ' + string(rth_element(Bodemdalingkosten, 0.95f)) + '\n'
			+ '  spreiding saldo p95 min p50, euro per cel       ' + string(rth_element(Saldo_met, 0.95f) - rth_element(Saldo_met, 0.5f)) + '\n'
			+ '\n'
			+ '  bovenste 2 procent: ' + string(n_beide_2pct) + ' van ' + string(n_met_2pct) + ' cellen in beide standen, overlap ' + string(float32(n_beide_2pct) / float32(n_met_2pct)) + '\n'
			+ '  bovenste 5 procent: ' + string(n_beide_5pct) + ' van ' + string(n_met_5pct) + ' cellen in beide standen, overlap ' + string(float32(n_beide_5pct) / float32(n_met_5pct)) + '\n'
		,	StorageName = "='%LocalDataProjDir%/Diagnose/BodemdalingVerzetKeuze_'+Variant_name+'_'+OP_name+'.txt'"
		,	StorageType = "str";
	}

	attribute<Eur> ResidueleWaarde  (CompactedAdminDomain) := Opbrengsten - Bouwkosten - BijkomendeKosten - WinstEnRisico - Grondproductiekosten - Bodemdalingkosten - Piekbuibergingkosten
	, Descr = "De residuele grondwaarde: wat er van de opbrengst overblijft nadat alles is betaald wat tussen de aanneemsom en de verkoopprijs zit. Opbrengsten is netto van btw, en BijkomendeKosten en WinstEnRisico zijn de twee posten die #672 heeft toegevoegd. Tot september 2026 stonden die drie er niet in en was dit opbrengsten min bouwsom min grondproductie min bodemdaling, wat de grondquote boven de zestig procent hield.";
	attribute<Eur> ExploitatieSaldo (CompactedAdminDomain) := ResidueleWaarde - Verwervingskosten/Totaal - Sloopkosten/Totaal;
	attribute<Eur> Per_AdminDomain0 (CompactedAdminDomain) := ExploitatieSaldo;
	
	attribute<Bool> IsIjburg2_cel (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/RegioIndelingen/LMSSubzone/IsIJburg2_AdminDomain), Descr = "Cellen in de IJburg2-LMSSubzone, waar brondata voor het saldo ontbreekt (nieuw land).";

	parameter<Eur>     IJburg1_MediaanSaldo := rth_element(Per_AdminDomain0, 0.5f, collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/RegioIndelingen/LMSSubzone/Per_AdminDomain))[/SourceData/RegioIndelingen/LMSSubzone/IJburg1_proxy], Descr = "Mediaan saldo in IJburg1, de bebouwde buurzone met brondata, als proxy voor het saldo in IJburg2.";

	parameter<Float32> TieBreakEpsilon      := 0.01f, Descr = "Relatieve bandbreedte van de tie-break op de IJburg2-proxy: de trekking spreidt het saldo over plus en min een half procent rond de mediaan.";

	attribute<Float32> TieBreakFactor (CompactedAdminDomain) := 1f + TieBreakEpsilon * (rnd_uniform(0, CompactedAdminDomain, range(float32, 0f, 1f)) - 0.5f), Descr = "Vaste seed, dus deterministisch. Verwachtingswaarde exact 1, zodat de proxy zijn niveau houdt, en een spreiding die alleen de gelijkstand tussen de IJburg2-cellen breekt. Multiplicatief en niet additief, want Eur is float32: een additieve term van enkele euro's valt bij saldi boven een miljoen weg in de afronding.";

	attribute<Eur> TotaalIJburg (CompactedAdminDomain) :=
		IsIjburg2_cel
			? IJburg1_MediaanSaldo * TieBreakFactor
			: null_f[Eur], Descr = "IJburg is altijd een lastige: nieuw land waarvoor brondata ontbreekt. Vulwaarde expliciet beperkt tot de IJburg2-zone; elders blijft null gewoon null (#598). Voorheen vulde de deling-door-boolean-constructie via MakeDefined alle null-saldi in heel NL. De tie-break is een factor rond 1 en geen trekking tussen 0 en 1: die laatste halveerde de verwachtingswaarde van de proxy.";

	attribute<Eur> TotaalAdminDomain (CompactedAdminDomain) := MakeDefined(Per_AdminDomain0, TotaalIjburg), Descr = "Saldo, met alleen voor IJburg2 een proxy-vulling; overige cellen zonder saldo blijven undefined en doen niet mee in de allocatie (#598).";
	attribute<Eur> CalcTotaal        (CompactedAdminDomain) := TotaalAdminDomain;
	attribute<Eur> Totaal            (CompactedAdminDomain) := CalcTotaal;
}
