////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de geschiktheid voor wonen per OP in de zichtjaren Potentiele opbrengsten van een pakket Woningen De
// geschatte grondproductiekosten op die locatie
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Suitability_Wonen_perOP_T
: Descr = "Bepaal de geschiktheid voor wonen per OP in de zichtjaren"
{
	parameter<String> OP_name;
	//
	
	attribute<Float32> Marktwaarde (CompactedAdminDomain) := ='src/Wonen/Opbrengsten_perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De marktwaarde van een pakket Woningen op deze cel, dus de prijs die de koper betaalt. Gemaskeerd met beschikbaarheid, net als de kostenposten, zodat niet-beschikbare cellen saldo 0 hebben i.p.v. de bruto opbrengst (#597).";

	attribute<Float32> Opbrengsten (CompactedAdminDomain) := Marktwaarde * /ModelParameters/Wonen/Exploitatieposten/OpbrengstFactor
	, Descr = "Wat de ontwikkelaar van de marktwaarde overhoudt, en dus de opbrengstterm van de exploitatie: een nieuwbouwwoning wordt vrij op naam verkocht en de ontwikkelaar draagt de btw over die prijs
			af (#672). De correctie zit hier en niet in Woningwaarde, want daar is de marktwaarde de gevraagde grootheid: de indicator Woningwaarde/Nieuwbouw hoort de waarde van het vastgoed te tellen
			en niet de netto-opbrengst van de bouwer; het scheelt bovendien dat de Opbrengsten_perOP-tifs niet opnieuw hoeven te worden gemaakt. Zie ModelParameters/Wonen/Exploitatieposten voor de bron
			en de bandbreedte.";
	
	attribute<Eur> Grondproductiekosten (CompactedAdminDomain) :=
		='collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, src/Wonen/Grondproductiekosten/PerPakket/Totaal/'+OP_name+'/Totaal)
		* float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar) * AdminDomain/NrHaPerCell', Descr = "De geschatte grondproductiekosten op die locatie voor dit pakket: de locatieschatting van
			Grondproductiekosten/Results met de kaveldichtheid van het pakket in de twee componenten die daarop reageren (#847), zie src/Wonen/Grondproductiekosten/PerPakket. Gemaskeerd met beschikbaarheid, net als de andere posten (#597).";
		
	attribute<Eur> Bouwkosten (CompactedAdminDomain) := ='src/Wonen/Bouwkosten/perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De geschatte bouwkosten van een pakket Woningen, gemaskeerd met beschikbaarheid, consistent met de overige posten (#597). Dit is de bouwsom en niet het totaal van de bouwkosten: het kental is CBS 83673NED, de materiaal- en arbeidskosten van het bouwwerk exclusief btw; honoraria, leges, rente en onvoorzien staan in BijkomendeKosten hieronder (#672).";

	attribute<Eur> BijkomendeKosten (CompactedAdminDomain) := Bouwkosten * /ModelParameters/Wonen/Exploitatieposten/BijkomendeKostenOpslag
	, Descr = "Honoraria, advies en onderzoek, projectorganisatie, leges, kwaliteitsborging, rente tijdens de bouw, voorzieningen en onvoorzien (#672). Als opslag op de bouwsom, want zo meet de bron ze. Erft de maskering van Bouwkosten, dus niet-beschikbare cellen blijven op nul. Zie /ModelParameters/Wonen/Exploitatieposten.";

	attribute<Eur> WinstEnRisico (CompactedAdminDomain) := (Bouwkosten + BijkomendeKosten) * /ModelParameters/Wonen/Exploitatieposten/WinstEnRisicoFractie
	, Descr = "De winst- en risicovergoeding van de ontwikkelaar, over de vastgoedinvestering (#672). Niet te verwarren met de staartkosten van de aannemer, die al in de bouwsom zitten. Erft de maskering van Bouwkosten. Zie /ModelParameters/Wonen/Exploitatieposten voor waarom dit de zwakst onderbouwde van de drie parameters is.";

	attribute<Eur> Bodemdalingkosten (CompactedAdminDomain) := ='src/Wonen/Bodemdalingkosten/perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De meerkosten van bouwen op een bodemdalingsgevoelige ondergrond ten opzichte van de zandgrondreferentie, per ontwikkelpakket en per cel (#505). Nul in varianten met
			VariantK/BodemdalingkostenInSaldo op FALSE; daar draagt de dummy AndersBouwen in de grondproductiekosten het bodemeffect. Alleen de aanlegkosten, want alleen die komen bij de ontwikkelaar
			terecht; beheer en onderhoud vallen bij de gemeente en horen in een maatschappelijke indicator en niet in dit saldo.";
	
	attribute<Eur> Piekbuibergingkosten (CompactedAdminDomain) := ='src/Wonen/Piekbuibergingkosten/perOP/'+OP_name+' * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)', Descr = "De aanlegkosten van de piekbuibergingsmaatregelen die bij dit pakket horen (#798): groene en blauwe daken, halfverharding, holle wegen, wadi's en doorlatend groen. Een nieuwe wijk legt die
			aan als onderdeel van de ontwikkeling, dus de rekening hoort in dit saldo en stuurt de allocatie. Berekend per pakket in Templates/VariantData_T/Geschiktheden/Piekbuibergingkosten.dms, op
			dezelfde oppervlakken en met dezelfde variantfracties als de bergingsindicator. Gemaskeerd met beschikbaarheid, net als de andere posten (#597). Alleen aanleg: het onderhoud valt bij de beheerder en staat als indicator naast de bergingsindicator, dezelfde
			afweging als bij Bodemdalingkosten hierboven. Deze post draagt de opslagen BijkomendeKosten en WinstEnRisico niet, want die zijn gedefinieerd op de bouwsom van de woningen en dit is
			terreininrichting.";
	
	container Verwervingskosten : Descr = "De kosten van het opkopen van het huidige opstal, voor woningen en niet-woningen uitgesmeerd over de herontwikkeleenheid van de cel (#861); de grond alleen waar geen woningen staan."
	{
		attribute<Eur> Woningen0 (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/PerZichtjaar/'+name+'/Verwerving_Woningen/Result) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)'
		, Descr = "De verwervingskosten van de woningen van de herontwikkeleenheid van de cel, uitgesmeerd over de cellen van het kadastrale perceel (BaseData/Suitabilities/Wonen/Herontwikkeleenheid,
				#861), zodat een tuincel kost wat het huis kost: de hedonische waarde van de voorraad van het basisjaar met de sociale huur tegen haar beleidswaarde (#861), maal de vervangingsfactor
				van dit zichtjaar (#859), plus de opslagen naar het aandeel koopwoningen (#861), de bouwperiode (#861) en het energielabel (#860). De vervangingsfactor is een plus het aandeel dat voor het begin van de
				periode is vervangen maal de waardeverhouding van nieuw tegen oud min een, zie BaseData/Suitabilities/Wonen/Vervanging/PerZichtjaar; de labelopslag krimpt naar nul, zie
				BaseData/Suitabilities/Wonen/Energielabel. Gemaskeerd met beschikbaarheid, net als de andere posten (#597).";
		
		container Funderingsschade
		{
			attribute<Eur> Src                (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/Funderingsschade/Result)
			, Descr = "De funderingsschade, per woning afgekapt op P99 met herverdeling binnen de buurt (#408), uitgesmeerd over het perceel zoals Woningen0 (#861), zodat de begrenzing op de woningwaarde in
						Waardevermindering schade en waarde van hetzelfde perceel vergelijkt.";
			
			// De schade valt in JaarWaarinFunderingschadeZichtbaar en wordt van daaruit contant gemaakt naar het basisjaar (#651).
			// Sinds #651 loopt dat via het gedeelde sjabloon, zodat hier en in de indicator dezelfde voeten en dezelfde
			// termijnstructuur gelden. Zolang dat jaar gelijk is aan Model_StartYear is de horizon nul en de factor 1.
			container Verdiscontering := Templates/Verdiscontering_Horizon_T(float32((VariantParameters/VariantK/JaarWaarinFunderingschadeZichtbaar[Variant_rel] - ModelParameters/Model_StartYear) / 1[YearRange])[jaar]);
			
			attribute<Eur> Herstelkosten      (CompactedAdminDomain) := = VariantParameters/VariantK/FunderingschadeWordtHersteld[Variant_rel]  // We gaan ervanuit dat deze geincasseerd worden, ongeacht evt sloop in een zichtjaar
																				? 'Src * Verdiscontering/Factor'
																				: 'const(0[Eur], CompactedAdminDomain)';

			attribute<Eur> Waardevermindering (CompactedAdminDomain) :=	= VariantParameters/VariantK/FunderingschadeWordtHersteld[Variant_rel] // We gaan ervan uit dat deze niet groter kan zijn dan de bestaande woningwaarde
																				? 'const(0[Eur], CompactedAdminDomain)'
					 															: 'min_elem(Src, Woningen0) * Verdiscontering/Factor';
		}

		attribute<Eur> Woningen      (CompactedAdminDomain) := max_elem(Woningen0 - Funderingsschade/Waardevermindering, 0[Eur]);
		attribute<Eur> Niet_Woningen (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/Verwerving_NietWoningen/Result) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		attribute<Eur> Grond         (CompactedAdminDomain) := = /ModelParameters/Wonen/Grondwaarde/GrondwaardeInSaldo
			? ('(Woningen0 > 0[Eur] ? 0[Eur] : /ModelParameters/Wonen/Grondwaarde/PerKlasse[collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/StartState/Bodemstatistiek/gg_CBS)] * AdminDomain/NrHaPerCell) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)')
			: 'const(0[Eur], CompactedAdminDomain)'
		, Descr = "De verwervingskosten van de grond zelf (#787); zonder deze post is onbebouwde grond gratis terwijl woningen hun grond via de WOZ betalen. De voorwaarde op Woningen0 voorkomt dat de grond
						onder een woning twee keer wordt gerekend. Gemaskeerd met IsBeschikbaar_zichtjaar, net als alle andere posten (#597, #672): zonder dat masker droeg elke niet-beschikbare cel een saldo van
						precies min de grondwaarde, wat de allocatie niet raakte (Beschikbaar_voorOP toetst daarnaast op Beschikbaar_src) maar elke meting op de zeefpoort Impl/ExploitatieSaldo wel. Zie
						ModelParameters/Wonen/Grondwaarde voor de prijzen en de bronnen; de post haalt de zwakste marge weg en verzet de rangorde nauwelijks, want de sprong van gebruikswaarde naar residuele waarde
						is een factor tien tot twintig.";

		attribute<Eur> Totaal        (CompactedAdminDomain) := Woningen + Niet_Woningen + Grond;
	}
	
	container Sloopkosten : Descr = "De kosten van het slopen van het huidige opstal, uitgesmeerd over de herontwikkeleenheid van de cel (#861), zoals de verwervingskosten."
	{
		attribute<Eur> Woningen      (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/Sloop_Woningen/Result) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		attribute<Eur> Niet_Woningen (CompactedAdminDomain) := = 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/Sloop_NietWoningen/Result) * float32(PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar)';
		attribute<Eur> Totaal        (CompactedAdminDomain) := Woningen + Niet_Woningen;
	}
	
	attribute<Eur> ResidueleWaarde  (CompactedAdminDomain) := Opbrengsten - Bouwkosten - BijkomendeKosten - WinstEnRisico - Grondproductiekosten - Bodemdalingkosten - Piekbuibergingkosten
	, Descr = "De residuele grondwaarde: wat er van de opbrengst overblijft nadat alles is betaald wat tussen de aanneemsom en de verkoopprijs zit. Opbrengsten is netto van btw, en BijkomendeKosten en WinstEnRisico zijn de twee posten van #672; zonder die drie bleef de grondquote boven de zestig procent.";
	attribute<Eur> ExploitatieSaldo (CompactedAdminDomain) := ResidueleWaarde - Verwervingskosten/Totaal - Sloopkosten/Totaal;
	container PerPerceel
	: Descr = "Herontwikkeling per perceel (#861): op een kadastraal perceel met een pand krijgt elke beschikbare cel het saldo van het perceel als geheel, zodat de allocatie het perceel als
				geheel kiest en een huis niet voor een deel kan kopen of een flat per cel kan opknippen. Dat saldo is het gemiddelde saldo van de beschikbare cellen min de verwerving en de sloop van
				de cellen van het perceel die niet beschikbaar zijn, verdeeld over de beschikbare cellen: wie een deel van een perceel herontwikkelt, betaalt het hele perceel. Buiten zo'n perceel het
				saldo van de cel zelf."
	{
		unit<UInt32>       Perceel                       := /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/Perceel;
		attribute<Perceel> Eenheid_rel   (CompactedAdminDomain) := /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/Eenheid_rel_Compacted;
		attribute<Bool>    IsBeschikbaar (CompactedAdminDomain) := ='PotentieleState/'+name+'/per_SectorxSubsectoren/Wonen/'+Subsector_name+'/IsBeschikbaar_zichtjaar';
		attribute<Bool>    OpEenheid     (CompactedAdminDomain) := IsDefined(Eenheid_rel) && /BaseData/Suitabilities/Wonen/Herontwikkeleenheid/IsHerontwikkeleenheid[Eenheid_rel] && IsBeschikbaar && IsDefined(ExploitatieSaldo), Descr = "Beschikbare cel op een perceel met een pand.";
		attribute<Eur>     Opstal        (CompactedAdminDomain) := Verwervingskosten/Woningen + Verwervingskosten/Niet_Woningen + Sloopkosten/Totaal, Descr = "De verwerving en de sloop van het opstal op een beschikbare cel; op een perceel is dat op elke cel hetzelfde, want beide zijn over het perceel uitgesmeerd.";
		attribute<UInt32>  CellenBeschikbaar  (Perceel)         := sum_uint32(OpEenheid, Eenheid_rel), Descr = "Het aantal beschikbare cellen van het perceel.";
		attribute<Float32> RestPerBeschikbaar (Perceel)         := (float32(/BaseData/Suitabilities/Wonen/Herontwikkeleenheid/CellenPerEenheid) - float32(CellenBeschikbaar)) / float32(CellenBeschikbaar), Descr = "De cellen van het perceel die niet beschikbaar zijn, per beschikbare cel.";
		attribute<Eur>     SaldoPerceel  (Perceel)              := mean(OpEenheid ? ExploitatieSaldo : null_f[Eur], Eenheid_rel) - mean(OpEenheid ? Opstal : null_f[Eur], Eenheid_rel) * RestPerBeschikbaar, Descr = "Het saldo per beschikbare cel van het perceel als geheel.";
		attribute<Eur>     Result        (CompactedAdminDomain) := OpEenheid ? SaldoPerceel[Eenheid_rel] : ExploitatieSaldo;
	}
	
	attribute<Bool> IsIjburg2_cel (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/RegioIndelingen/LMSSubzone/IsIJburg2_AdminDomain), Descr = "Cellen in de IJburg2-LMSSubzone, waar brondata voor het saldo ontbreekt (nieuw land).";

	parameter<Eur>     IJburg1_MediaanSaldo := rth_element(PerPerceel/Result, 0.5f, collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /SourceData/RegioIndelingen/LMSSubzone/Per_AdminDomain))[/SourceData/RegioIndelingen/LMSSubzone/IJburg1_proxy], Descr = "Mediaan saldo in IJburg1, de bebouwde buurzone met brondata, als proxy voor het saldo in IJburg2.";

	parameter<Float32> TieBreakEpsilon      := 0.01f, Descr = "Relatieve bandbreedte van de tie-break op de IJburg2-proxy: de trekking spreidt het saldo over plus en min een half procent rond de mediaan.";

	attribute<Float32> TieBreakFactor (CompactedAdminDomain) := 1f + TieBreakEpsilon * (rnd_uniform(0, CompactedAdminDomain, range(float32, 0f, 1f)) - 0.5f), Descr = "Vaste seed, dus deterministisch. Verwachtingswaarde exact 1, zodat de proxy zijn niveau houdt, en een spreiding die alleen de gelijkstand tussen de IJburg2-cellen breekt. Multiplicatief en niet additief, want Eur is float32: een additieve term van enkele euro's valt bij saldi boven een miljoen weg in de afronding.";

	attribute<Eur> TotaalIJburg (CompactedAdminDomain) :=
		IsIjburg2_cel
			? IJburg1_MediaanSaldo * TieBreakFactor
			: null_f[Eur], Descr = "IJburg is altijd een lastige: nieuw land waarvoor brondata ontbreekt. Vulwaarde expliciet beperkt tot de IJburg2-zone; elders blijft null gewoon null (#598). Voorheen vulde de deling-door-boolean-constructie via MakeDefined alle null-saldi in heel NL. De tie-break is een factor rond 1 en geen trekking tussen 0 en 1: die laatste halveerde de verwachtingswaarde van de proxy.";

	attribute<Eur> Totaal (CompactedAdminDomain) := MakeDefined(PerPerceel/Result, TotaalIJburg), Descr = "Het saldo waarop de zeef en de allocatie kiezen, per perceel (#861), met alleen voor IJburg2 een proxy-vulling; overige cellen zonder saldo blijven undefined en doen niet mee in de allocatie (#598).";
}
