// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bepaal de woningwaarde per OP (i.e. nieuwbouw) De totale prijs van alle woningen in deze AdminDomain voor deze
// OP De prijs per woning in deze AdminDomain voor deze OP, met een minimum van de gemiddelde prijs per woning in
// Nederland voor deze WP4
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Woningwaarde_OP_T
: Descr = "Bepaal de woningwaarde per OP (i.e. nieuwbouw)"
{
	parameter<OP> OP_id;
	//
	
	unit<UInt8> OP       := ='ThisVariantClassifications/Vastgoed/OP';
	container   OP_Buurt := ='ThisVariantClassifications/Vastgoed/OP_Buurt';
		
	parameter<String>     WP2_name                        := OP/WP2_name[OP_id];
	parameter<String>     VSSH_name                       := OP/VSSH_name[OP_id];
	parameter<String>     WP4_name                        := OP/WP4_name[OP_id];
	
	attribute<Eur>        Prijs_OP          (AdminDomain) := OP/Dichtheid[OP_id] * Prijs_perWoning * AdminDomain/NrHaPerCell, Descr = "De totale prijs van alle woningen in deze AdminDomain voor deze OP";
	
	attribute<Eur_Woning> Prijs_perWoning   (AdminDomain) := ='Prijs_perWoning0 * ModelParameters/Wonen/WoningPrijsVerandering_'+ModelParameters/NVM_coeff_Year+'_naar_'+string(ModelParameters/Model_StartYear);
	attribute<Eur_Woning> Prijs_perWoning0  (AdminDomain) := MakeDefined(Prijs_perWoning00, mean(Prijs_perWoning00))[Eur_Woning], Descr = "De prijs per woning in deze AdminDomain voor deze OP; cellen zonder locatiedata krijgen de gemiddelde prijs per woning in Nederland voor deze OP (#595).";
	attribute<Float32>    Prijs_perWoning00 (AdminDomain) := =
		replace(
			'(exp('
				'@C@/Constant'
				
//				Woonpand
				'+ '+string(OP/IsHoogbouw[OP_id])+'[float32]                  * MakeDefined(@C@/d_highrise, 0f)' // kenmerk uit ontwikkelpakket
				'+ log('+string(OP/Woonoppervlakte_woning[OP_id])+'[float32]) * @C@/lnsize'                      // kenmerk uit ontwikkelpakket             SIZE == WOONOPP
				'+ log('+string(OP_Buurt/Perceeloppervlakte[OP_id])+'[float32])  * MakeDefined(@C@/lnlotsize, 0f)'  // kenmerk uit ontwikkelpakket. LOTSIZE == PERCEEL (uitgeefbaar per woning, incl. voetafdruk): de coefficient is geschat op perceel, niet op tuin (#628). Geen guard nodig: het perceel is minstens de voetafdruk, want FractieUitgeefbaar >= GSI wordt afgedwongen in Default_src.dms
				'+ '+string(OP/Aant_kamers[OP_id])+'[float32]                 * @C@/nrooms'                       // idem
				'+ 1f                                                         * @C@/d_maintgood'                 // wordt 100% voorondersteld bij nieuw te bouwen Woningen
				'+ 1f                                                         * @C@/Y'+ModelParameters/NVM_coeff_Year+ // in alle gevallen gaat het om nieuwbouw
				'+ 1f                                                         * @C@/d_constrgt2001'              // in alle gevallen gaat het om nieuwbouw
				
//				Locatie 
				'+ '+string(OP/Weging_Amenities[OP_id])+'[float32]         * value(@LOC@/UAI_2012_network,float32)              * @C@/uai_2012' //wegingsfactor amenities uit ontwikkelpakket maal de UAI (netwerk 2012, 0-100) van de locatie maal de coëfficiënt voor UAI
				'+ '+string(OP/Weging_NatNiv[OP_id])+'[float32]            * log(value(@LOC@/tt_500kinhab_min,float32))         * @C@/lntt_500k_2024' //wegingsfactor nationale niveaus uit ontwikkelpakket maal de reistijd naar 500k inwoners (2024) maal de coëfficiënt
				'+ '+string(OP/Weging_NatOV[OP_id])+'[float32]             * log(value(@LOC@/tt_OVknooppunten_min,float32))     * @C@/lntt_ovknoop' //wegingsfactor nationale OV uit ontwikkelpakket maal de reistijd naar het dichtstbijzijnde OV-knooppunt (2026) maal de coëfficiënt
//				Groen/water uit het statische LGN-basisjaarraster (RSopen #566/#481); geen OP-weging, dus ook geen diff-mean-correctie. MakeDefined: oudere estimates-sets zonder fr-termen geven dan 0-bijdrage i.p.v. null-prijzen. De prijs per OP blijft op het basisjaar staan; de allocatie corrigeert hem per zichtjaar voor de natuur en het water die er aan het begin van dat zichtjaar liggen (#637, zie Templates/Allocatie/Zichtjaar_T/GroenNabijheid). Zo blijven deze kaarten variantdata en hoeven ze niet per casus en per zichtjaar opnieuw gerekend te worden.
				'+ value(@LOC@/fr_natuur_tot2500m,float32)                 * MakeDefined(@C@/fr_natuur_tot2500m, 0f)'
				'+ value(@LOC@/fr_water_500m,float32)                      * MakeDefined(@C@/fr_water_500m, 0f)'

//				Diff mean (correctie weging aanpassing) 
				'- sum((value(@LOC@/UAI_2012_network,float32)              * @C@/uai_2012                   *('+string(OP/Weging_Amenities[OP_id])+'[float32]  - 1f)) * ThisVariant/Zeef/Basisjaar/Wonen/'+WP2_name+'_'+VSSH_name+'/IsBeschikbaar_AdminDomain[float32]) / sum(ThisVariant/Zeef/Basisjaar/Wonen/'+WP2_name+'_'+VSSH_name+'/IsBeschikbaar_AdminDomain[float32])'  //diff_mean_amenities
				'- sum((log(value(@LOC@/tt_500kinhab_min,float32))         * @C@/lntt_500k_2024             *('+string(OP/Weging_NatNiv[OP_id])+'[float32]     - 1f)) * ThisVariant/Zeef/Basisjaar/Wonen/'+WP2_name+'_'+VSSH_name+'/IsBeschikbaar_AdminDomain[float32]) / sum(ThisVariant/Zeef/Basisjaar/Wonen/'+WP2_name+'_'+VSSH_name+'/IsBeschikbaar_AdminDomain[float32])'  //diff_mean_natniv
				'- sum((log(value(@LOC@/tt_OVknooppunten_min,float32))     * @C@/lntt_ovknoop               *('+string(OP/Weging_NatOV[OP_id])+'[float32]      - 1f)) * ThisVariant/Zeef/Basisjaar/Wonen/'+WP2_name+'_'+VSSH_name+'/IsBeschikbaar_AdminDomain[float32]) / sum(ThisVariant/Zeef/Basisjaar/Wonen/'+WP2_name+'_'+VSSH_name+'/IsBeschikbaar_AdminDomain[float32])'  //diff_mean_natov
			'))'
			
			,'@C@',   '/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+WP4_name+'/Result'
			,'@RAT@', '/BaseData/Suitabilities/Wonen/RegionalAvgCharacteristics/perWP4/RegionalAvgCharacteristics'
			,'@LOC@', '/SourceData/Diversen/Per_AdminDomain'
		);
	
	attribute<Float32> Prijs_perWoning_zWeging  (AdminDomain) := ='Prijs_perWoning_zWeging0 * ModelParameters/Wonen/WoningPrijsVerandering_'+ModelParameters/NVM_coeff_Year+'_naar_'+string(ModelParameters/Model_StartYear);
	attribute<Float32> Prijs_perWoning_zWeging0 (AdminDomain) := =
		replace(
			'(exp('
				'@C@/Constant'
				
//				Woonpand
				'+ '+string(OP/IsHoogbouw[OP_id])+'[float32]                  * MakeDefined(@C@/d_highrise, 0f)' // kenmerk uit ontwikkelpakket
				'+ log('+string(OP/Woonoppervlakte_woning[OP_id])+'[float32]) * @C@/lnsize'     // kenmerk uit ontwikkelpakket
				'+ log('+string(OP_Buurt/Perceeloppervlakte[OP_id])+'[float32]) * MakeDefined(@C@/lnlotsize, 0f)'  // idem regel 41: perceel, niet tuin (#628)
				'+ '+string(OP/Aant_kamers[OP_id])+'[float32]                 * @C@/nrooms'     // idem voor aantal kamers etc.
				'+ 1f                                                         * @C@/d_maintgood' // wordt 100% voorondersteld bij nieuw te bouwen Woningen
				'+ 1f                                                         * @C@/Y'+ModelParameters/NVM_coeff_Year+ // in alle gevallen gaat het om nieuwbouw
				'+ 1f                                                         * @C@/d_constrgt2001' // in alle gevallen gaat het om nieuwbouw
				
//				Locatie 
				'+ value(@LOC@/UAI_2012_network,float32)                      * @C@/uai_2012'
				'+ log(value(@LOC@/tt_500kinhab_min,float32))                 * @C@/lntt_500k_2024'
				'+ log(value(@LOC@/tt_OVknooppunten_min,float32))             * @C@/lntt_ovknoop'
				'+ value(@LOC@/fr_natuur_tot2500m,float32)                    * MakeDefined(@C@/fr_natuur_tot2500m, 0f)'
				'+ value(@LOC@/fr_water_500m,float32)                         * MakeDefined(@C@/fr_water_500m, 0f)'

			'))'
			
			,'@C@',   '/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+WP4_name+'/Result'
			,'@RAT@', '/BaseData/Suitabilities/Wonen/RegionalAvgCharacteristics/perWP4/RegionalAvgCharacteristics'
			,'@LOC@', '/SourceData/Diversen/Per_AdminDomain'
		);
}