////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Generieke binomiale logistische regressie (logit), volledig in GeoDMS-expressies geschat via
// IRLS (iteratively reweighted least squares, ofwel Newton-Raphson op de loglikelihood).
// Per iteratie: p = 1/(1+exp(-X*beta)); W = diag(p*(1-p)); beta_nieuw = beta + inv(X'WX) * X'(y-p).
// De K bij K matrix X'WX wordt opgebouwd uit sum(...)-scalars per variabelenpaar (alleen de
// bovendriehoek wordt gesommeerd, de spiegelcellen verwijzen naar hetzelfde item), als grid over
// een spoint-domein gelegd en met matr_inv geinverteerd. Vijftien iteraties volstaan ruim:
// Newton convergeert kwadratisch en is in de praktijk na zes tot acht iteraties uitgeconvergeerd
// (zie ConvergentieStap in het Rapport als controle).
//
// Dezelfde modelvorm als de logit-schattingen achter de geschiktheidskaarten, zie Koomen,
// Claassens & Konig (2021), de schattingsrapportage achter de logitcoeff-bestanden in
// SourceData/Vastgoed. Hiermee zijn die schattingen binnen het model zelf te reproduceren of
// te herzien, op exact de data die de toepassing gebruikt.
//
// Beperking: het waarnemingsdomein is AdminDomain via naamresolutie (vanuit Templates werkt dat
// via using Geography), geen template-argument. Een unit<ipoint>-argument doorgeven kan wel, maar
// alle aanroepen werken op AdminDomain en de Data-container moet toch al op hetzelfde domein
// leveren; een argument zou hier alleen schijnflexibiliteit toevoegen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Logit_T
: Descr = "Binomiale logit via IRLS. Argumenten: Naam (voor het rapportbestand), Var (variabelenlijst met attribute name, waaronder een rij Constant) en Data (levert per Var/name een attribute over AdminDomain, plus y en InSample als bool). Resultaat: It15/beta en Eind/se per Var, met loglikelihood-verloop en McFadden pseudo-R2 in het Rapport."
{
	parameter<String> Naam;
	unit<uint8>       Var;
	container         Data;

	container X :=
		for_each_nedv(
			'x' + string(id(Var))
			, 'MakeDefined(float64(Data/' + Var/name + '), 0d)'
			, AdminDomain
			, float64
		), Descr = "De ontwerpmatrix als kolommen x0..x{K-1} in float64, op volgorde van Var. Nulls worden 0: buiten InSample telt de cel toch niet mee, en zo blijven de sommen gedefinieerd.";

	attribute<float64> msk (AdminDomain) := MakeDefined(Data/InSample, false) ? 1d : 0d, Descr = "Steekproefmasker als 0/1. Alle kruissommen en de loglikelihood worden hiermee vermenigvuldigd.";
	attribute<float64> y64 (AdminDomain) := msk * MakeDefined(Data/y ? 1d : 0d, 0d), Descr = "De afhankelijke variabele als 0/1 binnen de steekproef.";

	parameter<uint32>  K    := #Var, Descr = "Aantal te schatten coefficienten, inclusief de constante.";
	parameter<float64> N_   := sum(msk), Descr = "Aantal waarnemingen in de steekproef.";
	parameter<float64> pos_ := sum(y64), Descr = "Aantal positieven (y=1) in de steekproef.";
	parameter<float64> LL0  := pos_ * log(pos_ / N_) + (N_ - pos_) * log((N_ - pos_) / N_), Descr = "Loglikelihood van het intercept-only model, de referentie voor McFadden pseudo-R2.";

	parameter<Var> ConstIdx := rlookup('Constant', Var/name), Descr = "Positie van de constante in Var.";

	unit<spoint> MatrixDom := range(spoint, point_xy(0s, 0s), point_xy(int16(K), int16(K))), Descr = "K bij K griddomein voor X'WX en zijn inverse (matr_inv werkt op een attribute over zo'n domein).";

	unit<uint32> Cells := range(uint32, 0, K * K), Descr = "Alle K*K matrixcellen, met rij i0 en kolom j0. Omdat X'WX symmetrisch is verwijst elke cel naar het som-item van zijn bovendriehoek-spiegel (S_ref)."
	{
		attribute<uint32>    i0       := id(.) / K;
		attribute<uint32>    j0       := mod(id(.), K);
		attribute<String>    S_ref    := 'S_' + string(min_elem(i0, j0)) + '_' + string(max_elem(i0, j0));
		attribute<MatrixDom> cell_rel := point_xy(int16(i0), int16(j0))[MatrixDom];
		attribute<Var>       i_rel    := uint8(i0)[Var];
		attribute<Var>       j_rel    := uint8(j0)[Var];
	}

	unit<uint32> UCells := select_with_org_rel(Cells/i0 <= Cells/j0), Descr = "De bovendriehoek inclusief diagonaal: de K*(K+1)/2 kruissommen die echt gerekend worden, met itemnaam en expressie voor de for_each in Iter_T."
	{
		attribute<uint32> i0   := Cells/i0[org_rel];
		attribute<uint32> j0   := Cells/j0[org_rel];
		attribute<String> name := 'S_' + string(i0) + '_' + string(j0);
		attribute<String> expr := 'sum(w * X/x' + string(i0) + ' * X/x' + string(j0) + ')';
	}

	attribute<MatrixDom> diag_rel (Var) := point_xy(int16(id(Var)), int16(id(Var)))[MatrixDom], Descr = "Diagonaalcellen van de matrix, voor de standaardfouten.";

	container It0
	: Descr = "Startpunt: de constante op log(pos/(N-pos)), het intercept-only optimum, en de overige coefficienten op 0. Dit voorkomt overshoot in de eerste stap bij zeldzame positieven."
	{
		attribute<float64> beta (Var) := id(Var) == ConstIdx ? log(pos_ / (N_ - pos_)) : 0d;
	}

	Template Iter_T
	: Descr = "Een IRLS-iteratie: neemt de coefficienten-container van de vorige iteratie (prev) en levert beta = prev/beta + inv(X'WX) * X'(y-p). LL is de loglikelihood bij intrede, dus geevalueerd op prev/beta."
	{
		container prev;

		attribute<float64> eta (AdminDomain) := ='add(' + asItemList('prev/beta[' + string(id(Var)) + '[Var]] * X/x' + string(id(Var))) + ')', Descr = "Lineaire index X*beta.";
		attribute<float64> p   (AdminDomain) := eta > 0d ? 1d / (1d + exp(-eta)) : exp(eta) / (1d + exp(eta)), Descr = "Kans, numeriek veilig: er wordt altijd een niet-positief getal geexponentieerd.";
		attribute<float64> w   (AdminDomain) := msk * p * (1d - p), Descr = "IRLS-gewicht binnen de steekproef.";
		attribute<float64> r   (AdminDomain) := y64 - msk * p, Descr = "Werkresidu y - p binnen de steekproef.";

		parameter<float64> LL := sum(y64 * eta - msk * (max_elem(eta, 0d) + log(1d + exp(0d - abs(eta))))), Descr = "Loglikelihood op prev/beta, met de log1pexp-vorm zodat grote |eta| niet overloopt.";

		container S := for_each_nedv(UCells/name, UCells/expr, void, float64), Descr = "De kruissommen van X'WX (bovendriehoek).";
		container G := for_each_nedv('g' + string(id(Var)), 'sum(r * X/x' + string(id(Var)) + ')', void, float64), Descr = "De gradient X'(y-p) per coefficient.";

		attribute<float64> g_vec (Var)       := ='union_data(Var, ' + asItemList('G/g' + string(id(Var))) + ')';
		attribute<float64> XtWX  (MatrixDom) := ='union_data(MatrixDom, ' + asItemList('S/' + Cells/S_ref) + ')', Descr = "X'WX als K bij K grid, via de spiegelverwijzingen van Cells gevuld uit de bovendriehoek-sommen.";
		attribute<float64> Sinv  (MatrixDom) := matr_inv(XtWX), Descr = "Inverse van X'WX (LU-decompositie). Tevens de covariantiematrix van de schatter.";

		attribute<float64> Sinv_flat (Cells) := Sinv[Cells/cell_rel];
		attribute<float64> gflat     (Cells) := g_vec[Cells/j_rel];
		attribute<float64> delta     (Var)   := sum(Sinv_flat * gflat, Cells/i_rel), Descr = "Newton-stap inv(X'WX) * X'(y-p), als matrixproduct in celvorm gesommeerd per rij.";

		attribute<float64> beta (Var) := prev/beta + delta;
		attribute<float64> se   (Var) := sqrt(Sinv[diag_rel]), Descr = "Standaardfouten: wortel van de diagonaal van inv(X'WX). Gebruik die van Eind, geevalueerd op de eindcoefficienten.";
	}

	container It1  := Iter_T(It0);
	container It2  := Iter_T(It1);
	container It3  := Iter_T(It2);
	container It4  := Iter_T(It3);
	container It5  := Iter_T(It4);
	container It6  := Iter_T(It5);
	container It7  := Iter_T(It6);
	container It8  := Iter_T(It7);
	container It9  := Iter_T(It8);
	container It10 := Iter_T(It9);
	container It11 := Iter_T(It10);
	container It12 := Iter_T(It11);
	container It13 := Iter_T(It12);
	container It14 := Iter_T(It13);
	container It15 := Iter_T(It14);
	container Eind := Iter_T(It15), Descr = "Extra evaluatie op de eindcoefficienten: levert LL en de standaardfouten op It15/beta, plus de restestap (ConvergentieStap) als convergentiebewijs.";

	parameter<float64> LL_eind          := Eind/LL, Descr = "Loglikelihood op de eindcoefficienten.";
	parameter<float64> McFaddenR2       := 1d - LL_eind / LL0, Descr = "McFadden pseudo-R2 ten opzichte van het intercept-only model.";
	parameter<float64> ConvergentieStap := max(abs(Eind/delta)), Descr = "Grootste absolute Newton-stap na It15. Orde machineprecisie betekent uitgeconvergeerd; is dit niet zo, verleng dan de keten of inspecteer de data op separatie.";

	attribute<String> RegelPerVar (Var) := Var/name + ';' + string(It15/beta) + ';' + string(Eind/se);

	parameter<String> Rapport :=
		  'variabele;coefficient;standaardfout\n'
		+ AsList(RegelPerVar, '\n') + '\n'
		+ 'N;'                + string(N_)   + '\n'
		+ 'positieven;'       + string(pos_) + '\n'
		+ 'LL0_interceptonly;'+ string(LL0)  + '\n'
		+ 'LL_eind;'          + string(LL_eind) + '\n'
		+ 'McFaddenR2;'       + string(McFaddenR2) + '\n'
		+ 'ConvergentieStap;' + string(ConvergentieStap) + '\n'
		+ 'LL_verloop;'
		+ string(It1/LL)  + ';' + string(It2/LL)  + ';' + string(It3/LL)  + ';' + string(It4/LL)  + ';' + string(It5/LL)  + ';'
		+ string(It6/LL)  + ';' + string(It7/LL)  + ';' + string(It8/LL)  + ';' + string(It9/LL)  + ';' + string(It10/LL) + ';'
		+ string(It11/LL) + ';' + string(It12/LL) + ';' + string(It13/LL) + ';' + string(It14/LL) + ';' + string(It15/LL) + '\n'
		, StorageName = "='%LocalDataProjDir%/Diagnose/logit_' + Naam + '.txt'"
		, StorageType = "str"
		, Descr = "Leesbaar schattingsrapport: coefficienten met standaardfouten, steekproefomvang, loglikelihood-verloop en pseudo-R2. Wordt als txt weggeschreven naar de Diagnose-map.";
}
