// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Laadt via #include: WaarAllocatieHeeftPlaatsgevonden.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Aanbod
{
	#include<WaarAllocatieHeeftPlaatsgevonden.dms>
	
	container WaarGeenAllocatieHeeftPlaatsgevonden
	{
		attribute<Bool> AllocatieHeeftNietPlaatsgevonden (AdminDomain) := !IsDefined(Stand/Sector_rel);

		parameter<uint32>  Zichtjaar_jaar := uint32(right(Zichtjaar_name, 4)), Descr = "Het zichtjaar als getal, uit de naam Y2040.";
		parameter<float32> Tijdfactor     := OpbouwBestaandGebied
			? min_elem(1f, max_elem(0f, float32(Zichtjaar_jaar - uint32(/ModelParameters/Model_StartYear)) / float32(OpbouwEindjaar - uint32(/ModelParameters/Model_StartYear))))
			: 1f
		, Descr = "Opbouwfactor voor het aanbod in bestaand gebied, zie OpbouwBestaandGebied bij de parameters van deze indicator (#746). Staat die schakelaar uit, dan is de factor 1 en verandert er niets; sinds 3 september 2026 staat hij aan. Hij werkt alleen op deze tak; nieuwbouw heeft zijn eigen tijdpad, want die komt mee met de allocatie.";
		
		container OpDaken
		{
			parameter<float32> FractieGroenDak := /VariantParameters/VariantK/FractieGroenDakBestaandeBouwIn2050[Variant_rel] * Tijdfactor;
			parameter<float32> FractieBlauwDak := /VariantParameters/VariantK/FractieBlauwDakBestaandeBouwIn2050[Variant_rel] * Tijdfactor;
			parameter<float32> SomDakfracties := FractieGroenDak + FractieBlauwDak, IntegrityCheck = "this <= 1.001f", Descr = "Groen en blauw dak delen hetzelfde dakoppervlak, en Resultaat hieronder telt de twee bergingscapaciteiten bij elkaar op. Staan de twee fracties in VariantK samen boven een, dan bergt het model meer dak dan er ligt. Deze controle staat bij de lezer en niet bij de waarden, want een IntegrityCheck vuurt alleen waar het item ook wordt uitgerekend. De marge van 0,001 vangt de afronding van float32.";

			attribute<meter2> Dakoppervlak      (AdminDomain) := (Basisjaar/Stand/PandFootprint_Wonen + Basisjaar/Stand/PandFootprint_Werken) / float32(AllocatieHeeftNietPlaatsgevonden)
			, Descr = "Wonen plus Werken dekt samen de hele pandfootprint uit de BAG. De verblijfsrecreatiefootprint hoort er niet bij opgeteld te worden: die bestaat uit logies-panden, en logies valt in Classifications/Actor.dms onder de Jobs6-subsector Ov_consumentendiensten en zit daarmee al in PandFootprint_Werken. Optellen leverde dubbele daken op in cellen met logies. Sinds #364 telt de verblijfsrecreatiestand alleen nog logies binnen de CBS-verblijfsrecreatiegebieden, dus de dubbeltelling speelde daar het sterkst.";
			attribute<float32> FractiePlatWonen (AdminDomain) := MakeDefined(
				  (  MakeDefined(Basisjaar/Stand/PandFootprint_Wonen_Meergezins, 0[meter2]) * /ModelParameters/Piekbuiberging/Dakvorm/FractiePlatDak[Classifications/Vastgoed/WP2/V/meergezins]
				   + MakeDefined(Basisjaar/Stand/PandFootprint_Wonen_Eengezins,  0[meter2]) * /ModelParameters/Piekbuiberging/Dakvorm/FractiePlatDak[Classifications/Vastgoed/WP2/V/eengezins])
				/ (MakeDefined(Basisjaar/Stand/PandFootprint_Wonen_Meergezins, 0[meter2]) + MakeDefined(Basisjaar/Stand/PandFootprint_Wonen_Eengezins, 0[meter2]))
				, 0f)
			, Descr = "Het platte aandeel van de woonfootprint in de cel, uit de footprint per WP2 van de BAG en de proxy in ModelParameters/Piekbuiberging/Dakvorm (#746). Als verhouding en niet als eigen som, zodat het totale dak precies PandFootprint_Wonen uit de stand blijft; de IntegrityCheck op PandFootprint_Wonen_Meergezins bewaakt dat de live delen bij de tif horen. Een cel zonder woonfootprint krijgt nul en telt dan alleen het werkendak mee.";
			attribute<meter2> DakoppervlakPlat   (AdminDomain) := (Basisjaar/Stand/PandFootprint_Wonen * FractiePlatWonen + Basisjaar/Stand/PandFootprint_Werken * /ModelParameters/Piekbuiberging/Dakvorm/FractiePlatDakWerken) / float32(AllocatieHeeftNietPlaatsgevonden)
			, Descr = "Het platte deel van het dak: het meergezinsdeel van wonen plus de werkpanden, volgens de proxy in ModelParameters/Piekbuiberging/Dakvorm. Alleen hierop komt een blauw dak, en alleen hier bergt een groen dak.";
			attribute<meter2> DakoppervlakSchuin (AdminDomain) := Dakoppervlak - DakoppervlakPlat;
			attribute<meter2> DakoppervlakGroenPlat   (AdminDomain) := DakoppervlakPlat   * FractieGroenDak;
			attribute<meter2> DakoppervlakGroenSchuin (AdminDomain) := DakoppervlakSchuin * FractieGroenDak;
			attribute<meter2> DakoppervlakGroen       (AdminDomain) := DakoppervlakGroenPlat + DakoppervlakGroenSchuin, Descr = "Het aangelegde groene dak, plat en schuin samen. De groene fractie geldt voor het hele dak; het schuine deel wordt wel groen maar bergt niets, zie Resultaat.";
			attribute<meter2> DakoppervlakBlauw       (AdminDomain) := DakoppervlakPlat * FractieBlauwDak, Descr = "Het aangelegde blauwe dak, alleen op het platte deel: een blauw dak kan constructief niet op een schuin dak (team Stad van Deltares, #746). De blauwe fractie uit VariantK is daarmee een aandeel van de platte daken.";
			attribute<meter3> Resultaat               (AdminDomain) := add(
				  DakoppervlakGroenPlat   * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/GroenDak]
				, DakoppervlakGroenSchuin * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/GroenDakSchuin]
				, DakoppervlakBlauw       * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/BlauwDak]
			)
			, ExplicitSuppliers = "SomDakfracties"
			, Descr = "Berging op bestaande daken, groen plus blauw, sinds #746 met de dakvorm erin. Twee mechanismen, allebei naar de letter van het besluit van team Stad: het groene dak ligt op het hele dak en krijgt op het schuine deel het kental van de rij GroenDakSchuin in Classifications/WaterretentieK, en dat is nul; het blauwe dak ligt alleen op het platte deel. In m3 komt dat op hetzelfde neer, in m2 niet: DakoppervlakGroen telt ook het schuine groene dak, DakoppervlakBlauw alleen plat. De blauwe term stond tot #714 uitgecommentarieerd terwijl de groene fractie in de NbS-varianten al op nul stond; het dakenaanbod kwam daar dus op exact nul uit. Een dak is groen of blauw, niet allebei; SomDakfracties bewaakt dat.";
		}
		
		container OpOverigePlekken
		{
			container GrondgebruikSrc := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData; // @Bart: TODO: deze src naar basedata verplaatsen
			
			parameter<string> CalcString :=
				'GrondgebruikSrc/@Capaciteit_AdminDomain
				* /VariantParameters/VariantK/FractieWaterretentieCapaciteit@[Variant_rel]
				* Tijdfactor
				* Classifications/WaterretentieK/MetBenodigdeVelddata/Bergingscapaciteit[Classifications/WaterretentieK/MetBenodigdeVelddata/V/@] 
				/ float32(AllocatieHeeftNietPlaatsgevonden)';
			
			container PerWaterrententieK := for_each_nedv(Classifications/WaterretentieK/MetBenodigdeVelddata/name, replace(CalcString, '@', Classifications/WaterretentieK/MetBenodigdeVelddata/name), AdminDomain, meter3);
			
			attribute<meter3> Totaal (AdminDomain) := ='add('+AsItemList('PerWaterrententieK/'+Classifications/WaterretentieK/MetBenodigdeVelddata/name)+')';
		}
		
		attribute<meter3> Totaal (AdminDomain) := add(MakeDefined(OpDaken/Resultaat, 0[meter3]), MakeDefined(OpOverigePlekken/Totaal, 0[meter3]));
	}
	
	attribute<meter3> Totaal (AdminDomain) := add(MakeDefined(WaarAllocatieHeeftPlaatsgevonden/Totaal, 0[meter3]), MakeDefined(WaarGeenAllocatieHeeftPlaatsgevonden/Totaal, 0[meter3]));
}