// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De fractie van de terreinoppervlakte die uitgeefbaar wordt gemaakt
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container WaarAllocatieHeeftPlaatsgevonden
{
	container Wonen
	{
		attribute<Bool>    AllocatieHeeftPlaatsgevonden                    (AdminDomain) := Stand/sector_rel == Actor/Sector/V/Wonen;
		attribute<Bool>    IsBAGnieuwbouwWonen                             (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantAllocatie/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/IsBAGnieuwbouwWonen), FALSE), Descr = "BAG-nieuwbouw wonen-cel, onafhankelijk van OP_rel (issue #550: BAG-cellen hebben nu een gematchte OP_rel, dus IsNull(OP_rel) volstaat niet meer).";
		attribute<Bool>    BAGNieuwbouwAllocatieHeeftPlaatsgevonden        (AdminDomain) := AllocatieHeeftPlaatsgevonden && (IsNull(Stand/OP_rel) || IsBAGnieuwbouwWonen);
		attribute<meter2>  StandPandFootprintWaarAllocHeeftPlaatsgevonden  (AdminDomain) := ='min_elem(AdminDomain/NrHaPerCell[meter2], Stand/PandFootprint_Wonen / float32(AllocatieHeeftPlaatsgevonden)) / float32(AllocatieHeeftPlaatsgevonden)';
		
		parameter<float32> DefaultFractieUitgeefbaar := ModelParameters/Wonen/DefaultFractieUitgeefbaar, Descr = "De fractie van de terreinoppervlakte die uitgeefbaar wordt gemaakt";
		parameter<float32> DefaultFractieGrasInGroen := ModelParameters/Wonen/DefaultFractiesGrasBoomStruikInGroen/Gras;
		parameter<float32> FractieDoorlatendGroenSrc := VariantParameters/VariantK/FractieDoorlatendGroenNieuwbouw[Variant_rel];
		
		attribute<float32> FractieDoorlatendGroen (AdminDomain) := FractieDoorlatendGroenSrc * float32(/BaseData/Omgeving/NbSOPToepassingsgebied/Hoog_NL);
		
		parameter<float32> DefaultVerharding      := min_elem(ModelParameters/Wonen/DefaultVerharding * VariantParameters/VariantK/VerhardingTovDefault[Variant_rel], 1f); // waarom niet obv deze o.a. /VariantParameters/Ontwikkelpakketten/NettoBuurt/Default/InUitgeefbaarExPandFootprint/Verhard
		
		container OpDaken
		{
			parameter<float32> FractieGroenDak := /VariantParameters/VariantK/FractieGroenDakNieuwbouw[Variant_rel];
			parameter<float32> FractieBlauwDak := /VariantParameters/VariantK/FractieBlauwDakNieuwbouw[Variant_rel];
			
			attribute<meter2> Dakoppervlak      (AdminDomain) := StandPandFootprintWaarAllocHeeftPlaatsgevonden;
			attribute<meter2> DakoppervlakGroen (AdminDomain) := Dakoppervlak * FractieGroenDak;
			attribute<meter2> DakoppervlakBlauw (AdminDomain) := Dakoppervlak * FractieBlauwDak;
			attribute<meter3> Resultaat         (AdminDomain) := add(
				DakoppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/GroenDak],
				DakoppervlakBlauw * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/BlauwDak]
			);
		}
		
		container OpOverigVerhardUitgeefbaar
		{
			parameter<float32> FractieHalfverharding := /VariantParameters/VariantK/FractieHalfverhardingNieuwbouwUitgeefbaar[Variant_rel];
			
			attribute<meter2> VerhardOppervlak      (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
																		? (AdminDomain/NrHaPerCell[meter2] - StandPandFootprintWaarAllocHeeftPlaatsgevonden) * DefaultVerharding * DefaultFractieUitgeefbaar
																		: ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Uitgeefbaar/Buitenruimte/Verhard[Stand/OP_rel] * AdminDomain/NrHaPerCell[float32];
																		
			attribute<meter2> VerhardOppervlakGroen (AdminDomain) := VerhardOppervlak * FractieHalfverharding;
			attribute<meter3> Resultaat             (AdminDomain) := VerhardOppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Halfverharding];
		}
		
		container OpVerhardOpenbaar
		{
			parameter<float32> FractieHalfverharding := /VariantParameters/VariantK/FractieHalfverhardingNieuwbouwOpenbaar[Variant_rel];
			
			attribute<meter2> VerhardOppervlak (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
															? (AdminDomain/NrHaPerCell[meter2] - StandPandFootprintWaarAllocHeeftPlaatsgevonden) * DefaultVerharding * (1f - DefaultFractieUitgeefbaar) // Er zit dus geen water in BAG_nieuwbouw? Aanpassen.
															: ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Openbaar/Verhard[Stand/OP_rel] * AdminDomain/NrHaPerCell[float32];
															
			attribute<meter2> VerhardOppervlakGroen (AdminDomain) := VerhardOppervlak * FractieHalfverharding;
			attribute<meter3> Resultaat             (AdminDomain) := VerhardOppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Halfverharding];
		}
		
		container OpGrasUitgeefbaar
		{
			parameter<float32> FractieWadi := /VariantParameters/VariantK/FractieWadiNieuwbouwUitgeefbaarGras[Variant_rel];
			parameter<float32> FractieRest := 1f - FractieWadi;
			
			attribute<float32> FractieDoorlatendGroen (AdminDomain) := min_elem(const(FractieRest, AdminDomain), Wonen/FractieDoorlatendGroen);
			
			attribute<meter2> GrasOppervlak (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
															? DefaultFractieGrasInGroen * (AdminDomain/NrHaPerCell[meter2] - Verharding/Wonen/Verhard_NieuweOntwikkeling) * DefaultFractieUitgeefbaar
															: ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Uitgeefbaar/Buitenruimte/Groen/Gras[Stand/OP_rel] * AdminDomain/NrHaPerCell[float32];
			
			attribute<meter2> GrasOppervlakWadi            (AdminDomain) := GrasOppervlak * FractieWadi;
			attribute<meter2> GrasOppervlakDoorlatendGroen (AdminDomain) := GrasOppervlak * FractieDoorlatendGroen;
			
			attribute<meter3> ResultaatWadi            (AdminDomain) := GrasOppervlakWadi            * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Wadi];
			attribute<meter3> ResultaatDoorlatendGroen (AdminDomain) := GrasOppervlakDoorlatendGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/DoorlatendGroen];
			attribute<meter3> Resultaat                (AdminDomain) := ResultaatWadi + ResultaatDoorlatendGroen;
		}
		
		container OpGrasOpenbaar
		{
			parameter<float32> FractieWadi := /VariantParameters/VariantK/FractieWadiNieuwbouwOpenbaarGras[Variant_rel];
			parameter<float32> FractieRest := 1f - FractieWadi;
			
			attribute<float32> FractieDoorlatendGroen (AdminDomain) := min_elem(const(FractieRest, AdminDomain), Wonen/FractieDoorlatendGroen);
			
			attribute<meter2> GrasOppervlak (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
																		? DefaultFractieGrasInGroen * (AdminDomain/NrHaPerCell[meter2] - Verharding/Wonen/Verhard_NieuweOntwikkeling) * (1f - DefaultFractieUitgeefbaar)
																		: ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Openbaar/Groen/Gras[Stand/OP_rel] * AdminDomain/NrHaPerCell[float32];
			
			attribute<meter2> GrasOppervlakWadi            (AdminDomain) := GrasOppervlak * FractieWadi;
			attribute<meter2> GrasOppervlakDoorlatendGroen (AdminDomain) := GrasOppervlak * FractieDoorlatendGroen;
			
			attribute<meter3> ResultaatWadi            (AdminDomain) := GrasOppervlakWadi            * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Wadi];
			attribute<meter3> ResultaatDoorlatendGroen (AdminDomain) := GrasOppervlakDoorlatendGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/DoorlatendGroen];
			attribute<meter3> Resultaat                (AdminDomain) := ResultaatWadi + ResultaatDoorlatendGroen;
		}
		
		container OpOverigGroen
		{
			attribute<meter2> OverigGroenOppervlak (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
																		? (1f - DefaultFractieGrasInGroen) * (AdminDomain/NrHaPerCell[meter2] - Verharding/Wonen/Verhard_NieuweOntwikkeling)
																		: AdminDomain/NrHaPerCell[float32] * (
																			ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Totaal/Groen[Stand/OP_rel] -
																			ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Totaal/Groen/Gras[Stand/OP_rel]
																		);
			
			attribute<meter2> OverigGroenOppervlakDoorlatendGroen (AdminDomain) := OverigGroenOppervlak * FractieDoorlatendGroen;
			
			attribute<meter3> Resultaat (AdminDomain) := OverigGroenOppervlakDoorlatendGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/DoorlatendGroen];
		}
		
		container OpWater
		{
			parameter<float32> FractieBergingOpWater := /VariantParameters/VariantK/FractieBergingOpWaterNieuwbouw[Variant_rel];

			attribute<meter2> WaterOppervlak (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
																? 0[meter2]
																: AdminDomain/NrHaPerCell[float32] * ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Totaal/Water[Stand/OP_rel]
			, Descr = "Nieuw wateroppervlak volgens het ontwikkelpakket van de cel. Op BAG-nieuwbouw ligt geen ontwikkelpakket, dus daar staat nul; dat de standaardnieuwbouw geen water krijgt is een aanname die als vraag bij Deltares ligt, zie #741.

						De tak op BAGNieuwbouwAllocatieHeeftPlaatsgevonden is er sinds #741. De zes containers hiernaast hadden allemaal zo'n tak en deze niet, dus op een nieuwbouwcel zonder ontwikkelpakket gaf het opzoeken op Stand/OP_rel een null en op een BAG-nieuwbouwcel met een sinds #550 gematchte OP_rel kreeg het water wel het ontwikkelpakket terwijl de zes buurcontainers voor diezelfde cel de standaardaannames uit ModelParameters/Wonen gebruiken. Nu volgen alle zeven dezelfde tak. Gemeten op Y2120 in NbSGenuanceerd kost dat 12,9 mln m3 aan wateraanbod, waarvan het meeste buiten bestaand bebouwd gebied ligt.";
			attribute<meter2> WaterOppervlakBergingOpWater (AdminDomain) := WaterOppervlak * FractieBergingOpWater;

			attribute<meter3> Resultaat (AdminDomain) := WaterOppervlakBergingOpWater * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/BergingOpWater]
			, Descr = "Berging op nieuw oppervlaktewater via peilopzet, 0,50 m3 per m2 uit Classifications/WaterretentieK. In beide NbS-varianten staat de fractie op 1,00, in BAU en BAU2 op nul.

						Openstaand punt uit #741: de bronkaart achter de opgave neemt aan dat oppervlaktewater een onbeperkte bergingscapaciteit heeft en dat wateroverlast optreedt voordat het regenwater het oppervlaktewater bereikt. Dat is aan de kaart zelf te zien: cellen die binnen bebouwd gebied voor minstens 99 procent uit water bestaan staan gemiddeld op 2,4 mm. Op oppervlaktewater staat in deze kaart dus per constructie geen opgave, en extra berging daarop kan die opgave niet verkleinen; hij telt hier alleen mee doordat de blokoptelling die capaciteit bij buurcellen legt die wel opgave hebben. Daar staat tegenover dat dit water in het basisjaar nog niet lag, dus de kaart kent het niet. Welke van de twee zwaarder weegt is een vraag aan Deltares; zolang die openstaat blijft de term staan en is hij als nb_bergingopwater in de diagnose-uitdraai af te lezen. Gemeten op Y2120 in NbSGenuanceerd is dit met 92,3 mln m3 de grootste nieuwbouwmaatregel, waarvan 10,8 binnen bebouwd gebied.

						Bij het kental hoort een tweede kanttekening. 0,50 m3 per m2 is een halve meter peilstijging op het wateroppervlak, meer dan het kental van een wadi (0,30), terwijl een wadi een droge kom is die van nul begint en oppervlaktewater al op streefpeil staat en alleen de vrije ruimte tot maaiveld heeft. In een stedelijk peilvak is dat orde 0,10 tot 0,30 m. VariantParameters/VariantK zegt bij WaterbergingOpBestaandWater bovendien letterlijk dat het peil in bestaand oppervlaktewater 15 cm wordt opgezet, met de toevoeging dat die schakelaar gelijk oploopt met FractieBergingOpWaterNieuwbouw. Twee knoppen die volgens de configuratie samen oplopen gebruiken dus 0,15 en 0,50 m.";
		}

		attribute<meter3> Totaal (AdminDomain) := AllocatieHeeftPlaatsgevonden
			? add(
				  MakeDefined(OpDaken/Resultaat,                   0[meter3])
				, MakeDefined(OpOverigVerhardUitgeefbaar/Resultaat, 0[meter3])
				, MakeDefined(OpVerhardOpenbaar/Resultaat,          0[meter3])
				, MakeDefined(OpGrasUitgeefbaar/Resultaat,          0[meter3])
				, MakeDefined(OpGrasOpenbaar/Resultaat,             0[meter3])
				, MakeDefined(OpOverigGroen/Resultaat,              0[meter3])
				, MakeDefined(OpWater/Resultaat,                    0[meter3])
			  )
			: 0[meter3] / 0f
		, Descr = "De zeven bergingsmaatregelen op een nieuwbouwcel. Buiten de nieuwbouwcellen blijft dit item expliciet null, zodat de MakeDefined in de Totaal een laag hoger zijn werk doet en dit item ook als diagnose leesbaar blijft.

					Hier stond van 7 januari 2026 (d861e57f) tot #741 een kale optelling met een schrijffout erin: OpGrasUitgeefbaar/Resultaat droeg een slash aan het eind. GeoDMS leest `a/ + b` als `a / (+b)`, dus de twee grastermen werden niet opgeteld maar op elkaar gedeeld, en wat in de som terechtkwam was hun verhouding. De wadi's en het doorlatend groen op zowel uitgeefbaar als openbaar gras zaten dus niet in het wonen-aanbod. Bewezen in een losse dms: `A/Resultaat/ + B/Resultaat + C/Resultaat` geeft met a=10, b=1, c=100 de waarde 110 en niet 111.

					Gemeten op Y2120 in NbSGenuanceerd, standen van 1 september 2026: het wonen-aanbod gaat van 121,086 naar 140,159 mln m3. Bij werken en verblijfsrecreatie speelde het niet; daar staat dezelfde optelling zonder de slash.

					De deling had een tweede gevolg. Waar OpGrasOpenbaar/Resultaat nul is deelde hij door nul, en die null propageerde door de kale som heen, waarna de MakeDefined een laag hoger er stil nul van maakte: 11.257 van 1.296.044 wonencellen leverden zo helemaal niets, ook niet hun daken en halfverharding. Daarom telt elke term nu met MakeDefined voor zichzelf. Een ontbrekende term betekent dan alleen dat die maatregel daar nul oplevert, wat op elk van de zeven de bedoelde uitleg is. De diagnose-uitdraai telt de cellen met een ontbrekende term als nb_cellen_termnull, zodat een toename opvalt; op deze stand is dat er nul.";
	}
	
	container Werken             := WerkenEnVerblijfsrecreatie('Werken');
	container Verblijfsrecreatie := WerkenEnVerblijfsrecreatie('Verblijfsrecreatie');
	
	attribute<meter3> Totaal (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector
												? 'add(MakeDefined(Wonen/Totaal, 0[meter3]), MakeDefined(Werken/Totaal, 0[meter3]), MakeDefined(Verblijfsrecreatie/Totaal, 0[meter3]))'
												: 'add(MakeDefined(Wonen/Totaal, 0[meter3]), MakeDefined(Werken/Totaal, 0[meter3]))'; 
	
	Template WerkenEnVerblijfsrecreatie
	{
		//
		parameter<string> Sector_ref;
		//
		
		attribute<Bool>    AllocatieHeeftPlaatsgevonden                    (AdminDomain) := = 'Stand/Sector_rel == /Classifications/Actor/Sector/V/'+Sector_ref;
		parameter<float32> DefaultFractieUitgeefbaar                                     := = 'ModelParameters/'+Sector_ref+'/DefaultFractieUitgeefbaar', Descr = "De fractie van de terreinoppervlakte die uitgeefbaar wordt gemaakt";
		parameter<float32> FractieGrasInGroen                                            := = 'VariantParameters/FractiesGroenIn'+Sector_ref+'/DezeVariant/FractieGrasInGroen';
		
		attribute<meter2>  StandPandFootprintWaarAllocHeeftPlaatsgevonden  (AdminDomain) := ='min_elem(AdminDomain/NrHaPerCell[meter2], Stand/PandFootprint_'+Sector_ref+' / float32(AllocatieHeeftPlaatsgevonden)) / float32(AllocatieHeeftPlaatsgevonden)';
		
		container OpDaken
		{
			parameter<float32> FractieGroenDak := /VariantParameters/VariantK/FractieGroenDakNieuwbouw[Variant_rel];
			
			attribute<meter2> Dakoppervlak      (AdminDomain) := StandPandFootprintWaarAllocHeeftPlaatsgevonden;
			attribute<meter2> DakoppervlakGroen (AdminDomain) := Dakoppervlak * FractieGroenDak;
			attribute<meter3> Resultaat         (AdminDomain) := DakoppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/GroenDak];
		}
		
		container OpOverigVerhardUitgeefbaar
		{
			parameter<float32> FractieHalfverharding := /VariantParameters/VariantK/FractieHalfverhardingNieuwbouwUitgeefbaar[Variant_rel];
			
			attribute<meter2> VerhardOppervlak      (AdminDomain) := = '(AdminDomain/NrHaPerCell[meter2] - StandPandFootprintWaarAllocHeeftPlaatsgevonden) * VariantParameters/FractiesGroenIn'+Sector_ref+'/DezeVariant/Verhard * DefaultFractieUitgeefbaar';
			attribute<meter2> VerhardOppervlakGroen (AdminDomain) := VerhardOppervlak * FractieHalfverharding;
			attribute<meter3> Resultaat             (AdminDomain) := VerhardOppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Halfverharding];
		}
		
		container OpVerhardOpenbaar
		{
			parameter<float32> FractieHalfverharding := /VariantParameters/VariantK/FractieHalfverhardingNieuwbouwOpenbaar[Variant_rel];
			
			attribute<meter2> VerhardOppervlak      (AdminDomain) := = '(AdminDomain/NrHaPerCell[meter2] - StandPandFootprintWaarAllocHeeftPlaatsgevonden) * VariantParameters/FractiesGroenIn'+Sector_ref+'/DezeVariant/Verhard * (1f - DefaultFractieUitgeefbaar)';
			attribute<meter2> VerhardOppervlakGroen (AdminDomain) := VerhardOppervlak * FractieHalfverharding;
			attribute<meter3> Resultaat             (AdminDomain) := VerhardOppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Halfverharding];
		}
		
		container OpGrasUitgeefbaar
		{
			parameter<float32> FractieWadi := /VariantParameters/VariantK/FractieWadiNieuwbouwUitgeefbaarGras[Variant_rel];
			
			attribute<meter2> GrasOppervlak     (AdminDomain) := = 'FractieGrasInGroen * (AdminDomain/NrHaPerCell[meter2] - Verharding/'+Sector_ref+'/Verhard) * DefaultFractieUitgeefbaar';
			attribute<meter2> GrasOppervlakWadi (AdminDomain) := GrasOppervlak * FractieWadi;
			attribute<meter3> Resultaat         (AdminDomain) := GrasOppervlakWadi * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Wadi];
		}
		
		container OpGrasOpenbaar
		{
			parameter<float32> FractieWadi := /VariantParameters/VariantK/FractieWadiNieuwbouwOpenbaarGras[Variant_rel];
			
			attribute<meter2> GrasOppervlak     (AdminDomain) := = 'FractieGrasInGroen * (AdminDomain/NrHaPerCell[meter2] - Verharding/'+Sector_ref+'/Verhard) * (1f - DefaultFractieUitgeefbaar)';
			attribute<meter2> GrasOppervlakWadi (AdminDomain) := GrasOppervlak * FractieWadi;
			attribute<meter3> Resultaat         (AdminDomain) := GrasOppervlakWadi * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/Wadi];
		}
		
		attribute<meter3> Totaal (AdminDomain) := OpDaken/Resultaat + OpOverigVerhardUitgeefbaar/Resultaat + OpVerhardOpenbaar/Resultaat + OpGrasUitgeefbaar/Resultaat + OpGrasOpenbaar/Resultaat;
	}
}