// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Indicator of een cel tot een groenklasse behoort. Indicator of een cel binnen de afgebakende studie- of
// regiogrens ligt. Aantal woningen per cel.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template BereikbaarheidGroenBBG_T : using = "Classifications/Actor"
{
	container SrcSrc;
	//
	parameter<String> GroenBron := 'BBG';
	container Src := .;
	attribute<GroenK>    Groen                (AdminDomain) := SrcSrc/Landgebruikskaart/GroenInZichtjaar; // Groen obv CBS BBG
	
	container PerRegios := for_each_ne(Regio/name, 'Templates/Indicatoren/BereikbaarheidGroen_Per_Regio_T('+quote(Regio/name)+', Regio/per_AdminDomain == '+string(id(Regio))+'[Regio], Woningen, Src)')
	{
		container Nationaal := Templates/Indicatoren/BereikbaarheidGroen_Per_Regio_T('Nationaal', const(true, AdminDomain), Woningen, Src);
	}
	
	Template Per_Afstand_T 
	{
		parameter<Bereikbaarheid/AfstandGroen> id;
		attribute<bool>                        IsRegio    (AdminDomain);
		attribute<Woning>                      Woningen (AdminDomain);
		container                              Src;
		//
		
		container AggrGroenKlassen := 
			for_each_ne(
				GroenK/name
				, 'Per_GroenK_T(
					'+quote(GroenK/name)+'
					, Groen == GroenK/V/'+GroenK/name+'
					, id
					, IsRegio
					, Woningen
					, Src
				)'
			)
		{
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "=AsList(GroenK/name+'/Indicatoren/Generate', ';')+';Totaal/Indicatoren/Generate;TotaalExAgrarisch/Indicatoren/Generate;Fractie/Indicatoren/Generate'";
			
			container InDezeStudie := TotaalExAgrarisch;
			container Totaal            := Per_GroenK_T('Totaal', IsDefined(Groen), id, IsRegio, Woningen, Src);
			container TotaalExAgrarisch := Per_GroenK_T('TotaalExAgrarisch', IsDefined(Src/Groen) && !(Src/Groen == GroenK/V/overige_agrarisch_gebruik), id, IsRegio, Woningen, Src);
			container Fractie           := Per_GroenK_T('Fractie', const(TRUE, AdminDomain), id, IsRegio, Woningen, Src)
			, Descr = "De fractiebenadering uit #717, naast de klassebenadering en niet in plaats daarvan. De meegegeven groenklasse is hier bewust altijd waar: deze tak leest de klasse niet, hij leest de groenfractie van de cel. Daarmee vervallen ook de twee selectiecriteria, vijf woningen per hectare en een hectare aaneengesloten, want die horen bij bereikbaar parkgroen. De straal blijft 300 meter en de druktegecorrigeerde varianten komen automatisch mee, want die zitten in dezelfde indicatorenlijst.";

		}
	}
	
	Template Per_GroenK_T 
	{ 
		parameter<string>                      GroenK_name;
		attribute<bool>                        IsGroenKlasse                 (AdminDomain) : Descr = "Indicator of een cel tot een groenklasse behoort.";
		parameter<Bereikbaarheid/AfstandGroen> AfstandGroen_id;
		attribute<bool>                        IsRegio                       (AdminDomain) : Descr = "Indicator of een cel binnen de afgebakende studie- of regiogrens ligt.";
		attribute<Woning>                      Woningen                      (AdminDomain) : Descr = "Aantal woningen per cel.";
		container                              Src;
		//
		
		parameter<meter>                       Bovengrens                                  := Bereikbaarheid/AfstandGroen/Bovengrens[AfstandGroen_id], Descr = "Bovengrens afstandsklasse, i.e. tot hoever kijken we?";
		attribute<Woning>                      WoningenInThisStRegio         (AdminDomain) := Woningen * IsRegio[float32], Descr = "Aantal woningen per cel, geclipt op de geselecteerde regio.";
		attribute<Woning>                      WoningenInThisStRegio_ge1     (AdminDomain) := WoningenInThisStRegio > 0f ? max_elem(WoningenInThisStRegio, 1f) : null_f, Descr = "Aantal woningen per cel, geclipt op de geselecteerde regio.";
		attribute<bool>                        Extent0                       (AdminDomain) := Woningen0 <= MaxWoningenInGroen * AdminDomain/NrHaPerCell && IsGroenKlasse && IsRegio, Descr = "Selectie van groencellen binnen de regio die voldoen aan de maximale woningdichtheid.";
		
		unit<uint32> ExtentDistrict := district_8(uint32(Extent0))
		, Descr = "Identificatie van aaneengesloten groengebieden op basis van 8-connectiviteit."
		{
			attribute<ha> Oppervlakte := pcount(Districts)[float32] * AdminDomain/NrHaPerCell, Descr = "Oppervlakte van elk aaneengesloten groengebied (in hectare).";
			attribute<ha> Oppervlakte_gr (AdminDomain) := Oppervlakte[Districts], Descr = "Oppervlakte van elk aaneengesloten groengebied (in hectare).";
		}
		
		attribute<bool>                        Extent                        (AdminDomain) := Extent0 && ExtentDistrict/Oppervlakte[ExtentDistrict/Districts] >= MinimumAaneengeslotenOppervlakte, Descr = "Groencellen die deel uitmaken van een aaneengesloten groengebied met een minimale oppervlakte.";
		attribute<float32>                     GroenFractieCel               (AdminDomain) := min_elem(MakeDefined(WaardeNabijheidGroen/Fracties/NatuurCel, 0f) + MakeDefined(WaardeNabijheidGroen/Fracties/WaterCel, 0f), 1f) * float32(IsRegio)
		, Descr = "Het groene deel van de cel zelf, natuur plus water, volgens dezelfde definitie die de waardering en de sterfte gebruiken. Komt uit Groenfracties_T, dus met dezelfde volgorde: een fysiek ingericht ontwikkelpakket bepaalt de celwaarde via zijn eigen groen, daarna de landgebruiksmutatie, en anders de LGN-fractie van het basisjaar. Daarmee is een cel buiten een ontwikkelpakket niet leeg maar draagt hij zijn bestaande groen.

				De begrenzing op een is nodig omdat natuur en water twee losse fracties zijn die elkaar op een cel kunnen overlappen. Alleen gelezen door de Fractie-tak van RelevantGroen (#717).";

		attribute<meter2>                      RelevantGroen                 (AdminDomain) := = GroenK_name == 'Fractie'
			? 'GroenFractieCel * AdminDomain/NrMeter2PerCell'
			: 'float32(IsGroenKlasse) * float32(Extent) * AdminDomain/NrMeter2PerCell'
		, Descr = "Oppervlakte groen per cel, op twee onverenigbare manieren geteld, en dat is precies wat #717 beschrijft.

				De klassetak telt een cel helemaal mee of helemaal niet, op basis van de landgebruiksklasse, en alleen wanneer de cel de aaneengeslotenheidstoets en de woningdichtheidstoets haalt. Dat meet bereikbaar parkgroen.

				De fractietak telt het groene deel van elke cel, zonder die twee toetsen, want die horen bij parkgroen en niet bij groen in de woonomgeving. Dat is de tak waarin het groen binnen een ontwikkelpakket zichtbaar is; in de klassetak is dat per constructie onzichtbaar, want een woonpakket draagt de klasse wonen hoe groen het pakket ook is. Deltares heeft in #717 bevestigd dat de twee naast elkaar horen te bestaan en dat de keuze tussen beide later valt, op grond van de norm waaraan de score wordt getoetst.";
		
		attribute<Woning>                      Som_WoningenInOmgeving        (AdminDomain) := ='potential(WoningenInThisStRegio, geography/Distmatrices/Impl_25m/pot'+string(Bovengrens)+'m/potrange/Flat2)[Woning]', Descr = "Totale som van woningen binnen de gegeven afstand rond elke cel.";
		attribute<meter2>                      Som_GroenInOmgeving           (AdminDomain) := ='potential(RelevantGroen, geography/Distmatrices/Impl_25m/pot'+string(Bovengrens)+'m/potrange/Flat2)[meter2]', Descr = "Totale oppervlakte groen (m²) binnen de gegeven afstand rond elke cel.";
		attribute<meter2>                      Som_GroenInOmgeving_metWoning (AdminDomain) := Som_GroenInOmgeving * float32(WoningenInThisStRegio > 0[woning]), Descr = "Totale oppervlakte groen binnen de gegeven afstand, alleen voor cellen waar woningen aanwezig zijn.";
		
		attribute<m2_woning>                   GroenAanwezigPerWoning        (AdminDomain) := RelevantGroen / Som_WoningenInOmgeving, Descr = "Oppervlakte groen per woning aan de aanbodzijde, berekend als het aanwezige groen in een cel gedeeld door het aantal omliggende woningen.";
		attribute<m2_woning>                   Som_AanwezigGroenPerWoning    (AdminDomain) := ='potential(GroenAanwezigPerWoning, geography/Distmatrices/Impl_25m/pot'+string(Bovengrens)+'m/potrange/Flat2)[m2_woning]', Descr = "Som van per-woning groenbijdragen van alle groencellen binnen de gegeven afstand (drukte-gecorrigeerd groenaanbod).";
		
		container Indicatoren := for_each_ne(Indicator/name, 'Templates/Indicatoren/BereikbaarGroen_Indicatoren_T('+quote(Indicator/name)+','+quote(Indicator/IndicatorExpr)+','+quote(Indicator/ValuesUnit)+', ..)')
		{
			parameter<string> Generate := 'Ready', ExplicitSuppliers = "=AsList(Indicator/name+'/Indicator', ';')";
		}
	}
}
