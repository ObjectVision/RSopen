// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Stand, Parent, Prev_Stand, Group_Wonen_Start, Group_Werken_Start,
// Group_Verblijfsrecreatie_Start, Group_Wonen_Zichtjaar, Group_Werken_Zichtjaar.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Make_Landgebruikskaart_T : using = "Classifications/Actor;Classifications/Grondgebruik"
{
	//
	parameter<String>            Zichtjaar_name;
	container                    Stand;
	//
	
	container                    Parent              := .;
	container                    Prev_Stand          := =IsStartJaar ? 'Parent' : Prev_Zichtjaar_name+'/Stand';
	parameter<String>            Prev_Zichtjaar_name := rjoin(lowercase(Zichtjaar_name), lowercase(Time/Zichtjaar/name), Time/Zichtjaar/PrevName_triv);
	parameter<Bool>              IsStartJaar         := lowercase(Zichtjaar_name) == lowercase('Basisjaar');
	
	attribute<LU_ModelType>      gg_basis                      (AdminDomain) := /BaseData/StartState/Grondgebruik/Per_AdminDomain/gg_basis;
	attribute<CBSKlasse>         gg_CBS                        (AdminDomain) := /BaseData/StartState/Grondgebruik/Per_AdminDomain/gg_CBS;
	
	// attribute<Bool>              IsWonen_StartState              (AdminDomain) := Stand/Wonen/Aantal_Woningen_Totaal >= MinimumWoningAmount * AdminDomain/NrHaPerCell / 1[ha];
	// attribute<Bool>              IsWerken_StartState             (AdminDomain) := Stand/PandFootprint/Totaal >= MinimumPandFootprint * AdminDomain/NrHaPerCell / 1[ha];
	// attribute<Bool>              IsVerblijfsrecreatie_StartState (AdminDomain) := Stand/Verblijfsrecreatie/Totaal >= MinimumVerblijfsobjectAmount * AdminDomain/NrHaPerCell / 1[ha];
	// attribute<Bool>              IsWind_StartState               (AdminDomain) := Stand/Wind/Totaal > 0[MW];
	// attribute<Bool>              IsZon_StartState                (AdminDomain) := Stand/Zon/Totaal > 0[MW];
	
	attribute<Bool>              IsWonen_StartState              (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'Stand/Aantal_Woningen_Totaal >= ModelParameters/Advanced/MinimumWoningAmount * AdminDomain/NrHaPerCell / 1[ha]' : 'const(FALSE, AdminDomain)';
	attribute<Bool>              IsWerken_StartState             (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector ? 'Stand/PandFootprint_Werken >= ModelParameters/Advanced/MinimumPandFootprint * AdminDomain/NrHaPerCell / 1[ha]' : 'const(FALSE, AdminDomain)';
	attribute<Bool>              IsVerblijfsrecreatie_StartState (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'Stand/Objecten_Verblijfsrecreatie >= ModelParameters/Advanced/MinimumVerblijfsobjectAmount * AdminDomain/NrHaPerCell / 1[ha]' : 'const(FALSE, AdminDomain)';
	attribute<Bool>              IsWind_StartState               (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWindSector ? 'Stand/Vermogen_Wind > 0[MW]' : 'const(FALSE, AdminDomain)';
	attribute<Bool>              IsZon_StartState                (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasZonSector ? 'Stand/Vermogen_Zon > 0[MW]' : 'const(FALSE, AdminDomain)';
	
	attribute<LU_ModelType>      gg_prev                         (AdminDomain) := =IsStartJaar ? 'gg_basis' : Prev_Zichtjaar_name+'/Landgebruikskaart/Result';
	
	attribute<Bool>              IsWonen_Zichtjaar               (AdminDomain) := =asList('Stand/subSector_rel == ThisYear/impl/StandVar/Subsector/v/Wonen_'+Sector/xSubsectoren/Wonen/Subsector/Subsector_name,  '||');
	attribute<Bool>              IsWerken_Zichtjaar              (AdminDomain) := =asList('Stand/subSector_rel == ThisYear/impl/StandVar/Subsector/v/Werken_'+Sector/xSubsectoren/Werken/Subsector/Subsector_name,  '||');
	attribute<Bool>              IsVerblijfsrecreatie_Zichtjaar  (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'Stand/subSector_rel == ThisYear/impl/StandVar/Subsector/v/Verblijfsrecreatie_Totaal' : 'const(FALSE, AdminDomain)';
	
	attribute<Bool>              IsLU_NoData                   (AdminDomain) := IsNull(gg_prev);
	attribute<Bool>              IsLU_exogenous                (AdminDomain) := CBSKlasse/IsExogeen[gg_CBS];
	attribute<Bool>              IsLU_Water                    (AdminDomain) := gg_prev == LU_ModelType/v/water_Totaal;
	attribute<Bool>              IsLU_Wonen                    (AdminDomain) := gg_prev == LU_ModelType/V/wonen_Totaal;
	attribute<Bool>              IsLU_Werken                   (AdminDomain) := gg_prev == LU_ModelType/V/werken_Totaal;
	attribute<Bool>              IsLU_Verblijfsrecreatie       (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'gg_prev == LU_ModelType/V/Verblijfsrecreatie_Totaal' : 'const(FALSE, AdminDomain)';
	attribute<Bool>              IsLU_Landbouw                 (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasLandbouwSector ? 'LU_ModelType/Sector_rel[gg_prev] == Actor/Sector/V/Landbouw' : 'const(FALSE, AdminDomain)';
	
	attribute<LU_ModelType>      ExogeenOpleggen               (AdminDomain) := ='ThisVariantData/ExogeenOpleggen/Totaal';
	
	attribute<meter2>            Wonen_Filtered                (AdminDomain) := =IsStartJaar ? 'Group_Wonen_Start/IsNieuwGrouped ? Stand/PandFootprint_Wonen : null_f[meter2]' : 'Group_Wonen_Zichtjaar/IsNieuwGrouped ? AdminDomain/NrMeter2PerCell : null_f[meter2]';
	attribute<meter2>            Werken_Filtered               (AdminDomain) := =IsStartJaar ? 'Group_Werken_Start/IsNieuwGrouped ? Stand/PandFootprint_Werken : null_f[meter2]' : 'Group_Werken_Zichtjaar/IsNieuwGrouped ? AdminDomain/NrMeter2PerCell : null_f[meter2]';
	attribute<meter2>            Verblijfrecreatie_Filtered    (AdminDomain) := =IsStartJaar && ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector 
																					? 'Group_Verblijfsrecreatie_Start/IsNieuwGrouped ? Stand/PandFootprint_Werken : null_f[meter2]' 
																					: ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector
																						? 'Group_Verblijfsrecreatie_Zichtjaar/IsNieuwGrouped ? AdminDomain/NrMeter2PerCell : null_f[meter2]'
																						: 'const(null_f, AdminDomain,meter2)';
	
	attribute<LU_ModelType>      Allocatie                     (AdminDomain) := ThisYear/impl/StandVar/Subsector/LU_ModelType_rel[Stand/SubSector_rel];
	attribute<Typen>             Dominant_BebouwdeOmgeving     (AdminDomain) := IsLU_Wonen || IsLU_NoData ? null_b[Typen] : ArgMax_ifdefined(Wonen_Filtered, Werken_Filtered, Verblijfrecreatie_Filtered)[Typen];
	
	container Group_Wonen_Start                  := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Wonen','Wonen_Totaal', /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector, ModelParameters/Advanced/MinimumGroupSize, gg_basis, 'StartState');
	container Group_Werken_Start                 := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Werken','Werken_Totaal', /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector, ModelParameters/Advanced/MinimumGroupSize, gg_basis, 'StartState');
	container Group_Verblijfsrecreatie_Start     := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Verblijfsrecreatie','Verblijfsrecreatie_Totaal', /ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector, ModelParameters/Advanced/MinimumGroupSize, gg_basis, 'StartState');
	
	container Group_Wonen_Zichtjaar              := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Wonen','Wonen_Totaal', /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector, ModelParameters/Advanced/MinimumGroupSize, gg_prev, 'Zichtjaar');
	container Group_Werken_Zichtjaar             := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Werken','Werken_Totaal', /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector, ModelParameters/Advanced/MinimumGroupSize, gg_prev, 'Zichtjaar');
	container Group_Verblijfsrecreatie_Zichtjaar := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Verblijfsrecreatie','Verblijfsrecreatie_Totaal', /ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector, ModelParameters/Advanced/MinimumGroupSize, gg_prev, 'Zichtjaar');
	
	unit<UInt8> Typen : NrOfRows = 3
	{
		attribute<String> name : ['Wonen', 'Werken', 'Verblijfsrecreatie'];
		attribute<String> Label := name;
		
		container V := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}
	
	attribute<bool> SubResult_Wonen              (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector              ? 'Dominant_BebouwdeOmgeving == Typen/V/Wonen'              : 'const(false, AdminDomain)';
	attribute<bool> SubResult_Werken             (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector             ? 'Dominant_BebouwdeOmgeving == Typen/V/Werken'             : 'const(false, AdminDomain)';
	attribute<bool> SubResult_Verblijfsrecreatie (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'Dominant_BebouwdeOmgeving == Typen/V/Verblijfsrecreatie' : 'const(false, AdminDomain)';
	
	parameter<LU_ModelType> Wonen_LUT              := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'LU_ModelType/V/Wonen_Totaal' : 'null_b[LU_ModelType]';
	parameter<LU_ModelType> Werken_LUT             := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector ? 'LU_ModelType/V/Werken_Totaal' : 'null_b[LU_ModelType]';
	parameter<LU_ModelType> Verblijfsrecreatie_LUT := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'LU_ModelType/V/Verblijfsrecreatie_Totaal' : 'null_b[LU_ModelType]';
	
	attribute<LU_ModelType> Result (AdminDomain) := switch(
		 case(IsLU_NoData, gg_prev)
		,case(lowercase(Zichtjaar_name) != lowercase('Basisjaar') && IsDefined(ExogeenOpleggen), ExogeenOpleggen)
		,case(IsLU_Water, gg_prev)
		,case(IsLU_exogenous || IsLU_Wonen || IsLU_Verblijfsrecreatie, gg_prev)
		,case(SubResult_Wonen, Wonen_LUT)
		,case(SubResult_Werken, Werken_LUT)
		,case(SubResult_verblijfsrecreatie, Verblijfsrecreatie_LUT)
		,case(IsDefined(Allocatie), Allocatie)
		// ,case(IsLU_Landbouw && IsDefined(Allocatie), Allocatie)
		, gg_prev
	)
	, Descr = "De landgebruikskaart van dit zichtjaar. De volgorde van de cases is de voorrangsregel, en die luistert nauw.

				Geen data gaat voor: buiten de kaart blijft het buiten de kaart.

				Dan de exogene oplegging, want daar schrijft het model een ander landgebruik voor en wordt de bestaande stand
				geleegd. Die case stond tot 26 augustus 2026 achter de derde, en dat was fout. Wonen, water en
				verblijfsrecreatie schermden de cel dan af, dus een opgelegde wonencel bleef wonen op de kaart terwijl de
				stand leeg was. Gemeten in WLO_hoog_NbSGenuanceerd: in 2030 ging geen enkele van de 4.585.974 wonencellen
				ooit naar een andere klasse, terwijl 58.395 werkencellen bij precies dezelfde oplegging wel naar natuur
				gingen. Werken stond namelijk niet in die case. De regel dateert uit september 2024, toen de oplegging nog
				alleen waterbergingsreservoirs deed en de botsing met wonen een randgeval was.

				Dan pas de afscherming van bestaand wonen, water, verblijfsrecreatie en exogeen grondgebruik. Die is bedoeld
				om de allocatie en de dominantieregel niet over bestaand bebouwd gebied heen te laten schrijven, en die
				bedoeling blijft overeind: alleen de oplegging gaat er nu voor.

				Water staat sinds #665 als eigen case. De uitkomst is regel voor regel dezelfde als daarvoor, want beide
				takken leveren gg_prev; de splitsing is er om de enige case die over het oppervlak gaat en niet over de
				bebouwing apart leesbaar te maken. Wat die case doet: waar de vorige kaart water is, wint water van de
				dominantieregel en van de allocatie, ook als de stand op diezelfde cel woningen telt. Elke indicator die de
				kaart leest ziet dan water, elke indicator die de stand leest ziet wonen, en niemand meldt dat. Hoe vaak dat
				gebeurt telt Toets_WonenOpWater hieronder.

				Of water winnen ook het gewenste antwoord is bij het bebouwingstype wonen op water uit #614 is niet besloten.
				Er is inhoudelijk wat voor te zeggen, want het oppervlak is dan echt water en de woningen drijven erop, maar
				die keuze ligt bij PBL en Deltares en hier loopt niets erop vooruit. Let op dat deze case in het veengebied
				vandaag niet eens wordt bereikt: het open water van veenbouwsteen 9a en 9b komt pas in de kaart als
				VariantK/ExogeenWaterOpleggen aanstaat, en dan wint de exogene oplegging hierboven al.

				Daarna de allocatie, en als niets van dat alles geldt, de vorige kaart.";
	
	// Ook het basisjaar krijgt Casus_name in het pad. De basisjaarkaart is namelijk niet casusonafhankelijk: hij
	// loopt via Stand, en die hangt aan de variant. Zonder Casus_name schreven twee casussen over elkaars
	// basisjaarbestand heen, en las de tweede de kaart van de eerste terug zonder dat daar iets van te merken was.
	parameter<string> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Landgebruik/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
	
	attribute<LU_ModelType> Write_Result_SA               (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? Result : null_b, StorageName = "=StorageStr", StorageType = "gdalwrite.grid";
	attribute<LU_ModelType> Read_Result_SA                (AdminDomain) : StorageName = "=PropValue(Write_Result_SA, 'StorageName')", StorageType = "gdal.grid";
	attribute<LU_ModelType> Result_SA                     (AdminDomain) := =ModelParameters/LandUseMapOntkoppeld ? 'Read_Result_SA' : 'Write_Result_SA';
	
	parameter<string> Result_SA_prev_str := 'Result_SA != PrevIndicatoren/Landgebruikskaart/Result_SA';
	
	attribute<LU_ModelType> Result_bij_tov_PrevYear (AdminDomain) := =IsStartJaar ? 'const(null_b,AdminDomain)' : Result_SA_prev_str +' ? Result_SA : null_b';
	attribute<LU_ModelType> Result_af_tov_PrevYear  (AdminDomain) := =IsStartJaar ? 'const(null_b,AdminDomain)' : Result_SA_prev_str +' ? PrevIndicatoren/Landgebruikskaart/Result_SA : null_b';
	
	attribute<Bool> IsLandbouwInAllocEnNietInResultLU (AdminDomain) := =asList('(Allocatie == LU_ModelType/v/Landbouw_'+/Classifications/Actor/LandbouwKlasses/name+' && Result_SA != LU_ModelType/v/Landbouw_'+/Classifications/Actor/LandbouwKlasses/name+')', '||');
	
	attribute<CBSKlasse/Aggr/Groen> GroenInBasisjaar (AdminDomain) := invert(/Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/org_rel)[CBSKlasse/Aggr_rel[gg_CBS]];
	attribute<CBSKlasse/Aggr/Groen> GroenInZichtjaar (AdminDomain) := (GroenInBasisjaar[uint8] / uint8(!IsDefined(Stand/Subsector_rel)))[CBSKlasse/Aggr/Groen];
	
	container Toets_WonenOpWater
	: Descr = "Telt de cellen waar de kaart water toont terwijl de switch hierboven zonder de water-case wonen zou hebben opgeleverd. Die toestand bestaat vandaag al en wordt nergens gemeld; met het bebouwingstype wonen op water uit #614 wordt zij de maat voor hoeveel drijvend wonen de kaart niet laat zien. Zie #665.

				Twee getallen, en het verschil ertussen is de bedoeling. Woningen_OpWater is de ruis: alle woningen die de stand op een cel zet die de kaart water noemt. Op 25 meter is dat normaal, een woonboot of een huis dat half over een sloot valt, en het zegt niets over de switch. Woningen_WaterWintVanWonen is het signaal: alleen de cellen waar de water-case daadwerkelijk een latere case overrulet.

				Dat tweede getal is met opzet uit de switch zelf afgeleid en niet uit de wonen-vlaggen van de stand. Een losse cel met een woning op water haalt de dominantiedrempel niet, komt dus nooit tot SubResult_Wonen, en zou ook zonder de water-case bij de default op gg_prev uitkomen.

				Bewust een teller en geen harde controle, want er lopen al twee legitieme routes naar deze toestand: cellen die in het basisjaar water zijn en toch woningen in de stand dragen, en cellen die de zeef met opzet vrijgeeft, zoals IJburg 2 dat nog gedeeltelijk water is. Wie later een case tussen de water-case en de allocatie zet moet ZouWonenZijnGeweest meebewegen, anders meet de teller stil iets anders."
	{
		attribute<Bool> IsWaterOpKaart (AdminDomain) := Result == LU_ModelType/V/Water_Totaal && Geography/rdc_meter/IsStudyArea_AdminDomain
		, Descr = "Wat de switch hierboven van dit jaar oplevert, met hetzelfde studiegebiedmasker dat Write_Result_SA gebruikt. Met opzet Result en niet Result_SA: die laatste valt bij ModelParameters/LandUseMapOntkoppeld terug op het weggeschreven bestand, en dan legt deze toets een verouderde kaart naast een verse stand en rapporteert een vintageverschil als mechanismefout.";
		
		attribute<Bool> IsOplegging (AdminDomain) := =IsStartJaar ? 'const(FALSE, AdminDomain)' : 'IsDefined(ExogeenOpleggen)'
		, Descr = "Dezelfde voorwaarde als de opleggingscase hierboven, die voor de water-case gaat. Als indirecte expressie geschreven zodat het in het basisjaar een constante zonder supplier is.";
		
		attribute<Bool> ZouWonenZijnGeweest (AdminDomain) :=
			!IsOplegging && !IsLU_exogenous &&
			(SubResult_Wonen || (!SubResult_Werken && !SubResult_Verblijfsrecreatie && Allocatie == Wonen_LUT))
		, Descr = "Wat de switch hierboven had opgeleverd als de water-case er niet stond: eerst de twee cases die er nog voor gaan uitsluiten, dan de dominantieregel voor wonen, en anders de allocatie voor zover die wonen aanwijst. IsLU_Wonen en IsLU_Verblijfsrecreatie hoeven niet te worden uitgesloten, want gg_prev kan niet tegelijk water en wonen zijn.";
		
		attribute<Bool> Cel (AdminDomain) := IsWaterOpKaart && ZouWonenZijnGeweest
		, Descr = "De cel waar de water-case wonen wegneemt. Is ZouWonenZijnGeweest waar en is de kaart toch water, dan kan dat alleen doordat de water-case vuurde.";
		
		attribute<Woning> Woningen (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'MakeDefined(Stand/Aantal_Woningen_Totaal, 0[Woning])' : 'const(0[Woning], AdminDomain)'
		, Descr = "Zelfde schakelaar als bij IsWonen_StartState hierboven: zonder de sector wonen bestaat Stand/Aantal_Woningen_Totaal niet en is de teller per definitie nul.";
		
		parameter<Woning> Woningen_OpWater := sum(Woningen * float32(IsWaterOpKaart))
		, Descr = "De ruis: alle woningen die de stand op een watercel zet, ook de losse, en ook waar de water-case niets beslist.";
		
		parameter<Woning> Woningen_WaterWintVanWonen := sum(Woningen * float32(Cel))
		, IntegrityCheck = "!/ModelParameters/Advanced/ToetsWonenOpWaterInKaart || This == 0[Woning]"
		, Descr = "Het getal waar het om gaat: woningen op cellen die de kaart als water toont terwijl de switch er zonder de water-case wonen had neergezet. Loopt dit op, dan verbergt de kaart een woonwijk.";
		
		parameter<Ha> Opp_WaterWintVanWonen := sum(float32(Cel) * AdminDomain/NrHaPerCell)
		, Descr = "Hetzelfde in hectares.";
	}
}
