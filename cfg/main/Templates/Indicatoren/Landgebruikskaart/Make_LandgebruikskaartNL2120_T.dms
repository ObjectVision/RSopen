////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Derde en vierde landgebruikskaart: de grondbalanskaart op LU_NL2120 en de kaartbeeldkaart op LU_Hoofdklasse. Zie #783.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Make_LandgebruikskaartNL2120_T : using = "Classifications/Actor;Classifications/Grondgebruik"
, Descr = "Leidt twee kaarten af uit de stand-administratie en de verharding van hetzelfde jaar (#783). Result is bedoeld voor een sluitende grondbalans: de sectoren zoals de allocatie en de BAG-stand
			ze neerzetten, elk in vijf verhardingsklassen, en daaronder het volledige LandgebruikType van #751, dus natuurbeheertype, landbouwtype of LGN-klasse. Result_Hoofdklasse is dezelfde kaart
			gelezen door de aggregatiekolom, met natuur op natuurtype, landbouw op hoofdgroep, en stedelijk groen, infrastructuur en overig als eigen groepen. De kaart bouwt zichzelf op uit de stand, de
			verharding en de voorrangsregel hieronder (#803); alle dominantielogica, de exogene oplegging en de groepsfilters staan zo op een plek. Kaart en stand zijn een en dezelfde bron, en de toets
			onderaan telt hoe vaak ze verschillen, om dezelfde reden als Toets_AllocatieZonderEigenCase in de gewone landgebruikskaart: een verschil hoort een geteld getal te zijn en geen aanname."
{
	//
	parameter<String> Zichtjaar_name;
	container         SrcStand;
	container         SrcVerharding;
	//

	parameter<Bool>   IsStartJaar         := lowercase(Zichtjaar_name) == lowercase('Basisjaar');
	// De kaart van het vorige zichtjaar komt via PrevIndicatoren van de omvattende Zichtjaar_T, en niet meer via
	// de naam van dat zichtjaar (#824): ontkoppeld is dat Ketens/Lees, dat Result en Write_Result_SA van het vorige
	// zichtjaar uit tifs leest; anders de levende container, en dan is het dezelfde kaart als voorheen. In het
	// basisjaar bestaat PrevIndicatoren niet, maar daar staat IsStartJaar voor elke verwijzing.


	attribute<LandgebruikType> Type       (AdminDomain) := SrcStand/Landgebruik_Type
	, Descr = "Het landgebruikstype uit de stand van dit jaar, de standvariabele van #751. Draagt de exogene oplegging al mee, dus een cel die deze variant natuur maakt heeft hier haar beheertype.";

	attribute<Float32>         Verharding (AdminDomain) := SrcVerharding/Result
	, Descr = "De verharde fractie van de cel in dit jaar, de basis van de onderverdeling van wonen en werken.";

	// -- de sectorkant --

	// -- de voorrangsregel, verhuisd uit de kaart op LU_ModelType (#803) --

	attribute<Bool> IsLU_exogenous (AdminDomain) := /BaseData/StartState/Bodemstatistiek/IsExogeen
	, Descr = "Grondgebruik dat de voorrangsregel met rust laat: infrastructuur en begraafplaatsen.";

	attribute<Bool> IsLU_NoData (AdminDomain) := =IsStartJaar
		? '!/Geography/rdc_meter/IsStudyArea_AdminDomain'
		: 'IsNull(PrevIndicatoren/LandgebruikskaartNL2120/Result)';
	attribute<Bool> IsLU_Water (AdminDomain) := =IsStartJaar
		? 'MakeDefined(LandgebruikType/IsWater[Type], FALSE)'
		: 'MakeDefined(LU_NL2120/IsWater[PrevIndicatoren/LandgebruikskaartNL2120/Result], FALSE)';
	attribute<Bool> IsLU_Wonen (AdminDomain) := MakeDefined(Sector_behoud == S_Wonen, FALSE);
	attribute<Bool> IsLU_Werken (AdminDomain) := MakeDefined(Sector_behoud == S_Werken, FALSE);
	attribute<Bool> IsLU_Verblijfsrecreatie (AdminDomain) := MakeDefined(Sector_behoud == S_Verblijfsrecreatie, FALSE);

	attribute<Bool> IsWonen_StartState              (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector ? 'SrcStand/Aantal_Woningen_Totaal >= ModelParameters/Advanced/MinimumWoningAmount * AdminDomain/NrHaPerCell / 1[ha]' : 'const(FALSE, AdminDomain)';
	attribute<Bool> IsWerken_StartState             (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector ? 'SrcStand/PandFootprint_Werken >= ModelParameters/Advanced/MinimumPandFootprint * AdminDomain/NrHaPerCell / 1[ha]' : 'const(FALSE, AdminDomain)';
	attribute<Bool> IsVerblijfsrecreatie_StartState (AdminDomain) := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'SrcStand/Objecten_Verblijfsrecreatie >= ModelParameters/Advanced/MinimumVerblijfsobjectAmount * AdminDomain/NrHaPerCell / 1[ha]' : 'const(FALSE, AdminDomain)';

	attribute<Bool> IsWonen_Zichtjaar              (AdminDomain) := Sector_uit_stand == S_Wonen;
	attribute<Bool> IsWerken_Zichtjaar             (AdminDomain) := Sector_uit_stand == S_Werken;
	attribute<Bool> IsVerblijfsrecreatie_Zichtjaar (AdminDomain) := Sector_uit_stand == S_Verblijfsrecreatie
	, Descr = "Wat de allocatie dit zichtjaar heeft neergezet, per sector. Kwam vroeger uit een lijst vergelijkingen per subsector; de sector uit de stand zegt hetzelfde in een regel.";

	container Group_Wonen_Start                  := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Wonen', ModelParameters/Advanced/MinimumGroupSize, 'StartState');
	container Group_Wonen_Zichtjaar              := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Wonen', ModelParameters/Advanced/MinimumGroupSize, 'Zichtjaar');
	container Group_Werken_Start                 := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Werken', ModelParameters/Advanced/MinimumGroupSize, 'StartState');
	container Group_Werken_Zichtjaar             := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Werken', ModelParameters/Advanced/MinimumGroupSize, 'Zichtjaar');
	container Group_Verblijfsrecreatie_Start     := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Verblijfsrecreatie', ModelParameters/Advanced/MinimumGroupSize, 'StartState');
	container Group_Verblijfsrecreatie_Zichtjaar := Templates/Indicatoren/Landgebruikskaart/GetNieuwGrouped_T('Verblijfsrecreatie', ModelParameters/Advanced/MinimumGroupSize, 'Zichtjaar');

	attribute<meter2> Wonen_Filtered             (AdminDomain) := =IsStartJaar ? 'Group_Wonen_Start/IsNieuwGrouped ? SrcStand/PandFootprint_Wonen : null_f[meter2]' : 'Group_Wonen_Zichtjaar/IsNieuwGrouped ? SrcStand/PandFootprint_Wonen : null_f[meter2]';
	attribute<meter2> Werken_Filtered            (AdminDomain) := =IsStartJaar ? 'Group_Werken_Start/IsNieuwGrouped ? SrcStand/PandFootprint_Werken : null_f[meter2]' : 'Group_Werken_Zichtjaar/IsNieuwGrouped ? SrcStand/PandFootprint_Werken : null_f[meter2]';
	attribute<meter2> Verblijfrecreatie_Filtered (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector
		? (IsStartJaar
			? 'Group_Verblijfsrecreatie_Start/IsNieuwGrouped ? SrcStand/PandFootprint_Werken : null_f[meter2]'
			: 'Group_Verblijfsrecreatie_Zichtjaar/IsNieuwGrouped ? AdminDomain/NrMeter2PerCell : null_f[meter2]')
		: 'const(null_f, AdminDomain, meter2)';

	unit<UInt8> Typen : NrOfRows = 3
	{
		attribute<String> name : ['Wonen', 'Werken', 'Verblijfsrecreatie'];
		attribute<String> Label := name;
		container         V     := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	attribute<Typen> Dominant_BebouwdeOmgeving (AdminDomain) := IsLU_Wonen || IsLU_NoData ? null_b[Typen] : ArgMax_ifdefined(Wonen_Filtered, Werken_Filtered, Verblijfrecreatie_Filtered)[Typen]
	, Descr = "Welke bebouwde functie de cel domineert: die met de grootste gefilterde voetafdruk. De groepsfilters gooien clusters onder de minimumomvang eruit, zodat een losse cel geen woongebied maakt.";

	attribute<Bool> SubResult_Wonen              (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector              ? 'Dominant_BebouwdeOmgeving == Typen/V/Wonen'              : 'const(FALSE, AdminDomain)';
	attribute<Bool> SubResult_Werken             (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector             ? 'Dominant_BebouwdeOmgeving == Typen/V/Werken'             : 'const(FALSE, AdminDomain)';
	attribute<Bool> SubResult_Verblijfsrecreatie (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? 'Dominant_BebouwdeOmgeving == Typen/V/Verblijfsrecreatie' : 'const(FALSE, AdminDomain)';
	attribute<Bool> SubResult_Waterberging       (AdminDomain) := Sector_uit_stand == S_Waterberging;

	attribute<Bool> HeeftOplegging (AdminDomain) := IsDefined(ThisVariantData/ExogeenOpleggen/Beheertype_Kaart) || IsDefined(ThisVariantData/ExogeenOpleggen/LandbouwType_rel)
	, Descr = "Legt de variant hier iets op? De twee stromen rechtstreeks, zoals de landbouwallocatie ze sinds #803 ook leest, in plaats van de samengevoegde as die eerst naar een kaartklasse vertaalde.";

	unit<UInt8> Voorrang : NrOfRows = 10
	{
		attribute<String> name : ['GeenData','Oplegging','Water','Waterberging','Behoud','Wonen','Werken','Verblijfsrecreatie','Allocatie','Rest'];
		attribute<String> Label := name;
		container         V     := for_each_nedv(name, 'value('+string(id(.))+', ..)', void, .);
	}

	attribute<Voorrang> Voorrang_rel (AdminDomain) := switch(
		 case(IsLU_NoData, Voorrang/V/GeenData)
		,case(!IsStartJaar && HeeftOplegging, Voorrang/V/Oplegging)
		,case(IsLU_Water, Voorrang/V/Water)
		,case(SubResult_Waterberging, Voorrang/V/Waterberging)
		,case(IsLU_exogenous || IsLU_Wonen || IsLU_Verblijfsrecreatie, Voorrang/V/Behoud)
		,case(SubResult_Wonen, Voorrang/V/Wonen)
		,case(SubResult_Werken, Voorrang/V/Werken)
		,case(SubResult_Verblijfsrecreatie, Voorrang/V/Verblijfsrecreatie)
		,case(IsDefined(Sector_uit_stand), Voorrang/V/Allocatie)
		, Voorrang/V/Rest
	)
	, Descr = "Wie heeft voorrang op deze cel? Negen voorwaarden in vaste volgorde, uitgedrukt op de stand en op deze kaart zelf (#803). Geen data gaat voor. Dan de oplegging, want daar schrijft het model
				een ander landgebruik voor. Dan water, dat blijft water. Dan waterberging uit de allocatie. Dan wat blijven moet: infrastructuur en begraafplaatsen, en wonen en verblijfsrecreatie die er al
				lagen. Dan de dominantie tussen de bebouwde functies. Dan de rest van de allocatie. En anders houdt de cel wat zij had. Of het water was en of er wonen of verblijfsrecreatie lag wordt aan
				deze kaart van het vorige zichtjaar gevraagd, en in het basisjaar aan het type en aan de bebouwing die LGN aanwijst.";

	parameter<Actor/Sector/wo_Landbouw> S_Wonen              := rlookup(lowercase('Wonen'),              lowercase(Actor/Sector/wo_Landbouw/name));
	parameter<Actor/Sector/wo_Landbouw> S_Werken             := rlookup(lowercase('Werken'),             lowercase(Actor/Sector/wo_Landbouw/name));
	parameter<Actor/Sector/wo_Landbouw> S_Verblijfsrecreatie := rlookup(lowercase('Verblijfsrecreatie'), lowercase(Actor/Sector/wo_Landbouw/name));
	parameter<Actor/Sector/wo_Landbouw> S_Waterberging       := rlookup(lowercase('Waterberging'),       lowercase(Actor/Sector/wo_Landbouw/name));

	attribute<Actor/Sector/wo_Landbouw> Sector_uit_stand (AdminDomain) :=
		rlookup(lowercase(Actor/Sector/name[Actor/Sector/xSubsector/Sector_rel[SrcStand/SubSector_rel]]), lowercase(Actor/Sector/wo_Landbouw/name))
	, Descr = "Welke sector het model op deze cel heeft gealloceerd, uit de stand. Landbouw valt eruit, want die staat niet in wo_Landbouw: op deze kaart is landbouw een toestand van de cel en geen bezetter.";

	attribute<Actor/Sector/wo_Landbouw> Sector_behoud (AdminDomain) := =IsStartJaar
		? '/BaseData/StartState/Landgebruik/LGN_Bebouwd_Sector'
		: 'LU_NL2120/Sector_rel[PrevIndicatoren/LandgebruikskaartNL2120/Result]'
	, Descr = "Wat er stond: in het basisjaar de bebouwing die LGN zelf aanwijst, klasse 18 wonen en klasse 19 werken, en daarna de sector van deze kaart in het vorige zichtjaar. Dit is het doorgeefluik dat in de oude kaart gg_prev heette.";

	attribute<Actor/Sector/wo_Landbouw> Sector_rel (AdminDomain) := switch(
		 case(Voorrang_rel == Voorrang/V/GeenData,          null_b[Actor/Sector/wo_Landbouw])
		,case(Voorrang_rel == Voorrang/V/Oplegging,         null_b[Actor/Sector/wo_Landbouw])
		,case(Voorrang_rel == Voorrang/V/Wonen,             S_Wonen)
		,case(Voorrang_rel == Voorrang/V/Werken,            S_Werken)
		,case(Voorrang_rel == Voorrang/V/Verblijfsrecreatie,S_Verblijfsrecreatie)
		,case(Voorrang_rel == Voorrang/V/Waterberging,      S_Waterberging)
		,case(Voorrang_rel == Voorrang/V/Allocatie,         Sector_uit_stand)
		, Sector_behoud
	)
	, Descr = "Wie bezet deze cel, afgeleid uit de voorrangsregel (#803): elke uitkomst van die regel krijgt hier zijn sector. Drie uitkomsten leveren geen bezetter op: geen data, en de exogene oplegging,
				want die legt natuur, water of een gewas op en dat is een toestand van de cel. Water en Rest vallen in de default, met opzet: daar geldt wat er stond, en dat kan een sector zijn; een cel die
				werken was en dit jaar door geen enkele case wordt geraakt houdt werken.";

	attribute<Bool> VolgtWerkenGrenzen (AdminDomain) := Sector_VolgtWerkenGrenzen[Sector_rel];

	attribute<VerhardingK> Verhardingsklasse (AdminDomain) :=
		VolgtWerkenGrenzen
			? Classify(Verharding, VerhardingK/ClassBreaks_Werken)
			: Classify(Verharding, VerhardingK/ClassBreaks_Wonen)
	, Descr = "In welke van de vijf verhardingsklassen de cel valt, met de reeks grenzen die bij haar sector hoort. Buiten de sectoren heeft dit geen betekenis en wordt het niet gebruikt.";

	attribute<SectorVerhardingK> SectorVerharding_rel (AdminDomain) :=
		rlookup(uint32(Verhardingsklasse) * 256 + uint32(Sector_rel), SectorVerhardingK/Sleutel)
	, Descr = "De rij in SectorVerhardingK die bij deze sector en deze verhardingsklasse hoort. Via de samengestelde sleutel en niet via de blokvolgorde, zodat een wijziging in de opbouw van die unit hier geen stille verschuiving geeft.";

	// -- de twee kaarten --

	attribute<LU_NL2120> Result_Berekend (AdminDomain) := switch(
		 case(Voorrang_rel == Voorrang/V/GeenData, null_b[LU_NL2120])
		,case(IsDefined(Sector_rel), invert(LU_NL2120/SectorVerhardingK_rel)[SectorVerharding_rel])
		, invert(LU_NL2120/LandgebruikType_rel)[Type]
	), Descr = "Waar de landgebruikskaart een sector toont de sector met haar verhardingsklasse, en anders het type uit de stand. Waar de kaart niets weet blijft de cel leeg; waar zij wel iets weet en de stand niet, is de cel hier ook leeg en telt Toets_KaartTegenStand hem. Result hieronder vult zo'n cel met de klasse van het vorige zichtjaar (#826).";

	attribute<LU_NL2120> Result (AdminDomain) := =IsStartJaar ? 'Result_Berekend' : 'MakeDefined(Result_Berekend, PrevIndicatoren/LandgebruikskaartNL2120/Result)'
	, Descr = "De kaart van dit jaar: de berekende klasse, en waar die leeg is en de kaart van het vorige zichtjaar niet, de klasse van vorig jaar (#826).

				Waarom. De stand krijgt haar landgebruikstype per zichtjaar op het gecomprimeerde rekendomein van de allocatie, en dat volgt het studiegebied op AllocDomain-niveau (Geography/IsCompactedDomain). Een 25-metercel binnen het studiegebied waarvan de 100-metercel erbuiten valt heeft vanaf het eerste zichtjaar geen type, geen subsector en geen verharding meer, terwijl de basisjaarkaart er wel een klasse heeft. Zonder deze terugval vielen zo 67.483 cellen (4.218 ha) uit elke kaart vanaf 2040, in alle varianten dezelfde: randcellen langs de kust, de grote wateren en de landsgrens. De grondbalans sloot daardoor niet en 1.242 ha telde als verdwenen natuur en 1.181 ha als verdwenen landbouw zonder dat er iets was gebeurd (productierun van 10 en 11 september 2026).

				Buiten het gecomprimeerde domein alloceert het model niet en legt het niets op, dus de klasse van vorig jaar is daar de juiste; via de keten is dat de basisjaarklasse. De structurele reparatie, de basisjaarwaarden in de stand zelf laten staan buiten het gecomprimeerde domein, vraagt een nieuwe allocatie en staat in #826 voor de volgende productierun. Een cel die in beide jaren leeg is blijft leeg. In het basisjaar is er geen vorige kaart en is Result gelijk aan Result_Berekend; de 89,25 ha zonder type die daar al leeg waren blijven leeg, zie Areaal_ZonderType.";

	attribute<LU_Hoofdklasse> Result_Hoofdklasse (AdminDomain) :=
		Voorrang_rel == Voorrang/V/GeenData
			? null_b[LU_Hoofdklasse]
			: MakeDefined(LU_NL2120/Hoofdklasse_rel[Result], LU_Hoofdklasse/V/Overig)
	, Descr = "Dezelfde kaart, gelezen door de aggregatiekolom van LU_NL2120. Een cel waarvoor de stand geen type heeft valt hier op Overig terug en niet op leeg: op de kaart hoort geen gat te vallen waar wel iets ligt, en Deltares heeft die restbak expliciet gevraagd. Hoeveel dat er zijn staat in Areaal_ZonderType.";

	attribute<LU_Hoofdklasse_ZonderVerharding> Result_Hoofdklasse_ZonderVerharding (AdminDomain) := switch(
		 case(Voorrang_rel == Voorrang/V/GeenData, null_b[LU_Hoofdklasse_ZonderVerharding])
		,case(IsDefined(Sector_rel), invert(LU_Hoofdklasse_ZonderVerharding/Sector_rel)[Sector_rel])
		, MakeDefined(ZonderVerharding_rel[Hoofdklasse_van_Type[Type]], LU_Hoofdklasse_ZonderVerharding/V/Overig)
	)
	, Descr = "Dezelfde kaart als Result_Hoofdklasse, maar zonder de verhardingsbanden binnen wonen en werken, en daarmee zonder de verharding als leverancier; de kaart die Templates/Indicatoren/Verharding
				leest. De verhardingsindicator mag geen klasse lezen die zelf uit de verharding volgt, anders draait de keten rond (#803, zie Classifications/Grondgebruik/LU_Hoofdklasse_ZonderVerharding);
				daarom leest deze tak de sector rechtstreeks uit Sector_rel en het type uit Type, en niet uit Result.";

	attribute<CBSKlasse> gg_CBS (AdminDomain) := /BaseData/StartState/Bodemstatistiek/gg_CBS
	, Descr = "De CBS-bodemstatistiekklasse van het basisjaar, de bron onder de groenindeling hieronder. Stond in de kaart op LU_ModelType onder dezelfde naam en is met #803 meeverhuisd.";

	attribute<CBSKlasse/Aggr/Groen> GroenInBasisjaar (AdminDomain) := invert(/Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/org_rel)[CBSKlasse/Aggr_rel[gg_CBS]];
	attribute<CBSKlasse/Aggr/Groen> GroenInZichtjaar (AdminDomain) := (GroenInBasisjaar[uint8] / uint8(!/Classifications/Actor/Sector/xSubsector/LegtCelVast[Stand/Subsector_rel]))[CBSKlasse/Aggr/Groen]
	, Descr = "Het groen van het basisjaar, weggevallen op de cellen die de allocatie heeft bebouwd. De toets loopt sinds #803 langs LegtCelVast: landbouw legt de cel niet vast en houdt haar groen, terwijl dat groen met een kale IsDefined op het hele landbouwareaal zou verdwijnen zodra landbouw meealloceert.";
	
	parameter<String> Result_prev_str := 'Write_Result_SA != PrevIndicatoren/LandgebruikskaartNL2120/Write_Result_SA';

	// Wat er dit zichtjaar bij komt en af gaat ten opzichte van het vorige: de klasse van dit jaar,
	// respectievelijk die van vorig jaar, op de cellen waar de kaart is veranderd. Verhuisd uit de kaart
	// op LU_ModelType (#803). Zonder Descr, want achter een meta-expressie past hier geen eigenschap meer.
	attribute<LU_NL2120> Result_bij_tov_PrevYear (AdminDomain) := =IsStartJaar ? 'const(null_b, AdminDomain, LU_NL2120)' : Result_prev_str + ' ? Write_Result_SA : null_b';
	attribute<LU_NL2120> Result_af_tov_PrevYear (AdminDomain) := =IsStartJaar ? 'const(null_b, AdminDomain, LU_NL2120)' : Result_prev_str + ' ? PrevIndicatoren/LandgebruikskaartNL2120/Write_Result_SA : null_b';

	// -- wegschrijven --

	parameter<string> StorageStr_Detail      := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/LandgebruikNL2120/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
	parameter<string> StorageStr_Hoofdklasse := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/LandgebruikHoofdklasse/'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';

	attribute<LU_NL2120> Write_Result_SA (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? Result : null_b
	, StorageName = "=StorageStr_Detail"
	, StorageType = "gdalwrite.grid"
	, Descr = "Wegschrijven. De kaart zelf wordt altijd opnieuw uitgerekend, want het is een afgeleide; alleen de arealentabellen kunnen hem sinds #824 teruglezen, via Bron_Result_SA hieronder.";

	attribute<LU_Hoofdklasse> Write_Result_Hoofdklasse_SA (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? Result_Hoofdklasse : null_b
	, StorageName = "=StorageStr_Hoofdklasse"
	, StorageType = "gdalwrite.grid";

	// -- de bron van de arealentabellen: levend, of teruggelezen uit de export (#824) --
	// De arealentabellen in Templates/Indicatoren_T/Export.dms lezen Bron_Result_SA en Bron_Result_Hoofdklasse_SA. Met
	// ModelParameters/TabellenUitExport aan zijn dat de twee kaarten hierboven zoals de export ze heeft geschreven.
	attribute<LU_NL2120>      Lees_Result_SA             (AdminDomain) : StorageName = "=StorageStr_Detail",      StorageType = "gdal.grid", StorageReadOnly = "TRUE";
	attribute<LU_Hoofdklasse> Lees_Result_Hoofdklasse_SA (AdminDomain) : StorageName = "=StorageStr_Hoofdklasse", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
	attribute<LU_NL2120>      Bron_Result_SA             (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Result_SA' : 'Write_Result_SA';
	attribute<LU_Hoofdklasse> Bron_Result_Hoofdklasse_SA (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Result_Hoofdklasse_SA' : 'Write_Result_Hoofdklasse_SA';

	// -- controlegetallen --

	parameter<Ha> Areaal_Totaal      := sum(Geography/rdc_meter/IsStudyArea_AdminDomain            ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Het studiegebied, waar alle arealen hieronder bij op moeten tellen.";
	parameter<Ha> Areaal_Sector      := sum(IsDefined(Sector_rel) && Voorrang_rel != Voorrang/V/GeenData ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Wat de sectoren van de kaart beslaan; die krijgen hun verhardingsonderverdeling.";
	parameter<Ha> Areaal_ZonderType  := sum(Voorrang_rel != Voorrang/V/GeenData && IsNull(Sector_rel) && IsNull(Type) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen waar de kaart wel een klasse heeft en de stand geen type. Die vallen in Result_Berekend leeg en in de kaartbeeldkaart op Overig; Result vult ze sinds #826 met de klasse van vorig jaar, zie Areaal_TerugValOpVorigeKaart. In het basisjaar ging het om 89,25 ha van de 3.509.101; loopt dit op, dan is de stand-administratie ergens niet dekkend.";
	parameter<Ha> Areaal_TerugValOpVorigeKaart := sum(IsNull(Result_Berekend) && IsDefined(Result) ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen die hun klasse aan het vorige zichtjaar ontlenen omdat de berekening leeg was (#826). In de productierun van 10 en 11 september 2026 is dat 4.217,7 ha in elk zichtjaar, de randcellen buiten het gecomprimeerde rekendomein. Nul in het basisjaar. Loopt dit op, dan verliest de stand ergens anders haar type.";
	parameter<Ha> Areaal_ZonderKaart := sum(Voorrang_rel == Voorrang/V/GeenData ? AdminDomain/NrHaPerCell : 0[Ha]), Descr = "Cellen buiten de landgebruikskaart. Die blijven in beide kaarten leeg.";

	parameter<Ha> Areaal_Natuur := sum(LU_NL2120/IsNatuur[Result] ? AdminDomain/NrHaPerCell : 0[Ha])
	, Descr = "Controlegetal: alle natuur in dit jaar volgens de gewone landgebruikskaart. Stond eerder in de NL2120-kaart van #633 en is met #783 meeverhuisd, want Diagnose leest hem als controlewaarde.";

}
