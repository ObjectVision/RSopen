container Waterberging := Basisjaar/Waterberging
{
	#include<Aanbod.dms> // Is extra tov bestaand aanbod (het aanbod achter de restvraag in basisjaar)
	
	container PerGrid
	{
		attribute<meter3> Vraag             (Grid) := Basisjaar/Waterberging/PerGrid/Vraag;
		attribute<meter3> Aanbod            (Grid) := ='sum(Waterberging/Aanbod/Totaal, AdminDomain/rdc_'+Grid_ref+'_rel)';
		attribute<meter3> Restvraag         (Grid) := Vraag - Aanbod;
		attribute<meter3> RestvraagPositief (Grid) := max_elem(Restvraag, 0[meter3]);
		attribute<meter3> Afname            (Grid) := Vraag - RestvraagPositief, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Waterberging_Afname_'+Zichtjaar_name+'_m3_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
		
		attribute<float32> Relatief         (Grid) := Afname / Vraag;
	}
	
	container PerRegio
	{
		unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path
		{
			attribute<.> Per_Grid (Grid) := poly2grid(geometry, Grid);
		}
		
		attribute<Meter3> Vraag             (Regio) := sum(PerGrid/Vraag, Regio/Per_Grid);
		attribute<Meter3> RestVraag         (Regio) := sum(PerGrid/RestVraag, Regio/Per_Grid);
		attribute<Meter3> RestvraagPositief (Regio) := sum(PerGrid/RestvraagPositief, Regio/Per_Grid);
		attribute<meter3> Afname            (Regio) := Vraag - RestvraagPositief;
		
		attribute<float32> Relatief         (Regio) := Afname / Vraag;
	}
	
	container PerNL
	{
		parameter<Meter3> Vraag             := sum(PerGrid/Vraag);
		parameter<Meter3> RestVraag         := sum(PerGrid/RestVraag);
		parameter<Meter3> RestvraagPositief := sum(PerGrid/RestvraagPositief);
		parameter<meter3> Afname            := Vraag - RestvraagPositief;
		
		parameter<float32> Relatief         := Afname / Vraag;
	}
}