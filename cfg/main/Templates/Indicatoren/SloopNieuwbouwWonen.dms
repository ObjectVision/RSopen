// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Nieuwbouw, Sloop, Nieuwbouw_opp, InclBAGnb.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container SloopNieuwbouwWonen
{
	attribute<Bool> AllocatieHeeftPlaatsgevondenDezePeriode (AdminDomain) := = // we gaan ervan uit dat bagnieuwbiouw of alloc in periode p allocatie in periode p + n uitsluit
		'IsDefined(Stand/SubSector_rel) && !IsDefined' +
		iif(
			Zichtjaar_name == first(Classifications/Time/Zichtjaar/name)
			,'(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantAllocatie/StartState_metBAGnieuwbouw/SubSector_rel))'
			,'(PrevStand/SubSector_rel)'
		);

	container Nieuwbouw :=
		for_each_nedv(
			Classifications/Vastgoed/WP4/name
			,'MakeDefined(
				float32(ThisVariantClassifications/Vastgoed/OP/WP4_rel[Stand/OP_rel] 
					== Classifications/Vastgoed/WP4/V/'+Classifications/Vastgoed/WP4/name+' 
					&& AllocatieHeeftPlaatsgevondenDezePeriode) 
					* ThisVariantClassifications/Vastgoed/OP/Dichtheid[Stand/OP_rel] * AdminDomain/NrHaPerCell
				,0[Woning]
			)'
			, AdminDomain
			, Woning
		)
	{
		attribute<Woning> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')', StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/NieuwbouwWonen_'+Zichtjaar_name+'_Won_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
	}
	
	container Sloop :=
		for_each_nedv(
			Classifications/Vastgoed/WP4/name,
			'StartState_metBAGSloopNieuwbouwWonen/Woningen/'+Classifications/Vastgoed/WP4/name+' * float32(AllocatieHeeftPlaatsgevondenDezePeriode)',
			AdminDomain, Woning
		)
	{
		attribute<Woning> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')', StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SloopWonen_'+Zichtjaar_name+'_Won_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
	}
	
	container Stand_WP4
	: Descr = "Woningvoorraad per woningtype (WP4: vrijstaand, twee onder 1 kap, rijtjeswoning, appartement).
				Het totaal is per definitie gelijk aan de gealloceerde stand (Aantal_Woningen_Totaal): appartement == meergezins,
				en het grondgebonden deel (eengezins) wordt verdeeld over de drie grondgebonden typen volgens de flow-reeks hieronder.
				De allocatie zelf rekent op WP2xVSSH; het WP4-type volgt uit het gekozen ontwikkelpakket (OP/WP4_rel)."
	{
		container flows :=
			for_each_nedv(
				Classifications/Vastgoed/WP4/name
				// Eerste zichtjaar bouwt voort op de basisjaarvoorraad (incl. BAG-sloop/nieuwbouw), daarna op het vorige zichtjaar.
				, iif(
					  Zichtjaar_name == first(Classifications/Time/Zichtjaar/name)
					, 'StartState_metBAGSloopNieuwbouwWonen/Woningen/'
					, 'PrevIndicatoren/SloopNieuwbouwWonen/Stand_WP4/'
				  ) + Classifications/Vastgoed/WP4/name
					+ ' + Nieuwbouw/' + Classifications/Vastgoed/WP4/name
					+ ' - Sloop/'     + Classifications/Vastgoed/WP4/name
				, AdminDomain
				, Woning
			), Descr = "Ongecorrigeerde reeks: vorige stand + nieuwbouw - sloop. Levert de typeverdeling; het niveau komt uit de allocatie."
		{
			attribute<Woning> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
		}
		
		attribute<Woning> Grondgebonden_flows (AdminDomain) := flows/vrijstaand + flows/twee_onder_1_kap + flows/rijtjeswoning;
		attribute<Woning> Grondgebonden_alloc (AdminDomain) := Stand/Aantal_Woningen_eengezins_VrijeSector  + Stand/Aantal_Woningen_eengezins_SocialeHuur;
		attribute<Woning> Gestapeld_alloc     (AdminDomain) := Stand/Aantal_Woningen_meergezins_VrijeSector + Stand/Aantal_Woningen_meergezins_SocialeHuur;
		
		// Aandelen tellen altijd op tot 1; zonder grondgebonden reeks valt alles terug op rijtjeswoning (dominante type).
		attribute<float32> aandeel_vrijstaand       (AdminDomain) := Grondgebonden_flows > 0[Woning] ? float32(flows/vrijstaand)       / float32(Grondgebonden_flows) : 0f;
		attribute<float32> aandeel_twee_onder_1_kap (AdminDomain) := Grondgebonden_flows > 0[Woning] ? float32(flows/twee_onder_1_kap) / float32(Grondgebonden_flows) : 0f;
		attribute<float32> aandeel_rijtjeswoning    (AdminDomain) := Grondgebonden_flows > 0[Woning] ? float32(flows/rijtjeswoning)    / float32(Grondgebonden_flows) : 1f;
		
		attribute<Woning> vrijstaand       (AdminDomain) := aandeel_vrijstaand       * Grondgebonden_alloc;
		attribute<Woning> twee_onder_1_kap (AdminDomain) := aandeel_twee_onder_1_kap * Grondgebonden_alloc;
		attribute<Woning> rijtjeswoning    (AdminDomain) := aandeel_rijtjeswoning    * Grondgebonden_alloc;
		attribute<Woning> appartement      (AdminDomain) := Gestapeld_alloc;
		attribute<Woning> Totaal           (AdminDomain) := vrijstaand + twee_onder_1_kap + rijtjeswoning + appartement;
	}
	
	container Nieuwbouw_opp :=
		for_each_nedv(
			Classifications/Vastgoed/WP4/name
			,	'MakeDefined('
					'float32(ThisVariantClassifications/Vastgoed/OP/WP4_rel[Stand/OP_rel] == Classifications/Vastgoed/WP4/V/'+Classifications/Vastgoed/WP4/name+''
								'&& AllocatieHeeftPlaatsgevondenDezePeriode)'
						'* ThisVariantClassifications/Vastgoed/OP/Woonoppervlakte[Stand/OP_rel]'
						'* AdminDomain/NrHaPerCell'
					',0[meter2]'
				')'
			, AdminDomain
			, meter2
		)
	{
		attribute<meter2> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
	}
	
	// container Sloop_opp :=
		// for_each_nedv(
			// Classifications/Vastgoed/WP4/name
			// ,'StartState_metBAGSloopNieuwbouwWonen/Gebruiksoppervlak/'+Classifications/Vastgoed/WP4/name+' * float32(AllocatieHeeftPlaatsgevondenDezePeriode)'
			// ,AdminDomain
			// , meter2
		// )
	// {
		// attribute<meter2> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
	// }
	
	container InclBAGnb
	{
		container Nieuwbouw :=
			for_each_nedv(
				Classifications/Vastgoed/WP4/name,
				'SloopNieuwbouwWonen/Nieuwbouw/'+Classifications/Vastgoed/WP4/name
					// BAG-nieuwbouw = gerealiseerde voorraad t/m basisjaar; alleen in eerste zichtjaar meetellen, anders dubbeltelling over zichtjaren.
					+ iif(Zichtjaar_name == first(Classifications/Time/Zichtjaar/name), ' + BAGSloopNieuwbouwWonen/Nieuwbouw/'+Classifications/Vastgoed/WP4/name, ''),
				AdminDomain, Woning
			)
		{
			attribute<Woning> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')', StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/NieuwbouwWonen_InclBAGnb_'+Zichtjaar_name+'_Won_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";

		}
		
		container Sloop :=
			for_each_nedv(
				Classifications/Vastgoed/WP4/name,
				'SloopNieuwbouwWonen/Sloop/'+Classifications/Vastgoed/WP4/name
					// BAG-sloop = gerealiseerde sloop t/m basisjaar; alleen in eerste zichtjaar meetellen, anders dubbeltelling over zichtjaren.
					+ iif(Zichtjaar_name == first(Classifications/Time/Zichtjaar/name), ' + BAGSloopNieuwbouwWonen/Sloop/'+Classifications/Vastgoed/WP4/name, ''),
				AdminDomain, Woning
			)
		{
			attribute<Woning> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')', StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SloopWonen_InclBAGnb_'+Zichtjaar_name+'_Won_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
		}
		
		// container Nieuwbouw_opp :=
			// for_each_nedv(
				// Classifications/Vastgoed/WP4/name
				// ,'BAGSloopNieuwbouwWonen/Nieuwbouw_opp/'+Classifications/Vastgoed/WP4/name+' + SloopNieuwbouwWonen/Nieuwbouw_opp/'+Classifications/Vastgoed/WP4/name
				// ,AdminDomain
				// , meter2
			// )
		// {
			// attribute<meter2> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
		// }
		
		// container Sloop_opp :=
			// for_each_nedv(
				// Classifications/Vastgoed/WP4/name
				// ,'BAGSloopNieuwbouwWonen/Sloop_opp/'+Classifications/Vastgoed/WP4/name+' + SloopNieuwbouwWonen/Sloop_opp/'+Classifications/Vastgoed/WP4/name
				// , AdminDomain
				// , meter2
			// )
		// {
			// attribute<meter2> Totaal (AdminDomain) := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
		// }
		
		container PerNL
		{
			container Nieuwbouw :=
				for_each_nedv(
					Classifications/Vastgoed/WP4/name,
					'sum(InclBAGnb/Nieuwbouw/'+Classifications/Vastgoed/WP4/name+')',
					void, Woning
				)
			{
				parameter<Woning> Totaal := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
			}
			
			container Sloop :=
				for_each_nedv(
					Classifications/Vastgoed/WP4/name,
					'sum(InclBAGnb/Sloop/'+Classifications/Vastgoed/WP4/name+')',
					void, Woning
				)
			{
				parameter<Woning> Totaal := = 'add('+asItemList(Classifications/Vastgoed/WP4/name)+')';
			}
		}
	}
}