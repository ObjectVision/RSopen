// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De beschikbaarheid van groen per woning en het groentekort. Zie ObjectVision/RSopen#400 en #480.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Groennormtoets_T
: Descr = "De beschikbaarheid van groen per woning, getoetst aan ModelParameters/Indicatoren/Groennorm/GroenPerWoning, en het groentekort dat eruit volgt. Een woning deelt het groen binnen de straal met alle
			woningen die dat groen ook binnen de straal hebben; over alle woningen opgeteld telt elke vierkante meter groen dan precies een keer. Gedeeld door de normtoets van de bereikbaarheid van groen
			(Templates/Indicatoren/BereikbaarheidGroen_T/Normtoets) en de claim van nieuw stedelijk groen (Templates/Allocatie/Zichtjaar_T/Impl/StedelijkGroenClaim), zodat de claim hetzelfde tekort
			oplost als de indicator meet (#480)."
{
	attribute<Woning>  Woningen (AdminDomain);
	attribute<Float32> Fractie  (AdminDomain);
	//

	parameter<String>    Kern               := '/Geography/Distmatrices/Impl_25m/pot' + string(/ModelParameters/Indicatoren/Groennorm/Straal) + 'm/potrange/Flat2', Descr = "De schijf van de straal, hemelsbreed.";
	attribute<meter2>    Groen_m2           (AdminDomain) := Fractie * AdminDomain/NrMeter2PerCell;
	attribute<Woning>    WoningenInOmgeving (AdminDomain) := ='potential(Woningen, ' + Kern + ')[Woning]', Descr = "De woningen binnen de straal van de cel.";
	attribute<m2_Woning> AandeelPerWoning   (AdminDomain) := WoningenInOmgeving > 0[Woning] ? Groen_m2 / WoningenInOmgeving : 0[m2_Woning], Descr = "Wat het groen van de cel aan elke woning in de omgeving bijdraagt.";
	attribute<m2_Woning> GroenInOmgevingPerWoning (AdminDomain) := ='potential(AandeelPerWoning, ' + Kern + ')[m2_Woning]';
	attribute<m2_Woning> GroenPerWoning     (AdminDomain) := Woningen > 0[Woning] ? GroenInOmgevingPerWoning : 0[m2_Woning] / 0f
	, Descr = "De beschikbaarheid: het groen binnen de straal per woning, gedeeld met de woningen eromheen; leeg in een cel zonder woningen. Over alle woningen opgeteld komt het groen bij de woningen er precies een keer in.";
	attribute<Bool>      OnderReferentie    (AdminDomain) := GroenPerWoning < /ModelParameters/Indicatoren/Groennorm/GroenPerWoning;
	attribute<meter2>    Tekort             (AdminDomain) := Woningen > 0[Woning] ? Woningen * max_elem(/ModelParameters/Indicatoren/Groennorm/GroenPerWoning - GroenPerWoning, 0[m2_Woning]) : 0[meter2]
	, Descr = "Het groentekort van de woningen in de cel: hun aantal maal wat ze onder de referentie zitten. Opgeteld over een regio is het een ondergrens voor het groen dat erbij moet: GroenPerWoning deelt het groen van een cel met alle woningen binnen de straal, dus een m2 nieuw groen haalt hooguit een m2 van de som af, en minder waar het ook woningen boven de referentie bedient (#480).";
}
