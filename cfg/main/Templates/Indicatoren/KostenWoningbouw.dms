// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Indicator kosten woningbouw (#505): regulier bouwen, de meerkosten van bouwen op een
// bodemdalingsgevoelige ondergrond, en het beheer en onderhoud dat daarna bij de gemeente valt.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container KostenWoningbouw
: Descr = "Wat het bouwen van de gealloceerde nieuwbouw kost, gesplitst naar wie het betaalt en waarvoor (#505).

			Drie regels, alle drie per cel en per hectare gealloceerde nieuwbouw:

			Regulier is de grondproductie van de ontwikkelaar: bouw- en woonrijp maken, bovenwijkse voorzieningen en het planproces, uit de Fakton-schatting van 2019. Dat is de post die er ook zonder bodemdaling zou zijn.

			MeerkostenBodemdaling is wat daar bovenop komt doordat de ondergrond zakt, uit de kengetallen van bijlage E van het landelijk afwegingskader bodemdalingbestendige nieuwbouw van Deltares en Sweco, toegepast op de grondgebruikfracties van het gealloceerde ontwikkelpakket. Gemeten ten opzichte van integraal ophogen op een locatie zonder bodemdalingsopgave. Deze post zit ook in het exploitatiesaldo en stuurt dus de allocatie.

			BeheerEnOnderhoud is de netto contante waarde over honderd jaar van het onderhoud aan de openbare ruimte, uit tabel E-9. Die valt bij de gemeente en zit daarom niet in het exploitatiesaldo. Hij staat hier omdat het verschil tussen de alternatieven juist daar zit: de virtuele ontwikkelaar kiest op aanlegkosten, en wat hij bespaart komt hier terug.

			Let op de reikwijdte. Dit gaat over de kosten van bouwen, niet over schade door bodemdaling aan wat er al staat; die staat in de funderingsschade van #408."
{
	unit<UInt8> OP := ='ThisVariantClassifications/Vastgoed/OP';

	container Vlak := ='ThisVariantData/Suitability/src/Wonen/Bodemdalingkosten/Vlak'
	,	Descr = "De grondgebruikverdeling per ontwikkelpakket, in m2 per hectare terrein. Zelfde indeling als de allocatie gebruikt, dus indicator en model kunnen niet uit elkaar lopen.";

	container Kosten := Templates/Suitabilities/Bodemdalingkosten_T(
		  Vlak/Bebouwing[Stand/OP_rel]
		, Vlak/Tuin[Stand/OP_rel]
		, Vlak/Straat[Stand/OP_rel]
		, Vlak/Park[Stand/OP_rel]
		, Vlak/OpenbareRuimte[Stand/OP_rel]
		, Vlak/Water[Stand/OP_rel]
	)
	,	Descr = "Een enkele doorrekening met de grondgebruikverdeling van het pakket dat in deze cel daadwerkelijk is gealloceerd. Dat is 53 keer goedkoper dan alle pakketten doorrekenen en achteraf selecteren, en geeft per definitie hetzelfde antwoord.";

	attribute<Ha> Nieuwbouw_Ha (AdminDomain) := MakeDefined(WaardeNabijheidGroen/Nieuwbouw/n_nieuwbouw_cumulatief, 0[Woning]) > 0[Woning] ? AdminDomain/NrHaPerCell : 0[Ha]
	,	Descr = "Het oppervlak waarover de kosten worden geboekt: de cellen waar sinds het basisjaar netto woningen zijn bijgekomen, elk voor hun volle celoppervlak. Dat is grover dan naar rato van het aantal woningen, maar de kengetallen van bijlage E zijn per m2 terrein en niet per woning, dus een cel waar wordt gebouwd draagt de inrichtingskosten van die cel.";

	parameter<Bool> BodemdalingIsBeprijsd := VariantParameters/VariantK/BodemdalingkostenInSaldo[Variant_rel]
	,	Descr = "Heeft deze variant de bodemdaling via de kengetallen beprijsd? Zo niet, dan zat het bodemeffect in de grondproductiekosten via de dummy AndersBouwen, en zouden de twee onderste regels daar bovenop dubbel tellen. Ze staan dan op nul.";

	attribute<Eur_Ha> MeerkostenBodemdaling_perHa (AdminDomain) := = BodemdalingIsBeprijsd
		? 'Kosten/Meerkosten'
		: 'const(0[Eur_Ha], AdminDomain)'
	,	Descr = "De meerkosten per hectare van het ontwikkelpakket dat in deze cel is gealloceerd.

				Nul in een variant die de bodemdaling niet via de kengetallen beprijst. Dat is geen bewering dat de bodem daar gratis is, maar dat het effect daar in Regulier zit, via de dummy AndersBouwen in de grondproductiekosten. Zo blijven de regels van deze indicator optelbaar zonder dubbeltelling.";

	attribute<Eur_Ha> BeheerEnOnderhoud_perHa (AdminDomain) := = BodemdalingIsBeprijsd
		? 'Kosten/Onderhoud/Totaal'
		: 'const(0[Eur_Ha], AdminDomain)'
	,	Descr = "Het onderhoud per hectare over honderd jaar, netto contante waarde, van het gealloceerde ontwikkelpakket. Ook nul in een variant zonder de kengetallen: het gekozen inrichtingsalternatief waar dit onderhoud bij hoort is daar niet gebruikt, dus een bedrag noemen zou suggereren dat het model die keuze heeft gemaakt.";

	attribute<Classifications/Modellering/InrichtingsalternatiefK> Alternatief (AdminDomain) := Kosten/Keuze
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Alternatief_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid"
	,	Descr = "Welk inrichtingsalternatief op deze plek het goedkoopst uitkomt voor het gealloceerde pakket. Kaartbeeld bij de kostenindicator.";

	attribute<Eur_Ha> Regulier_perHa (AdminDomain) := ThisVariantData/Suitability/src/Wonen/Grondproductiekosten/Results/Totaal/Nominaal_high
	,	Descr = "De grondproductiekosten per hectare op deze locatie. Hangt niet aan het ontwikkelpakket maar aan de cel, want de Fakton-schatting kent geen pakketten. Wel variantspecifiek sinds #505: in een variant zonder BodemdalingkostenInSaldo draagt de dummy AndersBouwen hierin nog het bodemeffect.";

	attribute<Eur> Regulier (AdminDomain) := MakeDefined(Regulier_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Regulier_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	attribute<Eur> MeerkostenBodemdaling (AdminDomain) := MakeDefined(MeerkostenBodemdaling_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_MeerkostenBodemdaling_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	attribute<Eur> BeheerEnOnderhoud (AdminDomain) := MakeDefined(BeheerEnOnderhoud_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_BeheerEnOnderhoud_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	// #651: bouwen is een eenmalige uitgave bij oplevering, en de drie posten hierboven zijn cumulatief sinds het
	// basisjaar. De NCW wordt daarom per periode opgebouwd, net als bij Woningwaarde: alleen wat er in deze periode
	// bijkwam krijgt de factor van dit zichtjaar, opgeteld bij de NCW van het vorige zichtjaar.
	attribute<Ha> Nieuwbouw_Ha_dezePeriode (AdminDomain) := = IsFirstAllocYear
		? 'Nieuwbouw_Ha'
		: 'max_elem(Nieuwbouw_Ha - PrevIndicatoren/KostenWoningbouw/Nieuwbouw_Ha, 0[Ha])'
	,	Descr = "Hectares die in deze periode zijn gaan bouwen. Begrensd op nul: een cel die per saldo leegloopt geeft geen negatieve bouwkosten terug.";

	attribute<Eur> Regulier_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(Regulier_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(Regulier_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/Regulier_NCW';

	attribute<Eur> MeerkostenBodemdaling_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(MeerkostenBodemdaling_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(MeerkostenBodemdaling_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/MeerkostenBodemdaling_NCW'
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_MeerkostenBodemdaling_NCW_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	attribute<Eur> BeheerEnOnderhoud_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(BeheerEnOnderhoud_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(BeheerEnOnderhoud_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/BeheerEnOnderhoud_NCW'
	,	Descr = "Let op de dubbele verdiscontering in de betekenis: het bedrag zelf is al een contante waarde over honderd jaar vanaf oplevering, uit tabel E-9, en wordt hier nog eens teruggerekend van het bouwjaar naar het basisjaar.";

	parameter<Eur> Regulier_Per_NL                  := sum(Regulier);
	parameter<Eur> MeerkostenBodemdaling_Per_NL     := sum(MeerkostenBodemdaling);
	parameter<Eur> BeheerEnOnderhoud_Per_NL         := sum(BeheerEnOnderhoud);
	parameter<Eur> MeerkostenBodemdaling_NCW_Per_NL := sum(MeerkostenBodemdaling_NCW);

	parameter<Ha>  Nieuwbouw_Ha_Per_NL := sum(Nieuwbouw_Ha), Descr = "Controlegetal: over hoeveel hectare deze bedragen zijn geboekt.";

	parameter<String> Controle :=
		  'Kosten woningbouw, ' + Casus_name + ', ' + Zichtjaar_name + ', landelijk totaal in miljoen euro\n'
		+ '  nieuwbouw over            ' + string(Nieuwbouw_Ha_Per_NL / 1[Ha])              + ' hectare\n'
		+ '  regulier                  ' + string(Regulier_Per_NL              / 1e6[Eur])  + '\n'
		+ '  meerkosten bodemdaling    ' + string(MeerkostenBodemdaling_Per_NL / 1e6[Eur])  + '\n'
		+ '  beheer en onderhoud 100jr ' + string(BeheerEnOnderhoud_Per_NL     / 1e6[Eur])  + '\n'
		+ '  meerkosten in NCW         ' + string(MeerkostenBodemdaling_NCW_Per_NL / 1e6[Eur]) + '\n'
	,	StorageName = "='%LocalDataProjDir%/Diagnose/KostenWoningbouw_'+Casus_name+'_'+Zichtjaar_name+'.txt'"
	,	StorageType = "str"
	,	Descr = "Controlewaarden voor #505, zodat de orde van grootte zonder kaartviewer te lezen is.";

	unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;

	container Per_Regio
	: Descr = "De drie posten per regio van de indicatorentabellen, gestuurd door ModelParameters/Advanced/IndicatorRegio_ref."
	{
		attribute<Eur> Regulier                  (Regio) := sum(KostenWoningbouw/Regulier,                  Regio/Per_AdminDomain);
		attribute<Eur> MeerkostenBodemdaling     (Regio) := sum(KostenWoningbouw/MeerkostenBodemdaling,     Regio/Per_AdminDomain);
		attribute<Eur> BeheerEnOnderhoud         (Regio) := sum(KostenWoningbouw/BeheerEnOnderhoud,         Regio/Per_AdminDomain);
		attribute<Eur> MeerkostenBodemdaling_NCW (Regio) := sum(KostenWoningbouw/MeerkostenBodemdaling_NCW, Regio/Per_AdminDomain);
		attribute<Ha>  Nieuwbouw_Ha              (Regio) := sum(KostenWoningbouw/Nieuwbouw_Ha,              Regio/Per_AdminDomain);

		attribute<Eur_Ha> MeerkostenBodemdaling_perHa (Regio) := (MeerkostenBodemdaling / Nieuwbouw_Ha)[Eur_Ha]
		,	Descr = "De meerkosten per hectare nieuwbouw in deze regio. Handiger om regio's mee te vergelijken dan het totaal, dat vooral de bouwopgave weerspiegelt.";
	}
}
