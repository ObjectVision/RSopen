////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Indicator kosten woningbouw (#505): regulier bouwen, de meerkosten van bouwen op een
// bodemdalingsgevoelige ondergrond, en het beheer en onderhoud dat daarna bij de gemeente valt.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container KostenWoningbouw
: Descr = "Wat het bouwen van de gealloceerde nieuwbouw kost, gesplitst naar wie het betaalt en waarvoor (#505).

			Drie regels, alle drie per cel en per hectare gealloceerde nieuwbouw:

			Regulier is de grondproductie van de ontwikkelaar: bouw- en woonrijp maken, bovenwijkse voorzieningen en het planproces, uit de Fakton-schatting van 2019. Dat is de post die er ook zonder bodemdaling zou zijn.

			MeerkostenBodemdaling is wat daar bovenop komt doordat de ondergrond zakt, uit de kengetallen van bijlage E van het landelijk afwegingskader bodemdalingbestendige nieuwbouw van Deltares en Sweco, toegepast op de grondgebruikfracties van het gealloceerde ontwikkelpakket. Gemeten ten opzichte van integraal ophogen op een locatie zonder bodemdalingsopgave. Deze post zit ook in het exploitatiesaldo en stuurt dus de allocatie.

			BeheerEnOnderhoud is de netto contante waarde over honderd jaar van het onderhoud aan de openbare ruimte, uit tabel E-9. Die valt bij de gemeente en zit daarom niet in het exploitatiesaldo. Hij staat hier omdat het verschil tussen de alternatieven juist daar zit: de virtuele ontwikkelaar kiest op aanlegkosten, en wat hij bespaart komt hier terug.

			Let op de reikwijdte. Dit gaat over de kosten van bouwen, niet over schade door bodemdaling aan wat er al staat; die staat in de funderingsschade van #408."
{
	unit<UInt8> OP := ='ThisVariantClassifications/Vastgoed/OP';

	container Vlak := ='ThisVariantData/Suitability/src/Wonen/Bodemdalingkosten/Vlak'
	,	Descr = "De grondgebruikverdeling per ontwikkelpakket, in m2 per hectare terrein. Zelfde indeling als de allocatie gebruikt, dus indicator en model kunnen niet uit elkaar lopen.";

	container BouwwijzeInput
	: Descr = "De invoer voor de bouwwijzekeuze van de gealloceerde stand (#723), in dezelfde vorm als SSM2017_Overstromingsschades/Grondgebruik/Zichtjaar hem aanlevert. Zelfde sjabloon en zelfde invoer, dus de bouwwijze waarvoor hier betaald wordt is de bouwwijze waarvoor de schade-indicator krediet geeft."
	{
		attribute<OP>    OP_rel_cad  (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, Stand/OP_rel);
		attribute<meter> Waterdiepte (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/Overstromingsdiepte);

		parameter<Bool> VeenGeldt := ='VariantParameters/VariantK/BouwwijzeVeenGeldtVoorOPs[VariantParameters/VariantK/V/'+Variant_name+']';

		attribute<Bool> EisBodemdalingbestendig (CompactedAdminDomain) := VeenGeldt ? ThisVariantData/BouwwijzeEis/Bodemdalingbestendig : const(FALSE, CompactedAdminDomain);
		attribute<Bool> EisDrijvend             (CompactedAdminDomain) := VeenGeldt ? ThisVariantData/BouwwijzeEis/Drijvend             : const(FALSE, CompactedAdminDomain);

		container Toegestaan :=
			for_each_nedv(
				  /Classifications/Modellering/BouwwijzeK/name
				, 'MakeDefined(OP/Bouwwijze/Toegestaan/' + /Classifications/Modellering/BouwwijzeK/name + '[OP_rel_cad], FALSE)'
				, CompactedAdminDomain
				, bool
			);
	}

	container Bouwwijzekeuze := Templates/Beschikbaarheden/Bouwwijzekeuze_T(
		  BouwwijzeInput/Toegestaan
		, ThisVariantData/BouwwijzeEis/Overstromingsbestendig
		, BouwwijzeInput/EisBodemdalingbestendig
		, BouwwijzeInput/EisDrijvend
		, BouwwijzeInput/Waterdiepte
	), Descr = "Welke bouwwijze is er op elke standcel gebouwd (#723). Bepaalt hier hoeveel er moest worden opgehoogd en dus wat dat kostte.";

	container Kosten := Templates/Suitabilities/Bodemdalingkosten_T(
		  Vlak/Bebouwing[Stand/OP_rel]
		, Vlak/Tuin[Stand/OP_rel]
		, Vlak/Straat[Stand/OP_rel]
		, Vlak/Park[Stand/OP_rel]
		, Vlak/OpenbareRuimte[Stand/OP_rel]
		, Vlak/Water[Stand/OP_rel]
		, recollect_by_cond(AdminDomain/IsCompactedDomain, Bouwwijzekeuze/GekozenSchadevrijeDiepte, 0[meter])
	)
	,	Descr = "Een enkele doorrekening met de grondgebruikverdeling van het pakket dat in deze cel daadwerkelijk is gealloceerd. Dat is 53 keer goedkoper dan alle pakketten doorrekenen en achteraf selecteren, en geeft per definitie hetzelfde antwoord.";

	attribute<Ha> Nieuwbouw_Ha (AdminDomain) := MakeDefined(WaardeNabijheidGroen/Nieuwbouw/n_nieuwbouw_cumulatief, 0[Woning]) > 0[Woning] ? AdminDomain/NrHaPerCell : 0[Ha]
	,	Descr = "Het oppervlak waarover de kosten worden geboekt: de cellen waar sinds het basisjaar netto woningen zijn bijgekomen, elk voor hun volle celoppervlak. Dat is grover dan naar rato van het aantal woningen, maar de kengetallen van bijlage E zijn per m2 terrein en niet per woning, dus een cel waar wordt gebouwd draagt de inrichtingskosten van die cel.";

	unit<UInt32> BW := /Classifications/Modellering/BouwwijzeK;

	attribute<BW> Bouwwijze (AdminDomain) := Nieuwbouw_Ha > 0[Ha]
		? recollect_by_cond(AdminDomain/IsCompactedDomain, Bouwwijzekeuze/Keuze)
		: null_u
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Bouwwijze_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid"
	,	Descr = "Met welke bouwwijze er op deze cel is gebouwd (#763). Alleen ingevuld waar sinds het basisjaar netto woningen zijn bijgekomen; elders leeg, want een bouwwijze zonder nieuwbouw is een mogelijkheid en geen uitkomst.

				Dit is de kaartkant van aangepast bouwen. Waar de bebouwingstypekaart veen die categorie aanwijst eist het model een bodemdalingbestendige bouwwijze (#614, #723), en hier is per cel te zien wat daaruit gekomen is: ophogen, funderen op palen of drijvend in plaats van een gewone woning. De keuze stond al in de boom, als invoer voor de ophoogkosten en voor de overstromingsschade, maar werd nergens weggeschreven.

				Let op de variantschakelaar. De veeneis werkt alleen door waar BouwwijzeVeenGeldtVoorOPs aanstaat, dus in NbSMax en NbSGenuanceerd en niet in BAU en BAU2. In die laatste twee toont deze kaart de bouwwijze die het pakket zelf toelaat, zonder de eis uit het landschapstype.";

	attribute<Ha> Nieuwbouw_Ha_perBouwwijze (BW) := pcount(Bouwwijze)[float32] * AdminDomain/NrHaPerCell
	,	Descr = "De tabelkant van de kaart hierboven: hoeveel hectare nieuwbouw er per bouwwijze staat. Gaat als Bouwwijze_Areaal mee in de export (#763).";

	attribute<Float32> Kostenopslag_Bouwwijze (AdminDomain) := = /ModelParameters/Wonen/BouwwijzeOpslagInBouwkosten
		? 'MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, Bouwwijzekeuze/GekozenKostenopslag), 1f)'
		: 'const(1f, AdminDomain)'
	,	Descr = "De opslagfactor op de bouwkosten van de bouwwijze die hier gekozen is, precies zoals Geschiktheden/Bouwkosten hem leest. Staat de schakelaar uit, dan staat er 1,0 en laat de indicator de factor net zo weg als het model zelf.";

	parameter<Bool> BodemdalingIsBeprijsd := VariantParameters/VariantK/BodemdalingkostenInSaldo[Variant_rel]
	,	Descr = "Heeft deze variant de bodemdaling via de kengetallen beprijsd? Zo niet, dan zat het bodemeffect in de grondproductiekosten via de dummy AndersBouwen, en zouden de twee onderste regels daar bovenop dubbel tellen. Ze staan dan op nul.";

	attribute<Eur_Ha> MeerkostenBodemdaling_perHa (AdminDomain) := = BodemdalingIsBeprijsd
		? 'Kosten/Meerkosten'
		: 'const(0[Eur_Ha], AdminDomain)'
	,	Descr = "De meerkosten per hectare van het ontwikkelpakket dat in deze cel is gealloceerd.

				Nul in een variant die de bodemdaling niet via de kengetallen beprijst. Dat is geen bewering dat de bodem daar gratis is, maar dat het effect daar in Regulier zit, via de dummy AndersBouwen in de grondproductiekosten. Zo blijven de regels van deze indicator optelbaar zonder dubbeltelling.";

	attribute<Eur_Ha> BeheerEnOnderhoud_perHa (AdminDomain) := = BodemdalingIsBeprijsd
		? 'Kosten/Onderhoud/Totaal'
		: 'const(0[Eur_Ha], AdminDomain)'
	,	Descr = "Het onderhoud per hectare over honderd jaar, netto contante waarde, van het gealloceerde ontwikkelpakket. Ook nul in een variant zonder de kengetallen: het gekozen inrichtingsalternatief waar dit onderhoud bij hoort is daar niet gebruikt, dus een bedrag noemen zou suggereren dat het model die keuze heeft gemaakt.";

	attribute<Classifications/Modellering/InrichtingsalternatiefK> Alternatief (AdminDomain) := Kosten/Keuze
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Alternatief_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid"
	,	Descr = "Welk inrichtingsalternatief op deze plek het goedkoopst uitkomt voor het gealloceerde pakket. Kaartbeeld bij de kostenindicator.";

	attribute<Eur_Ha> Regulier_perHa (AdminDomain) := ThisVariantData/Suitability/src/Wonen/Grondproductiekosten/Results/Totaal/Nominaal_high
	,	Descr = "De grondproductiekosten per hectare op deze locatie. Hangt niet aan het ontwikkelpakket maar aan de cel, want de Fakton-schatting kent geen pakketten. Wel variantspecifiek sinds #505: in een variant zonder BodemdalingkostenInSaldo draagt de dummy AndersBouwen hierin nog het bodemeffect.";

	attribute<Eur> Regulier (AdminDomain) := MakeDefined(Regulier_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Regulier_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	attribute<Eur> MeerkostenBodemdaling (AdminDomain) := MakeDefined(MeerkostenBodemdaling_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_MeerkostenBodemdaling_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	attribute<Eur> BeheerEnOnderhoud (AdminDomain) := MakeDefined(BeheerEnOnderhoud_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_BeheerEnOnderhoud_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	// #763: de bouwkosten van de woningen zelf. Die zaten wel in de allocatie, via het exploitatiesaldo,
	// maar stonden in geen enkele indicator en werden dus ook nergens weggeschreven. De drie posten
	// hierboven gaan over het terrein en niet over het gebouw: Regulier is grondproductie en de twee
	// andere zijn bodemdaling. Deze regel telt wat er op dat terrein wordt neergezet.
	container Src_Bouwkosten := ='ThisVariantData/Suitability/src/Wonen/Bouwkosten'
	,	Descr = "De bouwkostenkant van de geschiktheid, met dezelfde opslagen die de allocatie heeft gebruikt. Zelfde bron als het model, zodat indicator en allocatie niet uit elkaar kunnen lopen.";

	attribute<Eur_m2> Prijs_perM2BVO (AdminDomain) :=
		OP/VSSH_rel[Stand/OP_rel] == /Classifications/Vastgoed/VSSH/V/SocialeHuur
			? MakeDefined(/ModelParameters/Wonen/Bouwkosten/SocialeHuur, mean(/ModelParameters/Wonen/Bouwkosten/SocialeHuur))
			: MakeDefined(/ModelParameters/Wonen/Bouwkosten/VrijeSector, mean(/ModelParameters/Wonen/Bouwkosten/VrijeSector))
	,	Descr = "Het CBS-kental per m2 bvo van het landsdeel, voor de huursector van het pakket dat hier is gealloceerd. Buiten de landsdeelpolygonen het landelijk gemiddelde, dezelfde terugval als in Geschiktheden/Bouwkosten (#595).";

	attribute<Eur_Ha> Bouwkosten_perHa (AdminDomain) :=
		  Prijs_perM2BVO
		* OP/Dichtheid[Stand/OP_rel]
		* OP/BVOPerWoning[Stand/OP_rel]
		* Kostenopslag_Bouwwijze
		* Src_Bouwkosten/WoningtypeOpslag_perOP[Stand/OP_rel]
		* Src_Bouwkosten/BouwlaagOpslag_perOP[Stand/OP_rel]
	,	Descr = "De bouwkosten per hectare van het pakket dat in deze cel is gealloceerd: de prijs per m2 bvo maal het bvo dat een hectare van dit pakket draagt, met dezelfde drie opslagen als in Geschiktheden/Bouwkosten. Dezelfde formule als perOP daar, een keer doorgerekend met het gealloceerde pakket in plaats van 53 keer, net zoals Kosten hierboven dat voor de bodemdaling doet.";

	attribute<Eur> Bouwkosten (AdminDomain) := MakeDefined(Bouwkosten_perHa * Nieuwbouw_Ha, 0[Eur])
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Bouwkosten_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid"
	,	Descr = "De bouwkosten van de gealloceerde nieuwbouw, geboekt over dezelfde hectares als de drie posten hierboven (#763).

				Dit is de grootste kostenpost van woningbouw en de enige die tot nu toe alleen binnen de allocatie bestond. Tel hem niet zonder meer op bij Regulier: die twee samen vormen de aanlegkant, terwijl BeheerEnOnderhoud over de gebruiksfase gaat en bij de gemeente valt.

				Zelfde grofheid als de rest van deze indicator: een cel waar netto woningen zijn bijgekomen draagt de bouwkosten van een volle hectare van dat pakket, en niet naar rato van het aantal woningen dat er precies bij kwam.";

	attribute<Eur> MeerkostenBouwwijze (AdminDomain) := Bouwkosten * (1f - 1f / Kostenopslag_Bouwwijze)
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_MeerkostenBouwwijze_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid"
	,	Descr = "Het deel van de bouwkosten hierboven dat aan de gekozen bouwwijze hangt, dus wat aangepast bouwen boven op een gewone woning kost (#763).

				Deze post is op dit moment overal nul, en dat is geen meting maar een lege kolom in de kentallen: BouwwijzeK/Kostenopslag staat voor alle vijf de bouwwijzen op 1,0 en ModelParameters/Wonen/BouwwijzeOpslagInBouwkosten staat op FALSE. Het model beprijst de bouwwijze dus niet, en de veeneis werkt als een restrictie op de pakketkeuze in plaats van als een prijs. Zie #505 en #723. Zodra daar getallen in staan vult deze post zich vanzelf, langs dezelfde weg als de allocatie hem dan voelt.

				Wat wel al een bedrag draagt is MeerkostenBodemdaling hierboven. Dat zijn de ophoogkosten van het terrein uit bijlage E, en die hangen aan de bodemdalingsopgave van de plek en niet aan de categorie uit de bebouwingstypekaart.";

	// #651: bouwen is een eenmalige uitgave bij oplevering, en de drie posten hierboven zijn cumulatief sinds het
	// basisjaar. De NCW wordt daarom per periode opgebouwd, net als bij Woningwaarde: alleen wat er in deze periode
	// bijkwam krijgt de factor van dit zichtjaar, opgeteld bij de NCW van het vorige zichtjaar.
	attribute<Ha> Nieuwbouw_Ha_dezePeriode (AdminDomain) := = IsFirstAllocYear
		? 'Nieuwbouw_Ha'
		: 'max_elem(Nieuwbouw_Ha - PrevIndicatoren/KostenWoningbouw/Nieuwbouw_Ha, 0[Ha])'
	,	Descr = "Hectares die in deze periode zijn gaan bouwen. Begrensd op nul: een cel die per saldo leegloopt geeft geen negatieve bouwkosten terug.";

	attribute<Eur> Regulier_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(Regulier_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(Regulier_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/Regulier_NCW';

	attribute<Eur> MeerkostenBodemdaling_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(MeerkostenBodemdaling_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(MeerkostenBodemdaling_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/MeerkostenBodemdaling_NCW'
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_MeerkostenBodemdaling_NCW_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid";

	attribute<Eur> BeheerEnOnderhoud_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(BeheerEnOnderhoud_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(BeheerEnOnderhoud_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/BeheerEnOnderhoud_NCW'
	,	Descr = "Let op de dubbele verdiscontering in de betekenis: het bedrag zelf is al een contante waarde over honderd jaar vanaf oplevering, uit tabel E-9, en wordt hier nog eens teruggerekend van het bouwjaar naar het basisjaar.";

	attribute<Eur> Bouwkosten_NCW (AdminDomain) := = IsFirstAllocYear
		? 'MakeDefined(Bouwkosten_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor'
		: 'MakeDefined(Bouwkosten_perHa * Nieuwbouw_Ha_dezePeriode, 0[Eur]) * Verdiscontering/Factor + PrevIndicatoren/KostenWoningbouw/Bouwkosten_NCW'
	,	StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/KostenWoningbouw_Bouwkosten_NCW_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	,	StorageType = "gdalwrite.grid"
	,	Descr = "De bouwkosten in netto contante waarde, per periode opgebouwd volgens dezelfde regel als de posten hierboven (#651, #763).";

	parameter<Eur> Regulier_Per_NL                  := sum(Regulier);
	parameter<Eur> MeerkostenBodemdaling_Per_NL     := sum(MeerkostenBodemdaling);
	parameter<Eur> BeheerEnOnderhoud_Per_NL         := sum(BeheerEnOnderhoud);
	parameter<Eur> MeerkostenBodemdaling_NCW_Per_NL := sum(MeerkostenBodemdaling_NCW);
	parameter<Eur> Regulier_NCW_Per_NL              := sum(Regulier_NCW);
	parameter<Eur> BeheerEnOnderhoud_NCW_Per_NL     := sum(BeheerEnOnderhoud_NCW);
	parameter<Eur> Bouwkosten_Per_NL                := sum(Bouwkosten);
	parameter<Eur> Bouwkosten_NCW_Per_NL            := sum(Bouwkosten_NCW);
	parameter<Eur> MeerkostenBouwwijze_Per_NL       := sum(MeerkostenBouwwijze);

	parameter<Ha>  Nieuwbouw_Ha_Per_NL := sum(Nieuwbouw_Ha), Descr = "Controlegetal: over hoeveel hectare deze bedragen zijn geboekt.";

	parameter<String> Controle :=
		  'Kosten woningbouw, ' + Casus_name + ', ' + Zichtjaar_name + ', landelijk totaal in miljoen euro\n'
		+ '  nieuwbouw over            ' + string(Nieuwbouw_Ha_Per_NL / 1[Ha])              + ' hectare\n'
		+ '  regulier                  ' + string(Regulier_Per_NL              / 1e6[Eur])  + '\n'
		+ '  meerkosten bodemdaling    ' + string(MeerkostenBodemdaling_Per_NL / 1e6[Eur])  + '\n'
		+ '  beheer en onderhoud 100jr ' + string(BeheerEnOnderhoud_Per_NL     / 1e6[Eur])  + '\n'
		+ '  meerkosten in NCW         ' + string(MeerkostenBodemdaling_NCW_Per_NL / 1e6[Eur]) + '\n'
		+ '  bouwkosten                ' + string(Bouwkosten_Per_NL          / 1e6[Eur])  + '\n'
		+ '  bouwkosten in NCW         ' + string(Bouwkosten_NCW_Per_NL      / 1e6[Eur])  + '\n'
		+ '  meerkosten bouwwijze      ' + string(MeerkostenBouwwijze_Per_NL / 1e6[Eur])  + '\n'
		+ '  hectare per bouwwijze\n    '
		+ AsList(BW/name + ' ' + string(Nieuwbouw_Ha_perBouwwijze / 1[Ha]), '\n    ') + '\n'
	,	StorageName = "='%LocalDataProjDir%/Diagnose/KostenWoningbouw_'+Casus_name+'_'+Zichtjaar_name+'.txt'"
	,	StorageType = "str"
	,	Descr = "Controlewaarden voor #505, zodat de orde van grootte zonder kaartviewer te lezen is.";

	unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;

	container Per_Regio
	: Descr = "De drie posten per regio van de indicatorentabellen, gestuurd door ModelParameters/Advanced/IndicatorRegio_ref."
	{
		attribute<Eur> Regulier                  (Regio) := sum(KostenWoningbouw/Regulier,                  Regio/Per_AdminDomain_Fijn);
		attribute<Eur> MeerkostenBodemdaling     (Regio) := sum(KostenWoningbouw/MeerkostenBodemdaling,     Regio/Per_AdminDomain_Fijn);
		attribute<Eur> BeheerEnOnderhoud         (Regio) := sum(KostenWoningbouw/BeheerEnOnderhoud,         Regio/Per_AdminDomain_Fijn);
		attribute<Eur> MeerkostenBodemdaling_NCW (Regio) := sum(KostenWoningbouw/MeerkostenBodemdaling_NCW, Regio/Per_AdminDomain_Fijn);
		attribute<Ha>  Nieuwbouw_Ha              (Regio) := sum(KostenWoningbouw/Nieuwbouw_Ha,              Regio/Per_AdminDomain_Fijn);
		attribute<Eur> Regulier_NCW              (Regio) := sum(KostenWoningbouw/Regulier_NCW,              Regio/Per_AdminDomain_Fijn);
		attribute<Eur> BeheerEnOnderhoud_NCW     (Regio) := sum(KostenWoningbouw/BeheerEnOnderhoud_NCW,     Regio/Per_AdminDomain_Fijn);
		attribute<Eur> Bouwkosten                (Regio) := sum(KostenWoningbouw/Bouwkosten,                Regio/Per_AdminDomain_Fijn);
		attribute<Eur> Bouwkosten_NCW            (Regio) := sum(KostenWoningbouw/Bouwkosten_NCW,            Regio/Per_AdminDomain_Fijn);
		attribute<Eur> MeerkostenBouwwijze       (Regio) := sum(KostenWoningbouw/MeerkostenBouwwijze,       Regio/Per_AdminDomain_Fijn);

		attribute<Eur_Ha> MeerkostenBodemdaling_perHa (Regio) := (MeerkostenBodemdaling / Nieuwbouw_Ha)[Eur_Ha]
		,	Descr = "De meerkosten per hectare nieuwbouw in deze regio. Handiger om regio's mee te vergelijken dan het totaal, dat vooral de bouwopgave weerspiegelt.";
	}

	container Per_NL
	: Descr = "Dezelfde posten landsdekkend. Bestaat sinds #763, zodat de landelijke indicatorentabel ze langs hetzelfde pad kan lezen als de regionale: alleen de containernaam verschilt. Zelfde constructie als KostenWerklocaties/Per_NL (#705); de waarden zelf stonden er al als losse parameters hierboven."
	{
		parameter<Eur> Regulier                  := Regulier_Per_NL;
		parameter<Eur> Regulier_NCW              := Regulier_NCW_Per_NL;
		parameter<Eur> MeerkostenBodemdaling     := MeerkostenBodemdaling_Per_NL;
		parameter<Eur> MeerkostenBodemdaling_NCW := MeerkostenBodemdaling_NCW_Per_NL;
		parameter<Eur> BeheerEnOnderhoud         := BeheerEnOnderhoud_Per_NL;
		parameter<Eur> BeheerEnOnderhoud_NCW     := BeheerEnOnderhoud_NCW_Per_NL;
		parameter<Eur> Bouwkosten                := Bouwkosten_Per_NL;
		parameter<Eur> Bouwkosten_NCW            := Bouwkosten_NCW_Per_NL;
		parameter<Eur> MeerkostenBouwwijze       := MeerkostenBouwwijze_Per_NL;
		parameter<Ha>  Nieuwbouw_Ha              := Nieuwbouw_Ha_Per_NL;
	}
}
