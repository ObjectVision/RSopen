//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Aanbod
{
	#include<WaarAllocatieHeeftPlaatsgevonden.dms>
	
	container WaarGeenAllocatieHeeftPlaatsgevonden
	{
		attribute<Bool> AllocatieHeeftNietPlaatsgevonden (AdminDomain) := !IsDefined(Stand/Sector_rel);
		
		container OpDaken
		{
			parameter<float32> FractieGroenDak := /VariantParameters/VariantK/FractieGroenDakBestaandeBouwIn2050[Variant_rel];
			parameter<float32> FractieBlauwDak := /VariantParameters/VariantK/FractieBlauwDakBestaandeBouwIn2050[Variant_rel];

			attribute<meter2> Dakoppervlak      (AdminDomain) := (Basisjaar/Stand/PandFootprint_Wonen + Basisjaar/Stand/PandFootprint_Werken) / float32(AllocatieHeeftNietPlaatsgevonden)
			, Descr = "Wonen plus Werken dekt samen de hele pandfootprint uit de BAG. De verblijfsrecreatiefootprint hoort er niet bij opgeteld te worden: die bestaat uit logies-panden, en logies valt in Classifications/Actor.dms onder de Jobs6-subsector Ov_consumentendiensten en zit daarmee al in PandFootprint_Werken. Optellen leverde dubbele daken op in cellen met logies. Sinds #364 telt de verblijfsrecreatiestand alleen nog logies binnen de CBS-verblijfsrecreatiegebieden, dus de dubbeltelling speelde daar het sterkst.";
			attribute<meter2> DakoppervlakGroen (AdminDomain) := Dakoppervlak * FractieGroenDak;
			attribute<meter2> DakoppervlakBlauw (AdminDomain) := Dakoppervlak * FractieBlauwDak;
			attribute<meter3> Resultaat         (AdminDomain) := add(
				  DakoppervlakGroen * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/GroenDak]
				, DakoppervlakBlauw * Classifications/WaterretentieK/Bergingscapaciteit[Classifications/WaterretentieK/V/BlauwDak]
			)
			, Descr = "Berging op bestaande daken, groen plus blauw. De blauwe term stond tot #714 uitgecommentarieerd terwijl de groene fractie in de NbS-varianten al op nul stond; het dakenaanbod kwam daar dus op exact nul uit. De twee fracties tellen samen op tot het aandeel bewerkte daken en zijn per constructie niet dubbel: een dak is groen of blauw, niet allebei.";
		}
		
		container OpOverigePlekken
		{
			container GrondgebruikSrc := /SourceData/Grondgebruik/BGT/IsDefinedAndNotNoData; // @Bart: TODO: deze src naar basedata verplaatsen
			
			parameter<string> CalcString :=
				'GrondgebruikSrc/@Capaciteit_AdminDomain
				* /VariantParameters/VariantK/FractieWaterretentieCapaciteit@[Variant_rel]
				* Classifications/WaterretentieK/MetBenodigdeVelddata/Bergingscapaciteit[Classifications/WaterretentieK/MetBenodigdeVelddata/V/@] 
				/ float32(AllocatieHeeftNietPlaatsgevonden)';
			
			container PerWaterrententieK := for_each_nedv(Classifications/WaterretentieK/MetBenodigdeVelddata/name, replace(CalcString, '@', Classifications/WaterretentieK/MetBenodigdeVelddata/name), AdminDomain, meter3);
			
			attribute<meter3> Totaal (AdminDomain) := ='add('+AsItemList('PerWaterrententieK/'+Classifications/WaterretentieK/MetBenodigdeVelddata/name)+')';
		}
		
		attribute<meter3> Totaal (AdminDomain) := add(MakeDefined(OpDaken/Resultaat, 0[meter3]), MakeDefined(OpOverigePlekken/Totaal, 0[meter3]));
	}
	
	attribute<meter3> Totaal (AdminDomain) := add(MakeDefined(WaarAllocatieHeeftPlaatsgevonden/Totaal, 0[meter3]), MakeDefined(WaarGeenAllocatieHeeftPlaatsgevonden/Totaal, 0[meter3]));
}