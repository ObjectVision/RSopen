// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De dichtheid van de hele woningvoorraad: per cel met woningen de woningen per hectare, per regio het gemiddelde
// daarvan. Een sjabloon voor het basisjaar en de zichtjaren, zodat beide dezelfde rekenregel hebben (#439).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template DichtheidVoorraad_T
: Descr = "De dichtheid van de hele voorraad (#439), in het basisjaar en in elk zichtjaar met dezelfde rekenregel: per cel met woningen de woningen van de stand per hectare, en per regio en landelijk het gemiddelde daarvan over die cellen. Een zichtjaar heeft daarnaast in Dichtheid/Wonen de dichtheid van de nieuwbouw, over de cellen waar sinds het basisjaar wonen is gealloceerd; het basisjaar heeft die niet."
{
	parameter<String>    Zichtjaar_name;
	//

	unit<UInt32>         Regio := =/ModelParameters/Advanced/IndicatorRegio_path;

	container Wonen
	{
		attribute<Bool>      HeeftWoningen   (AdminDomain) := ThisYear/Stand/Aantal_Woningen_Totaal > 0[Woning], Descr = "Een cel met woningen in de stand, ook als dat minder dan een hele woning is.";
		attribute<Woning_ha> Per_AdminDomain (AdminDomain) := HeeftWoningen ? ThisYear/Stand/Aantal_Woningen_Totaal / AdminDomain/NrHaPerCell : null_f[Woning_ha], Descr = "De woningen per hectare in een cel met woningen, leeg elders.";
		parameter<Woning_ha> Per_NL                        := mean(Per_AdminDomain);
		attribute<Woning_ha> Per_Regio       (Regio)       := mean(Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
	}
}
