// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De dichtheid van de hele voorraad van wonen en werken: per cel met woningen of banen de woningen, banen en
// pandvoetafdruk per hectare, per regio het gemiddelde daarvan. Een sjabloon voor het basisjaar en de zichtjaren,
// zodat beide dezelfde rekenregel hebben (#439).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template DichtheidVoorraad_T
: Descr = "De dichtheid van de hele voorraad (#439), in het basisjaar en in elk zichtjaar met dezelfde rekenregel: per cel met woningen de woningen van de stand per hectare, en per cel met banen de banen en de pandvoetafdruk per hectare, en per regio en landelijk het gemiddelde daarvan over die cellen. Een zichtjaar heeft daarnaast in Dichtheid/Wonen en Dichtheid/Werken de dichtheid van de nieuwbouw, over de cellen waar sinds het basisjaar wonen of werken is gealloceerd; het basisjaar heeft die niet."
{
	parameter<String>    Zichtjaar_name;
	//

	unit<UInt32>         Regio := =/ModelParameters/Advanced/IndicatorRegio_path;

	container Wonen
	{
		attribute<Bool>      HeeftWoningen   (AdminDomain) := ThisYear/Stand/Aantal_Woningen_Totaal > 0[Woning], Descr = "Een cel met woningen in de stand, ook als dat minder dan een hele woning is.";
		attribute<Woning_ha> Per_AdminDomain (AdminDomain) := HeeftWoningen ? ThisYear/Stand/Aantal_Woningen_Totaal / AdminDomain/NrHaPerCell : null_f[Woning_ha], Descr = "De woningen per hectare in een cel met woningen, leeg elders.";
		parameter<Woning_ha> Per_NL                        := mean(Per_AdminDomain);
		attribute<Woning_ha> Per_Regio       (Regio)       := mean(Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
	}
	
	container Werken
	: Descr = "De dichtheid van werken in de hele voorraad: per cel met banen de banen en de pandvoetafdruk per hectare en de banen per vierkante meter voetafdruk, en per regio en landelijk het gemiddelde daarvan over die cellen (#439). Een zichtjaar heeft daarnaast in Dichtheid/Werken de dichtheid van de nieuwbouw."
	{
		attribute<Bool> MeerDanEenBaan (AdminDomain) := Banen_ha/Banen_Totaal > 0[Job];
		
		container Banen_ha
		{
			attribute<Job> Banen_Totaal (AdminDomain) := ThisYear/Stand/Aantal_Banen_Totaal
			{
				attribute<Job> WaarMeerDanEenBaan (AdminDomain) := . / float32(MeerDanEenBaan);
			}
			
			attribute<Job_ha> Per_AdminDomain (AdminDomain) := Banen_Totaal/WaarMeerDanEenBaan / (float32(MeerDanEenBaan) * AdminDomain/NrHaPerCell);
			
			parameter <Job_ha> Per_NL := mean(Per_AdminDomain);
			
			attribute<Job_ha> Per_Regio (Regio) := mean(Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
		}
		
		container PandFootprint_ha
		{
			attribute<meter2> m2PandFootprint_Totaal (AdminDomain) := ThisYear/Stand/m2PandFootprint_Totaal
			{
				attribute<meter2> WaarMeerDanEenBaan (AdminDomain) := . / float32(MeerDanEenBaan);
			}
			
			attribute<m2_ha> Per_AdminDomain (AdminDomain) := m2PandFootprint_Totaal/WaarMeerDanEenBaan / (float32(MeerDanEenBaan) * AdminDomain/NrHaPerCell);
			
			parameter <m2_ha> Per_NL := mean(Per_AdminDomain);
			
			attribute<m2_ha> Per_Regio (Regio) := mean(Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
		}
		
		container Banen_m2
		{
			attribute<job_m2PandFootprint> Per_AdminDomain (AdminDomain) := Banen_ha/Banen_Totaal/WaarMeerDanEenBaan / PandFootprint_ha/m2PandFootprint_Totaal/WaarMeerDanEenBaan;
			
			parameter <job_m2PandFootprint> Per_NL := mean(Per_AdminDomain);
			
			attribute<job_m2PandFootprint> Per_Regio (Regio) := mean(Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
		}
	}
}
