////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De claimrealisatie per allocatieregio en voor Nederland: de stand gedeeld door de claim. InDezeStudie, die de
// controles en de indicatoren lezen, deelt door het grootste van de claim en de stand van het basisjaar, zodat een
// claim onder de basisjaarstand niet als overrealisatie verschijnt (#666). Claim_realisatie geeft de verhouding
// tot de claim van het zichtjaar zelf.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container ClaimRealisatie : using = "Impl"
{
	container Per_AllocRegio := 
		for_each_ne(
			ModelParameters/SectorAllocRegio/Uq_AllocRegios/AllocRegio_name
			, 'ClaimRealisatie_T('+quote(ModelParameters/SectorAllocRegio/Uq_AllocRegios/AllocRegio_name)+','+quote(ModelParameters/SectorAllocRegio/Uq_AllocRegios/AllocRegio_path)+', StandKeuze)'
		)
	{
		container Nederland := ClaimRealisatie_T('NL', 'RegioIndelingen/NL', StandKeuze);
	}
	
	container CheckNL :=
		for_each_nedv(
			  Classifications/Actor/Jobs6/name
			, replace('union_data(Classifications/Time/Zichtjaar, '+AsList('ThisCasus/Zichtjaren/'+Classifications/Time/Zichtjaar/name+'/ClaimRealisatie/Per_AllocRegio/Nederland/Claim_realisatie/Werken/@SS@',',')+')', '@SS@', Classifications/Actor/Jobs6/name)
			, Classifications/Time/Zichtjaar 
			, float32
		);
	
	
	Template ClaimRealisatie_T
	{
		//
		parameter<String> ClaimRegio_name;
		parameter<String> ClaimRegio_path;
		container         StandKeuze;
		//
		
		unit<UInt32> ClaimRegio   := =ClaimRegio_path;
		
		parameter<Bool> HeeftTigrisClaim        := ='ThisYear/Impl/Claims/AllocRegios/'+ClaimRegio_name+'/IsTigrisRegio'
		, Descr = "Heeft deze regio-indeling een claim voor wonen en werken? Alleen de TIGRIS-indelingen, zie IsTigrisRegio in de claims.";
		parameter<Bool> HeeftWaterbergingsclaim := ='ThisYear/Impl/Claims/AllocRegios/'+ClaimRegio_name+'/HeeftWaterbergingsopgave'
		, Descr = "Heeft deze regio-indeling een waterbergingsopgave? Alleen de indeling waarop het model waterberging alloceert.";
		parameter<Bool> MetWonen                := HeeftTigrisClaim && /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector;
		parameter<Bool> MetWerken               := HeeftTigrisClaim && /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector;
		
		unit<UInt8> Claims_sub := select_with_attr_by_cond(StandVar/Claims_sub
		                       , lowercase(StandVar/Claims_sub/Sector_name) == 'waterberging' ? HeeftWaterbergingsclaim
		                       : lowercase(StandVar/Claims_sub/Sector_name) == 'wonen' || lowercase(StandVar/Claims_sub/Sector_name) == 'werken' ? HeeftTigrisClaim
		                       : TRUE)
		, Descr = "De standvariabelen met een claim op deze regio-indeling: een deelverzameling van StandVar/Claims_sub (pbl-nl/model-RSopen#53).";
		unit<UInt8> WonenHier  := select_with_attr_by_cond(Classifications/Vastgoed/WP2xVSSH, const(MetWonen, Classifications/Vastgoed/WP2xVSSH)), Descr = "De woningtypen, of geen als deze indeling geen woonclaim heeft.";
		unit<UInt8> WerkenHier := select_with_attr_by_cond(Classifications/Actor/Jobs6, const(MetWerken, Classifications/Actor/Jobs6)), Descr = "De werksectoren, of geen als deze indeling geen banenclaim heeft.";
		
		container Impl := ThisYear/Impl
		{
			container Claims := // Voor het gemak pakken we hier voor elke sector de nationale claim, om te checken of deze uiteindelijk ergens wordt gealloceerd (de vraag tav claimrealisatie in in evt kleinere AllocRegio'sblijft dus over)
				for_each_nedvn(
					Claims_sub/name,
					'ThisYear/Impl/Claims/AllocRegios/'+ClaimRegio_name+'/'+Claims_sub/path
					, ClaimRegio
					, Claims_sub
					, Claims_sub/unit_name
				)
			{
				attribute<Woning> Aantal_Woningen_Totaal (ClaimRegio) := = MetWonen  ? 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Wonen/Subsector/StandVar_name)+')' : 'const(null_f[Woning], ClaimRegio)';
				attribute<Job>    Banen_Totaal           (ClaimRegio) := = MetWerken ? 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Werken/Subsector/StandVar_name)+')' : 'const(null_f[Job], ClaimRegio)';
			}
			
			container MinClaims :=  // /VariantData/Claims/Y2050/AllocRegios/Provincie/Landbouw_min
				for_each_nedvn(
					Claims_sub/name
					, Claims_sub/IsLandbouw 
						? 'ThisYear/Impl/Claims/AllocRegios/'+ClaimRegio_name+'/Landbouw/MinClaims/'+Claims_sub/Subsector_name 
						: 'min_elem(Claims/'+Claims_sub/name+', sum(StandKeuze/'+Claims_sub/name+', ClaimRegio/Per_AdminDomain))'
					, ClaimRegio
					, Claims_sub
					, Claims_sub/unit_name
				), Descr = "Per sector met een claim het kleinste van de claim van dit zichtjaar en de stand van het basisjaar in de regio; voor landbouw de minimumclaim van de variant."
			{
				attribute<Woning> Aantal_Woningen_Totaal (ClaimRegio) := = MetWonen  ? 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Wonen/Subsector/StandVar_name)+')' : 'const(null_f[Woning], ClaimRegio)';
				attribute<Job>    Banen_Totaal           (ClaimRegio) := = MetWerken ? 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Werken/Subsector/StandVar_name)+')' : 'const(null_f[Job], ClaimRegio)';
			}
			
			container MaxClaims := 
				for_each_nedvn(
					Claims_sub/name
					, Claims_sub/IsLandbouw 
						? 'ThisYear/Impl/Claims/AllocRegios/'+ClaimRegio_name+'/Landbouw/MaxClaims/'+Claims_sub/Subsector_name 
						: '	max_elem(Claims/'+Claims_sub/name+', sum(StandKeuze/'+Claims_sub/name+', ClaimRegio/Per_AdminDomain))'
					, ClaimRegio
					, Claims_sub
					, Claims_sub/unit_name
				), Descr = "Per sector met een claim het grootste van de claim van dit zichtjaar en de stand van het basisjaar in de regio; voor landbouw de maximumclaim van de variant."
			{
				attribute<Woning> Aantal_Woningen_Totaal (ClaimRegio) := = MetWonen  ? 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Wonen/Subsector/StandVar_name)+')' : 'const(null_f[Woning], ClaimRegio)';
				attribute<Job>    Banen_Totaal           (ClaimRegio) := = MetWerken ? 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Werken/Subsector/StandVar_name)+')' : 'const(null_f[Job], ClaimRegio)';
			}
			
			container Stand_PerAllocRegio := 
				for_each_nedvn(
					StandVar/Alloc_sub/name
					, 'sum(ThisYear/Stand/'+StandVar/Alloc_sub/name+', ClaimRegio/Per_AdminDomain)'
					, ClaimRegio
					, StandVar/Alloc_sub
					, StandVar/Alloc_sub/unit_name
				)
			{
				attribute<Woning> Aantal_Woningen_Totaal (ClaimRegio) := = 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Wonen/Subsector/StandVar_name)+')';
				attribute<Job>    Banen_Totaal           (ClaimRegio) := = 'add('+AsItemList(Classifications/Actor/Sector/xSubsectoren/Werken/Subsector/StandVar_name)+')';
			}
			
			// container Claims_oke := 
				// for_each_nedv(
					// StandVar/Claims_sub/name
					// , 'Stand_PerAllocRegio/'+StandVar/Claims_sub/name+' >= MinClaims/'+StandVar/Claims_sub/name+' && Stand_PerAllocRegio/'+StandVar/Claims_sub/name+' <= MaxClaims/'+StandVar/Claims_sub/name
					// , ClaimRegio
					// , bool
				// );
		} 
		
		container    InDezeStudie := MaxClaim_realisatie
		, Descr = "De claimrealisatie die de controles in Diagnose en de indicatoren lezen. Het model sloopt niet om een claim onder de stand van het basisjaar te halen, dus een regio waar de claim daaronder ligt komt hier op 1 uit in plaats van op een schijnbare overrealisatie (#666).";
		
		container MinClaim_realisatie := 
			for_each_nedv(
				Claims_sub/name
				, 'Impl/Stand_PerAllocRegio/'+Claims_sub/name+' / Impl/MinClaims/'+Claims_sub/name
				, ClaimRegio
				, float32
			), Descr = "De stand gedeeld door MinClaims: het kleinste van de claim van dit zichtjaar en de stand van het basisjaar, voor landbouw de minimumclaim; alleen bij minimumclaims informatief."
		{
			attribute<String>  name                   (ClaimRegio) := ClaimRegio/name;
			attribute<float32> Aantal_Woningen_Totaal (ClaimRegio) := Impl/Stand_PerAllocRegio/Aantal_Woningen_Totaal / Impl/MinClaims/Aantal_Woningen_Totaal;
			attribute<float32> Banen_Totaal           (ClaimRegio) := Impl/Stand_PerAllocRegio/Banen_Totaal / Impl/MinClaims/Banen_Totaal;
		}
		
		container MaxClaim_realisatie :=
			for_each_nedv(
				Claims_sub/name
				, 'Impl/Stand_PerAllocRegio/'+Claims_sub/name+' / Impl/MaxClaims/'+Claims_sub/name
				, ClaimRegio
				, float32
			), Descr = "De stand gedeeld door MaxClaims: het grootste van de claim van dit zichtjaar en de stand van het basisjaar, voor landbouw de maximumclaim. Een claim onder de basisjaarstand telt zo niet als overrealisatie; het is niet de hoogste claim over de zichtjaren (#666)."
		{
			attribute<String>  name                   (ClaimRegio) := ClaimRegio/name;
			attribute<float32> Aantal_Woningen_Totaal (ClaimRegio) := Impl/Stand_PerAllocRegio/Aantal_Woningen_Totaal / Impl/MaxClaims/Aantal_Woningen_Totaal;
			attribute<float32> Banen_Totaal           (ClaimRegio) := Impl/Stand_PerAllocRegio/Banen_Totaal / Impl/MaxClaims/Banen_Totaal;
			
			container Deltas
			{
				attribute<float32> Claim_Aantal_Woningen_Totaal (ClaimRegio) := impl/MaxClaims/Aantal_Woningen_Totaal - sum(StandKeuze/Aantal_Woningen_Totaal, ClaimRegio/Per_AdminDomain);
				attribute<float32> Claim_Banen_Totaal (ClaimRegio) := impl/MaxClaims/Banen_Totaal           - sum(StandKeuze/Aantal_Banen_Totaal, ClaimRegio/Per_AdminDomain);
				
				attribute<float32> Alloc_Aantal_Woningen_Totaal (ClaimRegio) := Impl/Stand_PerAllocRegio/Aantal_Woningen_Totaal - sum(StandKeuze/Aantal_Woningen_Totaal, ClaimRegio/Per_AdminDomain);
				attribute<float32> AllocBanen_Totaal  (ClaimRegio) := Impl/Stand_PerAllocRegio/Banen_Totaal           - sum(StandKeuze/Aantal_Banen_Totaal, ClaimRegio/Per_AdminDomain);
				
				attribute<float32> Onderrealisatie_Aantal_Woningen_Totaal_absoluut (ClaimRegio) := Claim_Aantal_Woningen_Totaal - Alloc_Aantal_Woningen_Totaal;
				attribute<float32> Onderrealisatie_Banen_Totaal_absoluut (ClaimRegio) := Claim_Banen_Totaal - AllocBanen_Totaal;
				
				attribute<float32> Onderrealisatie_Aantal_Woningen_Totaal_relatief (ClaimRegio) := Onderrealisatie_Aantal_Woningen_Totaal_absoluut / Claim_Aantal_Woningen_Totaal;
				attribute<float32> Onderrealisatie_Banen_Totaal_relatief (ClaimRegio) := Onderrealisatie_Banen_Totaal_absoluut / Claim_Banen_Totaal;
			}
			
		}
		
		container Claim_realisatie
		: Descr = "De stand gedeeld door de claim van dit zichtjaar, per woningtype, werksector en verblijfsrecreatie. Waar de claim onder de stand van het basisjaar ligt komt deze verhouding boven 1 zonder dat het model te veel bouwt; de controles lezen daarom InDezeStudie."
		{
			container Wonen	:= 
				for_each_nedv(
					WonenHier/name
					, 'Impl/Stand_PerAllocRegio/Aantal_Woningen_'+WonenHier/name+' / Impl/Claims/Aantal_Woningen_'+WonenHier/name
					, ClaimRegio
					, float32
				)
			{
				attribute<float32> Totaal (ClaimRegio) := Impl/Stand_PerAllocRegio/Aantal_Woningen_Totaal / Impl/Claims/Aantal_Woningen_Totaal;
			}
			
			container Werken := 
				for_each_nedv(
					WerkenHier/name
					, 'Impl/Stand_PerAllocRegio/Banen_'+WerkenHier/name+' / Impl/Claims/Banen_'+WerkenHier/name
					, ClaimRegio
					, float32
				)
			{
				attribute<float32> Totaal (ClaimRegio) := Impl/Stand_PerAllocRegio/Banen_Totaal / Impl/Claims/Banen_Totaal;
			}
			
			// container         Verblijfsrecreatie :=
				// for_each_nedv(
					// Classifications/Actor/VerblijfsrecreatieK/Sector_name
					// , lowercase(ClaimRegio_name) == lowercase('NL')
						// ? 'Impl/Stand_PerAllocRegio/Objecten_'+Classifications/Actor/VerblijfsrecreatieK/Sector_name+' / Impl/Claims/Verblijfsrecreatie_NL'
						// : 'Impl/Stand_PerAllocRegio/Objecten_'+Classifications/Actor/VerblijfsrecreatieK/Sector_name+' / Impl/Claims/Objecten_'+Classifications/Actor/VerblijfsrecreatieK/Sector_name
					// , ClaimRegio
					// , float32
				// );
				
			parameter<String> All                := 'Ready', ExplicitSuppliers = "=asList('Wonen/'+WonenHier/name, ';')+(MetWonen && MetWerken ? ';' : '')+asList('Werken/'+WerkenHier/name, ';')";
			
			// container Wind := 
				// for_each_nedv(
					// Classifications/Actor/WindK/Sector_name
					// , 'Stand_PerAllocRegio/Vermogen_'+Classifications/Actor/WindK/Sector_name+' / Claims/Vermogen_'+Classifications/Actor/WindK/Sector_name
					// , ClaimRegio
					// , float32
				// );
			
			// container Zon := 
				// for_each_nedv(
					// Classifications/Actor/ZonK/Sector_name
					// , 'Stand_PerAllocRegio/Vermogen_'+Classifications/Actor/ZonK/Sector_name+' / Claims/Vermogen_'+Classifications/Actor/ZonK/Sector_name
					// , ClaimRegio
					// , float32
				// );
		}
	}
}