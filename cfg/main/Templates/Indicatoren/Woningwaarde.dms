////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Kosten/waarde-indicatoren rond wonen:
//  - Woningwaarde  (#482): marktwaarde van de gealloceerde nieuwbouw per cel, uit de wonen-suitability.
//  - Uitkoopkosten (#520): vastgoedwaarde van de woningen die gesloopt worden door exogeen opgelegde nieuwe natuur (#519).
//  - Sloopkosten   (#549): sloopkosten van diezelfde woningen.
// Hergebruikt bestaande bouwstenen: WaardeNabijheidGroen/Nieuwbouw (P_nieuwbouw, cumulatieve nieuwbouw),
// SloopAlsGevolgVanExogeneOplegging (welke cellen leeggemaakt worden), en de wonen-suitability
// (Verwervingskosten = vastgoedwaarde bestaande voorraad, Sloopkosten = sloopkost bestaande voorraad).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Woningwaarde
: Descr = "Issue #482: marktwaarde (opbrengsten) van de in deze cel gealloceerde nieuwbouw, uit de wonen-suitability (hedonische nieuwbouwprijs per gealloceerde OP maal de cumulatieve nieuwbouw t.o.v. het basisjaar)."
{
	attribute<Eur> Nieuwbouw (AdminDomain) := MakeDefined(WaardeNabijheidGroen/Nieuwbouw/P_nieuwbouw * WaardeNabijheidGroen/Nieuwbouw/n_nieuwbouw_cumulatief, 0[Eur])
		, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Woningwaarde_Nieuwbouw_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
		, StorageType = "gdalwrite.grid"
		, Descr = "P_nieuwbouw (Eur/woning, gealloceerde OP via Stand/OP_rel) maal cumulatieve nieuwbouw (Stand - basisjaar). Geen aparte herberekening: P_nieuwbouw en n_nieuwbouw_cumulatief komen uit WaardeNabijheidGroen/Nieuwbouw.";
}

// Kosten van de sloop die volgt uit exogeen opgelegde nieuwe natuur (#519). Beide indicatoren maskeren een bestaande per-cel kostenkaart (uit de wonen-suitability) met de cellen die door de oplegging leeggemaakt worden.
container UitkoopEnSloopkostenNieuweNatuur
: Descr = "Issues #520 (uitkoopkosten) en #549 (sloopkosten) van de woningen die gesloopt worden als gevolg van exogeen opgelegde nieuwe natuur (#519)."
{
	attribute<Bool> IsExogeneSloopCel (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, SloopAlsGevolgVanExogeneOplegging/NeedsToBeEmptiedDueToExogenousDevelopments), FALSE)
	, Descr = "Cel die door exogeen opgelegde ontwikkeling (nieuwe natuur) wordt leeggemaakt; bestaande woningen worden daar gesloopt.";

	attribute<Eur>  Uitkoopkosten     (AdminDomain) := IsExogeneSloopCel ? MakeDefined(/BaseData/Suitabilities/Wonen/Verwervingskosten/Woningen/Totaal, 0[Eur]) : 0[Eur]
	, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Uitkoopkosten_NieuweNatuur_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	, StorageType = "gdalwrite.grid"
	, Descr = "Issue #520: vastgoedwaarde (verwervingskosten) van de bestaande woningen in de leeggemaakte cellen.";
	 
	attribute<Eur>  Sloopkosten       (AdminDomain) := IsExogeneSloopCel ? MakeDefined(/BaseData/Suitabilities/Wonen/Sloopkosten/Totaal, 0[Eur]) : 0[Eur]
	, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Sloopkosten_NieuweNatuur_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
	, StorageType = "gdalwrite.grid"
	, Descr = "Issue #549: sloopkosten (m2 per WP4 maal eenheidskost) van de bestaande woningen in de leeggemaakte cellen.";
}