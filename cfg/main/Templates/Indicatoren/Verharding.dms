////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Src, Wonen, Werken, Verblijfsrecreatie, PerModelType_Basisjaar, Mean_PerRegion_Basisjaar,
// Verharding_PerModelType, Verharding_AllowedToChanged_PerModelType, VerhardingOfChanged_PerModelType.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Verharding
{
	unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;
	
	container Src := ThisCasus/Basisjaar/Verharding;
	
	container Wonen
	{
		parameter<float32> FractieVerhard                                               := min_elem(ModelParameters/Wonen/DefaultVerharding * VariantParameters/VariantK/VerhardingTovDefault[Variant_rel], 1f);
	
		unit<UInt8>        OP                                                           := Impl/StandVar/OP;
		attribute<OP>      OP_rel                                         (AdminDomain) := Stand/OP_rel;
		attribute<Bool>    AllocatieHeeftPlaatsgevonden                   (AdminDomain) := Stand/Sector_rel == Actor/Sector/V/Wonen;
		attribute<Bool>    IsBAGnieuwbouwWonen                            (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantAllocatie/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/IsBAGnieuwbouwWonen), FALSE), Descr = "BAG-nieuwbouw wonen-cel, onafhankelijk van OP_rel (issue #550: BAG-cellen hebben nu een gematchte OP_rel, dus IsNull(OP_rel) volstaat niet meer).";
		attribute<Bool>    BAGNieuwbouwAllocatieHeeftPlaatsgevonden       (AdminDomain) := AllocatieHeeftPlaatsgevonden && (IsNull(OP_rel) || IsBAGnieuwbouwWonen);
		attribute<meter2>  Verhard_NB                                     (AdminDomain) := ='VariantParameters/Ontwikkelpakketten/'+VariantParameters/VariantK/OPScaleRef[Variant_rel]+'/PerVariant/'+Variant_name+'/InDezeBuurt/Terreinoppervlakte/Totaal/GebouwVoetafdrukPlusVerhard[OP_rel] * AdminDomain/NrHaPerCell[float32]';
		attribute<meter2>  Verhard_NieuweOntwikkeling                     (AdminDomain) := BAGNieuwbouwAllocatieHeeftPlaatsgevonden
																							? min_elem(AdminDomain/NrHaPerCell[meter2], (Stand/PandFootprint_Wonen + (AdminDomain/NrHaPerCell[meter2] - Stand/PandFootprint_Wonen) * FractieVerhard) / float32(AllocatieHeeftPlaatsgevonden)) / float32(AllocatieHeeftPlaatsgevonden)
																							: Verhard_NB;
		// attribute<meter2>  Verhard                                       (AdminDomain) := AdminDomain/IsStudyArea ? MakeDefined(Verhard_NieuweOntwikkeling, src/result) : null_f;
		attribute<float32> Verharding                                    (AdminDomain) := Verhard_NieuweOntwikkeling / AdminDomain/NrMeter2PerCell;
	}		

	
	container Werken
	{
		attribute<Bool>    AllocatieHeeftPlaatsgevonden (AdminDomain) := Impl/StandVar/Subsector/Sector_rel[Stand/SubSector_rel] == /Classifications/Actor/Sector/V/Werken;
		attribute<meter2>  Verhard0                     (AdminDomain) := Stand/PandFootprint_Werken + (AdminDomain/NrHaPerCell[meter2] - Stand/PandFootprint_Werken) * VariantParameters/FractiesGroenInWerken/Default/Verhard / float32(AllocatieHeeftPlaatsgevonden);
		attribute<meter2>  Verhard                      (AdminDomain) := min_elem(AdminDomain/NrHaPerCell[meter2], Verhard0) / float32(AllocatieHeeftPlaatsgevonden);
		attribute<float32> Verharding                   (AdminDomain) := Verhard / AdminDomain/NrMeter2PerCell;
		parameter<m2_ha>   Per_NL                                     := sum(Verhard) / (sum_uint32(AllocatieHeeftPlaatsgevonden)[float32] * AdminDomain/NrHaPerCell);
		attribute<m2_ha>   Per_Regio                          (Regio) := sum(Verhard, Regio/Per_AdminDomain) / (sum_uint32(AllocatieHeeftPlaatsgevonden, Regio/Per_AdminDomain)[float32] * AdminDomain/NrHaPerCell);
	}
	
	container Verblijfsrecreatie
	{
		attribute<Bool>    AllocatieHeeftPlaatsgevonden (AdminDomain) := =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector 
																			? 'Impl/StandVar/Subsector/Sector_rel[Stand/SubSector_rel] == /Classifications/Actor/Sector/V/Verblijfsrecreatie'
																			: 'const(FALSE, AdminDomain)';
		attribute<meter2>  Verhard0                     (AdminDomain) := Stand/PandFootprint_Verblijfsrecreatie + (AdminDomain/NrHaPerCell[meter2] - Stand/PandFootprint_Verblijfsrecreatie) * VariantParameters/FractiesGroenInVerblijfsrecreatie/Default/Verhard / float32(AllocatieHeeftPlaatsgevonden);
		attribute<meter2>  Verhard                      (AdminDomain) := min_elem(AdminDomain/NrHaPerCell[meter2], Verhard0) / float32(AllocatieHeeftPlaatsgevonden);
		attribute<float32> Verharding                   (AdminDomain) :=  =ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector 
																			? 'Verhard / AdminDomain/NrMeter2PerCell'
																			: 'const(null_f, AdminDomain)';
		parameter<m2_ha>   Per_NL                                     := sum(Verhard) / (sum_uint32(AllocatieHeeftPlaatsgevonden)[float32] * AdminDomain/NrHaPerCell);
		attribute<m2_ha>   Per_Regio                          (Regio) := sum(Verhard, Regio/Per_AdminDomain) / (sum_uint32(AllocatieHeeftPlaatsgevonden, Regio/Per_AdminDomain)[float32] * AdminDomain/NrHaPerCell);
	}
	
	container PerModelType_Basisjaar :=
		for_each_nedv(
			LU_ModelType/Name
			,'ThisCasus/Basisjaar/Landgebruikskaart/Result_SA  == LU_ModelType/V/'+ string(LU_ModelType/name)+' ? Src/Result : null_f'
			, rdc_25m
			, float32
		);
	
	container Mean_PerRegion_Basisjaar := 
		for_each_nedv(
			LU_ModelType/Name
			,'MakeDefined(mean(PerModelType_Basisjaar/'+LU_ModelType/Name+', RegioIndelingen/NVM/per_AdminDomain)[RegioIndelingen/NVM/per_AdminDomain], 0[float32])'
			, rdc_25m
			, float32
		);
	
	parameter<string> output_domain_str := '25m'; //domain of input files
	
	attribute<LU_ModelType> LU          (rdc_25m) := Landgebruikskaart/Result_SA;
	attribute<bool>         IsChanged   (rdc_25m) := ThisCasus/Basisjaar/Landgebruikskaart/Result_SA != LU;
	
	attribute<float32> Basisjaarverharding (rdc_25m) := ='mean(src/Result, rdc_25m/rdc_'+output_domain_str+'_rel)'
	, Descr = "De waargenomen verharding van de cel in het basisjaar, uit de BGT aangevuld met Copernicus. Stond hieronder drie keer uitgeschreven en staat er nu een keer.";
	
	attribute<bool> BebouwingWijkt (rdc_25m) := Sloopmaskers/NieuweNatuur || Sloopmaskers/OverigeBouwstenen || Sloopmaskers/WaterbergingVeen
	, Descr = "Wordt de bestaande stand op deze cel geleegd? De drie sloopmaskers uit Sloopmaskers bij elkaar, dus precies de cellen die de uitkoop- en sloopindicatoren tellen (#658). Gebruikt in VerhardingOfChanged_PerModelType om te weten of een landgebruiksverandering de bebouwing raakt (#697).

				Het masker wijst meer aan dan alleen bebouwde cellen. Waar het model natuur of water oplegt wordt de stand geleegd, ook waar niets stond. Dat is hier geen bezwaar, want het klassegemiddelde geldt in die tak als plafond: op een cel die toch al minder verhard was dan zijn nieuwe klasse gebeurt er niets.

				Route OverigeBouwstenen komt zelden aan bod. Daar wordt wel gesloopt maar niets opgelegd, dus de cel houdt zijn landgebruiksklasse, is niet veranderd en valt hieronder in de eerste tak. Die cellen houden hun basisjaarverharding terwijl de bebouwing verdwijnt; #697 laat dat staan, omdat het gemiddelde van de ongewijzigde klasse de bebouwing nog steeds meetelt en dus geen beter antwoord geeft.";
	
	container Verharding_PerModelType := 
		for_each_nedv(
			LU_ModelType/Name
			, 'LU == LU_ModelType/v/'+LU_ModelType/Name+' 
					? mean(Mean_PerRegion_Basisjaar/'+LU_ModelType/Name+', rdc_25m/rdc_'+output_domain_str+'_rel) 
					: null_f'
			, rdc_25m
			, float32
		);
	
	container Verharding_AllowedToChanged_PerModelType :=
		for_each_nedv(
			LU_ModelType/Name
			, 'LU_ModelType/IsVerhard[LU_ModelType/V/'+LU_ModelType/Name+']
					? Verharding_PerModelType/'+LU_ModelType/Name+' 
					: 0[float32]'
			, rdc_25m
			, float32
		);
	
	container VerhardingOfChanged_PerModelType :=
		for_each_nedv(
			LU_ModelType/Name
			, 'IsChanged
				? (BebouwingWijkt
					? min_elem(Verharding_PerModelType/'+LU_ModelType/Name+', Basisjaarverharding)
					: max_elem(Verharding_AllowedToChanged_PerModelType/'+LU_ModelType/Name+', Basisjaarverharding))
				: Basisjaarverharding'
			, rdc_25m
			, float32
		)
	, Descr = "De verharding die bij het landgebruik van dit zichtjaar hoort, per klasse. Drie gevallen (#697), en de richting van het effect volgt in alle drie het mechanisme.

				De cel verandert niet van klasse: hij houdt zijn eigen waargenomen basisjaarverharding.

				De cel verandert en de bebouwing blijft staan: het maximum van de basisjaarverharding en de waarde die de nieuwe klasse toestaat. Verstedelijking legt verharding aan, dus langs deze tak kan de waarde alleen omhoog. Dat is de oude regel en daar is hij op zijn plaats: een klassewisseling die de bebouwing niet raakt hoort een cel met veel waargenomen verharding niet terug te zetten naar een laag klassegemiddelde.

				De cel verandert en de bebouwing wijkt: het minimum van de basisjaarverharding en het klassegemiddelde van de nieuwe klasse. Uitkoop en sloop nemen verharding weg en leggen er niets voor terug, dus langs deze tak kan de waarde alleen omlaag. Gemeten op 2026-08-27, zichtjaar 2040: het landelijk verharde oppervlak daalt met 10.327 ha in WLO_hoog_BAU en met 8.309 ha in WLO_hoog_NbSGenuanceerd, op ruim een half miljoen hectare, dus in beide gevallen ruim anderhalf procent.

				Het klassegemiddelde is hier een plafond en geen vervanging, en dat verschil is gemeten voordat het zo is opgeschreven. Als vervanging stijgt de landelijke verharding juist: plus 1.079 ha in BAU en plus 8.859 ha in NbSGenuanceerd. Het masker is namelijk niet alleen bebouwing. Waar natuur of water wordt opgelegd leegt het model de stand ook waar niets stond, en dat is verreweg het grootste deel. Voor die cellen is het gemiddelde van de bestaande natuur juist een verhoging, want dat draagt de paden, parkeerplaatsen en bezoekerscentra die nieuwe natuur op een akker niet heeft. Hoe meer nieuwe natuur een variant heeft, hoe sterker dat effect, en dat is precies de verkeerde volgorde.

				Tot #697 gold de tweede regel voor elke verandering. Een cel die voor natuur of water werd uitgekocht en gesloopt hield daardoor zijn basisjaarverharding: de toegestane waarde van een onverharde klasse is nul, en max_elem(0, basisjaar) is de basisjaar. Langs de landgebruiksroute kon de indicator dus wel omhoog en niet omlaag, terwijl de sloopkosten en de gesloopte woningen wel in de indicatoren verschenen.";
	
	attribute<float32> Verharding_LU_Change (rdc_25m) :=
		='merge(
			uint16(LU)
			, float32
			,'+AsItemList('VerhardingOfChanged_PerModelType/'+LU_ModelType/Name)+'
		)';
	
	attribute<float32> Result (rdc_25m) := switch(
		  case(Wonen/AllocatieHeeftPlaatsgevonden, Wonen/Verharding)
		, case(Werken/AllocatieHeeftPlaatsgevonden, Werken/Verharding)
		, case(Verblijfsrecreatie/AllocatieHeeftPlaatsgevonden, Verblijfsrecreatie/Verharding)
		, Verharding_LU_Change
	), StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Verharding_'+Zichtjaar_name+'_fractie_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
}
