// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Wonen, Werken.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Dichtheid
{
	unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;
	
	container Wonen
	{
		attribute<Bool> AllocatieHeeftPlaatsgevonden (AdminDomain) := Impl/StandVar/Subsector/Sector_rel[Stand/SubSector_rel] == /Classifications/Actor/Sector/V/Wonen;
		
		attribute<Woning> Aantal_Woningen_Totaal (AdminDomain) := Stand/Aantal_Woningen_Totaal
		{
			attribute<Woning> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := . / float32(AllocatieHeeftPlaatsgevonden);
		}
		
		attribute<Woning_ha> Per_AdminDomain (AdminDomain) := Aantal_Woningen_Totaal/WaarAllocatieHeeftPlaatsgevonden / (float32(AllocatieHeeftPlaatsgevonden) * AdminDomain/NrHaPerCell), StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWonen_'+Zichtjaar_name+'_WonHa_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";

		attribute<Woning_ha> Lees_Per_AdminDomain (AdminDomain) : StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWonen_'+Zichtjaar_name+'_WonHa_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<Woning_ha> Bron_Per_AdminDomain (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Per_AdminDomain' : 'Per_AdminDomain'
		, Descr = "Wat Per_NL en Per_Regio lezen: Per_AdminDomain zelf, of met ModelParameters/TabellenUitExport aan de tif die dat item schrijft (#824).";
		
		parameter <Woning_ha> Per_NL := mean(Bron_Per_AdminDomain);
		
		attribute<Woning_ha> Per_Regio (Regio) := mean(Bron_Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
	}
	
	container Werken
	{
		attribute<Bool> AllocatieHeeftPlaatsgevonden (AdminDomain) := Impl/StandVar/Subsector/Sector_rel[Stand/SubSector_rel] == /Classifications/Actor/Sector/V/Werken;
		
		container Banen_ha
		{
			attribute<Job> Banen_Totaal (AdminDomain) := Stand/Aantal_Banen_Totaal
			{
				attribute<Job> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := . / float32(AllocatieHeeftPlaatsgevonden);
			}
			
			attribute<Job_ha> Per_AdminDomain (AdminDomain) := Banen_Totaal/WaarAllocatieHeeftPlaatsgevonden / (float32(AllocatieHeeftPlaatsgevonden) * AdminDomain/NrHaPerCell), StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWerken_'+Zichtjaar_name+'_JobHa_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
			
			attribute<Job_ha> Lees_Per_AdminDomain (AdminDomain) : StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWerken_'+Zichtjaar_name+'_JobHa_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
			attribute<Job_ha> Bron_Per_AdminDomain (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Per_AdminDomain' : 'Per_AdminDomain'
			, Descr = "Wat Per_NL en Per_Regio lezen: Per_AdminDomain zelf, of met ModelParameters/TabellenUitExport aan de tif die dat item schrijft (#824).";
			
			parameter <Job_ha> Per_NL := mean(Bron_Per_AdminDomain);
			
			attribute<Job_ha> Per_Regio (Regio) := mean(Bron_Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
		}
		
		container PandFootprint_ha
		{
			attribute<meter2> m2PandFootprint_Totaal (AdminDomain) := Stand/m2PandFootprint_Totaal
			{
				attribute<meter2> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := . / float32(AllocatieHeeftPlaatsgevonden);
			}
			
			attribute<m2_ha> Per_AdminDomain (AdminDomain) := m2PandFootprint_Totaal/WaarAllocatieHeeftPlaatsgevonden / (float32(AllocatieHeeftPlaatsgevonden) * AdminDomain/NrHaPerCell), StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWerken_'+Zichtjaar_name+'_m2Ha_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
			
			attribute<m2_ha> Lees_Per_AdminDomain (AdminDomain) : StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWerken_'+Zichtjaar_name+'_m2Ha_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
			attribute<m2_ha> Bron_Per_AdminDomain (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Per_AdminDomain' : 'Per_AdminDomain'
			, Descr = "Wat Per_NL en Per_Regio lezen: Per_AdminDomain zelf, of met ModelParameters/TabellenUitExport aan de tif die dat item schrijft (#824).";
			
			parameter <m2_ha> Per_NL := mean(Bron_Per_AdminDomain);
			
			attribute<m2_ha> Per_Regio (Regio) := mean(Bron_Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
		}
		
		container Banen_m2
		{
			attribute<job_m2PandFootprint> Per_AdminDomain (AdminDomain) := Banen_ha/Banen_Totaal/WaarAllocatieHeeftPlaatsgevonden / PandFootprint_ha/m2PandFootprint_Totaal/WaarAllocatieHeeftPlaatsgevonden, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWerken_'+Zichtjaar_name+'_JobM2_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdalwrite.grid";
			
			attribute<job_m2PandFootprint> Lees_Per_AdminDomain (AdminDomain) : StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Dichtheid_NieuwWerken_'+Zichtjaar_name+'_JobM2_'+/ModelParameters/StudyArea+'.tif'", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
			attribute<job_m2PandFootprint> Bron_Per_AdminDomain (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Per_AdminDomain' : 'Per_AdminDomain'
			, Descr = "Wat Per_NL en Per_Regio lezen: Per_AdminDomain zelf, of met ModelParameters/TabellenUitExport aan de tif die dat item schrijft (#824).";
			
			parameter <job_m2PandFootprint> Per_NL := mean(Bron_Per_AdminDomain);
			
			attribute<job_m2PandFootprint> Per_Regio (Regio) := mean(Bron_Per_AdminDomain, Regio/Per_AdminDomain_Fijn);
		}
	}
}