////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het registratiesysteem SOMERS (Subsurface Organic Matter Emission RegistRation System) is ontwikkeld om de
// landelijke CO2-uitstoot reductie in het veenweidegebied jaarlijks bij te houden. Met SOMERS 2.0 zijn
// rekenregels opgesteld om de toekomstige uitstoot te bepalen onder gestandaardiseerde omstandigheden.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template SOMERS_CO2_T 
: using = "/Classifications/Landbouw;/SourceData/Landbouw/SOMERS"
, Descr = "Het registratiesysteem SOMERS (Subsurface Organic Matter Emission RegistRation System) is ontwikkeld om de landelijke CO2-uitstoot reductie in het veenweidegebied jaarlijks bij te houden. Met SOMERS 2.0 zijn rekenregels opgesteld om de toekomstige uitstoot te bepalen onder gestandaardiseerde omstandigheden."
, URL = "https://www.nobveenweiden.nl/bevindingen-rekenregels/"
{
	//
	parameter<String>  Zichtjaar_name;
	//
	
	parameter<Bool>      IsStartYear         := lowercase(Zichtjaar_name) == lowercase('Basisjaar');
	parameter<Int16>     PrevZichtjaar_value := rjoin(lowercase(Zichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name), /Classifications/Time/Zichtjaar/PrevYearRange_rel);
	parameter<Int16>     Zichtjaar_value     := rjoin(lowercase(Zichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name), /Classifications/Time/Zichtjaar/YearRange_rel);
	parameter<Bool>      IsFirstAllocYear    := rjoin(lowercase(Zichtjaar_name), lowercase(/Classifications/Time/Zichtjaar/name), /Classifications/Time/Zichtjaar/IsFirstZichtjaar);
	parameter<jaar>      Periode             := Zichtjaar_Value[jaar] - PrevZichtjaar_Value[jaar];

	// #758: brengt bouwen op veen de oxidatie tot stilstand? Deltares heeft op 03-09-2026 laten weten dat de maatregelen
	// die dat doen alleen in de NbS-varianten worden genomen. In BAU en BAU2 wordt er dus gebouwd zonder die inrichting
	// en loopt de oxidatie onder de nieuwbouw door. Tot #758 stopte zij in elke variant, wat neerkwam op de aanname dat
	// elke vorm van bebouwing de veenbodem afdekt; dezelfde tabel van Deltares geeft bestaand stedelijk veen juist wel
	// een emissiefactor, en die twee waren niet met elkaar te rijmen.
	parameter<Bool>      StedelijkeInrichtingStoptOxidatie := /VariantParameters/VariantK/IsNbS[Variant_rel]
	, Descr = "Stopt de oxidatie zodra een veenweideperceel in het model stedelijk wordt? Alleen in de NbS-varianten, waar de inrichting daarop is gericht.";
	
	container Verdiscontering := Templates/Verdiscontering_T(Zichtjaar_name)
	, Descr = "Netto contante waarde naar het basisjaar (#651). De emissiekosten zijn een jaarlijkse stroom over de periode sinds het vorige zichtjaar, dus hier telt Verdiscontering/PeriodeFactor: de som van de contantewaardefactoren over de jaren van die periode, elk met de eigen trap van de termijnstructuur.";
	
	container Uitstoot := Templates/SOMERS_PerHa_T(Zichtjaar_name)
	, Descr = "De uitstoot per hectare per jaar bij de drooglegging en infiltratiemaatregel van deze variant, met de percelen en hun rekenregel in Uitstoot/Huidige_Percelen. Een eigen sjabloon, omdat de landbouwgeschiktheid dezelfde uitstoot leest als de variant de CO2-kosten aan de boer doorberekent (#510).";
	
	container Emissies := for_each_ne(CO2/EmissieK/name, 'EmissieT('+quote(CO2/EmissieK/name)+')');
	
	container Kosten := for_each_ne(CO2/EmissieXPrijsK/name, 'EmissieXPrijsT('+string(id(CO2/EmissieXPrijsK))+'[CO2/EmissieXPrijsK])');

	container Waterbeheer
	: Descr = "De kosten van het waterbeheer bij de zomerdrooglegging van deze variant, voor de peiloptimalisatie (#852): het kental per meter drooglegging uit ModelParameters/Landbouw maal de drooglegging, op de veenweidepercelen die geen stedelijk gebied of water zijn geworden. PostAllocAnalyses/Landbouw/PeilOptimalisatie leest de NPV terug en trekt hem af van de NPV van de variant."
	{
		attribute<float32>       Drooglegging_m     (AdminDomain) := MakeDefined(Uitstoot/Huidige_Percelen/Zomerdrooglegging_m_perGrid, 0f), Descr = "De zomerdrooglegging van deze variant in meters, nul buiten de veenweidepercelen.";
		attribute<bool>          IsStedelijkOfWater (AdminDomain) :=
			   /Classifications/Actor/Sector/IsStedelijk[Stand/Sector_rel]
			|| /Classifications/Actor/Sector/IsWaterberging[Stand/Sector_rel]
			|| /Classifications/Grondgebruik/LandgebruikType/IsBebouwdeKlasse[Stand/Landgebruik_Type]
			|| /Classifications/Grondgebruik/LandgebruikType/IsWater[Stand/Landgebruik_Type]
		, Descr = "Stedelijk gebied of water in dit zichtjaar, dezelfde afbakening als IsStedelijk_Nu en IsWater_Nu in EmissieT. Daar valt het waterbeheer van de landbouw weg.";
		attribute<EUR_jaarlijks> Jaarlijks          (AdminDomain) := IsStedelijkOfWater ? 0[EUR_jaarlijks] : (/ModelParameters/Landbouw/Waterbeheerkosten_PerMeterDrooglegging * Drooglegging_m * AdminDomain/NrHaPerCell)[EUR_jaarlijks];
		parameter<string>        StorageStr         := IsStartYear
			? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/SOMERS_Waterbeheer_Kosten_EUR_NPV_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
			: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SOMERS_Waterbeheer_Kosten_EUR_NPV_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
		attribute<EUR>           NPV                (AdminDomain) := (Jaarlijks * Verdiscontering/PeriodeFactor)[EUR], StorageName = "=StorageStr", StorageType = "gdalwrite.grid"
		, Descr = "Contante waarde in het basisjaar van de waterbeheerkosten over de periode sinds het vorige zichtjaar, op dezelfde discontovoeten en peildatum als de CO2-kosten.";
		parameter<EUR>           NPV_StGebied       := sum(NPV);
	}
	
	container Lachgas
	: Descr = "De kosten van de lachgasuitstoot van deze variant, voor de peiloptimalisatie (#852): Lachgas_PerMeterWortelzone maal de wortelzone, in CO2-equivalenten met Lachgas_GWP, tegen de CO2-prijs van elk prijspad, op de veenweidepercelen die geen stedelijk gebied of water zijn. De wortelzone volgt het grondwater van de hydrologische levering van de variant, zoals in het proefschrift uit #852. SOMERS rekent alleen CO2. PostAllocAnalyses/Landbouw/PeilOptimalisatie leest de NPV per prijspad terug en trekt hem af van de NPV van de variant."
	{
		parameter<string>  Levering     := /VariantParameters/VariantK/Hydrologie_Levering[Variant_rel];
		parameter<string>  Pad          := Levering == 'NbSGenuanceerd' || Levering == 'WBS' ? '/BaseData/Water/Grondwaterstanden/'+Levering : '/SourceData/Water/Grondwaterstanden/'+Levering
		, Descr = "Waar de grondwaterstanden van deze levering staan, zoals Grondwaterstanden_pad in BaseData/Landbouw.";
		parameter<float32> Jaar         := IsStartYear ? float32(/ModelParameters/Model_StartYear) : float32(Zichtjaar_value);
		parameter<uint32>  i_boven      := min_elem(sum(uint32(float32(/Classifications/Landbouw/WWL_Zichtjaren/jaar) < Jaar)), uint32(#/Classifications/Landbouw/WWL_Zichtjaren) - 1u);
		parameter<uint32>  i_onder      := max_elem(i_boven, 1u) - 1u;
		parameter<float32> jr_onder     := float32(/Classifications/Landbouw/WWL_Zichtjaren/jaar[value(i_onder, /Classifications/Landbouw/WWL_Zichtjaren)]);
		parameter<float32> jr_boven     := float32(/Classifications/Landbouw/WWL_Zichtjaren/jaar[value(i_boven, /Classifications/Landbouw/WWL_Zichtjaren)]);
		parameter<float32> Gewicht      := jr_boven > jr_onder ? min_elem(max_elem((Jaar - jr_onder) / (jr_boven - jr_onder), 0f), 1f) : 1f
		, Descr = "Hoe zwaar het bovenste klimaatanker meetelt, lineair tussen de twee ankers die het zichtjaar omsluiten, zoals WWL_Gewicht in Templates/Landbouw/Suitability_T.";
		parameter<string>  Anker_Onder  := /Classifications/Landbouw/WWL_Zichtjaren/name[value(i_onder, /Classifications/Landbouw/WWL_Zichtjaren)];
		parameter<string>  Anker_Boven  := /Classifications/Landbouw/WWL_Zichtjaren/name[value(i_boven, /Classifications/Landbouw/WWL_Zichtjaren)];
		attribute<float32> GLG_Onder    (AdminDomain) := ='float32('+Pad+'/GLG_'+Anker_Onder+')';
		attribute<float32> GLG_Boven    (AdminDomain) := ='float32('+Pad+'/GLG_'+Anker_Boven+')';
		attribute<float32> GLG          (AdminDomain) := MakeDefined((1f - Gewicht) * GLG_Onder + Gewicht * GLG_Boven, MakeDefined(GLG_Onder, GLG_Boven))
		, Descr = "De GLG van dit zichtjaar in meters onder maaiveld; waar maar een anker een waarde heeft, die ene.";
		attribute<bool>    Opgelegd     (AdminDomain) := = Levering == 'NbSGenuanceerd' || Levering == 'WBS' ? 'MakeDefined('+Pad+'/Opgelegd, FALSE)' : 'const(FALSE, AdminDomain)'
		, Descr = "Legt de levering op deze cel een grondwaterstand op, zoals VernattingOpgelegd in BaseData/Landbouw?";
		attribute<float32> Wortelzone_m (AdminDomain) := IsDefined(GLG) ? (Opgelegd ? GLG : max_elem(GLG - /ModelParameters/Landbouw/Lachgas_GLG_Correctie_m, 0f)) : Waterbeheer/Drooglegging_m
		, Descr = "De wortelzone in meters: de GLG min Lachgas_GLG_Correctie_m, op een opgelegde stand de GLG zelf, en waar de levering geen GLG geeft de zomerdrooglegging.";
		attribute<kg_jaarlijks>  CO2eq_Jaarlijks    (AdminDomain) := Waterbeheer/IsStedelijkOfWater || !IsDefined(Veenweide_percelen/AdminDomain_rel) ? 0[kg_jaarlijks] : (/ModelParameters/Landbouw/Lachgas_PerMeterWortelzone * /ModelParameters/Landbouw/Lachgas_GWP * Wortelzone_m * AdminDomain/NrHaPerCell)[kg_jaarlijks]
		, Descr = "De lachgasuitstoot per cel in kg CO2-equivalent per jaar.";
		parameter<ton_jaarlijks> CO2eq_StGebied     := sum(CO2eq_Jaarlijks)[ton_jaarlijks];
		container                Kosten             := for_each_ne(CO2/PrijsK/name, 'LachgasXPrijsT('+string(id(CO2/PrijsK))+'[CO2/PrijsK])');
	}
	
	Template LachgasXPrijsT
	{
		//
		parameter<CO2/PrijsK> id;
		//
		
		parameter<string>  Prijs_name    := CO2/PrijsK/name[id];
		parameter<Eur_ton> Prijs         := = '/ModelParameters/Landbouw/CO2_Prijs/PerJaar/'+Prijs_name+'[value(uint32(Verdiscontering/Zichtjaar_value), /ModelParameters/Landbouw/CO2_Prijs/JaarK)]';
		attribute<Eur_ton> Prijs_PerJaar (Verdiscontering/Stroom/JaarK) := = '/ModelParameters/Landbouw/CO2_Prijs/PerJaar/'+Prijs_name+'[value(uint32(/ModelParameters/Model_StartYear) + uint32(Verdiscontering/Stroom/JaarK/Horizon / 1[jaar]), /ModelParameters/Landbouw/CO2_Prijs/JaarK)]';
		parameter<Eur_ton> Prijs_Contant := Verdiscontering/PeriodeFactor > 0[jaar] ? sum(Prijs_PerJaar * Verdiscontering/Stroom/JaarK/Factor) / (Verdiscontering/PeriodeFactor / 1[jaar]) : Prijs
		, Descr = "De contante prijs van dit prijspad over de periode sinds het vorige zichtjaar, zoals Prijs_Contant in EmissieXPrijsT.";
		
		parameter<string>  StorageStr    := IsStartYear
			? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/SOMERS_Lachgas_Kosten_EUR_'+Prijs_name+'_NPV_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
			: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SOMERS_Lachgas_Kosten_EUR_'+Prijs_name+'_NPV_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
		attribute<EUR>     NPV           (AdminDomain) := Lachgas/CO2eq_Jaarlijks[ton_jaarlijks] * Prijs_Contant * Verdiscontering/PeriodeFactor, StorageName = "=StorageStr", StorageType = "gdalwrite.grid"
		, Descr = "Contante waarde in het basisjaar van de lachgaskosten over de periode sinds het vorige zichtjaar, op dezelfde discontovoeten en peildatum als de CO2-kosten.";
		parameter<EUR>     NPV_StGebied  := sum(NPV);
	}

	Template EmissieT
	{
		//
		parameter<string> Emissie_name;
		//
		
		attribute<kg_ha_jaarlijks> PerHa (AdminDomain) := = 'Uitstoot/PerHa/'+Emissie_name
			, IntegrityCheck = "not(any(IsDefined(Veenweide_percelen/AdminDomain_rel) && IsNull(this)))"
			, Descr = "Als deze IntegrityCheck faalt, is er een cel met een veenweideperceel zonder emissiewaarde. Dat is precies wat issue #619 heeft opgelost, dus er is dan een nieuwe bron van nulls bijgekomen.";

		attribute<kg_jaarlijks>  Jaarlijks       (AdminDomain) := PerHa * AdminDomain/NrHaPerCell;
		parameter<ton_jaarlijks> Totaal_StGebied := sum(Jaarlijks)[ton_jaarlijks];
		
		// #751: de landgebruiksverandering uit de stand-administratie en niet meer uit de landgebruikskaart. Stedelijk is
		// een gealloceerde stedelijke sector, gealloceerde waterberging (op de kaart was dat via LU_ModelType/IsStedelijk
		// ook stedelijk) of een bebouwde klasse van het type; water is de watervlag van het type.
		attribute<bool> IsStedelijk_Nu (AdminDomain) :=
			   /Classifications/Actor/Sector/IsStedelijk[Stand/Sector_rel]
			|| /Classifications/Actor/Sector/IsWaterberging[Stand/Sector_rel]
			|| /Classifications/Grondgebruik/LandgebruikType/IsBebouwdeKlasse[Stand/Landgebruik_Type]
		, Descr = "Stedelijk in dit zichtjaar: een gealloceerde stedelijke sector, gealloceerde waterberging, of een bebouwde koolstofklasse van het type. Dezelfde afbakening als IsBebouwdNu in de koolstofindicator, plus de waterberging: die telde op de landgebruikskaart via LU_ModelType/IsStedelijk als stedelijk en blijft hier de oxidatie stoppen. Glastuinbouw valt erbuiten, IsBebouwdeKlasse sluit klasse 8 uit.";
		attribute<bool> IsWater_Nu (AdminDomain) := /Classifications/Grondgebruik/LandgebruikType/IsWater[Stand/Landgebruik_Type]
		, Descr = "Open water volgens het type in de stand.";

		attribute<kg_jaarlijks> NaLUC_SOMERS (AdminDomain) :=
			IsStedelijk_Nu
				? (StedelijkeInrichtingStoptOxidatie ? ModelParameters/Landbouw/CO2_Uitstoot_StedelijkGebruik * AdminDomain/NrHaPerCell : Jaarlijks)
				: IsWater_Nu
					? ModelParameters/Landbouw/CO2_Uitstoot_Water * AdminDomain/NrHaPerCell
					: Jaarlijks
		, Descr = "De emissie na de landgebruiksverandering van dit zichtjaar. Stedelijk gebied en water hebben geen veenemissie, met de uitzondering dat de stedelijke nul alleen in de NbS-varianten geldt
					(#758, zie StedelijkeInrichtingStoptOxidatie). De stedelijke tak is breder dan bebouwing: naast de stedelijke sectoren telt ook gealloceerde waterberging mee, waar hetzelfde antwoord uitkomt
					als via de watertak, maar langs een andere weg.";
		
		// SOMERS rekent met een constante jaarlijkse uitstoot op een veenlaag die nooit opraakt. Op de horizon tot 2120 is dat
		// niet onschuldig: in #733 bleef in BAU 96,1 van de 278,7 Mton CO2 ongedekt door de koolstofvoorraad, op 116.007 van de
		// 245.968 hectare veenweideperceel en vooral op moerige gronden waar de veendiktekaart geen veenpakket geeft. Deltares
		// meldde in #657 dat de terugkoppeling van uitputting in de dynamische berekening zit, maar niet in de statische
		// getallen die wij gebruiken. ModelParameters/Landbouw/SOMERS_BegrensdOpVoorraad kiest. Uit is de reeks zoals hij is
		// aangeleverd, en het verschil met wat de voorraad kon dragen staat dan in
		// CarbonStorageSequestration/Zichtjaar/Carbon/Stock/Ongedekt_Cumulatief_StGebied en de kaart Write_CO2Ongedekt_Cumulatief.
		// Aan stopt de uitstoot van een cel zodra hij de voorraad van het basisjaar heeft opgebruikt, zoals in het proefschrift
		// uit #852 de uitstoot stopt als het grondwater de onderkant van het veen bereikt.
		attribute<kg> Voorraad_Basisjaar (AdminDomain) := MakeDefined(CarbonStorageSequestration/BaseYear/CO2/Stock, 0[ton])[kg]
		, Descr = "De koolstofvoorraad van de cel in het basisjaar als CO2, beide pools: de bovenste 30 cm en de veenreserve daaronder. Het plafond voor de cumulatieve uitstoot als SOMERS_BegrensdOpVoorraad aan staat.";
		attribute<kg> Cumulatief_Vorig   (AdminDomain) := = IsFirstAllocYear || IsStartYear
			? 'const(0[kg], AdminDomain)'
			: 'PrevIndicatoren/SOMERS_CO2_Laagveen/Emissies/'+Emissie_name+'/Cumulatief_sindsStartyear'
		, Descr = "De uitstoot van deze cel tot en met het vorige zichtjaar, nul in het eerste allocatiezichtjaar.";
		attribute<kg_jaarlijks> Plafond (AdminDomain) := (max_elem(Voorraad_Basisjaar - Cumulatief_Vorig, 0[kg]) / Periode)[kg_jaarlijks]
		, Descr = "Wat er van de voorraad van het basisjaar over is, verdeeld over de periode: de hoogste jaarlijkse uitstoot die de cel nog kan dragen.";
		// Een vergelijking en geen min_elem: min_elem slaat een null over en zou zo buiten de veenweidepercelen, waar
		// NaLUC_SOMERS null is, het plafond als uitstoot geven. De vergelijking met een null is onwaar en laat de null staan.
		attribute<kg_jaarlijks> NaLUC (AdminDomain) := = /ModelParameters/Landbouw/SOMERS_BegrensdOpVoorraad && !IsStartYear
			? 'NaLUC_SOMERS > Plafond ? Plafond : NaLUC_SOMERS'
			: 'NaLUC_SOMERS'
		, Descr = "De emissie na de landgebruiksverandering, met SOMERS_BegrensdOpVoorraad aan begrensd op het Plafond. De kosten, de cumulatieve reeks en de koolstofindicator lezen dit item.";
		attribute<kg> Cumulatief_overZichtjaar  (AdminDomain) := NaLUC * Periode;
		attribute<kg> Cumulatief_sindsStartyear (AdminDomain) := = IsFirstAllocYear 
																		? 'Cumulatief_overZichtjaar'
																		: IsStartYear 
																			? 'Jaarlijks * 1[jaar]' 
																			: 'PrevIndicatoren/SOMERS_CO2_Laagveen/Emissies/'+Emissie_name+'/Cumulatief_sindsStartyear + Cumulatief_overZichtjaar';
		
		parameter<mton> Cumulatief_sindsStartyear_StGebied := sum(Cumulatief_sindsStartyear)[mton];

		parameter<string> StorageStr := IsStartYear 
			? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/SOMERS_CO2_Emissies_kg_'+Emissie_name+'_Cumulatief_sindsStartyear_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
			: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SOMERS_CO2_Emissies_kg_'+Emissie_name+'_Cumulatief_sindsStartyear_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
		
		attribute<kg>                   Write_Result_SA      (AdminDomain) := Geography/rdc_meter/IsStudyArea_AdminDomain ? Cumulatief_sindsStartyear : null_f, StorageName = "=StorageStr", StorageType = "gdalwrite.grid";
		// #824: de tabelkolom leest Bron_Cumulatief, dus met ModelParameters/TabellenUitExport aan de tif van Write_Result_SA en anders dat item zelf.
		attribute<kg>                   Lees_Cumulatief      (AdminDomain) : StorageName = "=StorageStr", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<kg>                   Bron_Cumulatief      (AdminDomain) := = /ModelParameters/TabellenUitExport ? 'Lees_Cumulatief' : 'Write_Result_SA';
	}
	
	Template EmissieXPrijsT
	{
		//
		parameter<CO2/EmissieXPrijsK> id;
		//
		
		parameter<string> Emissie_name := CO2/EmissieXPrijsK/Emissie_name[id];
		parameter<string> Prijs_name := CO2/EmissieXPrijsK/Prijs_name[id];
		parameter<Eur_ton> Prijs := = '/ModelParameters/Landbouw/CO2_Prijs/PerJaar/'+Prijs_name+'[value(uint32(Verdiscontering/Zichtjaar_value), /ModelParameters/Landbouw/CO2_Prijs/JaarK)]'
		, Descr = "De CO2-prijs van deze reeks in dit zichtjaar.";

		attribute<Eur_ton> Prijs_PerJaar (Verdiscontering/Stroom/JaarK) := = '/ModelParameters/Landbouw/CO2_Prijs/PerJaar/'+Prijs_name+'[value(uint32(/ModelParameters/Model_StartYear) + uint32(Verdiscontering/Stroom/JaarK/Horizon / 1[jaar]), /ModelParameters/Landbouw/CO2_Prijs/JaarK)]'
		, Descr = "De CO2-prijs van deze reeks in elk jaar van de periode sinds het vorige zichtjaar.";
		parameter<Eur_ton> Prijs_Contant := Verdiscontering/PeriodeFactor > 0[jaar] ? sum(Prijs_PerJaar * Verdiscontering/Stroom/JaarK/Factor) / (Verdiscontering/PeriodeFactor / 1[jaar]) : Prijs
		, Descr = "De prijs die, constant over de periode sinds het vorige zichtjaar, dezelfde contante waarde geeft als de prijs per jaar uit de reeks: het gemiddelde van de prijzen in die periode, gewogen met de contantewaardefactoren van hun jaar. In het basisjaar, zonder periode, de prijs van dat jaar.";

		attribute<EUR_jaarlijks> Jaarlijks (AdminDomain) := = 'Emissies/'+Emissie_name+'/NaLUC[ton_jaarlijks] * Prijs';

		parameter<string> StorageStr_kosten := IsStartYear
			? '%LocalDataProjDir%/Indicatoren/'+Zichtjaar_name+'/SOMERS_CO2_Kosten_EUR_'+Emissie_name+'_'+Prijs_name+'_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
			: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SOMERS_CO2_Kosten_EUR_'+Emissie_name+'_'+Prijs_name+'_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
		, Descr = "De kostenkaarten van deze emissie- en prijsvariant, met dezelfde twee takken als de emissiekaarten: het basisjaar in zijn eigen map, elk ander zichtjaar in de casusmap; @V@ is de grootheid, NPV of NCW_Cumulatief. Ze staan niet in de export; PostAllocAnalyses/PeilOptimalisatie leest de NPV op dit pad terug (#824).";

		attribute<EUR> NPV (AdminDomain) := NCW_DezePeriode, StorageName = "=replace(StorageStr_kosten, '@V@', 'NPV')", StorageType = "gdalwrite.grid"
		, Descr = "Contante waarde in het basisjaar van de emissiekosten over de periode sinds het vorige zichtjaar, op de MKBA-discontovoeten: dezelfde grootheid als NCW_DezePeriode, als kaart weggeschreven omdat PostAllocAnalyses/PeilOptimalisatie hem terugleest en tegen de NPV van de landbouw afzet, die op dezelfde voeten en dezelfde peildatum staat (#510).";

		parameter<EUR> NPV_StGebied := sum(NPV);

		// #651: de emissiekosten als maatschappelijke post, op de MKBA-discontovoeten en contant gemaakt naar het basisjaar. Een
		// jaarlijkse stroom, dus elk jaar van de periode krijgt zijn eigen factor en zijn eigen prijs, via Prijs_Contant. Cumulatief
		// optellen omdat de uitstoot van eerdere perioden niet verdwijnt; NPV hierboven telt alleen de lopende periode.
		parameter<string> Pad := CO2/EmissieXPrijsK/name[id];

		attribute<EUR> NCW_DezePeriode (AdminDomain) := = 'Emissies/'+Emissie_name+'/NaLUC[ton_jaarlijks] * Prijs_Contant * Verdiscontering/PeriodeFactor', Descr = "Contante waarde in het basisjaar van de emissiekosten over de periode sinds het vorige zichtjaar.";
		
		attribute<EUR> NCW_Cumulatief  (AdminDomain) := = IsStartYear || IsFirstAllocYear
			? 'NCW_DezePeriode'
			: 'NCW_DezePeriode + PrevIndicatoren/SOMERS_CO2_Laagveen/Kosten/'+Pad+'/NCW_Cumulatief'
		, StorageName = "=replace(StorageStr_kosten, '@V@', 'NCW_Cumulatief')"
		, StorageType = "gdalwrite.grid"
		, Descr = "Contante waarde in het basisjaar van alle emissiekosten vanaf het basisjaar tot en met dit zichtjaar.";
		
		parameter<EUR> NCW_Cumulatief_StGebied := sum(NCW_Cumulatief), Descr = "Landelijk totaal.";
	}
}
