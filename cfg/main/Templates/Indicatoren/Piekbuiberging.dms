// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Laadt via #include: Aanbod.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Piekbuiberging := Basisjaar/Piekbuiberging
, Descr = "Welk deel van de piekbuiopgave in bestaand bebouwd gebied wordt gedekt door blauw-groene maatregelen. De opgave ligt vast in het basisjaar; deze container voegt het aanbod van het zichtjaar toe en streept opgave en aanbod per blok tegen elkaar weg.

			Heette tot #720 Waterberging, en die naam draagt ook de sector Waterberging, die bergingsgebieden in het landelijk gebied alloceert op een seizoensopgave in m3 per maand voor juli (#575, #664). In de opleveringstabel stonden de twee onder bijna dezelfde kolomnaam naast elkaar. Ze meten ander water, op een andere plek, op een andere tijdschaal, en horen nooit bij elkaar opgeteld te worden. Cellen die aan de sector Waterberging zijn toegewezen leveren aan deze indicator per constructie nul; ToetsOplevering.ps1 bewaakt dat als harde toets."
{
	#include<Aanbod.dms> // Is extra tov bestaand aanbod (het aanbod achter de restopgave in basisjaar)

	container PerGrid
	{
		attribute<meter3> Opgave             (Grid) := Basisjaar/Piekbuiberging/PerGrid/Opgave, StorageName = "=replace(StorageStr_PerGrid, '@V@', 'Opgave')", StorageType = "gdalwrite.grid";
		attribute<meter3> AanbodOngemaskeerd (Grid) := ='sum(Piekbuiberging/Aanbod/Totaal, AdminDomain/rdc_'+Grid_ref+'_rel)'
		, Descr = "Alle bergingscapaciteit in het blok, ook die buiten bestaand bebouwd gebied. Staat er alleen om Aanbod en AanbodBuitenUrbanContour te kunnen optellen tot een controleerbaar geheel; de dekkingsgraad rekent met Aanbod.";
		attribute<meter3> Aanbod             (Grid) := ='sum(Piekbuiberging/Aanbod/Totaal * float32(BestaandBebouwdGebied), AdminDomain/rdc_'+Grid_ref+'_rel)'
		, StorageName = "=replace(StorageStr_PerGrid, '@V@', 'Aanbod')", StorageType = "gdalwrite.grid"
		, Descr = "De bergingscapaciteit in het blok die ligt waar ook opgave is, dus binnen bestaand bebouwd gebied.

					Deze maskering is er sinds #741. Tot dan telde het hele blokaanbod mee terwijl de opgave op celniveau op bestaand bebouwd gebied was gemaskeerd, en die asymmetrie liep in de tijd op: het model bouwt aan de stadsrand terwijl de begrenzing op het basisjaar bevroren staat. Op de standen van 1 september 2026 lag op Y2120 in NbSGenuanceerd 59,6 procent van het aanbod buiten de begrenzing, en kwam minstens 39,3 van de 185,3 mln m3 gedekte opgave aantoonbaar van buiten.

					Er hangt een gevolg aan dat expliciet hoort te staan: nieuwbouw die net buiten de basisjaarbegrenzing landt is in het zichtjaar wel degelijk stad en bergt daar echt water, maar levert in deze indicator noch opgave noch aanbod. Dat is de prijs van symmetrie zolang er geen dieptekaart is die met de stad meebeweegt; de kaart is een basisjaargrootheid op AHN2 uit 2007 tot 2012.";
		attribute<meter3> AanbodBuitenUrbanContour    (Grid) := AanbodOngemaskeerd - Aanbod
		, StorageName = "=replace(StorageStr_PerGrid, '@V@', 'AanbodBuitenUrbanContour')", StorageType = "gdalwrite.grid"
		, Descr = "De bergingscapaciteit die door de maskering van #741 uit de dekkingsgraad valt: aangelegd buiten de basisjaarbegrenzing van bebouwd gebied, waar deze indicator geen opgave kent. Als verschil geschreven en niet als eigen som, zodat de twee per constructie optellen tot AanbodOngemaskeerd, ook op cellen waar de begrenzing geen waarde heeft.";
		attribute<meter3> Restopgave         (Grid) := Opgave - Aanbod;
		attribute<meter3> Ongedekt           (Grid) := max_elem(Restopgave, 0[meter3]), StorageName = "=replace(StorageStr_PerGrid, '@V@', 'Ongedekt')", StorageType = "gdalwrite.grid";
		attribute<meter3> AanbodZonderOpgave (Grid) := max_elem(Aanbod - Opgave, 0[meter3])
		, StorageName = "=replace(StorageStr_PerGrid, '@V@', 'AanbodZonderOpgave')", StorageType = "gdalwrite.grid"
		, Descr = "Het aanbod dat in zijn eigen blok geen opgave tegenkomt en daarmee uit de dekkingsgraad valt. De klemming op nul een regel hoger laat overschot niet naar een naburig blok stromen, dus dit is bergingscapaciteit die wel wordt aangelegd en niet wordt meegeteld.

					In #720 was dit de grootste enkele post van de indicator: 176,0 van 361,3 mln m3 op Y2120 in NbSGenuanceerd, 48,7 procent van het aanbod. Met de maskering van #741 is er 0,777 mln m3 van over, 0,5 procent van het aanbod. Dat overschot was dus vrijwel geheel aanbod buiten bebouwd gebied dat in een randblok tegen een kleine opgave aanliep, en niet een echte overmaat aan berging op de plek van de opgave. Sinds de maskering ligt het aanbod vrijwel overal ruim onder de blokopgave en heeft de blokmaat nauwelijks nog greep op de uitkomst.";
		attribute<meter3> Gedekt             (Grid) := Opgave - Ongedekt;

		attribute<float32> Dekkingsgraad     (Grid) := Gedekt / Opgave;
	}

	// -- de bron van de aggregaties: levend, of teruggelezen uit de export (#824); zie KostenWoningbouw voor de opzet --
	// PerRegio en PerNL lezen de vijf blokposten en de drie kostenposten via Bron. Gedekt en de dekkingsgraden blijven
	// afgeleiden van die sommen. Restopgave staat in geen enkele tabel en leest nog PerGrid.
	parameter<string> StorageStr_PerGrid := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Piekbuiberging_PerGrid_@V@_'+Zichtjaar_name+'_m3_per'+Grid_ref+'_'+/ModelParameters/StudyArea+'.tif'
	, Descr = "De blokposten van PerGrid als kaart op de blokmaat Grid_ref (#824); @V@ is de post. De blokmaat staat in de naam om dezelfde reden als bij de exportkaarten van #720.";
	parameter<string> StorageStr_Kosten := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Piekbuiberging_Kosten_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif'
	, Descr = "De drie kostenposten van Kosten als kaart per cel (#824); @V@ is de post.";
	container Lees
	: Descr = "De posten van dit zichtjaar teruggelezen uit de tifs die de items hierboven schrijven, voor een tabelrun met ModelParameters/TabellenUitExport aan (#824). Dezelfde bestandsnamen als de schrijvers, dus een hernoeming daar hoort hier mee te gaan."
	{
		attribute<meter3> Opgave (Grid) : StorageName = "=replace(StorageStr_PerGrid, '@V@', 'Opgave')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<meter3> Aanbod (Grid) : StorageName = "=replace(StorageStr_PerGrid, '@V@', 'Aanbod')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<meter3> AanbodBuitenUrbanContour (Grid) : StorageName = "=replace(StorageStr_PerGrid, '@V@', 'AanbodBuitenUrbanContour')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<meter3> Ongedekt (Grid) : StorageName = "=replace(StorageStr_PerGrid, '@V@', 'Ongedekt')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<meter3> AanbodZonderOpgave (Grid) : StorageName = "=replace(StorageStr_PerGrid, '@V@', 'AanbodZonderOpgave')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<Eur> Aanleg (AdminDomain) : StorageName = "=replace(StorageStr_Kosten, '@V@', 'Aanleg')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<Eur_jaarlijks> OnderhoudPerJaar (AdminDomain) : StorageName = "=replace(StorageStr_Kosten, '@V@', 'OnderhoudPerJaar')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<Eur> Onderhoud_NCW (AdminDomain) : StorageName = "=replace(StorageStr_Kosten, '@V@', 'Onderhoud_NCW')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
	}
	container Live
	{
		attribute<meter3> Opgave (Grid) := PerGrid/Opgave;
		attribute<meter3> Aanbod (Grid) := PerGrid/Aanbod;
		attribute<meter3> AanbodBuitenUrbanContour (Grid) := PerGrid/AanbodBuitenUrbanContour;
		attribute<meter3> Ongedekt (Grid) := PerGrid/Ongedekt;
		attribute<meter3> AanbodZonderOpgave (Grid) := PerGrid/AanbodZonderOpgave;
		attribute<Eur> Aanleg (AdminDomain) := Kosten/Aanleg;
		attribute<Eur_jaarlijks> OnderhoudPerJaar (AdminDomain) := Kosten/OnderhoudPerJaar;
		attribute<Eur> Onderhoud_NCW (AdminDomain) := Kosten/Onderhoud_NCW;
	}
	container Bron := = /ModelParameters/TabellenUitExport ? 'Lees' : 'Live'
	, Descr = "Waar de aggregaties hun per-celposten vandaan halen: Live (berekend) of Lees (de export van dit zichtjaar teruggelezen), gestuurd door ModelParameters/TabellenUitExport (#824).";

	container PerRegio
	{
		unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path
		{
			attribute<.> Per_Grid (Grid) := ='modus(Regio/Per_AdminDomain_Fijn, AdminDomain/rdc_'+Grid_ref+'_rel)'
			, Descr = "Regio van het blok, als meest voorkomende regio van de onderliggende cellen. Tot #705 kwam dit uit poly2grid op de regiogeometrie; met modus volgt het blok altijd dezelfde kaart als de celaggregaties, en kan ook een indeling zonder geometry meedoen, zoals Landschap.";
		}

		attribute<Meter3> Opgave             (Regio) := sum(Bron/Opgave, Regio/Per_Grid);
		attribute<Meter3> Aanbod             (Regio) := sum(Bron/Aanbod, Regio/Per_Grid);
		attribute<Meter3> AanbodBuitenUrbanContour    (Regio) := sum(Bron/AanbodBuitenUrbanContour, Regio/Per_Grid);
		attribute<Meter3> Restopgave         (Regio) := sum(PerGrid/Restopgave, Regio/Per_Grid);
		attribute<Meter3> Ongedekt           (Regio) := sum(Bron/Ongedekt, Regio/Per_Grid);
		attribute<Meter3> AanbodZonderOpgave (Regio) := sum(Bron/AanbodZonderOpgave, Regio/Per_Grid);
		attribute<meter3> Gedekt             (Regio) := Opgave - Ongedekt;

		attribute<Eur>           Aanlegkosten           (Regio) := sum(Bron/Aanleg,           Regio/Per_AdminDomain_Fijn), Descr = "De aanlegkosten van alle bergingsmaatregelen die er in dit zichtjaar liggen (#798). Zie de container Kosten voor wat er wel en niet in zit.";
		attribute<Eur_jaarlijks> OnderhoudskostenPerJaar (Regio) := sum(Bron/OnderhoudPerJaar, Regio/Per_AdminDomain_Fijn);
		attribute<Eur>           Onderhoudskosten_NCW    (Regio) := sum(Bron/Onderhoud_NCW,    Regio/Per_AdminDomain_Fijn);
		
		attribute<float32> Dekkingsgraad           (Regio) := Gedekt / Opgave;
		attribute<float32> Dekkingsgraad_Ongeklemd (Regio) := min_elem(Aanbod, Opgave) / Opgave
		, Descr = "De dekkingsgraad die zou gelden als het aanbod binnen de regio vrij naar de opgave kon stromen, dus zonder de klemming per blok. Samen met Dekkingsgraad spant dit de bandbreedte op die de blokmaat oplevert: Dekkingsgraad is de ondergrens, waarbij berging alleen zijn eigen blok bedient, en Dekkingsgraad_Ongeklemd de bovengrens, waarbij berging de hele regio bedient. De waarheid ligt ertussen en hangt af van de afstand waarover een voorziening werkelijk water opvangt. Zie #720 en #741.

					Deze bandbreedte is niet louter een rapportagekeuze. De opgave komt uit een kaart met de maximaal opgetreden waterdiepte per cel, en die maxima treden niet op hetzelfde moment op. Landelijk maakt dat weinig uit, want in zes uur verlaat er nauwelijks water het gebied, dus de som van de maxima benadert de netto neerslag. Per blok maakt het wel uit: daar wordt een momentopname van de ene cel tegen die van de andere weggestreept. Hoe kleiner het blok, hoe zwaarder dat weegt. Zie de Descr van Grid_ref in Templates/Indicatoren_T/Basisjaar.dms.";
	}

	container PerNL
	{
		parameter<Meter3> Opgave             := sum(Bron/Opgave);
		parameter<Meter3> Aanbod             := sum(Bron/Aanbod);
		parameter<Meter3> AanbodBuitenUrbanContour    := sum(Bron/AanbodBuitenUrbanContour);
		parameter<Meter3> Restopgave         := sum(PerGrid/Restopgave);
		parameter<Meter3> Ongedekt           := sum(Bron/Ongedekt);
		parameter<Meter3> AanbodZonderOpgave := sum(Bron/AanbodZonderOpgave);
		parameter<meter3> Gedekt             := Opgave - Ongedekt;

		parameter<Eur>           Aanlegkosten           := sum(Bron/Aanleg);
		parameter<Eur_jaarlijks> OnderhoudskostenPerJaar := sum(Bron/OnderhoudPerJaar);
		parameter<Eur>           Onderhoudskosten_NCW    := sum(Bron/Onderhoud_NCW);
		
		parameter<float32> Dekkingsgraad           := Gedekt / Opgave;
		parameter<float32> Dekkingsgraad_Ongeklemd := min_elem(Aanbod, Opgave) / Opgave;
	}
	
	container Kosten
	: Descr = "Wat de bergingsmaatregelen kosten (#798). Aanleg en onderhoud staan los van elkaar en horen niet bij elkaar opgeteld te worden: aanleg is een eenmalige uitgave bij aanleg, onderhoud een bedrag per jaar.

				De aanlegkosten zijn een voorraadgrootheid, net als het aanbod hierboven: de kosten van alles wat er in dit zichtjaar ligt, en niet wat er in deze periode bij is gekomen. In bestaand gebied loopt dat mee met de opbouwfactor van #746, dus daar groeit de post ook zonder dat er iets wordt gealloceerd.

				De aanlegkosten van nieuwbouwwoningen zitten ook in het exploitatiesaldo en sturen dus de allocatie, zie ModelParameters/Piekbuiberging/KostenInExploitatiesaldo. Wat hier staat is ruimer: het telt ook bestaand gebied, werken en verblijfsrecreatie mee, en dat zijn plekken waar geen exploitatiesaldo aan te pas komt. De twee zijn dus geen kopie van elkaar en horen dat ook niet te zijn.

				Het onderhoud staat alleen hier en in geen enkel saldo: het valt bij de beheerder van de openbare ruimte en niet bij de ontwikkelaar. Dezelfde afweging als bij BeheerEnOnderhoud in Templates/Indicatoren/KostenWoningbouw.dms."
	{
		attribute<Eur>           Aanleg           (AdminDomain) := Piekbuiberging/Aanbod/Aanlegkosten, StorageName = "=replace(StorageStr_Kosten, '@V@', 'Aanleg')", StorageType = "gdalwrite.grid";
		attribute<Eur_jaarlijks> OnderhoudPerJaar (AdminDomain) := Piekbuiberging/Aanbod/Onderhoudskosten, StorageName = "=replace(StorageStr_Kosten, '@V@', 'OnderhoudPerJaar')", StorageType = "gdalwrite.grid";
		
		attribute<Eur> Onderhoud_NCW (AdminDomain) := = IsFirstAllocYear
			? 'MakeDefined(OnderhoudPerJaar, 0[Eur_jaarlijks]) * Verdiscontering/PeriodeFactor'
			: 'MakeDefined(OnderhoudPerJaar, 0[Eur_jaarlijks]) * Verdiscontering/PeriodeFactor + PrevIndicatoren/Piekbuiberging/Kosten/Onderhoud_NCW'
		, StorageName = "=replace(StorageStr_Kosten, '@V@', 'Onderhoud_NCW')", StorageType = "gdalwrite.grid"
		, Descr = "De netto contante waarde van het onderhoud, per periode opgebouwd volgens #651: het bedrag per jaar van dit zichtjaar maal de annuiteitfactor over de periode sinds het vorige zichtjaar, opgeteld bij de NCW van dat vorige zichtjaar.

					De benadering die daarin zit: het onderhoudsbedrag van dit zichtjaar geldt voor de hele periode ervoor, terwijl de maatregelen ergens in die periode zijn aangelegd. Dat overschat het onderhoud van wat er net ligt en onderschat niets; over een decennium is dat hooguit een halve periode te veel. Fijner kan alleen door de aanlegjaren per maatregel bij te houden, en die kent het model niet.";
		
	}
}
