////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Bedrijven, Woningen, Infrastructuur, Overig, Overige_Objecten.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Zichtjaar
{
	// Issue #609: BAG-nieuwbouw cellen hebben sinds issue #550 een gematchte OP_rel, maar de OP-kenmerken
	// (dichtheid, woonoppervlakte) gelden voor een volledig ontwikkelde cel en overschatten deze deels bebouwde
	// cellen fors. Voor die cellen valt het grondgebruik daarom terug op de BAG-waarneming (basisjaar).
	attribute<Bool> IsBAGnieuwbouwWonen (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantAllocatie/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/IsBAGnieuwbouwWonen), FALSE), Descr = "BAG-nieuwbouw wonen-cel, onafhankelijk van OP_rel (issue #550: BAG-cellen hebben nu een gematchte OP_rel, dus IsDefined(OP_rel) volstaat niet meer).";

	// #505/#665/#681: wat doet een maatregel met de schade aan een nieuwbouwwoning? Sinds #681 is dat een verschuiving
	// langs de diepte-as en niet langer een drempel; de schakelaar staat in /ModelParameters/Advanced.
	attribute</Classifications/Modellering/BouwwijzeK> Bouwwijze_rel (AdminDomain) := ='OP/Bouwwijze['+Zichtjaar_name+'/Stand/OP_rel]'
	, Descr = "De bouwwijze van het ontwikkelpakket dat in deze cel gealloceerd is, null waar geen pakket staat. OP_rel staat in de stand al op AdminDomain, dus hier is geen recollect_by_cond nodig, anders dan bij BouwwijzeEis dat op CompactedAdminDomain staat. Staat bewust buiten de schakelaar, zodat de twee toetsen naast elkaar te bekijken zijn; met de schakelaar uit wordt hij nooit opgevraagd en dus nooit gerekend.";

	attribute<meter> SchadevrijeDiepte_Nieuwbouw (AdminDomain) := =
		/ModelParameters/Advanced/SchadeToetstBouwwijzeVanPakket
			? 'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen ? MakeDefined(/Classifications/Modellering/BouwwijzeK/SchadevrijeDiepte[Bouwwijze_rel], 0[meter]) : 0[meter]'
			: 'const(0[meter], AdminDomain)'
	, Descr = "Hoeveel water houdt de bouwwijze van het gealloceerde pakket in deze cel buiten de woning? Nul waar geen nieuwbouw staat en nul waar het pakket geen maatregel draagt, zodat dit item overal een geldige verschuiving is en nergens een null in de dieptekaart introduceert.

				Dit is de verschuiving die Parameters/<watersysteem>/Diepte_Nieuwbouw van de waterdiepte aftrekt voordat de schadefunctie wordt afgelezen, en daarmee de hele werking van de maatregel in deze indicator. Onder de ontwerpdiepte levert dat schade nul op, precies zoals de drempel hieronder dat deed; erboven levert het de schade bij de restdiepte in plaats van de volle schade. Zie #681.

				BAG-nieuwbouwcellen staan er expliciet buiten: die vallen voor het grondgebruik terug op de waarneming uit het basisjaar (#550, #609), dus daar hoort geen maatregel van een ontwikkelpakket overheen.

				Alleen wonen. De niet-woonschade en de categorie Overig/Stedelijkgebied lezen de ongeschoven diepte, want bouwwijze bestaat in het model alleen voor wonen. Die asymmetrie is bekend en staat in #681.";

	attribute<Bool> IsOverstromingsbestendig (AdminDomain) := =
		/ModelParameters/Advanced/SchadeToetstBouwwijzeVanPakket
			? 'const(FALSE, AdminDomain)'
			: 'recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantData/BouwwijzeEis/Overstromingsbestendig, FALSE)'
	, Descr = "De oude drempel: blijft de nieuwbouw in deze cel volledig buiten de overstromingsschade? Op FALSE leest dit de eis van de plek, precies zoals het tot #665 op acht plaatsen hieronder letterlijk stond. Op TRUE staat hij overal uit, want daar doet SchadevrijeDiepte_Nieuwbouw hierboven het werk en wordt de schade verschoven in plaats van weggeboekt.

				Waarom de eis van de plek de verkeerde toets was. Hij is een voldoende maar geen noodzakelijke voorwaarde, ook al dwingt de zeef hem af in Zeef_Wonen_perOP_T/Impl/BouwwijzeNietOverstromingsbestendig. Gevaarzone 0 en 1 stellen geen eis terwijl de NbS-pakketten daar wel met bouwwijze 1 tot en met 4 landen, en omgekeerd laat de zeef in zone 2 tot en met 5 een pakket zonder maatregel toe zolang de diepte onder 0,2 meter blijft. Gemeten in NbSGenuanceerd 2040 ging het om 31.663 cellen met 73.659 woningen in de eerste groep en 2.015 cellen met 5.214 woningen in de tweede. Zie #681.

				De toets is scenario-blind: BaseData/Omgeving/Overstromingsdiepte is het elementgewijze maximum van de drie LIWO-kaarten, terwijl de schade per categorie met haar eigen kaart rekent. Dat gold voor de oude bouwwijzetoets op deze plek; de verschuiving hierboven heeft dat bezwaar niet, want die trekt de ontwerpdiepte af van dezelfde kaart waarmee de categorie rekent.";

	container Bedrijven //verdeling fucnties binnen subsector obv huidige verdeling  //relatie m2 per Footprint gemiddeld berekenen per gebied (/BaseData/PandFootprint_baan/PerYear/Y2022/PerRegio)
	{
		attribute<meter2> bijeenkomst (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Ov_consumentendiensten
						* Footprint_Opp_Ratio/Ov_consumentendiensten
						* Fractie_Opp_inJobs6_perVBOfuctie/bijeenkomst[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/bijeenkomst';
		
		attribute<meter2> Kantoor (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Zak_dienstverlening
					* Footprint_Opp_Ratio/Zak_dienstverlening
					* Fractie_Opp_inJobs6_perVBOfuctie/Kantoor[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/Kantoor';
		
		attribute<meter2> industrie (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Nijverheid
					* Footprint_Opp_Ratio/Nijverheid
					* Fractie_Opp_inJobs6_perVBOfuctie/industrie[NVM/Per_AdminDomain]
					+ '+Zichtjaar_name+'/Stand/m2PandFootprint_Logistiek
					* Footprint_Opp_Ratio/Logistiek
					* Fractie_Opp_inJobs6_perVBOfuctie/Logistiek[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/industrie';
		
		attribute<meter2> onderwijs (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Overheid_kw_diensten
					* Footprint_Opp_Ratio/Overheid_kw_diensten
					* Fractie_Opp_inJobs6_perVBOfuctie/onderwijs[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/onderwijs';
		
		attribute<meter2> sport (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Ov_consumentendiensten
					* Footprint_Opp_Ratio/Ov_consumentendiensten
					* Fractie_Opp_inJobs6_perVBOfuctie/sport[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/sport';
		
		attribute<meter2> winkel (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Detailhandel
					* Footprint_Opp_Ratio/Detailhandel
					* Fractie_Opp_inJobs6_perVBOfuctie/winkel[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/winkel';
		
		attribute<meter2> Gezondheidszorg (AdminDomain) := =
			'IsDefined(Stand/SubSector_rel)
				? '+Zichtjaar_name+'/Stand/m2PandFootprint_Overheid_kw_diensten
					* Footprint_Opp_Ratio/Overheid_kw_diensten
					* Fractie_Opp_inJobs6_perVBOfuctie/Gezondheidszorg[NVM/Per_AdminDomain]
				: StartSituatie/Bedrijven/Gezondheidszorg';
		
		container Footprint_Opp_Ratio              := ='/BaseData/Densities/PandFootprint_baan/PerRegio/Ratio_Footprint_Opp_perAdminDomain';
		container Fractie_Opp_inJobs6_perVBOfuctie := ='/BaseData/Densities/PandFootprint_baan/PerRegio/Fractie_Opp_inJobs6_perVBOfuctie';
	}
	
	container Woningen
	{
		container eengezinsWoningen
		{
			attribute<verblijfsobject> Aantal_Woningen (AdminDomain) := =
					'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
						? (OP/WP2_rel == WP2/V/Eengezins)['+Zichtjaar_name+'/Stand/OP_rel]
							? IsOverstromingsbestendig
								? 0[verblijfsobject]
								: OP/Dichtheid['+Zichtjaar_name+'/Stand/OP_rel] * AdminDomain/NrHaPerCell / 1[Woning] * 1[verblijfsobject]
							: 0[verblijfsobject]
						: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/eengezinsWoningen/Aantal_Woningen';
			
			attribute<meter2> Vloeroppervlak (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Eengezins)['+Zichtjaar_name+'/Stand/OP_rel]
						? IsOverstromingsbestendig
							? 0[meter2]
							: OP/Woonoppervlakte['+Zichtjaar_name+'/Stand/OP_rel] * AdminDomain/NrHaPerCell' //issue #609: schaal met het celoppervlak (NrHaPerCell), niet met de vaste 1 ha uit Ontwikkelpakketten/Terreinoppervlakte (gaf 16x te veel op het 25m-grid)
						': 0f
					: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/eengezinsWoningen/Vloeroppervlak';
		}
		
		container meergezins_bg
		{
			attribute<verblijfsobject> Aantal_Woningen (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Meergezins)['+Zichtjaar_name+'/Stand/OP_rel]
					? IsOverstromingsbestendig
							? 0[verblijfsobject]
							: (OP/Dichtheid['+Zichtjaar_name+'/Stand/OP_rel] / OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel])' //dichtheid / bouwlagen = aantal panden, dus aantal bg verdiepingen.
								'* AdminDomain/NrHaPerCell / 1[Woning] * 1[verblijfsobject]
						: 0f
					: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/meergezins_bg/Aantal_Woningen';
			
			attribute<meter2> Vloeroppervlak (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Meergezins)['+Zichtjaar_name+'/Stand/OP_rel]
						? IsOverstromingsbestendig
							? 0[meter2]
							: OP/Woonoppervlakte['+Zichtjaar_name+'/Stand/OP_rel] * AdminDomain/NrHaPerCell'
								' / OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]' //issue #609: alleen het bg-aandeel van de woonoppervlakte (1/bouwlagen), analoog aan Aantal_Woningen
							': 0f
						: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/meergezins_bg/Vloeroppervlak';
		}
		
		container meergezins_1e
		{
			attribute<verblijfsobject> Aantal_Woningen (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Meergezins)['+Zichtjaar_name+'/Stand/OP_rel]
						? IsOverstromingsbestendig
							? 0[verblijfsobject]
							: round(OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]) > 1i
								? (OP/Dichtheid['+Zichtjaar_name+'/Stand/OP_rel] / OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel])' //dichtheid / bouwlagen = aantal panden, dus aantal 1e verdiepingen.
									'* AdminDomain/NrHaPerCell / 1[Woning] * 1[verblijfsobject]
								: 0f
						: 0f
					: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/meergezins_1e/Aantal_Woningen';
			
			attribute<meter2> Vloeroppervlak (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Meergezins)['+Zichtjaar_name+'/Stand/OP_rel]
						? IsOverstromingsbestendig
							? 0[meter2]
							: round(OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]) > 1i
								? OP/Woonoppervlakte['+Zichtjaar_name+'/Stand/OP_rel] * AdminDomain/NrHaPerCell'
									' / OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]' //issue #609: alleen het 1e-verdieping-aandeel (1/bouwlagen), analoog aan Aantal_Woningen
								': 0[meter2]
							: 0f
						: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/meergezins_1e/Vloeroppervlak';
		}
		
		container meergezins_hoog
		{
			attribute<verblijfsobject> Aantal_Woningen (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Meergezins)['+Zichtjaar_name+'/Stand/OP_rel]
						? IsOverstromingsbestendig
							? 0[verblijfsobject]
							: round(OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]) > 2i
								? (OP/Dichtheid['+Zichtjaar_name+'/Stand/OP_rel] / OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel])' //dichtheid / bouwlagen = aantal panden, dus aantal 1e verdiepingen.
									'* (round(OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel])[float32] - 2f)'
									'* AdminDomain/NrHaPerCell / 1[Woning] * 1[verblijfsobject]
								: 0f
						: 0f
					: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/meergezins_hoog/Aantal_Woningen';
			
			attribute<meter2> Vloeroppervlak (AdminDomain) := =
				'IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen
					? (OP/WP2_rel == WP2/V/Meergezins)['+Zichtjaar_name+'/Stand/OP_rel]
						? IsOverstromingsbestendig
							? 0[meter2]
							: round(OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]) > 2i
								? OP/Woonoppervlakte['+Zichtjaar_name+'/Stand/OP_rel] * AdminDomain/NrHaPerCell'
									' / OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel]'
									' * (round(OP/Bouwlagen['+Zichtjaar_name+'/Stand/OP_rel])[float32] - 2f)' //issue #609: aandeel verdiepingen boven de 1e ((L-2)/bouwlagen), analoog aan Aantal_Woningen
								': 0[meter2]
							: 0f
						: Basisjaar/Overstromingsschade/Grondgebruik/StartSituatie/Woningen/meergezins_hoog/Vloeroppervlak';
		}
	}
	
	container Infrastructuur := StartSituatie/Infrastructuur;
	
	container Overig
	{
		attribute<meter2> Glastuinbouw        (AdminDomain) := ='IsDefined('+Zichtjaar_name+'/Stand/SubSector_rel) ? 0[meter2] : StartSituatie/Overig/Glastuinbouw';
		attribute<meter2> Landbouw            (AdminDomain) := ='IsDefined('+Zichtjaar_name+'/Stand/SubSector_rel) ? 0[meter2] : StartSituatie/Overig/Landbouw';
		attribute<meter2> Stedelijkgebied     (AdminDomain) := ='IsDefined('+Zichtjaar_name+'/Stand/OP_rel) && !IsBAGnieuwbouwWonen        ? convert(AdminDomain/NrHaPerCell, meter2) : StartSituatie/Overig/Stedelijkgebied';
		attribute<meter2> ExtensieveRecreatie (AdminDomain) := ='IsDefined('+Zichtjaar_name+'/Stand/SubSector_rel) ? 0[meter2] : StartSituatie/Overig/ExtensieveRecreatie';
		attribute<meter2> IntensieveRecreatie (AdminDomain) := ='IsDefined('+Zichtjaar_name+'/Stand/SubSector_rel) ? 0[meter2] : StartSituatie/Overig/IntensieveRecreatie';
		attribute<meter2> Vliegveld           (AdminDomain) := ='IsDefined('+Zichtjaar_name+'/Stand/SubSector_rel) ? 0[meter2] : StartSituatie/Overig/Vliegveld';
	}
	
	// container Inwoners;
	container Overige_Objecten;
}