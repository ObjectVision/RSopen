// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Woondiensten (#491): per regio het gemiddelde vloeroppervlak en het gemiddelde perceel per woning. Een sjabloon
// voor het basisjaar en de zichtjaren, zodat de rekenregel op een plek staat (#439).
//


Template Woondiensten_T
: Descr = "Het gebruiksoppervlak en het perceel per woning (#491), per cel als som en per regio als gemiddelde. Een woning uit de voorraad van het basisjaar krijgt het gemiddelde van haar cel volgens de BAG
			en de BRK (Voorraad_BAG), een woning van een ontwikkelpakket de kenmerken van dat pakket. Een cel waar de allocatie een pakket heeft ingericht is helemaal pakket; elders blijft van de
			basisjaarvoorraad staan wat de stand nog draagt, en wat de stand daarboven draagt is BAG-nieuwbouw, met de kenmerken van het pakket dat #550 aan die cel koppelt. Het gemiddelde per regio is de
			som van het oppervlak gedeeld door de woningen waarvoor dat oppervlak bekend is, over dezelfde cellen."
{
	parameter<String> Zichtjaar_name;
	//

	parameter<Bool>   IsStartYear := lowercase(Zichtjaar_name) == lowercase('Basisjaar');

	unit<UInt8>       OP          := ThisVariantClassifications/Vastgoed/OP;
	container         OP_Buurt    := ='ThisVariantClassifications/Vastgoed/OP_Buurt';
	unit<UInt32>      Regio       := =/ModelParameters/Advanced/IndicatorRegio_path;

	container Voorraad_BAG
	: Descr = "Per cel het gemiddelde gebruiksoppervlak en het gemiddelde kadastrale perceel per woning van de woningvoorraad in het basisjaar. Per woon-vbo het gebruiksoppervlak uit de BAG en het
				perceel waarop het vbo staat, gedeeld door de woon-vbo's op dat perceel; per pand opgeteld en met dezelfde pandverdeling over de cellen gebracht als de woningwaarde in
				BaseData/Suitabilities/Verwervingskosten, en een vbo zonder pand op de cel van zijn punt. Teller en noemer gaan door dezelfde verdeling, dus het gemiddelde per cel hoort bij de woningen
				die de stand daar telt. De zichtjaren lezen deze container van het basisjaar."
	{
		unit<UInt32>  Pand      := ='/SourceData/Vastgoed/BAG/PerJaar/Y' + string(/ModelParameters/Model_StartYear) + '/pand', Descr = "De panden van het basisjaar, dezelfde set als in de woningstand en de verwervingskosten.";
		unit<UInt32>  Toedeling := Pand/ToedelingsMatrix, Descr = "Pand maal cel met het aandeel van het pand in de cel.";
		unit<UInt32>  VBO       := /SourceData/Vastgoed/BRK/WoonVBO, Descr = "De woon-vbo's van het basisjaar met het kadastrale perceel waarop hun punt ligt.";
		unit<UInt32>  Perceel   := /SourceData/Vastgoed/BRK/Perceel;

		attribute<UInt32>  VBOs_PerPerceel  (Perceel) := pcount(VBO/Perceel_rel), Descr = "Het aantal woon-vbo's op het perceel, waarover het perceel wordt verdeeld.";
		attribute<meter2>  Vloeroppervlak   (VBO)     := VBO/oppervlakte_trunc * 1[Verblijfsobject], Descr = "Het gebruiksoppervlak van het vbo zoals de woningstand het telt (oppervlakte_trunc): boven ModelParameters/Wonen/VBO_opp_truncation_upper begrensd, een onwaarschijnlijk klein of groot oppervlak leeg.";
		attribute<meter2>  Perceeloppervlak (VBO)     := IsDefined(VBO/Perceel_rel) ? min_elem(float32(Perceel/grootte)[meter2][VBO/Perceel_rel] / float32(VBOs_PerPerceel[VBO/Perceel_rel]), /ModelParameters/Wonen/Woondiensten/PerceelPerWoning_Max * 1[Woning]) : null_f[meter2]
		, Descr = "Het deel van het perceel dat bij dit vbo hoort: de kadastrale grootte gedeeld door de woon-vbo's op het perceel, begrensd op ModelParameters/Wonen/Woondiensten/PerceelPerWoning_Max. Leeg voor een vbo waarvan het punt in geen perceel ligt.";

		attribute<Bool>    HeeftPand        (VBO)     := IsDefined(VBO/eerste_pand_rel);

		container PerPand
		{
			attribute<meter2> Vloeroppervlak            (Pand) := sum(Voorraad_BAG/Vloeroppervlak, VBO/eerste_pand_rel);
			attribute<Woning> Woningen_Vloeroppervlak   (Pand) := sum(IsDefined(Voorraad_BAG/Vloeroppervlak) ? 1[Woning] : 0[Woning], VBO/eerste_pand_rel);
			attribute<meter2> Perceeloppervlak          (Pand) := sum(Voorraad_BAG/Perceeloppervlak, VBO/eerste_pand_rel);
			attribute<Woning> Woningen_Perceeloppervlak (Pand) := sum(IsDefined(Voorraad_BAG/Perceeloppervlak) ? 1[Woning] : 0[Woning], VBO/eerste_pand_rel);
		}

		container PerCel
		: Descr = "De sommen per cel: het pandaandeel uit Toedeling plus de vbo's zonder pand op de cel van hun punt."
		{
			attribute<meter2> Vloeroppervlak            (AdminDomain) := sum(PerPand/Vloeroppervlak[Toedeling/Pand_rel] * Toedeling/ToedelingPand, Toedeling/AdminDomain_rel) + sum(HeeftPand ? 0[meter2] : MakeDefined(Voorraad_BAG/Vloeroppervlak, 0[meter2]), VBO/AdminDomain_rel);
			attribute<Woning> Woningen_Vloeroppervlak   (AdminDomain) := sum(PerPand/Woningen_Vloeroppervlak[Toedeling/Pand_rel] * Toedeling/ToedelingPand, Toedeling/AdminDomain_rel) + sum(!HeeftPand && IsDefined(Voorraad_BAG/Vloeroppervlak) ? 1[Woning] : 0[Woning], VBO/AdminDomain_rel);
			attribute<meter2> Perceeloppervlak          (AdminDomain) := sum(PerPand/Perceeloppervlak[Toedeling/Pand_rel] * Toedeling/ToedelingPand, Toedeling/AdminDomain_rel) + sum(HeeftPand ? 0[meter2] : MakeDefined(Voorraad_BAG/Perceeloppervlak, 0[meter2]), VBO/AdminDomain_rel);
			attribute<Woning> Woningen_Perceeloppervlak (AdminDomain) := sum(PerPand/Woningen_Perceeloppervlak[Toedeling/Pand_rel] * Toedeling/ToedelingPand, Toedeling/AdminDomain_rel) + sum(!HeeftPand && IsDefined(Voorraad_BAG/Perceeloppervlak) ? 1[Woning] : 0[Woning], VBO/AdminDomain_rel);
		}

		attribute<m2_Woning> Vloeroppervlak_PerWoning   (AdminDomain) := PerCel/Woningen_Vloeroppervlak   > 0[Woning] ? PerCel/Vloeroppervlak   / PerCel/Woningen_Vloeroppervlak   : null_f[m2_Woning], Descr = "Het gemiddelde gebruiksoppervlak per woning in de cel; leeg zonder woning met een bekend oppervlak.";
		attribute<m2_Woning> Perceeloppervlak_PerWoning (AdminDomain) := PerCel/Woningen_Perceeloppervlak > 0[Woning] ? PerCel/Perceeloppervlak / PerCel/Woningen_Perceeloppervlak : null_f[m2_Woning], Descr = "Het gemiddelde perceel per woning in de cel; leeg zonder woning op een bekend perceel.";
	}

	container Voorraad := = IsStartYear ? 'Voorraad_BAG' : 'Basisjaar/Woondiensten/Voorraad_BAG', Descr = "De per-woningwaarden van de basisjaarvoorraad; een zichtjaar leest die van het basisjaar en rekent ze niet opnieuw.";

	attribute<Woning>    Woningen           (AdminDomain) := MakeDefined(ThisYear/Stand/Aantal_Woningen_Totaal, 0[Woning]), Descr = "De woningen van de stand.";
	attribute<Woning>    Woningen_Basisjaar (AdminDomain) := = IsStartYear ? 'Woningen' : 'Basisjaar/Woondiensten/Woningen';
	attribute<Bool>      IsPakketCel        (AdminDomain) := = IsStartYear ? 'const(FALSE, AdminDomain)' : 'ThisYear/WaardeNabijheidGroen/Bron_Zichtjaar/IsOPCel', Descr = "Hier heeft de allocatie de stand vervangen door een ontwikkelpakket, dus is er van het basisjaar niets over.";
	attribute<Woning>    Woningen_Voorraad  (AdminDomain) := IsPakketCel ? 0[Woning] : min_elem(Woningen, Woningen_Basisjaar), Descr = "De woningen uit de voorraad van het basisjaar die de stand nog draagt.";
	attribute<Woning>    Woningen_Pakket    (AdminDomain) := IsPakketCel ? Woningen : max_elem(Woningen - Woningen_Basisjaar, 0[Woning]), Descr = "De woningen van een pakket: in een pakketcel alle, elders wat de stand boven de basisjaarvoorraad draagt, en dat is BAG-nieuwbouw.";

	attribute<OP>        OP_rel                   (AdminDomain) := ThisYear/Stand/OP_rel, Descr = "Het pakket van de cel: door de allocatie ingericht, of het pakket dat #550 aan BAG-nieuwbouw koppelt; in het basisjaar leeg.";
	attribute<m2_Woning> Vloeroppervlak_Pakket    (AdminDomain) := OP/Woonoppervlakte_woning[OP_rel][m2_Woning], Descr = "Het gebruiksoppervlak per woning van het pakket (OPTabel_T, Woonoppervlakte_woning).";
	attribute<m2_Woning> Perceeloppervlak_Pakket  (AdminDomain) := OP_Buurt/Perceeloppervlakte[OP_rel][m2_Woning], Descr = "Het perceel per woning van het pakket: het uitgeefbare terrein inclusief de voetafdruk, gedeeld door de woningen (NettoBuurt, Perceeloppervlakte).";

	container PerCel
	: Descr = "Per cel de oppervlakken en de woningen waarvoor ze bekend zijn; een woning zonder bekend oppervlak telt in geen van beide mee."
	{
		attribute<meter2> Vloeroppervlak            (AdminDomain) := MakeDefined(Woningen_Voorraad * Voorraad/Vloeroppervlak_PerWoning, 0[meter2]) + MakeDefined(Woningen_Pakket * Vloeroppervlak_Pakket, 0[meter2]);
		attribute<Woning> Woningen_Vloeroppervlak   (AdminDomain) := (IsDefined(Voorraad/Vloeroppervlak_PerWoning) ? Woningen_Voorraad : 0[Woning]) + (IsDefined(Vloeroppervlak_Pakket) ? Woningen_Pakket : 0[Woning]);
		attribute<meter2> Perceeloppervlak          (AdminDomain) := MakeDefined(Woningen_Voorraad * Voorraad/Perceeloppervlak_PerWoning, 0[meter2]) + MakeDefined(Woningen_Pakket * Perceeloppervlak_Pakket, 0[meter2]);
		attribute<Woning> Woningen_Perceeloppervlak (AdminDomain) := (IsDefined(Voorraad/Perceeloppervlak_PerWoning) ? Woningen_Voorraad : 0[Woning]) + (IsDefined(Perceeloppervlak_Pakket) ? Woningen_Pakket : 0[Woning]);
	}

	// -- de bron van de aggregaties: levend, of teruggelezen uit de export (#824) --
	parameter<String> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Woondiensten_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif', Descr = "De bestandsnaam van de vier kaarten; @V@ is de grootheid.";

	container Schrijf
	: Descr = "De vier kaarten van PerCel, met de georeferentie in de tif zelf; een eigen container, zodat PerCel geen opslag draagt. Alleen de zichtjaren schrijven ze, via Export/generates."
	{
		attribute<meter2> Vloeroppervlak            (AdminDomain) := PerCel/Vloeroppervlak,            StorageName = "=replace(StorageStr, '@V@', 'Vloeroppervlak')",            StorageType = "gdalwrite.grid";
		attribute<Woning> Woningen_Vloeroppervlak   (AdminDomain) := PerCel/Woningen_Vloeroppervlak,   StorageName = "=replace(StorageStr, '@V@', 'Woningen_Vloeroppervlak')",   StorageType = "gdalwrite.grid";
		attribute<meter2> Perceeloppervlak          (AdminDomain) := PerCel/Perceeloppervlak,          StorageName = "=replace(StorageStr, '@V@', 'Perceeloppervlak')",          StorageType = "gdalwrite.grid";
		attribute<Woning> Woningen_Perceeloppervlak (AdminDomain) := PerCel/Woningen_Perceeloppervlak, StorageName = "=replace(StorageStr, '@V@', 'Woningen_Perceeloppervlak')", StorageType = "gdalwrite.grid";
	}
	container Lees
	: Descr = "De kaarten van Schrijf teruggelezen, voor een tabelrun met ModelParameters/TabellenUitExport aan (#824)."
	{
		attribute<meter2> Vloeroppervlak            (AdminDomain) : StorageName = "=replace(StorageStr, '@V@', 'Vloeroppervlak')",            StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<Woning> Woningen_Vloeroppervlak   (AdminDomain) : StorageName = "=replace(StorageStr, '@V@', 'Woningen_Vloeroppervlak')",   StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<meter2> Perceeloppervlak          (AdminDomain) : StorageName = "=replace(StorageStr, '@V@', 'Perceeloppervlak')",          StorageType = "gdal.grid", StorageReadOnly = "TRUE";
		attribute<Woning> Woningen_Perceeloppervlak (AdminDomain) : StorageName = "=replace(StorageStr, '@V@', 'Woningen_Perceeloppervlak')", StorageType = "gdal.grid", StorageReadOnly = "TRUE";
	}
	container Live := PerCel;
	container Bron := = /ModelParameters/TabellenUitExport && !IsStartYear ? 'Lees' : 'Live'
	, Descr = "Waar de gemiddelden hun sommen per cel vandaan halen, gestuurd door ModelParameters/TabellenUitExport (#824); het basisjaar schrijft geen kaarten en rekent altijd levend.";

	container Vloeroppervlak_PerWoning
	: Descr = "Het gemiddelde gebruiksoppervlak per woning: de som van het oppervlak gedeeld door de woningen met een bekend oppervlak."
	{
		attribute<m2_Woning> Per_Regio (Regio) := sum(Bron/Vloeroppervlak, Regio/Per_AdminDomain_Fijn) / sum(Bron/Woningen_Vloeroppervlak, Regio/Per_AdminDomain_Fijn);
		parameter<m2_Woning> Per_NL            := sum(Bron/Vloeroppervlak) / sum(Bron/Woningen_Vloeroppervlak);
	}
	container Perceeloppervlak_PerWoning
	: Descr = "Het gemiddelde perceel per woning: de som van het perceeloppervlak gedeeld door de woningen op een bekend perceel."
	{
		attribute<m2_Woning> Per_Regio (Regio) := sum(Bron/Perceeloppervlak, Regio/Per_AdminDomain_Fijn) / sum(Bron/Woningen_Perceeloppervlak, Regio/Per_AdminDomain_Fijn);
		parameter<m2_Woning> Per_NL            := sum(Bron/Perceeloppervlak) / sum(Bron/Woningen_Perceeloppervlak);
	}
}
