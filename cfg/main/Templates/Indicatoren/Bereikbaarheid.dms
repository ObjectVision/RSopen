////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// gemiddelde decayed banen bereikbaar per subsect, per vervoerstype, per provincie. (aggregatie vanaf buurt
// resultaten) Laadt via #include: Read_Indicators, MakeDecayT, Impl, ODs.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Bereikbaarheid_Banen
{
	container Parameters
	{
		//distance decay Parameters, ontvangen van Jeroen Bastiaansen (PBL) in 2020
		parameter<Float32> car_a   := -8.65786f;
		parameter<Float32> car_b   := 2.492099f;
		parameter<Float32> car_c   := 0.011641f;
		parameter<Float32> bike_a  := -7.95686f;
		parameter<Float32> bike_b  := 2.675059f;
		parameter<Float32> bike_c  := 0.011981f;
		parameter<Float32> ov_a    := -12.3301f;
		parameter<Float32> ov_b    := 2.907621f;
		parameter<Float32> ov_c    := 0.012824f;
	}
	
	unit<UInt32> Buurt   := /SourceData/RegioIndelingen/cbs/Y2021/buurt;
	unit<UInt8>  Jobs6   := Classifications/Actor/Jobs6;
	// unit<UInt32> WerkenK := Classifications/Actor/Sector/xSubsectoren/Werken/Combi;
	unit<UInt8> WerkenK := /Classifications/Actor/Sector/xSubsectoren/Werken/Subsector;
	
	unit<UInt32> StartYear : NrOfRows = 1
	{
		attribute<String> name  := const('Y'+string(ModelParameters/Model_StartYear),.);
	}
	
	// unit<UInt32> Scenarios_src := combine(CaseClassifications/Scenario, CaseClassifications/VariantK)
	// {
		// attribute<String> Scenario_name := CaseClassifications/Scenario/name[first_rel];
		// attribute<String> Variant_name  := CaseClassifications/VariantK/name[second_rel];
		
		// attribute<String> name := Scenario_name + '_' + Variant_name;
	// }
	
	// unit<UInt32> Scenarios := union_unit(Scenarios_src, StartYear)
	// {
		// attribute<String> name := union_data(., Scenarios_src/name, StartYear/name);
	// }
	
	unit<UInt32> TransportTypes : NrOfRows = 3
	{
		attribute<String> name  : ['W_OV_W','Bike','Car'];
		attribute<String> maintype  : ['OV','Bike','Car'];
	}
	
	unit<UInt32> TTxJobs6 := combine(TransportTypes, Jobs6)
	{
		attribute<String> itemname := TransportTypes/name[first_rel]+'_'+Jobs6/name[second_rel];
		attribute<String> tt_name := TransportTypes/name[first_rel];
		attribute<String> Jobs5_name := Jobs6/name[second_rel];
	}
	
	container MakeDecayPerSector := for_each_ne(jobs6/name, 'MakeDecayT(Read_Indicators/Stand_PerBuurt/BanenPerSector/'+jobs6/name+')');
	
	container MakeDecay := MakeDecayT(Read_Indicators/Stand_PerBuurt/Banen, Read_Indicators/Stand_StartYear_PerBuurt/Banen);
	
	container Output_PerBuurtPerSector := 
		for_each_nedv(
			TTxJobs6/itemname
			,'MakeDecayPerSector/'+TTxJobs6/Jobs5_name+'/PerTransportType/'+TTxJobs6/tt_name+'/Domain/banen_decayed_org'
			, Buurt
			, Job
		);
		
	container Output_PerProvinciePerSector := 
		for_each_nedv(
			TTxJobs6/itemname
			,'mean(Output_PerBuurtPerSector/'+TTxJobs6/itemname+', Output_PerProvincie/prov_rel)'
			, Provincie/StudyArea
			, Job
		), Descr = "gemiddelde decayed banen bereikbaar per subsect, per vervoerstype, per provincie. (aggregatie vanaf buurt resultaten)";
	
	container Result 
	: StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Bereikbaarheid_Banen_'+Zichtjaar_name+'.gpkg'"
	, StorageType = "gdalwrite.vect"
	{
		unit<UInt32> Output_PerBuurt := Buurt
		, Descr = "gemiddelde decayed banen bereikbaar per vervoerstype, per buurt."
		{
			attribute<String> BU_CODE                := Buurt/statcode;
			
			attribute<Job>    Banen_W_OV_W_StartYear := MakeDecay/PerTransportType/W_OV_W/Domain/banen_StartYear_decayed_org;
			attribute<Job>    Banen_W_OV_W           := MakeDecay/PerTransportType/W_OV_W/Domain/banen_decayed_org;
			
			attribute<Job>    Banen_BB_StartYear     := MakeDecay/PerTransportType/Bike/Domain/banen_StartYear_decayed_org;
			attribute<Job>    Banen_BB               := MakeDecay/PerTransportType/Bike/Domain/banen_decayed_org;
			
			attribute<Job>    Banen_CAR_StartYear    := MakeDecay/PerTransportType/CAR/Domain/banen_StartYear_decayed_org;
			attribute<Job>    Banen_CAR              := MakeDecay/PerTransportType/CAR/Domain/banen_decayed_org;
			
			attribute<Woning> Woningen               := Read_Indicators/Stand_PerBuurt/Woningen
			, Descr = "De woningen per buurt in dit zichtjaar, het gewicht van de bewonersgewogen gemiddelden in Output_PerNederland en PerIndicatorRegio. Staat sinds #824 in de gpkg, zodat een tabelrun met ModelParameters/TabellenUitExport aan het gewicht samen met de bereikbaarheid kan teruglezen.";
		}
		
		unit<UInt32> Output_PerProvincie := Provincie/StudyArea
		, Descr = "gemiddelde decayed banen bereikbaar per vervoerstype, per provincie. (aggregatie vanaf buurt resultaten)"
		{
			attribute<Job> Banen_W_OV_W_StartYear := mean(Output_PerBuurt/Banen_W_OV_W_StartYear, prov_rel);
			attribute<Job> Banen_W_OV_W           := mean(Output_PerBuurt/Banen_W_OV_W, prov_rel);
			
			attribute<Job> Banen_BB_StartYear     := mean(Output_PerBuurt/Banen_BB_StartYear, prov_rel);
			attribute<Job> Banen_BB               := mean(Output_PerBuurt/Banen_BB, prov_rel);
			
			attribute<Job> Banen_CAR_StartYear    := mean(Output_PerBuurt/Banen_CAR_StartYear, prov_rel);
			attribute<Job> Banen_CAR              := mean(Output_PerBuurt/Banen_CAR, prov_rel);

			attribute<.> prov_rel (Buurt) := point_in_polygon(centroid_or_mid(Buurt/geometry), geometry), DisableStorage = "TRUE";
		}
		
		container Output_PerNederland
		: Descr = "gemiddelde decayed banen bereikbaar per vervoerstype, totaal nederland. (aggregatie vanaf buurt resultaten)"
		{
			parameter<String> name := 'NL';
			
			parameter<Job> Banen_W_OV_W_StartYear := sum(Output_PerBuurt/Banen_W_OV_W_StartYear * Read_Indicators/Stand_StartYear_PerBuurt/Woningen) / sum(Read_Indicators/Stand_StartYear_PerBuurt/Woningen); 
			parameter<Job> Banen_W_OV_W           := sum(Output_PerBuurt/Banen_W_OV_W           * Read_Indicators/Stand_PerBuurt/Woningen          ) / sum(Read_Indicators/Stand_PerBuurt/Woningen); 
			
			parameter<Job> Banen_BB_StartYear     := sum(Output_PerBuurt/Banen_BB_StartYear     * Read_Indicators/Stand_StartYear_PerBuurt/Woningen) / sum(Read_Indicators/Stand_StartYear_PerBuurt/Woningen); 
			parameter<Job> Banen_BB               := sum(Output_PerBuurt/Banen_BB               * Read_Indicators/Stand_PerBuurt/Woningen          ) / sum(Read_Indicators/Stand_PerBuurt/Woningen); 
			
			parameter<Job> Banen_CAR_StartYear    := sum(Output_PerBuurt/Banen_CAR_StartYear    * Read_Indicators/Stand_StartYear_PerBuurt/Woningen) / sum(Read_Indicators/Stand_StartYear_PerBuurt/Woningen); 
			parameter<Job> Banen_CAR              := sum(Output_PerBuurt/Banen_CAR              * Read_Indicators/Stand_PerBuurt/Woningen          ) / sum(Read_Indicators/Stand_PerBuurt/Woningen); 
		}
	}
	
	// -- de bron van de aggregaties in PerIndicatorRegio: levend, of teruggelezen uit de gpkg (#824) --
	container Lees
	: Descr = "De bereikbaarheid en de woningen per buurt van dit zichtjaar, teruggelezen uit de gpkg die Result schrijft, voor een tabelrun met ModelParameters/TabellenUitExport aan (#824). Gekoppeld op buurtcode, zoals Indicatoren/AdHoc.dms dezelfde gpkg leest."
	{
		container Gpkg
		: StorageName     = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Bereikbaarheid_Banen_'+Zichtjaar_name+'.gpkg'"
		, StorageType     = "gdal.vect"
		, StorageReadOnly = "TRUE"
		{
			unit<uint32> Output_PerBuurt
			{
				attribute<String>  BU_CODE;
				attribute<Float32> Banen_W_OV_W;
				attribute<Float32> Banen_BB;
				attribute<Float32> Banen_CAR;
				attribute<Float32> Woningen;
				attribute<Float32> Banen_W_OV_W_StartYear;
				attribute<Float32> Banen_BB_StartYear;
				attribute<Float32> Banen_CAR_StartYear;
			}
		}
		attribute<Job>    Banen_W_OV_W (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Banen_W_OV_W)[Job];
		attribute<Job>    Banen_BB     (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Banen_BB)[Job];
		attribute<Job>    Banen_CAR    (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Banen_CAR)[Job];
		attribute<Woning> Woningen     (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Woningen)[Woning];
		// De basisjaarkant (#828): de gpkg draagt de bereikbaarheid van het basisjaar al per buurt; het gewicht komt uit de basisjaarstand zelf, die altijd op schijf staat.
		attribute<Job>    Banen_W_OV_W_StartYear (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Banen_W_OV_W_StartYear)[Job];
		attribute<Job>    Banen_BB_StartYear     (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Banen_BB_StartYear)[Job];
		attribute<Job>    Banen_CAR_StartYear    (Buurt) := rjoin(Buurt/statcode, Gpkg/Output_PerBuurt/BU_CODE, Gpkg/Output_PerBuurt/Banen_CAR_StartYear)[Job];
		attribute<Woning> Woningen_StartYear     (Buurt) := Read_Indicators/Stand_StartYear_PerBuurt/Woningen;
	}
	container Live
	{
		attribute<Job>    Banen_W_OV_W (Buurt) := Result/Output_PerBuurt/Banen_W_OV_W;
		attribute<Job>    Banen_BB     (Buurt) := Result/Output_PerBuurt/Banen_BB;
		attribute<Job>    Banen_CAR    (Buurt) := Result/Output_PerBuurt/Banen_CAR;
		attribute<Woning> Woningen     (Buurt) := Read_Indicators/Stand_PerBuurt/Woningen;
		attribute<Job>    Banen_W_OV_W_StartYear (Buurt) := Result/Output_PerBuurt/Banen_W_OV_W_StartYear;
		attribute<Job>    Banen_BB_StartYear     (Buurt) := Result/Output_PerBuurt/Banen_BB_StartYear;
		attribute<Job>    Banen_CAR_StartYear    (Buurt) := Result/Output_PerBuurt/Banen_CAR_StartYear;
		attribute<Woning> Woningen_StartYear     (Buurt) := Read_Indicators/Stand_StartYear_PerBuurt/Woningen;
	}
	container Bron := = /ModelParameters/TabellenUitExport ? 'Lees' : 'Live'
	, Descr = "Waar PerIndicatorRegio de bereikbaarheid en het gewicht per buurt vandaan haalt: Live (berekend) of Lees (de gpkg van dit zichtjaar teruggelezen), gestuurd door ModelParameters/TabellenUitExport (#824).";
	
	container PerIndicatorRegio
	: Descr = "De bereikbaarheid van banen geaggregeerd naar de indeling uit ModelParameters/Advanced/IndicatorRegio_ref, en daarnaast het landelijke getal. De achtervoegsels Per_Regio en Per_NL zijn er
				zodat de indicatorentabellen in Indicatoren_T/Export.dms ze langs NaamAggr kunnen lezen, net als bij SloopTotaal (#797). De aggregatie is hetzelfde bewonersgewogen gemiddelde als in
				Result/Output_PerNederland, want een decayed bereikbaarheidsgetal is een gemiddelde per woning en niet op te tellen; Landelijk draagt dezelfde formule als daar, maar over Bron, zodat een tabelrun met ModelParameters/TabellenUitExport aan ook het landelijke getal uit de gpkg haalt (#824). De buurt komt via een modus bij een
				regio en niet via een punt in een polygoon zoals Result/Output_PerProvincie doet, want de indelingen die hier langs kunnen komen zijn deels raster (#705) en de landschapsindeling heeft geen
				polygoongrens; elke buurt telt mee bij de regio waar de meeste van haar cellen liggen."
	{
		unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;

		attribute<Regio> Regio_rel (Buurt) := modus(Regio/Per_AdminDomain_Fijn, Buurt/Per_AdminDomain)
		, Descr = "Bij welke regio hoort deze buurt? De modus over de cellen van de buurt, zodat ook een rasterindeling meedoet.";

		attribute<Job> Banen_W_OV_W_Per_Regio (Regio) := sum(Bron/Banen_W_OV_W * Bron/Woningen, Regio_rel) / sum(Bron/Woningen, Regio_rel);
		attribute<Job> Banen_BB_Per_Regio     (Regio) := sum(Bron/Banen_BB     * Bron/Woningen, Regio_rel) / sum(Bron/Woningen, Regio_rel);
		attribute<Job> Banen_CAR_Per_Regio    (Regio) := sum(Bron/Banen_CAR    * Bron/Woningen, Regio_rel) / sum(Bron/Woningen, Regio_rel);

		parameter<Job> Banen_W_OV_W_Per_NL    := sum(Bron/Banen_W_OV_W * Bron/Woningen) / sum(Bron/Woningen);
		parameter<Job> Banen_BB_Per_NL        := sum(Bron/Banen_BB     * Bron/Woningen) / sum(Bron/Woningen);
		parameter<Job> Banen_CAR_Per_NL       := sum(Bron/Banen_CAR    * Bron/Woningen) / sum(Bron/Woningen);

		// Dezelfde aggregatie voor het basisjaar (#828), gewogen met de woningen van het basisjaar, voor de basisjaartabel in Indicatoren_T/Export.dms.
		attribute<Job> Banen_W_OV_W_StartYear_Per_Regio (Regio) := sum(Bron/Banen_W_OV_W_StartYear * Bron/Woningen_StartYear, Regio_rel) / sum(Bron/Woningen_StartYear, Regio_rel);
		attribute<Job> Banen_BB_StartYear_Per_Regio     (Regio) := sum(Bron/Banen_BB_StartYear     * Bron/Woningen_StartYear, Regio_rel) / sum(Bron/Woningen_StartYear, Regio_rel);
		attribute<Job> Banen_CAR_StartYear_Per_Regio    (Regio) := sum(Bron/Banen_CAR_StartYear    * Bron/Woningen_StartYear, Regio_rel) / sum(Bron/Woningen_StartYear, Regio_rel);

		parameter<Job> Banen_W_OV_W_StartYear_Per_NL    := sum(Bron/Banen_W_OV_W_StartYear * Bron/Woningen_StartYear) / sum(Bron/Woningen_StartYear);
		parameter<Job> Banen_BB_StartYear_Per_NL        := sum(Bron/Banen_BB_StartYear     * Bron/Woningen_StartYear) / sum(Bron/Woningen_StartYear);
		parameter<Job> Banen_CAR_StartYear_Per_NL       := sum(Bron/Banen_CAR_StartYear    * Bron/Woningen_StartYear) / sum(Bron/Woningen_StartYear);
	}
	
	#include<Read_Indicators.dms>
	#include<MakeDecayT.dms>
	#include<Impl.dms>
	#include<ODs.dms>
}