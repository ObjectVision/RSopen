// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Bevat de sub-items: Verandering.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Grondgebruik : using = "/SourceData/Grondgebruik"
{
	container Verandering
	{
		parameter<string> Zichtjaar_name := ThisYear/Zichtjaar_name;
		
		unit<UInt32> Regio := =/ModelParameters/Advanced/IndicatorRegio_path;
		
		unit<UInt8> VeranderingK := combine_uint8(Classifications/Grondgebruik/CBSKlasse/Aggr2, /Classifications/Actor/Sector)
		{
			attribute<String> Van_name       := Classifications/Grondgebruik/CBSKlasse/Aggr2/name[first_rel];
			attribute<String> Naar_name      := /Classifications/Actor/Sector/name[second_rel];
			attribute<String> name           := 'Van_'+Van_name+'_Naar_'+Naar_name;
			attribute<String> Label          := name, DialogType = "LabelText";
			
			attribute<UInt8>  from_TransCode := uint8(first_rel) + 1b;
			attribute<UInt8>  to_TransCode   := (uint8(second_rel) + 1b) * 10b;
			attribute<UInt8>  TransCode      := from_TransCode + to_TransCode;
			
			attribute<UInt32> count          := pcount(LU_Mutatie)[uint32];
			
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		}
		
		attribute<Classifications/Grondgebruik/CBSKlasse/Aggr2>       Basisjaar   (AdminDomain) := Classifications/Grondgebruik/CBSKlasse/Aggr2_rel[/BaseData/StartState/Landgebruik/gg_CBS];
		attribute<Classifications/Actor/Sector>                       Zichtjaar   (AdminDomain) := Classifications/Actor/Sector/xSubsector/Sector_rel[Stand/SubSector_rel];
		
		attribute<UInt8>        LU_Basisjaar (rdc_25m) := uint8(basisjaar) + 1b;
		attribute<UInt8>        LU_Y2050     (rdc_25m) := (uint8(Zichtjaar) + 1b)  * 10b;
		attribute<VeranderingK> LU_Mutatie   (rdc_25m) := rlookup(LU_Basisjaar + LU_Y2050, VeranderingK/TransCode);
		
		attribute<bool> NieuweExogeneNatuur (AdminDomain) := IsDefined(ThisVariantData/ExogeenOpleggen/Natuur) && LU_MT_Basisjaar != Classifications/Actor/LU_ModelType/V/Natuur_Totaal, Descr = "Cel waar de oplegging natuur neerzet en het basisjaar nog geen natuur was. Stond tot 5 september 2026 als !LU_MT_Basisjaar == ..., een negatie op de klasse in plaats van op de vergelijking.";
		
		container Per_NL0 := 
			for_each_nedv(
				VeranderingK/name
				,'sum_uint32(LU_Mutatie == VeranderingK/V/'+VeranderingK/name+')[float32] * AdminDomain/NrHaPerCell'
				, void
				, ha
			);
		
		attribute<ha> Per_NL (VeranderingK) := = 'union_data(VeranderingK, '+asItemList('Per_NL0/'+VeranderingK/name)+')';
		
		container Per_Regio := 
			for_each_nedv(
				VeranderingK/name
				,'sum_uint32(LU_Mutatie == VeranderingK/V/'+VeranderingK/name+', Regio/Per_AdminDomain_Fijn)[float32] * AdminDomain/NrHaPerCell'
				, Regio
				, ha
			);
			
		attribute<LU_ModelType> LU_MT_Basisjaar          (AdminDomain) := ThisCasus/Basisjaar/Landgebruikskaart/Result_SA;
		attribute<LU_ModelType> LU_MT_Zichtjaar          (AdminDomain) := Landgebruikskaart/Result_SA;
		
		attribute<Sector> LU_Sector_Basisjaar          (AdminDomain) := LU_ModelType/Sector_rel[LU_MT_Basisjaar];
		attribute<Sector> LU_Sector_Zichtjaar          (AdminDomain) := LU_ModelType/Sector_rel[LU_MT_Zichtjaar];
		
		attribute<Bool> Sector_rel_Verstedelijking                  (AdminDomain) := /Classifications/Actor/Sector/IsStedelijk[Sector_rel];	
		attribute<Bool> Sector_rel_Verstedelijking_Buitenstedelijk  (AdminDomain) := !/BaseData/Omgeving/UrbanContour ? Sector_rel_Verstedelijking : false
		, Descr = "Verstedelijking buiten bestaand bebouwd gebied, de teller van het buitenstedelijke aandeel. Leest sinds #749 dezelfde begrenzing als de zeef en de trede, namelijk de eigen afleiding met peiljaar ModelParameters/BegrenzingBebouwdGebied_jaar. Stond daarvoor op de CBS-bevolkingskernen van 2011, en die zijn in dit model vijftien jaar ouder dan het basisjaar: alles wat tussen 2011 en 2022 is gebouwd telde hier dus als buitenstedelijk terwijl het inmiddels binnen de kom valt.";
		
		attribute<bool> Verstedelijking                             (AdminDomain) := Sector_rel_Verstedelijking_Buitenstedelijk
		, Descr = "Verstedelijking buiten bestaand bebouwd gebied, in hectares. Leest via Sector_rel de stand en niet de landgebruikskaart, en is daarmee ongevoelig voor de maskering die #766 beschrijft. Dat de drie arealenindicatoren in deze container uit verschillende bronnen lezen is sinds #766 een bewuste keuze per indicator en niet een verschil dat er toevallig in is gegroeid: hier de stand, bij NieuweNatuur de kaart, bij WaterbergingVeen weer de stand.

					Let op dat de vruchtbare-grondvarianten van alle drie wel de kaart lezen, want zij snijden op
					VerdwenenVruchtbareLandbouw. Daar is dat de goede bron: de vraag is of de cel landbouw WAS en het niet meer is,
					en dat is precies wat de kaart bijhoudt."
		{
			attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha> Per_NL := sum(float32(.) * AdminDomain/NrHaPerCell);
		}
		
		attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> VerstedelijkingInABCD (AdminDomain) := (/SourceData/Grondgebruik/ABCD/ABCD_sub_rel_25m[uint8] / uint8(Sector_rel_Verstedelijking_Buitenstedelijk))[/SourceData/Grondgebruik/ABCD/ABCD_subK];
		
		attribute<bool> VerstedelijkingOpVruchtbareLandbouwgronden (AdminDomain) := VerdwenenVruchtbareLandbouw && VerstedelijkingInABCD == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A
		{
			attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha> Per_NL := sum(float32(.) * AdminDomain/NrHaPerCell);
			parameter<float32> TovTotaal := Per_NL[float32] / Verstedelijking/Per_NL[float32], Descr = "Aandeel van de verstedelijking dat op vruchtbare landbouwgrond terechtkomt. Sinds ObjectVision/RSopen#634 eist de teller dat de cel ook echt vruchtbare landbouwgrond was en die functie verliest, gelijk aan de verlieskant VerdwenenVruchtbareLandbouw. Zonder die eis telden ook cellen mee die al geen landbouw waren, en overschreden de drie bestemmingsindicatoren samen het totale verlies.";
		}

		// Natuur volgens de landgebruikskaart, dus zowel gealloceerde als exogeen opgelegde natuur.
		attribute<bool> Natuur_Basisjaar (AdminDomain) := MakeDefined(LU_ModelType/IsNatuur[LU_MT_Basisjaar], FALSE);
		attribute<bool> Natuur_Zichtjaar (AdminDomain) := MakeDefined(LU_ModelType/IsNatuur[LU_MT_Zichtjaar], FALSE);
		
		// Cellen die in het zichtjaar natuur zijn en dat in het basisjaar niet waren.
		attribute<bool> NieuweNatuur (AdminDomain) := Natuur_Zichtjaar && !Natuur_Basisjaar
		, Descr = "Cellen die in het zichtjaar natuur zijn en dat in het basisjaar niet waren.

					Deze indicator leest met opzet de kaart en niet de stand, anders dan WaterbergingVeen hieronder, en dat is bij
					#766 nagemeten in plaats van aangenomen. Natuur is in deze toepassing geen gealloceerde sector: in
					ModelParameters/SectorAllocRegio staan alleen wonen, werken en waterberging. Nieuwe natuur komt uitsluitend
					uit VariantData/ExogeenOpleggen, en die heeft in de switch van de landgebruikskaart de tweede case, meteen na
					geen data. Er is dus geen case die haar kan maskeren, en er is ook geen stand om in plaats van de kaart te
					lezen. Gemeten in WLO_hoog_NbSGenuanceerd Y2040: nul hectare gealloceerde natuur, 972.836 ha natuur op de kaart.

					Wat de kaart hier wel afsnijdt is het deel van de levering dat binnen bestaand bebouwd gebied valt, want
					ExogeenOpleggen/MagOpleggen laat dat vervallen voordat de kaart eraan toekomt. Dat is de keuze uit #641 en niet
					een maskering door de switch; hoeveel het is telt ExogeenOpleggen/Opp_GespaardInBebouwdGebied."
		{
			attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
		}
		
		// Cellen die in het basisjaar natuur waren en dat in het zichtjaar niet meer zijn.
		attribute<bool> VerdwenenNatuur (AdminDomain) := Natuur_Basisjaar && !Natuur_Zichtjaar
		, Descr = "De tegenhanger van NieuweNatuur en de evenknie van VerdwenenLandbouw. Sinds ObjectVision/RSopen#652 legt het model bestaande natuur niet meer exogeen op in de NbS-varianten, zodat de allocatie er terecht mag waar geen restrictie op zit. Deze indicator maakt zichtbaar wat dat kost."
		{
			attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
		}

		attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> NieuweNatuurInABCD (AdminDomain) := (/SourceData/Grondgebruik/ABCD/ABCD_sub_rel_25m[uint8] / uint8(NieuweNatuur))[/SourceData/Grondgebruik/ABCD/ABCD_subK];
		
		attribute<bool> NieuweNatuurOpVruchtbareLandbouwgronden (AdminDomain) := VerdwenenVruchtbareLandbouw && NieuweNatuurInABCD == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A
		{
			attribute<ha>      Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha>      Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			parameter<float32> TovTotaal         := Per_NL[float32] / NieuweNatuur/Per_NL[float32], Descr = "Aandeel van de nieuwe natuur dat op vruchtbare landbouwgrond terechtkomt. Zie de toelichting bij VerstedelijkingOpVruchtbareLandbouwgronden/TovTotaal.";
		}

		// De waterbergingsector, in NL2120 de waterberging in het veenweidegebied.
		parameter<Sector> Waterberging_Sector := rlookup(lowercase('Waterberging'), lowercase(/Classifications/Actor/Sector/name)), Descr = "Opgezocht in plaats van rechtstreeks naar Sector/V/Waterberging verwezen. De unit Sector wordt opgebouwd uit de actieve regels in ModelParameters/SectorAllocRegio; staat waterberging uit, dan bestaat die sector niet en levert een rechtstreekse verwijzing een parsefout op. Nu is de uitkomst dan null en zijn de indicatoren hieronder overal false.

					Hier stond tot #766 dezelfde constructie op de landgebruiksklasse, Waterberging_LUT, want de indicator las toen de kaart. Die is met de bronwissel meegegaan; hij had daarna geen enkele lezer meer.";

		attribute<bool> WaterbergingVeen (AdminDomain) := MakeDefined(Sector_rel == Waterberging_Sector, FALSE)
		, Descr = "Waar heeft het model waterberging gealloceerd? Leest sinds #766 de stand en niet de landgebruikskaart, net als Verstedelijking hierboven.

					Waarom dat uitmaakt. Waterberging is de enige gealloceerde sector zonder eigen case in de switch van
					Templates/Indicatoren/Landgebruikskaart: wonen, werken en verblijfsrecreatie komen daar langs de dominantieregel
					op de kaart, waterberging hangt aan de generieke allocatiecase, en die staat achter de afscherming van de
					oplegging, van water en van bestaand bebouwd gebied. Alles wat daarvoor wint maskeert de gealloceerde klasse.

					Gemeten in WLO_hoog_NbSGenuanceerd Y2040, met de kaart van 3 september 2026. Op de stand van 2 september, dus
					stand en basisdata uit dezelfde reeks, scheelt de bron 2 van de 2.909 ha. Op de stand van 31 augustus, die is
					gealloceerd voordat #749 de begrenzing van bebouwd gebied verving, scheelde zij 1.210 van de 2.872 ha ofwel 42
					procent, alles langs de opleggingscase. Dat tweede is een vintageverschil en geen inhoudelijk resultaat, maar de
					indicator meldde het als een sprong van 74,9 procent terwijl de werkelijke verandering 1,28 procent was.

					Zolang deze indicator de kaart las kon zij dus niet naast de bergingscapaciteit gelegd worden, want die leest de
					stand. Nu tellen de twee dezelfde cellen.

					Wat er niet mee verandert: de kaart houdt haar voorrangsregel, en het verschil tussen kaart en stand wordt
					geteld in Landgebruikskaart/Toets_AllocatieZonderEigenCase. De exogeen opgelegde waterstroom van veenbouwsteen
					9a en 9b telt hier net zo min mee als voorheen: die komt als Water_Totaal op de kaart en niet als
					Waterberging_Totaal, en staat sowieso niet in de stand."
		{
			attribute<ha> Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha> Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
		}
		
		attribute</SourceData/Grondgebruik/ABCD/ABCD_subK> WaterbergingVeenInABCD (AdminDomain) := (/SourceData/Grondgebruik/ABCD/ABCD_sub_rel_25m[uint8] / uint8(WaterbergingVeen))[/SourceData/Grondgebruik/ABCD/ABCD_subK];
		
		attribute<bool> WaterbergingVeenOpVruchtbareLandbouwgronden (AdminDomain) := VerdwenenVruchtbareLandbouw && WaterbergingVeenInABCD == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A
		{
			attribute<ha>      Per_Regio (Regio) := sum(float32(.) * AdminDomain/NrHaPerCell, Regio/Per_AdminDomain_Fijn);
			parameter<ha>      Per_NL            := sum(float32(.) * AdminDomain/NrHaPerCell);
			parameter<float32> TovTotaal         := Per_NL[float32] / WaterbergingVeen/Per_NL[float32], Descr = "Aandeel van de waterberging dat op vruchtbare landbouwgrond terechtkomt. Zie de toelichting bij VerstedelijkingOpVruchtbareLandbouwgronden/TovTotaal.";
		}

		// Aantal cellen landbouwgrond dat verdwijnt door iets tussen 2120 en basisjaar
		attribute<bool> VerdwenenLandbouw (AdminDomain) := LU_ModelType/IsLandbouw[LU_MT_Basisjaar] &&  NOT(LU_ModelType/IsLandbouw)[LU_MT_Zichtjaar], StorageName = "=replace(StorageStr, '@V@', 'VerdwenenLandbouw')", StorageType = "tif";
		// Aantal cellen vruchtbare landbouwgrond dat verdwijnt door iets tussen 2120 en basisjaar
		attribute<bool> VerdwenenVruchtbareLandbouw (AdminDomain) := VerdwenenLandbouw ? /SourceData/Grondgebruik/ABCD/ABCD_sub_rel_25m == /SourceData/Grondgebruik/ABCD/ABCD_subK/V/A : FALSE, StorageName = "=replace(StorageStr, '@V@', 'VerdwenenVruchtbareLandbouw')", StorageType = "tif";

		parameter<string> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';


		attribute<Classifications/Grondgebruik/CBSKlasse/Aggr/Groen> Groen_Basisjaar  (AdminDomain) := ThisCasus/Basisjaar/Grondgebruik/Groen;
		attribute<Classifications/Grondgebruik/CBSKlasse/Aggr/Groen> Groen_Zichtjaar  (AdminDomain) := switch(
																			case(LU_MT_Basisjaar == LU_MT_Zichtjaar, Groen_Basisjaar)
																			, case(LU_ModelType/IsLandbouw[LU_MT_Zichtjaar], Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/V/overige_agrarisch_gebruik)
																			, case(LU_MT_Zichtjaar == LU_ModelType/V/Natuur_Totaal, Classifications/Grondgebruik/CBSKlasse/Aggr/Groen/V/Natuur)
																			, null_b
																			);
	}
}