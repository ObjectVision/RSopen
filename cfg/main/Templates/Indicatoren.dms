	// }
	
	container Funderingsschade
	{
		container Src
		: Descr = "Zelfde formules als in de suitability (Suitability_Wonen_perOP_T/Verwervingskosten/Funderingsschade), maar met de ongemaskeerde woningwaarde. De suitability-versie is per OP vermenigvuldigd met IsBeschikbaar_zichtjaar; daardoor zou het indicatortotaal van de Waardevermindering afhangen van de beschikbaarheid van een willekeurig gekozen OP."
		{
			attribute<Eur> k            (CompactedAdminDomain) := SourceData/Vastgoed/Funderingsschade/per_pand/k, Descr = "Funderingsschade per cel: per-pand-toerekening k_i, na per-woning-cap (P99) en herverdeling binnen de buurt, uitgesmeerd via de toedelingsmatrix.";
			attribute<Eur> Woningwaarde (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, BaseData/Suitabilities/Wonen/Verwervingskosten/Woningen/Totaal), Descr = "Verwervingswaarde van de bestaande woningen per cel, zonder OP-beschikbaarheidsmasker; cap voor de waardevermindering.";

			parameter<Float32> NCW_deler := (1f+ModelParameters/Wonen/Discontovoet)^float32((VariantParameters/VariantK/JaarWaarinFunderingschadeZichtbaar[Variant_rel] - ModelParameters/Model_StartYear) / 1[YearRange]);

			attribute<Eur> Herstelkosten      (CompactedAdminDomain) := = VariantParameters/VariantK/FunderingschadeWordtHersteld[Variant_rel]  // We gaan ervanuit dat deze geincasseerd worden, ongeacht evt sloop in een zichtjaar
																				 ? 'k / NCW_deler'
																				 : 'const(0[Eur], CompactedAdminDomain)';																			

			attribute<Eur> Waardevermindering (CompactedAdminDomain) :=	= VariantParameters/VariantK/FunderingschadeWordtHersteld[Variant_rel] // We gaan ervan uit dat deze niet groter kan zijn dan de bestaande woningwaarde
																				? 'const(0[Eur], CompactedAdminDomain)'
																				: 'min_elem(k, Woningwaarde) / NCW_deler'; 
		}
		
		attribute<bool> AllocatieHeeftPlaatsgevonden (AdminDomain) := IsDefined(ThisYear/Sector_rel);
		
		container Waardevermindering
		{
			attribute<Eur> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Waardevermindering) / float32(AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Resterend                        (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Waardevermindering) / float32(!AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Totaal                           (AdminDomain) := MakeDefined(WaarAllocatieHeeftPlaatsgevonden, 0[Eur]) + MakeDefined(Resterend, 0[Eur]);
		}
		
		container Herstelkosten
		{
			attribute<Eur> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Herstelkosten) / float32(AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Resterend                        (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Herstelkosten) / float32(!AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Totaal                           (AdminDomain) := MakeDefined(WaarAllocatieHeeftPlaatsgevonden, 0[Eur]) + MakeDefined(Resterend, 0[Eur]);
		}
		
		container Totaal
		{
			attribute<Eur> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := Waardevermindering/WaarAllocatieHeeftPlaatsgevonden + Herstelkosten/WaarAllocatieHeeftPlaatsgevonden;
			attribute<Eur> Resterend                        (AdminDomain) := Waardevermindering/Resterend + Herstelkosten/Resterend;
			attribute<Eur> Totaal                           (AdminDomain) := MakeDefined(WaarAllocatieHeeftPlaatsgevonden, 0[Eur]) + MakeDefined(Resterend, 0[Eur]);
		}
	}
	
	container WaardeNabijheidGroen
	: Descr = "Hedonische waardering van natuur- en waternabijheid voor woningen (issues #481/#566). Semi-log rs_groen-model: prijs = exp(... + b_nat * fr_natuur_tot2500m + b_wat * fr_water_500m). Fracties per cel gemeten zoals in de schatting (PriceIndices spec rs_groen, LGN2024): natuur als aandeel in de schijf 0-2500m (gerekend op het 100m-grid), water als aandeel in de schijf 0-500m."
	{
		parameter<string>  AD_short := ModelParameters/Advanced/AdminDomain_ref;

		container Fracties
		: Descr = "Natuur- en waterfracties per cel voor basis- en zichtjaar. Basisjaar komt 1-op-1 uit de statische LGN-groenfracties (zelfde bron en definitie als de schatting); zichtjaar-celwaarden volgen het Groen_Zichtjaar-patroon: ongewijzigd grondgebruik houdt de LGN-basisjaarwaarde, allocatie-mutaties overschrijven."
		{
			attribute<float32> Natuur_Basisjaar    (AdminDomain) := SourceData/Grondgebruik/LGN/Groenfracties/fr_natuur_tot2500m[AdminDomain/rdc_25m_rel], Descr = "Aandeel natuur in de schijf 0-2500m, basisjaar (LGN).";
			attribute<float32> Water_Basisjaar     (AdminDomain) := SourceData/Grondgebruik/LGN/Groenfracties/fr_water_500m[AdminDomain/rdc_25m_rel],      Descr = "Aandeel water in de schijf 0-500m, basisjaar (LGN).";

			attribute<float32> NatuurCel_Basisjaar (AdminDomain) := SourceData/Grondgebruik/LGN/Groenfracties/natuur[AdminDomain/rdc_25m_rel];
			attribute<float32> WaterCel_Basisjaar  (AdminDomain) := SourceData/Grondgebruik/LGN/Groenfracties/water[AdminDomain/rdc_25m_rel];

			attribute<float32> NatuurCel_Zichtjaar (AdminDomain) := switch(
					case(ThisYear/Grondgebruik/Verandering/LU_MT_Zichtjaar == ThisYear/Grondgebruik/Verandering/LU_MT_Basisjaar, NatuurCel_Basisjaar)
					, case(ThisYear/Grondgebruik/Verandering/LU_MT_Zichtjaar == /Classifications/Actor/LU_ModelType/V/Natuur_Totaal, 1f)
					, 0f
				), Descr = "Natuur per cel in het zichtjaar (hedonische definitie): ongewijzigd grondgebruik houdt de LGN-basisjaarwaarde; cellen die naar Natuur_Totaal veranderen (allocatie of exogene oplegging) worden 1; overige veranderingen (verstedelijking, landbouw) worden 0.";

			attribute<bool>    IsBAGnieuwbouwWonen (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, ThisVariantAllocatie/StartState_metBAGnieuwbouw/OPMatch_BAGnieuwbouw/IsBAGnieuwbouwWonen), FALSE), Descr = "BAG-nieuwbouwcel (issue #550): heeft wel een gematchte OP_rel maar geen fysieke OP-inrichting; houdt daarom de basisjaar-waterwaarde.";
			attribute<float32> WaterCel_Zichtjaar  (AdminDomain) := switch(
					case(ThisYear/Grondgebruik/Verandering/LU_MT_Zichtjaar == ThisYear/Grondgebruik/Verandering/LU_MT_Basisjaar, WaterCel_Basisjaar)
					, case(IsDefined(Stand/OP_rel) && !IsBAGnieuwbouwWonen, ThisVariantClassifications/Vastgoed/OP_Buurt/Terreinoppervlakte/Totaal/Water[Stand/OP_rel][float32] / 10000f)
					, WaterCel_Basisjaar
				), Descr = "Water per cel in het zichtjaar: LU-water verandert nooit (#596), maar op cellen die naar wonen zijn ontwikkeld bepaalt de OP-inrichting het wateraandeel (NbS-Blauw-pakketten hebben tot ~0,68 openbaar water); Terreinoppervlak is m2 per ha, dus /10000 voor de celfractie.";

			// zichtjaar-fracties: zelfde kernels en (statische) noemers als de basisjaar-meting
			attribute<float32> NatuurCel_Zichtjaar_100m (rdc_100m) := mean(NatuurCel_Zichtjaar, AdminDomain/rdc_100m_rel);
			attribute<float32> Natuur_Zichtjaar_100m    (rdc_100m) := potential(NatuurCel_Zichtjaar_100m, /Geography/Distmatrices_100m/pot2500m/Flat2) / SourceData/Grondgebruik/LGN/Groenfracties/n_gedekt_2500m_100m;
			attribute<float32> Natuur_Zichtjaar         (AdminDomain) := Natuur_Zichtjaar_100m[AdminDomain/rdc_100m_rel], Descr = "Aandeel natuur in de schijf 0-2500m, zichtjaar.";

			attribute<float32> Water_Zichtjaar (AdminDomain) := = 'potential(WaterCel_Zichtjaar, /Geography/Distmatrices_'+AD_short+'/pot500m/Flat2) / SourceData/Grondgebruik/LGN/Groenfracties/n_gedekt_500m[AdminDomain/rdc_25m_rel]', Descr = "Aandeel water in de schijf 0-500m, zichtjaar.";
		}

		attribute<float32> b_natuur (/Classifications/Vastgoed/WP4) := = 'union_data(/Classifications/Vastgoed/WP4, '+asItemList('/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+/Classifications/Vastgoed/WP4/name+'/Result/fr_natuur_tot2500m')+')',	Descr = "Hedonische coefficient voor de natuurfractie (0-2500m) per WP4, uit de rs_groen-set.";
		attribute<float32> b_water  (/Classifications/Vastgoed/WP4) := = 'union_data(/Classifications/Vastgoed/WP4, '+asItemList('/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+/Classifications/Vastgoed/WP4/name+'/Result/fr_water_500m')+')',	Descr = "Hedonische coefficient voor de waterfractie (0-500m) per WP4, uit de rs_groen-set.";

		unit<uint32> Bestaand := /BaseData/Suitabilities/Wonen/Verwervingskosten/vbo_startjaar
		, Descr = "Waardeverandering van de bestaande woningvoorraad door verandering in natuur- en waternabijheid."
		{
			container PrijsZonderGroen_perWP4 :=
				for_each_ne(
					/Classifications/Vastgoed/WP4/name
					, 'Templates/Suitabilities/Woningwaarde_perWoningType_zonderGroen_T('+string(id(/Classifications/Vastgoed/WP4))+'[/Classifications/Vastgoed/WP4])'
				), Descr = "Hedonische woningprijs zonder de groen/water-termen (P_rest), per WP4.";

			attribute<Eur_Woning> P_rest  :=
				= '(add('+asItemList(
						'float32(WP4_rel == /Classifications/Vastgoed/WP4/V/'+/Classifications/Vastgoed/WP4/name+') * PrijsZonderGroen_perWP4/'+/Classifications/Vastgoed/WP4/name+'/PrijsZonderGroen[AdminDomain_rel]'
				  )+'))'
			,	Descr = "Hedonische woningprijs zonder de groen/water-termen per VBO.";

			attribute<float32>    b_nat_vbo           := b_natuur[WP4_rel], Descr = "Natuurcoefficient horend bij het WP4 van deze VBO.";
			attribute<float32>    b_wat_vbo           := b_water[WP4_rel],  Descr = "Watercoefficient horend bij het WP4 van deze VBO.";
			attribute<float32>    GroenTerm_Basisjaar := b_nat_vbo * Fracties/Natuur_Basisjaar[AdminDomain_rel] + b_wat_vbo * Fracties/Water_Basisjaar[AdminDomain_rel];
			attribute<float32>    GroenTerm_Zichtjaar := b_nat_vbo * Fracties/Natuur_Zichtjaar[AdminDomain_rel] + b_wat_vbo * Fracties/Water_Zichtjaar[AdminDomain_rel];

			attribute<Eur_Woning> P_basisjaar                   := P_rest * exp(GroenTerm_Basisjaar), Descr = "Prijs met de basisjaar-fracties.";
			attribute<Eur_Woning> P_zichtjaar                   := P_rest * exp(GroenTerm_Zichtjaar), Descr = "Prijs met de zichtjaar-fracties.";

			attribute<Eur_Woning> dWaarde_perVBO                := P_zichtjaar - P_basisjaar, Descr = "Waardeverandering per bestaande woning door verandering in natuur/water-nabijheid.";
			attribute<Eur>        dWaarde         (AdminDomain) := sum(dWaarde_perVBO, AdminDomain_rel) * 1[woning],  Descr = "Som van de waardeverandering van bestaande woningen per cel.";
		}
		
		container Nieuwbouw
		: Descr = "Groen/waterwaarde van nieuwbouwwoningen: de in de prijs ingebakken premie voor natuur- en waternabijheid, over de cumulatieve nieuwbouw sinds het basisjaar (issue #558)."
		{
			unit<UInt8> OP := ThisVariantClassifications/Vastgoed/OP;

			attribute<Eur_Woning> P_nieuwbouw            (AdminDomain) := = '(add('+asItemList('float32(Stand/OP_rel == '+string(id(OP))+'[OP]) * ThisVariantData/Suitability/src/Wonen/Impl/Woningwaarde_perOP/'+OP/name+'/Prijs_perWoning_zWeging')+'))[Eur_Woning]',	Descr = "Hedonische nieuwbouwprijs van de in deze cel gealloceerde OP; bevat sinds #566 de basisjaar-bevroren groen/water-termen.";
			attribute<float32>    B_nat                  (AdminDomain) := b_natuur[OP/WP4_rel[Stand/OP_rel]], Descr = "Natuurcoefficient horend bij het WP4 van de gealloceerde OP.";
			attribute<float32>    B_wat                  (AdminDomain) := b_water[OP/WP4_rel[Stand/OP_rel]],  Descr = "Watercoefficient horend bij het WP4 van de gealloceerde OP.";
			attribute<Woning>     n_nieuwbouw_cumulatief (AdminDomain) := max_elem(Stand/Aantal_Woningen_Totaal - StandBasisjaar/Aantal_Woningen_Totaal, 0[Woning]), Descr = "Cumulatieve nieuwbouw t.o.v. basisjaar: voorraad zichtjaar - voorraad basisjaar, geklemd op >=0. Telt alle bouw basisjaar->zichtjaar (incl. eerste-decennium BAG-nieuwbouw, issue #550, die in Stand maar niet in StandBasisjaar zit) i.p.v. enkel de bouw van het laatste decennium (issue #558). Netto-verschil netteert sloop/herontwikkeling weg, zodat er geen dubbeltelling met de Bestaand-term ontstaat.";
			attribute<float32>    GroenTerm_Basisjaar    (AdminDomain) := B_nat * Fracties/Natuur_Basisjaar + B_wat * Fracties/Water_Basisjaar;
			attribute<float32>    GroenTerm_Zichtjaar    (AdminDomain) := B_nat * Fracties/Natuur_Zichtjaar + B_wat * Fracties/Water_Zichtjaar;
			attribute<Eur_Woning> P_rest                 (AdminDomain) := P_nieuwbouw * exp(-GroenTerm_Basisjaar), Descr = "Nieuwbouwprijs zonder de groen/water-termen (de suitability-prijs bevat de basisjaar-termen, die hier worden uitgedeeld).";
			attribute<Eur>        dWaarde                (AdminDomain) := n_nieuwbouw_cumulatief * P_rest * (exp(GroenTerm_Zichtjaar) - 1f),	Descr = "Groen/waterwaarde van cumulatieve nieuwbouw per cel: aantal * (prijs met zichtjaar-fracties - prijs zonder groen/water-termen).";
		}

		// near-zero -> null (issue #566: 0-waarden transparant in de kaart; null wordt NoData in de tif)
		attribute<Eur> WaardeVeranderingDoorGroenVerandering_BestaandeWoningen (AdminDomain) := switch(
																									case(Bestaand/dWaarde < 0.01f && Bestaand/dWaarde > -0.01f, null_f)
																									,Bestaand/dWaarde
																								), StorageName = "=replace(StorageStr, '@V@', 'WaardeVeranderingDoorGroenVerandering_BestaandeWoningen')", StorageType = "gdalwrite.grid";
		attribute<Eur> WaardeDoorGroenNabij_NieuwbouwWoningen                  (AdminDomain) := switch(
																									case(Nieuwbouw/dWaarde < 0.01f && Nieuwbouw/dWaarde > -0.01f, null_f)
																									,Nieuwbouw/dWaarde
																								), StorageName = "=replace(StorageStr, '@V@', 'WaardeDoorGroenNabij_NieuwbouwWoningen')", StorageType = "gdalwrite.grid";
		attribute<Eur> WaardeVeranderingDoorGroenVerandering_Woningen          (AdminDomain) := switch(
																									case(IsNull(WaardeVeranderingDoorGroenVerandering_BestaandeWoningen) && IsNull(WaardeDoorGroenNabij_NieuwbouwWoningen), null_f)
																									,MakeDefined(WaardeVeranderingDoorGroenVerandering_BestaandeWoningen, 0[Eur]) + MakeDefined(WaardeDoorGroenNabij_NieuwbouwWoningen, 0[Eur])
																								), StorageName = "=replace(StorageStr, '@V@', 'WaardeVeranderingDoorGroenVerandering_Woningen')", StorageType = "gdalwrite.grid";

		parameter<string> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
	}
	
	#include<Woningwaarde.dms>
	
	container SloopAlsGevolgVanExogeneOplegging
	{
		attribute<bool>   NeedsToBeEmptiedDueToExogenousDevelopments (CompactedAdminDomain) := ='collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, IsDefined(/VariantData/'+variant_name+'/ExogeenOpleggen/Totaal))';
		attribute<woning> Wonen                                      (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Wonen/totaal : 0[woning]'; //, StorageName = "=replace(StorageStr, '@V@', 'Wonen')", StorageType = "gdalwrite.grid";
		attribute<job>    Werken                                     (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Werken/totaal : 0[job]'; //, StorageName = "=replace(StorageStr, '@V@', 'Werken')", StorageType = "gdalwrite.grid";
		// attribute<woning> Wonen                                      (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Wonen/totaal : 0[woning]', StorageName = "=replace(StorageStr, '@V@', 'Wonen')", StorageType = "gdalwrite.grid";
		// attribute<job>    Werken                                     (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Werken/totaal : 0[job]', StorageName = "=replace(StorageStr, '@V@', 'Werken')", StorageType = "gdalwrite.grid";
		
		// parameter<string> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SloopAlsGevolgVanExogeneOplegging_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
	}
	
	// Kosten van de sloop die volgt uit exogeen opgelegde nieuwe natuur (#519). Beide indicatoren maskeren een bestaande per-cel kostenkaart (uit de wonen-suitability) met de cellen die door de oplegging leeggemaakt worden.
	container UitkoopEnSloopkostenNieuweNatuur
	: Descr = "Issues #520 (uitkoopkosten) en #549 (sloopkosten) van de woningen die gesloopt worden als gevolg van exogeen opgelegde nieuwe natuur (#519)."
	{
		attribute<Bool> IsExogeneSloopCel (AdminDomain) := MakeDefined(recollect_by_cond(AdminDomain/IsCompactedDomain, SloopAlsGevolgVanExogeneOplegging/NeedsToBeEmptiedDueToExogenousDevelopments), FALSE)
		, Descr = "Cel die door exogeen opgelegde ontwikkeling (nieuwe natuur) wordt leeggemaakt; bestaande woningen worden daar gesloopt.";

		attribute<Eur>  Uitkoopkosten     (AdminDomain) := IsExogeneSloopCel ? MakeDefined(/BaseData/Suitabilities/Wonen/Verwervingskosten/Woningen/Totaal, 0[Eur]) : 0[Eur]
		, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Uitkoopkosten_NieuweNatuur_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
		, StorageType = "gdalwrite.grid"
		, Descr = "Issue #520: vastgoedwaarde (verwervingskosten) van de bestaande woningen in de leeggemaakte cellen.";
		 
		attribute<Eur>  Sloopkosten       (AdminDomain) := IsExogeneSloopCel ? MakeDefined(/BaseData/Suitabilities/Wonen/Sloopkosten/Totaal, 0[Eur]) : 0[Eur]
		, StorageName = "='%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Sloopkosten_NieuweNatuur_'+Zichtjaar_name+'_Eur_'+/ModelParameters/StudyArea+'.tif'"
		, StorageType = "gdalwrite.grid"
		, Descr = "Issue #549: sloopkosten (m2 per WP4 maal eenheidskost) van de bestaande woningen in de leeggemaakte cellen.";
	}
}