	container Funderingsschade
	{
		container Src := = 'ThisVariantData/Suitability/'+Zichtjaar_name+'/Wonen/eengezins_VrijeSector/perOP/StedelijkerEGVS/Verwervingskosten/Funderingsschade'; // Dit kan any WP4 of OP zijn.
		
		attribute<bool> AllocatieHeeftPlaatsgevonden (AdminDomain) := IsDefined(ThisYear/Sector_rel);
		
		container Waardevermindering
		{
			attribute<Eur> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Waardevermindering) / float32(AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Resterend                        (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Waardevermindering) / float32(!AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Totaal                           (AdminDomain) := MakeDefined(WaarAllocatieHeeftPlaatsgevonden, 0[Eur]) + MakeDefined(Resterend, 0[Eur]);
		}
		
		container Herstelkosten
		{
			attribute<Eur> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Herstelkosten) / float32(AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Resterend                        (AdminDomain) := recollect_by_cond(AdminDomain/IsCompactedDomain, Src/Herstelkosten) / float32(!AllocatieHeeftPlaatsgevonden);
			attribute<Eur> Totaal                           (AdminDomain) := MakeDefined(WaarAllocatieHeeftPlaatsgevonden, 0[Eur]) + MakeDefined(Resterend, 0[Eur]);
		}
		
		container Totaal
		{
			attribute<Eur> WaarAllocatieHeeftPlaatsgevonden (AdminDomain) := Waardevermindering/WaarAllocatieHeeftPlaatsgevonden + Herstelkosten/WaarAllocatieHeeftPlaatsgevonden;
			attribute<Eur> Resterend                        (AdminDomain) := Waardevermindering/Resterend + Herstelkosten/Resterend;
			attribute<Eur> Totaal                           (AdminDomain) := MakeDefined(WaarAllocatieHeeftPlaatsgevonden, 0[Eur]) + MakeDefined(Resterend, 0[Eur]);
		}
	}

	container SloopAlsGevolgVanExogeneOplegging
	{
		attribute<bool>   NeedsToBeEmptiedDueToExogenousDevelopments (CompactedAdminDomain) := ='collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, IsDefined(/VariantData/'+variant_name+'/ExogeenOpleggen/Totaal))';
		attribute<woning> Wonen                                      (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Wonen/totaal : 0[woning]'; //, StorageName = "=replace(StorageStr, '@V@', 'Wonen')", StorageType = "gdalwrite.grid";
		attribute<job>    Werken                                     (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Werken/totaal : 0[job]'; //, StorageName = "=replace(StorageStr, '@V@', 'Werken')", StorageType = "gdalwrite.grid";
		// attribute<woning> Wonen                                      (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Wonen/totaal : 0[woning]', StorageName = "=replace(StorageStr, '@V@', 'Wonen')", StorageType = "gdalwrite.grid";
		// attribute<job>    Werken                                     (CompactedAdminDomain) := ='NeedsToBeEmptiedDueToExogenousDevelopments ? /Allocatie/'+casus_name+'/StartState_metBAGnieuwbouw/Werken/totaal : 0[job]', StorageName = "=replace(StorageStr, '@V@', 'Werken')", StorageType = "gdalwrite.grid";

		// parameter<string> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/SloopAlsGevolgVanExogeneOplegging_@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
	}

	container WaardeNabijheidGroen
	: Descr = "Hedonische waardering van nabij groen voor woningen (issue #481). Semi-log model: prijs = exp(... + d_groennabij * groen_nabij + ...)."
	{
		attribute<Classifications/Grondgebruik/CBSKlasse/Aggr/Groen> Groen_Basisjaar  (AdminDomain) := ThisYear/Grondgebruik/Verandering/Groen_Basisjaar;
		attribute<Classifications/Grondgebruik/CBSKlasse/Aggr/Groen> Groen_Zichtjaar  (AdminDomain) := ThisYear/Grondgebruik/Verandering/Groen_Zichtjaar;

		attribute<bool>    IsGroenCel_Basisjaar (AdminDomain) := IsDefined(Groen_Basisjaar),	Descr = "Per-cel groen (CBS IsGroen_breed) in basisjaar.";
		attribute<bool>    IsGroenCel_Zichtjaar (AdminDomain) := IsDefined(Groen_Zichtjaar),	Descr = "Per-cel groen in zichtjaar; ongewijzigde cellen houden hun basisjaar-groen.";

		parameter<string>  AD_short := ModelParameters/Advanced/AdminDomain_ref;
		attribute<bool>    GroenNabij_Basisjaar (AdminDomain) := = 'potential(IsGroenCel_Basisjaar[float32], /Geography/Distmatrices_'+AD_short+'/pot100m/Flat2) >= 0.5f * potential(const(1f, AdminDomain), /Geography/Distmatrices_'+AD_short+'/pot100m/Flat2)',	Descr = "Groen-nabij basisjaar (>=50% groen binnen 100m).";
		attribute<bool>    GroenNabij_Zichtjaar (AdminDomain) := = 'potential(IsGroenCel_Zichtjaar[float32], /Geography/Distmatrices_'+AD_short+'/pot100m/Flat2) >= 0.5f * potential(const(1f, AdminDomain), /Geography/Distmatrices_'+AD_short+'/pot100m/Flat2)',	Descr = "Groen-nabij zichtjaar (>=50% groen binnen 100m).";

		attribute<float32> d_groennabij (/Classifications/Vastgoed/WP4) := = 'union_data(/Classifications/Vastgoed/WP4, '+asItemList('/BaseData/Suitabilities/Wonen/PrijsIndex/ReadCoefficients_WP4/'+/Classifications/Vastgoed/WP4/name+'/Result/d_groennabij')+')',	Descr = "Hedonische coefficient voor groen-nabij per WP4.";

		unit<uint32> Bestaand := /BaseData/Suitabilities/Wonen/Verwervingskosten/vbo_startjaar
		, Descr = "Waardeverandering van de bestaande woningvoorraad door verandering in groen-nabij."
		{
			container PrijsZonderGroen_perWP4 :=
				for_each_ne(
					/Classifications/Vastgoed/WP4/name
					, 'Templates/Suitabilities/Woningwaarde_perWoningType_zonderGroen_T('+string(id(/Classifications/Vastgoed/WP4))+'[/Classifications/Vastgoed/WP4])'
				), Descr = "Hedonische woningprijs zonder groen (P_rest), per WP4.";

			attribute<Eur_Woning> P_rest  :=
				= '(add('+asItemList(
						'float32(WP4_rel == /Classifications/Vastgoed/WP4/V/'+/Classifications/Vastgoed/WP4/name+') * PrijsZonderGroen_perWP4/'+/Classifications/Vastgoed/WP4/name+'/PrijsZonderGroen[AdminDomain_rel]'
				  )+'))'
			,	Descr = "Hedonische woningprijs zonder groen per VBO.";

			attribute<float32>    Groen_coeff                   := d_groennabij[WP4_rel], Descr = "groen coefficient horend bij specifiek WP4_rel";
			attribute<float32>    GroenNabij_basisjaar          := float32(../GroenNabij_Basisjaar[AdminDomain_rel]);
			attribute<float32>    GroenNabij_Zichtjaar          := float32(../GroenNabij_Zichtjaar[AdminDomain_rel]);

			attribute<Eur_Woning> P_basisjaar                   := P_rest * exp(groen_coeff * GroenNabij_basisjaar), Descr = "Prijs met onze groen-basisjaar definitie.";
			attribute<Eur_Woning> P_zichtjaar                   := P_rest * exp(groen_coeff * GroenNabij_Zichtjaar), Descr = "Prijs met onze groen-zichtjaar definitie.";

			attribute<Eur_Woning> dWaarde_perVBO                := P_zichtjaar - P_basisjaar, Descr = "Waardeverandering per bestaande woning door verandering in groen-nabij.";
			attribute<Eur>        dWaarde         (AdminDomain) := sum(dWaarde_perVBO, AdminDomain_rel) * 1[woning],  Descr = "Som van de waardeverandering van bestaande woningen per cel.";
		}

		container Nieuwbouw
		: Descr = "Groenwaarde van nieuwbouwwoningen: de in de prijs ingebakken premie voor groen-nabij, over de cumulatieve nieuwbouw sinds het basisjaar (issue #558)."
		{
			unit<UInt8> OP := ThisVariantClassifications/Vastgoed/OP;

			attribute<Eur_Woning> P_nieuwbouw            (AdminDomain) := = '(add('+asItemList('float32(Stand/OP_rel == '+string(id(OP))+'[OP]) * ThisVariantData/Suitability/src/Wonen/Impl/Woningwaarde_perOP/'+OP/name+'/Prijs_perWoning_zWeging')+'))[Eur_Woning]',	Descr = "Hedonische nieuwbouwprijs van de in deze cel gealloceerde OP.";
			attribute<float32>    Groen_coeff            (AdminDomain) := d_groennabij[OP/WP4_rel[Stand/OP_rel]], Descr = "groen coefficient horend bij specifiek WP4_rel";
			attribute<float32>    GroenNabij_basisjaar   (AdminDomain) := float32(../GroenNabij_Basisjaar);
			attribute<Woning>     n_nieuwbouw_cumulatief (AdminDomain) := max_elem(Stand/Aantal_Woningen_Totaal - StandBasisjaar/Aantal_Woningen_Totaal, 0[Woning]), Descr = "Cumulatieve nieuwbouw t.o.v. basisjaar: voorraad zichtjaar - voorraad basisjaar, geklemd op >=0. Telt alle bouw basisjaar->zichtjaar (incl. eerste-decennium BAG-nieuwbouw, issue #550, die in Stand maar niet in StandBasisjaar zit) i.p.v. enkel de bouw van het laatste decennium (issue #558). Netto-verschil netteert sloop/herontwikkeling weg, zodat er geen dubbeltelling met de Bestaand-term ontstaat.";
			attribute<Eur_Woning> P_rest                 (AdminDomain) := P_nieuwbouw * exp(-groen_coeff * GroenNabij_basisjaar), Descr = "Nieuwbouwprijs zonder groenterm.";
			attribute<Eur>        dWaarde                (AdminDomain) := float32(GroenNabij_Zichtjaar) * n_nieuwbouw_cumulatief * P_rest * (exp(Groen_coeff) - 1f),	Descr = "Groenwaarde van cumulatieve nieuwbouw per cel: aantal * (prijs met groen - prijs zonder groen), waar groen-nabij aanwezig.";
		}

		attribute<Eur> WaardeVeranderingDoorGroenVerandering_BestaandeWoningen (AdminDomain) := switch(
																									case(Bestaand/dWaarde < 0.01f && Bestaand/dWaarde > -0.01f, 0f)
																									,Bestaand/dWaarde
																								), StorageName = "=replace(StorageStr, '@V@', 'WaardeVeranderingDoorGroenVerandering_BestaandeWoningen')", StorageType = "gdalwrite.grid";
		attribute<Eur> WaardeDoorGroenNabij_NieuwbouwWoningen                  (AdminDomain) := switch(
																									case(Nieuwbouw/dWaarde < 0.01f && Nieuwbouw/dWaarde > -0.01f, 0f)
																									,Nieuwbouw/dWaarde
																								), StorageName = "=replace(StorageStr, '@V@', 'WaardeDoorGroenNabij_NieuwbouwWoningen')", StorageType = "gdalwrite.grid";
		attribute<Eur> WaardeVeranderingDoorGroenVerandering_Woningen          (AdminDomain) := MakeDefined(WaardeVeranderingDoorGroenVerandering_BestaandeWoningen, 0[Eur]) + MakeDefined(WaardeDoorGroenNabij_NieuwbouwWoningen, 0[Eur]), StorageName = "=replace(StorageStr, '@V@', 'WaardeVeranderingDoorGroenVerandering_Woningen')", StorageType = "gdalwrite.grid";

		parameter<string> StorageStr := '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/@V@_'+Zichtjaar_name+'_'+/ModelParameters/StudyArea+'.tif';
	}

	#include<Woningwaarde.dms>
}