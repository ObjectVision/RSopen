////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// In deze module wordt per subsector de eventuele voorkeurslocaties ('treden') beschreven, van hoog naar laag.
// Welke er beschouwd worden is bepaald in de variant parameters in Trede_Variant in VariantK Identifier for the
// subsector Source container for additional data
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Trede_T
: Descr = "In deze module wordt per subsector de eventuele voorkeurslocaties ('treden') beschreven, van hoog naar laag. Welke er beschouwd worden is bepaald in de variant parameters in Trede_Variant in VariantK"
{
	parameter<Sector/xSubsector> id : Descr = "Identifier for the subsector";
	container Src : Descr = "Source container for additional data";
	//
	
	parameter<String> SectorxSubsector_name := Sector/xSubsector/name[id], Descr = "Name of the subsector";
	parameter<String> Sector_name           := Sector/xSubsector/Sector_name[id], Descr = "Name of the sector";
	parameter<String> Subsector_name        := Sector/xSubsector/Subsector_name[id], Descr = "Name of the sector";
	
	container Klassen := 
		for_each_nedv(
			Impl/Klasse/Label
			,replace(
				Impl/Klasse/RefSrc+' ? Impl/Klasse/V/'+Impl/Klasse/name+' : null_u[Impl/Klasse]'
				,'@S@', 'Src/'
				,'@X@', Sector_name
				,'@SS@', Subsector_name
			)
			, AdminDomain
			, Impl/Klasse
		), Descr = "Per klasse de klasse-index waar alle asvlaggen waar zijn, anders null. Sinds #775 alleen nog voor de visualisatie per klasse hieronder; de ladder zelf komt uit Impl/Assen, die dezelfde vlaggen per as combineert zonder een attribuut per klasse."
	{
		attribute<uint32>            per_domain_brushcolor        (AdminDomain) := AdminDomain/IsStudyArea ? per_domain_grid_visualisatie -> BrushColor : null_u, DialogType = "BrushColor", Descr = "Visualization per admindomain";
		attribute<Impl/Visualisatie> per_domain_grid_visualisatie (AdminDomain) := = 'ArgMin_ifdefined('+asItemList(Impl/Klasse/Label)+')[Impl/Visualisatie]', Descr = "Visualization per admindomain";
	}
	
	
	container Impl
	{
		unit<UInt32> Visualisatie := union_unit(Classifications/Actor/NoData, Visualisatie_src)
		{
			attribute<String> name       := union_data(., Classifications/Actor/NoData/name, Visualisatie_src/Label);
			attribute<String> Label      := union_data(., Classifications/Actor/NoData/Label, Visualisatie_src/Label), DialogType = "LabelText";
			attribute<UInt8>  r          := union_data(., const(null_b, Classifications/Actor/NoData), Visualisatie_src/r), Descr = "Red color component";
			attribute<UInt8>  g          := union_data(., const(null_b, Classifications/Actor/NoData), Visualisatie_src/g), Descr = "Green color component";
			attribute<UInt8>  b          := union_data(., const(null_b, Classifications/Actor/NoData), Visualisatie_src/b), Descr = "Blue color component";
			attribute<UInt32> BrushColor := rgb(r,g,b), DialogType = "BrushColor", Descr = "Combined RGB color for brush";
			
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		}
		
		unit<UInt32> Visualisatie_src := range(uint32,0, #Klasse)
		{
			attribute<String> Label := Klasse/Label[id(.)[Klasse]], DialogType = "LabelText";
			attribute<UInt32> BrushColor := rgb(r,g,b), DialogType = "BrushColor";
			attribute<UInt8>  r := id(.) <= middle_record ? (0f + change)[uint8] : 254b;
			attribute<UInt8>  g := id(.) <= middle_record ? 254b : (254f - change)[uint8];
			attribute<UInt8>  b := const(0b, .);
			
			attribute<Float32> change :=
				id(.) <= middle_record 
					? (id(.)[float32] * factor) > 254f ? 254f : (id(.)[float32] * factor)
					: ((id(.)[float32] - middle_record[float32]) * factor), Descr = "Change factor for color gradient";
			
			parameter<uint32> middle_record := (#.[float32] / 2f)[uint32], Descr = "Middle record index for color calculation";
			parameter<Float32> factor := 255f / #.[float32] * 2f, Descr = "Factor for color scaling";
		}
		
		unit<UInt32> Klasse := = 'VariantParameters/Tredes/'+SectorxSubsector_name+'/'+/VariantParameters/VariantK/Trede_Variant[Variant_rel]
		{
			attribute<String> Label := '_'+name, DialogType = "LabelText", Descr = "Label for the class";
			attribute<String> name_short := 'Trede_' + string(id(.)), Descr = "Short name for the class";
			attribute<String> PrevName := MakeDefined(name[sub_or_null(id(.),1[.])], ''), Descr = "Name of the previous class";
			attribute<String> PrevName_short := MakeDefined(name_short[sub_or_null(id(.),1[.])], ''), Descr = "Short name of the previous class";
			attribute<.>      Per_AdminDomain    (AdminDomain) := = #. = 1[uint32] ? 'const(0[.], AdminDomain)' : '('+Assen/LadderExpr+')[.]'
			, Descr = "De ladder per cel van 25 meter: de laagst genummerde klasse waarvan alle asvlaggen waar zijn, en null waar een as geen enkele klasse waar heeft.

						Sinds #775 opgebouwd per as. Elke as levert een uint8 met de eerste ware klasse (Assen/PerAs), en de klasse-index volgt uit de mixed-radix som van die asindices, in dezelfde volgorde als combine: het eerste argument telt het zwaarst. Dat is rekenkundig gelijk aan de oude ArgMin over de klassenconjuncties in Klassen, want die conjuncties zijn het cartesisch product van de asvlaggen, maar het kost een handvol attributen van een byte per cel in plaats van een uint32 per klasse per cel. Op 25 meter met 144 klassen scheelde dat tientallen gigabytes aan reservering; zie #775.

						Tot #759 werd de ladder op AllocDomain ge-ArgMind en daarna met AdminDomain/AllocDomain_rel uitgesmeerd; sinds #759 beslist hij op 25 meter.";
			
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		}
		container Assen
		: Descr = "De assen van de ladder, afgelezen uit de combine-unit zelf, zodat een nieuwe as of een andere volgorde in VariantParameters/Tredes vanzelf meekomt. De first_rel, second_rel, ... die combine aanmaakt wijzen per klasse naar de asklasse; unique daarover geeft de asklassen in asvolgorde, en de pijl -> RefSrc haalt de vlagexpressie van de as op. Een alias zoals NbSMax := BAU heeft die subitems niet zelf; PropValue Expr geeft dan de naam van de unit waarnaar hij wijst, en die wordt hier tot twee niveaus gevolgd. Een unit zonder first_rel is geen combine en is dan zelf de enige as."
		{
			parameter<String> KlassePad  := 'VariantParameters/Tredes/'+SectorxSubsector_name+'/'+/VariantParameters/VariantK/Trede_Variant[Variant_rel];
			parameter<String> OuderPad   := 'VariantParameters/Tredes/'+SectorxSubsector_name;
			parameter<String> Expr0      := = 'PropValue('+KlassePad+', '+quote('Expr')+')';
			parameter<Bool>   IsAlias0   := Expr0 != '' && !IsDefined(strpos(Expr0, '(')) && !IsDefined(strpos(Expr0, '/')), Descr = "Een kale naam zonder haakjes of pad verwijst naar een broer-unit in dezelfde container.";
			parameter<String> Pad1       := IsAlias0 ? OuderPad+'/'+Expr0 : KlassePad;
			parameter<String> Expr1      := = 'PropValue('+Pad1+', '+quote('Expr')+')';
			parameter<Bool>   IsAlias1   := Expr1 != '' && !IsDefined(strpos(Expr1, '(')) && !IsDefined(strpos(Expr1, '/'));
			parameter<String> DoelPad    := IsAlias1 ? OuderPad+'/'+Expr1 : Pad1, Descr = "De unit waarvan de subitems de assen dragen, na het volgen van hooguit twee aliassen.";

			unit<uint32> Subitems := = 'SubItem_PropValues('+DoelPad+', '+quote('name')+')';
			unit<uint32> Ordinalen : nrofrows = 8
			{
				attribute<String> name : ['first_rel', 'second_rel', 'third_rel', 'fourth_rel', 'fifth_rel', 'sixth_rel', 'seventh_rel', 'eighth_rel'];
				attribute<Bool>   Aanwezig := IsDefined(rlookup(name, lowercase(Subitems/name)));
			}
			unit<uint32> AsGevonden := select_with_attr_by_cond(Ordinalen, Ordinalen/Aanwezig);
			unit<uint32> Zelf : nrofrows = 1 { attribute<String> name : ['zelf']; }
			unit<uint32> As := = #AsGevonden = 0[uint32] ? 'Zelf' : 'AsGevonden'
			, Descr = "De assen in combine-volgorde. Zonder first_rel is de unit geen combine en is hij zelf de enige as."
			{
				attribute<uint32> Card := = 'union_data(., '+asItemList('PerAs/'+name+'/Card')+')';
				attribute<String> Expr := = 'union_data(., '+asItemList('PerAs/'+name+'/Expr')+')', Descr = "De vlagexpressie van deze as, ter controle; zie VlagExprs.";
				attribute<String> Term := 'uint32(Assen/PerAs/'+name+'/Index)', Descr = "Gekwalificeerd vanaf Impl, want de expressie wordt in Klasse/Per_AdminDomain geevalueerd en niet hier.";
				attribute<String> Open := id(.) == 0[.] ? '' : '(';
				attribute<String> Stap := id(.) == 0[.] ? Term : ') * '+string(Card)+'u + '+Term;
			}
			container PerAs := for_each_ne(As/name, 'AsIndex_T('+quote(As/name)+')');
			parameter<String> VlagExprs  := AsList(As/Expr, ' | '), Descr = "De vlagexpressies van alle assen achter elkaar. Metadata, dus goedkoop, en het opvragen ervan dwingt af dat elke as zijn RefSrc vindt; het meetharnas van #759 schrijft dit voor elke variant x subsector weg.";
			parameter<String> LadderExpr := AsList(As/Open, '') + AsList(As/Stap, ''), Descr = "De mixed-radix som, bijvoorbeeld ((uint32(Assen/PerAs/first_rel/Index) * 3u + uint32(Assen/PerAs/second_rel/Index)) * 2u + uint32(Assen/PerAs/third_rel/Index)) voor drie assen waarvan de tweede en derde 3 en 2 klassen hebben.";

			Template AsIndex_T
			{
				parameter<String> RelName;
				unit<uint32> Klassen_As := = RelName == 'zelf' ? 'Klasse' : 'unique(Klasse/'+RelName+')'
				, Descr = "De klassen van deze as in asvolgorde. unique sorteert oplopend op de asklasse-index, en dat is de volgorde van de as zelf.";
				attribute<String> VlagExpr (Klassen_As) := = RelName == 'zelf' ? 'Klassen_As/RefSrc' : 'Klassen_As/values -> RefSrc';
				attribute<String> Index_s  (Klassen_As) := = RelName == 'zelf' ? 'string(id(Klassen_As))' : 'string(Klassen_As/values)';
				parameter<uint32> Card := #Klassen_As;
				parameter<String> Expr := AsList(replace(VlagExpr, '@S@', 'Src/', '@X@', Sector_name, '@SS@', Subsector_name)+' ? '+Index_s+'b : ', '') + 'null_b';
				attribute<uint8>  Index (AdminDomain) := = Expr, Descr = "De eerste ware klasse van deze as per cel, als asklasse-index; null waar geen klasse waar is.";
			}
		}
	}
}