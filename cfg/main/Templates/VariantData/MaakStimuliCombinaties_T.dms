// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Maakt per sector de stimuli die bij de gekozen stimulivariant horen, per klasse apart voor de drie stimulitreden.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template MaakStimuliCombinaties_T
: Descr = "Per sector de stimuli uit de brondata die de gekozen stimulivariant meeneemt: per klasse apart (Hard, Middel, Zacht), zodat de ladder ze als drie treden op volgorde zet
			(VariantParameters/Tredes/impl/Stimuli), en samen in Result, dat de subsectorkeuze van werken leest (Templates/Allocatie/IterSubsector_T)."
{
	parameter<String> Sector;
	//
	parameter<String> CombinatieRef := ='lowercase(VariantParameters/VariantK/StimuliVariant_'+Sector+'[Variant_rel])';
	container         src           := ='/SourceData/Stimuli/'+Sector;
	
	parameter<Bool>   MetHard   := CombinatieRef == lowercase('HardMiddelZacht') || CombinatieRef == lowercase('HardMiddel') || CombinatieRef == lowercase('Hard');
	parameter<Bool>   MetMiddel := CombinatieRef == lowercase('HardMiddelZacht') || CombinatieRef == lowercase('HardMiddel') || CombinatieRef == lowercase('MiddelZacht') || CombinatieRef == lowercase('Middel');
	parameter<Bool>   MetZacht  := CombinatieRef == lowercase('HardMiddelZacht') || CombinatieRef == lowercase('MiddelZacht') || CombinatieRef == lowercase('Zacht');
	
	attribute<Bool>   Hard   (AdminDomain) := = MetHard   ? 'src/Hard'   : 'const(FALSE, AdminDomain)', Descr = "De harde stimuli, als de variant ze meeneemt: de bovenste stimulitrede.";
	attribute<Bool>   Middel (AdminDomain) := = MetMiddel ? 'src/Middel' : 'const(FALSE, AdminDomain)', Descr = "De middelstimuli, als de variant ze meeneemt: de trede onder de harde stimuli.";
	attribute<Bool>   Zacht  (AdminDomain) := = MetZacht  ? 'src/Zacht'  : 'const(FALSE, AdminDomain)', Descr = "De zachte stimuli, als de variant ze meeneemt: de laagste stimulitrede.";
	attribute<Bool>   Result (AdminDomain) := Hard || Middel || Zacht
	, IntegrityCheck = "MetHard || MetMiddel || MetZacht"
	, Descr = "Alle stimuli die de variant meeneemt. De IntegrityCheck vangt een onbekende waarde van StimuliVariant af, die anders stil geen enkele stimulus zou geven.";
}
