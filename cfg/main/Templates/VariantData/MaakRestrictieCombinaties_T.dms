// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Maakt per sector de combinatie van restrictiecategorieen die bij de gekozen restrictievariant hoort.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template MaakRestrictieCombinaties_T
: Descr = "Template voor het maken van restrictiecombinaties op basis van de restricties in de brondata en de gekozen restrictievariant.
			De vier hardheidscategorieen worden hier niet meer meteen tot een enkele boolean samengevoegd. Elke categorie blijft als eigen laag beschikbaar (ZeerHard, Hard, Middel, Zacht), leeg wanneer de restrictievariant hem niet selecteert. Result is de OR over alles wat de variant selecteert en is daarmee gelijk aan wat deze template hiervoor gaf; Result_ExclZeerHard is dezelfde OR zonder de zeerharde laag. Dat onderscheid is nodig omdat de zeef een zeerharde restrictie anders kan behandelen dan een middelharde, zie #686."
{
	parameter<String> Sector; 
	
	parameter<String> CombinatieRef := ='lowercase(VariantParameters/VariantK/RestrictiesVariant_'+Sector+'[Variant_rel])';
	container         src           := ='/SourceData/Restricties/'+Sector;
	
	parameter<String> ActieveHardheden := switch(
											  case(CombinatieRef == lowercase('ZeerHardHardMiddelZacht'), 'ZeerHard,Hard,Middel,Zacht')
											, case(CombinatieRef == lowercase('ZeerHardHardMiddel')     , 'ZeerHard,Hard,Middel')
											, case(CombinatieRef == lowercase('ZeerHardHard')           , 'ZeerHard,Hard')
											, case(CombinatieRef == lowercase('ZeerHard')               , 'ZeerHard')
											, case(CombinatieRef == lowercase('HardMiddelZacht')        ,          'Hard,Middel,Zacht')
											, case(CombinatieRef == lowercase('HardMiddel')             ,          'Hard,Middel')
											, case(CombinatieRef == lowercase('Hard')                   ,          'Hard')
											, case(CombinatieRef == lowercase('MiddelZacht')            ,               'Middel,Zacht')
											, case(CombinatieRef == lowercase('Middel')                 ,               'Middel')
											, case(CombinatieRef == lowercase('Zacht')                  ,                      'Zacht')
											, case(CombinatieRef == lowercase('Geen')                   , 'Geen')
											, ''
										), Descr = "De hardheden die de restrictievariant van deze sector selecteert, als lijst. Dit is dezelfde opsomming van toegestane combinatienamen als hiervoor, alleen levert hij nu de losse categorieen op in plaats van meteen een samengestelde expressie. Een naam die hier niet in staat geeft een lege lijst, en die wordt door de IntegrityCheck op Result afgevangen: zonder die check zou een typefout in RestrictiesVariant_<sector> alle restricties van die sector stilzwijgend uitzetten. Geen is de expliciete manier om dat wel te doen.";
	
	parameter<String> ActieveLijst  := ','+ActieveHardheden+',', Descr = "Met komma's aan weerszijden, zodat het zoeken naar ,Hard, niet ook in ,ZeerHard, aanslaat.";
	
	parameter<Bool>   Geldt_ZeerHard := strcount(ActieveLijst, ',ZeerHard,') > 0;
	parameter<Bool>   Geldt_Hard     := strcount(ActieveLijst, ',Hard,')     > 0;
	parameter<Bool>   Geldt_Middel   := strcount(ActieveLijst, ',Middel,')   > 0;
	parameter<Bool>   Geldt_Zacht    := strcount(ActieveLijst, ',Zacht,')    > 0;
	
	parameter<String> Expr_ZeerHard := Geldt_ZeerHard ? 'src/ZeerHard' : 'const(FALSE, AdminDomain)';
	parameter<String> Expr_Hard     := Geldt_Hard     ? 'src/Hard'     : 'const(FALSE, AdminDomain)';
	parameter<String> Expr_Middel   := Geldt_Middel   ? 'src/Middel'   : 'const(FALSE, AdminDomain)';
	parameter<String> Expr_Zacht    := Geldt_Zacht    ? 'src/Zacht'    : 'const(FALSE, AdminDomain)';
	
	attribute<Bool>   ZeerHard (AdminDomain) := =Expr_ZeerHard, Descr = "De zeerharde restrictielaag van deze sector, leeg wanneer de restrictievariant hem niet selecteert. Volgens de wikipagina Restrictie-generatie is dit de categorie wettelijk verbod: Natura 2000, militair terrein, kustfundament, de plaatsgebonden risicocontour en de sloop- en beperkingsgebieden uit het Luchthavenindelingbesluit. Er zitten ook regimes in waaronder ontwikkeling met voorwaarden wel kan, zoals rijksmonumenten, rijksbeschermde stads- en dorpsgezichten en gebufferde hoogspanningslijnen, dus lees deze laag niet als een zuiver verbod. Zie #686.";
	attribute<Bool>   Hard     (AdminDomain) := =Expr_Hard,     Descr = "Sterk beschermingsregime, in principe niet toegestaan. Leeg wanneer de restrictievariant deze categorie niet selecteert.";
	attribute<Bool>   Middel   (AdminDomain) := =Expr_Middel,   Descr = "Afweging nodig, ontwikkeling niet vanzelfsprekend. Leeg wanneer de restrictievariant deze categorie niet selecteert.";
	attribute<Bool>   Zacht    (AdminDomain) := =Expr_Zacht,    Descr = "Aandachtspunt, geen harde belemmering. Leeg wanneer de restrictievariant deze categorie niet selecteert.";
	
	attribute<Bool>   Result             (AdminDomain) := ZeerHard || Hard || Middel || Zacht
	, IntegrityCheck = "ActieveHardheden != ''"
	, Descr = "Alle hardheden die deze restrictievariant selecteert, samen. Dit is het item dat de zeef gebruikt wanneer hij geen onderscheid naar hardheid maakt. De IntegrityCheck bewaakt de naam in RestrictiesVariant_<sector>.";
	
	attribute<Bool>   Result_ExclZeerHard (AdminDomain) := Hard || Middel || Zacht
	, Descr = "Hetzelfde als Result, maar zonder de zeerharde laag. De zeef gebruikt dit wanneer een zeerharde restrictie ook binnen harde plancapaciteit moet gelden en de rest niet, zie VariantK/ZeerHardOokGeldigBinnenHardePlancapaciteit.";
}
