// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De vier landschapsketens van NbSGenuanceerd bij elkaar, geinstantieerd vanuit Natuur_T (#751).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Landschap_T
: Descr = "De landschapsketens van de variant met landschapsleveringen: veen (#613), kust (#654), zand (#652) en rivieren (#621). Natuur_T instantieert dit sjabloon alleen voor NbSGenuanceerd; de andere varianten krijgen Landschap_Leeg, zodat de zware ketens daar niet eens in de boom staan."
{
	parameter<VariantParameters/VariantK> Variant_rel;
	parameter<String> Variant_name := VariantParameters/VariantK/name[Variant_rel];

	container Veen     := /Templates/VariantData/Natuur/Veen_T(Variant_rel);
	container Kust     := /Templates/VariantData/Natuur/Kust_T(Variant_name);
	container Zand     := /Templates/VariantData/Natuur/Zand_T(Variant_name, 'NbS', 'NbSGenuanceerd'), Descr = "NbSMax en NbSGenuanceerd delen bij natte natuur een kolom, zo staat het in de aanlevering.";
	container Rivieren := /Templates/VariantData/Natuur/Rivieren_T(Variant_name);
}

container Landschap_Leeg
: Descr = "Wat een variant zonder landschapsleveringen als Landschap krijgt: niets. Natuur_T leest de landschappen alleen achter een meta-schakelaar op de variant, dus hier hoeft geen enkel item te staan."
{
}
