// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De vier landschapsketens van NbSGenuanceerd bij elkaar, geinstantieerd vanuit Natuur_T (#751).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Landschap_T
: Descr = "De landschapsketens van de variant met landschapsleveringen: veen (#613), kust (#654), zand (#652) en rivieren (#621). Natuur_T instantieert dit sjabloon alleen voor NbSGenuanceerd; de andere varianten krijgen Landschap_Leeg, zodat de zware ketens daar niet eens in de boom staan."
{
	parameter<VariantParameters/VariantK> Variant_rel;
	parameter<String> Variant_name := VariantParameters/VariantK/name[Variant_rel];

	container Veen     := /Templates/VariantData/Natuur/Veen_T(Variant_rel);
	container Kust     := /Templates/VariantData/Natuur/Kust_T(Variant_name);
	container Rivieren := /Templates/VariantData/Natuur/Rivieren_T(Variant_name);

	// De zandallocatie wijkt voor wat een landschap van hogere rang op dezelfde cel levert (#829). De voorrang staat in Natuur_T/Levering: kust, zand nat, veen,
	// rivieren, zand droog, en daaronder de onderlaag; die laatste zit al in de zeef van Bron/Zand_Allocatiebasis (BezetDoorBAU) en hoort hier niet nog een keer.
	attribute<Bool> Bezet_Nat   (AdminDomain) := IsDefined(Kust/Type)
	, Descr = "De cellen waar de natte zandallocatie niets mag zetten omdat een landschap van hogere rang ze al levert: alleen kust staat boven zand nat.";
	attribute<Bool> Bezet_Droog (AdminDomain) := IsDefined(Kust/Type) || IsDefined(Veen/Type) || IsDefined(Veen/LandbouwType_rel) || IsDefined(Rivieren/Type)
	, Descr = "De cellen waar de droge zandallocatie niets mag zetten omdat een landschap van hogere rang ze al levert: kust, veen met alles wat het levert (natuur en landbouw, want de veenlevering is een
				eindtoestand, #660) en rivieren. Zand nat staat er ook boven, maar is per constructie disjunct: nat landt binnen het beekdalherstel en droog erbuiten.";

	container Zand     := /Templates/VariantData/Natuur/Zand_T(Variant_name, 'NbS', 'NbSGenuanceerd', Bezet_Nat, Bezet_Droog), Descr = "De NbS-varianten delen bij natte natuur een kolom, zo staat het in de aanlevering. Als laatste van de vier, want de zeef leest de andere drie.";
}

container Landschap_Leeg
: Descr = "Wat een variant zonder landschapsleveringen als Landschap krijgt: niets. Natuur_T leest de landschappen alleen achter een meta-schakelaar op de variant, dus hier hoeft geen enkel item te staan."
{
}
