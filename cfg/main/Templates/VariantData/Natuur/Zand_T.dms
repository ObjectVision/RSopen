// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De zandallocatie als landschap van de exogene natuuroplegging (#751). De zeven, claimregios en geschiktheid staan in SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Zand_T
: Descr = "Beekdalherstel en extra natuur uit het landschapstype Zand: het ruimtebeslag dat op slot gaat (#630) en de opgave in hectares per claimregio die het model zelf op de kaart zet (#652). Het
			enige variantgebonden deel van zand: de aanroep van NatuurAllocZand_T met de opgavekolommen van de variant; alles wat daaraan voorafgaat (de claimregios, de NNN-ringen, de zeven en de
			geschiktheid) is variant-onafhankelijk en te duur om per variant te berekenen, en staat in Bron/Zand_Allocatiebasis. De ingangen NatKolom en DroogKolom kiezen de kolom uit
			ModelParameters/Natuur/NatClaims en DroogClaims; Bezet_Nat en Bezet_Droog zijn per allocatie de cellen die een landschap van hogere rang al levert en die de zeef overslaat (#829), samengesteld in
			Landschap_T, waar de andere drie landschappen in beeld zijn. Alleen NbSGenuanceerd krijgt de allocatie; de aanlevering bevat ook een kolom voor BAU, die in ModelParameters/Natuur klaarstaat maar niet is
			aangesloten, want #652 gaat over NbSGenuanceerd en voor BAU speelt dubbeltelling met het Natuurnetwerk, dat al in de MNP-kaart zit."
{
	parameter<String> Variant_name;
	parameter<String> NatKolom;
	parameter<String> DroogKolom;
	attribute<Bool>   Bezet_Nat   (AdminDomain);
	attribute<Bool>   Bezet_Droog (AdminDomain);

	unit<UInt8> INL_Beheertype := /Classifications/Grondgebruik/INL_Beheertype;
	container   Bron           := /SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis;

	container Alloc := /Templates/VariantData/Natuur/NatuurAllocZand_T(Variant_name, NatKolom, DroogKolom, /SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis, Bezet_Nat, Bezet_Droog)
	, Descr = "De allocatie zelf: twee aanroepen van NatuurAlloc_T, nat binnen het beekdalherstel en droog erbuiten.";

	attribute<INL_Beheertype> Type_Nat   (AdminDomain) := Alloc/Alloc_Nat/INL_Beheertype_rel_AD,   Descr = "Vochtig hooiland, broekbos of moeras, binnen het beekdalherstel.";
	attribute<INL_Beheertype> Type_Droog (AdminDomain) := Alloc/Alloc_Droog/INL_Beheertype_rel_AD, Descr = "Bos, heide of open zand, buiten het beekdalherstel. Zes terrestrische typen, dus nooit water.";

	parameter<Ha> Claim_NL        := Alloc/Claim_NL;
	parameter<Ha> Gerealiseerd_NL := Alloc/Gerealiseerd_NL;
	parameter<Ha> Tekort_NL       := Alloc/Tekort_NL, Descr = "Hoeveel van de opgave niet in de zeef paste.";
}
