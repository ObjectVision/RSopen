// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De rivierenlevering als landschap van de exogene natuuroplegging (#751). De rangschikking en het sloopgebied staan in SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Rivieren_T
: Descr = "Riviertrajecten en binnendijkse gebieden uit het landschapstype Rivieren (#621), met het sloopgebied van #620. De rangschikking van de cellen op natheid en de vertaling naar ecotoop en
			beheertype zijn variant-onafhankelijk en staan in Bron/Rivieren_NbSGenuanceerd; hier staat wat de variant ervan leest. Het water (zomerbed, stromend en stagnant water) gaat mee in de
			oplegging (#751), en de drie waterecotopen dragen een watertype (N02.01 en N04.02), zodat de categorie van het ecotoop en het type hetzelfde zeggen en de stand, SOMERS en de NL2120-kaart die
			cellen als water zien."
{
	parameter<String> Variant_name;

	unit<UInt8> INL_Beheertype := /Classifications/Grondgebruik/INL_Beheertype;
	container   Bron           := /SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd;

	attribute<INL_Beheertype> Type              (AdminDomain) := Bron/IsOpgelegd ? Bron/INL_Beheertype_rel_AD : null_b[INL_Beheertype], Descr = "Het beheertype van het ecotoop, waar de levering iets oplegt: natuur- en waterecotopen, niet op de behouden dijken en niet op het agrarische en bebouwde deel.";
	attribute<Bool>           IsWater           (AdminDomain) := INL_Beheertype/IsWater[Type], IntegrityCheck = "all(IsDefined(Type) ? (IsWater == Bron/IsWaterEcotoop) : TRUE)", Descr = "Uit het type, net als bij de andere landschappen; de IntegrityCheck bewaakt dat de categorie van het ecotoop hetzelfde zegt.";
}
