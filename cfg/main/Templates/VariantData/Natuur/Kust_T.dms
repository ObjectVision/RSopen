//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Kust_T
: Descr = "Kerven, meegroeilandschappen en voorlanden uit het landschapstype Kust (#654). Het inlezen van de drie shapes en de vertaling naar drie beheertypen staan in Bron/Kust_NbSGenuanceerd; hier staat alleen wat de variant ervan leest: het type per cel en of dat water is. Waar niet meer gebouwd mag worden staat in Bron/Kust_NbSGenuanceerd/NietBouwen en gaat buiten dit sjabloon om naar het bouwregime. De bestaande bebouwing blijft sinds #707 staan."
{
	parameter<String> Variant_name;

	unit<UInt8> INL_Beheertype := /Classifications/Grondgebruik/INL_Beheertype;
	container   Bron           := /SourceData/Grondgebruik/Natuur/Bron/Kust_NbSGenuanceerd;

	attribute<INL_Beheertype> Type       (AdminDomain) := Bron/INL_Beheertype_rel_AD, Descr = "Open duin, kwelder of duin- en kwelderlandschap, zie Bron/Beheertypecode_*.";
	attribute<Bool>           IsWater    (AdminDomain) := MakeDefined(INL_Beheertype/IsWater[Type], FALSE), Descr = "Geen van de drie typen is water: N01.02 is op typeniveau land (duinvegetatie), dus de oude uitzondering VoorlandAlsNatuur is niet meer nodig.";
}
