// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De potentiele state per subsector binnen een zichtjaar.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template PerSectorxSubsector_T
: Descr = "Template voor het berekenen van de potentiele state per subsector."
{
	parameter<Sector/xSubsector> id;
	parameter<String> Zichtjaar_name;
	container Density;
	//
	
	attribute<Bool>    IsBeschikbaar_basisjaar   (CompactedAdminDomain) := = 'Zeef/Basisjaar/'+Sector/xSubsector/name[id]+'/IsBeschikbaar';
	attribute<Bool>    IsBeschikbaar_zichtjaar   (CompactedAdminDomain) := = 'Zeef/'+Zichtjaar_name+'/SectorxSubsectoren/'+Sector/xSubsector/name[id]+'/IsBeschikbaar';
	attribute<Float32> BAG_nieuwbouw             (CompactedAdminDomain) := = lowercase(Sector/xSubsector/Sector_name[id]) == lowercase('landbouw') 
																				? 'const(0f, CompactedAdminDomain)'
																				: '/BaseData/StartState/BAG_nieuwbouw/'+Sector/xSubsector/name[id]+'';
	
	attribute<Float32> Basisjaar     (CompactedAdminDomain) := ='StateBasisjaar/'+Sector/xSubsector/name[id]+ ' * float32(IsBeschikbaar_basisjaar)';

	parameter<Bool>    IsKantoorVerdikking := /ModelParameters/Werken/KantoorVerdikkingInBestaand && lowercase(Sector/xSubsector/Sector_name[id]) == lowercase('Werken') && lowercase(Sector/xSubsector/Subsector_name[id]) == lowercase('Zak_dienstverlening'), Descr = "Geldt de potentieelvloer van #668 voor deze subsector? Alleen zakelijke dienstverlening, en alleen met de schakelaar aan.";
	attribute<Float32> Potentieel                         (CompactedAdminDomain) := ='(Density/Per_CompactedAllocDomain/'+Zichtjaar_name+'/SectorxSubsectoren/'+Sector/xSubsector/name[id]+'/Zichtjaar[CompactedAdminDomain/CompactedAllocDomain_rel] * AdminDomain/NrHaPerCell)[float32]'
	, Descr = "Het reguliere potentieel van de cel: de dichtheid van de hectare waarin hij ligt, maal zijn oppervlak van 0,0625 hectare. De dichtheid is een omgevingsgemiddelde op het schattingsgrid van 100 meter en wordt hier uitgesmeerd; dat is de richting die mag. De cast naar float32 strijkt de metriek (Job, Woning, m3) weg, zodat max_elem met de vloer kan rekenen; de afnemers lezen dit item toch als kale float32.";
	attribute<Float32> Vloer                              (CompactedAdminDomain) := = IsKantoorVerdikking
		? 'collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/KantoorDominantie/WerkBanenWaarKantoorDominant) / (1f + VariantParameters/VariantK/m2BVO_job_Kantoor_groeifactor[VariantParameters/VariantK/V/'+Variant_name+'])'
		: 'const(0f, CompactedAdminDomain)'
	, Descr = "Potentieelvloer voor bestaande kantoorcellen (#668): op een cel van 25 meter waar kantoor de werkstand domineert geldt minimaal de eigen werkstand maal de verdikkingsfactor, de capaciteit die bureaudeling in situ vrijspeelt. De factor is 1 gedeeld door (1 plus de groeifactor van de kantoorcoefficient), dus 1,143 bij 17,5 tegenover 20 m2 per baan; daarmee ligt de vloer altijd 14,3 procent boven de stand van de cel en komt zij door de dichtheidsdrempel van 10 procent in de zeef. Elders 0, zodat max_elem daar niets doet.

				Tot #770 stond deze vloer in de dichtheid op 100 meter (DichtheidZichtjaar_T/Src/Werken/Banen_perHa): de werkstand van de dominante cellen van een hectare werd over de hele hectare uitgesmeerd en daarna per cel van 25 meter weer maal 0,0625 genomen. Zodra de saldotoets per cel rekent werkt dat niet meer: een pandcel met 100 banen in een hectare met vier zulke cellen kreeg een potentieel van 28,6 en haalde de toets nooit, terwijl de lege buurcellen de vloer kregen zonder dominant te zijn. De vloer is een celgrootheid en staat daarom hier.";
	attribute<Float32> PotentieelMetVloer                 (CompactedAdminDomain) := max_elem(Potentieel, Vloer);
	attribute<Float32> Zichtjaar                          (CompactedAdminDomain) := PotentieelMetVloer * float32(IsBeschikbaar_zichtjaar);
	attribute<Float32> Zichtjaar_BeschikbaarheidBasisjaar (CompactedAdminDomain) := PotentieelMetVloer * float32(IsBeschikbaar_basisjaar);
	attribute<Float32> StandInBereik                      (CompactedAdminDomain) := = 'Per_Sector/'+Sector/xSubsector/Sector_name[id]+'/Basisjaar_Ongemaskeerd * float32(IsBeschikbaar_basisjaar)'
	, Descr = "Alle werkgelegenheid in de cel op het deel dat voor deze subsector beschikbaar is, en dus precies wat er bij een overname door deze subsector gesloopt wordt.

				Stond tot #713 op Per_Sector/Basisjaar, dat per subsector op de eigen beschikbaarheid maskeert. Daardoor telden de banen niet mee van subsectoren die op deze cel restrictief staan, terwijl die bij een overname wel sneuvelen: de cel oogde leeg, viel onder de greenfield-vrijstelling en passeerde de sloopwacht gratis. Gemeten in Y2040 van BAU ging het om 69 cellen met 2.793 banen bij de vier lichte subsectoren en om ruim 7.400 cellen met circa 106.000 banen bij nijverheid en logistiek.

				De oude vorm mat bovendien teller en noemer over verschillend deeloppervlak: de teller was gemaskeerd op de beschikbaarheid van deze subsector, de noemer op die van elke subsector afzonderlijk. Daardoor kreeg een subsector banen aangerekend op deelcellen waar hij zelf niet mag bouwen en die bij zijn allocatie dus ook niet sneuvelen. Dat trof vooral de subsectoren met een smalle beschikbaarheid: de noemer van detailhandel ging van 2.450.126 naar 1.477.012 banen, terwijl die van nijverheid juist van 2.450.126 naar 2.498.307 ging.";
	attribute<Float32> Result                    (CompactedAdminDomain) := Zichtjaar_BeschikbaarheidBasisjaar - StandInBereik
	, Descr = "Het saldo van een overname door deze subsector per cel van 25 meter: wat de subsector er neerzet tegen wat er dan sneuvelt. Tot #770 werd dit saldo naar de cel van 100 meter opgeteld en daar getoetst; sinds de allocatie per cel van 25 meter kiest (#508) hoort de saldotoets op diezelfde cel, want dat is de cel die bij een overname wordt gesloopt. Zie Zeef_T/Impl/TeKleineDichtheidsToenameSubsector.";
	attribute<Float32> StateSectorVoorAllocatie (CompactedAdminDomain) := StandInBereik
	, Descr = "De basisjaarstand van de hele sector in de cel, voor zover in bereik van deze subsector, en daarmee de noemer van TovStateVoorAllocatie. Staat apart zodat de zeef het greenfieldgeval (stand nul) expliciet kan uitzonderen in plaats van op de uitkomst van de nuldeling te leunen; zie Zeef_T/Impl/TeKleineDichtheidsToenameSubsector en #709. Voor de grondslag zie StandInBereik en #713. Tot #770 de som over de cel van 100 meter.";
	attribute<Float32> TovStateVoorAllocatie    (CompactedAdminDomain) := Result / StateSectorVoorAllocatie, Descr = "De potentiele dichtheidstoename van de subsector in deze cel, als aandeel van de stand die er nu staat. Null waar niets staat; de zeef zondert dat geval expliciet uit.";

}
