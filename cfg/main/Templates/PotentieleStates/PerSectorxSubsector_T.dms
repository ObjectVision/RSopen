// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De potentiele state per subsector binnen een zichtjaar.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template PerSectorxSubsector_T
: Descr = "Template voor het berekenen van de potentiele state per subsector."
{
	parameter<Sector/xSubsector> id;
	parameter<String> Zichtjaar_name;
	container Density;
	//
	
	attribute<Bool>    IsBeschikbaar_basisjaar   (CompactedAdminDomain) := = 'Zeef/Basisjaar/'+Sector/xSubsector/name[id]+'/IsBeschikbaar';
	attribute<Bool>    IsBeschikbaar_zichtjaar   (CompactedAdminDomain) := = 'Zeef/'+Zichtjaar_name+'/SectorxSubsectoren/'+Sector/xSubsector/name[id]+'/IsBeschikbaar';
	attribute<Float32> BAG_nieuwbouw             (CompactedAdminDomain) := = lowercase(Sector/xSubsector/Sector_name[id]) == lowercase('landbouw') 
																				? 'const(0f, CompactedAdminDomain)'
																				: '/BaseData/StartState/BAG_nieuwbouw/'+Sector/xSubsector/name[id]+'';
	
	attribute<Float32> Basisjaar     (CompactedAdminDomain) := ='StateBasisjaar/'+Sector/xSubsector/name[id]+ ' * float32(IsBeschikbaar_basisjaar)';

	attribute<Float32> Zichtjaar                          (CompactedAdminDomain) := ='Density/Per_CompactedAllocDomain/'+Zichtjaar_name+'/SectorxSubsectoren/'+Sector/xSubsector/name[id]+'/Zichtjaar[CompactedAdminDomain/CompactedAllocDomain_rel] * AdminDomain/NrHaPerCell * float32(IsBeschikbaar_zichtjaar)';
	attribute<Float32> Zichtjaar_BeschikbaarheidBasisjaar (CompactedAdminDomain) := ='Density/Per_CompactedAllocDomain/'+Zichtjaar_name+'/SectorxSubsectoren/'+Sector/xSubsector/name[id]+'/Zichtjaar[CompactedAdminDomain/CompactedAllocDomain_rel] * AdminDomain/NrHaPerCell * float32(IsBeschikbaar_basisjaar)';
	attribute<Float32> StandInBereik                      (CompactedAdminDomain) := = 'Per_Sector/'+Sector/xSubsector/Sector_name[id]+'/Basisjaar_Ongemaskeerd * float32(IsBeschikbaar_basisjaar)'
	, Descr = "Alle werkgelegenheid in de cel op het deel dat voor deze subsector beschikbaar is, en dus precies wat er bij een overname door deze subsector gesloopt wordt.

				Stond tot #713 op Per_Sector/Basisjaar, dat per subsector op de eigen beschikbaarheid maskeert. Daardoor telden de banen niet mee van subsectoren die op deze cel restrictief staan, terwijl die bij een overname wel sneuvelen: de cel oogde leeg, viel onder de greenfield-vrijstelling en passeerde de sloopwacht gratis. Gemeten in Y2040 van BAU ging het om 69 cellen met 2.793 banen bij de vier lichte subsectoren en om ruim 7.400 cellen met circa 106.000 banen bij nijverheid en logistiek.

				De oude vorm mat bovendien teller en noemer over verschillend deeloppervlak: de teller was gemaskeerd op de beschikbaarheid van deze subsector, de noemer op die van elke subsector afzonderlijk. Daardoor kreeg een subsector banen aangerekend op deelcellen waar hij zelf niet mag bouwen en die bij zijn allocatie dus ook niet sneuvelen. Dat trof vooral de subsectoren met een smalle beschikbaarheid: de noemer van detailhandel ging van 2.450.126 naar 1.477.012 banen, terwijl die van nijverheid juist van 2.450.126 naar 2.498.307 ging.";
	attribute<Float32> Result_CompactedAdminDomain        (CompactedAdminDomain) := Zichtjaar_BeschikbaarheidBasisjaar - StandInBereik;
	
	attribute<Float32> Result                      (CompactedAllocDomain) := sum(Result_CompactedAdminDomain, CompactedAdminDomain/CompactedAllocDomain_rel);
	attribute<Float32> StateSectorVoorAllocatie  (CompactedAllocDomain) := sum(StandInBereik, CompactedAdminDomain/CompactedAllocDomain_rel)
	, Descr = "De basisjaarstand van de hele sector in de cel, voor zover in bereik van deze subsector, en daarmee de noemer van TovStateVoorAllocatie. Staat apart zodat de zeef het greenfieldgeval (stand nul) expliciet kan uitzonderen in plaats van op de uitkomst van de nuldeling te leunen; zie Zeef_T/Impl/TeKleineDichtheidsToenameSubsector en #709. Voor de grondslag zie StandInBereik en #713.";
	attribute<Float32> TovStateVoorAllocatie       (CompactedAllocDomain) := Result / StateSectorVoorAllocatie;

}
