// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// De potentiele state per sector, opgeteld over de subsectoren.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template PerSector_T
: Descr = "Template voor het berekenen van de potentiele state per sector."
{
	parameter<Sector> id;
	container Per_SectorxSubsectoren;
	//
	
	unit<UInt8> Subsector := = Sector/Subsector_ref[id];
	
	attribute<Float32> Basisjaar (CompactedAdminDomain) := = 'add('+asItemList('Per_SectorxSubsectoren/'+Sector/name[id]+'/'+Subsector/name+'/Basisjaar')+')';
	attribute<Float32> Basisjaar_Ongemaskeerd (CompactedAdminDomain) := = 'add('+asItemList('StateBasisjaar/'+Sector/name[id]+'/'+Subsector/name)+')'
	, Descr = "De basisjaarstand van de hele sector in de cel, zonder het beschikbaarheidsmasker dat Basisjaar hierboven per subsector op zichzelf legt. Nodig voor de sloopwacht in de zeef: bij een overname sneuvelt alle werkgelegenheid in de cel, ook die van subsectoren die daar zelf restrictief staan, dus die moet meetellen. Zie #713.";
	attribute<Float32> Zichtjaar (CompactedAdminDomain) := = 'value(add('+asItemList('Per_SectorxSubsectoren/'+Sector/name[id]+'/'+Subsector/name+'/Zichtjaar')+'), float32)';
}
