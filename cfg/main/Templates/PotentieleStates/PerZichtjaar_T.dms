//
// De potentiele state per zichtjaar: hoe vol een cel in de toekomst zou kunnen zitten, gegeven dichtheid en of er
// daar uberhaupt gebouwd mag worden.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template PerZichtjaar_T
: Descr = "Template voor het berekenen van de potentiele state per sector en subsector."
{
	parameter<String> Zichtjaar_name;
	container Density;
	//
	
	container Per_SectorxSubsectoren := 
		for_each_ne(
			Sector/xSubsector/name
			, 'PerSectorxSubsector_T('+string(id(Sector/xSubsector))+'[Sector/xSubsector], Zichtjaar_name, Density)'
		)
	{
		container Landbouw
		{
			container NonLandbouw 
			{
				attribute<Bool>    IsBeschikbaar_zichtjaar   (CompactedAdminDomain) := const(TRUE,CompactedAdminDomain);
				attribute<Float32> Zichtjaar                 (CompactedAdminDomain) := AdminDomain/NrHaPerCell * float32(IsBeschikbaar_zichtjaar);
			}
		}
	}
	container Per_Sector := for_each_ne(Sector/name, 'PerSector_T('+string(id(Sector))+'[Sector], Per_SectorxSubsectoren)');
}
