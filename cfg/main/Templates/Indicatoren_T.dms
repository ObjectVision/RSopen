// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het instapsjabloon van de indicatoren: hiervan bestaat een instantie per casus (scenario x variant). Het wordt
// aangeroepen vanuit container Indicatoren in Indicatoren.dms. Het sjabloon per zichtjaar daaronder staat in
// Templates/Indicatoren.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Indicatoren_T
:	using = "Units;Geography;Classifications"
{
	parameter<Modellering/AllCases>       Case_id;
	///
	parameter<Modellering/ScenarioK>      Scenario_rel := Modellering/AllCases/scenario_rel[case_id];
	parameter<VariantParameters/VariantK> Variant_rel  := Modellering/AllCases/Variant_rel[case_id];
	
	parameter<string> Scenario_name := Modellering/ScenarioK/name[Scenario_rel];
	parameter<string> Variant_name  := VariantParameters/VariantK/name[Variant_rel];
	parameter<string> Casus_name    := Modellering/AllCases/label[Case_id];

	parameter<string> StandVariant_name := VariantParameters/VariantK/StandVanVariant[Variant_rel]
	, Descr = "Uit welke variant deze casus haar allocatiestand leest. Vrijwel altijd Variant_name zelf; zie de kolom StandVanVariant in VariantK voor een variant die de stand van een andere leest en dan niet zelf alloceert.";

	parameter<string> StandCasus_name := Scenario_name + '_' + StandVariant_name
	, Descr = "De casusnaam waaronder de standtifs op schijf staan, gebruikt in AllocatieFileName hieronder. De enige plek waar de indicatorenkant van Casus_name afwijkt; Variant_rel blijft die van deze
					casus, dus alle variantparameters worden van deze variant gelezen. Een variant die leent leest zo de stand van de uitlener terwijl haar eigen variantkolommen gelden. De aanname dat lener en
					uitlener dezelfde stand zouden krijgen wordt hier niet bewaakt; dat gebeurt in Test-LeenAanname in batch/Run2120.ps1, voordat de eerste stap draait, en wie een reeks buiten dat script om
					start omzeilt die toets (zie de kolom StandVanVariant in VariantK). Wel meebewaakt: de legendatoets van #721 in Templates/Indicatoren.dms leest het zijbestand van precies de tif die hier
					wordt aangewezen, dus lopen de OP-sets van lener en uitlener uiteen, dan valt die toets om.";
	
	container ThisCasus                  := .;
	container ThisVariantData            := ='/VariantData/'+Variant_name;
	container ThisVariantAllocatie       := ='Allocatie/'+Casus_name;
	container ThisVariantClassifications := ='CaseClassifications/'+Variant_name;
	
	#include<Basisjaar.dms>
	
	container Zichtjaren :=
		for_each_ne(
			Classifications/Time/Zichtjaar/name
			,	'Templates/Indicatoren/Zichtjaar_T('+
					quote(Classifications/Time/Zichtjaar/name)+
				','+Classifications/Time/Zichtjaar/PrevName_triv+
				')'
		)
		,	using = "Units;Geography;Classifications"
	{
		container NPV_agrarisch_landgebruik
		{
			attribute<EUR> Result (AdminDomain) := for_each_nedv(Classifications/Actor/LandbouwKlasses/name, '', AdminDomain, EUR);
		}
		
		#include<BAGSloopNieuwbouwWonen.dms>
		#include<StartState_metBAGSloopNieuwbouwWonen.dms>
		#include<Export.dms>
	}
}