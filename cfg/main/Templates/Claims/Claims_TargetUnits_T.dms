// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Converteer Tigris claims in org domain (LMS) naar target allocatie domains
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Template Claims_TargetUnits_T
: Descr = "Converteer Tigris claims in org domain (LMS) naar target allocatie domains"
{
	parameter<ZichtjaarxTXLClaimsxCase> id;
	unit<UInt32> ZichtjaarxTXLClaimsxCase;
	//
	
	parameter<String> Scenario_name    := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Scenario_name[id];
	parameter<String> Variant_name     := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Variant_name[id];
	parameter<String> TXLClaims_ref    := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/TXLClaims_ref[id];
	parameter<uint16> UsedTIGRIS_year_Voor := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/UsedTIGRIS_year_Voor[id];
	parameter<uint16> UsedTIGRIS_year_Na   := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/UsedTIGRIS_year_Na[id];
	parameter<Float32> UsedTIGRIS_gewicht  := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/UsedTIGRIS_gewicht[id];
	parameter<String> Zichtjaar_name   := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Zichtjaar_name[id];
	parameter<String> Sector_name      := Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Sector_name[id];
	unit<UInt8>       AllocRegio       := Classifications/Modellering/AllocRegiosK/TigrisRegios, Descr = "Alleen de landsdekkende indelingen: de waterbergingsregio's zijn niet bedoeld voor TIGRIS-claims, zie AllocRegiosK/IsTigrisRegio.";
	unit<UInt8>       SectorAllocRegio := ModelParameters/SectorAllocRegio;
	
	parameter<String> SrcStr_Template :=
		replace(
			'WonenEnWerken/Cases/@S@/@V@/Tables/@T@/Zichtjaren/@J@/Attributes',
			'@S@', Scenario_name,
			'@V@', Variant_name,
			'@T@', TXLClaims_ref
		);

	parameter<String> SrcStr_Voor := replace(SrcStr_Template, '@J@', 'Y'+string(UsedTIGRIS_year_Voor));
	parameter<String> SrcStr_Na   := replace(SrcStr_Template, '@J@', 'Y'+string(UsedTIGRIS_year_Na));

	unit<UInt8> AttrUnit        := = Classifications/Modellering/ZichtjaarxTXLClaimsxCase/Attr_ref[id];
	unit<UInt8> Aggregatie_Unit := = AttrUnit/Aggregatie_Unit[0b];
	unit<Int32> TargetValUnit   := = Classifications/Modellering/ZichtjaarxTXLClaimsxCase/TargetValUnitRef[id];
	
	unit<UInt32> LMS := RegioIndelingen/LMSsubzone;
	
	container Results_in_Org :=
		for_each_nedv(
			AttrUnit/name
			, UsedTIGRIS_gewicht == 0f
				? 'union_data(LMS, '+SrcStr_Voor+'/'+AttrUnit/TXLTbl_Ref+'[TargetValUnit])'
				: 'union_data(LMS, round(float32('+SrcStr_Voor+'/'+AttrUnit/TXLTbl_Ref+') + UsedTIGRIS_gewicht * (float32('+SrcStr_Na+'/'+AttrUnit/TXLTbl_Ref+') - float32('+SrcStr_Voor+'/'+AttrUnit/TXLTbl_Ref+')))[TargetValUnit])'
			, LMS
			, TargetValUnit
		), Descr = "Claims per LMS-subzone. Valt het zichtjaar samen met een TIGRIS-jaar (of ligt het erbuiten), dan wordt dat ene jaar gelezen en blijft de berekening exact gelijk aan die van voor de invoering van interpolatie. Ligt het ertussenin, dan wordt er lineair geinterpoleerd tussen de twee omliggende TIGRIS-jaren, zodat zichtjaren op een fijner raster dan de TIGRIS-jaren mogelijk zijn. De round is nodig omdat TargetValUnit op Int32 gebaseerd is: zonder afronding kapt de cast af en levert dat per subzone een systematische onderschatting op. Zie /Classifications/Time/Zichtjaar voor de bepaling van de omliggende jaren en het gewicht.";
	
	container Results := 
		for_each_nedv(
			Aggregatie_Unit/name
			, asList('Results_in_Org/'+AttrUnit/name, ' + ' , AttrUnit/Aggregatie_rel)
			, LMS
			, TargetValUnit
		);
		
	container AllocRegios := for_each_ne(AllocRegio/name, 'AllocRegio_T('+string(id(AllocRegio))+'[AllocRegio])');
	
	Template AllocRegio_T
	{
		parameter<AllocRegio> AllocRegio_rel;
		
		parameter<String> AllocRegio_name := AllocRegio/name[AllocRegio_rel];
		parameter<String> AllocRegio_path := AllocRegio/path[AllocRegio_rel];
		
		unit<UInt32> RegioUnit := = AllocRegio_path
		{
			attribute<rdc_meter> SrcRegio_Centroid           (WonenEnWerken/SrcRegio) := WonenEnWerken/SrcRegio/centroid;
			attribute<rdc_meter> geometry_buffered           (poly)                   := geos_buffer_multi_polygon(geometry, float64(/ModelParameters/Advanced/Claimregio_Bufferstraal / 1[meter]), 4b);
			attribute<.>         per_TigrisXLSrcRegio_direct (WonenEnWerken/SrcRegio) := point_in_polygon(SrcRegio_Centroid, geometry);
			attribute<.>         per_TigrisXLSrcRegio        (WonenEnWerken/SrcRegio) := MakeDefined(per_TigrisXLSrcRegio_direct, point_in_polygon(SrcRegio_Centroid, geometry_buffered))
			,	IntegrityCheck = "all(IsDefined(this))"
			,	Descr = "Subzones met veel buitenwater kunnen hun zwaartepunt buiten de (uit gemeentegrenzen herbouwde) regiogeometrie hebben; zonder fallback wordt de toewijzing null en laat de sum in CalcStr de claims van zo'n subzone geruisloos uit de regiototalen vallen (pbl-nl/model-RSopen#46: LMS-subzone 517, haven Den Helder, 44 m uit de gegeneraliseerde kustlijn, ca. 5.4k woningen per zichtjaar). De bufferfallback van 2.5 km wijst zulke subzones alsnog aan de nabije regio toe; de IntegrityCheck laat elke toekomstige niet-toewijzing hard falen in plaats van stil claims te verliezen.";
		}
		
		parameter<String> CalcStr          := 'sum('+Zichtjaar_name+'/@X@/'+Scenario_name+'/'+Variant_name+'/Results/@Y@, RegioUnit/per_TigrisXLSrcRegio)';
		parameter<String> ClaimDir        := /PrivData/Claims/WonenEnWerken/ClaimRef
		, Descr = "Alle claimjaren, het claimbasisjaar inbegrepen, in LocalData (PrivData/Claims/WonenEnWerken/ClaimRef). Niet in de brondatamap: die synchroniseert naar Nextcloud, en daar is een eenmaal weggeschreven bestand niet meer te wijzigen of te verwijderen.";
		parameter<String> File_csv_name   := ClaimDir +'/'+Scenario_name+'/'+Variant_name+'/'+Zichtjaar_name+'/'+AllocRegio_name;
		
		container Write_Wonen :=
			for_each_nedv(
				  WP2/name
				, replace(CalcStr, '@X@', 'Woningen', '@Y@', WP2/name)+'[Woning]'
				, RegioUnit
				, Woning
			), StorageName = "=File_csv_name+'/Wonen.csv'", StorageType = "gdalwrite.vect"
		{
			attribute<String> Regio (RegioUnit) := RegioUnit/name
			, Descr = "Regiosleutel bij de waardekolommen hiernaast. De leeskant koppelt de rijen van dit bestand op volgorde aan de regio-eenheid; zonder deze kolom is uit het bestand zelf niet af te leiden op
								welke indeling er is geaggregeerd (#585, #691). GDAL zet hem als eerste kolom en schrijft de naam in kleine letters, dus de kop luidt regio gevolgd door de waardekolommen. Bestanden van voor
								deze kolom missen haar; de leeskant leest alleen de kolommen die hij bij naam noemt, dus oude en nieuwe leveringen zijn allebei leesbaar, en koppelen op sleutel in plaats van op rijvolgorde
								kan pas worden afgedwongen zodra elke gelezen levering opnieuw is gegenereerd.";
		}

		container Write_Werken :=
			for_each_nedv(
				Jobs6/name,
				replace(CalcStr, '@X@', 'Banen', '@Y@', Jobs6/name)+'[job]',
				RegioUnit, job
			), StorageName = "=File_csv_name+'/Werken.csv'", StorageType = "gdalwrite.vect"
		{
			attribute<String> Regio (RegioUnit) := RegioUnit/name
			, Descr = "Regiosleutel bij de waardekolommen hiernaast. De leeskant koppelt de rijen van dit bestand op volgorde aan de regio-eenheid; zonder deze kolom is uit het bestand zelf niet af te leiden op
								welke indeling er is geaggregeerd (#585, #691). GDAL zet hem als eerste kolom en schrijft de naam in kleine letters, dus de kop luidt regio gevolgd door de waardekolommen. Bestanden van voor
								deze kolom missen haar; de leeskant leest alleen de kolommen die hij bij naam noemt, dus oude en nieuwe leveringen zijn allebei leesbaar, en koppelen op sleutel in plaats van op rijvolgorde
								kan pas worden afgedwongen zodra elke gelezen levering opnieuw is gegenereerd.";
		}
			
		Container Write := =lowercase(Sector_name) == lowercase('Werken') ? 'Write_Werken' : 'Write_Wonen';
	}
} 

