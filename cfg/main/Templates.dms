// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file bevat templates ofwel rekenschema's: stukken script die in verschillende contexten worden gebruikt
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Templates: using = "Units;Geography;SourceData/RegioIndelingen;Classifications;Classifications/Vastgoed;Classifications/Actor"
{
	// Ingedeeld naar de laag die de sjablonen aanroept: SourceData, BaseData, VariantData, Allocatie en
	// Indicatoren. Het instapsjabloon van een laag heet X_T en staat in container X, met daarnaast de sjablonen
	// voor de niveaus daaronder. Suitabilities, Beschikbaarheden, PotentieleStates, Classificaties, Landbouw,
	// Claims, Densities en DecoupledFile_T staan er los naast: die worden vanuit meer dan een laag aangeroepen en
	// horen dus niet in een van hen thuis.
	//
	// LET OP bij het toevoegen van een subcontainer hier. Een naam die ook elders in de boom bestaat, of dat nu
	// een rootcontainer is zoals /BaseData of een container binnen de variantboom zoals PotentieleState, schermt
	// die af voor ELKE ongekwalificeerde verwijzing vanuit een sjabloon. GeoDMS zoekt namelijk omhoog vanaf de
	// plek waar het sjabloon STAAT, niet vanaf de plek waar het wordt geinstantieerd.
	//
	// De oplossing is niet om de container anders te noemen maar om de verwijzing te kwalificeren: schrijf vanuit
	// een sjabloon /BaseData/ en niet BaseData/. Dat is hier overal doorgevoerd, en het was al de norm voor
	// /Allocatie en /Indicatoren, die immers al langer ook als subcontainer bestaan. Voeg je een subcontainer toe,
	// controleer dan eerst of de naam vrij is met:
	//     grep -rE "(^|[^/A-Za-z_])NAAM/" cfg/main/Templates --include=*.dms
	// Nul treffers betekent veilig. Zo een fout valt namelijk NIET op bij het laden; hij komt pas boven wanneer
	// die tak echt gerekend wordt. PotentieleStates staat in het meervoud om die reden, net als Suitabilities en
	// Beschikbaarheden: die verwijzingen staan in samengestelde strings en zijn niet met een slash te kwalificeren.

	container Classificaties
	: Descr = "Templates die klassenindelingen opbouwen: de casusclassificaties per variant, de subsectoren binnen een sector, en de BAG-gebruiksdoelsets."
	{
		#include<Classificaties/CaseClassifications_T.dms>
		#include<Classificaties/SectorxSubsector_T.dms>
		#include<Classificaties/BAG_GebruiksdoelSets_T.dms>
	}

	container SourceData
	: Descr = "Sjablonen die alleen vanuit SourceData worden aangeroepen."
	{
		#include<SourceData/OV_halte_bereikbaarheid_T.dms>
		#include<SourceData/NatuurAlloc_T.dms>
		#include<SourceData/NatuurAllocZand_T.dms>
	}

	container Statistiek
	: Descr = "Generieke statistische schattingssjablonen, niet aan een laag gebonden."
	{
		#include<Statistiek/Logit_T.dms>
	}

	container BaseData
	: Descr = "Sjablonen die alleen vanuit BaseData worden aangeroepen."
	{
		container Zonneladder
		: Descr = "Sjablonen voor het opbouwen van de zonneladder. Simplify_T staat hier omdat de zonneladder de enige gebruiker is, ook al is hij op zichzelf generiek."
		{
			#include<BaseData/Zonneladder/Union_T.dms>
			#include<BaseData/Zonneladder/Isoperimetrisch_quotient_T.dms>
			#include<BaseData/Zonneladder/ProcessTiles_T.dms>
			#include<BaseData/Zonneladder/Simplify_T.dms>
		}
	}

	container VariantData
	: Descr = "Templates die alleen vanuit VariantData_T worden aangeroepen: de restrictie- en stimulicombinaties per sector, en de treden per subsector."
	{
		#include<VariantData_T.dms>
		#include<VariantData/MaakRestrictieCombinaties_T.dms>
		#include<VariantData/MaakStimuliCombinaties_T.dms>
		#include<VariantData/Trede_T.dms>
	}

	container Allocatie
	: Descr = "Alle templates voor de allocatie, inclusief iteratiestructuren en state preparatie."
	{
		#include<Allocatie_T.dms>
		#include<Allocatie/Zichtjaar_T.dms>
		#include<Allocatie/Sequence_T.dms>
		#include<Allocatie/SectorAllocRegio_T.dms>
		#include<Allocatie/Iter_T.dms>
		#include<Allocatie/Iter_Landbouw_T.dms>
		#include<Allocatie/IterSubsector_T.dms>
		#include<Allocatie/IterSubsector_T_Landbouw.dms>
		#include<Allocatie/IterSubsector_T_Wonen.dms>
		#include<Allocatie/IterSubsector_T_Wind.dms>
		#include<Allocatie/StatePrep_T.dms>
		#include<Allocatie/Buffer_gridcel_T.dms>
		#include<Allocatie/Buurtaandeel_gridcel_T.dms>
	}	
	
	container Suitabilities
	: Descr = "Templates voor het berekenen van geschiktheden voor verschillende sectoren."
	{
		#include<Suitabilities/Woningwaarde.dms>
		#include<Suitabilities/Woningwaarde_perWoningType.dms> //voor verwervingskosten
		#include<Suitabilities/Woningwaarde_perWoningType_zonderGroen.dms> //prijs zonder groen (P_rest), voor groenwaardering in indicatoren (issue #481)
		#include<Suitabilities/Bouwperiode_T.dms> //bouwperiodeterm in de prijs van de bestaande voorraad (issue #675)
		#include<Suitabilities/Groenfracties_T.dms> //hedonische natuur- en waterfracties, gedeeld door indicator en allocatie (issue #637)
		#include<Suitabilities/Suitability_Zichtjaar_T.dms>
		#include<Suitabilities/Suitability_Wonen_perSubsector_T.dms>
		#include<Suitabilities/Suitability_Wonen_perOP_T.dms>
	}
	
	container Beschikbaarheden
	: Descr = "Templates voor het berekenen van beschikbaarheden voor verschillende sectoren."
	{
		#include<Beschikbaarheden/Wind_BepaalGeschikteCellenPerStempel_T.dms>
		#include<Beschikbaarheden/Zeef_T.dms>
		#include<Beschikbaarheden/Zeef_Basisjaar_T.dms>
		#include<Beschikbaarheden/Zeef_Wonen_perOP_T.dms>
		#include<Beschikbaarheden/Zeef_Wonen_perSubsector_T.dms>
		#include<Beschikbaarheden/Zeef_Zichtjaar_T.dms>
	}

	container PotentieleStates
	: Descr = "Templates voor de potentiele state, in drie niveaus: per zichtjaar, daarbinnen per subsector, en de optelling per sector."
	{
		#include<PotentieleStates/PerZichtjaar_T.dms>
		#include<PotentieleStates/PerSectorxSubsector_T.dms>
		#include<PotentieleStates/PerSector_T.dms>
	}

	#include<Landbouw.dms>
	#include<Claims.dms>
	#include<Densities.dms>

	container Indicatoren
	{
		#include<Indicatoren_T.dms>
		#include<Indicatoren.dms>
		#include<Indicatoren/BereikbaarheidGroenBBG_T.dms> // RVNL methode
		#include<Indicatoren/BereikbaarheidGroenBGT_T.dms> // Methode Jip obv BGT
		#include<Indicatoren/SSM2017_Overstromingsschades.dms>
		#include<Indicatoren/SOMERS_CO2_T.dms>
		#include<Indicatoren/CarbonStorageSequestration_T.dms>
		container Landgebruikskaart
		: Descr = "Sjablonen voor de landgebruikskaart in het basisjaar en de zichtjaren. Staat onder Indicatoren omdat de indicatoren de enige gebruiker zijn."
		{
			#include<Indicatoren/Landgebruikskaart/GetNieuwGrouped_T.dms>
			#include<Indicatoren/Landgebruikskaart/Make_Landgebruikskaart_Basisjaar_T.dms>
			#include<Indicatoren/Landgebruikskaart/Make_LandgebruikskaartNL2120_T.dms>
		}

		Template BereikbaarheidGroen_Per_Regio_T 
		{
			parameter<string> Regio_naam;
			attribute<bool>   IsRegio  (AdminDomain);
			attribute<Woning> Woningen (AdminDomain);
			container         Src;
			//
			
			container Afstanden := 
				for_each_ne(
					Classifications/Bereikbaarheid/AfstandGroen/name
					, 'Per_Afstand_T(
							'+string(id(Classifications/Bereikbaarheid/AfstandGroen))+'[Classifications/Bereikbaarheid/AfstandGroen]
							, IsRegio
							, Woningen
							, Src
						)'
				)
			{
				container InDezeStudie := Tot300m;
			}
		}
		
		Template BereikbaarGroen_Indicatoren_T
		{
			parameter<string> IndicatorName;
			parameter<string> IndicatorExpr;
			parameter<string> ValuesUnit0;
			container         Src;
			//
			unit<float32> ValuesUnit :=  =ValuesUnit0;
			// /BereikbaarheidGroen/obv_BBG/PerRegios/Totaal/Afstanden/Tot300m/AggrGroenKlassen/Totaal/Indicatoren/Groenaanbod/Indicator
			parameter<string> StorageStr := lowercase(GroenBron) == 'bbg'
				? '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Bereikbaarheid_Groen_'+GroenBron+'_'+Regio_naam+'_Tot'+string(Bovengrens)+'m_'+GroenK_name+'_'+IndicatorName+'_'+Zichtjaar_name+'_'+ValuesUnit0+'_'+/ModelParameters/StudyArea+'.tif'
				: '%LocalDataProjDir%/Indicatoren/'+Casus_name+'/Bereikbaarheid_Groen_'+GroenBron+'_'+Regio_naam+'_Tot'+string(Bovengrens)+'m_'+IndicatorName+'_'+Zichtjaar_name+'_'+ValuesUnit0+'_'+/ModelParameters/StudyArea+'.tif';


			attribute<ValuesUnit>   Indicator        (AdminDomain) := =IndicatorExpr, Descr = "Berekende indicatorwaarde per cel volgens de gekozen definitie.", StorageName = "=StorageStr", StorageType = "gdalwrite.grid";
			parameter<ValuesUnit>   Indicator_Aggregated           := mean(WoningenInThisStRegio > 0[Woning] || Indicator > 0[ValuesUnit] ? Indicator : null_f), Descr = "Gemiddelde positieve indicatorwaarde over het studiegebied.";
		}
	}

	#include<Verdiscontering_T.dms> // netto contante waarde in het basisjaar, gedeeld door indicatoren en suitability, issue #651
	#include<DecoupledFile_T.dms>
}
