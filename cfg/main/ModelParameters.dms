// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de ModelParameters: Parameters die voor elk scenario en elke Variant hetzelfde zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container ModelParameters : using = "Units;Geography;SourceData/RegioIndelingen"
{
	parameter<String>    StudyArea                     := 'Nederland', Descr = "Welk gebied moet het model beslaan. Heel Nederland, of een kleiner studiegebied. Opties: Nederland Noord_Brabant Friesland Noord_Holland Utrecht. De mogelijke opties zijn gedefinieerd in Geography/StudyAreas. De studiegebied keuze heeft natuurlijk effect op welke cellen er beschouwd worden. Deze waarde wordt ook als suffix in alle ontkoppelde/resultaat bestanden verwerkt."; 
	parameter<Bool>      AlleenEindjaar                := =replace_value(expand(., '%env:AlleenEindjaar%'), 'env:AlleenEindjaar', 'FALSE'), Descr = "Bepaalt of de allocatie in één stap naar het eindjaar springt (TRUE) of via de tussenliggende zichtjaren (2030, 2040, ...) sequentieel doorrekent (FALSE). TRUE:  springt direct van basisjaar naar eindjaar. Tussenliggende zichtjaren verschijnen NIET in de GeoDMS-tree en worden ook niet berekend. De padafhankelijkheid vervalt hierdoor. FALSE: alle zichtjaren worden sequentieel doorlopen. Resultaten van eerder zichtjaren vormen input voor latere (padafhankelijk). Alle zichtjaren zijn zichtbaar in de boom. In batchmodus wordt deze parameter aangestuurd via de omgevingsvariabele AlleenEindjaar. LET OP: de keuze TRUE vs FALSE kan effect hebben op de allocatieresultaten doordat de padafhankelijke verdichtings- en verdringingsmechanismen anders doorwerken.";
	
	// ===== ONTKOPPELINGS­PARAMETERS =====
	// Het model kan in stappen worden uitgevoerd door tussenresultaten weg te schrijven ("ontkoppelen") en bij volgende runs te hergebruiken. Dit bespaart rekentijd tijdens ontwikkeling/debuggen.
	parameter<Bool>      AlwaysRemakeDecoupledFiles    := FALSE, Descr = "Zet dit op TRUE om elk ontkoppeld bestand opnieuw te laten maken, ook als het er al staat en de fingerprint klopt. Bedoeld voor het geval je vermoedt dat een bestand niet meer bij de configuratie past terwijl de fingerprint dat niet ziet, bijvoorbeeld omdat een invoer wel de uitkomst bepaalt maar nog niet in de fingerprint is opgenomen.
																				Normaal blijft deze op FALSE: dan bepaalt Templates/DecoupledFile_T per bestand of het hergebruikt mag worden. De fingerprint van een bestand is te lezen via het Explanation-item van de bijbehorende Decoupling-container.";
	parameter<Bool>      BaseDataOntkoppeld            :=  TRUE, Descr = "Gebruik maken van reeds berekende en opgeslagen (ontkoppelde) voorbereidende data (pre-allocatie, generiek). Optie: TRUE, FALSE. Deze data is voor alle varianten gelijk, en duurt relatief lang om te berekenen.";
	parameter<Bool>      VariantDataOntkoppeld         := =replace_value(expand(., '%env:VariantDataOntkoppeld%'), 'env:VariantDataOntkoppeld', 'TRUE'), Descr = "Gebruik maken van reeds berekende en opgeslagen (ontkoppelde) voorbereidende data (pre-allocatie, Variant-specifiek). Opties: TRUE, FALSE. Dit is handig bij het debuggen/exploreren van allocatie tussenstappen. Deze duren relatief kort om te berekenen, dus kan ook makelijk op FALSE staan. In batchmodus wordt deze parameter aangestuurd via de omgevingsvariabele VariantDataOntkoppeld. De batch bepaalt de waarde; de waarde hier is alleen de default voor de GUI en voor losse aanroepen.";
	parameter<Bool>      StandAllocatieOntkoppeld      := =replace_value(expand(., '%env:StandAllocatieOntkoppeld%'), 'env:StandAllocatieOntkoppeld', 'TRUE'), Descr = "Wil je ontkoppelde model (stand) resultaten gebruiken. Handing wanneer je in de GUI de indicatoren wil exploreren. In batchmodus wordt deze parameter aangestuurd via de omgevingsvariabele StandAllocatieOntkoppeld. De batch bepaalt de waarde; de waarde hier is alleen de default voor de GUI en voor losse aanroepen.";
	parameter<bool>      LandUseMapOntkoppeld          := FALSE, Descr = "Zijn de Land-use maps in de indicatoren al ontkoppeld?";
	parameter<Bool>      BAG_WP5_rel_Ontkoppeld        :=  TRUE, Descr = "Voor debug doeleinden; tijdens het debuggen is het onhandig om telkens dit te laten uitrekenen. Normaal kan dit dus op FALSE staan. Het wordt overigens in de SD ontkoppeld. Let op: het ontkoppelde bestand is een positionele array over de pandenset van dat jaar. Hoort het bij een andere pandenset, dan schuift de typering op en krijgen appartementenblokken het type van een ander pand; de IntegrityCheck op pand/WP5_rel in SourceData/Vastgoed/BAG.dms vangt dat af.";
	parameter<bool>      OntkoppelStedelijkeKlasses    := FALSE, Descr = "Debug: wanneer je alleen Landbouw wilt debuggen en de stedelijke functies exogeen wilt maken. Dan run je een keer de stedelijke functies, daarna zet je deze op TRUE.";
	
	parameter<YearRange> Model_StartYear               := 2023[YearRange], Descr = "Actueel/recent jaar met dubbele functie: 1) centraal uitgangspunt voor de allocatie; 2) IJkjaar voor dichtheden: de verhouding woningen/banen per hectare in dit jaar. Dient gelijk te zijn aan LISA_StartYear wanneer werken wordt meegealloceerd. Redenen:
																						1) De werkdichtheid (m²PandFootprint/ha) combineert BAG-pandfootprints van dit jaar (noemer) met
																						   LISA-banen van LISA_StartYear (teller). Bij ongelijke jaren is de ratio inconsistent.
																						2) De startstate combineert BAG-woningen/panden (van dit jaar) met LISA-banen (van LISA_StartYear).
																						   Panden gebouwd tussen LISA_StartYear en dit jaar bevatten dan 0 LISA-banen.
																						3) De groeiperiode naar het eerste zichtjaar (Model_FirstZichtjaar - Model_StartYear) veronderstelt dat de
																						   banendata van dit jaar is. Bij oudere LISA-data worden tussenliggende jaren niet gemodelleerd.
																						4) CBS-regioindelingen (gemeentegrenzen) kunnen tussen de twee jaren afwijken door herindeling."
																			, IntegrityCheck = "!SectorAllocRegio/Uq_Sectors/HasWerkenSector || uint32(This) == LISA_StartYear"; //de volgorde-toets tegen het eerste zichtjaar staat op Model_FirstZichtjaar; hier ook toetsen geeft een kring van IntegrityChecks en daarmee Invalid Recursion in UpdateMetaInfo
	parameter<YearRange> Model_FirstZichtjaar          := 2040[YearRange], Descr = "Eerste zichtjaar van de allocatie, en daarmee het tweede modeljaar na Model_StartYear. De zichtjarenreeks telt vanaf hier in stappen van tien door tot Model_FinalYear, dus deze waarde moet een heel decennium zijn.
																						Stond tot #658 vast op 2030. De TIGRIS-claim voor 2030 ligt in veel regio's onder de stand van het basisjaar, vooral bij de banen: voor Zak_dienstverlening in alle 76 regio's en voor Nijverheid in 75. Het model kan geen woningen of banen slopen om een claim te halen, dus daar kan alleen overrealisatie uitkomen. Met 2040 als eerste zichtjaar is de claim voor het merendeel van de regio's weer hoger dan de stand en verdwijnt die klem.
																						Let op: de eerste allocatiestap beslaat dan Model_FinalYear minus Model_StartYear jaar in plaats van zeven. De groeifactoren rekenen met de werkelijke periodelengte uit Zichtjaar/PrevYearRange_rel, dus dat gaat vanzelf goed, maar de padafhankelijkheid mist wel het tussenstation 2030."
																			, IntegrityCheck = "This > Model_StartYear && This < Model_FinalYear && (uint32(This) / 10) * 10 == uint32(This)";
	parameter<YearRange> Model_FinalYear               := 2120[YearRange], Descr = "Laatste jaar waarvoor standgegevens worden berekend in de allocatieprocedure", IntegrityCheck = "This > 2030[YearRange]"; //de volgorde-toets tegen het eerste zichtjaar staat op Model_FirstZichtjaar, zie de opmerking daar
	
	parameter<UInt8>     Default_NrOfIters             := 15b, Descr = "Aantal iteraties in de allocatie. Iteraties zijn  nodig om niet vervulde restclaims in een iteratie in een volgende iteratie te vervullen";
	parameter<UInt8>     Default_NrOfSequences         := 2b, Descr = "Aantal sequences in de allocatie. Sequences zijn nodig om verdrongen wooneenheden, banen etc in een sequentie in een volgende sequentie te heralloceren, voor zover de verdringing restclaims opleverede. Dit moet minimaal 2 zijn.", IntegrityCheck = "This >= 2b"; 
	container Skeleton
	: Descr = "De verkorte allocatieopzet voor de late zichtjaren. Vanaf VanafZichtjaar draaien de sectorallocregio's niet meer allemaal en niet meer met het volle aantal iteraties; wat elke regel dan doet staat in de kolom RolNaXZichtjaar van de tabel SectorAllocRegio hieronder.

				Waarom dit mag. De wonen- en werkenclaim bevriest op Advanced/FromWhichDoWeKeepTIGRISconstant, en de leeskant in Templates/Claims/ZichtjaarXScenarioxAllocRegios klemt daarop, dus vanaf het zichtjaar daarna is de claim gelijk aan die van het klemjaar terwijl de stand alleen kan groeien. Er valt dan niets meer te verdelen, en de COROP- en Provincie-passen die restclaims van NVM opvangen hebben geen werk meer.

				Waarom 2070 en niet 2060. Y2060 is niet het rustige jaar waar het op lijkt, maar het drukste van de late reeks. De klem staat op 2060, dus Y2060 leest zijn eigen claim en maakt nog een volle stap: op NVM in WLO_hoog/BAU van 10.067.002 naar 10.630.442 woningen, precies zo groot als de stap ervoor. Pas vanaf Y2070 is de stap nul. Tegelijk vervalt in Y2060 de plancapaciteitsvrijstelling (Advanced/PlancapaciteitGeldigTotEnMet op 2050), de trede-voorrang die daaraan hangt (TredeVolgtPlancapaciteitVervaldatum) en de eigendom-as (EigendomVolgtVervaldatum). Dat jaar met een enkele iteratie afdoen zou de allocatie juist raken op het moment dat de voorkeursvolgorde van locaties verandert.

				De keuze is een aanname over de claimreeks en hoort in de verantwoording van een run. Toets hem voordat je hem aanzet, met de restclaim-uitdraaien uit Diagnose op de standen van de vorige oplevering; dat kost geen allocatie. Let op dat de aanname in BAU en BAU2 is waargenomen: in NbSMax en NbSGenuanceerd staat VariantK/WaterbergingClaimActief op TRUE en groeit de bergingsopgave na 2060 gewoon door."
	{
		parameter<Bool>      Actief         := TRUE
		, Descr = "Staat de verkorte opzet aan? Op FALSE draait elk zichtjaar de volledige lijst met het volle aantal iteraties, en doet de kolom RolNaXZichtjaar niets.

					Wat hier nog niet is nagerekend, en waarom AantalIters op drie staat en niet op een. Een constante claim betekent niet dat er niets meer te alloceren valt: gemeten op verse standen gaat BAU van 10.580.566 woningen op Y2060 naar 10.602.608 op Y2080, dus 22.042 woningen erbij over twee zichtjaren, en de verstedelijking van 76.166,8 naar 76.921,4 ha. In NbSGenuanceerd is dat 23.123 woningen. De claim staat vanaf Y2060 stil, dus die woningen komen ergens anders vandaan, vermoedelijk uit herbouw van wat nieuwe natuur, water of vernatting heeft gesloopt. Meting uit de toetsronde van #753.

					Drie iteraties geven NVM ruimte om die herbouw te plaatsen waar een enkele dat niet zou doen. Wat drie iteraties niet terugbrengen is het vangnet: de passen op COROP en Provincie vangen nu de restclaim op die NVM binnen de eigen regio niet kwijt kan, en die vervallen met de rol Niet. Zit die herbouw geconcentreerd in regio's waar lokaal geen ruimte meer is, dan blijft er iets liggen en geeft niets daar een foutmelding over; het stopcriterium is statisch en toetst alleen of de laatste iteratie de laatste was.

					Toets een run met deze schakelaar aan dus op claimrealisatie voordat de uitkomst wordt geleverd, met de restclaim-uitdraaien uit Diagnose op Y2070 en later. Een schone exitcode zegt hier niets.";

		parameter<YearRange> VanafZichtjaar := 2070[YearRange]
		, Descr = "Vanaf welk zichtjaar de verkorte opzet geldt, dit jaar meegerekend. Moet op of na het zichtjaar na Advanced/FromWhichDoWeKeepTIGRISconstant liggen, want daarvoor groeit de claim nog en is er echt werk te doen. De IntegrityCheck bewaakt dat."
		, IntegrityCheck = "uint16(This) > ModelParameters/Advanced/FromWhichDoWeKeepTIGRISconstant";

		parameter<UInt8>     AantalIters           := 3b
		, Descr = "Hoeveel iteraties een regel met de rol Beperkt krijgt in de eerste sequentie. Moet minstens 1 zijn: nul iteraties geeft een lege Iter-unit in SectorAllocRegio_T en daarmee een last() op niets. Een regel die helemaal niet meer hoort mee te doen krijgt de rol Niet en wordt overgeslagen.

					Op drie en niet op een. Een enkele iteratie laat geen ruimte om een restclaim te herverdelen, en na Y2060 valt er nog wel degelijk te alloceren: zie de meting bij Actief hierboven. Hoeveel iteraties die herbouw werkelijk nodig heeft is niet gemeten, dus drie is een marge en geen uitkomst."
		, IntegrityCheck = "This >= 1b";

		parameter<UInt8>     AantalItersInLaterSeq := 1b
		, Descr = "Hoeveel iteraties een regel met de rol Beperkt krijgt in de vervolgsequenties. Lager dan in de eerste sequentie mag: de vervolgsequentie hoeft alleen te heralloceren wat in de eerste is verdrongen, en dat is een kleiner probleem dan de hele claim. Buiten de verkorte opzet doet de tabelkolom AantalItersInLaterSeq hetzelfde, daar met vijf tegen vijftien."
		, IntegrityCheck = "This >= 1b";
	}

	// Jaren/Data waarvoor recente waarnemingen beschikbaar zijn. t.b.v. het inlezen ervan.
	parameter<String>    RegioIndelingen_CBSjaar       := '2024'
	, Descr = "Welke jaargang van de CBS-gebiedsindelingen het model gebruikt, voor buurt, wijk, gemeente, COROP, provincie, de daaruit herbouwde NVM-regio en de landsgrens. Elk jaar uit RegioIndelingen/CBS_Gebiedsindelingen_jaren kan hier staan; de container die erbij hoort is RegioIndelingen/CBS/Gekozen.

																						Dit stond als last(CBS_Gebiedsindelingen_jaren) in de configuratie, en was daarmee de enige brondatabron die zichzelf bijstelde. Een gebiedsindelingenjaar erbij verzette de regiogrenzen als bijvangst, en dat is stil: de TIGRIS-claims staan als ontkoppelde csv per regio op schijf en worden op rijvolgorde gekoppeld, dus die bestanden houden hun naam en blijven staan terwijl de regio's eronder veranderen. Zolang het aantal regio's gelijk blijft komt er geen foutmelding. Zie #691 en #585.

																						Van jaargang wisselen vraagt daarom om het opnieuw genereren van de claim-csv's en om TIGRIS_claims_CBSjaar hieronder mee te verzetten; de IntegrityCheck op ClaimDir in Templates/Claims/ZichtjaarXScenarioxAllocRegios.dms houdt die twee gelijk. Twee dingen om te weten voordat je hem ophoogt. De levering 2026 die op schijf staat bevat alleen corop, provincie en gemeente_gegeneraliseerd, dus buurt, wijk en gemeente vallen daarop om. En RegioIndelingen/NL bepaalt via het studiegebiedmasker welke cellen in CompactedAllocDomain en CompactedAdminDomain zitten, dus een andere jaargang verzet in beginsel de hele allocatiebasis.";
	parameter<UInt32>    BAG_RecentYear                :=  2026, Descr = "Wat is het meest recent beschikbare jaar van de BAG";
	parameter<String>    BAG_file_date                 := '20260710', Descr = "Welke bestandsdatum van BAG moet worden gebruikt";
	parameter<UInt32>    LISA_FileYear                 :=  2023, Descr = "Wat is het bestandsjaar van de LISA dataset";
	parameter<UInt32>    LISA_StartYear                :=  2023, Descr = "Welk jaar van LISA moet worden gebruikt", IntegrityCheck = "LISA_StartYear <= LISA_FileYear"; //evident dat lisa startjaar kleiner over gelijk moet zijn aan het filejaar. Het zijn immers geen prognses.
	parameter<String>    BBG_Year                      := '2022', Descr = "Welk jaar van BBG moet worden gebruikt. Bewuste keuze: de werken-suitability gebruikt de actuele landgebruiksaandelen bij coefficienten die op 2012-aandelen zijn geschat; bij een start-of-period model hoort de actuele stand als input (zelfde redenering als de dynamische UAI, #599). Kanttekening: NBBG2022 (CBS2020-klassen) is een methodebreuk ten opzichte van de BBG2012-schattingsdata, en de nieuwe klasse zonnepark telt mee als overig bebouwd.";
	parameter<String>    BBG_Verblijfsrecreatie_Year   := '2022', Descr = "Om Verblijfsrecreatie trends te bepalen moet een BBG jaar gekozen worden.";
	parameter<String>    BGT_file_date                 := '20260819', Descr = "Welke bestandsdatum van de Basisregistratie Grootschalige Topografie moet worden gebruikt"; 
	parameter<String>    BegrenzingBebouwdGebied_jaar  := '2022', Descr = "Peiljaar van de begrenzing bebouwd gebied die als bestaand bebouwd gebied geldt. Beschikbaar: 2012 en 2022. Deze begrenzing bepaalt niet alleen de inbreidingsindicator en de bereikbaarheid van groen, maar via Grondproductiekosten ook de residuele waarde en daarmee de allocatie zelf. Van peiljaar wisselen vraagt dus een volledige herberekening van alle zichtjaren.";
	parameter<String>    BRT_file_date                 := '20260601', Descr = "Welke bestandsdatum van de Basisregistratie Topografie moet worden gebruikt";
	parameter<String>    IBIS_Year                     := '2024', Descr = "Welk jaar van IBIS moet worden gebruikt. Alleen 2023 en 2024 werken: de Result-container vereist netto_oppervlakte, een numeriek Uitgegeven-veld, maximale_milieucategorie en het vol-veld, en die ontbreken of verschillen in de oudere vintages.", IntegrityCheck = "uint32(this) >= 2023";
	parameter<String>    NVM_filedate                  := '20260711', Descr = "Welke bestandsdatum van de NVM-coefficienten moet worden gebruikt. Bepaalt ook de map van de regio-/nationale karakteristieken. NB: de Estimates_20260711_*-bestanden bevatten sinds 2026-07-17 de rs_groen-set (redev + fr_natuur_tot2500m/fr_water_500m, RSopen #566/#481); de eerdere groenloze redev-versies staan als Estimates_20260711_redev_* in de PriceIndices-Output op OneDrive.";
	parameter<String>    NVM_coeff_Year                := '2023', Descr = "Welk jaar moet als prijsniveau worden gehanteerd uit de hedonische prijsanalyse";
	parameter<String>    Verblijfsrec_coeff_date       := '20211213', Descr = "Welke bestandsdatum van de Verblijfsrecreatie coëfficiënten moet worden gebruikt, tbv suitability";
	parameter<String>    Werken_coeff_date             := '20220401', Descr = "Welke bestandsdatum van de Werken coëfficiënten moet worden gebruikt, tbv suitability";
	parameter<String>    NWB_file_date                 := '20211001', Descr = "Welke bestandsdatum van het Nationaal Wegenbestand moet worden gebruikt";
	parameter<String>    LGN_Year                      := '2025', Descr = "Welke bestandsdatum van het Landelijk Grondgebruiksbestand Nederland moet worden gebruikt";
	parameter<String>    BRP_Year                      := '2025', Descr = "Welk jaar van de Basisregistratie Gewaspercelen moet worden gebruikt. Dit is de derde grondgebruiksbron naast BBG_Year en LGN_Year, en de enige die per perceel werkt; zie #751 voor wie welke van de drie leest. De naam van het bestand is brpgewaspercelen_definitief_<jaar>.gpkg in de wortel van %sourceDataDir%.";
	parameter<String>    Landgebruik_Basis             := 'BBG', IntegrityCheck = "this == 'BBG' || this == 'LGN'"
	, Descr = "Op welke bron de basisjaarkaart van het landgebruik rust (#751). BBG: de CBS-bodemstatistiek van BBG_Year bepaalt de klasse, met de BRP en LGN als achtervang voor de landbouw; dit is de route die tot september 2026 de enige was. LGN: de fysieke bedekking van LGN_Year is de basis, verbijzonderd met de natuurbeheertypen waar LGN natuur of water zegt en met de BRP waar LGN landbouw zegt, en de bebouwing komt uit de BAG- en LISA-standen via de dominantieregel van de kaart. Zie BaseData/StartState/Landgebruik.

																						Een schakelaar en geen vervanging, want dit verschuift elke areaalindicator en elke koolstofbasis; leg de twee routes naast elkaar met BaseData/StartState/Landgebruik/Controle voordat de default omgaat.";
	parameter<String>    Beheertype_Basisjaar_Bron     := 'MNP', IntegrityCheck = "this == 'MNP' || this == 'NVK'"
	, Descr = "Welke kaart het natuurbeheertype van de bestaande natuur en het bestaande water in het basisjaar geeft (#751). MNP: de planpotentieelkaart van de MNP, gemaskeerd op waar LGN natuur of water ziet; dat was tot september 2026 de enige bron. NVK: de kaart huidig van de Natuurverkenning (2020, 2,5 meter), via SourceData/Grondgebruik/NVK/Huidig/INL_Beheertype_25m. De provinciale natuurbeheertypenkaart 2025 die via WUR komt hoort hier als derde waarde bij zodra hij er is. Tot dan is MNP de default: NVK wijkt 60.138 ha echt en 241.901 ha in detail af van wat BAU en de landschappen opleggen, en geeft groot water zonder N-code (zee, meer, plas) geen N04-type; zie de Descr bij SourceData/Grondgebruik/Natuur/Basisjaar/BT_Levering.";
	parameter<Bool>      Beheertype_GatenVullen        := TRUE
	, Descr = "Vult de basisjaar-beheertypenkaart aan waar de gekozen bron zwijgt (#751): eerst met de andere beheertypenkaart (NVK naast MNP of andersom), daarna met een heuristiek uit de bodemstatistiek voor het water (zee, afgesloten zeearm, rivier, plas) en uit LGN met de veenkaart voor de begroeiing (bos, heide, duin, moeras, nat of droog). Gemeten op 2026-09-04 voor het vullen: 121.099 ha natuur en water volgens LGN zonder beheertype, waarvan 75.190 ha water en 41.000 ha bos. Zie BaseData/StartState/Landgebruik/Beheertype_Heuristiek. Uit voor een A/B-vergelijking met de kale bron.";
	parameter<String>    Oplegging_Route               := 'Oud', IntegrityCheck = "this == 'Oud' || this == 'Nieuw'"
	, Descr = "Welke keten de exogene natuuroplegging levert (#751). Oud: de twee stromen ExoNatuur en ExoWater uit SourceData/Grondgebruik/Natuur/Varianten met de vlaggen op NatuurType. Nieuw: de ene stroom van Templates/VariantData/Natuur_T, water als eigenschap van het type, het veenwater van 9a en 9b buiten de stroom. Beide ketens staan naast elkaar en VariantData/<variant>/ExogeenOpleggen/AB legt ze per cel naast elkaar; zet deze schakelaar pas om als die vergelijking is gelezen, en gooi de oude keten daarna weg.";
	parameter<String>    TIGRIS_filedate               := '20251216_Run32', Descr = "Welke versie van de TIGRIS-claims moet worden gebruikt (relevant voor wonen/werken)";
	parameter<String>    TIGRIS_claims_CBSjaar         := '2024'
	, Descr = "Op welke jaargang van de CBS-gebiedsindelingen de claim-csv's onder TIGRIS_filedate zijn geaggregeerd. Geen keuze maar een eigenschap van de bestanden die al op schijf staan, en de versiestempel die #585 onder punt 2 vroeg: de bestandsnaam draagt alleen de TIGRIS-vintage en niet de regio-indeling waarop is gesommeerd.

																						De set van 20251216_Run32 is op 2026-08-21 weggeschreven op RegioIndelingen_CBSjaar 2024. Dat is op 2026-09-01 nagemeten: de aggregatie op de huidige codestand levert voor alle vier de indelingen en alle drie de TIGRIS-jaren exact dezelfde waarden als de csv's op schijf, dus de bestanden en de regiodefinitie liepen op dat moment niet uiteen (#691).

																						Wie de claims opnieuw genereert op een andere jaargang, verzet deze parameter in dezelfde wijziging. De IntegrityCheck op ClaimDir in Templates/Claims/ZichtjaarXScenarioxAllocRegios.dms weigert de combinatie waarin de twee uiteenlopen."; 
	parameter<String>    Restricties_filedate          := '2026-08-28_15-25-40', Descr = "Welke bestandsdatum van de Ruimtelijke Restricities moet worden gebruikt.

																						De set van 2026-08-28 verschilt op drie punten van 2026-05-19. Twee vergriddingsfouten zijn gerepareerd, waardoor de plaatsgebonden risicocontour langs het Basisnet er wel volledig in zit; daar kwam 64,5 van de 11.576 hectare doorheen. De categorie ZeerHard is uitgesplitst, zodat die alleen nog gebiedsverboden bevat: rijksmonumenten en beschermde stads- en dorpsgezichten staan nu op Hard en de hoogspanningsbuffer op Middel. En de LIB-zones die over woningen en geluidgevoelige gebouwen gaan gelden niet meer voor bedrijventerrein. Binnen bebouwd gebied gaat ZeerHard daarmee van 36.107 naar 19.874 hectare voor wonen en van 36.060 naar 16.358 hectare voor werken. Zie #686 en pbl-nl/model-RS-RuimtelijkeRestricties#5.

																						Let op: de set bevat geen kaarten voor wind meer. Die werden niet gelezen, want wind zit niet in de sectorlijst en heeft in RSopen een eigen dynamische restrictiemodule.";
	parameter<String>    Stimuli_filedate              := '2026-03-10_18-02-04', Descr = "Welke bestandsdatum van de Stimuli moet worden gebruikt";
	parameter<String>    PlanCapaciteit_filedate       := '2025-11-20_15-23-29', Descr = "Welke bestandsdatum van de Plan Capaciteiten moet worden gebruikt";
	parameter<Bool>      UsePrivPlanCapaciteit         := TRUE, Descr = "Er zijn publiek en niet-publiek beschikbare plancapaciteiten. Wil je die niet-publieke gebruiken?";

	parameter<Bool>      VBO_opp_truncation_BovengrenzenAlleenWoon := TRUE
	, Descr = "Laat de twee bovengrenzen op de vbo-gebruiksoppervlakte in SourceData/Vastgoed/BAG.dms alleen gelden voor verblijfsobjecten met een woonfunctie (#700). Het gaat om de regel dat een vbo groter dan vijf keer de voetafdruk van zijn pand op null gaat, en om de afkapping op VBO_opp_truncation_upper (500 m2). Beide heten Woon en hun grenswaarden staan onder ModelParameters/Wonen, maar ze golden voor elk verblijfsobject; de ondergrens ernaast heeft de woon-vlag wel altijd gehad.
					Op FALSE staat het gedrag van voor #700: dan verdwijnt bij woningen 2,2 procent van het oppervlak en bij de rest tweederde. Al het niet-woon vloeroppervlak gaat dan van 550 naar 180 miljoen m2, waardoor het vbo-oppervlak per subsector onder de pandvoetafdruk zakt, dus onder een bouwlaag. Dat raakt de overstromingsschade aan bedrijfsmatig vastgoed via Ratio_Footprint_Opp_perAdminDomain, en de sloop- en verwervingskosten van niet-woningen via VBOopp_perGebruiksdoel/niet_woon_AdminDomain.";

	parameter<Units/cm>  VBO_opp_LaaghoogteNietWoon    := 300[Units/cm]
	, Descr = "Bovengrens op de gebruiksoppervlakte van een niet-woon verblijfsobject: wat er fysiek in het pand past, oftewel de pandvoetafdruk maal het aantal bouwlagen uit de hoogte van de AHN-pandenset, maal de tolerantie hieronder. Deze twee parameters worden gelezen in SourceData/Vastgoed/BAG.dms. Ze vervangen voor niet-woon de bovengrenzen die #700 daar terecht heeft weggehaald, want die waren op een woningmaat geijkt; deze grens is op het gebouw zelf geijkt. Panden zonder hoogte blijven ongemoeid, dat is 2,6 procent van de panden met niet-woon vastgoed.

					Aanleiding: zonder bovengrens laat de BAG oppervlaktes door die geen gebouw kunnen zijn. Gemeten op de jaarset van het modeljaar stonden er 107 verblijfsobjecten boven de 100.000 m2, samen 20,5 miljoen m2, waarvan vier van gemiddeld 872.000 m2. De klem haalt daar 30,06 miljoen m2 af, 5,5 procent van het niet-woon vloeroppervlak.

					Deze parameter zelf: hoeveel hoogte er voor een bouwlaag wordt gerekend bij het omrekenen van pandhoogte naar bouwlagen. Drie meter is ruim voor een kantoor en krap voor een bedrijfshal: bij tien meter hoogte staat deze regel drie lagen toe waar er in werkelijkheid een is. Dat maakt de grens hieronder mild, en dat is bewust, want dit is een filter op datafouten en geen modellering van de voorraad.";

	parameter<Float32>   VBO_opp_TolerantieNietWoon    := 2.0f
	, Descr = "Hoeveel keer de fysieke ruimte een verblijfsobject mag beslaan voordat het geklemd wordt. Op 1,0 gaat er 9,4 procent van het niet-woon vloeroppervlak af, op 2,0 nog 4,6 procent. Twee betekent dus: alleen wat meer dan tweemaal in het gebouw past gaat eruit.";

	parameter<Bool>      SloopVolgtExogeneOplegging    := FALSE
	, Descr = "Wordt de bestaande bebouwing gesloopt op elke cel waar het model een nieuw landgebruik oplegt? Staat sinds #620 uit, op verzoek vanuit Deltares van 28 augustus 2026: verspreide bebouwing buiten bestaand bebouwd gebied mag blijven staan en met de nieuwe natuur samengaan, tenzij een levering die cel uitdrukkelijk als sloopgebied aanwijst.
					Op TRUE staat het gedrag van voor die datum, en dat is hoe het model het altijd heeft gedaan: een cel kan geen twee dingen tegelijk zijn, dus waar natuur of water wordt opgelegd gaat de stand op nul. Het gevolg was dat de sloop de natuurkaart volgde in plaats van de bedoeling van de levering. Bij zand sloopte het model 1.037 woningen die #630 juist wilde sparen, bij veen 25.029 waar de bebouwingstypekaart bouwen toestond, en bij rivieren 2.496 buiten de sloopshape van #620. In BAU, BAU2 en NbSMax is er geen sloopkaart, dus daar is dit de enige sloopgrond en gaat de opgelegde sloop met deze schakelaar op nul.
					Wat er niet mee verandert. De cel gaat nog steeds op slot voor nieuwe allocatie, want dat loopt langs Zeef_T/IsRestrictief_DoorExogeenopleggen. En de landgebruikskaart zet de cel nog steeds op de opgelegde klasse, want de oplegging gaat daar voor op de afscherming van bestaand wonen. Een cel telt dus als natuur terwijl er woningen in de stand blijven staan. Op 25 meter is dat te verdedigen, een woning beslaat een fractie van de 625 m2, maar het is wel een dubbeltelling die je moet kennen als je natuurareaal en woningvoorraad naast elkaar legt.
					De uitzondering voor bestaand bebouwd gebied en voor hoofdwegen, spoor, vliegvelden en begraafplaatsen zit hier niet in; die staat los in BaseData/Omgeving/Opleggingsmasker en geldt in alle varianten, zie #641.";

	parameter<Bool>      SloopVereistNieuwLandgebruik  := TRUE
	, Descr = "Mag er alleen gesloopt worden waar er ook werkelijk een nieuw landgebruik voor in de plaats komt? Staat aan, op de keuze van 2026-08-31 in #684.

					De redenering is die van de veenlevering zelf: de sloop is daar het gevolg van de omzetting naar een natuurbeheertype, en geen zelfstandige opgave. Landt de omzetting niet op de cel, dan is er ook geen reden om de bebouwing te laten wijken. Zonder deze koppeling leegde het model in NbSGenuanceerd 121.708 ha en 29.521 woningen waar niets voor in de plaats kwam; die cellen hielden op de landgebruikskaart hun huidige klasse en stonden er met nul woningen in.

					Gemeten op 2026-08-31, aan tegenover uit. De opgelegde sloop gaat van 31.510 naar 3.426 woningen. Wat er zonder nieuw landgebruik geleegd wordt is nog 10.567 ha met 1.437 woningen, en dat is precies het sloopgebied van rivieren; het veendeel is nul. Gespaard wordt 111.141 ha met 28.084 woningen. Die woningen genereren daarmee ook geen vervangende nieuwbouw meer via de restclaim.

					Let op de wisselwerking met de pandentoets, die sinds #768 anders uitpakt. Die toets sloeg cellen met een BAG-pand over (#661), dus daar landde geen oplegging en werd met deze koppeling ook niet gesloopt; in het veen wijken dan 204,6 woningen, en dat was een uitkomst van de zeef en niet van de levering. Deltares heeft in #768 gesteld dat de bouwstenen over de bestaande bebouwing heen komen te liggen, dus Templates/SourceData/NatuurAlloc_T/NatuurNietOpPanden staat uit. Daarmee landt de sloopbouwsteen wel op de bebouwde cel en wijken er in het veen 25.352,6 woningen en 21.827,7 banen, allemaal met een landgebruik uit dezelfde bouwsteen ervoor in de plaats.

					Het landschapstype Rivieren is uitgezonderd en blijft onvoorwaardelijk slopen. Daar kan de sloop uit veiligheidsoverwegingen zijn gekozen en staat nog niet vast wat er voor in de plaats komt; zie de openstaande vraag in #684. Kust sloopt sinds #707 niet meer en zand nooit, dus die twee raakt de koppeling niet.

					Een nieuw landschapstype valt hier vanzelf onder de koppeling. Wil een levering onvoorwaardelijk slopen, dan hoort ze net als rivieren met naam en reden in Sloop/VereistNieuwLandgebruik te staan. Dat is de veilige kant: te weinig slopen is zichtbaar in de stand, te veel slopen niet.

					Deze schakelaar is de tegenhanger van SloopVolgtExogeneOplegging hierboven. Die zegt dat een oplegging op zichzelf genoeg is om te slopen en staat uit; deze zegt dat een oplegging nodig is om te mogen slopen en staat aan. Samen: gesloopt wordt er waar de levering het vraagt en de omzetting ook landt.";

	#include<Wonen.dms>
	#include<Werken.dms>
	#include<Verblijfsrecreatie.dms>
	#include<Zon.dms>
	#include<Wind.dms>
	#include<Landbouw.dms>
	#include<Waterberging.dms>
	#include<Piekbuiberging.dms>
	#include<Natuur.dms>
	#include<ClaimBasisjaar.dms>
	#include<UtiliteitCombi.dms>
	#include<Advanced.dms>
	
	// ===== ALLOCATIEVOLGORDE (SectorAllocRegio/Elements/Text) =====
	// Deze tabel definieert de volgorde waarin sectoren worden gealloceerd en op welk regionaal
	// schaalniveau. Elke rij bevat 5 kolommen (zie nrAttr):
	//
	//   1. name             : Sectornaam (moet overeenkomen met Classifications/Actor/Sector)
	//   2. AllocRegio       : Regionaal schaalniveau waarop claims worden verdeeld
	//                         (NVM, COROP, Provincie, NL).
	//   3. UseInLaterSeq    : TRUE = deze sector kan worden verdrongen door latere sectoren en wordt
	//                         daarom in opvolgende sequenties opnieuw doorlopen om verdrongen eenheden
	//                         te heralloceren. FALSE = eenmalige allocatie, geen herberekening bij verdringing.
	//                         Alleen de kleinste regio per sector krijgt TRUE (verdringing zo lokaal mogelijk).
	//   4. AantalIters      : Aantal iteraties in de eerste sequentie (Default_NrOfIters of specifiek).
	//   5. AantalItersInLaterSeq : Aantal iteraties in eventuele vervolgsequenties.
	//   6. RolNaXZichtjaar  : Wat deze regel doet vanaf Skeleton/VanafZichtjaar, zodra Skeleton/Actief aanstaat.
	//                         Drie rollen. 'Volledig' is onveranderd meedoen, dus op de kolommen 4 en 5 hierboven.
	//                         'Beperkt' is meedoen met Skeleton/AantalIters in de eerste sequentie en
	//                         Skeleton/AantalItersInLaterSeq in de vervolgsequenties. 'Niet' is overslaan: de regel
	//                         geeft zijn ingangsstand door zonder te alloceren, langs dezelfde tak die
	//                         OntkoppelStedelijkeKlasses gebruikt.
	//                         De kolom noemt de rol en niet het aantal, want de eerste en de vervolgsequentie
	//                         krijgen een verschillend aantal en een tabelcel kan er maar een dragen.
	//                         Staat Skeleton/Actief op FALSE, dan doet deze kolom niets.
	//
	// VOLGORDE IS BELANGRIJK: sectoren worden van boven naar beneden gealloceerd.
	// Gelijke sectornamen (bijv. Wonen op NVM, daarna Wonen op Provincie) worden na elkaar doorlopen:
	// eerst de fijnste regio, dan grovere regio's om restclaims op te vangen.
	// Uitgecommentarieerde regels (bijv. COROP, Landbouw) zijn beschikbaar maar momenteel niet actief.	
	
	unit<UInt8> SectorAllocRegio := range(uint8, 0b, 7b) // e.g. 7 = het huidige aantal SectorAllocRegio-combinaties in Elements/Text hieronder. Pas dit aan als je regels toevoegt/verwijdert.
	, Descr = "Volgorde waarin de sectoren gealloceerd worden, incluisef het schaalniveau waarop dit (achtereenvolgens) gebeurt (de AllocRegio's)."
	, using = "/Classifications;/Classifications/actor;/Classifications/Modellering"
	{
		unit<Uint32> Elements := Range(uint32, 0, nrAttr * #.) 
		, Descr = "Gelijke sectoren moeten direct na elkaar komen. van klein naar grote alloc regios. Teneinde verdringing zo lokaal mogelijk op te lossen. Anders kan wel, maar geeft wellicht onwenselijke resultaten."
		{
			attribute<String> Text: [
			// name                , AllocRegio            , UseInLaterSeq , AantalIters        , AantalItersInLaterSeq , RolNaXZichtjaar
			  'Wonen'              , 'NVM'                 ,  'TRUE'       ,'Default_NrOfIters' ,'5'                    , 'Beperkt'
			 ,'Wonen'              , 'COROP'               , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters'    , 'Niet'
			 ,'Wonen'              , 'Provincie'           , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters'    , 'Niet'
			 // ,'Wonen'              , 'NL'                  , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters' , 'Niet'
			 ,'Werken'             , 'NVM'                 ,  'TRUE'       ,'Default_NrOfIters' ,'5'                    , 'Beperkt'
			 ,'Werken'             , 'COROP'               , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters'    , 'Niet'
			 ,'Werken'             , 'Provincie'           , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters'    , 'Niet'
			 // ,'Werken'             , 'NL'                  , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters' , 'Niet'
			 // ,'Verblijfsrecreatie' , 'Provincie'           ,  'TRUE'       ,'Default_NrOfIters' ,'Default_NrOfIters' , 'Volledig'
			 ,'Waterberging'       , 'Waterbergingsregio'  ,  'FALSE'      ,'Default_NrOfIters' ,'Default_NrOfIters'    , 'Volledig'
			 // ,'Zon'                , 'Provincie'           ,  'TRUE'       ,'Default_NrOfIters' ,'Default_NrOfIters' , 'Volledig'
			 // ,'Wind'               , 'Provincie'           ,  'TRUE'       ,'NrOfIters_Wind'    ,'NrOfIters_Wind'    , 'Volledig'
			 // ,'Wind'               , 'NL'                  , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters' , 'Niet'
			 // ,'Landbouw'           , 'Provincie'           , 'FALSE'       ,'Default_NrOfIters' ,'Default_NrOfIters' , 'Volledig'
			 //
			 // Zet je Landbouw hier aan, lees dan eerst de voorwaarde bij
			 // SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/SloopUitGealloceerdeBouwsteen.
			 // Die schakelaar legt sinds #684 natte teelt en vernat grasland op via ExogeenOpleggen/Totaal, en
			 // Iter_Landbouw_T leest dat item als Beschikbaar := IsNull(Totaal). Opgelegde landbouw zou zichzelf
			 // daarmee uit de landbouwallocatie schrijven: 207.947 ha die de claim elders moet zoeken en daar iets
			 // anders verdringt. Zolang deze regel uitstaat is dat ongevaarlijk.
			];
		}
		
		attribute<String>       Default_Sectorname    := Elements/Text[value(uint32(id(.))* nrAttr + 0, Elements)];
		attribute<Sector>       Default_Sector        := ='union_data(.,'+asList('Sector/V/'+Default_Sectorname, ',')+')', Descr = "relatie naar Sector";
		// attribute<String>     Default_Regioname     := replace(Elements/Text[value(uint32(id(.))* nrAttr + 1, Elements)], 'Rec_AllocRegio_name', Recreatie_AllocRegio_name);
		attribute<String>       Default_Regioname     := Elements/Text[value(uint32(id(.))* nrAttr + 1, Elements)];
		attribute<AllocRegiosK> Default_Regio         := ='union_data(.,'+asList('AllocRegiosK/V/'+Default_Regioname, ',')+')', Descr = "relatie naar AllocRegio";
		
		parameter<String>       Recreatie_AllocRegio_name := MakeDefined(rjoin('Verblijfsrecreatie', Default_Sectorname, Default_Regioname), 'Provincie');
		// Kan een sector verdrongen worden door daarop volgende sectoren? In dat geval moet deze sector in een volgende sequence opnieuw worden doorlopen. In dat geval moet deze sector TRUE krijgen.
		// Verdringing wordt vervolgens zo lokaal mogelijk opgelost, en dus krijgt de kleinste regio per sector een TRUE.
		attribute<Bool>         UseInLaterSequences     := Elements/Text[value(uint32(id(.))* nrAttr + 2, Elements)][bool]; 
		attribute<UInt8>        AantalIters             := uint8(replace(Elements/Text[value(uint32(id(.))* nrAttr + 3, Elements)], 'Default_NrOfIters', string(ModelParameters/Default_NrOfIters), 'NrOfIters_Wind', string(ModelParameters/Wind/NrOfIters_Wind))), Descr = "Hier wordt het aantal iteraties uit de ModelParameters opgehaald en in deze lijst toegevoegd.";
		attribute<UInt8>        AantalItersInLaterSeq   := uint8(replace(Elements/Text[value(uint32(id(.))* nrAttr + 4, Elements)], 'Default_NrOfIters', string(ModelParameters/Default_NrOfIters), 'NrOfIters_Wind', string(ModelParameters/Wind/NrOfIters_Wind))), Descr = "Er kan eventueel voor worden gekozen in latere sequenties minder iteraties te gebruiken. Dat kan hier insteld worden.";
		attribute<String>       RolNaXZichtjaar         := Elements/Text[value(uint32(id(.))* nrAttr + 5, Elements)]
		, IntegrityCheck = "all(this == 'Volledig' || this == 'Beperkt' || this == 'Niet')"
		, Descr = "Wat deze regel doet vanaf Skeleton/VanafZichtjaar. Drie rollen: Volledig is onveranderd meedoen met de gewone kolommen AantalIters en AantalItersInLaterSeq, Beperkt is meedoen met de aantallen uit Skeleton, en Niet is overslaan.

					De kolom noemt de rol en niet het aantal, met opzet. Een getal in de tabel kan maar een waarde dragen, terwijl de eerste en de vervolgsequentie een verschillend aantal iteraties horen te krijgen; het aantal hoort dus bij Skeleton en de rol bij de regel. Wie de verkorting ruimer of krapper wil zet Skeleton/AantalIters om en hoeft de tabel niet aan te raken.

					De IntegrityCheck is geen luxe: een typefout of een kolom die door een verkeerde nrAttr verschoven is zou anders stil als een geldige rol doorlopen. Deze check is meteen de kanarie voor een nrAttr die niet meer bij het aantal kolommen past.";
		attribute<Bool>         DoetMeeNaXZichtjaar     := RolNaXZichtjaar != 'Niet', Descr = "Doet deze regel vanaf Skeleton/VanafZichtjaar nog mee? Zo nee, dan slaat SectorAllocRegio_T hem over langs StateNaAllocatie_NoAlloc en geeft hij de ingangsstand door. Er wordt nooit een aantal van nul doorgegeven; dat zou een lege Iter-unit geven.";
		attribute<Bool>         IsBeperktNaXZichtjaar   := RolNaXZichtjaar == 'Beperkt', Descr = "Draait deze regel vanaf Skeleton/VanafZichtjaar op de aantallen uit Skeleton in plaats van op de eigen kolommen? Sequence_T kiest daarop, want alleen daar is bekend of het de eerste of een vervolgsequentie is.";
		attribute<String>       SortOrder               := string(rlookup(Default_Sectorname, Default_Sectorname)), Descr = "foolproof oplossing om een sortorder af te dwingen, die gebruikt wordt bij de sortering van Uq_Sectors";
		
		attribute<AllocRegiosK> AllocRegio_rel          := Default_Regio;
		attribute<Sector>       Sector_rel              := Default_Sector;
		
		attribute<String>       name                    := AllocRegio_name +'_'+ Sector_name;
		attribute<String>       SectorAllocRegio_name   := Sector_name +'_'+ AllocRegio_name;
		attribute<String>       Sector_name             := Sector/name[Sector_rel];
		attribute<String>       AllocRegio_name         := AllocRegiosK/name[AllocRegio_rel];
		attribute<String>       AllocRegio_path         := AllocRegiosK/path[AllocRegio_rel];
		
		attribute<Bool>         IsFirstSectorAllocRegio := id(.) == 0b;
		attribute<String>       PrevName                := IsFirstSectorAllocRegio ? '' : name[id(.) - min_elem( id(.), 1b)];
		attribute<String>       PrevState               := IsFirstSectorAllocRegio ? 'StateVoorAllocatie' : PrevName+'/StateNaAllocatie';
		attribute<String>       Subsector_ref           := Sector/Subsector_ref[Sector_rel];
		
		unit<UInt8>             WonenAllocRegio := select_with_org_rel(Sector_rel == Sector/V/Wonen);
		
		unit<UInt8> Uq_AllocRegios := unique(AllocRegio_name)
		, Descr = "Unieke lijst van AllocRegio's die in deze variant gebruikt worden. Nodig om bijvoorbeeld voor alle gebruikte allocregio's iets uit te rekenen."
		{
			attribute<String> AllocRegio_name := values;
			attribute<String> AllocRegio_path := rjoin(lowercase(AllocRegio_name), lowercase(../AllocRegio_name), ../AllocRegio_path);
		}
		unit<UInt8> Uq_Sectors := unique(SortOrder + Default_Sectorname)
		, Descr = "SortOrder wordt hier voorgezet om ervoor te zorgen dat dit niet alfabetisch wordt gesorteerd.
					Dit wordt gebruikt om in if-statements te kijken of bepaalde sectoren wel of niet gealloceerd worden."
		{
			attribute<String> Sectorname                  := substr(values, 1, 99);
			attribute<Bool>   IsWonen                     := lowercase(Sectorname) == lowercase('Wonen');
			attribute<Bool>   IsWerken                    := lowercase(Sectorname) == lowercase('Werken');
			attribute<Bool>   IsVerblijfsrecreatie        := lowercase(Sectorname) == lowercase('Verblijfsrecreatie');
			attribute<Bool>   IsZon                       := lowercase(Sectorname) == lowercase('Zon');
			attribute<Bool>   IsWind                      := lowercase(Sectorname) == lowercase('Wind');
			attribute<Bool>   IsLandbouw                  := lowercase(Sectorname) == lowercase('Landbouw');
			parameter<Bool>   HasWonenSector              := any(IsWonen);
			parameter<Bool>   HasWerkenSector             := any(IsWerken);
			parameter<Bool>   HasVerblijfsrecreatieSector := any(IsVerblijfsrecreatie);
			parameter<Bool>   HasZonSector                := any(IsZon);
			parameter<Bool>   HasWindSector               := any(IsWind);
			parameter<Bool>   HasLandbouwSector           := any(IsLandbouw);
			
			unit<UInt8> wo_Landbouw := select_with_attr_by_cond(., NOT(IsLandbouw));
		}
		
		unit<UInt8> SectorAllocRegio_LaterSeq := select_with_org_rel(SectorAllocRegio/UseInLaterSequences)
		{
			attribute<String>       name                  := ../name[org_rel];
			attribute<Sector>       Sector_rel            := ../Sector_rel[org_rel];
			attribute<UInt8>        AantalIters           := ../AantalIters[org_rel];
			attribute<UInt8>        AantalItersInLaterSeq := ../AantalItersInLaterSeq[org_rel];
			attribute<Bool>         IsBeperktNaXZichtjaar := ../IsBeperktNaXZichtjaar[org_rel], Descr = "Moet mee, want Sequence_T leest deze kolom op de unit die het krijgt doorgegeven, en dat is voor de vervolgsequenties deze deelverzameling.";
			attribute<Bool>         DoetMeeNaXZichtjaar   := ../DoetMeeNaXZichtjaar[org_rel];
			attribute<AllocRegiosK> AllocRegio_rel        := ../AllocRegio_rel[org_rel];
			attribute<String>       Label                 := ../Label[org_rel];
			attribute<String>       Sector_name           := ../Sector_name[org_rel];
			attribute<String>       AllocRegio_name       := ../AllocRegio_name[org_rel];
			attribute<String>       AllocRegio_path       := ../AllocRegio_path[org_rel];
			attribute<String>       SrcRefRestricties     := ../SrcRefRestricties[org_rel];
			attribute<String>       Subsector_ref         := ../Subsector_ref[org_rel];
		
			attribute<Bool>   IsFirstSectorAllocRegio := id(.) == 0b;
			attribute<String> PrevName                := IsFirstSectorAllocRegio ? '' : name[id(.) - min_elem( id(.), 1b)];
			attribute<String> PrevState               := IsFirstSectorAllocRegio ? 'StateVoorAllocatie' : PrevName+'/StateNaAllocatie';
			
			
			parameter<String> LastSectorBeforeWind     := LastInSector[Sector/V/Wind - 1[Sector]];
			attribute<String> LastInSector    (Sector) := last(name, Sector_rel);
			attribute<String> Sector_PrevName (Sector) := Sector/name[id(Sector)- 1[Sector]];
			
			container V := for_each_nedv(name, string(id(.))+'[..]', void, .);
		}
		
		parameter<UInt32> nrAttr := 6, Descr ="Aantal kolommen per rij in Elements/Text: name, AllocRegio, UseInLaterSeq, AantalIters, AantalItersInLaterSeq, RolNaXZichtjaar. Wordt gebruikt om de Text-array te indexeren (id * nrAttr + kolomnr).

					Klopt dit getal niet met het werkelijke aantal kolommen, dan schuift elke kolom op zonder foutmelding. De IntegrityCheck op RolNaXZichtjaar vangt dat af, want de laatste kolom is de eerste die dan onzin oplevert.";
	}
}