// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de ModelParameters: Parameters die voor elk scenario en elke Variant hetzelfde zijn.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container ModelParameters : using = "Units;Geography;SourceData/RegioIndelingen"
{
	parameter<String>        Productieprofiel             := 'Standaard'           , Descr = "Welke projectlijn deze werkkopie bedient, en daarmee welke kolom van Preflight/Profiel/Regel de verwachte stand van de sleutelparameters geeft (#833, pbl-nl/model-RSopen#53), welke indicatordomeinen ModelParameters/Indicatoren/Domein aanzet en welke invoer de batchscripts eisen. NL2120 levert alle domeinen, Standaard alleen wonen en werken. RuimteVoorWoningbouw hoort bij de gelijknamige tak van pbl-nl/model-RSopen en is hier niet toegestaan, want zijn preflight en claims leunen op parameters die alleen daar bestaan.", IntegrityCheck = "This == 'NL2120' || This == 'Standaard'";
	parameter<String>        StudyArea                    := 'Nederland'           , Descr = "Welk gebied moet het model beslaan. Heel Nederland, of een kleiner studiegebied. Opties: Nederland, of een provincie gespeld zoals in SourceData/RegioIndelingen/Provincie/name, bijvoorbeeld Noord_Holland of Gelderland; zie Geography/StudyAreas. De studiegebied keuze heeft natuurlijk effect op welke cellen er beschouwd worden. Deze waarde wordt ook als suffix in alle ontkoppelde/resultaat bestanden verwerkt.";
	
	// ===== ONTKOPPELINGS­PARAMETERS =====
	// Het model kan in stappen worden uitgevoerd door tussenresultaten weg te schrijven ("ontkoppelen") en bij volgende runs te hergebruiken. Dit bespaart rekentijd tijdens ontwikkeling/debuggen.
	parameter<Bool>          AlwaysRemakeDecoupledFiles   := FALSE                 , Descr = "Op TRUE wordt elk ontkoppeld bestand opnieuw gemaakt, ook als het er staat en de fingerprint klopt; voor het geval een invoer de uitkomst bepaalt maar nog niet in de fingerprint zit. Normaal FALSE: dan beslist Templates/DecoupledFile_T per bestand over hergebruik.";
	parameter<Bool>          BaseDataOntkoppeld           := TRUE                  , Descr = "Gebruik maken van reeds berekende en opgeslagen (ontkoppelde) voorbereidende data (pre-allocatie, generiek). Optie: TRUE, FALSE. Deze data is voor alle varianten gelijk, en duurt relatief lang om te berekenen.";
	parameter<Bool>          VariantDataOntkoppeld        := =replace_value(expand(., '%env:VariantDataOntkoppeld%'), 'env:VariantDataOntkoppeld', 'TRUE'), Descr = "Leest de variantspecifieke voorbereidende data (pre-allocatie) uit de ontkoppelde bestanden (TRUE) of rekent hij ze opnieuw (FALSE)? In batchmodus gestuurd via de omgevingsvariabele VariantDataOntkoppeld; de waarde hier is de default voor de GUI en voor losse aanroepen.";
	parameter<Bool>          StandAllocatieOntkoppeld     := =replace_value(expand(., '%env:StandAllocatieOntkoppeld%'), 'env:StandAllocatieOntkoppeld', 'FALSE'), Descr = "Wil je ontkoppelde model (stand) resultaten gebruiken. Handing wanneer je in de GUI de indicatoren wil exploreren. In batchmodus wordt deze parameter aangestuurd via de omgevingsvariabele StandAllocatieOntkoppeld. De batch bepaalt de waarde; de waarde hier is alleen de default voor de GUI en voor losse aanroepen.";
	parameter<Bool>          TabellenUitExport            := =replace_value(expand(., '%env:TabellenUitExport%'), 'env:TabellenUitExport', 'FALSE'), Descr = "Laat de regionale en landelijke aggregaties van de indicatoren (Per_Regio, Per_NL en de eigen sommen van de indicatorentabel) de per-celkaarten teruglezen die de export van hetzelfde zichtjaar heeft geschreven, in plaats van het levende item te berekenen (#824, vervolg op de ketens van #825). Via de omgevingsvariabele TabellenUitExport, standaard uit. Aan is alleen zinvol nadat Export/generates/Generate_Kaarten voor dat zichtjaar is gedraaid, in een eigen proces en met deze schakelaar uit: de lezers verwachten elke kaart op schijf en een lezer kent zijn schrijver niet, dus in hetzelfde proces zou een tabel een tif kunnen openen voordat hij geschreven is. Een ontbrekende tif geeft een leesfout op het item. RunIndicatoren.ps1 -TabellenUitExport regelt die volgorde: eerst Generate_Kaarten met de schakelaar uit, daarna Themas/Tabellen en de tabel van elke volgende indeling met de schakelaar aan. In elk indicatorsjabloon wijst de container Bron dan naar Lees (StorageReadOnly-lezers op dezelfde bestandsnamen als de schrijvers) in plaats van naar Live. De aggregatieregels zelf veranderen niet, dus de tabel is gelijk aan die van een levende run (#824). Een uitzondering in de manier van rekenen, niet in de uitkomst: de bereikbaarheid van groen leest per regio alleen haar invoer terug en rekent de potentialen opnieuw, omdat een regio woningen en groen afsnijdt op haar eigen grens; alleen de landelijke tabel leest de groenkaarten zelf terug. Winst: een tabel per indeling hoeft de zware ketens van het zichtjaar niet meer te rekenen, en een herstelde kolom kost geen volledige export.";
	parameter<Bool>          IndicatorenOntkoppeld        := =replace_value(expand(., '%env:IndicatorenOntkoppeld%'), 'env:IndicatorenOntkoppeld', 'FALSE'), Descr = "Leest een zichtjaar in de indicatoren wat het van het vorige zichtjaar nodig heeft uit de ketentifs (Templates/Indicatoren/Ketens.dms) in plaats van uit de levende container van dat zichtjaar (#824). Op TRUE rekent een export alleen zijn eigen zichtjaar, en moeten de zichtjaren ervoor eerst hun Ketens hebben geschreven; RunIndicatoren.ps1 regelt die volgorde. Op FALSE, de default, verandert er niets: de cumulatieve indicatoren trekken de hele reeks zichtjaren mee. Geen fingerprint: bestaat de tif, dan wordt hij gelezen. Batchinstelling via de omgevingsvariabele IndicatorenOntkoppeld.";
	parameter<Bool>          OpbrengstdervingOntkoppeld   := TRUE                  , Descr = "Leest de landbouwkant de opbrengstdervingskaarten als tif terug (TRUE) of leidt hij ze bij elke aanroep opnieuw af uit de WWL-relatiedatabase zonder te schrijven (FALSE)? Afleiden is duur (honderden banden uit een netcdf per gewas, maal ankers en leveringen). Op TRUE bewaakt een fingerprint per kaart de invoer (BaseData/Landbouw/Yield_Reduction/OpbrengstenDerving_T, #837): klopt het zijbestand niet meer of ontbreekt het, dan wordt de kaart opnieuw gemaakt.";
	parameter<Bool>          BAG_WP5_rel_Ontkoppeld       := TRUE                  , Descr = "Leest de WP5-pandtypering van de BAG uit het ontkoppelde bestand (TRUE) of rekent hij haar opnieuw (FALSE)? Het bestand is een positionele array over de pandenset van dat jaar; hoort het bij een andere pandenset, dan schuift de typering op, en de IntegrityCheck op pand/WP5_rel in SourceData/Vastgoed/BAG.dms vangt dat af.";
	parameter<bool>          OntkoppelStedelijkeKlasses   := FALSE                 , Descr = "Debug: wanneer je alleen Landbouw wilt debuggen en de stedelijke functies exogeen wilt maken. Dan run je een keer de stedelijke functies, daarna zet je deze op TRUE.";
	
	parameter<YearRange>     Model_StartYear              := 2023[YearRange]       , Descr = "Het basisjaar: uitgangspunt van de allocatie en ijkjaar voor de dichtheden (woningen en banen per hectare). Moet gelijk zijn aan LISA_StartYear zodra werken meedoet: de werkdichtheid deelt LISA-banen door BAG-voetafdrukken van dit jaar, de startstand combineert beide bronnen, de groeiperiode naar het eerste zichtjaar rekent vanaf dit jaar en de CBS-gebiedsindelingen kunnen tussen twee jaren verschillen.", IntegrityCheck = "!SectorAllocRegio/Uq_Sectors/HasWerkenSector || uint32(This) == LISA_StartYear"; //de volgorde-toets tegen het eerste zichtjaar staat op Model_FirstZichtjaar; hier ook toetsen geeft een kring van IntegrityChecks en daarmee Invalid Recursion in UpdateMetaInfo
	parameter<YearRange>     Model_FirstZichtjaar         := 2040[YearRange]       , Descr = "Eerste zichtjaar van de allocatie; vanaf hier loopt de reeks met stappen van Model_ZichtjaarInterval door tot Model_FinalYear. Op 2040 sinds #658: de TIGRIS-claim voor 2030 ligt in veel regio's onder de stand van het basisjaar en het model kan niet slopen om een claim te halen. De eerste stap beslaat dan het hele verschil met Model_StartYear; de groeifactoren rekenen met de werkelijke periodelengte uit Zichtjaar/PrevYearRange_rel.", IntegrityCheck = "This > Model_StartYear"; //de volgorde-toets tegen het eindjaar staat op Model_FinalYear en die tegen het raster op Model_ZichtjaarInterval; elk van de drie toetst een andere kant, zodat er geen kring van IntegrityChecks ontstaat
	parameter<YearRange>     Model_FinalYear              := 2060[YearRange]       , Descr = "Laatste jaar waarvoor standgegevens worden berekend in de allocatieprocedure. Alleen NL2120 rekent door tot 2120; main en de andere projecttakken rekenen tot 2060.", IntegrityCheck = "This >= Model_FirstZichtjaar";
	parameter<YearDiffRange> Model_ZichtjaarInterval      := 10[YearDiffRange]     , Descr = "Afstand in jaren tussen twee opeenvolgende zichtjaren vanaf Model_FirstZichtjaar. Een kleinere stap betekent evenredig meer allocatiestappen, rekentijd en ontkoppelde bestanden. Een zichtjaar tussen twee TIGRIS-jaren krijgt een lineair geinterpoleerde claim (Classifications/Time/ModelJaar).", IntegrityCheck = "This > 0[YearDiffRange] && mod(uint32(Model_FinalYear) - uint32(Model_FirstZichtjaar), max_elem(uint32(This), 1)) == 0"; //Model_FinalYear moet precies op het zichtjaarraster vallen, anders valt het eindjaar weg. De max_elem voorkomt een deling door nul in de mod wanneer de eerste voorwaarde al faalt.
	
	// Jaren/Data waarvoor recente waarnemingen beschikbaar zijn. t.b.v. het inlezen ervan.
	parameter<String>        RegioIndelingen_CBSjaar      := '2024'                , Descr = "Welke jaargang van de CBS-gebiedsindelingen het model gebruikt, voor buurt, wijk, gemeente, COROP, provincie, de daaruit herbouwde NVM-regio en de landsgrens; de bijbehorende container is RegioIndelingen/CBS/Gekozen. Een vaste waarde en geen last() over de beschikbare jaren, want de TIGRIS-claims staan als csv per regio op rijvolgorde op schijf en schuiven stil mee met een andere indeling (#585, #691). Wisselen vraagt dus om nieuwe claim-csv's en om TIGRIS_claims_CBSjaar in dezelfde wijziging; de levering 2026 bevat alleen corop, provincie en gemeente_gegeneraliseerd, en RegioIndelingen/NL bepaalt via het studiegebiedmasker de hele allocatiebasis.";
	parameter<UInt32>        BAG_RecentYear               := 2026                  , Descr = "Wat is het meest recent beschikbare jaar van de BAG";
	parameter<String>        BAG_file_date                := '20261008'            , Descr = "Welke levering van de BAG het model gebruikt: de datum van het extract. De compacte stores (pand, vbo, nummeraanduiding, elk alle voorkomens) komen uit Xml2MMD van BAG-Tools en staan onder %RSo_DataDir%/Vastgoed/BAG_<datum>_History, de naam die BAG-Tools zijn store met alle voorkomens geeft; SourceData/Vastgoed/BAG leest ze. De datum zit in de fingerprints van de basisjaarstand en de BAG-afleidingen, dus een nieuwe levering maakt die opnieuw.";
	parameter<String>        BRK_file_date                := '20261007'            , Descr = "Welke levering van de BRK Kadastrale Kaart het model gebruikt (SourceData/Vastgoed/BRK): de datum van de PDOK-download, die ook in de naam van de mmd-store %RSo_DataDir%/Vastgoed/BRK/BRK_<datum>/perceel_<datum>.mmd staat, de kopie op de RSopen-share van de store uit de plancapaciteitsrepo (#583). De datum zit in de naam en de fingerprint van de tif met het perceel per cel, dus een andere levering maakt die opnieuw.";
	parameter<String>        Hestia_Exportdatum           := '20261006'            , Descr = "De datum in de mapnaam van de levering aan Hestia, <datum>_RO_<casus>; Hestia vindt de levering op die datum (ScenarioDate, pbl-nl/model-hestia-development#180).";
	parameter<UInt32>        LISA_FileYear                := 2023                  , Descr = "Wat is het bestandsjaar van de LISA dataset";
	parameter<UInt32>        LISA_StartYear               := 2023                  , Descr = "Welk jaar van LISA moet worden gebruikt", IntegrityCheck = "LISA_StartYear <= LISA_FileYear"; //evident dat lisa startjaar kleiner over gelijk moet zijn aan het filejaar. Het zijn immers geen prognses.
	parameter<String>        BBG_Year                     := '2022'                , Descr = "Welk jaar van het Bestand Bodemgebruik het model gebruikt. De werken-geschiktheid neemt de actuele landgebruiksaandelen bij coefficienten die op 2012-aandelen zijn geschat, zoals een start-of-period model hoort te doen (#599); NBBG2022 met CBS2020-klassen is wel een methodebreuk ten opzichte van BBG2012, en de klasse zonnepark telt mee als overig bebouwd.";
	parameter<String>        BBG_Verblijfsrecreatie_Year  := '2022'                , Descr = "Om Verblijfsrecreatie trends te bepalen moet een BBG jaar gekozen worden.";
	parameter<String>        BGT_file_date                := '20260819'            , Descr = "Welke bestandsdatum van de Basisregistratie Grootschalige Topografie moet worden gebruikt";
	parameter<String>        BegrenzingBebouwdGebied_jaar := '2022'                , Descr = "Peiljaar van de begrenzing bebouwd gebied die als bestaand bebouwd gebied geldt. Beschikbaar: 2012 en 2022. Deze begrenzing bepaalt niet alleen de inbreidingsindicator en de bereikbaarheid van groen, maar via Grondproductiekosten ook de residuele waarde en daarmee de allocatie zelf. Van peiljaar wisselen vraagt dus een volledige herberekening van alle zichtjaren.";
	parameter<String>        BRT_file_date                := '20260601'            , Descr = "Welke bestandsdatum van de Basisregistratie Topografie moet worden gebruikt";
	parameter<String>        IBIS_Year                    := '2026'                , Descr = "Welk jaar van IBIS moet worden gebruikt. Alleen 2023, 2024 en 2026 werken: de Result-container vereist netto_oppervlakte, een numeriek Uitgegeven-veld, maximale_milieucategorie en het vol-veld, en die ontbreken of verschillen in de oudere vintages. 2026 is IBIS 2024 bijgewerkt met de werklocatielagen van vier provincies (SourceData/Grondgebruik/IBIS/Y2026) en vraagt IBIS_NL_2026_20261012.gpkg in de IBIS-map van de brondata.", IntegrityCheck = "uint32(this) >= 2023";
	parameter<String>        NVM_filedate                 := '20261014'            , Descr = "Welke bestandsdatum van de NVM-coefficienten moet worden gebruikt; bepaalt ook de map van de regionale en nationale karakteristieken. De set 20260711 bevat de rs_groen-termen redev, fr_natuur_tot2500m en fr_water_500m (#566, #481); 20261014 is dezelfde specificatie opnieuw geschat na twee reparaties in PriceIndices, de bouwperiode van de nieuwbouw uit de oude levering (klasse 9 hoort bij vanaf 2002) en BAG-kenmerken alleen bij een adresmatch, plus een dummy voor een onbekend perceel die RS niet leest (#847, #855).";
	parameter<String>        NVM_coeff_Year               := '2023'                , Descr = "Welk jaar moet als prijsniveau worden gehanteerd uit de hedonische prijsanalyse";
	parameter<String>        Verblijfsrec_coeff_date      := '20261117'            , Descr = "Welke bestandsdatum van de coëfficiënten voor verblijfsrecreatie de geschiktheid leest. 20261117 is de schatting op de bouw van verblijfsrecreatie in de BAG van 2017 tot 2022, met de logies in de cel en in het venster van de cel plus de acht buurcellen als termen (#649); de oudere 20261114 en 20211213 hebben andere termen en passen niet op de raw-formule.";
	parameter<String>        Werken_coeff_date            := '20261116'            , Descr = "Welke bestandsdatum van de werken-coëfficiënten de geschiktheid leest. 20261116 is de herschatting op de bouw van 2017 tot 2022 met de termen van Herschatting/Var en het vaste zeehavengebied (#708); de oudere 20220401 heeft andere termen en past niet meer op Calc_raw.";
	parameter<String>        NWB_file_date                := '20251101'            , Descr = "Welke bestandsdatum van het Nationaal Wegenbestand moet worden gebruikt";
	parameter<String>        OSM_file_date                := '20260601'            , Descr = "Welke levering van het OSM-wegennet de afleiding van de winkelcentra gebruikt: de datum in OSM_NL_<datum>.parquet in Infrastructuur/OSM onder %RSo_DataDir%, een export van het netwerkmodel van PBL.";
	parameter<String>        WinkelCentra_file_date       := 'BAG20261008_OSM20260601', Descr = "Welke afleiding van de winkelcentra het model leest: de leveringen van de BAG en het OSM-wegennet waaruit hij is afgeleid, zoals in WinkelCentra_afleiding_<leveringen>.parquet in Vastgoed onder %RSo_DataDir%.";
	parameter<String>        LGN_Year                     := '2025'                , Descr = "Welke bestandsdatum van het Landelijk Grondgebruiksbestand Nederland moet worden gebruikt";
	parameter<String>        BRP_Year                     := '2025'                , Descr = "Welk jaar van de Basisregistratie Gewaspercelen moet worden gebruikt. Dit is de derde grondgebruiksbron naast BBG_Year en LGN_Year, en de enige die per perceel werkt; zie #751 voor wie welke van de drie leest. De naam van het bestand is brpgewaspercelen_definitief_<jaar>.gpkg in de map Grondgebruik/BRP onder %RSo_DataDir%.";
	parameter<String>        TIGRIS_filedate              := '20251216_Run32'      , Descr = "Welke versie van de TIGRIS-claims moet worden gebruikt (relevant voor wonen/werken)";
	parameter<String>        TIGRIS_claims_CBSjaar        := '2024'                , Descr = "Op welke jaargang van de CBS-gebiedsindelingen de claim-csv's onder TIGRIS_filedate zijn geaggregeerd. Geen keuze maar een eigenschap van de bestanden op schijf, die alleen de TIGRIS-vintage in hun naam dragen (#585, #691). Wie de claims opnieuw genereert op een andere jaargang verzet deze parameter in dezelfde wijziging; de IntegrityCheck op ClaimDir in Templates/Claims/ZichtjaarXScenarioxAllocRegios.dms weigert een combinatie die uiteenloopt.";
	parameter<String>        Restricties_filedate         := '2026-10-19_15-17-18' , Descr = "Welke levering van de ruimtelijke restricties het model gebruikt (pbl-nl/model-RS-RuimtelijkeRestricties), een map onder %RSo_DataDir%/Beleid/Restricties/. Deze levering volgt de herziening van pbl-nl/model-RS-RuimtelijkeRestricties#5: de provinciale lagen uit de omgevingsverordeningen in het DSO, de rijkslagen uit bijlage III van de Omgevingsregeling, elke laag met artikel en toelichting, en een vaste grens tussen ZeerHard en Hard: ZeerHard sluit de functie uit op bijzondere gevallen na, Hard is een toestemming onder voorwaarden. Zij heeft ook kaarten voor wind, die alleen gelezen worden als wind wordt gealloceerd.";
	parameter<String>        Stimuli_filedate             := '2026-10-19_15-17-18' , Descr = "Welke levering van de stimuli het model gebruikt, een map onder %RSo_DataDir%/Beleid/Stimuli/, uit dezelfde levering als Restricties_filedate: per sector Hard, Middel en Zacht, met de NOVEX-woningbouwlocaties op Zacht. Daarom staat VariantK/Stimuli_<sector> op HardMiddelZacht, zodat ze meetellen zoals eerst op Middel.";
	parameter<String>        PlanCapaciteit_filedate      := '2026-10-15_16-37-32' , Descr = "De levering van pbl-nl/model-RS-PlanCapaciteit waaruit wonen en werken komen: de harde en zachte woningbouwplannen voor de zeef en de tredes, en de plannen voor kantoor,
																															industrieterrein en algemene bedrijfslocatie. De mapnaam is het tijdstip van de run in die repo, onder %RSo_DataDir%/Beleid/Plancapaciteit/, of bij UsePrivPlanCapaciteit onder
																															%PrivDataDir%/PlanCapaciteit/. Een levering voor beide sectoren sinds 15 oktober 2026; de aparte parameter voor wonen is toen vervallen.";
	parameter<Bool>          UsePrivPlanCapaciteit        := FALSE                 , Descr = "Lees werken uit de vertrouwelijke map %PrivDataDir%/PlanCapaciteit in plaats van de openbare levering op de brondata. De levering van 14 oktober 2026 is openbaar en compleet, dus uit.";
	parameter<String>        Capaciteitskaart_filedate    := '20261110'            , Descr = "Welke download van de capaciteitskaart van Netbeheer Nederland het model gebruikt: de datum van de download, die als map onder %RSo_DataDir%/Energie/ staat (Capaciteitskaart_<datum>). Een download bevat de kleur per PC6 en per voedingsgebied het jaar waarin de congestie naar verwachting is opgelost; die twee sturen het uitstel van de woningclaim (#448).";

	#include<Wonen.dms>
	#include<Werken.dms>
	#include<Verblijfsrecreatie.dms>
	#include<Zon.dms>
	#include<Wind.dms>
	#include<Landbouw.dms>
	#include<Waterberging.dms>
	#include<Piekbuiberging.dms>
	#include<Regenwaterhergebruik.dms>
	#include<Natuur.dms>
	#include<Koolstof.dms>
	#include<Indicatoren.dms>

	#include<ClaimBasisjaar.dms>
	#include<Advanced.dms>
	
	// ===== ALLOCATIEVOLGORDE (SectorAllocRegioTabel/Elements/Text) =====
	// Deze tabel definieert de volgorde waarin sectoren worden gealloceerd en op welk regionaal
	// schaalniveau. Elke rij bevat 5 kolommen (zie nrAttr):
	//
	//   1. name             : Sectornaam (moet overeenkomen met Classifications/Actor/Sector)
	//   2. AllocRegio       : Regionaal schaalniveau waarop claims worden verdeeld
	//                         (NVM, COROP, Provincie, NL).
	//   3. UseInLaterSeq    : TRUE = deze sector kan worden verdrongen door latere sectoren en wordt
	//                         daarom in opvolgende sequenties opnieuw doorlopen om verdrongen eenheden
	//                         te heralloceren. FALSE = eenmalige allocatie, geen herberekening bij verdringing.
	//                         Alleen de kleinste regio per sector krijgt TRUE (verdringing zo lokaal mogelijk).
	//   4. AantalIters      : Aantal iteraties in de eerste sequentie (Advanced/Default_NrOfIters of specifiek).
	//   5. AantalItersInLaterSeq : Aantal iteraties in eventuele vervolgsequenties.
	//   6. RolNaXZichtjaar  : Wat deze regel doet vanaf Advanced/Skeleton/VanafZichtjaar, zodra Advanced/Skeleton/Actief aanstaat.
	//                         Drie rollen. 'Volledig' is onveranderd meedoen, dus op de kolommen 4 en 5 hierboven.
	//                         'Beperkt' is meedoen met Advanced/Skeleton/AantalIters in de eerste sequentie en
	//                         Advanced/Skeleton/AantalItersInLaterSeq in de vervolgsequenties. 'Niet' is overslaan: de regel
	//                         geeft zijn ingangsstand door zonder te alloceren, langs dezelfde tak die
	//                         OntkoppelStedelijkeKlasses gebruikt.
	//                         De kolom noemt de rol en niet het aantal, want de eerste en de vervolgsequentie
	//                         krijgen een verschillend aantal en een tabelcel kan er maar een dragen.
	//                         Staat Advanced/Skeleton/Actief op FALSE, dan doet deze kolom niets.
	//
	// VOLGORDE IS BELANGRIJK: sectoren worden van boven naar beneden gealloceerd.
	// Gelijke sectornamen (bijv. Wonen op NVM, daarna Wonen op Provincie) worden na elkaar doorlopen:
	// eerst de fijnste regio, dan grovere regio's om restclaims op te vangen.
	// Uitgecommentarieerde regels (Verblijfsrecreatie, Zon, Wind, het NL-niveau) zijn beschikbaar maar niet actief.	
	
	unit<UInt8> SectorAllocRegioTabel := range(uint8, 0b, 6b) // e.g. 6 = het huidige aantal SectorAllocRegio-combinaties in Elements/Text hieronder. Pas dit aan als je regels toevoegt/verwijdert.
	, Descr = "De regels van de allocatievolgorde zoals een gebruiker ze invult; ModelParameters/SectorAllocRegio leidt er de sectoren, regio's en sequenties uit af."
	{
		unit<Uint32> Elements := Range(uint32, 0, nrAttr * #.)
		, Descr = "Gelijke sectoren moeten direct na elkaar komen. van klein naar grote alloc regios. Teneinde verdringing zo lokaal mogelijk op te lossen. Anders kan wel, maar geeft wellicht onwenselijke resultaten."
		{
			attribute<String> Text : [
