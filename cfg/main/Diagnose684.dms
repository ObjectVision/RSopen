////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #684, verwijderen zodra de getallen in het issue staan en de keuze is gemaakt.
//
// De vraag uit #684 en uit de comments van Deltares: waar komt de sloop zonder nieuw landgebruik vandaan, welke
// levering en welk landschapstype, en welke NbS-bouwstenen liggen onder die hectares. Dat laatste is nodig om ze
// alsnog exogeen op te kunnen leggen.
//
// Alles telt op het compacted domain en op de woningvoorraad in het basisjaar, dezelfde grondslag als
// VariantData/<variant>/Sloop/Verschil, zodat de getallen naast die uitdraai te leggen zijn. De allocatie hoeft
// niet te draaien: dit hangt alleen aan VariantData.
//
// Vaste variant NbSGenuanceerd, want alleen daar bestaan landschapstypen en dus bouwregime Slopen.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose684
: using = "Units;Geography"
, Descr = "Tijdelijk meetharnas voor #684: de sloop zonder nieuw landgebruik, uitgesplitst naar landschapstype en naar NbS-bouwsteen."
{
	container VD   := /VariantData/NbSGenuanceerd;
	container Veen := /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen;
	container Btk  := /BaseData/Omgeving/Bebouwingstype_Veen_NbSGenuanceerd/bebouwingstype_nbsnuanc;

	unit<uint8> BS := /Classifications/Grondgebruik/NbSVeen/NbSBouwsteen/MetBrondata;

	parameter<float32> Cel := AdminDomain/NrHaPerCell[float32];

	attribute<AdminDomain> AD_rel (CompactedAdminDomain) := CompactedAdminDomain/AdminDomain_rel;

	// ---- de maskers uit Sloop/Verschil, hier alleen opgehaald ----

	attribute<bool>    Gesloopt      (CompactedAdminDomain) := VD/Sloop/Totaal;
	attribute<bool>    OpSlotGeenNatuur (CompactedAdminDomain) := VD/Sloop/Verschil/OpSlotMaarGeenNatuur;
	attribute<float32> Won           (CompactedAdminDomain) := VD/StateBasisjaar/wonen/Totaal[float32];

	attribute<bool> Regime_Veen     (CompactedAdminDomain) := VD/Bouwregime/Bron/Landschap/Veen     == /Classifications/Modellering/BouwregimeK/V/Slopen;
	attribute<bool> Regime_Kust     (CompactedAdminDomain) := VD/Bouwregime/Bron/Landschap/Kust     == /Classifications/Modellering/BouwregimeK/V/Slopen;
	attribute<bool> Regime_Rivieren (CompactedAdminDomain) := VD/Bouwregime/Bron/Landschap/Rivieren == /Classifications/Modellering/BouwregimeK/V/Slopen;

	// ---- hoe groot is de categorie slopen en op slot zelf, los van de oplegging ----

	attribute<bool> IsSlopenEnOpSlot (CompactedAdminDomain) := Btk/SlopenEnOpSlot[AD_rel];
	attribute<bool> MagOpleggen      (CompactedAdminDomain) := VD/Sloop/MagOpleggen;

	parameter<float32> Opp_SlopenEnOpSlot_Ruw      := sum(float32(IsSlopenEnOpSlot))                * Cel, Descr = "Het hele ruimtebeslag van de categorie slopen en op slot uit de bebouwingstypekaart veen, op het compacted domain.";
	parameter<float32> Opp_SlopenEnOpSlot_NaMasker := sum(float32(IsSlopenEnOpSlot && MagOpleggen)) * Cel, Descr = "Wat daarvan overblijft na de toets op bestaand bebouwd gebied en exogeen grondgebruik (#641). Dat is het veendeel van Sloop/DoorBouwregime.";

	// ---- de driedeling naar landschapstype, in hectare naast de woningen ----

	parameter<float32> Opp_Gesloopt      := sum(float32(Gesloopt))      * Cel;
	parameter<float32> Opp_OpSlotGeenNatuur := sum(float32(OpSlotGeenNatuur)) * Cel;

	parameter<float32> Opp_OpSlotGeenNatuur_Veen     := sum(float32(OpSlotGeenNatuur && Regime_Veen))     * Cel;
	parameter<float32> Opp_OpSlotGeenNatuur_Kust     := sum(float32(OpSlotGeenNatuur && Regime_Kust))     * Cel;
	parameter<float32> Opp_OpSlotGeenNatuur_Rivieren := sum(float32(OpSlotGeenNatuur && Regime_Rivieren)) * Cel;

	parameter<float32> Won_Gesloopt      := sum(Won * float32(Gesloopt));
	parameter<float32> Won_OpSlotGeenNatuur := sum(Won * float32(OpSlotGeenNatuur));
	parameter<float32> Won_OpSlotGeenNatuur_Veen      := sum(Won * float32(OpSlotGeenNatuur && Regime_Veen));
	parameter<float32> Won_OpSlotGeenNatuur_Kust      := sum(Won * float32(OpSlotGeenNatuur && Regime_Kust));
	parameter<float32> Won_OpSlotGeenNatuur_Rivieren  := sum(Won * float32(OpSlotGeenNatuur && Regime_Rivieren));

	// ---- de pandentoets uit #661 tegenover de sloop ----

	attribute<bool> HeeftPanden (CompactedAdminDomain) := /BaseData/Omgeving/Opleggingsmasker/HeeftPanden[AD_rel], Descr = "Staat er een BAG-pand in de cel? Dit is de toets waarmee NatuurAlloc_T de cel uit de zeef houdt, dus waar de natuurallocatie per definitie niet landt.";
	attribute<bool> MetNieuwLU  (CompactedAdminDomain) := Gesloopt && !OpSlotGeenNatuur, Descr = "De andere helft van de sloop: hier landt wel een oplegging, dus de cel krijgt een nieuw landgebruik.";

	parameter<float32> Opp_OpSlotGeenNatuurVeen_MetPand    := sum(float32(OpSlotGeenNatuur && Regime_Veen &&  HeeftPanden)) * Cel;
	parameter<float32> Opp_OpSlotGeenNatuurVeen_ZonderPand := sum(float32(OpSlotGeenNatuur && Regime_Veen && !HeeftPanden)) * Cel;
	parameter<float32> Won_OpSlotGeenNatuurVeen_MetPand    := sum(Won * float32(OpSlotGeenNatuur && Regime_Veen &&  HeeftPanden));
	parameter<float32> Won_OpSlotGeenNatuurVeen_ZonderPand := sum(Won * float32(OpSlotGeenNatuur && Regime_Veen && !HeeftPanden));

	parameter<float32> Opp_MetNieuwLU_Veen := sum(float32(MetNieuwLU && Regime_Veen)) * Cel, Descr = "De helft van het veensloopgebied waar de natuurallocatie wel landt, ter vergelijking met Opp_OpSlotGeenNatuur_Veen.";
	parameter<float32> Won_MetNieuwLU_Veen := sum(Won * float32(MetNieuwLU && Regime_Veen));

	// ---- ligt de cel wel in het gebied waar de veenallocatie iets kan neerzetten ----

	attribute<bool> InBouwstenenkaart (CompactedAdminDomain) := MakeDefined(Veen/IsVeengebied[AD_rel], FALSE), Descr = "Valt de cel binnen het ruimtebeslag van de bouwstenenkaart? Daarbuiten kan de veenallocatie per definitie niets neerzetten, hoe hoog de voorrang ook staat, want de cel zit dan in geen enkel peilvak.";

	parameter<float32> Opp_OpSlotGeenNatuurVeen_BuitenBouwstenen := sum(float32(OpSlotGeenNatuur && Regime_Veen && !InBouwstenenkaart)) * Cel;
	parameter<float32> Won_OpSlotGeenNatuurVeen_BuitenBouwstenen := sum(Won * float32(OpSlotGeenNatuur && Regime_Veen && !InBouwstenenkaart));
	parameter<float32> Opp_OpSlotGeenNatuurVeen_BinnenBouwstenen := sum(float32(OpSlotGeenNatuur && Regime_Veen &&  InBouwstenenkaart)) * Cel;
	parameter<float32> Won_OpSlotGeenNatuurVeen_BinnenBouwstenen := sum(Won * float32(OpSlotGeenNatuur && Regime_Veen &&  InBouwstenenkaart));

	// ---- wat zegt de veenlevering zelf over die cellen ----

	attribute<float32> Fr_Natuur (CompactedAdminDomain) := MakeDefined(Veen/Fr_Natuur_Totaal[AD_rel],    0f);
	attribute<float32> Fr_Water  (CompactedAdminDomain) := MakeDefined(Veen/Fr_Water_Totaal[AD_rel],     0f);
	attribute<float32> Fr_Blijft (CompactedAdminDomain) := MakeDefined(Veen/Fr_BlijftZoalsHetIs[AD_rel], 0f);

	parameter<float32> Opp_OpSlotGeenNatuurVeen_Natuur := sum(Fr_Natuur * float32(OpSlotGeenNatuur && Regime_Veen)) * Cel, Descr = "Van het veendeel: hoeveel hectare de bouwstenentabel op deze cellen als natuurbeheertype voorschrijft. Dat is een opgave die ergens binnen hetzelfde peilvak moet landen, niet noodzakelijk hier.";
	parameter<float32> Opp_OpSlotGeenNatuurVeen_Water  := sum(Fr_Water  * float32(OpSlotGeenNatuur && Regime_Veen)) * Cel, Descr = "Idem het open water uit kolom OppervlakteWater, dat sinds #664 niet wordt gealloceerd.";
	parameter<float32> Opp_OpSlotGeenNatuurVeen_Blijft := sum(Fr_Blijft * float32(OpSlotGeenNatuur && Regime_Veen)) * Cel, Descr = "Idem het deel dat volgens de levering zijn huidige grondgebruik houdt: grasland, natte teelt, bebouwing en de niet aangeleverde bouwstenen.";

	// ---- wat de veenallocatie zelf doet, om de prijs van de schakelaar te zien ----

	container Ctl := Veen/Alloc/Controle;

	parameter<float32> Alloc_Claim              := Ctl/Claim_NL[float32];
	parameter<float32> Alloc_Gerealiseerd       := Ctl/Gerealiseerd_NL[float32];
	parameter<float32> Alloc_Tekort             := Ctl/Tekort_NL[float32];
	parameter<float32> Alloc_VerliesPandentoets := Ctl/Verlies_Pandentoets_NL[float32];
	parameter<float32> Alloc_Aaneengeslotenheid := Ctl/Aaneengeslotenheid;
	parameter<float32> Alloc_Aaneen_Aselect     := Ctl/Aaneengeslotenheid_Aselect;

	// ---- wat er werkelijk geleegd wordt, tegenover de afstand tussen de twee leveringen ----
	//
	// OpSlotGeenNatuur hierboven meet de afstand tussen de niet-bouwen-levering en de opleggingslevering, en is
	// nadrukkelijk NIET de sloop. Sinds de koppeling uit #684 lopen die twee ver uiteen. Wie wil weten wat het model
	// leegt leest de twee items hieronder, die rechtstreeks uit Sloop/Verschil komen.

	parameter<float32> Won_GeleegdZonderNieuwLU := VD/Sloop/Verschil/Woningen_GeleegdZonderNieuwLandgebruik[float32];
	parameter<float32> Opp_GeleegdZonderNieuwLU := VD/Sloop/Verschil/Opp_GeleegdZonderNieuwLandgebruik[float32];
	parameter<float32> Won_GespaardDoorKoppeling := VD/Sloop/Verschil/Woningen_GespaardDoorKoppeling[float32];
	parameter<float32> Opp_GespaardDoorKoppeling := VD/Sloop/Verschil/Opp_GespaardDoorKoppeling[float32];

	// ---- toets op de samenvatting van Deltares van 2026-08-31, per landschapstype ----

	attribute<bool> Ruimtebeslag_Kust (CompactedAdminDomain) := MakeDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Kust/NietBouwen[AD_rel], FALSE);
	attribute<bool> Ruimtebeslag_Zand (CompactedAdminDomain) := MakeDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/NietBouwen[AD_rel], FALSE);
	attribute<bool> Ruimtebeslag_Veen (CompactedAdminDomain) := MakeDefined(Veen/IsVeengebied[AD_rel], FALSE);
	attribute<bool> Ruimtebeslag_Riv  (CompactedAdminDomain) := MakeDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/NietBouwen[AD_rel], FALSE);

	parameter<float32> Won_Gesloopt_InKust := sum(Won * float32(Gesloopt && Ruimtebeslag_Kust)), Descr = "Hoort nul te zijn: kust sloopt nergens.";
	parameter<float32> Won_Gesloopt_InZand := sum(Won * float32(Gesloopt && Ruimtebeslag_Zand)), Descr = "Hoort nul te zijn: zand sloopt nergens. Een cel binnen het beekdal die ook in het veen- of rivierensloopgebied ligt telt hier wel mee.";
	parameter<float32> Won_Gesloopt_InVeen := sum(Won * float32(Gesloopt && Ruimtebeslag_Veen));
	parameter<float32> Won_Gesloopt_InRiv  := sum(Won * float32(Gesloopt && Ruimtebeslag_Riv));

	parameter<float32> Won_NatuurOpBebouwing_Kust := sum(Won * float32(Ruimtebeslag_Kust && MetNieuwLU == FALSE && Gesloopt == FALSE && HeeftPanden)), Descr = "Ruwe indicatie dat de bebouwing in het kustgebied blijft staan.";

	// ---- wat de sloopbouwstenen 5 tot en met 8 aan opgave meebrengen ----

	attribute<float32> Fr_SloopBouwstenen (CompactedAdminDomain) :=
		  MakeDefined(Veen/Fr_perBouwsteen/BS5[AD_rel], 0f)
		+ MakeDefined(Veen/Fr_perBouwsteen/BS6[AD_rel], 0f)
		+ MakeDefined(Veen/Fr_perBouwsteen/BS7[AD_rel], 0f)
		+ MakeDefined(Veen/Fr_perBouwsteen/BS8[AD_rel], 0f)
	, Descr = "Het aandeel van de cel dat volgens de bouwstenenkaart naar bouwsteen 5, 6, 7 of 8 gaat. Dat zijn precies de vier bouwstenen waarvan kolom J van de brontabel slopen en op slot zegt.";

	parameter<float32> Opp_SloopBouwstenen := sum(Fr_SloopBouwstenen) * Cel, Descr = "De opgave van die vier bouwstenen in hectare. Dit is het areaal dat onder de regel van Deltares gesloopt zou worden, tegenover de 283.426 ha van de bebouwingstypekaart.";
	parameter<float32> Won_SloopBouwstenen := sum(Won * Fr_SloopBouwstenen), Descr = "De woningvoorraad gewogen met datzelfde aandeel. Een indicatie en geen uitkomst: waar die hectares binnen het peilvak landen bepaalt de allocatie, en die is hier niet gedraaid.";

	// ---- welke bouwstenen liggen onder de sloop zonder nieuw landgebruik ----

	container Ha_perBouwsteen :=
		for_each_nedv(
			BS/name
			, 'sum(MakeDefined(Veen/Fr_perBouwsteen/' + BS/name + '[AD_rel], 0f) * float32(OpSlotGeenNatuur)) * Cel'
			, void
			, float32
		), Descr = "Per NbS-bouwsteen het aantal hectare onder de sloop zonder nieuw landgebruik, gewogen met de bouwsteenfractie van de cel. De som blijft onder Opp_OpSlotGeenNatuur: de niet aangeleverde bouwstenen 0a, 0b, 1 en 10b zitten er niet in en het rivierendeel ligt buiten het veengebied.";

	container Won_perBouwsteen :=
		for_each_nedv(
			BS/name
			, 'sum(MakeDefined(Veen/Fr_perBouwsteen/' + BS/name + '[AD_rel], 0f) * Won * float32(OpSlotGeenNatuur))'
			, void
			, float32
		), Descr = "Dezelfde weging op de woningvoorraad in het basisjaar.";

	attribute<float32> Ha_BS  (BS) := ='union_data(BS, ' + AsItemList('Ha_perBouwsteen/'  + BS/name) + ')';
	attribute<float32> Won_BS (BS) := ='union_data(BS, ' + AsItemList('Won_perBouwsteen/' + BS/name) + ')';

	parameter<String> Uitdraai_Bouwsteen := AsList(BS/code + ';' + string(Ha_BS) + ';' + string(Won_BS), '|')
	, StorageName = "%LocalDataProjDir%/Diagnose/684_bouwstenen.txt"
	, StorageType = "str"
	, Descr = "Een regel per bouwsteen: code, hectare, woningen.";

	parameter<String> Uitdraai :=
		  'opp_slopen_en_op_slot_ruw;'       + string(Opp_SlopenEnOpSlot_Ruw)
		+ '|opp_slopen_en_op_slot_namasker;' + string(Opp_SlopenEnOpSlot_NaMasker)
		+ '|opp_gesloopt;'                   + string(Opp_Gesloopt)
		+ '|opp_opslot_maar_geen_natuur;'            + string(Opp_OpSlotGeenNatuur)
		+ '|opp_opslot_geen_natuur_veen;'                   + string(Opp_OpSlotGeenNatuur_Veen)
		+ '|opp_opslot_geen_natuur_kust;'                   + string(Opp_OpSlotGeenNatuur_Kust)
		+ '|opp_opslot_geen_natuur_rivieren;'               + string(Opp_OpSlotGeenNatuur_Rivieren)
		+ '|won_gesloopt;'                   + string(Won_Gesloopt)
		+ '|won_opslot_maar_geen_natuur;'            + string(Won_OpSlotGeenNatuur)
		+ '|won_opslot_geen_natuur_veen;'                   + string(Won_OpSlotGeenNatuur_Veen)
		+ '|won_opslot_geen_natuur_kust;'                   + string(Won_OpSlotGeenNatuur_Kust)
		+ '|won_opslot_geen_natuur_rivieren;'               + string(Won_OpSlotGeenNatuur_Rivieren)
		+ '|opp_znlveen_metpand;'            + string(Opp_OpSlotGeenNatuurVeen_MetPand)
		+ '|opp_znlveen_zonderpand;'         + string(Opp_OpSlotGeenNatuurVeen_ZonderPand)
		+ '|won_znlveen_metpand;'            + string(Won_OpSlotGeenNatuurVeen_MetPand)
		+ '|won_znlveen_zonderpand;'         + string(Won_OpSlotGeenNatuurVeen_ZonderPand)
		+ '|opp_metnieuwlu_veen;'            + string(Opp_MetNieuwLU_Veen)
		+ '|won_metnieuwlu_veen;'            + string(Won_MetNieuwLU_Veen)
		+ '|opp_znlveen_buiten_bouwstenen;'  + string(Opp_OpSlotGeenNatuurVeen_BuitenBouwstenen)
		+ '|won_znlveen_buiten_bouwstenen;'  + string(Won_OpSlotGeenNatuurVeen_BuitenBouwstenen)
		+ '|opp_znlveen_binnen_bouwstenen;'  + string(Opp_OpSlotGeenNatuurVeen_BinnenBouwstenen)
		+ '|won_znlveen_binnen_bouwstenen;'  + string(Won_OpSlotGeenNatuurVeen_BinnenBouwstenen)
		+ '|opp_znlveen_natuur_volgens_levering;' + string(Opp_OpSlotGeenNatuurVeen_Natuur)
		+ '|opp_znlveen_water_volgens_levering;'  + string(Opp_OpSlotGeenNatuurVeen_Water)
		+ '|opp_znlveen_blijft_volgens_levering;' + string(Opp_OpSlotGeenNatuurVeen_Blijft)
		+ '|won_geleegd_zonder_nieuw_lu;'    + string(Won_GeleegdZonderNieuwLU)
		+ '|opp_geleegd_zonder_nieuw_lu;'    + string(Opp_GeleegdZonderNieuwLU)
		+ '|won_gespaard_door_koppeling;'    + string(Won_GespaardDoorKoppeling)
		+ '|opp_gespaard_door_koppeling;'    + string(Opp_GespaardDoorKoppeling)
		+ '|won_gesloopt_in_kust;'           + string(Won_Gesloopt_InKust)
		+ '|won_gesloopt_in_zand;'           + string(Won_Gesloopt_InZand)
		+ '|won_gesloopt_in_veen;'           + string(Won_Gesloopt_InVeen)
		+ '|won_gesloopt_in_rivieren;'       + string(Won_Gesloopt_InRiv)
		+ '|opp_sloopbouwstenen_5tm8;'       + string(Opp_SloopBouwstenen)
		+ '|won_sloopbouwstenen_5tm8;'       + string(Won_SloopBouwstenen)
		+ '|alloc_claim;'                    + string(Alloc_Claim)
		+ '|alloc_gerealiseerd;'             + string(Alloc_Gerealiseerd)
		+ '|alloc_tekort;'                   + string(Alloc_Tekort)
		+ '|alloc_verlies_pandentoets;'      + string(Alloc_VerliesPandentoets)
		+ '|alloc_aaneengeslotenheid;'       + string(Alloc_Aaneengeslotenheid)
		+ '|alloc_aaneen_aselect;'           + string(Alloc_Aaneen_Aselect)
	, StorageName = "%LocalDataProjDir%/Diagnose/684_sloop.txt"
	, StorageType = "str"
	, Descr = "De getallen in een keer, zodat ze zonder allocatierun na te rekenen zijn.";
}
