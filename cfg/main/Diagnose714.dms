////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #714, verwijderen zodra de getallen in het issue staan.
//
// Meet waar de nieuw toegewezen banen van een zichtjaar landen, en hoeveel er verloren gaan. Bedoeld om de vier vragen
// uit #714 te beantwoorden over het ontwikkelwerk van #709, #710 en #713, dat alle drie raakt waar werken terechtkomt
// terwijl de metingen tot nu toe voor de allocatie van werken stoppen.
//
// De kern is nieuw_op_leeg: het deel van de nieuwe banen dat landt op cellen die aan het begin van het zichtjaar geen
// enkele werkgelegenheid hadden. Dat is het getal waar #710 mee opende, toen 87 tot 95 procent voor de drie verzorgende
// subsectoren. Daarnaast nieuw_in_bbg, dat toen 14 tot 32 procent was.
//
// Draai het item Tabel na een allocatierun van hetzelfde zichtjaar. Casus en zichtjaar komen uit dezelfde
// omgevingsvariabelen als de rest van het diagnoseharnas, DiagCasus en DiagJaar.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose714
: using = "Units;Geography;Classifications/Actor"
, Descr = "Tijdelijk meetharnas voor #714: waar landen de nieuwe banen, en hoeveel gaan er verloren."
{
	parameter<String> Pad_A := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/', Descr = "Wortel van de allocatie van het te meten zichtjaar.";

	attribute<Bool> InUrbanContour (CompactedAdminDomain) := collect_by_cond(CompactedAdminDomain, AdminDomain/IsCompactedDomain, /BaseData/Omgeving/UrbanContour), Descr = "Bestaand bebouwd gebied, dezelfde laag die de trede van #710 als hoogste as gebruikt.";

	container Begin := for_each_nedv(Jobs6/name, Pad_A+'StateVoorAllocatie/Werken/'+Jobs6/name, CompactedAdminDomain, Float32), Descr = "Stand per subsector aan het begin van het zichtjaar, dus voor de eerste sequentie.";
	container Eind  := for_each_nedv(Jobs6/name, Pad_A+'Sequences/LastSequence/StateNaAllocatie/Werken/'+Jobs6/name, CompactedAdminDomain, Float32), Descr = "Stand per subsector na de laatste sequentie van het zichtjaar.";

	attribute<Float32> WerkstandBegin (CompactedAdminDomain) := = 'add('+asItemList('Begin/'+Jobs6/name)+')', Descr = "Alle werkgelegenheid in de cel aan het begin van het zichtjaar, over de zes subsectoren.";
	attribute<Bool>    HadGeenWerk    (CompactedAdminDomain) := WerkstandBegin <= 0f, Descr = "Cel zonder enige werkgelegenheid aan het begin van het zichtjaar. Dit is de noemer-vraag van #710: landt een verzorgende functie op kaal terrein of bij bestaande bedrijvigheid.";

	container Nieuw    := for_each_nedv(Jobs6/name, 'max_elem(Eind/'+Jobs6/name+' - Begin/'+Jobs6/name+', 0f)', CompactedAdminDomain, Float32), Descr = "Toename per cel, dus de banen die deze subsector er in dit zichtjaar bij kreeg.";
	container Verloren := for_each_nedv(Jobs6/name, 'max_elem(Begin/'+Jobs6/name+' - Eind/'+Jobs6/name+', 0f)', CompactedAdminDomain, Float32), Descr = "Afname per cel, dus de banen die deze subsector in dit zichtjaar verloor door verdringing of sloop.";

	container ClaimTotaal       := for_each_nedv(Jobs6/name, 'sum('+Pad_A+'StateVoorAllocatie/RestClaims/Werken/Claim/'+Jobs6/name+')', void, Float32);
	container StandBegin        := for_each_nedv(Jobs6/name, 'sum(Begin/'+Jobs6/name+')', void, Float32);
	container StandEind         := for_each_nedv(Jobs6/name, 'sum(Eind/'+Jobs6/name+')', void, Float32);
	container NieuwTotaal       := for_each_nedv(Jobs6/name, 'sum(Nieuw/'+Jobs6/name+')', void, Float32);
	container VerlorenTotaal    := for_each_nedv(Jobs6/name, 'sum(Verloren/'+Jobs6/name+')', void, Float32);
	container NieuwOpLeeg       := for_each_nedv(Jobs6/name, 'sum(Nieuw/'+Jobs6/name+' * float32(HadGeenWerk))', void, Float32);
	container NieuwInUrbanContour        := for_each_nedv(Jobs6/name, 'sum(Nieuw/'+Jobs6/name+' * float32(InUrbanContour))', void, Float32);
	container CellenNieuw       := for_each_nedv(Jobs6/name, 'sum(float32(Nieuw/'+Jobs6/name+' > 0f))', void, Float32);
	container CellenNieuwOpLeeg := for_each_nedv(Jobs6/name, 'sum(float32(Nieuw/'+Jobs6/name+' > 0f && HadGeenWerk))', void, Float32);

	parameter<String> Tabel :=
		  'subsector;claim;stand_begin;stand_eind;nieuw;verloren;nieuw_op_leeg;nieuw_in_bbg;cellen_nieuw;cellen_nieuw_op_leeg'
		+ '|Nijverheid;'+string(ClaimTotaal/Nijverheid)+';'+string(StandBegin/Nijverheid)+';'+string(StandEind/Nijverheid)+';'+string(NieuwTotaal/Nijverheid)+';'+string(VerlorenTotaal/Nijverheid)+';'+string(NieuwOpLeeg/Nijverheid)+';'+string(NieuwInUrbanContour/Nijverheid)+';'+string(CellenNieuw/Nijverheid)+';'+string(CellenNieuwOpLeeg/Nijverheid)
		+ '|Logistiek;'+string(ClaimTotaal/Logistiek)+';'+string(StandBegin/Logistiek)+';'+string(StandEind/Logistiek)+';'+string(NieuwTotaal/Logistiek)+';'+string(VerlorenTotaal/Logistiek)+';'+string(NieuwOpLeeg/Logistiek)+';'+string(NieuwInUrbanContour/Logistiek)+';'+string(CellenNieuw/Logistiek)+';'+string(CellenNieuwOpLeeg/Logistiek)
		+ '|Detailhandel;'+string(ClaimTotaal/Detailhandel)+';'+string(StandBegin/Detailhandel)+';'+string(StandEind/Detailhandel)+';'+string(NieuwTotaal/Detailhandel)+';'+string(VerlorenTotaal/Detailhandel)+';'+string(NieuwOpLeeg/Detailhandel)+';'+string(NieuwInUrbanContour/Detailhandel)+';'+string(CellenNieuw/Detailhandel)+';'+string(CellenNieuwOpLeeg/Detailhandel)
		+ '|Ov_consumentendiensten;'+string(ClaimTotaal/Ov_consumentendiensten)+';'+string(StandBegin/Ov_consumentendiensten)+';'+string(StandEind/Ov_consumentendiensten)+';'+string(NieuwTotaal/Ov_consumentendiensten)+';'+string(VerlorenTotaal/Ov_consumentendiensten)+';'+string(NieuwOpLeeg/Ov_consumentendiensten)+';'+string(NieuwInUrbanContour/Ov_consumentendiensten)+';'+string(CellenNieuw/Ov_consumentendiensten)+';'+string(CellenNieuwOpLeeg/Ov_consumentendiensten)
		+ '|Zak_dienstverlening;'+string(ClaimTotaal/Zak_dienstverlening)+';'+string(StandBegin/Zak_dienstverlening)+';'+string(StandEind/Zak_dienstverlening)+';'+string(NieuwTotaal/Zak_dienstverlening)+';'+string(VerlorenTotaal/Zak_dienstverlening)+';'+string(NieuwOpLeeg/Zak_dienstverlening)+';'+string(NieuwInUrbanContour/Zak_dienstverlening)+';'+string(CellenNieuw/Zak_dienstverlening)+';'+string(CellenNieuwOpLeeg/Zak_dienstverlening)
		+ '|Overheid_kw_diensten;'+string(ClaimTotaal/Overheid_kw_diensten)+';'+string(StandBegin/Overheid_kw_diensten)+';'+string(StandEind/Overheid_kw_diensten)+';'+string(NieuwTotaal/Overheid_kw_diensten)+';'+string(VerlorenTotaal/Overheid_kw_diensten)+';'+string(NieuwOpLeeg/Overheid_kw_diensten)+';'+string(NieuwInUrbanContour/Overheid_kw_diensten)+';'+string(CellenNieuw/Overheid_kw_diensten)+';'+string(CellenNieuwOpLeeg/Overheid_kw_diensten)
	, StorageName = "='%LocalDataProjDir%/Diagnose/714_banenlanding_'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'.txt'", StorageType = "str"
	, Descr = "Een regel per subsector, puntkomma-gescheiden, regels gescheiden door een liggend streepje. Deel nieuw_op_leeg door nieuw voor het greenfieldaandeel, en nieuw_in_bbg door nieuw voor het aandeel binnen bebouwd gebied.";
}
