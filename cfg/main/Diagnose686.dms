////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// TIJDELIJK meetharnas voor #686, verwijderen zodra de getallen in het issue staan en de keuze over de schakelaar is gemaakt.
//
// Meet wat de vrijstelling binnen harde plancapaciteit met de restricties doet, uitgesplitst naar hardheid. Twee kanten.
// Hoeveel harde plancapaciteit ligt in de zeerharde laag en wordt daarmee vrijgesteld van een categorie die als wettelijk
// verbod is bedoeld, en hoeveel van de bestaande woningvoorraad ligt in diezelfde categorie, wat laat zien dat de laag
// breder is dan haar naam suggereert. Gerekend op de stand in het basisjaar, dus zonder allocatie.
//
// zeef_verlies_ha is de kern: het areaal dat nu beschikbaar is omdat een hard plan de zeerharde restrictie opzij zet en
// dat afvalt zodra VariantK/ZeerHardOokGeldigBinnenHardePlancapaciteit aangaat.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose686
: using = "Units;Geography"
, Descr = "Tijdelijk meetharnas voor #686."
{
	parameter<String> Variant := /Diagnose/Variant, Descr = "Dezelfde variant als de rest van het diagnoseharnas, aangestuurd via de omgevingsvariabele DiagCasus.";
	parameter<ha>     Cel     := AdminDomain/NrHaPerCell;

	attribute<bool>   ZeerHard    (AdminDomain) := /SourceData/Restricties/Wonen/ZeerHard;
	attribute<bool>   Hard        (AdminDomain) := /SourceData/Restricties/Wonen/Hard;
	attribute<bool>   Middel      (AdminDomain) := /SourceData/Restricties/Wonen/Middel;
	attribute<bool>   Zacht       (AdminDomain) := /SourceData/Restricties/Wonen/Zacht;
	attribute<bool>   Actief      (AdminDomain) := ='/VariantData/'+Variant+'/Restricties/Wonen/Result';
	attribute<bool>   HardPlan    (AdminDomain) := /SourceData/Plancapaciteit/Read/Wonen/Hard/Per_AdminDomain;
	attribute<bool>   ZachtPlan   (AdminDomain) := /SourceData/Plancapaciteit/Read/Wonen/Zacht/Per_AdminDomain;
	attribute<Woning> Woningen    (AdminDomain) := /BaseData/StartState/StateBasisjaar/Read/Wonen/Aantal_Woningen_Totaal;
	attribute<bool>   Beschikbaar (AdminDomain) := ='/VariantData/'+Variant+'/Zeef/Basisjaar/Wonen/eengezins_VrijeSector/IsBeschikbaar_AdminDomain'
	, Descr = "De zeef van een van de vier woonsubsectoren. De vier verschillen alleen in de sloopbescherming via het energielabel, niet in de restricties, dus voor deze telling maakt de keuze niet uit.";

	attribute<bool>   ZeerHard_W    (AdminDomain) := /SourceData/Restricties/Werken/ZeerHard;
	attribute<bool>   Actief_W      (AdminDomain) := ='/VariantData/'+Variant+'/Restricties/Werken/Result';
	attribute<bool>   HardPlan_W    (AdminDomain) := /SourceData/Plancapaciteit/Read/Werken/Hard/Per_AdminDomain;
	attribute<bool>   Beschikbaar_W (AdminDomain) := ='/VariantData/'+Variant+'/Zeef/Basisjaar/Werken/Nijverheid/IsBeschikbaar_AdminDomain';

	container BeschikbaarPerSubsector :=
		for_each_nedv(
			/Classifications/Actor/Jobs6/name
			, '/VariantData/'+Variant+'/Zeef/Basisjaar/Werken/'+/Classifications/Actor/Jobs6/name+'/IsBeschikbaar_AdminDomain'
			, AdminDomain
			, bool
		), Descr = "De basisjaarzeef per werksubsector. Nodig om #669, #670 en #713 te kunnen meten: die drie veranderen alle drie hoeveel ruimte een subsector overhoudt, en tot nu toe keek daar niets naar.";

	parameter<String> werken_persubsector :=
		  'subsector;beschikbaar_ha'
		+ '|nijverheid;' + string(sum(float32(BeschikbaarPerSubsector/Nijverheid) * Cel))
		+ '|logistiek;' + string(sum(float32(BeschikbaarPerSubsector/Logistiek) * Cel))
		+ '|detailhandel;' + string(sum(float32(BeschikbaarPerSubsector/Detailhandel) * Cel))
		+ '|ov_consumentendiensten;' + string(sum(float32(BeschikbaarPerSubsector/Ov_consumentendiensten) * Cel))
		+ '|zak_dienstverlening;' + string(sum(float32(BeschikbaarPerSubsector/Zak_dienstverlening) * Cel))
		+ '|overheid_kw_diensten;' + string(sum(float32(BeschikbaarPerSubsector/Overheid_kw_diensten) * Cel))
	, StorageName = "='%LocalDataProjDir%/Diagnose/zeef_werken_persubsector_'+/Diagnose/Casus+'.txt'", StorageType = "str"
	, Descr = "Beschikbare hectares in de basisjaarzeef per werksubsector. Verschillen tussen de zes zeggen wat de milieuzonering en de dichtheidsdrempel per subsector wegnemen.";

	parameter<String> wonen :=
		  'maat;waarde'
		+ '|zeerhard_ha;'                   + string(sum(float32(ZeerHard) * Cel))
		+ '|hard_ha;'                       + string(sum(float32(Hard)     * Cel))
		+ '|middel_ha;'                     + string(sum(float32(Middel)   * Cel))
		+ '|zacht_ha;'                      + string(sum(float32(Zacht)    * Cel))
		+ '|actief_ha;'                     + string(sum(float32(Actief)   * Cel))
		+ '|hardplan_ha;'                   + string(sum(float32(HardPlan) * Cel))
		+ '|hardplan_zeerhard_ha;'          + string(sum(float32(HardPlan && ZeerHard) * Cel))
		+ '|hardplan_actief_ha;'            + string(sum(float32(HardPlan && Actief)   * Cel))
		+ '|zachtplan_zeerhard_ha;'         + string(sum(float32(ZachtPlan && !HardPlan && ZeerHard) * Cel))
		+ '|cellen_met_woningen;'           + string(sum(float32(Woningen > 0f)))
		+ '|cellen_met_woningen_zeerhard;'  + string(sum(float32(Woningen > 0f && ZeerHard)))
		+ '|cellen_met_woningen_actief;'    + string(sum(float32(Woningen > 0f && Actief)))
		+ '|woningen_totaal;'               + string(sum(Woningen))
		+ '|woningen_in_zeerhard;'          + string(sum(Woningen * float32(ZeerHard)))
		+ '|zeef_beschikbaar_ha;'           + string(sum(float32(Beschikbaar) * Cel))
		+ '|zeef_verlies_ha;'               + string(sum(float32(Beschikbaar && ZeerHard && HardPlan) * Cel))
		+ '|zeef_verlies_woningen;'         + string(sum(Woningen * float32(Beschikbaar && ZeerHard && HardPlan)))
	, StorageName = "='%LocalDataProjDir%/Diagnose/restricties_686_wonen_'+/Diagnose/Casus+'.txt'", StorageType = "str";

	parameter<String> werken :=
		  'maat;waarde'
		+ '|zeerhard_ha;'          + string(sum(float32(ZeerHard_W) * Cel))
		+ '|actief_ha;'            + string(sum(float32(Actief_W)   * Cel))
		+ '|hardplan_ha;'          + string(sum(float32(HardPlan_W) * Cel))
		+ '|hardplan_zeerhard_ha;' + string(sum(float32(HardPlan_W && ZeerHard_W) * Cel))
		+ '|hardplan_actief_ha;'   + string(sum(float32(HardPlan_W && Actief_W)   * Cel))
		+ '|zeef_beschikbaar_ha;'  + string(sum(float32(Beschikbaar_W) * Cel))
		+ '|zeef_verlies_ha;'      + string(sum(float32(Beschikbaar_W && ZeerHard_W && HardPlan_W) * Cel))
	, StorageName = "='%LocalDataProjDir%/Diagnose/restricties_686_werken_'+/Diagnose/Casus+'.txt'", StorageType = "str"
	, Descr = "Dezelfde telling voor werken, met de subsector Nijverheid als zeef en de drie plansoorten samen als harde plancapaciteit.";

	container D723
	: Descr = "Meetpunt voor #723: kloppen de maskers in de OP-tabel en doet de bouwwijzekeuze wat de regel zegt. Verwachting vooraf: elk pakket heeft vandaag precies een toegestane bouwwijze (de omzetting was een op een), het drijvende Nuanceerd-pakket kiest overal waar iets voldoet Drijvend, en het gewone stedelijke pakket valt op veel meer cellen uit dan het drijvende, want GeenMaatregelen haalt 0,2 meter en Drijvend 5,5."
	{
		unit<UInt8> OPd := /VariantParameters/Ontwikkelpakketten/NettoBuurt/Default;
		container Pad := /VariantData/NbSGenuanceerd/Zeef/Y2040/Wonen/eengezins_VrijeSector/Zeef_perOP;

		parameter<String> maskers := AsList(OPd/name + ';' + string(OPd/Bouwwijze/Aantal) + ';' + OPd/BouwwijzeToegestaan, '|')
		, StorageName = "%LocalDataProjDir%/Diagnose/723_maskers.txt", StorageType = "str"
		, Descr = "Alle default-pakketten met hun aantal toegestane bouwwijzen en het masker zelf. Forceert ook de IntegrityCheck op Aantal.";

		parameter<String> sets :=
			  'variant;aantal_pakketten'
			+ '|BAU;'            + string(uint32(#/VariantParameters/Ontwikkelpakketten/NettoBuurt/PerVariant/BAU/OP))
			+ '|BAU2;'           + string(uint32(#/VariantParameters/Ontwikkelpakketten/NettoBuurt/PerVariant/BAU2/OP))
			+ '|NbSMax;'         + string(uint32(#/VariantParameters/Ontwikkelpakketten/NettoBuurt/PerVariant/NbSMax/OP))
			+ '|NbSGenuanceerd;' + string(uint32(#/VariantParameters/Ontwikkelpakketten/NettoBuurt/PerVariant/NbSGenuanceerd/OP))
			+ '|Default;'        + string(uint32(#/VariantParameters/Ontwikkelpakketten/NettoBuurt/Default))
		, StorageName = "%LocalDataProjDir%/Diagnose/721_sets.txt", StorageType = "str"
		, Descr = "De setgrootte per variant na #721. Verwachting: BAU en BAU2 exact de default (27), NbSMax 27 plus 14 is 41, NbSGenuanceerd 27 plus 12 is 39.";

		parameter<String> legenda := /Indicatoren/WLO_hoog_NbSGenuanceerd/Zichtjaren/Y2040/impl/Stand_with_path/LegendaVerwacht
		, StorageName = "%LocalDataProjDir%/Diagnose/723_legenda.txt", StorageType = "str"
		, Descr = "De verwachte standlegenda van NbSGenuanceerd, om de leestoets van #721 mee te beproeven.";

		parameter<String> keuze :=
			  'maat;waarde'
			+ '|drijvend_geenvoldoet_cellen;'  + string(sum(uint32(Pad/NuanceerdLNLLaagEGVS/Impl/GeenToegestaneBouwwijzeVoldoet)))
			+ '|drijvend_voldoet;'             + string(sum(uint32(Pad/NuanceerdLNLLaagEGVS/Bouwwijzekeuze/Voldoet/Drijvend)))
			+ '|drijvend_keuze_is_drijvend;'   + string(sum(uint32(MakeDefined(Pad/NuanceerdLNLLaagEGVS/Bouwwijzekeuze/Keuze == /Classifications/Modellering/BouwwijzeK/V/Drijvend, FALSE))))
			+ '|stedelijk_geenvoldoet_cellen;' + string(sum(uint32(Pad/StedelijkEGVS/Impl/GeenToegestaneBouwwijzeVoldoet)))
			+ '|stedelijk_keuze_is_geen;'      + string(sum(uint32(MakeDefined(Pad/StedelijkEGVS/Bouwwijzekeuze/Keuze == /Classifications/Modellering/BouwwijzeK/V/GeenMaatregelen, FALSE))))
			+ '|cellen_totaal;'                + string(uint32(#/Geography/CompactedAdminDomain))
		, StorageName = "%LocalDataProjDir%/Diagnose/723_keuze.txt", StorageType = "str"
		, Descr = "Voor een drijvend pakket en een gewoon pakket in NbSGenuanceerd Y2040: hoe vaak voldoet er niets, en is de keuze overal het ene toegestane element. drijvend_voldoet plus drijvend_geenvoldoet hoort op cellen_totaal uit te komen, en hetzelfde geldt aan de stedelijke kant.";
	}
}
