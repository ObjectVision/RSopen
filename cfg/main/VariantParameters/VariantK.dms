////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de Varianten en hun attributen, ofwel de VariantParameters. De Parameters verschillen per Variant.
// Tenzij anders gespecificeerd zijn de waarden gebaseerd op expert judgement van het PBL
//
// STRUCTUUR:
//   - Elke KOLOM vertegenwoordigt een variant. Een nieuwe variant toevoegen = een nieuwe kolom toevoegen
//     en NrOfRows met 1 verhogen. (tip: gebruik je notepad++, met shift+alt kun je een kolom selecteren en bewerken)
//   - Elke RIJ definieert een parameter; de celwaarde per kolom bepaalt de instelling voor die variant.
//
//     LET OP:
//   - Het attribuut 'name' (eerste attribute) is de technische sleutel waarmee de variant wordt aangeroepen
//   - De volgorde van waarden in elke array moet overeenkomen met de volgorde in 'name'.
//
// TRACEERBAARHEID:
//   Om te vinden waar een parameter in het model wordt gebruikt, zoek op de attribuutnaam
//   (bijv. 'RestrictiesVariant_Wind') in de overige .dms-bestanden. De parameter wordt doorgaans
//   als volgt benaderd: VariantK/<attribuutnaam>[Variant_rel]
//   Voorbeeld: VariantK/RestrictiesVariant_Wind[Variant_rel] → levert de stringwaarde voor de actieve variant
//   Echter, soms worden attributen als indirectie aangeroepen en daarom lastiger te vinden. Zoek dan op het deel van de 
//   naam van het attribuut dat geen variant/sector/etc bevat.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
unit<UInt8> VariantK: NrOfRows = 4
{                                                                         // BusinessAsUsual                  , BusinessAsUsual2                  , NbSMax                            , NbSGenuanceerd                    
	attribute<string_t> name:                                              ['BAU'                             ,'BAU2'                             ,'NbSMax'                           ,'NbSGenuanceerd'                   ];
	attribute<string_t> Label := union_data                                (.,'BusinessAsUsual'               ,'BusinessAsUsual2'                 ,'NbSMax'                           ,'NbSGenuanceerd'                   ), DialogType = "LabelText";
                                                                                                                                                                                                                          
///////////////////////////////////////////////////////////////////////////////////// Wonen /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
                                                                                                                                                                                                                          
	attribute<String>    OntwikkelPakketVariant:                           ['Default'                         ,'Default'                          ,'Default'                          ,'Default'                          ], Descr = "Ontwikkelpakket-variant die wordt gebruikt voor deze variant, zie VariantParameters/Ontwikkelpakketten";
	attribute<bool>      IsNbSVariant:                                     [FALSE                             ,FALSE                              , TRUE                              , TRUE                              ], Descr = "Beaalt welke OP  togestaan zijn";
	attribute<string_t>  RestrictiesVariant_Wonen:                         ['ZeerHardHardMiddel'              ,'ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'               ], Descr = "Geldende restricties: alleen (zeer) hard, of ook middel, zacht?";
	attribute<string_t>  StimuliVariant_Wonen:                             ['HardMiddel'                      ,'HardMiddel'                       ,'HardMiddel'                       ,'HardMiddel'                       ], Descr = "Geldende stimuli: alleen (zeer) hard, of ook middel, zacht?";
	attribute<String>    EvidentBenutVariant_Wonen:                        [ 'BAU'                            ,'BAU'                              ,'NbS'                              ,'NbS'                              ], Descr = "Selectie van BBG-klassen die voor deze sector als EvidentBenut gelden. Gegroepeerd per variant";
                                                                                                                                                                                                                          
	attribute<Woning_ha> MaxDichtheidInMooiLandschap:                      [100                               ,100                                ,100                                ,100                                ], Descr = "Maximale dichtheid (woningen per hectare) in Mooi Landschap";
	attribute<Woning_ha> MaxDichtheidInZeerMooiLandschap:                  [ 50                               , 50                                , 50                                , 50                                ], Descr = "Maximale dichtheid (woningen per hectare) in Zeer Mooi Landschap";
                                                                                                                                                                                                                          
                                                                                                                                                                   
                                                                                                                                                                                                                          
	attribute<bool_t>    HoogbouwToegestaanInMooiLandschap:                [ TRUE                             , TRUE                              , TRUE                              , TRUE                              ], Descr = "Is hoogbouw toegestaan in Mooi Landschap?";
	attribute<bool_t>    HoogbouwToegestaanInZeerMooiLandschap:            [FALSE                             ,FALSE                              , TRUE                              , TRUE                              ], Descr = "Is hoogbouw toegestaan in Zeer Mooi Landschap?";
	attribute<bool_t>    TinyHousesToegestaan:                             [FALSE                             ,FALSE                              ,FALSE                              ,FALSE                              ], Descr = "Zijn Tiny Houses toegestaan?";
	attribute<bool_t>    SuperStedelijkToegestaan:                         [ TRUE                             ,TRUE                               , TRUE                              , TRUE                              ], Descr = "Is SuperStedelijk bouwen toegestaan?";
                                                                                                                                                                                                                          
	attribute<float32_t> MinimumDichtheidToenameWonen:                     [0.10                              ,0.10                               ,0.10                               ,0.10                               ], Descr = "Fractie waarmee de Woningdichtheid minimaal moet toenemen in AllocDomain";
                                                                                                                                                                                                                          
	attribute<String>    OPScaleRef:                                       ['NettoBuurt'                      ,'NettoBuurt'                       ,'NettoBuurt'                       ,'NettoBuurt'                       ], Descr = "Gaan we bij het alloceren van wonen uit van woningdichtheden etc. op NettoBuurt schaal of op BrutoBuurt schaal";  // ''NettoBuurt, 'BrutoBuurt'
	attribute<String>    OpbrengstenVariant_Wonen:                         ['BAU'                             ,'BAU'                              ,'NbSMax'                           ,'NbSGenuanceerd'                   ], Descr = "Naam van de set Opbrengsten_perOP-bestanden die deze variant leest en schrijft, naar het voorbeeld van EvidentBenutVariant. Varianten met dezelfde waarde delen dezelfde tifs in VariantData/Vastgoed/Opbrengsten_perOP/<set>/. BAU en BAU2 delen een set: hun 53 tifs waren byte-identiek (gemeten 2026-08-28), dus de tweede kopie van 10 GB en 4 minuten generatie was loos. De NbS-varianten houden elk een eigen set, want de OP-factoren (onder andere de verhardingsfracties via Ontwikkelpakketten/PerVariant, die waarden uit deze tabel opzoeken) verschillen daar echt: 25 van de 53 tifs wijken af tussen BAU en NbSGenuanceerd. Geef een variant een eigen setnaam zodra hij afwijkende OP-factoren, woningwaardeparameters of een andere OPScaleRef krijgt; twee varianten met verschillende inhoud onder dezelfde setnaam overschrijven elkaars bestanden.";
                                                                                                                                                                                                                          
	attribute<YearRange> JaarWaarinFunderingschadeZichtbaar:               [2023                              ,2023                               ,2023                               ,2023                               ], Descr = "Wanneer wordt de schade zichtjaar voor kopers en moeten ofwel herstelkosten gemaakt of waardedaling van woning geincasseerd?";
	attribute<bool>      FunderingschadeWordtHersteld:                     [ TRUE                             , TRUE                              ,FALSE                              ,FALSE                              ], Descr = "Wordt de schade hersteld?";
	
	//Wat is toegestaan in de overstromingsgevraazones?					   // BAU                              ,BAU2                              ,NbSMax                             ,NbSGenuanceerd                     
	attribute<BouwregimeK>GevaarRegimeZone0:=union_data(.,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen              ,BouwregimeK/V/Bouwen              ), Descr = "Wat is toegestaan in de verschillende GevaarRegimeZones (GRZ). Zone 0 = geen GRZ. De klasse Slopen is hier verboden, zie de IntegrityCheck op elke zone. Een gevaarzone is een blijvende eigenschap van een groot deel van laag Nederland, en sloop op die schaal heeft drie dingen niet die de landschapstypen wel hebben: een toets op bestaand bebouwd gebied, een landgebruik dat ervoor in de plaats komt, en een allocregio die de restclaim kan opvangen. Wil je dat toch, regel die drie dan eerst.", IntegrityCheck = "all(this != BouwregimeK/V/Slopen) && #/Classifications/Overstromingsgevaarzonering/zoneringK == 6";
	attribute<BouwregimeK>GevaarRegimeZone1:=union_data(.,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen              ,BouwregimeK/V/Bouwen              ), Descr = "Wat is toegestaan in de verschillende GevaarRegimeZones (GRZ). Zone 1 = laagste GRZ", IntegrityCheck = "all(this != BouwregimeK/V/Slopen)";
	attribute<BouwregimeK>GevaarRegimeZone2:=union_data(.,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen,BouwregimeK/V/BouwenMetMaatregelen,BouwregimeK/V/Bouwen              ), Descr = "Wat is toegestaan in de verschillende GevaarRegimeZones (GRZ). Zone 2 = middelste GRZ", IntegrityCheck = "all(this != BouwregimeK/V/Slopen)";
	attribute<BouwregimeK>GevaarRegimeZone3:=union_data(.,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen,BouwregimeK/V/BouwenMetMaatregelen,BouwregimeK/V/BouwenMetMaatregelen), Descr = "Wat is toegestaan in de verschillende GevaarRegimeZones (GRZ). Zone 3 = hoogste GRZ", IntegrityCheck = "all(this != BouwregimeK/V/Slopen)";
	attribute<BouwregimeK>GevaarRegimeZone4:=union_data(.,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen,BouwregimeK/V/BouwenMetMaatregelen,BouwregimeK/V/BouwenMetMaatregelen), Descr = "Wat is toegestaan in de verschillende GevaarRegimeZones (GRZ). Zone 4 = uiterste GRZ", IntegrityCheck = "all(this != BouwregimeK/V/Slopen)";
	attribute<BouwregimeK>GevaarRegimeZone5:=union_data(.,BouwregimeK/V/Bouwen,BouwregimeK/V/Bouwen,BouwregimeK/V/BouwenMetMaatregelen,BouwregimeK/V/BouwenMetMaatregelen), Descr = "Wat is toegestaan in de verschillende GevaarRegimeZones (GRZ). Zone 5 = uiterste GRZ", IntegrityCheck = "all(this != BouwregimeK/V/Slopen)";
                                                                                                                                                                                                                          
///////////////////////////////////////////////////////////////////////////////////////// Werken //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
                                                                                                                                                                                                                          
	attribute<String>    EvidentBenutVariant_Werken:                       ['BAU'                             ,'BAU'                              ,'NbS'                              ,'NbS'                              ], Descr = "Selectie van BBG-klassen die voor deze sector als EvidentBenut gelden. Gegroepeerd per variant";
	attribute<string_t>  RestrictiesVariant_Werken:                        ['ZeerHardHardMiddel'              ,'ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'               ], Descr = "Welke restricties gelden: alleen (zeer) hard, of ook middel, zacht?";
	attribute<string_t>  StimuliVariant_Werken:                            ['HardMiddel'                      ,'HardMiddel'                       ,'HardMiddel'                       ,'HardMiddel'                       ], Descr = "Welke stimuli gelden: alleen (zeer) hard, of ook middel, zacht?";
                                                                                                                                                                                                                          
	attribute<float32_t> MinimumDichtheidToenameWerken:                    [0.10                              ,0.10                               ,0.10                               ,0.10                               ], Descr = "Fractie waarmee de Werkdichtheid minimaal moet toenemen in AllocDomain (100m cel). Nodig om verdunning te voorkomen (niet te sturen met huidge versie van suit maps waar geen transitiekosten in zitten)";
                                                                                                                                                                                                                          
	attribute<m2BVO_job> m2BVO_job_Kantoor:                                [17.5                              ,17.5                               ,17.5                               ,17.5                               ], Descr = "De zgn. Kantoorcoefficioent en de groeifactor die daaruit kan worden afgeleid. Bron: expert judgement PBL. Default: /ModelParameters/m2BVO_job_Kantoor_PreCORONA";
	attribute<float32_t> m2BVO_job_Kantoor_groeifactor := ((m2BVO_job_Kantoor / /ModelParameters/werken/m2BVO_job_Kantoor_Basisjaar) - 1f) / 1f                                                                            , Descr = "Groeifactor voor het ruimtebeslag per kantoorbaan, ten opzichte van de kantoorcoefficient in het basisjaar (ModelParameters/Werken/m2BVO_job_Kantoor_Basisjaar). Grijpt aan op de dichtheid: hij verlaagt de pandvoetafdruk per kantoorbaan en verhoogt spiegelbeeldig het aantal banen per m2, in elk zichtjaar als niveauverschuiving ten opzichte van de waarneming in het basisjaar (#590). De noemer was de pre-coronawaarde 2020, terwijl de waarneming waarop de factor aangrijpt uit LISA_StartYear komt; dat telde de bureaudeling van voor het basisjaar dubbel (#668).";
                                                                                                                                                                                                                          
	// Groeifactor t.a.v. m2pandFootprint_baan werken                                                                                                                                                                     
	// Aanpassing van werkdichtheid op bestaand werkgebied gebeurt hier: /VariantData/Allocatie/Zichtjaren/Y2030/StateVoorAllocatie/Werken                                                                                
	// Aanpassing van werkdichtheid op nieuw werkgebied gebeurt hier: /VariantData/Dichtheid/Per_AllocDomain/Y2030/Src/Werken/Job_Perm2PandFootprint/Subsectoren                                                          
	container Groeifactor := ModelParameters/Werken/Groeifactor;                                                                                                                                                          
	                                                                     // BAU                               ,BAU2                               ,NbSMax                             ,NbSGenuanceerd                     
	attribute<jaarlijks> Groeifactor_Nijverheid             := union_data(.,Groeifactor/Nijverheid            ,Groeifactor/Nijverheid             ,Groeifactor/Nijverheid             ,Groeifactor/Nijverheid             ), Descr = "groeifactor t.a.v. m2pandFootprint_baan voor de subsector Nijverheid";
	attribute<jaarlijks> Groeifactor_Logistiek              := union_data(.,Groeifactor/Logistiek             ,Groeifactor/Logistiek              ,Groeifactor/Logistiek              ,Groeifactor/Logistiek              ), Descr = "groeifactor t.a.v. m2pandFootprint_baan voor de subsector Logistiek";
	attribute<jaarlijks> Groeifactor_Detailhandel           := union_data(.,Groeifactor/Detailhandel          ,Groeifactor/Detailhandel           ,Groeifactor/Detailhandel           ,Groeifactor/Detailhandel           ), Descr = "groeifactor t.a.v. m2pandFootprint_baan voor de subsector Detailhandel";
	attribute<jaarlijks> Groeifactor_Ov_consumentendiensten := union_data(.,Groeifactor/Ov_consumentendiensten,Groeifactor/Ov_consumentendiensten ,Groeifactor/Ov_consumentendiensten ,Groeifactor/Ov_consumentendiensten ), Descr = "groeifactor t.a.v. m2pandFootprint_baan voor de subsector Overige consumentendiensten";
	attribute<jaarlijks> Groeifactor_Zak_dienstverlening    := union_data(.,Groeifactor/Zak_dienstverlening   ,Groeifactor/Zak_dienstverlening    ,Groeifactor/Zak_dienstverlening    ,Groeifactor/Zak_dienstverlening    ), Descr = "groeifactor t.a.v. m2pandFootprint_baan voor de subsector Zakelijke dienstverlening";
	attribute<jaarlijks> Groeifactor_Overheid_kw_diensten   := union_data(.,Groeifactor/Overheid_kw_diensten  ,Groeifactor/Overheid_kw_diensten   ,Groeifactor/Overheid_kw_diensten   ,Groeifactor/Overheid_kw_diensten   ), Descr = "groeifactor t.a.v. m2pandFootprint_baan voor de subsector Overheid en kwartaire diensten";
                                                                                                                                                                                                                          
///////////////////////////////////////////////////////////////////////////////// Wonen/Werken ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
                                                                                                                                                                                                                          
	attribute<float32_t> VerhardingTovDefault:                             [1.00                               ,1.00                              ,1.00                               ,1.00                               ], Descr = "Mate waarin de verharding van nieuwbouwlocaties (ex pandfootprint!) in de Varianten hoger is dan de default. 1.0 = gelijk aan default, 0.5 = de helft van default, 2.0 = het dubbele van default";
	                                                                                                                                                                                                                      
	attribute<string_t>  ClaimVariantName:                                 ['BAU'                              ,'BAU'                             ,'BAU'                              ,'BAU'                              ], Descr = "Welke variant uit de TIGRIS claims moet worden gekozen";
                                                                                                                                                                                                                          
	attribute<float32_t> DichtheidFactorGeneriek:                          [1.00                               ,1.00                              ,1.00                               ,1.00                               ], Descr = "Generieke (niet-locatiespecifieke) factor, te vermenigvuldigen met waargenomen dichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorOV_EG:                             [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor OV-locaties voor Eengezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorOV_MG:                             [1.50                               ,1.50                              ,1.50                               ,1.50                               ], Descr = "Locatiespecifieke Factor voor OV-locaties voor Meergezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorOV_NietWonen:                      [1.50                               ,1.50                              ,1.50                               ,1.50                               ], Descr = "Locatiespecifieke Factor voor OV-locaties voor Niet-Wonen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorWater_EG:                          [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Water-locaties voor Eengezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorWater_MG:                          [1.50                               ,1.50                              ,1.50                               ,1.50                               ], Descr = "Locatiespecifieke Factor voor Water-locaties voor Meergezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorWater_NietWonen:                   [1.50                               ,1.50                              ,1.50                               ,1.50                               ], Descr = "Locatiespecifieke Factor voor Water-locaties voor Niet-Wonen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
                                                                                                                                                                                                                          
	attribute<float32_t> DichtheidFactorBevKern100kPlus_EG:                [1.20                               ,1.20                              ,1.20                               ,1.20                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen >100k inwoners in WLO Hoog voor Eengezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern100kPlus_MG:                [1.20                               ,1.20                              ,1.20                               ,1.20                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen >100k inwoners in WLO Hoog voor Meergezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern100kPlus_NietWonen:         [1.20                               ,1.20                              ,1.20                               ,1.20                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen >100k inwoners in WLO Hoog voor Niet-Wonen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern20kPlus_EG:                 [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen 20-100k inwoners in WLO Hoog voor Eengezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern20kPlus_MG:                 [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen 20-100k inwoners in WLO Hoog voor Meergezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern20kPlus_NietWonen:          [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen 20-100k inwoners in WLO Hoog voor Niet-Wonen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern20kMin_EG:                  [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen <20k inwoners in WLO Hoog voor Eengezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern20kMin_MG:                  [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen <20k inwoners in WLO Hoog voor Meergezinswoningen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
	attribute<float32_t> DichtheidFactorBevKern20kMin_NietWonen:           [1.10                               ,1.10                              ,1.10                               ,1.10                               ], Descr = "Locatiespecifieke Factor voor Bebouwde Kernen <20k inwoners in WLO Hoog voor Niet-Wonen, te vermenigvuldigen met waargenomen Woningdichtheden, t.b.v. het bepalen van de maximale dichtheid waarin gebouwd mag worden. Hoe hoger de factor, hoe hoger het maximum.";
                                                                                                                                                                                                                          
	attribute<ha>        MinimalLandAvailability:                          [0.40                               ,0.40                              ,0.40                               ,0.40                               ], Descr = "Minimale oppervlak van een gridcel (AllocDomain) die beschikbaar moet zijn voor bebouwing. Anders wordt de cel restrictief verklaard voor bouwen. Gevoeligheid: lagere waarden → meer verdichting mogelijk; hogere waarden → meer uitbreiding.";
                                                                                                                                                                                                                          
	attribute<Yr>        GeenSlooptotLeeftijd_BuitenHardePlancapaciteit:   [55                                 ,55                                ,55                                 ,55                                 ], Descr = "Geen sloop toegestaan van woningen met een leeftijd jonger dan opgegeven."; 
	attribute<Energielabel> GeenSloopvanafELabel := union_data             (., Energielabel/V/D                ,Energielabel/V/D                  ,Energielabel/V/B                   ,Energielabel/V/B                   ), Descr = "Geen sloop toegestaan van woningen met een hoger dan opgegeven energielabel. Oftewel, als D dan mogen C en hoger niet worden gesloopt."; 
                                                                                                                                                                                                                          
	attribute<Eur>       MinimumExploitatieSaldo:                          [0                                  ,0                                 ,0                                  ,0                                  ], Descr = "Minimale ondergrens voor het exploitatie saldo van een woning. Onder deze grens wordt een locatie restrictief verklaard voor bouwen.";
                                                                                                                                                                                                                          
	                                                                       // BAU                              ,BAU2                              ,NbSMax                             ,NbSGenuanceerd                     
	attribute<bool_t>    NietBouwenInNatura2000Buffer:                     [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen in de bufferzone rond Natura2000 gebieden";
	attribute<bool_t>    NietBouwenVerVanOV:                               [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen op locaties die ver van OV zijn gelegen (boven een bepaalde reistijd).";
	attribute<bool_t>    NietBouwenOpZeehaven:                             [ TRUE                              , TRUE                             , TRUE                              , TRUE                              ], Descr = "Niet bouwen in de zeehavengebieden (ten behoeve van havenontwikkeling)";
	attribute<bool_t>    NietBouwenWaarSlap:                               [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen op slappe gronden (ten behoeve van kostenreductie)";
	attribute<bool_t>    NietBouwenWaarNat:                                [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen op natte gronden (ten behoeve van waterberging). In WBS om (bouw)kosten te besparen";
	attribute<bool_t>    NietBouwenWaarBeheerkostenInfraTeHoog:            [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen waar de bodemdaling tot 2050 boven MaxBodemdaling uitkomt en de grond slap of zettingsgevoelig is. Stond tot #505 vast aan zonder schakelaar, en was daarmee de enige slappe-bodemrestrictie die daadwerkelijk beperkte: NietBouwenWaarSlap en NietBouwenWaarZettingsgevoelig staan overal uit. Staat sinds #505 in alle vier de varianten op FALSE, samen met die twee, zodat geen enkele slappe-bodemrestrictie meer zeeft en de afweging volledig via de meerkosten uit Bodemdalingkosten loopt. Op TRUE zetten geeft het zeefgedrag van voor #505 terug, wat alleen zinvol is als je die twee benaderingen naast elkaar wilt leggen; laat ze niet allebei aan staan, want dan wordt de slappe bodem zowel weggezeefd als beprijsd.";
	attribute<bool_t>    NietBouwenWaarZettingsgevoelig:                   [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen op zettingsgevoelige gronden (ten behoeve van kostenreductie)";
	attribute<bool_t>    BodemdalingkostenInSaldo:                         [ TRUE                              , TRUE                             , TRUE                               ,TRUE                              ], Descr = "Rekent deze variant de kosten van bouwen op een bodemdalingsgevoelige ondergrond door als eigen post in het exploitatiesaldo, uit de kengetallen van bijlage E van het landelijk afwegingskader van Deltares en Sweco (#505)?

				Deze kolom schakelt twee dingen tegelijk, en dat is geen gemak maar een eis. Op TRUE komen de meerkosten uit Bodemdalingkosten in het saldo en gaat de dummy AndersBouwen in de grondproductiekosten uit. Op FALSE precies andersom. Beide beschrijven het hele bodemeffect, dus met allebei aan wordt de bodem twee keer beprijsd en met allebei uit verdwijnt hij helemaal.

				Alle vier de varianten staan op TRUE en rekenen dus met de kengetallen. BAU en BAU2 stonden tot 28 augustus 2026 op FALSE zodat ze vergelijkbaar bleven met runs van voor #505; die vergelijkbaarheid is bewust opgegeven, dus runs van voor die datum zijn op deze post niet meer naast nieuwe te leggen.

				Omdat deze kolom de grondproductiekosten raakt, is die module sinds #505 variantspecifiek en staat hij in Templates/VariantData_T/Geschiktheden in plaats van in BaseData.";
	attribute<bool_t>    BouwwijzeVeenGeldtVoorOPs:                        [FALSE                              ,FALSE                             ,TRUE                              ,TRUE                              ], Descr = "Laat het bebouwingstype uit het landschapstype veen meewegen in de OP-keuze: waar aangepast bouwen staat vallen de niet-bodemdalingbestendige ontwikkelpakketten af, waar wonen op water staat blijven alleen drijvende over. Werkt via dezelfde OP-kolom als de overstromingsmaatregel, getoetst op IsBodemdalingbestendig respectievelijk IsDrijvend. Staat aan in NbSMax en NbSGenuanceerd en uit in BAU en BAU2. Let op wat dat betekent zolang de bouwwijze-kosten uit #505 er niet in zitten: in die twee varianten werkt dit als een pure restrictie op de OP-keuze en niet als een prijs, terwijl #505 juist die restrictie door een prijs wil vervangen. De twee NbS-varianten hebben op deze post dus een andere mechaniek dan BAU en BAU2.";
                                                                                                                                                                                                                          
	// attribute<bool_t>    OverstromingsMaatregelKanAangepastBouwenZijn:                  [FALSE                              ,FALSE                             , TRUE                              , TRUE                              ], Descr = "Kan de maatregel 'Aangepast bouwen' worden ingezet om bouwen toch toe te staan op locaties waar dat anders niet zou mogen?";
                                                                                                                                                                                                                          
	attribute<bool_t>    NietBouwenInZeerMooiLandschapWonen:               [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet woningen bouwen in Zeer Mooi Landschap";
	attribute<bool_t>    NietBouwenInZeerMooiLandschapWerken:              [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet werken bouwen in Zeer Mooi Landschap";
	attribute<bool_t>    NietBouwenInMooiLandschap:                        [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen in Mooi Landschap";
	attribute<bool_t>    NietBouwenInNatuurorganisaties:                   [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen op terreinen van natuurorganisaties (Natuurmonumenten, Staatsbosbeheer, etc.)";
	attribute<bool_t>    NietBouwenInWaterschappen:                        [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Niet bouwen op terreinen van waterschappen";
	attribute<bool_t>    BouwenInWoonlocatieNietVanGemeenteOfCorporatie:   [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Bouwen in woonlocaties die niet van gemeente of corporatie zijn (dus van particulieren of projectontwikkelaars)";
                                                                                                                                                                                                                          
	attribute<bool_t>    RestrictiesOokGeldigBinnenHardePlancapaciteit:    [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Zijn restricties ook geldig binnen de harde plancapaciteit? Buiten harde plancapaciteit zijn restricties sowieso geldig. Deze schakelaar heft sinds #686 de bescherming van de harde plancapaciteit in zijn geheel op, dus ook voor de landschappelijke, bodemkundige en eigendomstoetsen die in dezelfde groep zitten. Daarvoor lichtte hij alleen de restrictiekaarten eruit, terwijl de wikipagina Beschikbaarheid hem al als de algemene schakelaar beschreef.";
	attribute<bool_t>    ZeerHardOokGeldigBinnenHardePlancapaciteit:       [ TRUE                              , TRUE                             , TRUE                              , TRUE                              ], Descr = "Geldt alleen de zeerharde restrictielaag ook binnen de harde plancapaciteit, terwijl de overige hardheden daarbinnen vrijgesteld blijven? Dit is de tussentrede tussen niets en RestrictiesOokGeldigBinnenHardePlancapaciteit hierboven.
																																																																				De aanleiding is #686. Een wettelijk verbod kan niet door een gemeentelijk plan opzij worden gezet, en dat gebeurde wel: van de harde plancapaciteit wonen ligt een deel in de zeerharde laag en dat werd in zijn geheel vrijgesteld. Staat deze schakelaar aan, dan blijft dat deel restrictief en houden de overige hardheden hun vrijstelling.
																																																																				Staat sinds 28 augustus 2026 in alle vier de varianten aan, als besluit bij #686. De prijs is bekend en aanvaard: van de harde plancapaciteit valt 521 hectare wonen af, met 17.336 bestaande woningen erop, en 1.522 hectare werken. Die claim landt elders in dezelfde regio, dus de inbreidingsfractie zakt.

																																																																																																De kanttekening blijft staan: de zeerharde laag is hiervoor eigenlijk te breed. Binnen bebouwd gebied rust 72 procent ervan uitsluitend op rijksmonumenten, rijksbeschermde stads- en dorpsgezichten en gebufferde hoogspanningslijnen, en dat zijn regimes waaronder ontwikkeling met voorwaarden juist wel kan. Het uitsplitsen van die laag loopt in het restrictieproject, pbl-nl/model-RS-RuimtelijkeRestricties#5. Zodra dat is gebeurd wordt deze schakelaar strikter en zuiverder tegelijk.

																																																																																																Werkt niet voor wind en landbouw: daar houdt de zeef zijn eigen regime.";
	attribute<bool_t>    HardePlannenGeldigInZeef:                         [ TRUE                              , TRUE                             , TRUE                              , TRUE                              ], Descr = "Worden harde plannen uitgezonderd in de zeefanalyse?";
	attribute<bool_t>    ZachtePlannenGeldigInZeef:                        [ TRUE                              , TRUE                             , TRUE                              , TRUE                              ], Descr = "Worden zachte plannen uitgezonderd in de zeefanalyse?";
                                                                                                                                                                                                                          
	attribute<string_t>  KlimaatScenario_ref:                              ['Stoom2100'                        ,'Stoom2100'                       ,'Stoom2100'                        ,'Stoom2100'                        ], Descr = "Welk delta scenario vormt het uitgangspunt qua klimaat?";
	attribute<String>    Trede_Variant:                                    ['BAU'                              ,'BAU'                             ,'NbSMax'                           ,'NbSGenuanceerd'                   ], Descr = "Welke trede-variant moet worden gekozen. Dit geeft voorkeursvolgorde van allocatie weer. Dit heeft zeer veel impact op de resultaten.";
	attribute<String>    EvidentBenutVariant_BGT:                          [ 'Default'                         ,'Default'                         ,'Default'                          ,'Default'                          ], Descr = "Selectie van BGT-klassen die voor wonen/werken als EvidentBenut gelden. Gegroepeerd per variant. De generatie staat in /VariantData/<variant>/EvidentBenut. De inhoud van de hier gekozen set zit in de fingerprint van het ontkoppelde bestand, dus een wijziging binnen de set Default leidt vanzelf tot hergenereren.";
	attribute<String>    ReserverenVoorRivierAfvoer_ref:                   [ 'BaU'                             ,'BaU'                             ,'BaU'                              ,'BaU'                              ];
                                                                                                                                                                                                                          
