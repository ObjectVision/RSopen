    attribute<Eur_Ha_jaarlijks> ANLb_veen_Bedrag:                          [ 300                               , 300                              , 300                               , 300                               ];
    attribute<Ratio>            ANLb_veen_Fractie:                         [ 0.10                              , 0.10                             , 0.10                              , 0.10                              ];
                                                                                                                                                                                                                          
////////////////////////////////////////////////////////////////////////////////////// Waterretentie stad ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// bestaand/resterend in/uit basisjaar                                                                                                                                                                                                                          
	attribute<float32_t> FractieGroenDakBestaandeBouwIn2050:               [0.30                               ,0.30                              ,0.00                               ,0.00                               ], Descr = "Aandeel van bestaande daken dat groen wordt gemaakt (bestaand ruimtegebruik). Sinds #746 bergt alleen het platte deel daarvan; op het schuine deel geldt het kental GroenDakSchuin van nul (Classifications/WaterretentieK, ModelParameters/Piekbuiberging/Dakvorm).";//
	attribute<float32_t> FractieBlauwDakBestaandeBouwIn2050:               [0.00                               ,0.00                              ,1.00                               ,0.70                               ], Descr = "Aandeel van de platte bestaande daken dat blauw wordt gemaakt (bestaand ruimtegebruik); sinds #746 werkt deze fractie alleen op het platte deel van het dak, zie FractieBlauwDakNieuwbouw. Hoort bij FractieGroenDakBestaandeBouwIn2050 hierboven: in de NbS-varianten gaat het dak van groen naar blauw, en die twee rijen tellen samen op tot het aandeel bewerkte daken. Deze rij stond tot #714 uitgecommentarieerd terwijl de groene rij in de NbS-varianten al op nul was gezet, waardoor het dakenaanbod daar op exact nul uitkwam. Een blauw dak bergt 0,10 m3 per m2 tegen 0,01 voor een groen dak (Classifications/WaterretentieK), dus dat scheelt een orde van grootte in het aanbod.";//
	attribute<float32_t> FractieWaterretentieCapaciteitHalfVerharding:     [0.01                               ,0.01                              ,0.50                               ,0.50                               ], Descr = "Aandeel van betreffend verhard oppervlak dat halfverhard kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitHolleWeg:           [0.10                               ,0.10                              ,0.30                               ,0.30                               ], Descr = "Aandeel van betreffend verhard oppervlak (wegen) dat 'hol' kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitWadi:               [0.10                               ,0.10                              ,0.50                               ,0.50                               ], Descr = "Aandeel van betreffend groen oppervlak dat wadi kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitDoorlatendGroen:    [0.00                               ,0.00                              ,0.00                               ,0.00                               ], Descr = "Aandeel van het groene oppervlak dat doorlatend groen wordt (bestaand ruimtegebruik). De BGT-capaciteitskaart voor deze maatregel staat in bestaand gebied nog op nul, dus deze fractie is daar tot nu toe zonder effect. Tot #746 droeg deze rij de Descr van de wadi-rij.";//
	attribute<float32_t> FractieWaterretentieCapaciteitBergingOpWater:     [0.00                               ,0.00                              ,0.00                               ,0.00                               ], Descr = "Aandeel van het wateroppervlak dat berging via peilopzet krijgt (bestaand ruimtegebruik). De BGT-capaciteitskaart voor deze maatregel staat in bestaand gebied nog op nul, dus deze fractie is daar tot nu toe zonder effect. Tot #746 droeg deze rij de Descr van de wadi-rij.";//
//	nieuwbouw                                                                                                                                                                                                                      
	attribute<float32_t> FractieGroenDakNieuwbouw:                         [0.30                               ,0.30                              ,0.00                               ,0.00                               ], Descr = "Aandeel van nieuwe daken dat groen wordt aangelegd. Sinds #746 bergt alleen het platte deel daarvan; op het schuine deel geldt het kental GroenDakSchuin van nul."; //
	attribute<float32_t> FractieBlauwDakNieuwbouw:                         [0.00                               ,0.00                              ,1.00                               ,0.70                               ], Descr = "Aandeel van de platte nieuwe daken dat blauw wordt aangelegd. Sinds #746 werkt deze fractie alleen op het platte deel van het dak (ModelParameters/Piekbuiberging/Dakvorm), want een blauw dak kan constructief niet op een schuin dak; de groene fractie geldt voor het hele dak met een kental van nul op het schuine deel. Tot #746 droeg deze rij per ongeluk de Descr van de groene rij."; //
	attribute<float32_t> FractieHalfverhardingNieuwbouwUitgeefbaar:        [0.10                               ,0.10                              ,0.30                               ,0.30                               ], Descr = "Aandeel van nieuw verhard oppervlak in uitgeefbaar gebied dat halfverhard kan worden aangelegd"; //
	attribute<float32_t> FractieHalfverhardingNieuwbouwOpenbaar:           [0.10                               ,0.10                              ,0.50                               ,0.50                               ], Descr = "Aandeel van nieuw verhard oppervlak in openbaar gebied dat halfverhard kan worden aangelegd"; //
	attribute<float32_t> FractieHolleWegNieuwbouwOpenbaar:                 [0.05                               ,0.05                              ,0.15                               ,0.15                               ], Descr = "Aandeel van nieuw verhard oppervlak in openbaar gebied dat als holle weg wordt aangelegd (#757). Deelt de noemer met de rij hierboven, dus halfverharding en holle weg liggen op hetzelfde openbare oppervlak en tellen samen op tot het bewerkte deel; OpVerhardOpenbaar bewaakt dat met een IntegrityCheck. De waarden zijn de helft van FractieWaterretentieCapaciteitHolleWeg voor bestaand gebied, want die rij heeft alleen de rijbaan als noemer en de rijbaan is ongeveer de helft van de openbare verharding; gemeten op de BGT-capaciteitskaarten is er 391,8 mln m2 rijbaan lokale weg plus OV-baan tegen 383,6 mln m2 halfverhardbaar oppervlak. Dezelfde ambitie dus, op een andere noemer. Ter toetsing bij Deltares."; //
	attribute<float32_t> FractieWadiNieuwbouwUitgeefbaarGras:              [0.05                               ,0.05                              ,0.30                               ,0.30                               ], Descr = "Aandeel van nieuw groen oppervlak in uitgeefbaar gebied dat als wadi kan worden aangelegd"; //
	attribute<float32_t> FractieWadiNieuwbouwOpenbaarGras:                 [0.10                               ,0.10                              ,0.50                               ,0.50                               ], Descr = "Aandeel van nieuw groen oppervlak in openbaar gebied dat als wadi kan worden aangelegd"; //
	attribute<float32_t> FractieDoorlatendGroenNieuwbouw:                  [0.00                               ,0.00                              ,1.00                               ,1.00                               ], Descr = "Aandeel van nieuw groen oppervlak dat doorlatend kan worden aangelegd"; //
	attribute<float32_t> FractieBergingOpWaterNieuwbouw:                   [0.00                               ,0.00                              ,1.00                               ,1.00                               ], Descr = "Aandeel van nieuw wateroppervlak waarop extra kan worfden gebergd (via peilopzet)"; //
                                                                                                                                                                                                                          
////////////////////////////////////////////////////////////////////////////////////// WaterBerging veen ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	                                                                                                                                                                                                                      
	attribute<String>    EvidentBenutVariant_WaterBerging:                 ['BAU'                              ,'BAU'                             ,'BAU'                              ,'BAU'                              ], Descr = "Selectie van BBG-klassen die voor verblijfsrecretie als EvidentBenut gelden. Gegroepeerd per variant";
	attribute<string_t>  RestrictiesVariant_WaterBerging:                  ['ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'              ,'ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'               ], Descr = "Geldende restricties: alleen (zeer) hard, of ook middel, zacht?";
	attribute<string_t>  StimuliVariant_WaterBerging:                      ['HardMiddel'                       ,'HardMiddel'                      ,'HardMiddel'                       ,'HardMiddel'                       ], Descr = "Geldende stimuli: alleen (zeer) hard, of ook middel, zacht?";
	attribute<float32_t> MinimumDichtheidToenameWaterberging:              [0.0                                ,0.0                               ,0.0                                ,0.0                                ], Descr = "Minimale dichtheidstoename (in % t.o.v. de waargenomen dichtheid) die nodig is om een locatie geschikt te maken voor landbouw. Wordt gebruikt om te voorkomen dat locaties met zeer lage dichtheden worden gealloceerd.";
	attribute<string_t>  WaterbergingClaimBron:                            ['BAU'                              ,'BAU2'                             ,'BAU2'                            ,'BAU2'                             ], Descr = "Welke door Deltares aangeleverde claimkolom deze variant gebruikt, zie ModelParameters/Waterberging/Claims. Geleverd zijn alleen BAU1 en BAU2; de NbS-varianten lenen de BAU2-reeks. Toegestane waarden: BAU (is BAU1 in de aanlevering) en BAU2. Doet niets zolang WaterbergingClaimActief uit staat.";
	attribute<bool_t>    WaterbergingOpBestaandWater:                      [FALSE                              ,FALSE                              ,TRUE                              ,TRUE                               ], Descr = "Wordt het peil in bestaand oppervlaktewater 15 cm opgezet? Zo ja, dan gebruikt de variant de kolommen OokBestaand_* en is de resterende opgave voor nieuwe berging kleiner. Loopt gelijk op met FractieBergingOpWaterNieuwbouw.";
	attribute<bool_t>    WaterbergingClaimActief:                          [FALSE                              ,FALSE                              ,TRUE                              ,TRUE                               ], Descr = "Alloceert deze variant waterberging? Zo nee, dan staat de opgave voor alle waterbergingsregio's en zichtjaren op 0 en alloceert de sector niets. Uit in BAU en BAU2 op het besluit in #664: in de referentievarianten geen waterbergingsallocatie op het veen. De aangeleverde BAU- en BAU2-reeksen blijven in ModelParameters/Waterberging/Claims staan; WaterbergingClaimBron bepaalt welke reeks geldt zodra deze schakelaar aanstaat.";

	// Gewichten voor de waterberging-geschiktheid, zie /Templates/Suitabilities/Suitability_Zichtjaar_T/Waterberging.
	// De positieve gewichten tellen per variant bij voorkeur op tot 1.0; Weight_Wegzijging wordt als negatieve term afgetrokken.
	attribute<float32_t> Weight_Depth_Waterberging:                        [0.20                               ,0.20                              ,0.20                               ,0.20                               ], Descr = "Gewicht van de genormaliseerde waterdiepte (dieptekaart) in de waterberging-geschiktheid";
	attribute<float32_t> Weight_UAI_Waterberging:                          [0.10                               ,0.10                              ,0.10                               ,0.10                               ], Descr = "Gewicht van de inverse urban attractivity index in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Lake_Waterberging:                         [0.15                               ,0.15                              ,0.15                               ,0.15                               ], Descr = "Gewicht van de nabijheid van bestaande meren in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Peat_Waterberging:                         [0.35                               ,0.35                              ,0.35                               ,0.35                               ], Descr = "Gewicht van de nabijheid van veengebieden in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Kwel_Waterberging:                         [0.20                               ,0.20                              ,0.20                               ,0.20                               ], Descr = "Gewicht van kwel (afgekapt en geschaald 0..1) in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Wegzijging_Waterberging:                   [0.20                               ,0.20                              ,0.20                               ,0.20                               ], Descr = "Gewicht van wegzijging (afgekapt en geschaald 0..1); wordt als negatieve term van de waterberging-geschiktheid afgetrokken";
	attribute<float32_t> Weight_VeenWater_Waterberging:                    [0.00                               ,0.00                              ,0.00                               ,1.00                               ], Descr = "Voorkeursterm voor de cellen waar de veenallocatie het open water van bouwsteen 9a en 9b heeft gelegd (#664): de waterbergingsallocatie landt bij voorkeur daar, zodat de aangeleverde opgave op die plekken verzadigd raakt in plaats van dubbel te tellen. Bij 1.0 is het een vrijwel strikte rangorde, want de overige termen tellen samen op tot hoogstens 1. Alleen NbSGenuanceerd heeft de veen-bouwstenenlevering; in de andere varianten moet dit gewicht 0 zijn, anders verwijst de geschiktheid naar een levering die daar niet bestaat.";
                                                                                                                                                                                                                          
////////////////////////////////////////////////////////////////////////////////////// Natuur ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	                                                                                                                                                                                                                      
	attribute<String>    NDVI_variant_ref:                                 ['mid'                              ,'mid'                             ,'max'                              ,'max'                              ], Descr = "Het NDVI-bereik per landgebruiksklasse is een bandbreedte, geen exacte waarde; de werkelijke NDVI hangt o.a. af van natuurkwaliteit, seizoen en beheer. Daarom worden min-, mid- en max-varianten doorgerekend";
}