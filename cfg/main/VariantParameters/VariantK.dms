	attribute<String>    EvidentBenutVariant_Landbouw:                     ['Default'                          ,'Default'                         ,'Default'                          ,'Default'                          ], Descr = "Selectie van BBG-klassen die voor landbouw als EvidentBenut gelden. Gegroepeerd per variant";
	attribute<string_t>  RestrictiesVariant_Landbouw:                      ['Zacht'                            ,'Zacht'                           ,'Zacht'                            ,'Zacht'                            ], Descr = "Welke restricties gelden: alleen (zeer) hard, of ook middel, zacht?";
	attribute<string_t>  StimuliVariant_Landbouw:                          ['Zacht'                            ,'Zacht'                           ,'Zacht'                            ,'Zacht'                            ], Descr = "Welke stimuli gelden: alleen (zeer) hard, of ook middel, zacht?";
	attribute<float32_t> MinimumDichtheidToenameLandbouw:                  [0.0                                ,0.0                               ,0.0                                ,0.0                                ], Descr = "Minimale dichtheidstoename (in % t.o.v. de waargenomen dichtheid) die nodig is om een locatie geschikt te maken voor landbouw. Wordt gebruikt om te voorkomen dat locaties met zeer lage dichtheden worden gealloceerd.";
	attribute<String>    Waterbeheeroptie:                                 ['Indexation_NoDD'                  ,'Fixation_DD'                     ,'Fixation_NoDD'                    ,'Fixation_NoDD'                    ], Descr = "Welke waterbeheeroptie wordt toegepast. Indexation = peilfluctuaties meeveranderen met grondwaterstand; Fixation = peilfluctuaties constant houden. NoDD = geen drainage diepte.";
	attribute<String>    WinterdroogleggingK_ref:                          ['shp'                              ,'_0'                              ,'min0_2'                           ,'min0_2'                           ], Descr = "Gewenste winterdrooglegging t.o.v. zomerdrooglegging in meters. min0_1 = -0.1m; min0_2 = -0.2m";
	attribute<String>    ZomerdroogleggingK_ref:                           ['shp'                              ,'_0_4'                            ,'_0_2'                             ,'_0_2'                             ], Descr = "Gewenste zomerdrooglegging t.o.v maaiveld in meters. _0_6 = 0.6m; _0_2 = 0.2m";
	attribute<String>    ZomerdroogleggingK_fallback_ref:                  ['_0_6'                             ,'_0_6'                            ,'_0_6'                             ,'_0_6'                             ], Descr = "Zomerdrooglegging die wordt gebruikt waar de peilvakdata ontbreekt. Alleen van toepassing als ZomerdroogleggingK_ref op shp staat. Issue #619.";
	attribute<String>    WinterdroogleggingK_fallback_ref:                 ['_0'                               ,'_0'                              ,'_0'                               ,'_0'                               ], Descr = "Winterdrooglegging t.o.v. zomerdrooglegging die wordt gebruikt waar de peilvakdata ontbreekt. Alleen van toepassing als WinterdroogleggingK_ref op shp staat. Issue #619.";
	attribute<String>    InfiltratieMaatregelK_ref:                        ['Geen_infiltratiemaatregel'        ,'AWIS'                            ,'AWIS'                             ,'AWIS'                             ], Descr = "Welke infiltratiemaatregel wordt toegepast. AWIS = Aanvullend Water Infiltratie Systeem; PWIS = Permanent Water Infiltratie Systeem; Geen_infiltratiemaatregel = geen infiltratiemaatregel";
	attribute<bool_t>    VernattingUitsluitenZonderWIS:                    [TRUE                               ,TRUE                              ,TRUE                               ,TRUE                               ], Descr = "Sluit percelen uit van de vernatting waarvoor de SOMERS-datasheet geen rekenregel met een infiltratiemaatregel heeft, in de praktijk de moerige gronden. Die percelen houden hun gemeten drooglegging en rekenen zonder maatregel, en krijgen dus dezelfde uitstoot als in de variant zonder vernatting. Afgesproken met Deltares, zie #619.";
	//attribute<String>    BeregeningsScenario:                              ['WelBeregening'                    ,'WelBeregening'                   ,'WelBeregening'                    ,'WelBeregening'                              ], Descr = "tbv WWL_dynamisch opbrengstenderving";
	attribute<String>    VerziltingsScenario:                              ['Stoom2050'                        ,'Stoom2050'                       ,'Stoom2050'                        ,'Stoom2050'                        ], Descr = "Welk verziltingsscenario wordt toegepast. Opties: Stoom2050, Stoom2100";
	attribute<String>    Claim_agrarisch_Variant:                          ['claims_conservatief'              ,'claims_conservatief'             ,'claims_conservatief'              ,'claims_conservatief'              ], Descr = "Welke claimvariant wordt toegepast. Opties: claims_conservatief, claims_ggvee_minfractie, claims_ggvee_maxfractie";
	attribute<Bool>      ExogeenOpleggen:                                  ['TRUE'                             ,'TRUE'                            ,'TRUE'                             ,'TRUE'                             ], Descr = "Wordt er bepaald landgebruik exogeen opgelegd? Zoals waterbergingsgebieden.";
	attribute<bool_t>    ExogeenWaterOpleggen:                             [FALSE                              ,FALSE                             ,FALSE                              ,FALSE                              ], Descr = "Neemt de exogene oplegging naast de natuurstroom ook de waterstroom mee? De leveringen geven water apart aan; in NbSGenuanceerd is dat 21.132 ha rivierwater, plus het open water van de veenbouwstenen 9a en 9b dat op N04.02 uitkomt. Dat veendeel telde tot 26 augustus 2026 helemaal niet mee, ook niet als water, doordat N04 in geen van beide vlaggen van NatuurType stond; dat is nu gerepareerd, dus meet opnieuw voordat je het areaal citeert.

																		Staat deze schakelaar uit, dan wordt dat water niet opgelegd: die cellen krijgen geen nieuw landgebruik, worden niet geleegd en tellen niet mee in de uitkoop- en sloopkosten. Ze gaan wel op slot, maar via het bouwregime van het landschapstype en niet via de oplegging. Aan zetten maakt de waterstroom gelijkwaardig aan de natuurstroom. Stond sinds 2 juli 2026 uit als uitgecommentarieerde regel; nu een schakelaar, zodat het verschil te meten is.";
	attribute<ha>        MinimalLandAvailability_Landbouw:                 [0.60                               ,0.60                              ,0.60                               ,0.60                               ], Descr = "Minimale beschikbaarheid van land voor landbouw in ha per 100m cel.";
                                                                                                                                                                                                                          
	// Prijsmultipliers per gewas-categorie, per variant                                                                                                                                                                  
	// Basis: BAU = 1.0, andere varianten wijken af op basis van WLO-STOOM scenario                                                                                                                                       
	attribute<Ratio>     PriceMult_Melk:                                   [1.00                               ,1.00                              ,1.00                               ,1.00                               ];
	attribute<Ratio>     PriceMult_Granen:                                 [1.00                               ,1.00                              ,1.00                               ,1.00                               ];
	attribute<Ratio>     PriceMult_Aardappelen:                            [1.00                               ,1.00                              ,1.00                               ,1.00                               ];
	attribute<Ratio>     PriceMult_Bieten:                                 [1.00                               ,1.00                              ,1.00                               ,1.00                               ];
	attribute<Ratio>     PriceMult_Boomgaard:                              [1.00                               ,1.00                              ,1.00                               ,1.00                               ];
	attribute<Ratio>     PriceMult_Rietteelt:                              [1.00                               ,1.00                              ,1.00                               ,1.00                               ]; //paludi, e.g.: lisdodde, riet, veenmos, wilgen
	attribute<Ratio>     PriceMult_Exoten:                                 [1.00                               ,1.00                              ,1.00                               ,1.00                               ];
	attribute<Ratio>     PriceMult_Cranberry   := PriceMult_Exoten;                                                                                                                                                       
	attribute<Ratio>     PriceMult_Moerasbomen := PriceMult_Exoten;                                                                                                                                                       
	attribute<Ratio>     PriceMult_Rijst       := PriceMult_Exoten;                                                                                                                                                       
	attribute<Ratio>     PriceMult_Yacon       := PriceMult_Exoten;                                                                                                                                                       
                                                                                                                                                                                                                          
    // GLB basispremie-niveau per variant (EUR/ha/jr)                                                                                                                                                                     
    attribute<Eur_Ha_jaarlijks> GLB_Basispremie:                           [ 260                               , 260                              , 260                               , 260                               ];
                                                                                                                                                                                                                           
    // Aandeel van boeren dat mee doet aan eco-regelingen                                                                                                                                                                  
    attribute<Ratio>            GLB_EcoRegeling_Fractie_Goud:              [ 0.20                              , 0.20                             , 0.20                              , 0.20                              ];
    attribute<Ratio>            GLB_EcoRegeling_Fractie_Zilver:            [ 0.30                              , 0.30                             , 0.30                              , 0.30                              ];
    attribute<Ratio>            GLB_EcoRegeling_Fractie_Brons:             [ 0.25                              , 0.25                             , 0.25                              , 0.25                              ];
                                                                                                                                                                                                                          
    // Uitkering per niveau (stijgt in Transformeren vanwege zwaardere eisen maar hogere beloning)                                                                                                                        
    attribute<Eur_Ha_jaarlijks> GLB_EcoRegeling_Bedrag_Goud:               [ 200                               , 200                              , 200                               , 200                               ];
    attribute<Eur_Ha_jaarlijks> GLB_EcoRegeling_Bedrag_Zilver:             [ 100                               , 100                              , 100                               , 100                               ];
    attribute<Eur_Ha_jaarlijks> GLB_EcoRegeling_Bedrag_Brons:              [  60                               ,  60                              ,  60                               ,  60                               ];
                                                                                                                                                                                                                          
    // ANLb veenweiden (veelvoud van BIS, alleen op veengrond)                                                                                                                                                            
    attribute<Eur_Ha_jaarlijks> ANLb_veen_Bedrag:                          [ 300                               , 300                              , 300                               , 300                               ];
    attribute<Ratio>            ANLb_veen_Fractie:                         [ 0.10                              , 0.10                             , 0.10                              , 0.10                              ];
                                                                                                                                                                                                                          
////////////////////////////////////////////////////////////////////////////////////// Waterretentie stad ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// bestaand/resterend in/uit basisjaar                                                                                                                                                                                                                          
	attribute<float32_t> FractieGroenDakBestaandeBouwIn2050:               [0.30                               ,0.30                              ,0.00                               ,0.00                               ], Descr = "Aandeel van bestaande daken die groen kunnen worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieBlauwDakBestaandeBouwIn2050:               [0.00                               ,0.00                              ,1.00                               ,0.70                               ], Descr = "Aandeel van bestaande daken dat blauw kan worden gemaakt (bestaand ruimtegebruik). Hoort bij FractieGroenDakBestaandeBouwIn2050 hierboven: in de NbS-varianten gaat het dak van groen naar blauw, en die twee rijen tellen samen op tot het aandeel bewerkte daken. Deze rij stond tot #714 uitgecommentarieerd terwijl de groene rij in de NbS-varianten al op nul was gezet, waardoor het dakenaanbod daar op exact nul uitkwam. Een blauw dak bergt 0,10 m3 per m2 tegen 0,01 voor een groen dak (Classifications/WaterretentieK), dus dat scheelt een orde van grootte in het aanbod.";//
	attribute<float32_t> FractieWaterretentieCapaciteitHalfVerharding:     [0.01                               ,0.01                              ,0.50                               ,0.50                               ], Descr = "Aandeel van betreffend verhard oppervlak dat halfverhard kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitHolleWeg:           [0.10                               ,0.10                              ,0.30                               ,0.30                               ], Descr = "Aandeel van betreffend verhard oppervlak (wegen) dat 'hol' kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitWadi:               [0.10                               ,0.10                              ,0.50                               ,0.50                               ], Descr = "Aandeel van betreffend groen oppervlak dat wadi kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitDoorlatendGroen:    [0.00                               ,0.00                              ,0.00                               ,0.00                               ], Descr = "Aandeel van betreffend groen oppervlak dat wadi kan worden gemaakt (bestaand ruimtegebruik)";//
	attribute<float32_t> FractieWaterretentieCapaciteitBergingOpWater:     [0.00                               ,0.00                              ,0.00                               ,0.00                               ], Descr = "Aandeel van betreffend groen oppervlak dat wadi kan worden gemaakt (bestaand ruimtegebruik)";//
//	nieuwbouw                                                                                                                                                                                                                      
	attribute<float32_t> FractieGroenDakNieuwbouw:                         [0.30                               ,0.30                              ,0.00                               ,0.00                               ], Descr = "Aandeel van nieuwe daken die groen kunnen worden aangelegd"; //
	attribute<float32_t> FractieBlauwDakNieuwbouw:                         [0.00                               ,0.00                              ,1.00                               ,0.70                               ], Descr = "Aandeel van nieuwe daken die groen kunnen worden aangelegd"; //
	attribute<float32_t> FractieHalfverhardingNieuwbouwUitgeefbaar:        [0.10                               ,0.10                              ,0.30                               ,0.30                               ], Descr = "Aandeel van nieuw verhard oppervlak in uitgeefbaar gebied dat halfverhard kan worden aangelegd"; //
	attribute<float32_t> FractieHalfverhardingNieuwbouwOpenbaar:           [0.10                               ,0.10                              ,0.50                               ,0.50                               ], Descr = "Aandeel van nieuw verhard oppervlak in openbaar gebied dat halfverhard kan worden aangelegd"; //
	attribute<float32_t> FractieWadiNieuwbouwUitgeefbaarGras:              [0.05                               ,0.05                              ,0.30                               ,0.30                               ], Descr = "Aandeel van nieuw groen oppervlak in uitgeefbaar gebied dat als wadi kan worden aangelegd"; //
	attribute<float32_t> FractieWadiNieuwbouwOpenbaarGras:                 [0.10                               ,0.10                              ,0.50                               ,0.50                               ], Descr = "Aandeel van nieuw groen oppervlak in openbaar gebied dat als wadi kan worden aangelegd"; //
	attribute<float32_t> FractieDoorlatendGroenNieuwbouw:                  [0.00                               ,0.00                              ,1.00                               ,1.00                               ], Descr = "Aandeel van nieuw groen oppervlak dat doorlatend kan worden aangelegd"; //
	attribute<float32_t> FractieBergingOpWaterNieuwbouw:                   [0.00                               ,0.00                              ,1.00                               ,1.00                               ], Descr = "Aandeel van nieuw wateroppervlak waarop extra kan worfden gebergd (via peilopzet)"; //
                                                                                                                                                                                                                          
////////////////////////////////////////////////////////////////////////////////////// WaterBerging veen ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	                                                                                                                                                                                                                      
	attribute<String>    EvidentBenutVariant_WaterBerging:                 ['BAU'                              ,'BAU'                             ,'BAU'                              ,'BAU'                              ], Descr = "Selectie van BBG-klassen die voor verblijfsrecretie als EvidentBenut gelden. Gegroepeerd per variant";
	attribute<string_t>  RestrictiesVariant_WaterBerging:                  ['ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'              ,'ZeerHardHardMiddel'               ,'ZeerHardHardMiddel'               ], Descr = "Geldende restricties: alleen (zeer) hard, of ook middel, zacht?";
	attribute<string_t>  StimuliVariant_WaterBerging:                      ['HardMiddel'                       ,'HardMiddel'                      ,'HardMiddel'                       ,'HardMiddel'                       ], Descr = "Geldende stimuli: alleen (zeer) hard, of ook middel, zacht?";
	attribute<float32_t> MinimumDichtheidToenameWaterberging:              [0.0                                ,0.0                               ,0.0                                ,0.0                                ], Descr = "Minimale dichtheidstoename (in % t.o.v. de waargenomen dichtheid) die nodig is om een locatie geschikt te maken voor landbouw. Wordt gebruikt om te voorkomen dat locaties met zeer lage dichtheden worden gealloceerd.";
	attribute<string_t>  WaterbergingClaimBron:                            ['BAU'                              ,'BAU2'                             ,'BAU2'                            ,'BAU2'                             ], Descr = "Welke door Deltares aangeleverde claimkolom deze variant gebruikt, zie ModelParameters/Waterberging/Claims. Geleverd zijn alleen BAU1 en BAU2; de NbS-varianten lenen de BAU2-reeks. Toegestane waarden: BAU (is BAU1 in de aanlevering) en BAU2.";
	attribute<bool_t>    WaterbergingOpBestaandWater:                      [FALSE                              ,FALSE                              ,TRUE                              ,TRUE                               ], Descr = "Wordt het peil in bestaand oppervlaktewater 15 cm opgezet? Zo ja, dan gebruikt de variant de kolommen OokBestaand_* en is de resterende opgave voor nieuwe berging kleiner. Loopt gelijk op met FractieBergingOpWaterNieuwbouw.";

	// Gewichten voor de waterberging-geschiktheid, zie /Templates/Suitabilities/Suitability_Zichtjaar_T/Waterberging.
	// De positieve gewichten tellen per variant bij voorkeur op tot 1.0; Weight_Wegzijging wordt als negatieve term afgetrokken.
	attribute<float32_t> Weight_Depth_Waterberging:                        [0.20                               ,0.20                              ,0.20                               ,0.20                               ], Descr = "Gewicht van de genormaliseerde waterdiepte (dieptekaart) in de waterberging-geschiktheid";
	attribute<float32_t> Weight_UAI_Waterberging:                          [0.10                               ,0.10                              ,0.10                               ,0.10                               ], Descr = "Gewicht van de inverse urban attractivity index in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Lake_Waterberging:                         [0.15                               ,0.15                              ,0.15                               ,0.15                               ], Descr = "Gewicht van de nabijheid van bestaande meren in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Peat_Waterberging:                         [0.35                               ,0.35                              ,0.35                               ,0.35                               ], Descr = "Gewicht van de nabijheid van veengebieden in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Kwel_Waterberging:                         [0.20                               ,0.20                              ,0.20                               ,0.20                               ], Descr = "Gewicht van kwel (afgekapt en geschaald 0..1) in de waterberging-geschiktheid";
	attribute<float32_t> Weight_Wegzijging_Waterberging:                   [0.20                               ,0.20                              ,0.20                               ,0.20                               ], Descr = "Gewicht van wegzijging (afgekapt en geschaald 0..1); wordt als negatieve term van de waterberging-geschiktheid afgetrokken";
                                                                                                                                                                                                                          
////////////////////////////////////////////////////////////////////////////////////// Natuur ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	                                                                                                                                                                                                                      
	attribute<String>    NDVI_variant_ref:                                 ['mid'                              ,'mid'                             ,'max'                              ,'max'                              ], Descr = "Het NDVI-bereik per landgebruiksklasse is een bandbreedte, geen exacte waarde; de werkelijke NDVI hangt o.a. af van natuurkwaliteit, seizoen en beheer. Daarom worden min-, mid- en max-varianten doorgerekend";
}