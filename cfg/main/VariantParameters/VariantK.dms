	attribute<string_t>  TurbineType:                                      ['WT4000_120'                       ,'WT4000_120'                      ,'WT4000_120'                       ,'WT4000_120'                       ], Descr = "Type windturbine dat wordt toegepast. WT4000_120 = 4MW, 120m ashoogte; WT5000_120 = 5MW, 120m ashoogte; WT5000_100 = 5MW, 100m ashoogte";
	attribute<GW>        NationaalVermogenWindOpLandEnBinnenwater2060:     [10.00                              ,10.00                             ,10.00                              ,10.00                              ], Descr = "Nationaal vermogen wind op land en binnenwater in 2060";
