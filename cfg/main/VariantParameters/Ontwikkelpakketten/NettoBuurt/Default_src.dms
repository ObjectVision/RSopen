		 'NuanceerdHNLLaagSH'  ,'EG','SH','148','5','1', '0','0.5','0.5','0.5','0.16','0.08','vrijstaand'      ,'0.06','0.04','0.66','0.71','0.28','0.25','0.30','0.45','0.10','0.30','0.45','0.10', '0.16','null','1','Hoog_NL',     '3',
		 'NuanceerdHNLMiddenSH','EG','SH','121','4','1', '0','0.5','0.5','0.5','0.53','0.21','rijtjeswoning'   ,'0.04','0.02','0.64','0.74','0.31','0.28','0.30','0.38','0.10','0.30','0.38','0.10', '0.42','null','1','Hoog_NL',     '2',
		 'NuanceerdHNLHoogSH'  ,'MG','SH', '91','3','1', '0','0.5','0.5','0.5','0.63','0.13','appartement'     ,'0.07','0.04','0.61','0.68','0.32','0.28','0.30','0.30','0.10','0.30','0.30','0.10', '0.13','null','1','Hoog_NL',     '1'
		];
	}
	
	attribute<String>               name                   := Elements/Text[value(uint32(id(.))* nrAttr +  0, Elements)], Descr = "De naam van het ontwikkelpakket";
	attribute<String>               WP2_name_short         := Elements/Text[value(uint32(id(.))* nrAttr +  1, Elements)], Descr = "De WP2 classificatie van het ontwikkelpakket, verkorte naam";
	attribute<String>               VSSH_name_short        := Elements/Text[value(uint32(id(.))* nrAttr +  2, Elements)], Descr = "De VSSH classificatie van het ontwikkelpakket, verkorte naam";
	attribute<Woonoppervlak_Woning> Woonoppervlakte_woning := Elements/Text[value(uint32(id(.))* nrAttr +  3, Elements)][Woonoppervlak_Woning], Descr = "De gemiddelde woonoppervlakte per woning in m2 gebruiksoppervlak (GBO); via de vormfactor om te rekenen naar BVO (zie BVOPerWoning)";
	attribute<UInt32>               Aant_kamers            := Elements/Text[value(uint32(id(.))* nrAttr +  4, Elements)][uint32], Descr = "Het gemiddelde aantal kamers per woning";
	attribute<UInt32>               Aant_badkamers         := Elements/Text[value(uint32(id(.))* nrAttr +  5, Elements)][uint32], Descr = "Het gemiddelde aantal badkamers per woning";
	attribute<Bool>                 HeeftPriveParkeren     := Elements/Text[value(uint32(id(.))* nrAttr +  6, Elements)][bool], Descr = "Geeft aan of er bij de woningen in dit ontwikkelpakket sprake is van privé parkeermogelijkheden (op eigen terrein)";
	
	// Wegingsfactoren ten aanzien van centraliteit/bereikbaarheid en de nabijheid van amenities (Voorzieningen).
	attribute<Float32>              Weging_NatNiv      := Elements/Text[value(uint32(id(.))* nrAttr +  7, Elements)][float32], Descr = "Wegingsfactor voor de invloed van nationale niveaus (proxy voor Randstad-NietRandstad) op de woningprijs";
	attribute<Float32>              Weging_NatOV       := Elements/Text[value(uint32(id(.))* nrAttr +  8, Elements)][float32], Descr = "Wegingsfactor voor de invloed van nationale OV (proxy voor grotere steden) op de woningprijs";
	attribute<Float32>              Weging_Amenities   := Elements/Text[value(uint32(id(.))* nrAttr +  9, Elements)][float32], Descr = "Wegingsfactor voor de invloed van de nabijheid van amenities (voorzieningen) op de woningprijs";
	
	attribute<FSI>                  FloorSpaceIndex    := Elements/Text[value(uint32(id(.))* nrAttr + 10, Elements)][FSI], Descr = "De Floor Space Index (FSI) van het ontwikkelpakket, oftewel de verhouding tussen de totale vloeroppervlakte van alle gebouwen en de terreinoppervlakte van de netto buurt";
	attribute<GSI>                  GroundSpaceIndex   := Elements/Text[value(uint32(id(.))* nrAttr + 11, Elements)][GSI], Descr = "De Ground Space Index (GSI) van het ontwikkelpakket, oftewel de verhouding tussen de footprint van alle gebouwen en de terreinoppervlakte van de netto buurt";
	attribute<String>               WP4_name           := Elements/Text[value(uint32(id(.))* nrAttr + 12, Elements)], Descr = "De WP4 classificatie van het ontwikkelpakket, volledige naam";
	
	attribute<Classifications/Vastgoed/WP4> WP4_rel := rlookup(lowercase(WP4_name), lowercase(/Classifications/Vastgoed/WP4/name)), Descr = "De WP4 classificatie van het ontwikkelpakket";
	
	parameter<UInt32> nrAttr := 30;

	unit<uint8> InUitgeefbaarExPandFootprint := ., Descr = "De inrichting van het uitgeefbaar deel van de netto buurt exclusief de footprint van de panden"
	{
		// De check zit op Verhard omdat die in elke run wordt bijgewerkt, maar toetst de hele rij: verhard,
		// groen, water en bruin moeten samen de buitenruimte vullen. Pakketten zonder private buitenruimte
		// (FractieUitgeefbaar == GroundSpaceIndex, zie TuinDoel 0) zijn uitgezonderd: daar staan de fracties
		// op 0 omdat er niets te verdelen valt.
		attribute<Float32> Verhard  := Elements/Text[value(uint32(id(..))* nrAttr + 13, Elements)][float32]
		, IntegrityCheck = "all(!(FractieUitgeefbaar > GroundSpaceIndex) || abs(add(this, Groen, Water, Bruin) - 1f) < 0.005f)";
		attribute<Float32> Groen    := Elements/Text[value(uint32(id(..))* nrAttr + 15, Elements)][float32];
		attribute<Float32> Water    := Elements/Text[value(uint32(id(..))* nrAttr + 17, Elements)][float32];
		attribute<Float32> Boom0    := Elements/Text[value(uint32(id(..))* nrAttr + 19, Elements)][float32];
		attribute<Float32> Gras0    := Elements/Text[value(uint32(id(..))* nrAttr + 20, Elements)][float32];
		attribute<Float32> Struik0  := Elements/Text[value(uint32(id(..))* nrAttr + 21, Elements)][float32];
		attribute<Float32> Groen0   := add(Boom0, Gras0, Struik0);
		
		attribute<Float32> Bruin    := const(0f, ..); // Werd niet ingeschat door WR. TODO toevoegen
		
		//Schalen omdat groen Totaal bij nader inzien moest optellen tot fractie groen
		attribute<Float32> Boom    := Boom0   / Groen0 * Groen;
		attribute<Float32> Gras    := Gras0   / Groen0 * Groen;
		attribute<Float32> Struik  := Struik0 / Groen0 * Groen;
	}
	
	unit<uint8> InOpenbaar := ., Descr = "De inrichting van het openbare deel van de netto buurt"
	{
		// Zelfde check als bij InUitgeefbaarExPandFootprint, maar zonder uitzondering: openbaar gebied is
		// Terrein * (1 - FractieUitgeefbaar) en dat is bij elk pakket groter dan nul.
		attribute<Float32> Verhard  := Elements/Text[value(uint32(id(..))* nrAttr + 14, Elements)][float32]
		, IntegrityCheck = "all(abs(add(this, Groen, Water, Bruin) - 1f) < 0.005f)";
		attribute<Float32> Groen    := Elements/Text[value(uint32(id(..))* nrAttr + 16, Elements)][float32];
		attribute<Float32> Water    := Elements/Text[value(uint32(id(..))* nrAttr + 18, Elements)][float32];
		attribute<Float32> Boom0    := Elements/Text[value(uint32(id(..))* nrAttr + 22, Elements)][float32];
		attribute<Float32> Gras0    := Elements/Text[value(uint32(id(..))* nrAttr + 23, Elements)][float32];
		attribute<Float32> Struik0  := Elements/Text[value(uint32(id(..))* nrAttr + 24, Elements)][float32];
		attribute<Float32> Groen0   := add(Boom0, Gras0, Struik0);
		
		attribute<Float32> Bruin    := const(0f, ..); // Werd niet ingeschat door WR. TODO toevoegen
		
		//Schalen omdat groen Totaal bij nader inzien moest optellen tot fractie groen
		attribute<Float32> Boom    := Boom0   / Groen0 * Groen;
		attribute<Float32> Gras    := Gras0   / Groen0 * Groen;
		attribute<Float32> Struik  := Struik0 / Groen0 * Groen;
	}
	
	attribute<string>    FractieUitgeefbaar0  := Elements/Text[value(uint32(id(.))* nrAttr +  25, Elements)], Descr = "De fractie van de terreinoppervlakte die uitgeefbaar wordt gemaakt";
	attribute<string>    TuinDoel0            := Elements/Text[value(uint32(id(.))* nrAttr +  26, Elements)], Descr = "Doeltuin: de beoogde private buitenruimte per woning in m2, exclusief de voetafdruk van de woning. 'null' = niet opgegeven, dan geldt de FractieUitgeefbaar-kolom. 0 = geen private buitenruimte, uitgeefbaar is dan exact de gebouwvoetafdruk; dat is de conventie bij appartementen, waar de InUitgeefbaar-fracties op 0 staan en FractieUitgeefbaar dus de GSI moet volgen.";
	attribute<Bool>      HeeftTuinDoel        := TuinDoel0 != 'null', Descr = "Geeft aan of voor dit ontwikkelpakket een doeltuin is opgegeven; zo ja, dan wordt FractieUitgeefbaar daaruit afgeleid in plaats van uit de FractieUitgeefbaar-kolom.";
	attribute<m2_Woning> TuinDoel             := replace(TuinDoel0, 'null', '0')[m2_Woning], Descr = "De doeltuin per woning in m2 (0 waar geen doeltuin is opgegeven, zie HeeftTuinDoel).";
	attribute<m2_Woning> Tuin                 := BVOPerWoning * (FractieUitgeefbaar - GroundSpaceIndex) / FloorSpaceIndex;

	// #618: de tuin is Terrein * (FractieUitgeefbaar - GSI), per woning dus BVOPerWoning * (FU - GSI) / FSI.
	// Omgekeerd levert een gewenste tuin de benodigde FractieUitgeefbaar: FU = GSI + FSI * tuin / BVOPerWoning.
	// Zo staat de ontwerpkeuze (hoeveel tuin) in de tabel en niet de afgeleide fractie. BVOPerWoning volgt uit Woonoppervlakte_woning en Vormfactor, en die uit FSI en GSI.
	attribute<float32> FractieUitgeefbaar                      :=
		HeeftTuinDoel
			? GroundSpaceIndex[float32] + FloorSpaceIndex[float32] * TuinDoel[float32] / BVOPerWoning[float32]
			: replace(FractieUitgeefbaar0, 'null', string(ModelParameters/Wonen/DefaultFractieUitgeefbaar))[float32]
	, IntegrityCheck = "all(!(GroundSpaceIndex > this)) && all(WP2_rel != Vastgoed/WP2/V/eengezins || this > GroundSpaceIndex)"
	, Descr = "De fractie van de terreinoppervlakte die uitgeefbaar wordt gemaakt, afgeleid uit TuinDoel waar die is opgegeven. Moet bij eengezinspakketten strikt groter zijn dan de GSI, anders is de tuin 0 en valt de lnlotsize-term uit de nieuwbouwprijs (#618); zie Checks.";
	
	attribute<Bool> IsNbSOP                                    := Elements/Text[value(uint32(id(.))* nrAttr +  27, Elements)][bool], Descr = "Geeft aan of het een ontwikkelpakket met Nature based Solutions (NbS) is, met veel groen en/of water bijv, tbv gezondheid etc.";
	attribute<string> NbSOPToepassingsgebied_ref               := Elements/Text[value(uint32(id(.))* nrAttr +  28, Elements)]
	, IntegrityCheck = "all(this == 'Overal' || this == 'Laag_NL' || this == 'Hoog_NL')"
	, Descr = "Geeft aan voor welk gebied dit ontwikkelpakket bedoeld is, Hoog NL, Laag NL of overal. De IntegrityCheck bewaakt de kolomindex: bij het invoegen van een kolom in de tabel moeten de indices hierna meeschuiven, wat bij de doeltuin-kolom (#618) is misgegaan en IsNbSOP stil op FALSE zette.";
	attribute<Classifications/Modellering/BouwwijzeK> Bouwwijze := Elements/Text[value(uint32(id(.))* nrAttr +  29, Elements)][Classifications/Modellering/BouwwijzeK]
	, IntegrityCheck = "all(IsDefined(this))"
	, Descr = "Geeft aan welke overstromingsmaatregel in het  ontwikkelpakket worden getroffen; de IntegrityCheck bewaakt de kolomindex (zie NbSOPToepassingsgebied_ref).";
	
	attribute<Bool> IsHoogbouw := Bouwlagen * ModelParameters/Wonen/Bouwlaaghoogte > ModelParameters/Wonen/Hoogbouwgrens, Descr = "Geeft aan of het ontwikkelpakket als hoogbouw wordt beschouwd (meer dan X bouwlagen)";
	
	// is per definitie de fractie uitgeefbaar van terreinopp nettobuurt
	attribute<Float32>                 Bouwlagen                    := FloorSpaceIndex / GroundSpaceIndex, Descr = "Het gemiddeld aantal bouwlagen van de woningen in het ontwikkelpakket";
	attribute<Woonoppervlak_m2BVO>     Vormfactor                   := WP2_rel == Classifications/Vastgoed/WP2/V/Eengezins ? ModelParameters/Wonen/VormfactorEengezins: IsHoogbouw ? ModelParameters/Wonen/VormfactorHoogbouw: ModelParameters/Wonen/VormfactorMeergezins, Descr = "De vormfactor: verhouding gebruiksoppervlak (GBO) per m2 bruto vloeroppervlak (BVO), afhankelijk van het woningtype en of het hoogbouw betreft";
	attribute<m2BVO_Woning>            BVOPerWoning                 := Woonoppervlakte_woning / Vormfactor, Descr = "Het gemiddelde bruto vloeroppervlak (BVO) per woning in m2, afgeleid van de Woonoppervlakte_woning (GBO) en de vormfactor (GBO/BVO)";
	attribute<Woning_ha>               Dichtheid                    := (FloorSpaceIndex * Terreinoppervlakte) / BVOPerWoning / Terreinoppervlakte[ha], Descr = "De dichtheid van het ontwikkelpakket in woningen per hectare, afgeleid van de FSI en het BVO per woning";
	attribute<Woonoppervlak_ha>        Woonoppervlakte              := (Dichtheid[float32] * Woonoppervlakte_woning[float32])[Woonoppervlak_ha], Descr = "De woonoppervlakte per hectare in de netto buurt, afgeleid van de dichtheid en de woonoppervlakte per woning";
	
	container Checks
	{
		attribute<Bool> GSIIsNietGroterDanFractieUitgeefbaar (..) := !(GroundSpaceIndex > FractieUitgeefbaar);
		
		// #618: bij FractieUitgeefbaar == GroundSpaceIndex is Buitenruimte (= Terrein * (FU - GSI)) exact 0 en dus ook
		// Tuinoppervlakte. Woningwaarde.dms kapt dat af op 1 m2, log(1) = 0, waardoor de hele lnlotsize-term uit de
		// nieuwbouwprijs valt. Voor eengezinswoningen draagt lnlotsize een coefficient (vrijstaand 0.090, rijtjeswoning
		// 0.020, twee_onder_1_kap 0.027) en is een tuin van 0 dus een prijsartefact; bij appartementen kent de
		// NVM-schatting geen lnlotsize, daar mag FU == GSI wel. De check hierboven toetst op '>' en laat gelijkheid door.
		attribute<Bool> EengezinsHeeftPriveBuitenruimte (..) := WP2_rel != Vastgoed/WP2/V/eengezins || FractieUitgeefbaar > GroundSpaceIndex;
	}
	
	attribute<String>            Label                := name, DialogType = "LabelText";
	attribute<Vastgoed/WP2>      WP2_rel              := lowercase(WP2_name_short) == lowercase('EG') ? rlookup(lowercase('eengezins'), lowercase(Vastgoed/WP2/name)) : rlookup(lowercase('meergezins'), lowercase(Vastgoed/WP2/name));
	attribute<String>            WP2_name             := Vastgoed/WP2/name[WP2_rel];
	attribute<Vastgoed/VSSH>     VSSH_rel             := lowercase(VSSH_name_short) == lowercase('VS') ? rlookup(lowercase('vrijeSector'), lowercase(Vastgoed/VSSH/name)) : rlookup(lowercase('SocialeHuur'), lowercase(Vastgoed/VSSH/name));
	attribute<String>            VSSH_name            := Vastgoed/VSSH/name[VSSH_rel];
	attribute<String>            WP2xVSSH_name        := WP2_name+'_'+VSSH_name;
	attribute<Vastgoed/WP2xVSSH> WP2xVSSH_rel         := rlookup(lowercase(WP2xVSSH_name), lowercase(Vastgoed/WP2xVSSH/name));
	attribute<Actor/Sector/xSubsector> SectorxSubSector_rel := Vastgoed/WP2xVSSH/SectorxSubSector_rel[WP2xVSSH_rel];
	
	container perWP2xVSSH := for_each_ne(Vastgoed/WP2xVSSH/name,'perWP2xVSSH_T('+quote(Vastgoed/WP2xVSSH/name)+', ..)');
	container perWP2      := for_each_ne(Vastgoed/WP2/name,'perWP2_T('+quote(Vastgoed/WP2/name)+', ..)');
	
	attribute<UInt32> BrushColor:
	[
		rgb(102,   0, 102),
		rgb(153,   0, 153),
		rgb(204,   0, 204),
		rgb(255,   0, 255),
		rgb(204,   0,   0),
		rgb(255,   0,   0),
		rgb(255,  51,  51),
		rgb(255, 102, 102),
		rgb(255, 153, 153),
		rgb(255, 204, 204),
		rgb(102,   0,  51),
		rgb(153,   0,  76),
		rgb(204,   0, 102),
		rgb(255,   0, 127),
		rgb(153,  76,   0),
		rgb(155, 128,   0),
		rgb(255,  51,  51),
		rgb(255, 102, 102),
		rgb(255, 153, 153),
		rgb(255, 204, 204),
		rgb(102,   0,  51),
		rgb(153,   0,  76),
		rgb(204,   0, 102),
		rgb(255,   0, 127),
		rgb(153,  76,   0),
		rgb(155, 128,   0),
		rgb(255,  51,  51),
		
		rgb(153, 255,  51),
		rgb( 51, 255,  76),
		rgb(  0, 204, 102),
		rgb(  0, 153, 127),
		// rgb(  0, 153, 127),
		// rgb(  0, 153, 127),
		
		rgb(255, 255, 102),
		rgb(204, 204,   0),
		rgb(153, 153,   0),
		// rgb(153, 153,   0),
		// rgb(153, 153,   0),
		
		rgb(153, 255,  51),
		rgb( 51, 255,  76),
		rgb(  0, 204, 102),
		rgb(  0, 153, 127),
		// rgb(  0, 153, 127),
		// rgb(  0, 153, 127),
		
		rgb(255, 255, 102),
		rgb(204, 204,   0),
		rgb(153, 153,   0),
		// rgb(153, 153,   0),
