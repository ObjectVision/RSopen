		rgb(255,  51,  51), // DorpsMGVS
		rgb(255, 102, 102), // StedelijkerEGVS
		rgb(255, 153, 153), // StedelijkEGVS
		rgb(255, 204, 204), // LaagStedelijkEGVS
		rgb(102,   0,  51), // LagerStedelijkEGVS
		rgb(153,   0,  76), // DorpsLandelijkEGVS
		rgb(204,   0, 102), // DorpsLandLaagEGVS
		rgb(255,   0, 127), // TinyHousesEGVS
		rgb(153,  76,   0), // TinyHousesLaagEGVS
		rgb(155, 128,   0), // SuperStedelijkMGSH
		rgb(255,  51,  51), // HoogStedelijkMGSH
		rgb(255, 102, 102), // StedelijkerMGSH
		rgb(255, 153, 153), // StedelijkMGSH
		rgb(255, 204, 204), // LaagStedelijkMGSH
		rgb(102,   0,  51), // LagerStedelijkMGSH
		rgb(153,   0,  76), // DorpsMGSH
