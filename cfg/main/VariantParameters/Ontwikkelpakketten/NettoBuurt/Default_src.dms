unit<UInt8> KleurenOP : NrOfRows = 66
, Descr = "De kaartkleur per pakketnaam, voor alle sets samen. Op naam en niet op rijnummer, zodat een pakket in Default en in een variantset dezelfde kleur draagt en de sets vrij kunnen groeien. Nieuwe pakketten horen hier een rij bij te krijgen; zonder rij kleurt het pakket zwart (zie OPTabel_T/OP/BrushColor)."
{
	attribute<String> name:
	[
		'SuperStedelijkMGVS', 'HoogStedelijkMGVS', 'StedelijkerMGVS', 'StedelijkMGVS',
		'LaagStedelijkMGVS', 'LagerStedelijkMGVS', 'DorpsMGVS', 'StedelijkerEGVS',
		'StedelijkEGVS', 'LaagStedelijkEGVS', 'LagerStedelijkEGVS', 'DorpsLandelijkEGVS',
		'DorpsLandLaagEGVS', 'TinyHousesEGVS', 'TinyHousesLaagEGVS', 'SuperStedelijkMGSH',
		'HoogStedelijkMGSH', 'StedelijkerMGSH', 'StedelijkMGSH', 'LaagStedelijkMGSH',
		'LagerStedelijkMGSH', 'DorpsMGSH', 'StedelijkerEGSH', 'StedelijkEGSH',
		'LaagStedelijkEGSH', 'LagerStedelijkEGSH', 'DorpsLandelijkEGSH', 'MaxLNLLaagGroenEGVS',
		'MaxLNLLaagBlauwEGVS', 'MaxLNLMiddenEGVS', 'MaxLNLHoogMGVS', 'MaxHNLLaagEGVS',
		'MaxHNLMiddenEGVS', 'MaxHNLHoogMGVS', 'MaxLNLLaagGroenEGSH', 'MaxLNLLaagBlauwEGSH',
		'MaxLNLMiddenEGSH', 'MaxLNLHoogMGSH', 'MaxHNLLaagEGSH', 'MaxHNLMiddenEGSH',
		'MaxHNLHoogMGSH', 'NuanceerdLNLLaagEGVS', 'NuanceerdLNLMiddenEGVS', 'NuanceerdLNLHoogMGVS',
		'NuanceerdHNLLaagEGVS', 'NuanceerdHNLMiddenEGVS', 'NuanceerdHNLHoogMGVS', 'NuanceerdLNLLaagEGSH',
		'NuanceerdLNLMiddenEGSH', 'NuanceerdLNLHoogMGSH', 'NuanceerdHNLLaagEGSH', 'NuanceerdHNLMiddenEGSH',
		'NuanceerdHNLHoogMGSH', 'NuanceerderLNLLaagEGVS', 'NuanceerderLNLMiddenEGVS', 'NuanceerderLNLHoogMGVS',
		'NuanceerderHNLLaagEGVS', 'NuanceerderHNLMiddenEGVS', 'NuanceerderHNLHoogMGVS', 'NuanceerderLNLLaagEGSH',
