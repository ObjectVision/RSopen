		rgb(255,   0, 255), // StedelijkMGVS
		rgb(204,   0,   0), // LaagStedelijkMGVS
		rgb(255,   0,   0), // LagerStedelijkMGVS
		rgb(255,  51,  51), // DorpsMGVS
		rgb(255, 102, 102), // StedelijkerEGVS
		rgb(255, 153, 153), // StedelijkEGVS
