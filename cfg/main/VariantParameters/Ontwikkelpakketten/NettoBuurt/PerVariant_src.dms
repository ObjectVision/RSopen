		 'NuanceerderLNLHoogMGVS'  ,'MG','VS', '91','3','1', '1','1.0','1.0','1.0','0.63','0.13','appartement'     ,'0.04','0.04','0.57','0.57','0.39','0.39','0.30','0.30','0.10','0.30','0.30','0.10','0.40','null','0', '1', 'Laag_NL',     ';GeenMaatregelen;GebouwMaatregelen;Opgehoogd;',
