		 'NuanceerderLNLLaagEGVS'  ,'EG','VS','148','5','1', '1','1.0','1.0','1.0','0.16','0.08','vrijstaand'      ,'0.04','0.04','0.62','0.60','0.34','0.36','0.20','0.45','0.10','0.20','0.45','0.10','0.40','null','0', '1', 'Laag_NL',     ';GeenMaatregelen;GebouwMaatregelen;Opgehoogd;OpPalen;Drijvend;',
