// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Definitie van de tredes voor de werksectoren op basis van plancapaciteit, stimuli, maatregelen, eigendom en
// grondgebruik. Per model variant.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Werken : using = "impl"
, Descr = "Definitie van de tredes voor de werksectoren op basis van plancapaciteit, stimuli, maatregelen, eigendom en grondgebruik. Per model variant."
{
	container Logistiek              := Nijverheid;
	container Detailhandel           := Overigen;
	container Ov_consumentendiensten := Overigen;
	container Zak_dienstverlening    := Overigen;
	container Overheid_kw_diensten   := Overigen;
	
	container Nijverheid
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(PlancapaciteitPlusStimuli, GrondGebruikK)
		{
			attribute<String> PlancapaciteitPlusStimuli_name := PlancapaciteitPlusStimuli/name[first_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[second_rel];
			attribute<String> name := PlancapaciteitPlusStimuli_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli/RefSrc[first_rel]+' && '+
				GrondGebruikK/RefSrc[second_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OverstromingsMaatregelK, EigendomVarianten/Transformeren_Nijverheid, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[second_rel];
			attribute<String> OverstromingsMaatregelK_name        := OverstromingsMaatregelK/name[third_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren_Nijverheid/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+PlanCapaciteitZ_name+'_'+OverstromingsMaatregelK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[second_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[third_rel]+' && '+
				EigendomVarianten/Transformeren_Nijverheid/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, OverstromingsMaatregelK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, EigendomVarianten/Transformeren_Nijverheid, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> OverstromingsMaatregelK_name        := OverstromingsMaatregelK/name[second_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[third_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren_Nijverheid/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+OverstromingsMaatregelK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[second_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[third_rel]+' && '+
				EigendomVarianten/Transformeren_Nijverheid/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
		unit<UInt32> NbSGenuanceerd := BAU;
		
		unit<UInt32> NbSMaxOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, OverstromingsMaatregelK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> OverstromingsMaatregelK_name := OverstromingsMaatregelK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+OverstromingsMaatregelK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerdOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, OverstromingsMaatregelK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> OverstromingsMaatregelK_name := OverstromingsMaatregelK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+OverstromingsMaatregelK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> OO := combine(Plancapaciteit_Varianten/Totaal, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal/name[first_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[second_rel];
			attribute<String> name                := PlanCapaciteit_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
				'('+
					Plancapaciteit_Varianten/Totaal/RefSrc[first_rel]+' && '+
					GrondGebruikK/RefSrc[second_rel]+
				')';
		}
		
		unit<UInt32> GR := combine(Plancapaciteit_Varianten/Totaal, OverstromingsMaatregelK, EigendomVarianten/Transformeren_Nijverheid, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal/name[first_rel];
			attribute<String> OverstromingsMaatregelK_name     := OverstromingsMaatregelK/name[second_rel];
			attribute<String> EigendomK_name      := EigendomVarianten/Transformeren_Nijverheid/name[third_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[fourth_rel];
			attribute<String> name                := PlanCapaciteit_name+'_'+OverstromingsMaatregelK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/Totaal/RefSrc[first_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[second_rel]+' && '+
				EigendomVarianten/Transformeren_Nijverheid/RefSrc[third_rel]+' && '+
				GrondGebruikK/RefSrc[fourth_rel]+
			')';
		}
	}
	
	container Overigen
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(PlancapaciteitPlusStimuli, BBGK, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		{
			attribute<String> PlancapaciteitPlusStimuli_name := PlancapaciteitPlusStimuli/name[first_rel];
			attribute<String> BBGK_name := BBGK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[third_rel];
			attribute<String> EigendomK_name := EigendomVarianten/BAU/name[fourth_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[fifth_rel];
			attribute<String> name := PlancapaciteitPlusStimuli_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli/RefSrc[first_rel]+' && '+
				BBGK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, BBGK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OverstromingsMaatregelK, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> BBGK_name              := BBGK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> OverstromingsMaatregelK_name        := OverstromingsMaatregelK/name[fifth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[sixth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[seventh_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+OverstromingsMaatregelK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				BBGK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[fifth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[sixth_rel]+' && '+
				GrondGebruikK/RefSrc[seventh_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, OverstromingsMaatregelK, BBGK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> OverstromingsMaatregelK_name        := OverstromingsMaatregelK/name[second_rel];
			attribute<String> BBGK_name              := BBGK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fifth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[sixth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[seventh_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+OverstromingsMaatregelK_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[second_rel]+' && '+
				BBGK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fifth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[sixth_rel]+' && '+
				GrondGebruikK/RefSrc[seventh_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
		unit<UInt32> NbSGenuanceerd := BAU;
		
		unit<UInt32> NbSMaxOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, OverstromingsMaatregelK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> OverstromingsMaatregelK_name        := OverstromingsMaatregelK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+OverstromingsMaatregelK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerdOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, OverstromingsMaatregelK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> OverstromingsMaatregelK_name        := OverstromingsMaatregelK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+OverstromingsMaatregelK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> GR := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, OVBereikbaarheidK, OverstromingsMaatregelK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[second_rel];
			attribute<String> OverstromingsMaatregelK_name := OverstromingsMaatregelK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> EigendomK_name := EigendomVarianten/Transformeren/name[fifth_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[sixth_rel];
			attribute<String> name := PlanCapaciteitH_name+'_'+OVBereikbaarheidK_name+'_'+OverstromingsMaatregelK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				OVBereikbaarheidK/RefSrc[second_rel]+' && '+
				OverstromingsMaatregelK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> OO := combine(Plancapaciteit_Varianten/Totaal, EigendomVarianten/Intensiveren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal/name[first_rel];
			attribute<String> EigendomK_name := EigendomVarianten/Intensiveren/name[second_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[third_rel];
			attribute<String> name := PlanCapaciteit_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
				'('+
					Plancapaciteit_Varianten/Totaal/RefSrc[first_rel]+' && '+
					EigendomVarianten/Intensiveren/RefSrc[second_rel]+' && '+
					GrondGebruikK/RefSrc[third_rel]+
				')';
		}
	}
}