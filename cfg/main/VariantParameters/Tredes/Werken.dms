//
// Definitie van de tredes voor de werksectoren op basis van plancapaciteit, stimuli, maatregelen, eigendom en
// grondgebruik. Per model variant.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Werken : using = "impl"
, Descr = "Definitie van de tredes voor de werksectoren op basis van plancapaciteit, stimuli, maatregelen, eigendom en grondgebruik. Per model variant."
{
	container Logistiek := Nijverheid;
	
	container Detailhandel
	: Descr = "Eigen tredetabel voor de verzorgende subsectoren (#668, vervolg): dezelfde assen als Overigen, met binnen de kom of de wijkrand als hoogste as. Zie ModelParameters/Werken/VerzorgendVolgtWoongebied."
	{
		unit<UInt32> WoongebiedK: NrOfRows = 2
		{
			attribute<String> name: ['BinnenWoongebiedOfKom', 'BuitenWoongebiedOfKom'];
			attribute<String> RefSrc := '@S@'+name;
		}
		
		unit<UInt32> GeenTredes := Overigen/GeenTredes;
		
		unit<UInt32> BAU := combine(WoongebiedK, PlancapaciteitPlusStimuli_PerSubsector, BBGK, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		{
			attribute<String> WoongebiedK_name := WoongebiedK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> BBG_name := BBGK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> EigendomK_name := EigendomVarianten/BAU/name[fifth_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[sixth_rel];
			attribute<String> name := WoongebiedK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+BBG_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				WoongebiedK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				BBGK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerd := combine(WoongebiedK, PlancapaciteitPlusStimuli_PerSubsector, BBGPlusKansrijkWoningbouw, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		{
			attribute<String> WoongebiedK_name := WoongebiedK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> BBGPlusKansrijk_name := BBGPlusKansrijkWoningbouw/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> EigendomK_name := EigendomVarianten/BAU/name[fifth_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[sixth_rel];
			attribute<String> name := WoongebiedK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+BBGPlusKansrijk_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				WoongebiedK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				BBGPlusKansrijkWoningbouw/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
	}
	
	container Ov_consumentendiensten := Detailhandel;
	
	container Zak_dienstverlening
	: Descr = "Eigen tredetabel voor kantoren (#668): dezelfde assen als Overigen, met bestaand kantoorgebied als hoogste as. Waar kantoor in het basisjaar de werkstand domineert, gaat de zaaglijn eerst; greenfield komt pas aan de beurt als de bestaande voorraad vol is of de regio geen dominante cellen heeft. Met KantoorVerdikkingInBestaand uit is de as leeg en gedraagt de tabel zich als Overigen."
	{
		unit<UInt32> BestaandKantoorK: NrOfRows = 2
		{
			attribute<String> name: ['BinnenBestaandKantoor', 'BuitenBestaandKantoor'];
			attribute<String> RefSrc := '@S@'+name;
		}
		
		unit<UInt32> GeenTredes := Overigen/GeenTredes;
		
		unit<UInt32> BAU := combine(BestaandKantoorK, PlancapaciteitPlusStimuli_PerSubsector, BBGK, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		{
			attribute<String> BestaandKantoorK_name := BestaandKantoorK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> BBGK_name := BBGK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> EigendomK_name := EigendomVarianten/BAU/name[fifth_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[sixth_rel];
			attribute<String> name := BestaandKantoorK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				BestaandKantoorK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				BBGK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
		unit<UInt32> NbSGenuanceerd := BAU;
	}
	container Overheid_kw_diensten   := Detailhandel;
	
	container Nijverheid
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(PlancapaciteitPlusStimuli_PerSubsector, GrondGebruikK)
		{
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[first_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[second_rel];
			attribute<String> name := PlancapaciteitPlusStimuli_PerSubsector_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[first_rel]+' && '+
				GrondGebruikK/RefSrc[second_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, BouwregimeK, EigendomVarianten/Transformeren_Nijverheid, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[second_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[third_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren_Nijverheid/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+PlanCapaciteitZ_name+'_'+BouwregimeK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				EigendomVarianten/Transformeren_Nijverheid/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, EigendomVarianten/Transformeren_Nijverheid, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[second_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[third_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren_Nijverheid/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[third_rel]+' && '+
				EigendomVarianten/Transformeren_Nijverheid/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
		unit<UInt32> NbSGenuanceerd := BAU;
		
		unit<UInt32> NbSMaxOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, SlappeBodemsK, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> BouwregimeK_name := BouwregimeK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerdOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, SlappeBodemsK, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> BouwregimeK_name := BouwregimeK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> OO := combine(Plancapaciteit_Varianten/Totaal_PerSubsector, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal_PerSubsector/name[first_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[second_rel];
			attribute<String> name                := PlanCapaciteit_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
				'('+
					Plancapaciteit_Varianten/Totaal_PerSubsector/RefSrc[first_rel]+' && '+
					GrondGebruikK/RefSrc[second_rel]+
				')';
		}
		
		unit<UInt32> GR := combine(Plancapaciteit_Varianten/Totaal_PerSubsector, BouwregimeK, EigendomVarianten/Transformeren_Nijverheid, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal_PerSubsector/name[first_rel];
			attribute<String> BouwregimeK_name     := BouwregimeK/name[second_rel];
			attribute<String> EigendomK_name      := EigendomVarianten/Transformeren_Nijverheid/name[third_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[fourth_rel];
			attribute<String> name                := PlanCapaciteit_name+'_'+BouwregimeK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/Totaal_PerSubsector/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				EigendomVarianten/Transformeren_Nijverheid/RefSrc[third_rel]+' && '+
				GrondGebruikK/RefSrc[fourth_rel]+
			')';
		}
	}
	
	container Overigen
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(PlancapaciteitPlusStimuli_PerSubsector, BBGK, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		{
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[first_rel];
			attribute<String> BBGK_name := BBGK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[third_rel];
			attribute<String> EigendomK_name := EigendomVarianten/BAU/name[fourth_rel];
			attribute<String> GrondGebruikK_name := GrondGebruikK/name[fifth_rel];
			attribute<String> name := PlancapaciteitPlusStimuli_PerSubsector_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[first_rel]+' && '+
				BBGK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, BBGK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, BouwregimeK, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> BBGK_name              := BBGK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[fourth_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[fifth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[sixth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[seventh_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+BouwregimeK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				BBGK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[fourth_rel]+' && '+
				BouwregimeK/RefSrc[fifth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[sixth_rel]+' && '+
				GrondGebruikK/RefSrc[seventh_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, BouwregimeK, BBGK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[second_rel];
			attribute<String> BBGK_name              := BBGK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[fifth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[sixth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[seventh_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BouwregimeK_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				BBGK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[fifth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[sixth_rel]+' && '+
				GrondGebruikK/RefSrc[seventh_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
		unit<UInt32> NbSGenuanceerd := BAU;
		
		unit<UInt32> NbSMaxOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, SlappeBodemsK, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
