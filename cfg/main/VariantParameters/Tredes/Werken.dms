////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Definitie van de tredes voor de werksectoren op basis van plancapaciteit, stimuli, bebouwd gebied, OV-bereikbaarheid,
// bouwregime en grondgebruik. Per model variant.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Werken : using = "impl"
, Descr = "Definitie van de tredes voor de werksectoren op basis van plancapaciteit, stimuli, bebouwd gebied, OV-bereikbaarheid, bouwregime en grondgebruik. Per model variant."
{
	container Logistiek := Nijverheid;
	
	container Detailhandel
	: Descr = "Eigen tredetabel voor de verzorgende subsectoren (#668, vervolg): dezelfde assen als de overige werksubsectoren, namelijk plancapaciteit met stimuli, bestaand bebouwd gebied, OV-bereikbaarheid en grondgebruik, met binnen de kom of de wijkrand als hoogste as (#710, Trede/BinnenWoongebiedOfKom)."
	{
		unit<UInt32> WoongebiedK: NrOfRows = 2
		{
			attribute<String> name: ['BinnenWoongebiedOfKom', 'BuitenWoongebiedOfKom'];
			attribute<String> RefSrc := '@S@'+name;
		}
		
		unit<UInt32> GeenTredes := Gedeeld/GeenTredes;
		
		unit<UInt32> BAU := combine(WoongebiedK, PlancapaciteitPlusStimuli_PerSubsector, UrbanContourK, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> WoongebiedK_name                            := WoongebiedK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> UrbanContour_name                           := UrbanContourK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name                      := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name                          := GrondGebruikK/name[fifth_rel];
			attribute<String> name                                        := WoongebiedK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+UrbanContour_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				WoongebiedK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				UrbanContourK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerd := combine(WoongebiedK, PlancapaciteitPlusStimuli_PerSubsector, UrbanContourPlusKansrijkWoningbouw, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> WoongebiedK_name                            := WoongebiedK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> UrbanContourPlusKansrijk_name               := UrbanContourPlusKansrijkWoningbouw/name[third_rel];
			attribute<String> OVBereikbaarheidK_name                      := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name                          := GrondGebruikK/name[fifth_rel];
			attribute<String> name                                        := WoongebiedK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+UrbanContourPlusKansrijk_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				WoongebiedK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				UrbanContourPlusKansrijkWoningbouw/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
	}
	
	container Ov_consumentendiensten := Detailhandel;
	
	container Zak_dienstverlening
	: Descr = "Eigen tredetabel voor kantoren (#668): dezelfde assen als de overige werksubsectoren, met bestaand kantoorgebied als hoogste as. Waar kantoor in het basisjaar de werkstand domineert gaat de
				zaaglijn eerst; greenfield komt pas aan de beurt als de bestaande voorraad vol is."
	{
		unit<UInt32> BestaandKantoorK: NrOfRows = 2
		{
			attribute<String> name: ['BinnenBestaandKantoor', 'BuitenBestaandKantoor'];
			attribute<String> RefSrc := '@S@'+name;
		}
		
		unit<UInt32> GeenTredes := Gedeeld/GeenTredes;
		
		unit<UInt32> BAU := combine(BestaandKantoorK, PlancapaciteitPlusStimuli_PerSubsector, UrbanContourK, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> BestaandKantoorK_name                       := BestaandKantoorK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> UrbanContourK_name                          := UrbanContourK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name                      := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name                          := GrondGebruikK/name[fifth_rel];
			attribute<String> name                                        := BestaandKantoorK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+UrbanContourK_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				BestaandKantoorK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				UrbanContourK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerd := BAU;
	}
	container Overheid_kw_diensten
	: Descr = "Eigen tredetabel voor overheid en kwartaire diensten: dezelfde assen als de overige verzorgende subsectoren, maar met een driedelige eerste as in plaats van de tweedelige WoongebiedK;
				bestaande instellingen gaan voor de wijkrand, de wijkrand voor de rest (#668)."
	{
		unit<UInt32> InstellingWoongebiedK: NrOfRows = 3
		{
			attribute<String> name  : ['BinnenBestaandeInstelling', 'BinnenWoongebiedOfKom', 'BuitenWoongebiedOfKom'];
			attribute<String> RefSrc: ['@S@BinnenBestaandeInstelling', '@S@BuitenBestaandeInstelling && @S@BinnenWoongebiedOfKom', '@S@BuitenBestaandeInstelling && @S@BuitenWoongebiedOfKom'];
		}

		unit<UInt32> GeenTredes := Gedeeld/GeenTredes;

		unit<UInt32> BAU := combine(InstellingWoongebiedK, PlancapaciteitPlusStimuli_PerSubsector, UrbanContourK, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> InstellingWoongebiedK_name                  := InstellingWoongebiedK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> UrbanContour_name                           := UrbanContourK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name                      := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name                          := GrondGebruikK/name[fifth_rel];
			attribute<String> name                                        := InstellingWoongebiedK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+UrbanContour_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;

			attribute<String> RefSrc :=
			'('+
				InstellingWoongebiedK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				UrbanContourK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}

		unit<UInt32> NbSGenuanceerd := combine(InstellingWoongebiedK, PlancapaciteitPlusStimuli_PerSubsector, UrbanContourPlusKansrijkWoningbouw, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> InstellingWoongebiedK_name                  := InstellingWoongebiedK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[second_rel];
			attribute<String> UrbanContourPlusKansrijk_name               := UrbanContourPlusKansrijkWoningbouw/name[third_rel];
			attribute<String> OVBereikbaarheidK_name                      := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name                          := GrondGebruikK/name[fifth_rel];
			attribute<String> name                                        := InstellingWoongebiedK_name+'_'+PlancapaciteitPlusStimuli_PerSubsector_name+'_'+UrbanContourPlusKansrijk_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;

			attribute<String> RefSrc :=
			'('+
				InstellingWoongebiedK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[second_rel]+' && '+
				UrbanContourPlusKansrijkWoningbouw/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}

	}
	
	container Nijverheid
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(PlancapaciteitPlusStimuli_PerSubsector, GrondGebruikK)
		{
			attribute<String> PlancapaciteitPlusStimuli_PerSubsector_name := PlancapaciteitPlusStimuli_PerSubsector/name[first_rel];
			attribute<String> GrondGebruikK_name                          := GrondGebruikK/name[second_rel];
			attribute<String> name                                        := PlancapaciteitPlusStimuli_PerSubsector_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli_PerSubsector/RefSrc[first_rel]+' && '+
				GrondGebruikK/RefSrc[second_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, BouwregimeK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> PlanCapaciteitZ_name := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[second_rel];
			attribute<String> BouwregimeK_name     := BouwregimeK/name[third_rel];
			attribute<String> GrondGebruikK_name   := GrondGebruikK/name[fourth_rel];
			attribute<String> name                 := PlanCapaciteitH_name+'_'+PlanCapaciteitZ_name+'_'+BouwregimeK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				GrondGebruikK/RefSrc[fourth_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> BouwregimeK_name     := BouwregimeK/name[second_rel];
			attribute<String> PlanCapaciteitZ_name := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[third_rel];
			attribute<String> GrondGebruikK_name   := GrondGebruikK/name[fourth_rel];
			attribute<String> name                 := PlanCapaciteitH_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[third_rel]+' && '+
				GrondGebruikK/RefSrc[fourth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerd := BAU;
		
		unit<UInt32> NbSGenuanceerdOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector, SlappeBodemsK, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> BouwregimeK_name       := BouwregimeK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/name[fourth_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit_PerSubsector/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit_PerSubsector/RefSrc[fourth_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> OO := combine(Plancapaciteit_Varianten/Totaal_PerSubsector, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal_PerSubsector/name[first_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[second_rel];
			attribute<String> name                := PlanCapaciteit_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
				'('+
					Plancapaciteit_Varianten/Totaal_PerSubsector/RefSrc[first_rel]+' && '+
					GrondGebruikK/RefSrc[second_rel]+
				')';
		}
		
		unit<UInt32> GR := combine(Plancapaciteit_Varianten/Totaal_PerSubsector, BouwregimeK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal_PerSubsector/name[first_rel];
			attribute<String> BouwregimeK_name    := BouwregimeK/name[second_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[third_rel];
			attribute<String> name                := PlanCapaciteit_name+'_'+BouwregimeK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/Totaal_PerSubsector/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				GrondGebruikK/RefSrc[third_rel]+
			')';
		}
	}
	
	container Gedeeld
	: Descr = "Trede-onderdelen die meerdere werksubsectoren delen. Templates/VariantData/Trede_T zoekt de trede op als VariantParameters/Tredes/<Sector>/<Subsector>/<Trede_Variant>, dus een container onder een naam die geen subsector is wordt nooit opgezocht (#605); alleen GeenTredes wordt gebruikt, door Detailhandel en Zak_dienstverlening."
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
	}
}