// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Definitie van de tredes voor de woningsectoren op basis van plancapaciteit, stimuli, maatregelen, eigendom en
// grondgebruik. Per Model Variant.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Wonen : using = "impl"
, Descr = "Definitie van de tredes voor de woningsectoren op basis van plancapaciteit, stimuli, maatregelen, eigendom en grondgebruik. Per Model Variant."
{
	container eengezins_VrijeSector
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(PlancapaciteitPlusStimuli, BBGK, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		{
			attribute<String> PlancapaciteitPlusStimuli_name := PlancapaciteitPlusStimuli/name[first_rel];
			attribute<String> BBGK_name                      := BBGK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name         := OVBereikbaarheidK/name[third_rel];
			attribute<String> EigendomK_name                 := EigendomVarianten/BAU/name[fourth_rel];
			attribute<String> GrondGebruikK_name             := GrondGebruikK/name[fifth_rel];
			
			attribute<String> name                           := PlancapaciteitPlusStimuli_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli/RefSrc[first_rel]+' && '+
				BBGK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, BBGK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, BouwregimeK, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> BBGK_name              := BBGK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[fifth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[sixth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[seventh_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+BouwregimeK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				BBGK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				BouwregimeK/RefSrc[fifth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[sixth_rel]+' && '+
				GrondGebruikK/RefSrc[seventh_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, BouwregimeK, BBGK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[second_rel];
			attribute<String> BBGK_name              := BBGK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fifth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[sixth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[seventh_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BouwregimeK_name+'_'+BBGK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				BBGK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fifth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[sixth_rel]+' && '+
				GrondGebruikK/RefSrc[seventh_rel]+
			')';
		}
		
		unit<UInt32> NbSMax := BAU;
		unit<UInt32> NbSGenuanceerd := combine(PlancapaciteitPlusStimuli, BBGPlusKansrijkWoningbouw, OVBereikbaarheidK, EigendomVarianten/BAU, GrondGebruikK)
		, Descr = "Als BAU, met een extra stap ertussen: de zoekgebieden woningbouw uit het landschapstype Rivieren (#620).
	
					De tweede dimensie is BBGPlusKansrijkWoningbouw in plaats van BBGK. Daarmee gaat binnen elke
					plancapaciteitsklasse eerst het bestaand bebouwd gebied, daarna wat daarbuiten in een kansrijk
					zoekgebied ligt, en daarna de rest. Het zoekgebied stuurt dus binnen de uitbreiding en zet de
					ladder niet op zijn kop.
					
					De trede telt hierdoor 216 klassen in plaats van 144. Alleen deze variant gebruikt hem; BAU,
					BAU2 en NbSMax draaien onverminderd op BAU."
		{
			attribute<String> PlancapaciteitPlusStimuli_name := PlancapaciteitPlusStimuli/name[first_rel];
			attribute<String> BBGPlusKansrijk_name           := BBGPlusKansrijkWoningbouw/name[second_rel];
			attribute<String> OVBereikbaarheidK_name         := OVBereikbaarheidK/name[third_rel];
			attribute<String> EigendomK_name                 := EigendomVarianten/BAU/name[fourth_rel];
			attribute<String> GrondGebruikK_name             := GrondGebruikK/name[fifth_rel];
			
			attribute<String> name                           := PlancapaciteitPlusStimuli_name+'_'+BBGPlusKansrijk_name+'_'+OVBereikbaarheidK_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				PlancapaciteitPlusStimuli/RefSrc[first_rel]+' && '+
				BBGPlusKansrijkWoningbouw/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				EigendomVarianten/BAU/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> NbSMaxOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[third_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fourth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'++PlanCapaciteitZ_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[third_rel]+' && '+
				GrondGebruikK/RefSrc[fourth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerdOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> GR := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, OVBereikbaarheidK, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, EigendomVarianten/Transformeren, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[second_rel];
			attribute<String> BouwregimeK_name        := BouwregimeK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> EigendomK_name         := EigendomVarianten/Transformeren/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+OVBereikbaarheidK_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				OVBereikbaarheidK/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				EigendomVarianten/Transformeren/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> OO := combine(PampusK, Plancapaciteit_Varianten/Totaal, EigendomVarianten/Intensiveren, GrondGebruikK)
		{
			attribute<String> Pampus_name         := PampusK/name[first_rel];
			attribute<String> PlanCapaciteit_name := Plancapaciteit_Varianten/Totaal/name[second_rel];
			attribute<String> EigendomK_name      := EigendomVarianten/Intensiveren/name[third_rel];
			attribute<String> GrondGebruikK_name  := GrondGebruikK/name[fourth_rel];
			attribute<String> name                := Pampus_name+'_'+PlanCapaciteit_name+'_'+EigendomK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
				'('+
					PampusK/RefSrc[first_rel]+' && '+
					Plancapaciteit_Varianten/Totaal/RefSrc[second_rel]+' && '+
					EigendomVarianten/Intensiveren/RefSrc[third_rel]+' && '+
					GrondGebruikK/RefSrc[fourth_rel]+
				')';
		}
	}
	
	container eengezins_SocialeHuur  := eengezins_VrijeSector;
	container meergezins_VrijeSector := eengezins_VrijeSector;
	container meergezins_SocialeHuur := eengezins_VrijeSector;
}