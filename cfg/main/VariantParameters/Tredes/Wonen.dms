////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Definitie van de tredes voor de woningsectoren op basis van herontwikkelingskans, plancapaciteit, stimuli, bebouwd
// gebied, OV-bereikbaarheid, bouwregime en grondgebruik. Per Model Variant.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Wonen : using = "impl"
, Descr = "Definitie van de tredes voor de woningsectoren op basis van herontwikkelingskans, plancapaciteit, stimuli, bebouwd gebied, OV-bereikbaarheid, bouwregime en grondgebruik. Per Model Variant."
{
	container eengezins_VrijeSector
	{
		unit<UInt32> GeenTredes := StudyAreas/UnityDomain
		{ 
			attribute<String>    name            := rdc_meter/name;
			attribute<rdc_meter> geometry (poly) := rdc_meter/geometry;
			attribute<String>    RefSrc          := const('@S@Totaal',.);
		}
		
		unit<UInt32> BAU := combine(HerontwikkelingK, PlancapaciteitPlusStimuli, UrbanContourAansluitendK, OVBereikbaarheidK, GrondGebruikK)
		, Descr = "De ladder van BAU: eerst de percelen die de herontwikkelingskans vrij laat (#869), dan plancapaciteit en stimuli, dan de ligging ten opzichte van het bebouwd gebied in drie treden (binnen, aansluitend, verder weg; #862), dan OV en
					bouwterrein. 216 klassen."
		{
			attribute<String> HerontwikkelingK_name           := HerontwikkelingK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_name := PlancapaciteitPlusStimuli/name[second_rel];
			attribute<String> UrbanContourK_name             := UrbanContourAansluitendK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name         := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name             := GrondGebruikK/name[fifth_rel];
			
			attribute<String> name                           := HerontwikkelingK_name+'_'+PlancapaciteitPlusStimuli_name+'_'+UrbanContourK_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				HerontwikkelingK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli/RefSrc[second_rel]+' && '+
				UrbanContourAansluitendK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> Intensiveren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, UrbanContourK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, BouwregimeK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> UrbanContourK_name     := UrbanContourK/name[second_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> BouwregimeK_name       := BouwregimeK/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+UrbanContourK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+BouwregimeK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				UrbanContourK/RefSrc[second_rel]+' && '+
				OVBereikbaarheidK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				BouwregimeK/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> Transformeren := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, BouwregimeK, UrbanContourK, OVBereikbaarheidK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> BouwregimeK_name       := BouwregimeK/name[second_rel];
			attribute<String> UrbanContourK_name     := UrbanContourK/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fifth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[sixth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+BouwregimeK_name+'_'+UrbanContourK_name+'_'+OVBereikbaarheidK_name+'_'+PlanCapaciteitZ_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				BouwregimeK/RefSrc[second_rel]+' && '+
				UrbanContourK/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fifth_rel]+' && '+
				GrondGebruikK/RefSrc[sixth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerd := combine(HerontwikkelingK, PlancapaciteitPlusStimuli, UrbanContourPlusKansrijkWoningbouw, OVBereikbaarheidK, GrondGebruikK)
		, Descr = "Als BAU, met een extra stap ertussen: de zoekgebieden woningbouw uit het landschapstype Rivieren (#620). De tweede dimensie is UrbanContourPlusKansrijkWoningbouw in plaats van UrbanContourK,
					zodat binnen elke plancapaciteitsklasse eerst het bestaand bebouwd gebied gaat, daarna wat daarbuiten in een kansrijk zoekgebied ligt, en daarna de rest; het zoekgebied stuurt binnen de
					uitbreiding en zet de ladder niet op zijn kop. Alleen NbSGenuanceerd gebruikt hem."
		{
			attribute<String> HerontwikkelingK_name           := HerontwikkelingK/name[first_rel];
			attribute<String> PlancapaciteitPlusStimuli_name := PlancapaciteitPlusStimuli/name[second_rel];
			attribute<String> UrbanContourPlusKansrijk_name  := UrbanContourPlusKansrijkWoningbouw/name[third_rel];
			attribute<String> OVBereikbaarheidK_name         := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name             := GrondGebruikK/name[fifth_rel];
			
			attribute<String> name                           := HerontwikkelingK_name+'_'+PlancapaciteitPlusStimuli_name+'_'+UrbanContourPlusKansrijk_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				HerontwikkelingK/RefSrc[first_rel]+' && '+
				PlancapaciteitPlusStimuli/RefSrc[second_rel]+' && '+
				UrbanContourPlusKansrijkWoningbouw/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> NbSGenuanceerdOld := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, SlappeBodemsK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, OVBereikbaarheidK, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> SlappeBodemsK_name     := SlappeBodemsK/name[second_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[third_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+SlappeBodemsK_name+'_'+PlanCapaciteitZ_name+'_'+OVBereikbaarheidK_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				SlappeBodemsK/RefSrc[second_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[third_rel]+' && '+
				OVBereikbaarheidK/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
		unit<UInt32> GR := combine(Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit, OVBereikbaarheidK, BouwregimeK, Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit, GrondGebruikK)
		{
			attribute<String> PlanCapaciteitH_name   := Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/name[first_rel];
			attribute<String> OVBereikbaarheidK_name := OVBereikbaarheidK/name[second_rel];
			attribute<String> BouwregimeK_name       := BouwregimeK/name[third_rel];
			attribute<String> PlanCapaciteitZ_name   := Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/name[fourth_rel];
			attribute<String> GrondGebruikK_name     := GrondGebruikK/name[fifth_rel];
			attribute<String> name                   := PlanCapaciteitH_name+'_'+OVBereikbaarheidK_name+'_'+BouwregimeK_name+'_'+PlanCapaciteitZ_name+'_'+GrondGebruikK_name;
			
			attribute<String> RefSrc :=
			'('+
				Plancapaciteit_Varianten/BinnenOfBuitenHardePlancapaciteit/RefSrc[first_rel]+' && '+
				OVBereikbaarheidK/RefSrc[second_rel]+' && '+
				BouwregimeK/RefSrc[third_rel]+' && '+
				Plancapaciteit_Varianten/BinnenOfBuitenZachtePlancapaciteit/RefSrc[fourth_rel]+' && '+
				GrondGebruikK/RefSrc[fifth_rel]+
			')';
		}
		
	}
	
	container eengezins_SocialeHuur  := eengezins_VrijeSector;
	container meergezins_VrijeSector := eengezins_VrijeSector;
	container meergezins_SocialeHuur := eengezins_VrijeSector;
}