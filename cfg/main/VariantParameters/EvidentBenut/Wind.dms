// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de VariantParameters ten aazien van de evidente benutting van bestaande windparken. Plekken die reeds benut zijn vallen af in de zeefanalyse.
// Benutting is relatief ten opzichte van potentiele alternatieve aanwendingen van bestaande grond.
// Bron: expert judgement PBL
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

attribute<Bool> Wind :=
	id(.) == V/oorspronkelijk_noData ||
	id(.) == V/Spoorterrein ||
	id(.) == V/hoofdweg ||
	id(.) == V/Vliegveld ||
	// id(.) == V/metro_en_sneltram ||
	id(.) == V/Woonterrein ||
	id(.) == V/Detailhandel_en_horeca ||
	id(.) == V/openbare_Voorziening ||
	id(.) == V/sociaal_culturele_Voorziening ||
	id(.) == V/bedrijfsterrein ||
	id(.) == V/stortplaats ||
	id(.) == V/begraafplaats ||
	id(.) == V/Delfstofwinplaats ||
	// id(.) == V/Bouwterrein ||
	// id(.) == V/semi_verhard_overig_terrein ||
	// id(.) == V/zonnepark ||
	id(.) == V/Stedelijk_groen ||
	id(.) == V/sportterrein ||
	id(.) == V/volkstuin ||
	id(.) == V/dagrecreatief_terrein ||
	id(.) == V/Verblijfsrecreatief_terrein ||
	// id(.) == V/Glastuinbouw ||
	// id(.) == V/Overig_agrarisch_terrein ||
	// id(.) == V/akker_en_meerjarige_teelt ||
	// id(.) == V/agrarisch_grasland ||
	id(.) == V/bos ||
	id(.) == V/Open_droog_natuurlijk_terrein ||
	id(.) == V/Open_nat_natuurlijk_terrein ||
	// id(.) == V/Ijsselmeer_en_Markermeer ||
	// id(.) == V/Afgesloten_zeearm ||
	id(.) == V/Rijn_en_Maas ||
	// id(.) == V/Randmeer ||
	id(.) == V/Spaarbekken ||
	id(.) == V/Recreatief_binnenwater ||
	id(.) == V/Binnenwater_voor_delfstofwinning ||
	id(.) == V/Vloei_en_slibveld ||
	id(.) == V/overig_binnenwater ||
	// id(.) == V/Waddenzee_Eems_en_Dollard ||
	// id(.) == V/Oosterschelde ||
	id(.) == V/Westerschelde ||
	// id(.) == V/NoordZee ||
	id(.) == V/buitenland
, Descr = "Welke klassen op de evident-benut-kaart voor wind al benut zijn. Geldt overal, dus ook binnen plancapaciteit, en in alle varianten (#872). Daarnaast sluit de zeef autowegen en spoorbanen uit de BGT uit, zie Zeef_Basisjaar_T/Impl/IsEvidentBenut_obv_BGT_wind.";
