// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert per klasse van de evident-benut-kaart de jaarlijkse kans dat grond die in gebruik is vrijkomt voor wonen en werken.
// Een cel van zo'n klasse op de lijst van wonen of werken blijft dicht tot de cumulatieve kans de vaste trekking van haar perceel haalt (#882).
// Stedelijk groen, dagrecreatie en natuur hebben geen kans en blijven dicht: grote parken gaan in werkelijkheid niet om, en een trekking per perceel kan een park niet onderscheiden van restgroen.
// Bron: eigen schatting op de bodemstatistiek van 2015 en de BAG, zie Source.
//


attribute<Float32> GrondInGebruik_Stad :=
	switch(
		 case(id(.) == V/openbare_Voorziening,          0.00188f)
		,case(id(.) == V/sociaal_culturele_Voorziening, 0.00323f)
		,case(id(.) == V/sportterrein,                  0.00144f)
		,case(id(.) == V/volkstuin,                     0.00108f)
		,case(id(.) == V/Verblijfsrecreatief_terrein,   0.00209f)
		,0f
	)
, Descr = "De jaarlijkse kans dat grond van deze klasse vrijkomt voor wonen en werken, binnen KernStraal van een BRT-woonkern in een stedelijke buurt (#882). Nul: de klasse komt niet vrij en blijft dicht zolang ze op de lijst staat; zo ook stedelijk groen, dagrecreatie en natuur, zie de kop van dit bestand."
, Source = "Eigen schatting (#882): het deel van de cellen van 25 m zonder woning op 1 januari 2016 dat tot en met 2025 een woon- of werkobject kreeg (BAG van 1 januari 2026, bouwjaar 2017 tot en met 2025), als constante kans per jaar, naar de klasse in de bodemstatistiek van 2015 (CBS), binnen 250 m van een woonkern (BRT 2026) en in de zone van Stedelijkheid.";

attribute<Float32> GrondInGebruik_Platteland :=
	switch(
		 case(id(.) == V/openbare_Voorziening,          0.00116f)
		,case(id(.) == V/sociaal_culturele_Voorziening, 0.00271f)
		,case(id(.) == V/sportterrein,                  0.00079f)
		,case(id(.) == V/volkstuin,                     0.00049f)
		,case(id(.) == V/Verblijfsrecreatief_terrein,   0.00047f)
		,0f
	)
, Descr = "De jaarlijkse kans dat grond van deze klasse vrijkomt voor wonen en werken, binnen KernStraal van een BRT-woonkern in een niet-stedelijke buurt (#882). Nul: de klasse komt niet vrij en blijft dicht zolang ze op de lijst staat; zo ook stedelijk groen, dagrecreatie en natuur, zie de kop van dit bestand."
, Source = "Eigen schatting (#882): het deel van de cellen van 25 m zonder woning op 1 januari 2016 dat tot en met 2025 een woon- of werkobject kreeg (BAG van 1 januari 2026, bouwjaar 2017 tot en met 2025), als constante kans per jaar, naar de klasse in de bodemstatistiek van 2015 (CBS), binnen 250 m van een woonkern (BRT 2026) en in de zone van Stedelijkheid.";
