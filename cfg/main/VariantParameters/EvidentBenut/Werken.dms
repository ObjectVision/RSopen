//
// Deze file specificeert de VariantParameters ten aazien van de evidente benutting van bestaand woongebied. Plekken die reeds benut zijn vallen af in de zeefanalyse.
// Benutting is relatief ten opzichte van potentiele alternatieve aanwendingen van bestaande grond.
// Bron: expert judgement PBL
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

attribute<Bool> Werken := Wonen || id(.) == V/woonterrein || id(.) == V/Detailhandel_en_horeca
, Descr = "De lijst van wonen plus woonterrein en detailhandel en horeca. Geldt overal, dus ook binnen plancapaciteit, en in alle varianten (#872).";
