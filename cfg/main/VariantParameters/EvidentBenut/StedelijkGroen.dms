// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Welke klassen van de evident-benut-kaart al benut zijn voor nieuw stedelijk groen. Zie ObjectVision/RSopen#480.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

attribute<Bool> StedelijkGroen :=
	// id(.) == V/oorspronkelijk_noData ||
	id(.) == V/Spoorterrein ||
	id(.) == V/hoofdweg ||
	id(.) == V/Vliegveld ||
	id(.) == V/metro_en_sneltram ||
	// id(.) == V/woonterrein ||
	// id(.) == V/Detailhandel_en_horeca ||
	// id(.) == V/openbare_Voorziening ||
	// id(.) == V/sociaal_culturele_Voorziening ||
	// id(.) == V/bedrijfsterrein ||
	// id(.) == V/Stortplaats ||
	id(.) == V/begraafplaats ||
	// id(.) == V/Delfstofwinplaats ||
	// id(.) == V/Bouwterrein ||
	// id(.) == V/semi_verhard_overig_terrein ||
	// id(.) == V/zonnepark ||
	id(.) == V/stedelijk_groen ||
	id(.) == V/sportterrein ||
	id(.) == V/volkstuin ||
	id(.) == V/dagrecreatief_terrein ||
	// id(.) == V/Verblijfsrecreatief_terrein ||
	// id(.) == V/Glastuinbouw ||
	// id(.) == V/overig_agrarisch_terrein ||
	// id(.) == V/akker_en_meerjarige_teelt ||
	// id(.) == V/agrarisch_grasland ||
	id(.) == V/bos ||
	id(.) == V/open_droog_natuurlijk_terrein ||
	id(.) == V/open_nat_natuurlijk_terrein ||
	id(.) == V/Ijsselmeer_en_Markermeer ||
	id(.) == V/Afgesloten_zeearm ||
	id(.) == V/Rijn_en_Maas ||
	id(.) == V/Randmeer ||
	id(.) == V/Spaarbekken ||
	id(.) == V/Recreatief_binnenwater ||
	id(.) == V/Binnenwater_voor_delfstofwinning ||
	id(.) == V/Vloei_en_slibveld ||
	id(.) == V/overig_binnenwater ||
	id(.) == V/Waddenzee_Eems_en_Dollard ||
	id(.) == V/Oosterschelde ||
	id(.) == V/Westerschelde ||
	id(.) == V/NoordZee ||
	id(.) == V/buitenland
, Descr = "Welke klassen op de evident-benut-kaart al benut zijn voor nieuw stedelijk groen (#480). Van de grond die een functie heeft, is alleen de infrastructuur benut, dus spoorterrein, hoofdweg, vliegveld en metro en sneltram; woonterrein, voorzieningen, zonneparken en verblijfsrecreatie staan open (#906), en op een cel met woningen of banen komt een park alleen als de baat de verwerving en sloop dekt (Templates/Beschikbaarheden/Zeef_T/IsBeschikbaar_BijAfweging). Benut is verder alles wat al groen, natuur of water is, want daar levert een park geen groen bij; de geschiktheid ziet alleen het groen van de CBS-kaart en het water in het landgebruik, en mist zo het plantsoen dat de CBS-kaart woonterrein noemt. Bedrijventerrein, braakliggend en verhard overig terrein, kassen en landbouwgrond staan ook open; kassen sluit de geschiktheid uit op het landgebruik (Templates/Allocatie/Zichtjaar_T/Impl/StedelijkGroenClaim/IsWaterKasOfHoofdinfra).";
