// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Welke klassen van de evident-benut-kaart al benut zijn voor nieuw stedelijk groen. Zie ObjectVision/RSopen#480.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

attribute<Bool> StedelijkGroen :=
	// id(.) == V/oorspronkelijk_noData ||
	id(.) == V/Spoorterrein ||
	id(.) == V/hoofdweg ||
	id(.) == V/Vliegveld ||
	id(.) == V/metro_en_sneltram ||
	id(.) == V/woonterrein ||
	id(.) == V/Detailhandel_en_horeca ||
	id(.) == V/openbare_Voorziening ||
	id(.) == V/sociaal_culturele_Voorziening ||
	// id(.) == V/bedrijfsterrein ||
	// id(.) == V/Stortplaats ||
	id(.) == V/begraafplaats ||
	// id(.) == V/Delfstofwinplaats ||
	// id(.) == V/Bouwterrein ||
	// id(.) == V/semi_verhard_overig_terrein ||
	id(.) == V/zonnepark ||
	id(.) == V/stedelijk_groen ||
	id(.) == V/sportterrein ||
	id(.) == V/volkstuin ||
	id(.) == V/dagrecreatief_terrein ||
	id(.) == V/Verblijfsrecreatief_terrein ||
	// id(.) == V/Glastuinbouw ||
	// id(.) == V/overig_agrarisch_terrein ||
	// id(.) == V/akker_en_meerjarige_teelt ||
	// id(.) == V/agrarisch_grasland ||
	id(.) == V/bos ||
	id(.) == V/open_droog_natuurlijk_terrein ||
	id(.) == V/open_nat_natuurlijk_terrein ||
	id(.) == V/Ijsselmeer_en_Markermeer ||
	id(.) == V/Afgesloten_zeearm ||
	id(.) == V/Rijn_en_Maas ||
	id(.) == V/Randmeer ||
	id(.) == V/Spaarbekken ||
	id(.) == V/Recreatief_binnenwater ||
	id(.) == V/Binnenwater_voor_delfstofwinning ||
	id(.) == V/Vloei_en_slibveld ||
	id(.) == V/overig_binnenwater ||
	id(.) == V/Waddenzee_Eems_en_Dollard ||
	id(.) == V/Oosterschelde ||
	id(.) == V/Westerschelde ||
	id(.) == V/NoordZee ||
	id(.) == V/buitenland
, Descr = "Welke klassen op de evident-benut-kaart al benut zijn voor nieuw stedelijk groen (#480). Benut zijn de woonterreinen en voorzieningen, want een park sloopt geen woningen of gebouwen, en alles wat al groen, natuur of water is, want daar levert een park geen groen bij. Bedrijventerrein, braakliggend en verhard overig terrein en landbouwgrond blijven beschikbaar; daar betaalt het park de verwerving en het slopen van wat er staat. Kassen staan hier ook open, maar de geschiktheid sluit ze uit op het landgebruik van de stand (Templates/Allocatie/Zichtjaar_T/Impl/StedelijkGroenClaim/IsWaterOfKas), net als water dat deze kaart niet als water ziet.";
