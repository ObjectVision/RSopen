// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de VariantParameters ten aazien van de evidente benutting van bestaande zonneparken. Plekken die reeds benut zijn vallen af in de zeefanalyse.
// Benutting is relatief ten opzichte van potentiele alternatieve aanwendingen van bestaande grond.
// Binnen bestaande plancapaciteit worden minder GrondgebruiksTypen als reeds benut beschouwd. Daar is dus meer mogelijk in de allocatie.
// Bron: expert judgement PBL
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Landbouw
: Descr = "Welke bodemgebruiksklassen uit het BBG als al benut gelden, zodat de landbouwallocatie er niet kan landen; gelezen door Zeef_Basisjaar_T/Impl/IsEvidentBenutBinnenPlancapaciteit en
IsEvidentBenutBuitenPlancapaciteit, die voor landbouw hetzelfde item lezen omdat de sector geen plancapaciteit kent. Sinds #605 versmald tot de klassen die een onomkeerbare verandering na de
gewaskaart aanwijzen: bebouwing, infrastructuur, winning, glastuinbouw en zonnepark. De zoekruimte van de landbouw wordt al bepaald door de basisjaargewaskaart
(Iter_Landbouw_T/Allocatie_Prep/MagLandbouwWorden, BRP met LGN als achtervang); een tweede uitsluiting op een bron die functie meet in plaats van bedekking nam anders agrarisch natuurbeheer
weg dat de teler in de BRP opgeeft en het CBS als natuurgebied afbakent. Zou de regel dat de landbouw alleen op bestaand areaal landt ooit worden uitgezet, dan is deze lijst het enige dat de
landbouw uit de stad en de natuur houdt en hoort zij eerst terug in haar oude vorm."
{
	container BinnenPlancapaciteit
	{
		attribute<Bool> Default (...) :=
			// De klassen die een onomkeerbare verandering na de gewaskaart aanwijzen; zie de Descr van deze container (#605).
			// Bebouwing en infrastructuur
			id(...) == V/woonterrein ||
			id(...) == V/bedrijfsterrein ||
			id(...) == V/Detailhandel_en_horeca ||
			id(...) == V/openbare_Voorziening ||
			id(...) == V/sociaal_culturele_Voorziening ||
			id(...) == V/begraafplaats ||
			id(...) == V/bouwterrein ||
			id(...) == V/semi_verhard_overig_terrein ||
			id(...) == V/hoofdweg ||
			id(...) == V/Spoorterrein ||
			id(...) == V/Metro_en_Sneltram ||
			id(...) == V/Vliegveld ||
			// Winning, opslag en energie
			id(...) == V/delfstofwinplaats ||
			id(...) == V/stortplaats ||
			id(...) == V/Zonnepark ||
			// Bedekte teelt: een kas is een gebouw
			id(...) == V/Glastuinbouw ||
			// Buiten het studiegebied
			id(...) == V/buitenland
			// WEGGEHAALD op 8 september 2026 (#605), want daar spreekt het BBG de gewaskaart tegen in plaats van haar aan te vullen:
			//   bos, open_droog_natuurlijk_terrein, open_nat_natuurlijk_terrein
			//   stedelijk_groen, sportterrein, volkstuin, dagrecreatief_terrein, Verblijfsrecreatief_terrein
			//   IJsselmeer_en_Markermeer, afgesloten_zeearm, Rijn_en_Maas, Randmeer, spaarbekken, recreatief_binnenwater,
			//   binnenwater_voor_delfstofwinning, vloei_en_slibveld, overig_binnenwater, Waddenzee_Eems_en_Dollard,
			//   Oosterschelde, Westerschelde, NoordZee
			// overige_agrarisch_gebruik stond ook toen al bewust buiten de lijst.
		;

		attribute<bool> BAU (...) := Default;
		attribute<bool> WBS (...) := Default;
	}
	
	container BuitenPlancapaciteit := BinnenPlancapaciteit;
}