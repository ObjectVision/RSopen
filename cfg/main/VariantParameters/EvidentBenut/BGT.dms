// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert de VariantParameters ten aazien van de evidente benutting via de BGT. Plekken die reeds benut zijn vallen af in de zeefanalyse.
// Benutting is relatief ten opzichte van potentiele alternatieve aanwendingen van bestaande grond.
// Bron: expert judgement PBL
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

unit<UInt32> BGT := Classifications/Grondgebruik/BGT/Classes 
// De set Default gaat op in de evident-benut-kaart (BaseData/StartState/EvidentBenutKaart, #872), voor hele lokale benutting die niet door de BAG wordt afgevangen, zoals benzinestations en (grootschalige) infra.
// Als we geen specifieke reden hebben waarom je ergens niet mag bouwen, dan ook niet op EvidentBenut zetten, e.g. WaardeOnbekend. 
{
	attribute<Bool> Default :=
		// id(.) == V/functioneelgebied_waardeOnbekend ||                             // Zeer grote vlakken in bijv Friesland.
		// id(.) == V/functioneelgebied_recreatie_volkstuin ||                        // 
		// id(.) == V/functioneelgebied_recreatie_sportterrein ||                     // 
		// id(.) == V/functioneelgebied_bushalte ||                                   // 
		// id(.) == V/functioneelgebied_kering ||                                     // Zitten 0 vlakken in BGT2025.
		// id(.) == V/functioneelgebied_bedrijvigheid ||                              // 
		id(.) == V/functioneelgebied_benzinestation ||                                // 
		// id(.) == V/functioneelgebied_beWoning ||                                   // 
		// id(.) == V/functioneelgebied_carpoolplaats ||                              // 
		// id(.) == V/functioneelgebied_functioneel_beheer ||                         // 
		// id(.) == V/functioneelgebied_functioneel_beheer_hondenuitlaatplaats ||     // 
		// id(.) == V/functioneelgebied_infrastructuur_verkeer_en_vervoer ||          // 
		// id(.) == V/functioneelgebied_infrastructuur_waterstaatswerken ||           // Veel kleine vlakjes (waterbakken, kleine overloopjes oid).
		// id(.) == V/functioneelgebied_Landbouw ||                                   // 
		// id(.) == V/functioneelgebied_maatschappelijke_en_of_publieksVoorziening || // 
		// id(.) == V/functioneelgebied_natuur_en_landschap ||                        // 
		// id(.) == V/functioneelgebied_recreatie ||                                  // 
		// id(.) == V/functioneelgebied_recreatie_bungalowpark ||                     // 
		// id(.) == V/functioneelgebied_recreatie_camping ||                          // 
		// id(.) == V/functioneelgebied_recreatie_park ||                             // Wordt variant specifiek afgehandeld via de evident-benut-kaart.
		// id(.) == V/functioneelgebied_recreatie_speeltuin ||                        // 
		// id(.) == V/functioneelgebied_verzorgingsplaats ||                          // 
		id(.) == V/functioneelgebied_waterbergingsgebied ||                           // 
		id(.) == V/functioneelgebied_begraafplaats ||                                 // 
		// id(.) == V/gebouwinstallatie_waardeOnbekend ||                             // 
		// id(.) == V/gebouwinstallatie_bordes ||                                     // 
		// id(.) == V/gebouwinstallatie_luifel ||                                     // 
		// id(.) == V/gebouwinstallatie_toegangstrap ||                               // 
		// id(.) == V/onbegroeidterreindeel_erf ||                                    // 
		// id(.) == V/onbegroeidterreindeel_gesloten_verharding ||                    // 
		// id(.) == V/onbegroeidterreindeel_half_verhard ||                           // 
		// id(.) == V/onbegroeidterreindeel_onverhard  ||                             // 
		// id(.) == V/onbegroeidterreindeel_open_verharding  ||                       // 
		// id(.) == V/onbegroeidterreindeel_transitie  ||                             // 
		// id(.) == V/onbegroeidterreindeel_zand ||                                   // 
		// id(.) == V/begroeidterreindeel_boomteelt ||                                // 
		// id(.) == V/begroeidterreindeel_bouwland ||                                 // 
		// id(.) == V/begroeidterreindeel_fruitteelt ||                               // 
		// id(.) == V/begroeidterreindeel_gemengd_bos ||                              // 
		// id(.) == V/begroeidterreindeel_grasland_agrarisch ||                       // 
		// id(.) == V/begroeidterreindeel_grasland_overig ||                          // 
		id(.) == V/begroeidterreindeel_groenvoorziening ||                         // Zeer veel impact! Veel meer dan park. TODO: 20251013 alsnog evidentbenut maken of via OPs als tarra buurtgroen. 
		// id(.) == V/begroeidterreindeel_heide ||                                    // 
		// id(.) == V/begroeidterreindeel_houtwal ||                                  // 
		// id(.) == V/begroeidterreindeel_kwelder ||                                  // 
		// id(.) == V/begroeidterreindeel_loofbos ||                                  // 
		// id(.) == V/begroeidterreindeel_moeras ||                                   // 
		// id(.) == V/begroeidterreindeel_naaldbos ||                                 // 
		// id(.) == V/begroeidterreindeel_rietland ||                                 // 
		// id(.) == V/begroeidterreindeel_struiken ||                                 // 
		// id(.) == V/begroeidterreindeel_transitie ||                                // 
		// id(.) == V/begroeidterreindeel_duin ||                                     // 
		// id(.) == V/ondersteunendwaterdeel_oever_slootkant ||                       // 
		// id(.) == V/ondersteunendwaterdeel_slik ||                                  // 
		// id(.) == V/ondersteunendwaterdeel_transitie ||                             // 
		// id(.) == V/ondersteunendwegdeel_berm ||                                    // 
		// id(.) == V/ondersteunendwegdeel_verkeerseiland |                           // 
		// id(.) == V/ondersteunendwegdeel_transitie ||                               // 
		// id(.) == V/ongeClassificeerdobject_geenWaarde ||                           // 
		// id(.) == V/overbruggingsdeel_waardeOnbekend ||                             // 
		id(.) == V/overbruggingsdeel_brug ||                                          // 
		id(.) == V/overbruggingsdeel_viaduct ||                                       // 
		id(.) == V/overbruggingsdeel_ecoduct ||                                       // 
		id(.) == V/overbruggingsdeel_fly_over ||                                      // 
		id(.) == V/overbruggingsdeel_aquaduct ||                                      // 
		// id(.) == V/overigbouwwerk_waardeOnbekend ||                                // 
		// id(.) == V/overigbouwwerk_bassin ||                                        // 
		// id(.) == V/overigbouwwerk_lage_trafo ||                                    // 
		// id(.) == V/overigbouwwerk_schuur ||                                        // 
		// id(.) == V/overigbouwwerk_overkapping ||                                   // 
		// id(.) == V/overigbouwwerk_open_loods ||                                    // 
		// id(.) == V/overigbouwwerk_voedersilo ||                                    // 
		// id(.) == V/overigbouwwerk_bezinkbak ||                                     // 
		// id(.) == V/overigbouwwerk_windturbine ||                                   // 
		// id(.) == V/overigbouwwerk_opslagtank ||                                    // 
		id(.) == V/overigbouwwerk_bunker ||                                           // 
		// id(.) == V/overigbouwwerk_niet_bgt ||                                      // 
		// id(.) == V/overigbouwwerk_transitie ||                                     // 
		// id(.) == V/pand_woongebied ||                                              // 
		// id(.) == V/pand_Detailhandel_en_horeca ||                                  // 
		// id(.) == V/pand_sociaal_culturele_Voorzieningen ||                         // 
		// id(.) == V/pand_bedrijfsterreinen ||                                       // 
		// id(.) == V/tunneldeel_geenWaarde ||                                        // 
		// id(.) == V/waterdeel_waterloop ||                                          // Klopt dit? Willen we bebuwing hier toelaten? JC: Als je in een weiland bouwt, mag je toch slootjes weghalen?
		// id(.) == V/waterdeel_watervlakte ||                                        // Al via de evident-benut-kaart geregeld.
		id(.) == V/waterdeel_Zee ||                                                   // 
		// id(.) == V/waterdeel_greppel_droge_sloot ||                                // 
		// id(.) == V/waterdeel_transitie ||                                          // 
		id(.) == V/wegdeel_OV_baan ||                                              // 
		// id(.) == V/wegdeel_fietspad ||                                             // 
		// id(.) == V/wegdeel_inrit ||                                                // 
		   id(.) == V/wegdeel_parkeervlak ||                                          // #784: een parkeerterrein is benutte grond.
		   id(.) == V/wegdeel_rijbaan_lokale_weg ||                                   // #784: aan sinds september 2026, zie de toelichting onderaan deze set.
		id(.) == V/wegdeel_rijbaan_regionale_weg ||                                   // 
		// id(.) == V/wegdeel_transitie ||                                            // 
		// id(.) == V/wegdeel_voetgangersgebied ||                                    // 
		// id(.) == V/wegdeel_voetpad ||                                              // 
		// id(.) == V/wegdeel_voetpad_op_trap ||                                      // 
		// id(.) == V/wegdeel_woonerf ||                                              // 
		// id(.) == V/wegdeel_ruiterpad ||                                            // 
		id(.) == V/wegdeel_Spoorbaan ||                                               // 
		id(.) == V/wegdeel_rijbaan_autoweg ||                                         // 
		id(.) == V/wegdeel_overweg ||                                                 // 
		id(.) == V/wegdeel_rijbaan_autosnelweg ||                                     // 
		id(.) == V/wegdeel_baan_voor_vliegverkeer ||                                  // 
		id(.) == V/wegdeel_brug_viaduct ||                                            // 
		// id(.) == V/vegetatieobject_haag ||                                         // 
		// id(.) == V/waterinrichtingselement_geenWaarde ||                           // 
		// id(.) == V/weginrichtingselement_balustrade ||                             // 
		// id(.) == V/weginrichtingselement_boomspiegel ||                            // 
		// id(.) == V/weginrichtingselement_geleideconstructie ||                     // 
		// id(.) == V/weginrichtingselement_lijnafwatering ||                         // 
		// id(.) == V/weginrichtingselement_molgoot ||                                // 
		// id(.) == V/weginrichtingselement_rooster ||                                // 
		// id(.) == V/weginrichtingselement_verblindingswering ||                     // 
		// id(.) == V/weginrichtingselement_waardeOnbekend ||                         // 
		// id(.) == V/weginrichtingselement_wegmarkering ||                           // 
		// id(.) == V/weginrichtingselement_wildrooster                               // 
		id(.) == V/kunstwerkdeel_gemaal ||                                            // 
		id(.) == V/kunstwerkdeel_Hoogspanningsmast ||                                 // 
		// id(.) == V/kunstwerkdeel_niet_bgt ||                                       // 
		id(.) == V/kunstwerkdeel_perron ||
		id(.) == V/kunstwerkdeel_sluis ||                                             // 
		// id(.) == V/kunstwerkdeel_steiger ||                                        // 
		id(.) == V/kunstwerkdeel_strekdam ||                                          // 
		id(.) == V/kunstwerkdeel_stuw                                                 // 
		// id(.) == V/kunstwerkdeel_transitie                                         // 
	;
	
	// wegdeel_rijbaan_lokale_weg en wegdeel_parkeervlak staan aan omdat alleen de BGT een stedelijke ontsluitingsweg of parkeerterrein ziet; de bodemstatistiek karteert op ongeveer een hectare (#784).
	// De BGT gaat met Modus van 2,5 naar 25 meter, dus de set telt pas mee waar hij samen meer dan de halve cel dekt.
	// De pand-regels hierboven doen niets, want de BGT-store bevat geen panden.
	// Een wijziging in deze set verandert de fingerprint van de evident-benut-kaart (bgt_used) en van de BGT-kaart van zon (class_flags in Templates/VariantData_T); doe dat niet terwijl een allocatie die bestanden leest.

	container Kaart
	: Descr = "De groepen BGT-klassen waaruit BaseData/StartState/EvidentBenutKaart zijn klassen afleidt (#872). Een groep telt als ze samen meer dan de halve cel dekken; pandvlakken zitten niet in de BGT-store, dus een cel die vooral pand is haalt geen groep."
	{
		attribute<Bool> Benut        (BGT) := Default, Descr = "De hele set hierboven. Wat in geen andere groep de cel haalt, krijgt op de kaart de klasse Hoofdweg.";
		attribute<Bool> Water        (BGT) := id(BGT) == V/waterdeel_watervlakte || id(BGT) == V/waterdeel_waterloop || id(BGT) == V/waterdeel_Zee;
		attribute<Bool> Zee          (BGT) := id(BGT) == V/waterdeel_Zee;
		attribute<Bool> Hoofdweg     (BGT) :=
			id(BGT) == V/wegdeel_rijbaan_autosnelweg || id(BGT) == V/wegdeel_rijbaan_autoweg || id(BGT) == V/wegdeel_rijbaan_regionale_weg || id(BGT) == V/wegdeel_rijbaan_lokale_weg ||
			id(BGT) == V/wegdeel_parkeervlak || id(BGT) == V/wegdeel_overweg || id(BGT) == V/wegdeel_brug_viaduct ||
			id(BGT) == V/overbruggingsdeel_waardeOnbekend || id(BGT) == V/overbruggingsdeel_brug || id(BGT) == V/overbruggingsdeel_viaduct || id(BGT) == V/overbruggingsdeel_ecoduct || id(BGT) == V/overbruggingsdeel_fly_over || id(BGT) == V/overbruggingsdeel_aquaduct ||
			id(BGT) == V/ondersteunendwegdeel_berm || id(BGT) == V/ondersteunendwegdeel_verkeerseiland || id(BGT) == V/ondersteunendwegdeel_transitie
		, Descr = "De rijbanen en hun bermen samen. Een berm hoort erbij omdat een cel alleen haalt wat breed genoeg is: een smalle landweg met bermen blijft onder de halve cel, een brede weg met bermen niet.";
		attribute<Bool> Spoor        (BGT) := id(BGT) == V/wegdeel_Spoorbaan || id(BGT) == V/wegdeel_OV_baan || id(BGT) == V/kunstwerkdeel_perron;
		attribute<Bool> Vliegbaan    (BGT) := id(BGT) == V/wegdeel_baan_voor_vliegverkeer;
		attribute<Bool> Groen        (BGT) := id(BGT) == V/begroeidterreindeel_groenvoorziening;
		attribute<Bool> Bos          (BGT) := id(BGT) == V/begroeidterreindeel_gemengd_bos || id(BGT) == V/begroeidterreindeel_loofbos || id(BGT) == V/begroeidterreindeel_naaldbos || id(BGT) == V/begroeidterreindeel_houtwal || id(BGT) == V/begroeidterreindeel_struiken;
		attribute<Bool> NatuurNat    (BGT) := id(BGT) == V/begroeidterreindeel_moeras || id(BGT) == V/begroeidterreindeel_rietland || id(BGT) == V/begroeidterreindeel_kwelder;
		attribute<Bool> Woonomgeving (BGT) :=
			id(BGT) == V/onbegroeidterreindeel_erf || id(BGT) == V/wegdeel_rijbaan_lokale_weg || id(BGT) == V/wegdeel_parkeervlak || id(BGT) == V/wegdeel_fietspad || id(BGT) == V/wegdeel_inrit ||
			id(BGT) == V/wegdeel_voetgangersgebied || id(BGT) == V/wegdeel_voetpad || id(BGT) == V/wegdeel_voetpad_op_trap || id(BGT) == V/wegdeel_woonerf
		, Descr = "Erven en straten; telt binnen een BRT-woonkern als woonterrein, ook waar in de cel zelf geen woning staat.";
	}
}