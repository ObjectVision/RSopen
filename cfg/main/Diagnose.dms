////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Tijdelijk controle-harnas voor #639. Elke regel in de tabel Checks wordt een parameter die zijn waarde naar
// een tekstbestand schrijft, zodat de uitkomsten buiten de GUI leesbaar zijn en een run in de batch te
// beoordelen is. Casus en zichtjaar komen uit de omgevingsvariabelen DiagCasus en DiagJaar.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose
: Descr = "Tijdelijk controle-harnas voor #639: schrijft de waarde van een set indicatoren naar losse tekstbestanden."
{
	parameter<String> Casus   := replace_value(expand(., '%env:DiagCasus%'), 'env:DiagCasus', 'WLO_hoog_NbSGenuanceerd');
	parameter<String> Jaar    := replace_value(expand(., '%env:DiagJaar%'),  'env:DiagJaar',  'Y2030');
	parameter<String> Variant := replace(Casus, 'WLO_hoog_', '');

	parameter<String> Pad_Z := '/Indicatoren/'+Casus+'/Zichtjaren/'+Jaar+'/';
	parameter<String> Pad_V := '/VariantData/'+Variant+'/';
	parameter<String> Pad_A := '/Allocatie/'+Casus+'/Zichtjaren/'+Jaar+'/';

	unit<uint32> Checks : nrofrows = 32
	{
		//                        pad, aggregatie, item
		//   pad: Z = onder het zichtjaar van de indicatoren, V = variantdata, A = allocatie
		//   aggr: p = parameter, s = som over grid, b = aantal cellen waar waar, c = aantal gevulde cellen, l = lijst per regio, m = maximum
		attribute<String> name :
		[
			 'stand_woningen', 'stand_banen'
			,'claimreal_NL_woningen', 'claimreal_NL_banen'
			,'claimreal_NVM_woningen', 'claimreal_Provincie_banen', 'claimreal_Waterberging'
			,'verstedelijking_ha', 'verstedelijking_vruchtbaar_ha'
			,'nieuwenatuur_ha', 'nieuwenatuur_vruchtbaar_ha'
			,'waterbergingveen_ha', 'waterbergingveen_vruchtbaar_ha'
			,'inbreiding_fractie', 'verharding_som', 'lu2120_areaal_natuur'
			,'woningwaarde_nieuwbouw', 'groenwaarde_woningen'
			,'uitkoop_nieuwenatuur', 'sloop_nieuwenatuur'
			,'uitkoop_waterberging', 'sloop_waterberging'
			,'mortaliteit', 'carbon_flow', 'somers_mediaan'
			,'nietbouwen_landschap_cellen', 'nietbouwen_metsloop_woningen', 'exogeen_cellen'
			,'groenopslag_max', 'groenopslag_min'
			,'exogeen_gespaard_ha', 'exogeen_gespaard_woningen'
		];

		attribute<String> pad :
		[
			 'Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'V','V','V'
			,'A','A'
			,'V','V'
		];

		attribute<String> aggr :
		[
			 's','s'
			,'s','s'
			,'l','l','l'
			,'p','p'
			,'p','p'
			,'p','p'
			,'p','s','p'
			,'s','s'
			,'s','s'
			,'s','s'
			,'p','s','s'
			,'b','p','p'
			,'m','n'
			,'p','p'
		];

		attribute<String> item :
		[
			 'Stand/Aantal_Woningen_Totaal', 'Stand/Aantal_Banen_Totaal'
			,'ClaimRealisatie/Per_AllocRegio/Nederland/InDezeStudie/Aantal_Woningen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Nederland/InDezeStudie/Banen_Totaal'
			,'ClaimRealisatie/Per_AllocRegio/NVM/InDezeStudie/Aantal_Woningen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Provincie/InDezeStudie/Banen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/InDezeStudie/meter3_Waterberging'
			,'Grondgebruik/Verandering/Verstedelijking/Per_NL', 'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_NL'
			,'Grondgebruik/Verandering/NieuweNatuur/Per_NL', 'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_NL'
			,'Grondgebruik/Verandering/WaterbergingVeen/Per_NL', 'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_NL'
			,'Inbreiding/FractieWoningenErbijInBestaandBebouwdGebied', 'Verharding/Result', 'LandgebruikskaartNL2120/Areaal_Natuur'
			,'Woningwaarde/Nieuwbouw', 'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen'
			,'UitkoopEnSloopkostenNieuweNatuur/Uitkoopkosten', 'UitkoopEnSloopkostenNieuweNatuur/Sloopkosten'
			,'UitkoopEnSloopkostenWaterbergingVeen/Uitkoopkosten', 'UitkoopEnSloopkostenWaterbergingVeen/Sloopkosten'
			,'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameCumulatief_Totaal', 'CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar', 'SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA'
			,'NietBouwen/Landschapstoekomstbeeld/Totaal', 'NietBouwen/Landschapstoekomstbeeld/WoningenOpSlotMaarNietOpgelegd', 'ExogeenOpleggen/CountCellenOplegging'
			,'GroenNabijheid/Prijsopslag_perWP4/vrijstaand', 'GroenNabijheid/Prijsopslag_perWP4/vrijstaand'
			,'ExogeenOpleggen/Opp_GespaardInBebouwdGebied', 'ExogeenOpleggen/Woningen_GespaardInBebouwdGebied'
		];
	}

	container Resultaten :=
		for_each_ne(
			Checks/name
			, 'Check_T('+quote(Checks/name)+', '+quote(Checks/pad)+', '+quote(Checks/aggr)+', '+quote(Checks/item)+')'
		);

	parameter<String> GenerateAll := 'Klaar', ExplicitSuppliers = "=AsList('Resultaten/'+Checks/name+'/Waarde', ';')";

	Template Check_T
	{
		parameter<String> naam;
		parameter<String> pad;
		parameter<String> aggr;
		parameter<String> item;
		//

		parameter<String> VolPad := (pad == 'Z' ? /Diagnose/Pad_Z : pad == 'V' ? /Diagnose/Pad_V : /Diagnose/Pad_A) + item;

		parameter<String> Expr :=
			  aggr == 'p' ? 'string(value('+VolPad+', float32))'
			: aggr == 's' ? 'string(sum(value('+VolPad+', float32)))'
			: aggr == 'b' ? 'string(sum(uint32('+VolPad+')))'
			: aggr == 'c' ? 'string(sum(uint32(IsDefined('+VolPad+'))))'
			: aggr == 'm' ? 'string(max(value('+VolPad+', float32)))'
			: aggr == 'n' ? 'string(min(value('+VolPad+', float32)))'
			: 'AsList(string(value('+VolPad+', float32)), ('+quote(';')+'))';

		parameter<String> Waarde := =Expr
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_'+naam+'.txt'"
		, StorageType = "str";
	}
	parameter<String> NVM_namen := AsList(/SourceData/RegioIndelingen/NVM/name, ';')
	, StorageName = "='%LocalDataProjDir%/Diagnose/NVM_namen.txt'"
	, StorageType = "str";

	parameter<String> gesloopt_natuur := =('string('+Pad_Z+'UitkoopEnSloopkostenNieuweNatuur/GesloopteWoningen_Per_NL)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/gesloopt_natuur.txt'"
	, StorageType = "str";

	parameter<String> gesloopt_waterberging := =('string('+Pad_Z+'UitkoopEnSloopkostenWaterbergingVeen/GesloopteWoningen_Per_NL)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/gesloopt_waterberging.txt'"
	, StorageType = "str";

	// --- inbreiding: teller en noemer los, plus de omvang van het BBG-masker ---
	parameter<String> inbr_teller := =('string(sum('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar * float32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/inbr_teller.txt'", StorageType = "str";

	parameter<String> inbr_noemer := =('string(sum('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/inbr_noemer.txt'", StorageType = "str";

	parameter<String> inbr_bbg_cellen := =('string(sum(uint32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/inbr_bbg_cellen.txt'", StorageType = "str";

	// --- waterberging: hoeveel is er cumulatief afgewezen wegens clusteromvang ---
	parameter<String> wb_pad := '/Allocatie/'+Casus+'/Zichtjaren/'+Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_14/Allocatie/';

	parameter<String> wb_afgewezen := =('string(sum(uint32('+wb_pad+'IsAfgewezen_Cumulatief)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/wb_afgewezen.txt'", StorageType = "str";

	parameter<String> wb_grootgenoeg := =('string(sum(uint32('+wb_pad+'IsAllocGroupLargeEnough)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/wb_grootgenoeg.txt'", StorageType = "str";

	// --- inbreiding bruto: gebouwd en gesloopt binnen BBG apart ---
	parameter<String> inbr_bruto_bij_bbg := =('string(sum(max_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/inbr_bruto_bij_bbg.txt'", StorageType = "str";

	parameter<String> inbr_bruto_af_bbg := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/inbr_bruto_af_bbg.txt'", StorageType = "str";

	parameter<String> inbr_bruto_bij_nl := =('string(sum(max_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/inbr_bruto_bij_nl.txt'", StorageType = "str";

	// --- sloop uitgesplitst naar oorzaak (voorstel Jip): exogeen, gealloceerd, rest ---
	parameter<String> sloop_exogeen := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32('+Pad_Z+'UitkoopEnSloopkostenNieuweNatuur/IsExogeneSloopCel)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/sloop_exogeen.txt'", StorageType = "str";

	parameter<String> sloop_gealloceerd := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32(!'+Pad_Z+'UitkoopEnSloopkostenNieuweNatuur/IsExogeneSloopCel && IsDefined('+Pad_Z+'Stand/Sector_rel))))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/sloop_gealloceerd.txt'", StorageType = "str";

	parameter<String> sloop_rest := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32(!'+Pad_Z+'UitkoopEnSloopkostenNieuweNatuur/IsExogeneSloopCel && !IsDefined('+Pad_Z+'Stand/Sector_rel))))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/sloop_rest.txt'", StorageType = "str";

	// --- clusteranalyse waterberging, los van de allocatie ---
	container WaterbergingClusters
	: Descr = "Aaneengesloten beschikbaar areaal voor waterberging binnen de veen-deelgebieden, met dezelfde district_8-methode als de allocatie maar zonder die te herrekenen."
	{
		attribute<Bool> IsVeenDeelgebied (/Geography/AdminDomain) :=
			MakeDefined(!/SourceData/RegioIndelingen/Waterbergingsregio/IsRestRegio[/SourceData/RegioIndelingen/Waterbergingsregio/Per_AdminDomain], FALSE);

		attribute<Bool> Beschikbaar_Compacted (/Geography/CompactedAdminDomain) :=
			=/Diagnose/Pad_V+'PotentieleState/'+/Diagnose/Jaar+'/per_SectorxSubsectoren/Waterberging/Totaal/IsBeschikbaar_zichtjaar';

		attribute<Bool> Beschikbaar (/Geography/AdminDomain) :=
			MakeDefined(recollect_by_cond(/Geography/AdminDomain/IsCompactedDomain, Beschikbaar_Compacted), FALSE) && IsVeenDeelgebied;

		unit<uint32> Clusters := district_8(Beschikbaar)
		{
			attribute<float32> Oppervlakte_ha (/Geography/AdminDomain) :=
				(pcount(Districts)[float32] * float32(/Geography/AdminDomain/NrHaPerCell))[Districts];
		}

		parameter<float32> HaPerCel        := float32(/Geography/AdminDomain/NrHaPerCell);
		parameter<float32> Areaal_totaal   := sum(float32(Beschikbaar)) * HaPerCel;
		parameter<float32> Areaal_vanaf2ha := sum(float32(Beschikbaar && Clusters/Oppervlakte_ha >= 2f)) * HaPerCel;
		parameter<float32> Areaal_onder2ha := sum(float32(Beschikbaar && Clusters/Oppervlakte_ha <  2f)) * HaPerCel;
		parameter<float32> Grootste_cluster := max(Clusters/Oppervlakte_ha);

		parameter<String> Samenvatting :=
			  'beschikbaar_totaal_ha;'  + string(Areaal_totaal)
			+ ';beschikbaar_vanaf2ha;'  + string(Areaal_vanaf2ha)
			+ ';beschikbaar_onder2ha;'  + string(Areaal_onder2ha)
			+ ';grootste_cluster_ha;'   + string(Grootste_cluster)
			+ ';aantal_clusters;'       + string(#Clusters)
		, StorageName = "='%LocalDataProjDir%/Diagnose/wb_clusters.txt'", StorageType = "str";
	}

	// --- bebouwd gebied: nieuwe begrenzing tegenover de oude unie ---
	parameter<String> bbg_nieuw_cellen := 'x'
	, StorageName = "='%LocalDataProjDir%/Diagnose/bbg_nieuw_cellen.txt'", StorageType = "str";

	parameter<String> bbg_vergelijk :=
		  'nieuw_cellen;'   + string(sum(uint32(/BaseData/Omgeving/BBGSamengesteld)))
		+ ';oud_cellen;'    + string(sum(uint32(/BaseData/Omgeving/BBGSamengesteld_Unie)))
		+ ';nieuw_ha;'      + string(sum(float32(/BaseData/Omgeving/BBGSamengesteld)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ ';oud_ha;'        + string(sum(float32(/BaseData/Omgeving/BBGSamengesteld_Unie)) * float32(/Geography/AdminDomain/NrHaPerCell))
	, StorageName = "='%LocalDataProjDir%/Diagnose/bbg_vergelijk.txt'", StorageType = "str";

	// --- claimvintage: was de claim al gehaald voor de allocatie begon? ---
	parameter<String> restclaim_pad := Pad_A + 'StateVoorAllocatie/RestClaims/';

	parameter<String> restclaim_wonen := =('
		  '+quote('nr_regios;')+' + string('+restclaim_pad+'Wonen/NrRegios)
		+ '+quote(';al_gehaald_voor_alloc;')+' + string('+restclaim_pad+'Wonen/NrRegiosAlGehaald)
		+ '+quote(';restclaim_totaal;')+' + string(sum('+restclaim_pad+'Wonen/Totaal_RestClaim))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/restclaim_wonen.txt'", StorageType = "str";

	parameter<String> restclaim_werken := =('
		  '+quote('nr_regios;')+' + string('+restclaim_pad+'Werken/NrRegios)
		+ '+quote(';al_gehaald_voor_alloc;')+' + string('+restclaim_pad+'Werken/NrRegiosAlGehaald)
		+ '+quote(';restclaim_totaal;')+' + string(sum('+restclaim_pad+'Werken/Totaal_RestClaim))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/restclaim_werken.txt'", StorageType = "str";

	// --- restclaim per NVM-regio, om vintage van lek te scheiden ---
	parameter<String> restclaim_wonen_perregio := =('AsList(string('+restclaim_pad+'Wonen/Totaal_RestClaim), '+quote(';')+')')
	, StorageName = "='%LocalDataProjDir%/Diagnose/restclaim_wonen_perregio.txt'", StorageType = "str";

	parameter<String> restclaim_werken_perregio := =('AsList(string('+restclaim_pad+'Werken/Totaal_RestClaim), '+quote(';')+')')
	, StorageName = "='%LocalDataProjDir%/Diagnose/restclaim_werken_perregio.txt'", StorageType = "str";

	// --- de claimrealisatietoets zelf uitlezen ---
	parameter<String> claimtoets := =('
		  '+quote('regios;')+'      + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_Regios)
		+ '+quote(';al_gehaald;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_AlGehaald)
		+ '+quote(';telt_mee;')+'    + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_TeltMee)
		+ '+quote(';op_norm;')+'     + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_OpNorm)
		+ '+quote(';onder_norm;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_OnderNorm)
		+ '+quote(';boven_norm;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_BovenNorm)
		+ '+quote(';tekort;')+'      + string('+Pad_Z+'ClaimRealisatie_Toets/Tekort_woningen)
		+ '+quote(';overschot;')+'   + string('+Pad_Z+'ClaimRealisatie_Toets/Overschot_woningen)
		+ '+quote(';saldo;')+'       + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_woningen)
		+ '+quote(';saldo_algehaald;')+' + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_AlGehaald)
		+ '+quote(';saldo_alles;')+'     + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_Alles)
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/claimtoets.txt'", StorageType = "str";

	// --- grondbalans: sluit de verdwenen landbouw op de nieuwe bestemmingen? ---
	parameter<String> grondbalans := =('
		  '+quote('verdwenen_landbouw_ha;')+'    + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';verdwenen_vruchtbaar_ha;')+' + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/grondbalans.txt'", StorageType = "str";

	// --- waterberging: past de opgave uberhaupt in het beschikbare bergingsvolume? ---
	container WaterbergingVolume
	: Descr = "Per waterbergingsregio de opgave in m3 naast het bergingsvolume dat in alle beschikbare cellen samen zit. Dat volume is precies het gewicht waarmee IterSubsector_T de zaaglijn bepaalt: nth_element_weighted telt cellen op in volgorde van geschiktheid tot het gewicht de restclaim haalt. Is de som over alle beschikbare cellen kleiner dan de opgave, dan wordt de zaaglijn undefined, valt hij terug op 0, wordt alles gealloceerd en blijft de realisatie per definitie onder 1. Meer iteraties helpen dan niet. Deze container rekent de allocatie niet mee."
	{
		unit<uint32> Regio := /SourceData/RegioIndelingen/Waterbergingsregio;

		parameter<String> Scenario := replace(/Diagnose/Casus, '_'+/Diagnose/Variant, '')
		, Descr = "De casusnaam zonder de variantnaam, dus het scenario waaronder de claims hangen.";

		attribute<float32> Volume_perCel (/Geography/CompactedAdminDomain) :=
			=/Diagnose/Pad_V+'PotentieleState/'+/Diagnose/Jaar+'/per_SectorxSubsectoren/Waterberging/Totaal/Zichtjaar'
		, Descr = "Bergingsvolume in m3 per cel, al vermenigvuldigd met de beschikbaarheid in dit zichtjaar.";

		attribute<bool> IsDiepGenoeg (/Geography/CompactedAdminDomain) :=
			collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg)
		, Descr = "Haalt de cel de Minimum_Waterschijf? Zo niet, dan is de geschiktheid exact 0 en staat de cel onderaan de rij, maar hij blijft alloceerbaar.";

		attribute<Regio> Regio_rel (/Geography/CompactedAdminDomain) := /SourceData/RegioIndelingen/Waterbergingsregio/Per_CompactedAdminDomain;

		attribute<float32> Claim_m3       (Regio) := =/Diagnose/Pad_V+'Claims/'+/Diagnose/WaterbergingVolume/Scenario+'/Zichtjaren/'+/Diagnose/Jaar+'/SectorAllocRegios/Waterbergingsregio_Waterberging/Totaal';
		attribute<float32> Volume_m3      (Regio) := sum(Volume_perCel, Regio_rel);
		attribute<float32> Volume_diep_m3 (Regio) := sum(Volume_perCel * float32(IsDiepGenoeg), Regio_rel)
		, Descr = "Alleen de cellen met een waterschijf vanaf Minimum_Waterschijf, dus de cellen met een geschiktheid boven nul.";
		attribute<float32> Cellen         (Regio) := sum(float32(Volume_perCel > 0f), Regio_rel);
		attribute<float32> Dekking        (Regio) := Volume_m3 / Claim_m3;
		attribute<float32> Dekking_diep   (Regio) := Volume_diep_m3 / Claim_m3;

		attribute<float32> Cellen_totaal (Regio) := sum(float32(IsDefined(Regio_rel)), Regio_rel)
		, Descr = "Alle cellen in de regio, ongeacht beschikbaarheid, zodat een lege regio te onderscheiden is van een regio zonder beschikbare cellen.";

		attribute<String> Regel (Regio) :=
			MakeDefined(Regio/label, 'null') + ';' + string(MakeDefined(Claim_m3, -1f)) + ';' + string(MakeDefined(Volume_m3, -1f)) + ';' + string(MakeDefined(Volume_diep_m3, -1f))
			+ ';' + string(MakeDefined(Cellen, -1f)) + ';' + string(MakeDefined(Cellen_totaal, -1f)) + ';' + string(MakeDefined(Dekking, -1f));

		parameter<String> Samenvatting :=
			'regio;claim_m3;volume_m3;volume_diep_m3;cellen_beschikbaar;cellen_totaal;dekking|' + AsList(Regel, '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/wb_volume.txt'", StorageType = "str";
	}

	// --- waterberging: convergeert de allocatie binnen het aantal iteraties? ---
	container WaterbergingIteraties
	: Descr = "Per iteratie de landelijke stand waterberging in m3 en het aantal cumulatief afgewezen cellen. Ligt de reeks aan het eind vlak, dan is het aantal iteraties niet de beperking en zit de rem in de morfologische cleaning en de minimale clusteromvang. Stijgt hij aan het eind nog, dan helpt ophogen van Default_NrOfIters wel. Het aantal iteraties volgt Default_NrOfIters, zodat deze container meebeweegt met de instelling die getest wordt."
	{
		parameter<String> PadIter := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/';

		unit<uint8> Iters := range(uint8, 0b, /ModelParameters/Default_NrOfIters)
		{
			attribute<String> name := 'Iter_'+string(id(.));
			attribute<String> expr :=
				  quote(name+';')
				+ ' + string(sum('+PadIter+name+'/Stand_PerAllocRegio/Waterberging/Totaal))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen_Cumulatief)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector))))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen)))'
				+ ' + ' + quote('|');
		}

		parameter<String> Samenvatting := =quote('iter;stand_m3;afgewezen_cumulatief;gealloceerd_deze_iter;afgewezen_deze_iter|')+' + '+AsList(Iters/expr, ' + ')
		, StorageName = "='%LocalDataProjDir%/Diagnose/wb_convergentie.txt'", StorageType = "str";
	}

	// --- verharding: welke Copernicus-kaart is actief, en verschilt 2024 van 2021? ---
	parameter<String> imperviousness :=
		  'jaar;'        + /ModelParameters/Advanced/ImperviousnessMapYear
		+ ';gem_2021;'   + string(mean(float32(/SourceData/Grondgebruik/Imperviousness_Map/Y2021_25m)))
		+ ';gem_2024;'   + string(mean(float32(/SourceData/Grondgebruik/Imperviousness_Map/Y2024_25m)))
		+ ';gem_actief;' + string(mean(float32(/SourceData/Grondgebruik/Imperviousness_Map/InProcent)))
		+ ';verhardingsbestand;' + /Classifications/Grondgebruik/BGT/Classes/Verharding_Impl/VerhardingFile
	, StorageName = "='%LocalDataProjDir%/Diagnose/imperviousness.txt'", StorageType = "str"
	, Descr = "Controle op de jaarschakelaar van de Copernicus-verhardingskaart. gem_actief hoort gelijk te zijn aan het jaar dat in ModelParameters/Advanced/ImperviousnessMapYear staat.";

	// --- waterberging: hoe versnipperd is wat de zaaglijn uitkiest? ---
	container WaterbergingClusterVerdeling
	: Descr = "Verdeling van de gealloceerde cellen over clustergroottes in iteratie 0, dus wat de zaaglijn uitkiest voordat de toets op clusteromvang er iets van weggooit. Leest de districten die de allocatie zelf al bepaalt. Hiermee is te zien of de ondergrens van 2 ha te hoog is of dat de selectie versnipperd is."
	{
		parameter<String> PadIter0 := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_0/Allocatie/';

		attribute<Bool>    Gealloceerd (/Geography/AdminDomain) := =PadIter0+'Cleaned';
		attribute<float32> ClusterOpp  (/Geography/AdminDomain) := =PadIter0+'VindAangeslotenCellen/Oppervlakte';

		parameter<float32> HaPerCel := float32(/Geography/AdminDomain/NrHaPerCell);

		parameter<float32> Totaal_ha    := sum(float32(Gealloceerd)) * HaPerCel;
		parameter<float32> Onder04_ha   := sum(float32(Gealloceerd && ClusterOpp <  0.4f)) * HaPerCel;
		parameter<float32> Van04tot1_ha := sum(float32(Gealloceerd && ClusterOpp >= 0.4f && ClusterOpp < 1f)) * HaPerCel;
		parameter<float32> Van1tot2_ha  := sum(float32(Gealloceerd && ClusterOpp >= 1f   && ClusterOpp < 2f)) * HaPerCel;
		parameter<float32> Vanaf2_ha    := sum(float32(Gealloceerd && ClusterOpp >= 2f)) * HaPerCel;
		parameter<float32> Grootste_ha  := max(ClusterOpp * float32(Gealloceerd));

		parameter<String> Samenvatting :=
			  'gealloceerd_ha;'   + string(Totaal_ha)
			+ ';onder_0,4ha;'     + string(Onder04_ha)
			+ ';0,4_tot_1ha;'     + string(Van04tot1_ha)
			+ ';1_tot_2ha;'       + string(Van1tot2_ha)
			+ ';vanaf_2ha;'       + string(Vanaf2_ha)
			+ ';grootste_cluster_ha;' + string(Grootste_ha)
		, StorageName = "='%LocalDataProjDir%/Diagnose/wb_clusterverdeling.txt'", StorageType = "str";
	}

	// --- waterberging: zit de gerealiseerde berging wel in cellen die diep genoeg zijn? ---
	container WaterbergingDiepte
	: Descr = "Splitst de gerealiseerde berging naar cellen die de Minimum_Waterschijf wel en niet halen. Cellen die hem niet halen krijgen geschiktheid 0, maar dat sluit ze niet uit; ze tellen wel met hun volle volume mee in de claimrealisatie. Wat hier bij te_ondiep staat is berging die op papier meetelt maar er fysiek niet in past."
	{
		parameter<String> PadLaatste := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_'+string(/ModelParameters/Default_NrOfIters - 1b)+'/';

		attribute<float32> Stand        (/Geography/CompactedAdminDomain) := =PadLaatste+'StateNaAllocatie/Waterberging/Totaal';
		attribute<bool>    IsDiepGenoeg (/Geography/CompactedAdminDomain) :=
			collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg);

		parameter<float32> HaPerCel := float32(/Geography/AdminDomain/NrHaPerCell);

		parameter<String> Samenvatting :=
			  'totaal_m3;'      + string(sum(Stand))
			+ ';diep_genoeg_m3;'+ string(sum(Stand * float32(IsDiepGenoeg)))
			+ ';te_ondiep_m3;'  + string(sum(Stand * float32(!IsDiepGenoeg)))
			+ ';totaal_ha;'     + string(sum(float32(Stand > 0f)) * HaPerCel)
			+ ';te_ondiep_ha;'  + string(sum(float32(Stand > 0f && !IsDiepGenoeg)) * HaPerCel)
		, StorageName = "='%LocalDataProjDir%/Diagnose/wb_diepte.txt'", StorageType = "str";
	}

	// --- claimrealisatie werken per Jobs6-subsector, en de grondbalans na de #634-correctie ---
	parameter<String> claimtoets_werken := =('string('+Pad_Z+'ClaimRealisatie_Toets_Werken/Samenvatting)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/claimtoets_werken.txt'", StorageType = "str";

	parameter<String> grondbalans_bestemmingen := =('
		  '+quote('verdwenen_vruchtbaar_ha;')+'      + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';verstedelijking_vruchtbaar_ha;')+' + string('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_NL)
		+ '+quote(';nieuwenatuur_vruchtbaar_ha;')+'    + string('+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_NL)
		+ '+quote(';waterberging_vruchtbaar_ha;')+'    + string('+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_NL)
		+ '+quote(';overlap_verst_natuur_ha;')+'      + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';overlap_verst_wb_ha;')+'          + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';overlap_natuur_wb_ha;')+'         + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/grondbalans_bestemmingen.txt'", StorageType = "str"
	, Descr = "Sluit de verdwenen vruchtbare landbouw op de drie bestemmingen? Met de oude definitie (klasse A, ongeacht vorig gebruik) telden de bestemmingen samen op tot meer dan het verlies. Zie #634.";

	// --- wonen: doet de clustertoets hetzelfde als bij waterberging? ---
	container WonenIteraties
	: Descr = "Per iteratie de stand woningen, het aantal gealloceerde en afgewezen cellen, en de splitsing binnenstedelijk tegen buitenstedelijk. Bedoeld om te zien of de vormtoetsen bij wonen dezelfde rem vormen als bij waterberging: kan een cluster aangroeien, en vallen binnenstedelijke locaties vaker af. Draai dit met alleen de regel Wonen op NVM in ModelParameters/SectorAllocRegio."
	{
		parameter<String> PadIter := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/NVM_Wonen/Iters_Normaal/';

		unit<uint8> Iters := range(uint8, 0b, /ModelParameters/Default_NrOfIters)
		{
			attribute<String> name := 'Iter_'+string(id(.));
			attribute<String> expr :=
				  quote(name+';')
				+ ' + string(sum('+PadIter+name+'/Stand_PerAllocRegio/wonen/Aantal_Woningen_Totaal))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector))))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen_Cumulatief)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector) && collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain))))'
				+ ' + ' + quote('|');
		}

		parameter<String> Samenvatting := =quote('iter;stand_woningen;gealloceerd;afgewezen_deze_iter;afgewezen_cumulatief;gealloceerd_in_woonkern|')+' + '+AsList(Iters/expr, ' + ')
		, StorageName = "='%LocalDataProjDir%/Diagnose/wonen_convergentie.txt'", StorageType = "str";
	}

	// --- werken: dezelfde meting als bij wonen ---
	container WerkenIteraties
	: Descr = "Per iteratie de stand banen, het aantal gealloceerde en afgewezen cellen, en de splitsing binnenstedelijk tegen buitenstedelijk, voor de regel Werken op NVM. Draai dit met alleen die regel in ModelParameters/SectorAllocRegio. Zie #643."
	{
		parameter<String> PadIter := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/NVM_Werken/Iters_Normaal/';
		parameter<String> StandExpr := 'add('+AsList('@P@Stand_PerAllocRegio/Werken/'+/Classifications/Actor/Jobs6/name, ', ')+')'
		, Descr = "Som over de zes Jobs6-subsectoren. @P@ is de plek waar het iteratiepad in komt; dat hoort per item en niet voor de add.";

		unit<uint8> Iters := range(uint8, 0b, /ModelParameters/Default_NrOfIters)
		{
			attribute<String> name := 'Iter_'+string(id(.));
			attribute<String> expr :=
				  quote(name+';')
				+ ' + string(sum('+replace(StandExpr, '@P@', PadIter+name+'/')+'))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector))))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen_Cumulatief)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector) && collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain))))'
				+ ' + ' + quote('|');
		}

		parameter<String> Samenvatting := =quote('iter;stand_banen;gealloceerd;afgewezen_deze_iter;afgewezen_cumulatief;gealloceerd_in_woonkern|')+' + '+AsList(Iters/expr, ' + ')
		, StorageName = "='%LocalDataProjDir%/Diagnose/werken_convergentie.txt'", StorageType = "str";
	}

}
