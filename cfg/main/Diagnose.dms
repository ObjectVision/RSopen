////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Het controleharnas van RSopen. De tabel Checks maakt per regel een parameter die zijn waarde naar een
// tekstbestand schrijft, per casus en zichtjaar; ChecksBasisjaar doet hetzelfde voor grootheden van het
// basisjaar, een keer per casus. De thematische containers eronder schrijven de uitdraaien die niet in een
// getal passen. Casus en zichtjaar komen uit de omgevingsvariabelen DiagCasus en DiagJaar. Aanroep:
// GenerateAll per zichtjaar en GenerateBasisjaar per casus, allebei vanuit batch/RunAllocatie.ps1. De norm van een
// regel staat in de kolommen norm_onder en norm_boven, en Uitvoer schrijft per casus en zichtjaar een csv met
// het oordeel, die batch/ToetsOplevering.ps1 leest (#833).
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose
: Descr = "Het controleharnas: schrijft per casus en zichtjaar een set controlewaarden naar losse tekstbestanden onder %LocalDataProjDir%/Diagnose, en daarnaast de thematische uitdraaien die niet
			in een getal passen. Alles wat hier staat draait mee in GenerateAll of GenerateBasisjaar, behalve wat de Descr van zijn container als op aanvraag aanmerkt; wie zo'n uitdraai leest
			controleert de mtime tegen de eigen run, want een oude uitdraai blijft staan. Een harnas dat een vraag uit een issue beantwoordt is tijdelijk en gaat weg zodra het issue dicht is,
			de meting staat dan in het issue; wat blijft heeft een thematische naam en, waar het een controlewaarde is, een norm in norm_onder en norm_boven van Checks of ChecksBasisjaar."
{
	parameter<String> Casus                    := replace_value(expand(., '%env:DiagCasus%'), 'env:DiagCasus', 'WLO_hoog_NbSGenuanceerd');
	parameter<String> Jaar                     := =replace_value(expand(., '%env:DiagJaar%'),  'env:DiagJaar',  quote('Y'+string(ModelParameters/Model_FirstZichtjaar))), Descr = "Het zichtjaar waarover de controlewaarden gaan. Zonder de omgevingsvariabele DiagJaar valt hij terug op het eerste zichtjaar van de allocatie. Als string met aanhalingstekens, want hij komt in een meta-expressie terecht: DiagJaar is dan 'Y2040' en niet Y2040.";
	parameter<String> Variant                  := replace(Casus, 'WLO_hoog_', '');

	parameter<String> Pad_Z                    := '/Indicatoren/'+Casus+'/Zichtjaren/'+Jaar+'/';
	parameter<String> Pad_V                    := '/VariantData/'+Variant+'/';
	parameter<String> Pad_A                    := '/Allocatie/'+Casus+'/Zichtjaren/'+Jaar+'/';
	parameter<String> Pad_B                    := '/Diagnose/Basisjaar/', Descr = "De container Basisjaar hieronder, het pad van de rijen in ChecksBasisjaar.";
	parameter<String> Pad_D                    := '/Diagnose/', Descr = "Dit harnas zelf, voor rijen in Checks die een parameter uit een thematische container lezen.";

	container Voorwaarde
	: Descr = "Wanneer een controle zinvol is, als korte namen voor de kolom vereist van Checks en voor de uitdraaien die buiten die tabel staan. Een sector die niet in ModelParameters/SectorAllocRegio staat,
				of een indicatordomein dat de projectlijn niet levert (ModelParameters/Indicatoren/Domein), zet een controle op null en een uitdraai op een regel niet_van_toepassing, zodat een run met
				alleen wonen en werken dit harnas zonder fouten doorloopt; batch/ToetsOplevering.ps1 telt beide als niet van toepassing."
	{
		parameter<Bool>   MetWonen                       := /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWonenSector;
		parameter<Bool>   MetWerken                      := /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWerkenSector;
		parameter<Bool>   MetWaterberging                := /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWaterbergingSector;
		parameter<Bool>   MetVerblijfsrecreatie          := /ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector;
		parameter<Bool>   MetNbSGenuanceerd              := any(/VariantParameters/VariantK/name == 'NbSGenuanceerd'), Descr = "Staat de variant NbSGenuanceerd in VariantK? De diagnoses van de landschapsleveringen lezen die variant bij naam; zonder haar staan ze leeg (pbl-nl/model-RSopen#53).";
		parameter<Bool>   ProvincieAlsAllocRegio         := any(lowercase(/ModelParameters/SectorAllocRegio/Uq_AllocRegios/AllocRegio_name) == lowercase('Provincie')), Descr = "Is de provincie een allocatieregio? Alleen dan bestaat de claimrealisatie per provincie waar claimreal_Provincie_banen naar kijkt. In NL2120 komt hij mee met de landbouw; een projectlijn zonder landbouw, zoals Space for Energy, heeft hem niet.";
		parameter<Bool>   DomeinGrondgebruik             := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Grondgebruik];
		parameter<Bool>   DomeinWonen                    := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Wonen];
		parameter<Bool>   DomeinWater                    := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Water];
		parameter<Bool>   DomeinNatuur                   := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Natuur];
		parameter<Bool>   DomeinKoolstof                 := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Koolstof];
		parameter<Bool>   DomeinSloop                    := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Sloop];
		parameter<Bool>   VerdelingWoningen              := lowercase(/ModelParameters/ClaimBasisjaar/VerdelingVerzorgend) == 'woningen' && MetWonen && MetWerken, Descr = "Volgt de claim van de verzorgende werksubsectoren de woningen die het model bouwt (ModelParameters/ClaimBasisjaar/VerdelingVerzorgend, #911)? Alleen dan bestaat het bestand met de woningen per gemeente dat Claims/Verzorgend leest.";
		parameter<Bool>   DomeinLandgebruikskaart        := /ModelParameters/Indicatoren/Domein/Actief[/ModelParameters/Indicatoren/Domein/V/Landgebruikskaart];

		parameter<String> Zonder_Wonen                   := 'niet_van_toepassing;de sector Wonen doet in deze run niet mee';
		parameter<String> Zonder_Werken                  := 'niet_van_toepassing;de sector Werken doet in deze run niet mee';
		parameter<String> Zonder_Waterberging            := 'niet_van_toepassing;de sector Waterberging doet in deze run niet mee';
		parameter<String> Zonder_DomeinLandgebruikskaart := 'niet_van_toepassing;deze projectlijn levert de landgebruikskaart niet';
		parameter<String> Zonder_DomeinWater             := 'niet_van_toepassing;deze projectlijn levert het indicatordomein Water niet, of wonen of werken doet niet mee';
	}

	// De vier kolommen hieronder en nrofrows moeten met de hand in de pas blijven. Een lijst die LANGER is
	// dan het domein valt luid om (DoArrayAssignment: Index N out of range); een lijst die KORTER is wordt
	// stil met nulls aangevuld en de uitdraai ziet er dan normaal uit. De IntegrityCheck op elke lijst vangt
	// dat tweede geval. Hij staat inline op de data, want een check op een aparte parameter geeft Invalid
	// Recursion in UpdateMetaInfo; zie de skill geodms-valkuilen.
	unit<uint32> Checks : nrofrows = 66
	{
		//                        pad, aggregatie, item
		//   pad: Z = onder het zichtjaar van de indicatoren, V = variantdata, A = allocatie, D = een parameter in dit harnas
		//   aggr: p = parameter, s = som over grid, b = aantal cellen waar waar, c = aantal gevulde cellen, l = lijst per regio, m = maximum
		attribute<String> name :
		[
			 'stand_woningen', 'stand_banen'
			,'claimreal_NL_woningen', 'claimreal_NL_banen'
			,'claimreal_wonenregio_woningen', 'claimreal_Provincie_banen', 'claimreal_Waterberging'
			,'verstedelijking_ha', 'verstedelijking_vruchtbaar_ha'
			,'nieuwenatuur_ha', 'nieuwenatuur_vruchtbaar_ha', 'verdwenennatuur_ha'
			,'waterbergingveen_ha', 'waterbergingveen_vruchtbaar_ha'
			,'inbreiding_fractie', 'verharding_som', 'lu2120_areaal_natuur'
			,'woningwaarde_nieuwbouw', 'groenwaarde_woningen'
			,'uitkoop_nieuwenatuur', 'sloop_nieuwenatuur'
			,'uitkoop_waterberging', 'sloop_waterberging'
			,'mortaliteit', 'carbon_flow', 'carbon_ongedekt', 'somers_mediaan'
			,'nietbouwen_landschap_cellen', 'sloop_opslot_geen_natuur_woningen', 'exogeen_cellen'
			// groenopslag_max en groenopslag_min lezen de prijsopslag door veranderde groen- en waternabijheid
			// op de allocatiekant. Die staat in het eerste zichtjaar per definitie op nul, zie de Descr van
			// Prijsopslag_perWP4 in Templates/Allocatie/Zichtjaar_T, dus een nul op Y2040 is geen kapotte controle.
			,'groenopslag_max', 'groenopslag_min'
			,'sloop_natuur_niet_opslot_woningen', 'sloop_opslot_geen_natuur_ha', 'sloop_natuur_niet_opslot_ha'
			,'sloop_opslot_zonder_sloopbedoeling', 'sloop_zonder_masker'
			,'sloop_zondermasker_veen', 'sloop_zondermasker_buiten'
			,'sloop_opslot_geen_natuur_veen', 'sloop_opslot_geen_natuur_kust', 'sloop_opslot_geen_natuur_rivieren'
			,'waterberging_regios_met_tekort', 'groenwaarde_lek_eur', 'verharding_cellen_gedaald', 'ijburg2_woningen_groei'
			,'koolstof_keten_null_cellen', 'koolstof_vastlegging_keten_min', 'koolstof_afboeking_keten_max'
			,'woningtype_eengezins_afwijking'
			,'claimreal_wonenregio_onder_alarm', 'grondbalans_rest_fractie'
			,'piekbui_opgave_mln_m3', 'piekbui_aanbod_op_wbcellen_mln_m3', 'piekbui_aanbod_sluiting_mln_m3', 'piekbui_schade_volume_sluiting_mln_m3', 'piekbui_schade_vermeden_fractie', 'piekbui_schade_vermeden_min_eur', 'piekbui_weguitval_km_verschil', 'piekbui_wegennet_hoofdnet_fractie', 'piekbui_wegennet_ziekenhuizen'
			,'grondexploitatie_min_boven_drempel'
			,'nieuwbouw_ver_van_kern'
			,'claimreal_wonenregio_boven_alarm'
			,'claim_verzorgend_tov_nl', 'claim_verzorgend_groei_ongeldig'
		], IntegrityCheck = "all(IsDefined(this))";

		attribute<String> pad :
		[
			 'Z','Z'
			,'Z','Z'
			,'D','Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z','Z','Z'
			,'V','V','V'
			,'A','A'
			,'V','V','V'
			,'V','V'
			,'V','V'
			,'V','V','V'
			,'D','D','D','D'
			,'D','D','D'
			,'D'
			,'D', 'D'
			,'D', 'D', 'D', 'D', 'D', 'D', 'D', 'D', 'D'
			,'Z'
			,'D'
			,'D'
			,'D', 'D'
		], IntegrityCheck = "all(IsDefined(this))";

		attribute<String> aggr :
		[
			 's','s'
			,'s','s'
			,'l','l','l'
			,'p','p'
			,'p','p','p'
			,'p','p'
			,'p','s','p'
			,'s','s'
			,'s','s'
			,'s','s'
			,'p','s','s','s'
			,'b','p','b'
			,'m','n'
			,'p','p','p'
			,'p','p'
			,'p','p'
			,'p','p','p'
			,'p','p','p','p'
			,'p','p','p'
			,'p'
			,'p', 'p'
			,'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p'
			,'p'
			,'p'
			,'p'
			,'p', 'p'
		], IntegrityCheck = "all(IsDefined(this))";

		attribute<String> item :
		[
			 'Stand/Aantal_Woningen_Totaal', 'Stand/Aantal_Banen_Totaal'
			,'ClaimRealisatie/Per_AllocRegio/Nederland/Bouwbaar_realisatie/Aantal_Woningen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Nederland/InDezeStudie/Banen_Totaal'
			,'Claims/Realisatie_WonenRegio', 'ClaimRealisatie/Per_AllocRegio/Provincie/InDezeStudie/Banen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/InDezeStudie/meter3_Waterberging'
			,'Grondgebruik/Verandering/Verstedelijking/Per_NL', 'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_NL'
			,'Grondgebruik/Verandering/NieuweNatuur/Per_NL', 'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_NL', 'Grondgebruik/Verandering/VerdwenenNatuur/Per_NL'
			,'Grondgebruik/Verandering/WaterbergingVeen/Per_NL', 'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_NL'
			,'Inbreiding/FractieWoningenErbijInBestaandBebouwdGebied', 'Verharding/Result', 'LandgebruikskaartNL2120/Areaal_Natuur'
			,'Woningwaarde/Nieuwbouw', 'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen'
			,'SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten', 'SloopAlsGevolgVanNieuweNatuur/Sloopkosten'
			,'SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten', 'SloopAlsGevolgVanWaterbergingVeen/Sloopkosten'
			,'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameCumulatief_Totaal', 'CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar', 'CarbonStorageSequestration/Write_CO2Ongedekt_Cumulatief', 'SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA'
			,'Bouwregime/OpSlotDoorLandschap', 'Sloop/Verschil/Woningen_OpSlotMaarGeenNatuur', 'ExogeenOpleggen/IsOpgelegd'
			,'Impl/GroenNabijheid/Prijsopslag_perWP4/vrijstaand', 'Impl/GroenNabijheid/Prijsopslag_perWP4/vrijstaand'
			,'Sloop/Verschil/Woningen_NatuurMaarNietOpSlot', 'Sloop/Verschil/Opp_OpSlotMaarGeenNatuur', 'Sloop/Verschil/Opp_NatuurMaarNietOpSlot'
			,'Sloop/Verschil/Woningen_OpSlotZonderSloopbedoeling', 'Sloop/Verschil/Woningen_ZonderMasker'
			,'Sloop/Verschil/Woningen_ZonderMasker_InVeenlevering', 'Sloop/Verschil/Woningen_ZonderMasker_Buiten'
			,'Sloop/Verschil/Woningen_Veen', 'Sloop/Verschil/Woningen_Kust', 'Sloop/Verschil/Woningen_Rivieren'
			,'Waterberging/Volume/RegiosMetTekort', 'Groen/Groenwaarde/LekBedrag_eur', 'Verharding/Cellen_Gedaald', 'Wonen/IJburg2_WoningenGroei'
			,'Koolstof/KetenNull', 'Koolstof/VastleggingKetenMin', 'Koolstof/AfboekingKetenMax'
			,'Wonen/WoningtypeEengezins/Afwijking'
			,'Claims/WonenRegio_OnderAlarm', 'Grondbalans/RestFractie'
			,'Piekbuiberging/Opgave_mln_m3', 'Piekbuiberging/AanbodOpWbCellen_mln_m3', 'Piekbuiberging/AanbodSluiting_mln_m3', 'Piekbuiberging/SchadeVolumeSluiting_mln_m3', 'Piekbuiberging/SchadeVermedenFractie', 'Piekbuiberging/SchadeVermedenMin_eur', 'Piekbuiberging/WeguitvalKmVerschil', 'Piekbuiberging/WegennetHoofdnetFractie', 'Piekbuiberging/WegennetZiekenhuizen'
			,'Grondexploitatie/Saldo_Min_BovenDrempel'
			,'Wonen/NieuwbouwVerVanKern/Aandeel'
			,'Claims/WonenRegio_BovenAlarm'
			,'Claims/Verzorgend/SomTovNL', 'Claims/Verzorgend/GroeiOngeldig'
		], IntegrityCheck = "all(IsDefined(this))";

		// vereist: namen uit Voorwaarde, met && te combineren; leeg is altijd.
		attribute<String> vereist :
		[
			 'MetWonen', 'MetWerken'
			,'MetWonen', 'MetWerken'
			,'MetWonen', 'MetWerken && ProvincieAlsAllocRegio', 'MetWaterberging'
			,'DomeinGrondgebruik', 'DomeinLandgebruikskaart'
			,'DomeinNatuur', 'DomeinNatuur', 'DomeinNatuur'
			,'MetWaterberging', 'MetWaterberging && DomeinLandgebruikskaart'
			,'MetWonen', 'DomeinWater', 'DomeinNatuur'
			,'MetWonen', 'DomeinNatuur'
			,'DomeinSloop', 'DomeinSloop'
			,'MetWaterberging && DomeinSloop', 'MetWaterberging && DomeinSloop'
			,'DomeinNatuur', 'DomeinKoolstof', 'DomeinKoolstof', 'DomeinKoolstof'
			,'', '', ''
			,'MetWonen', 'MetWonen'
			,'', '', ''
			,'', ''
			,'', ''
			,'', '', ''
			,'MetWaterberging', 'DomeinNatuur', 'DomeinWater', 'MetWonen'
			,'DomeinKoolstof', 'DomeinKoolstof', 'DomeinKoolstof'
			,'MetWonen'
			,'MetWonen', 'DomeinLandgebruikskaart'
			,'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken', 'DomeinWater && MetWonen && MetWerken'
			,'MetWonen'
			,'MetWonen'
			,'MetWonen'
			,'VerdelingWoningen', 'VerdelingWoningen'
		], IntegrityCheck = "all(IsDefined(this))"
		, Descr = "Onder welke voorwaarde uit Voorwaarde de rij zinvol is. Een rij die niet geldt schrijft null en rekent zijn item niet uit, zodat een verwijzing naar een sector die niet meedoet niet tot een onbekende naam leidt.";

		// De norm van elke rij (#833): leeg is aan die kant geen grens, twee keer leeg is een waarde zonder norm, die wel in de csv staat maar
		// geen oordeel krijgt. Waarom een norm deze waarde heeft staat in de Descr van het item dat de rij noemt, of hieronder bij de rij.
		//   claimreal_NL: de landelijke realisatie, ruimer voor banen want werken kan niet slopen waar de claim onder de stand ligt.
		//   claimreal_wonenregio_onder_alarm: het aantal regio's van de eerste woonregel onder de alarmdrempel van Claims. Op de stadregio's loopt wat
		//     een stad niet kwijt kan bewust over naar zijn ommeland; de grens ligt boven wat een gewone levering geeft (hooguit 31 van 2040 tot en met
		//     2060 bij WLO hoog) en onder wat de allocatie per NVM-regio op dezelfde indeling geeft (38 tot 45), zodat een terugval naar die allocatie
		//     alarm geeft (#392).
		//   piekbui_opgave_mln_m3: de opgave hangt aan het basisjaar en is in elke variant en elk zichtjaar dezelfde, 254,804 mln m3.
		//   piekbui_schade_volume_sluiting_mln_m3: de diepte na de maatregelen maal de natte fractie en het oppervlak hoort de ongedekte opgave te zijn (#875); piekbui_schade_vermeden_fractie ligt tussen nul en een,
		//     en de vermeden schade per cel kan alleen door afronding onder nul komen, want geen schadefunctie daalt tot 40 cm.
		//   piekbui_weguitval_km_verschil: met maatregelen valt nooit meer weg uit dan zonder (#873); piekbui_wegennet_hoofdnet_fractie en piekbui_wegennet_ziekenhuizen bewaken het wegennet, de TOP10NL telt 105 ziekenhuiscomplexen.
		//   woningtype_eengezins_afwijking: de ruimte boven nul is voor wat de hogere allocatieregio's vrij kiezen; zonder quotum per
		//     woningtype ligt de waarde ruim boven de grens (#847).
		//   grondexploitatie_min_boven_drempel: het laagste saldo waarop de allocatie koos, van de cellen die de allocatie in dit zichtjaar heeft bebouwd min de
		//     zeefdrempel hoort nul of positief te zijn; de ondergrens laat een paar euro afronding toe in float32 (#799).
		//   claimreal_wonenregio_boven_alarm: geen enkele regio van de fijnste woonindeling hoort meer dan anderhalf keer zijn doel te krijgen; zo'n regio vangt
		//     de overloop van regio's die hun claim niet halen en bouwt die in ringen rond zijn dorpen (#899).
		//   claim_verzorgend_tov_nl: de verdeling van de verzorgende subsectoren over de gemeenten houdt het landelijke totaal van TIGRIS, dus de som hoort op 1 te liggen (#911).
		//   claim_verzorgend_groei_ongeldig: elke gemeente in het studiegebied hoort een positieve groei van haar woningen te hebben; een nul wijst op een ontbrekend of leeg
		//     bestand met de woningen van de allocatie (#911).
		//   nieuwbouw_ver_van_kern: van de BAG-nieuwbouw tussen het basisjaar en de recente BAG ligt landelijk een procent verder dan een kilometer
		//     van een BRT-woonkern; de bovengrens laat ruimte voor de overloop naar de hogere allocatieregio's, die in het eerste zichtjaar al enkele
		//     procenten zo ver legt (#862). Geldt voor een landelijke run: in een studiegebied met weinig kernen, zoals Flevoland, ligt hij hoger.
		attribute<String> norm_onder :
		[
			 '', ''
			,'0.99', '0.99'
			,'', '', ''
			,'', ''
			,'', '', ''
			,'', ''
			,'', '', ''
			,'', ''
			,'', ''
			,'', ''
			,'', '', '', ''
			,'', '', ''
			,'', ''
			,'', '', ''
			,'', ''
			,'', ''
			,'', '', ''
			,'0', '0', '1', '1'
			,'0', '-0.01', ''
			,'0'
			,'0', '0'
			,'254.794', '0', '0', '0', '0', '-1', '', '0.99', '90'
			,'-10'
			,'0'
			,'0'
			,'0.999', '0'
		], IntegrityCheck = "all(IsDefined(this))";

		attribute<String> norm_boven :
		[
			 '', ''
			,'1.01', '1.06'
			,'', '', ''
			,'', ''
			,'', '', ''
			,'', ''
			,'', '', ''
			,'', ''
			,'', ''
			,'', ''
			,'', '', '', ''
			,'', '', ''
			,'', ''
			,'', '', ''
			,'', ''
			,'', ''
			,'', '', ''
			,'0', '1000', '', ''
			,'0', '', '0.01'
			,'0.10'
			,'35', '0.005'
			,'254.814', '0', '0.001', '0.01', '1', '', '0', '', '130'
			,''
			,'0.10'
			,'0'
			,'1.001', '0'
		], IntegrityCheck = "all(IsDefined(this))";

		attribute<Float64> Ondergrens := float64(norm_onder), Descr = "Leeg wordt null, want float64 op een lege tekst geeft null.";
		attribute<Float64> Bovengrens := float64(norm_boven);

		attribute<Bool>    Actief     := ='union_data(., '+AsList(vereist == '' ? 'TRUE' : 'Voorwaarde/' + replace(vereist, ' && ', ' && Voorwaarde/'), ',')+')';
	}

	unit<uint32> ChecksBasisjaar : nrofrows = 13
	, Descr = "Controlewaarden van het basisjaar, een keer per casus via GenerateBasisjaar en niet per zichtjaar: ze veranderen niet met het zichtjaar en kosten samen ruim een minuut. Dezelfde
				kolommen als Checks; pad B is de container Basisjaar hieronder, waar de rekenregel per rij staat. De bandbreedtes van de eerste zes zijn ruim genoeg voor een nieuwe BAG-jaargang en krap
				genoeg om een losgeraakte keten (een nul) of een dubbeltelling van tienden te zien."
	{
		attribute<String>  name       : ['basisjaar_woningen', 'basisjaar_banen', 'hogegronden_ha', 'bouwperiode_term', 'verwerving_nietwoon_mld', 'verblijfsrecreatie_stand_tov_trend', 'bouwjaar_telling_tov_stand', 'cellen_buiten_nl_indeling', 'vervanging_per_jaar', 'vervanging_kaart_tov_vbo', 'brk_pandcellen_met_perceel', 'brk_uitsmering_behoud', 'herontwikkeling_verwacht_per_jaar'], IntegrityCheck = "all(IsDefined(this))";
		attribute<String>  pad        : ['B', 'B', 'B', 'B', 'B', 'B', 'B', 'B', 'B', 'B', 'B', 'B', 'B'], IntegrityCheck = "all(IsDefined(this))";
		attribute<String>  aggr       : ['p', 'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p', 'p'], IntegrityCheck = "all(IsDefined(this))";
		attribute<String>  item       : ['Woningen', 'Banen', 'HogeGronden_ha', 'BouwperiodeTerm', 'Verwervingskosten_NietWoon_mld', 'Verblijfsrecreatie_StandTovTrend', 'BouwjaarTelling', 'CellenBuitenNL', 'VervangingPerJaar', 'VervangingKaartTovVBO', 'BRK_PandcellenMetPerceel', 'BRK_UitsmeringBehoud', 'HerontwikkelingVerwachtPerJaar'], IntegrityCheck = "all(IsDefined(this))";
		attribute<String>  norm_onder : ['8000000', '8500000',  '1750000', '-0.15', '250', '0', '0.999', '0', '5100', '0.98', '0.95', '0.999', '2000'], IntegrityCheck = "all(IsDefined(this))";
		attribute<String>  norm_boven : ['8500000', '10000000', '1900000', '-0.05', '900', '1', '1.001', '0', '6900', '1.02', '1', '1.001', '6000'], IntegrityCheck = "all(IsDefined(this))";
		attribute<Float64> Ondergrens := float64(norm_onder);
		attribute<Float64> Bovengrens := float64(norm_boven);
		attribute<String>  vereist    : ['', '', '', '', '', 'MetVerblijfsrecreatie', '', '', 'MetWonen', 'MetWonen', 'MetWonen', 'MetWonen', 'MetWonen'], IntegrityCheck = "all(IsDefined(this))", Descr = "Als vereist in Checks.";
		attribute<Bool>    Actief     := ='union_data(., '+AsList(vereist == '' ? 'TRUE' : 'Voorwaarde/' + replace(vereist, ' && ', ' && Voorwaarde/'), ',')+')';
	}

	container         Resultaten               :=
		for_each_ne(
			Checks/name
			, 'Check_T('+quote(Checks/name)+', '+quote(Checks/pad)+', '+quote(Checks/aggr)+', '+quote(Checks/item)+', '+(Checks/Actief ? 'TRUE' : 'FALSE')+')'
		);

	container         ResultatenBasisjaar      :=
		for_each_ne(
			ChecksBasisjaar/name
			, 'Check_T('+quote(ChecksBasisjaar/name)+', '+quote(ChecksBasisjaar/pad)+', '+quote(ChecksBasisjaar/aggr)+', '+quote(ChecksBasisjaar/item)+', '+(ChecksBasisjaar/Actief ? 'TRUE' : 'FALSE')+')'
		);

	parameter<String> UitvoerBestand           := '%LocalDataProjDir%/Diagnose/'+Casus+'_'+Jaar+'_checks.csv';
	parameter<String> UitvoerBestandBasisjaar  := '%LocalDataProjDir%/Diagnose/'+Casus+'_Basisjaar_checks.csv';
	container         Uitvoer                  := Uitvoer_T(Checks,          '/Diagnose/Resultaten/',          UitvoerBestand);
	container         UitvoerBasisjaar         := Uitvoer_T(ChecksBasisjaar, '/Diagnose/ResultatenBasisjaar/', UitvoerBestandBasisjaar);

	Template Uitvoer_T
	: Descr = "De controlewaarden van een tabel als een csv met naam, waarde, ondergrens, bovengrens en oordeel (#833), zodat batch/ToetsOplevering.ps1 de normen niet hoeft te kennen. Oordeel is
				PASS of FAIL voor een rij met een norm, NVT voor een rij die in deze run niet geldt (Voorwaarde), GEEN_NORM voor een waarde zonder norm en GEEN_GETAL als een rij met een norm geen
				getal oplevert. De losse tekstbestanden per rij blijven, want de csv leest ze."
	{
		unit<uint32>      Rijen;
		parameter<String> ResultatenPad;
		parameter<String> Bestand;
		//

		unit<uint32> Beoordeling := Rijen
		{
			attribute<String>  waarde     := ='union_data(., '+AsItemList(ResultatenPad+Rijen/name+'/Waarde')+')';
			attribute<Float64> getal      := float64(waarde), Descr = "Null voor null en voor tekst; een lijst per regio geeft het eerste getal, maar zo'n rij heeft geen norm.";
			attribute<Bool>    HeeftNorm  := IsDefined(Rijen/Ondergrens) || IsDefined(Rijen/Bovengrens);
			attribute<Bool>    BinnenNorm := (IsNull(Rijen/Ondergrens) || getal >= Rijen/Ondergrens) && (IsNull(Rijen/Bovengrens) || getal <= Rijen/Bovengrens);
			attribute<String>  oordeel    := !Rijen/Actief ? 'NVT' : !HeeftNorm ? 'GEEN_NORM' : IsNull(getal) ? 'GEEN_GETAL' : BinnenNorm ? 'PASS' : 'FAIL';
		}

		unit<uint32> Tabel := Rijen
		, StorageName = "=Bestand"
		, StorageType = "gdalwrite.vect"
		{
			attribute<String>  naam       := Rijen/name;
			attribute<String>  waarde     := Beoordeling/waarde;
			attribute<Float64> ondergrens := Rijen/Ondergrens;
			attribute<Float64> bovengrens := Rijen/Bovengrens;
			attribute<String>  oordeel    := Beoordeling/oordeel;
		}
	}

	parameter<String> GenerateAll              := 'Klaar'
	, ExplicitSuppliers = "=AsList('Resultaten/'+Checks/name+'/Waarde', ';')+';/Diagnose/grondbalans_bestemmingen;/Diagnose/Piekbuiberging/Dekking;/Diagnose/Piekbuiberging/Schade;/Diagnose/Piekbuiberging/Wegennet;/Diagnose/Piekbuiberging/Weguitval;/Diagnose/Waterberging/PerRegio;/Diagnose/Natuur/Veen/realisatie;/Diagnose/Natuur/Veen/terugkoppeling;/Diagnose/Natuur/Veen/perdeelgebied;/Diagnose/Natuur/Veen/perbouwsteen;/Diagnose/Natuur/Veen/waterkaart;/Diagnose/Claims/Wonen;/Diagnose/Claims/Werken;/Diagnose/Wonen/WoningtypeEengezins/PerRegio;/Diagnose/Claims/Verzorgend/Generate;/Diagnose/Uitvoer/Tabel/oordeel'"
	, Descr = "Rekent in een aanroep alle controlewaarden van het zichtjaar uit en schrijft ze weg: de tabel Checks, plus de uitdraaien die een reeks gelabelde waarden uit verschillende items in
				een regel zetten en daarom niet als rij in die tabel passen. De paden staan volledig gekwalificeerd, want een ongekwalificeerde naam zou stil naar een gelijknamig item hogerop
				oplossen zodra dit item wordt hernoemd of verplaatst. batch/RunAllocatie.ps1 draait per zichtjaar uitsluitend dit item en batch/ToetsOplevering.ps1 leest de bestanden (#729). De vijf
				uitdraaien van Natuur/Veen staan erbij omdat de onderrealisatie van de veenopgave aan team Veen wordt teruggekoppeld (#761); in een run zonder veenlevering kosten ze niets, want
				IsVanToepassing zet ze dan op een regel tekst. Een rij of uitdraai waarvan de sector of het indicatordomein in deze run niet meedoet (Voorwaarde) schrijft null of
				niet_van_toepassing in plaats van te rekenen.";

	parameter<String> GenerateBasisjaar        := 'Klaar'
	, ExplicitSuppliers = "=AsList('ResultatenBasisjaar/'+ChecksBasisjaar/name+'/Waarde', ';')+';/Diagnose/UitvoerBasisjaar/Tabel/oordeel'"
	, Descr = "De tegenhanger van GenerateAll voor de tabel ChecksBasisjaar: een keer per casus, voor de zichtjaren, vanuit batch/RunAllocatie.ps1. De bestanden dragen Basisjaar in plaats van het zichtjaar in
				de naam.";

	Template Check_T
	{
		parameter<String> naam;
		parameter<String> pad;
		parameter<String> aggr;
		parameter<String> item;
		parameter<Bool>   Actief;
		//

		parameter<String> VolPad    := (pad == 'Z' ? /Diagnose/Pad_Z : pad == 'V' ? /Diagnose/Pad_V : pad == 'A' ? /Diagnose/Pad_A : pad == 'B' ? /Diagnose/Pad_B : /Diagnose/Pad_D) + item;
		parameter<String> JaarLabel := pad == 'B' ? 'Basisjaar' : /Diagnose/Jaar, Descr = "Basisjaarcontroles dragen geen zichtjaar in de bestandsnaam, want ze gelden voor de hele reeks.";

		parameter<String> Expr      :=
			  !Actief ? quote('null')
			: aggr == 'p' ? 'string(value('+VolPad+', float32))'
			: aggr == 's' ? 'string(sum(value('+VolPad+', float32)))'
			: aggr == 'b' ? 'string(sum(uint32('+VolPad+')))'
			: aggr == 'c' ? 'string(sum(uint32(IsDefined('+VolPad+'))))'
			: aggr == 'm' ? 'string(max(value('+VolPad+', float32)))'
			: aggr == 'n' ? 'string(min(value('+VolPad+', float32)))'
			: 'AsList(string(value('+VolPad+', float32)), ('+quote(';')+'))';

		parameter<String> Waarde    := =Expr
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+JaarLabel+'_'+naam+'.txt'"
		, StorageType = "str";
	}
	parameter<String> WonenRegio_namen         := AsList(/Diagnose/Claims/WonenRegio/name, ';')
	, StorageName = "='%LocalDataProjDir%/Diagnose/WonenRegio_namen.txt'"
	, StorageType = "str"
	, Descr = "De regio's van de eerste woonregel van ModelParameters/SectorAllocRegio, in de volgorde van claimreal_wonenregio_woningen; die uitdraai gebruikt AsList en slaat null over, dus lees een regio zonder realisatie niet mee.";

	parameter<String> waterbergingsregio_namen := AsList(/SourceData/RegioIndelingen/Waterbergingsregio/label + ';' + string(/SourceData/RegioIndelingen/Waterbergingsregio/IsRestRegio), '|')
	, StorageName = "='%LocalDataProjDir%/Diagnose/waterbergingsregio_namen.txt'"
	, StorageType = "str"
	, Descr = "De negen waterbergingsregio's in de volgorde van de unit, dus de volgorde van de shapefile met de restregio erachter, plus de vlag die zegt welke de restregio is. Nodig om claimreal_Waterberging te kunnen lezen: die uitdraai gebruikt AsList en dat slaat de null-waarden over, dus een regio zonder opgave verschijnt er niet in en de posities schuiven op. Zonder deze lijst is niet te zeggen welke regio bij welk getal hoort.";

	parameter<String> grondbalans_bestemmingen := = !/Diagnose/Voorwaarde/DomeinLandgebruikskaart ? quote(/Diagnose/Voorwaarde/Zonder_DomeinLandgebruikskaart) : ('
	                                                '+quote('verdwenen_vruchtbaar_ha;')+'      + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
	                                              + '+quote(';verstedelijking_vruchtbaar_ha;')+' + string('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_NL)
	                                              + '+quote(';nieuwenatuur_vruchtbaar_ha;')+'    + string('+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_NL)
	                                              + '+quote(';waterberging_vruchtbaar_ha;')+'    + string('+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_NL)
	                                              + '+quote(';overlap_verst_natuur_ha;')+'      + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
	                                              + '+quote(';overlap_verst_wb_ha;')+'          + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
	                                              + '+quote(';overlap_natuur_wb_ha;')+'         + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_grondbalans_bestemmingen.txt'", StorageType = "str"
	, Descr = "Sluit de verdwenen vruchtbare landbouw op de drie bestemmingen? Met de oude definitie (klasse A, ongeacht vorig gebruik) telden de bestemmingen samen op tot meer dan het verlies. Zie #634.";

	container Grondbalans
	: Descr = "Waar de verdwenen vruchtbare landbouw heen gaat, de regel grondbalans_rest_fractie in Checks. Elke cel met verlies krijgt een bestemming, in deze volgorde: een stedelijke sector, ook
				binnen bestaand bebouwd gebied, waterberging, natuur en water volgens de landgebruikskaart; wat overblijft is de rest en hoort nul te zijn. De drie geleverde indicatoren
				*OpVruchtbareLandbouwgronden sluiten niet en hoeven dat ook niet: verstedelijking telt daar alleen buiten bestaand bebouwd gebied, en de natuurtypen van water (rivier, beek,
				stilstaand water) zijn op de kaart water en geen natuur."
	{
		parameter<String>  V                                     := /Diagnose/Pad_Z+'Grondgebruik/Verandering/';
		parameter<String>  LU                                    := '/Classifications/Grondgebruik/LU_NL2120/';
		parameter<Float64> Ha                                    := value(/Geography/AdminDomain/NrHaPerCell, float64);
		attribute<Bool>    Verlies      (/Geography/AdminDomain) := =V+'VerdwenenVruchtbareLandbouw';
		attribute<Bool>    Stedelijk    (/Geography/AdminDomain) := ='Verlies && /Classifications/Actor/Sector/IsStedelijk['+/Diagnose/Pad_Z+'Sector_rel]';
		attribute<Bool>    Waterberging (/Geography/AdminDomain) := ='Verlies && !Stedelijk && '+V+'WaterbergingVeen';
		attribute<Bool>    Natuur       (/Geography/AdminDomain) := ='Verlies && !Stedelijk && !Waterberging && '+LU+'IsNatuur['+V+'LU_MT_Zichtjaar]';
		attribute<Bool>    Water        (/Geography/AdminDomain) := ='Verlies && !Stedelijk && !Waterberging && !Natuur && '+LU+'IsWater['+V+'LU_MT_Zichtjaar]';
		attribute<Bool>    Rest         (/Geography/AdminDomain) := Verlies && !Stedelijk && !Waterberging && !Natuur && !Water;
		parameter<Float64> Verlies_ha                            := sum(float64(Verlies)) * Ha;
		parameter<Float64> Rest_ha                               := sum(float64(Rest)) * Ha;
		parameter<Float64> RestFractie                           := Verlies_ha > 0d ? Rest_ha / Verlies_ha : 0d, Descr = "Het deel van de verdwenen vruchtbare landbouw zonder bestemming; nul als de kaart en de stand dezelfde cellen kennen.";
		parameter<String>  PerBestemming                         := 'verlies_ha;' + string(Verlies_ha) + ';stedelijk_ha;' + string(sum(float64(Stedelijk)) * Ha) + ';waterberging_ha;' + string(sum(float64(Waterberging)) * Ha)
		                                                            + ';natuur_ha;' + string(sum(float64(Natuur)) * Ha) + ';water_ha;' + string(sum(float64(Water)) * Ha) + ';rest_ha;' + string(Rest_ha)
		, Descr = "De indeling zelf, om een rest te kunnen lezen; niet in GenerateAll.";
	}

	container Claims
	: Descr = "De claimrealisatietoets van de indicatorenkant uitgelezen, wonen en werken; al_gehaald wijst de regio's aan waar de claim al voor de allocatie was gehaald en de realisatie dus niet
				anders dan boven 1 kan uitkomen; Verzorgend zet de claim van de verzorgende werksubsectoren uit TIGRIS en uit de woningen per regio naast elkaar. In GenerateAll."
	{
		parameter<String>  Wonen                              := = !/Diagnose/Voorwaarde/MetWonen ? quote(/Diagnose/Voorwaarde/Zonder_Wonen) : ('
		                                                           '+quote('regios;')+'      + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_Regios)
		                                                         + '+quote(';al_gehaald;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_AlGehaald)
		                                                         + '+quote(';telt_mee;')+'    + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_TeltMee)
		                                                         + '+quote(';op_norm;')+'     + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_OpNorm)
		                                                         + '+quote(';onder_norm;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_OnderNorm)
		                                                         + '+quote(';boven_norm;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_BovenNorm)
		                                                         + '+quote(';tekort;')+'      + string('+Pad_Z+'ClaimRealisatie_Toets/Tekort_woningen)
		                                                         + '+quote(';overschot;')+'   + string('+Pad_Z+'ClaimRealisatie_Toets/Overschot_woningen)
		                                                         + '+quote(';saldo;')+'       + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_woningen)
		                                                         + '+quote(';saldo_algehaald;')+' + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_AlGehaald)
		                                                         + '+quote(';saldo_alles;')+'     + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_Alles)
		                                                         + '+quote(';uitgesteld_netcongestie;')+' + string('+Pad_Z+'ClaimRealisatie_Toets/Uitgesteld_woningen)
		')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_claimtoets.txt'", StorageType = "str";

		unit<UInt32>       WonenRegio                         := = /Diagnose/Voorwaarde/MetWonen ? '/SourceData/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_path : '/SourceData/RegioIndelingen/NL'
		, Descr = "De fijnste indeling waarop wonen alloceert, de eerste woonregel van ModelParameters/SectorAllocRegio (#392); zonder wonen Nederland, zodat de naam blijft oplossen.";
		attribute<Float32> Realisatie_WonenRegio (WonenRegio) := = /Diagnose/Voorwaarde/MetWonen
		                                                         ? 'value('+/Diagnose/Pad_Z+'ClaimRealisatie/Per_AllocRegio/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_name+'/Bouwbaar_realisatie/Aantal_Woningen_Totaal, float32)'
		                                                         : 'const(null_f, WonenRegio)'
		, Descr = "De realisatie van wonen per regio van die indeling, de regel claimreal_wonenregio_woningen in Checks.";
		parameter<Float32> Alarmdrempel                       := 0.99f, Descr = "De alarmdrempel voor de realisatie per regio van de eerste woonregel, strenger dan de modelnorm ModelParameters/Advanced/ClaimRealisatie_NormOnder (0,98): een levering wordt strenger beoordeeld dan
					de allocatie zichzelf beoordeelt, en de rij heet daarom alarm en niet norm.";
		parameter<UInt32>  WonenRegio_OnderAlarm              := sum(uint32(Realisatie_WonenRegio > 0f && Realisatie_WonenRegio < Alarmdrempel)), Descr = "Het aantal regio's van de eerste woonregel met een realisatie boven nul en onder Alarmdrempel, de regel claimreal_wonenregio_onder_alarm in Checks. Een aantal en geen minimum: het minimum zakt vanzelf naarmate
					de reeks vordert, want de claim groeit door terwijl de ruimte opraakt.";
		parameter<Float32> AlarmdrempelBoven                  := 1.5f, Descr = "Boven welke realisatie een regio van de fijnste woonindeling als uitschieter telt, in de regel claimreal_wonenregio_boven_alarm. De toedeling legt wat een regio niet kwijt kan bewust in de hogere regio's, dus een realisatie iets boven 1 is gewoon; bij 1,5 is een derde van de woningstand overloop van elders, en die landt dan in ringen rond de dorpen (#899).";
		parameter<UInt32>  WonenRegio_BovenAlarm              := ='sum(uint32(value('+/Diagnose/Pad_Z+'ClaimRealisatie/Per_AllocRegio/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_name+'/Bouwbaar_realisatie/Aantal_Woningen_Totaal, float32) > AlarmdrempelBoven))', Descr = "Het aantal regio's van de fijnste indeling waarop wonen alloceert (ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_name) met een realisatie boven AlarmdrempelBoven, de regel claimreal_wonenregio_boven_alarm in Checks. De tegenhanger van NVM_OnderAlarm; hij leest de indeling uit de tabel, zodat hij met #392 de stadregio's telt.";

		parameter<String>  Werken                             := = !/Diagnose/Voorwaarde/MetWerken ? quote(/Diagnose/Voorwaarde/Zonder_Werken) : ('string('+Pad_Z+'ClaimRealisatie_Toets_Werken/Samenvatting)')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_claimtoets_werken.txt'", StorageType = "str";

		container Verzorgend
		: Descr = "De claim van de verzorgende werksubsectoren per regio van elke allocatieregel van werken, uit TIGRIS en uit de woningen die het model bouwt (ClaimPerGemeente_T in
					Templates/Claims/ZichtjaarXScenarioxAllocRegios), naast de groei van de woningen in het model en in de woonclaim (#911). Alleen als Voorwaarde/VerdelingWoningen geldt; Generate
					schrijft per regel een csv en staat in GenerateAll. SomTovNL en GroeiOngeldig zijn de regels claim_verzorgend_tov_nl en claim_verzorgend_groei_ongeldig in Checks."
		{
			parameter<String>  Scenario      := replace(/Diagnose/Casus, '_'+/Diagnose/Variant, ''), Descr = "De casusnaam zonder de variantnaam, het scenario waaronder de claims hangen.";
			parameter<String>  Z             := /Diagnose/Pad_V+'Claims/'+Scenario+'/Zichtjaren/'+/Diagnose/Jaar+'/';
			parameter<String>  V             := Z+'ClaimPerGemeente/';

			unit<UInt8>        Subsectoren   := select_with_attr_by_cond(/Classifications/Actor/Jobs6, /Classifications/Actor/Jobs6/IsVerzorgend), Descr = "De verzorgende werksubsectoren.";
			unit<UInt8>        Regel         := select_with_org_rel(lowercase(/ModelParameters/SectorAllocRegio/Sector_name) == 'werken' && /Diagnose/Voorwaarde/VerdelingWoningen)
			, Descr = "De allocatieregels van werken; leeg zonder Voorwaarde/VerdelingWoningen, zodat er dan niets wordt geschreven."
			{
				attribute<String> AllocRegio_name := /ModelParameters/SectorAllocRegio/AllocRegio_name[org_rel];
			}

			parameter<Float32> SomTovNL      := ='float32(('+AsList('sum(value('+V+'Claim/'+Subsectoren/name+', Float64))', ' + ')+') / ('+AsList('sum(value('+Z+'AllocRegios/NL/Werken_TIGRIS/'+Subsectoren/name+', Float64))', ' + ')+'))'
			, Descr = "De claim van de verzorgende subsectoren opgeteld over alle gemeenten, gedeeld door het landelijke totaal van TIGRIS; de regel verdeelt alleen en hoort dus op 1 uit te komen.";
			parameter<UInt32>  GroeiOngeldig := ='sum(uint32('+V+'InStudiegebied && !('+V+'Groei > 0f)))'
			, Descr = "Het aantal gemeenten in het studiegebied zonder positieve groei van de woningen; zo'n gemeente valt uit de verdeling, bijvoorbeeld als het bestand met de woningen van de allocatie ontbreekt of leeg is.";

			container PerRegel := for_each_ne(Regel/AllocRegio_name, 'Regel_T('+quote(Regel/AllocRegio_name)+')');

			parameter<String>  Generate      := 'Ready', ExplicitSuppliers = "=AsList('PerRegel/'+Regel/AllocRegio_name+'/Tabel/verhouding', ';')", Descr = "Schrijft de tabel van elke allocatieregel van werken.";

			Template Regel_T
			: Descr = "De tabel van een allocatieregel: per regio en verzorgende subsector de claim uit TIGRIS en uit de woningen, en de groei van de woningen in het model en in de woonclaim."
			{
				parameter<String> AllocRegio_name;
				//

				parameter<String>  C                       := Z+'AllocRegios/'+AllocRegio_name+'/';
				unit<UInt32>       RegioUnit               := =C+'RegioUnit';
				attribute<RegioUnit> Gemeente_rel (/PrivData/TrendBasisjaar/Gemeente) := =C+'Gemeente_rel';
				attribute<Float32> RegioWoningenBasisjaar  (RegioUnit) := ='sum('+V+'InStudiegebied ? value('+V+'Woningen_Basisjaar, Float32) : 0f, Gemeente_rel)', Descr = "De woningen in het basisjaar van de gemeenten van de regio die in het studiegebied liggen.";
				attribute<Float32> RegioWoningenZichtjaar  (RegioUnit) := ='sum('+V+'InStudiegebied ? value('+V+'Woningen_Zichtjaar, Float32) : 0f, Gemeente_rel)', Descr = "De woningen in het zichtjaar nadat wonen en voordat werken alloceert, van dezelfde gemeenten.";
				container          ClaimTIGRIS             := for_each_nedv(Subsectoren/name, 'value('+C+'Werken_TIGRIS/'+Subsectoren/name+', Float32)', RegioUnit, Float32), Descr = "De claim per regio met de verdeling van TIGRIS.";
				container          ClaimWoningen           := for_each_nedv(Subsectoren/name, 'value('+C+'Werken_PerGemeente/'+Subsectoren/name+', Float32)', RegioUnit, Float32), Descr = "De claim per regio met de verdeling uit de woningen.";
				container          ClaimVerhouding         := for_each_nedv(Subsectoren/name, 'ClaimWoningen/'+Subsectoren/name+' / ClaimTIGRIS/'+Subsectoren/name, RegioUnit, Float32), Descr = "De claim uit de woningen gedeeld door die uit TIGRIS.";
				attribute<Float32> RegioGroeiWoningen      (RegioUnit) := RegioWoningenZichtjaar / RegioWoningenBasisjaar, Descr = "De groei van de woningen in het model sinds het basisjaar.";
				attribute<Float32> RegioGroeiWoonclaim     (RegioUnit) := ='value(add('+AsList(C+'Read_Wonen_CSV/'+/Classifications/Vastgoed/WP2/name, ',')+'), Float32) / value('+C+'Read_Wonen_Basisjaar_Regio_CSV/Totaal, Float32)', Descr = "De woonclaim van TIGRIS in het zichtjaar gedeeld door die in het basisjaar.";

				unit<UInt32> Tabel := ='union_unit('+AsList(const('RegioUnit', Subsectoren), ',')+')'
				, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_claim_verzorgend_'+AllocRegio_name+'.csv'"
				, StorageType = "gdalwrite.vect"
				, Descr = "Een rij per regio en verzorgende subsector."
				{
					attribute<String>  regio              := ='union_data(., '+AsList(const('RegioUnit/name', Subsectoren), ',')+')';
					attribute<String>  subsector          := ='union_data(., '+AsList('const('+quote(Subsectoren/name)+', RegioUnit)', ',')+')';
					attribute<Float32> claim_tigris       := ='union_data(., '+AsList('ClaimTIGRIS/'+Subsectoren/name, ',')+')';
					attribute<Float32> claim_woningen     := ='union_data(., '+AsList('ClaimWoningen/'+Subsectoren/name, ',')+')';
					attribute<Float32> verhouding         := ='union_data(., '+AsList('ClaimVerhouding/'+Subsectoren/name, ',')+')';
					attribute<Float32> woningen_basisjaar := ='union_data(., '+AsList(const('RegioWoningenBasisjaar', Subsectoren), ',')+')';
					attribute<Float32> woningen_zichtjaar := ='union_data(., '+AsList(const('RegioWoningenZichtjaar', Subsectoren), ',')+')';
					attribute<Float32> groei_woningen     := ='union_data(., '+AsList(const('RegioGroeiWoningen', Subsectoren), ',')+')';
					attribute<Float32> groei_woonclaim    := ='union_data(., '+AsList(const('RegioGroeiWoonclaim', Subsectoren), ',')+')';
				}
			}
		}
	}

	container Waterberging
	: Descr = "De sector waterberging: wat de veenbouwstenen aan berging bieden naast de opgave (Veenwater en PerRegio, in GenerateAll), of de opgave in het beschikbare volume past (Volume, waarvan
				RegiosMetTekort in Checks) en of de gerealiseerde berging in cellen ligt die diep genoeg zijn (Diepte, op aanvraag)."
	{
		container Veenwater
		: Descr = "Het bergingsvolume dat op de cellen ligt die de veenlevering als open water aanwijst, de bouwstenen 9a en 9b (#761): wat de bouwstenen zelf aan berging opleveren naast de opgave die team
					Stad per deelgebied aanlevert. Geen tweede claim en niet op te tellen bij het gerealiseerde volume: de veenallocatie bepaalt waar dat open water komt en de sector waterberging gebruikt
					diezelfde cellen als voorkeurslocatie (#664), zodat de aangeleverde opgave daar landt in plaats van er bovenop te komen. Dit is de bovengrens van wat de veenlevering op die plekken kan
					bergen, en de vergelijking met de opgave zegt hoeveel van die opgave alleen al uit de bouwstenen kan komen. Zonder veenlevering staan de kolommen op nul."
		{
			unit<UInt32>       R                 := /SourceData/RegioIndelingen/Waterbergingsregio;

			Template Bron_T
			: Descr = "De rekenstappen op de bouwstenen van NbSGenuanceerd; alleen geinstantieerd als die variant bestaat, als Bron (pbl-nl/model-RSopen#53)."
			{
				container          Veen                                  := /VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Veen;

				attribute<Bool>    IsWaterBouwsteen (Veen/BouwsteenType) := Veen/BouwsteenType/deelstrategie == 'waterbuffering'
				, IntegrityCheck = "sum(uint32(this)) == 2"
				, Descr = "De twee bouwstenen die open water opleggen, 9a nieuw open water voor waterbuffering en 9b bestaand open water met extra buffercapaciteit. Herkend aan de kolom deelstrategie en niet aan de code, zodat de hernummering uit #762 hem niet stil uitschakelt.";

				attribute<Bool>    IsNieuwWater     (Veen/BouwsteenType) := Veen/BouwsteenType/code == '9a'
				, IntegrityCheck = "sum(uint32(this)) == 1"
				, Descr = "Bouwsteen 9a, nieuw open water voor waterbuffering. Dit is de bouwsteen die extra bergingscapaciteit oplevert, en de enige die naast de opgave gelegd mag worden.";

				attribute<Bool>    IsBestaandWater  (Veen/BouwsteenType) := Veen/BouwsteenType/code == '9b'
				, IntegrityCheck = "sum(uint32(this)) == 1"
				, Descr = "Bouwsteen 9b, bestaand open water met extra buffercapaciteit, dus de peilopzet van 15 cm. Wat die oplevert zit al in de opgave verwerkt en mag er niet nog eens naast worden gelegd; zie de toelichting bij de uitdraai.";

				attribute<Bool>    Klopt_Waterbouwstenen (Veen/BouwsteenType) := IsWaterBouwsteen == (IsNieuwWater || IsBestaandWater)
				, IntegrityCheck = "all(this)"
				, Descr = "Controle op de twee codes hierboven. De splitsing naar nieuw en bestaand water kan alleen op de code 9a en 9b, want geen enkele kolom in de brontabel scheidt die twee. Deze toets bindt die codes aan de kolom deelstrategie: verschuift de nummering, zoals #762 aankondigt, dan valt hij om in plaats van stil de verkeerde bouwsteen te tellen.";

				attribute<Bool>    IsCel_9a     (/Geography/AdminDomain) := IsNieuwWater[Veen/Bouwsteen_rel] && all(Klopt_Waterbouwstenen);
				attribute<Bool>    IsCel_9b     (/Geography/AdminDomain) := IsBestaandWater[Veen/Bouwsteen_rel];

				attribute<float32> Volume_Cel   (/Geography/AdminDomain) := MakeDefined(float32(/BaseData/Suitabilities/Waterberging/Diepte), 0f) * float32(/Geography/AdminDomain/NrMeter2PerCell), Descr = "De bergbare waterschijf maal het celoppervlak, dus m3 per cel. Leest hetzelfde item als de bergingscapaciteit per cel in Templates/PotentieleStates/PerSectorxSubsector_T (#770), de capaciteit per hectare in Templates/Densities/DichtheidZichtjaar_T en de geschiktheid, inclusief de bovengrens Maximum_Waterschijf; cellen daarboven tellen als nul.";

				attribute<float32> Calc_Volume_9a                    (R) := sum(IsCel_9a ? Volume_Cel : 0f, R/Per_AdminDomain);
				attribute<float32> Calc_Areaal_9a                    (R) := sum(float32(IsCel_9a), R/Per_AdminDomain) * float32(/Geography/AdminDomain/NrHaPerCell);
				attribute<float32> Calc_Volume_9b                    (R) := sum(IsCel_9b ? Volume_Cel : 0f, R/Per_AdminDomain);
				attribute<float32> Calc_Areaal_9b                    (R) := sum(float32(IsCel_9b), R/Per_AdminDomain) * float32(/Geography/AdminDomain/NrHaPerCell);
			}
			container          Bron              := = /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron_T()' : '/Templates/Leeg';

			parameter<Bool>    HeeftVeenlevering := /VariantParameters/VariantK/HeeftLandschapslevering[rlookup(/Diagnose/Variant, /VariantParameters/VariantK/name)], Descr = "Draait deze casus de veenbouwstenen? Uit VariantK/Landschap_Levering en niet uit de casusnaam, zodat een tweede variant met dezelfde levering vanzelf meetelt.";


			attribute<float32> Volume_9a     (R) := =HeeftVeenlevering && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Calc_Volume_9a' : 'const(0f, R)';
			attribute<float32> Areaal_9a     (R) := =HeeftVeenlevering && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Calc_Areaal_9a' : 'const(0f, R)';
			attribute<float32> Volume_9b     (R) := =HeeftVeenlevering && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Calc_Volume_9b' : 'const(0f, R)';
			attribute<float32> Areaal_9b     (R) := =HeeftVeenlevering && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Calc_Areaal_9b' : 'const(0f, R)';
		}

		parameter<String> PerRegio := = !/Diagnose/Voorwaarde/MetWaterberging ? quote(/Diagnose/Voorwaarde/Zonder_Waterberging) : ('
		                              '+quote('waterbergingsregio;benodigde_berging_m3;berging_uit_nieuw_water_9a_m3;nieuw_water_9a_min_benodigd_m3;areaal_nieuw_water_9a_ha;aangewezen_berging_m3;aangewezen_min_benodigd_m3;berging_uit_bestaand_water_9b_m3;areaal_bestaand_water_9b_ha|')+' + AsList(
		                                /SourceData/RegioIndelingen/Waterbergingsregio/label + '+quote(';')+'
		                                + string('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/MaxClaims/meter3_Waterberging) + '+quote(';')+'
		                                + string(Veenwater/Volume_9a) + '+quote(';')+'
		                                + string(Veenwater/Volume_9a - float32('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/MaxClaims/meter3_Waterberging)) + '+quote(';')+'
		                                + string(Veenwater/Areaal_9a) + '+quote(';')+'
		                                + string('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/Stand_PerAllocRegio/meter3_Waterberging) + '+quote(';')+'
		                                + string(float32('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/Stand_PerAllocRegio/meter3_Waterberging) - float32('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/MaxClaims/meter3_Waterberging)) + '+quote(';')+'
		                                + string(Veenwater/Volume_9b) + '+quote(';')+'
		                                + string(Veenwater/Areaal_9b), '+quote('|')+')
		')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_waterberging_perregio.txt'"
		, StorageType = "str"
		, Descr = "Wat er per waterbergingsregio aan berging nodig is, wat het model daarvoor aanwijst, en wat de waterbouwstenen van de veenlevering daar aan berging bieden: het antwoord op #761 aan de
					allocatiekant. waterbergingsregio is een van de acht veen-deelgebieden waarvoor Deltares een opgave levert, plus de restregio met opgave nul. benodigde_berging_m3 is de aangeleverde opgave
					voor de maand juli, opgebouwd tot en met dit zichtjaar (welke reeks een variant leest bepalen VariantK/Claimset_Waterberging en WaterbergingOpBestaandWater, en of zij waterberging alloceert
					WaterbergingClaimActief). aangewezen_berging_m3 is het bergingsvolume van de cellen die het model aan de sector waterberging heeft toegewezen, per cel de bergbare waterschijf maal het
					celoppervlak. aangewezen_min_benodigd_m3 is het verschil met het teken erin, negatief is onderrealisatie; het model brengt een overschot niet terug, en de opgave is cumulatief per zichtjaar,
					dus lees dit als een stand en niet als een jaarsaldo. berging_uit_nieuw_water_9a_m3 is het bergingspotentieel van bouwsteen 9a, nieuw open water: de bergbare waterschijf maal het
					celoppervlak op het hele voetspoor van 9a, dus ruwweg zeven procent te hoog omdat een deel van dat voetspoor geen water wordt; nieuw_water_9a_min_benodigd_m3 zegt of 9a alleen al genoeg zou
					zijn. Bouwsteen 9b staat er apart bij en mag niet bij 9a worden opgeteld: dat is bestaand open water met peilopzet, en die peilopzet zit al aan de vraagkant verwerkt via de kolommen
					OokBestaand_*, dus optellen telt hem twee keer. Beide bouwsteenkolommen gaan over de veenlevering en niet over de sector en mogen ook niet bij aangewezen_berging_m3 worden opgeteld; zie
					Veenwater. claimreal_Waterberging uit de tabel Checks geeft alleen de verhouding tussen stand en opgave en laat via AsList de regio's zonder opgave weg; deze uitdraai loopt mee
					in GenerateAll.";

		Template Volume_T
		: Descr = "Per waterbergingsregio de opgave in m3 naast het bergingsvolume dat in alle beschikbare cellen samen zit. Dat volume is precies het gewicht waarmee IterSubsector_T de zaaglijn bepaalt: nth_element_weighted telt cellen op in volgorde van geschiktheid tot het gewicht de restclaim haalt. Is de som over alle beschikbare cellen kleiner dan de opgave, dan wordt de zaaglijn undefined, valt hij terug op 0, wordt alles gealloceerd en blijft de realisatie per definitie onder 1. Meer iteraties helpen dan niet. Deze container rekent de allocatie niet mee."
		{
			unit<uint32>       Regio                  := /SourceData/RegioIndelingen/Waterbergingsregio;

			parameter<String>  Scenario               := replace(/Diagnose/Casus, '_'+/Diagnose/Variant, ''), Descr = "De casusnaam zonder de variantnaam, dus het scenario waaronder de claims hangen.";

			attribute<float32> Volume_perCel (/Geography/CompactedAdminDomain) :=
				=/Diagnose/Pad_V+'PotentieleState/'+/Diagnose/Jaar+'/per_SectorxSubsectoren/Waterberging/Totaal/Zichtjaar'
			, Descr = "Bergingsvolume in m3 per cel, al vermenigvuldigd met de beschikbaarheid in dit zichtjaar.";

			attribute<bool>    IsDiepGenoeg (/Geography/CompactedAdminDomain) :=
				collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg)
			, Descr = "Haalt de cel de Minimum_Waterschijf? Zo niet, dan sluit de zeef de cel uit (Zeef_T/TeOndiepVoorWaterberging) en is de geschiktheid 0.";

			attribute<Regio>   Regio_rel (/Geography/CompactedAdminDomain) := /SourceData/RegioIndelingen/Waterbergingsregio/Per_CompactedAdminDomain;

			attribute<float32> Claim_m3       (Regio) := =/Diagnose/Pad_V+'Claims/'+/Diagnose/Waterberging/Volume/Scenario+'/Zichtjaren/'+/Diagnose/Jaar+'/SectorAllocRegios/Waterbergingsregio_Waterberging/Totaal';
			attribute<float32> Volume_m3      (Regio) := sum(Volume_perCel, Regio_rel);
			attribute<float32> Volume_diep_m3 (Regio) := sum(Volume_perCel * float32(IsDiepGenoeg), Regio_rel), Descr = "Alleen de cellen met een waterschijf vanaf Minimum_Waterschijf, dus de cellen met een geschiktheid boven nul.";
			attribute<float32> Cellen         (Regio) := sum(float32(Volume_perCel > 0f), Regio_rel);
			attribute<float32> Dekking        (Regio) := Volume_m3 / Claim_m3;
			attribute<float32> Dekking_diep   (Regio) := Volume_diep_m3 / Claim_m3;

			attribute<float32> Cellen_totaal  (Regio) := sum(float32(IsDefined(Regio_rel)), Regio_rel), Descr = "Alle cellen in de regio, ongeacht beschikbaarheid, zodat een lege regio te onderscheiden is van een regio zonder beschikbare cellen.";

			attribute<String>  Regel          (Regio) :=
				MakeDefined(Regio/label, 'null') + ';' + string(MakeDefined(Claim_m3, -1f)) + ';' + string(MakeDefined(Volume_m3, -1f)) + ';' + string(MakeDefined(Volume_diep_m3, -1f))
				+ ';' + string(MakeDefined(Cellen, -1f)) + ';' + string(MakeDefined(Cellen_totaal, -1f)) + ';' + string(MakeDefined(Dekking, -1f));

			parameter<Bool>    ClaimActief            := /VariantParameters/VariantK/WaterbergingClaimActief[rlookup(/Diagnose/Variant, /VariantParameters/VariantK/name)], Descr = "Alloceert deze variant waterberging op een opgave? Zonder opgave is er geen tekort te meten en blijft het volume ongerekend.";
			parameter<UInt32>  Calc_RegiosMetTekort   := sum(uint32(Claim_m3 > 0f && Volume_m3 < Claim_m3));
			parameter<UInt32>  RegiosMetTekort        := =ClaimActief ? 'Calc_RegiosMetTekort' : 'uint32(0)', Descr = "Het aantal waterbergingsregio's waar de opgave niet in het bergingsvolume van alle beschikbare cellen samen past: de regel waterberging_regios_met_tekort in Checks, en die hoort nul te
			                                             zijn, want een opgave die niet past kan geen enkele allocatie halen. De Samenvatting ernaast is op aanvraag.";

			parameter<String>  Samenvatting           :=
				'regio;claim_m3;volume_m3;volume_diep_m3;cellen_beschikbaar;cellen_totaal;dekking|' + AsList(Regel, '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_volume.txt'", StorageType = "str";
		}
		container         Volume   := = /Diagnose/Voorwaarde/MetWaterberging ? 'Volume_T()' : '/Templates/Leeg', Descr = "Leeg zonder de sector waterberging (pbl-nl/model-RSopen#53).";

		Template Diepte_T
		: Descr = "Op aanvraag. Splitst de gerealiseerde berging naar cellen die de Minimum_Waterschijf wel en niet halen. Cellen die hem niet halen sluit de zeef uit (Zeef_T/TeOndiepVoorWaterberging); wat hier bij te_ondiep staat hoort dus nul te zijn, en is anders berging die op papier meetelt maar er fysiek niet in past."
		{
			parameter<String>  PadLaatste                              := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_'+string(/ModelParameters/Advanced/Default_NrOfIters - 1b)+'/';

			attribute<float32> Stand (/Geography/CompactedAdminDomain) := =PadLaatste+'StateNaAllocatie/Waterberging/Totaal';
			attribute<bool>    IsDiepGenoeg (/Geography/CompactedAdminDomain) :=
				collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg);

			parameter<float32> HaPerCel                                := float32(/Geography/AdminDomain/NrHaPerCell);

			parameter<String>  Samenvatting                            :=
				  'totaal_m3;'      + string(sum(Stand))
				+ ';diep_genoeg_m3;'+ string(sum(Stand * float32(IsDiepGenoeg)))
				+ ';te_ondiep_m3;'  + string(sum(Stand * float32(!IsDiepGenoeg)))
				+ ';totaal_ha;'     + string(sum(float32(Stand > 0f)) * HaPerCel)
				+ ';te_ondiep_ha;'  + string(sum(float32(Stand > 0f && !IsDiepGenoeg)) * HaPerCel)
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_diepte.txt'", StorageType = "str";
		}
		container         Diepte   := = /Diagnose/Voorwaarde/MetWaterberging ? 'Diepte_T()' : '/Templates/Leeg', Descr = "Leeg zonder de sector waterberging (pbl-nl/model-RSopen#53).";
	}

	container Natuur
	: Descr = "De natuurleveringen en de natuurallocatie: Zand (zeef en realisatie van #652, op aanvraag), Veen (de bouwsteenallocatie per peilgebied, de vijf uitdraaien voor de terugkoppeling aan
				team Veen, in GenerateAll), Overzicht (welke bron waar oplegt en hoeveel de bronnen overlappen, op aanvraag) en Rangorde (wat de landbouwstroom van veen en de zandallocatie
				verliezen doordat zij de voorrang tussen de landschappen niet kennen, #829, op aanvraag)."
	{
		Template Zand_T
		: Descr = "Op aanvraag. Meet de twee dingen die bij de natuurallocatie van het landschapstype Zand mis kunnen gaan: een zeef die te klein is voor de opgave, en een allocatie die de opgave niet haalt. Het eerste is een gegeven van de invoer, het tweede kan ook aan de verdeling over de regio's liggen."
		{
			parameter<String> Pad                       := '/SourceData/Grondgebruik/Natuur/';

			parameter<String> zeven                     :=
				  'claimregios_ha;'   + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_Claimregios)
				+ ';zeef_nat_ha;'     + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_Zeef_Nat)
				+ ';zeef_droog_ha;'   + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_Zeef_Droog)
				+ ';droogbkn_ha;'     + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_DroogBKN)
				+ ';nnn_ha;'          + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_NNN)
				+ ';beekdal_ha;'      + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_Beekdal_Totaal)
				+ ';beekdal_landbouw_ha;' + string(/SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Controle/Areaal_Beekdal_AlleLandbouw)
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_zeven.txt'", StorageType = "str";

			parameter<String> realisatie_NbSGenuanceerd :=
				  'claim_ha;'         + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Claim_NL)
				+ ';gerealiseerd_ha;' + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Gerealiseerd_NL)
				+ ';tekort_ha;'       + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Tekort_NL)
				+ ';nat_claim_ha;'    + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Claim_NL)
				+ ';nat_gereal_ha;'   + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Gerealiseerd_NL)
				+ ';droog_claim_ha;'  + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Claim_NL)
				+ ';droog_gereal_ha;' + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Gerealiseerd_NL)
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_realisatie.txt'", StorageType = "str";

			parameter<String> vorm                      :=
				  'nat_aaneengesloten;'      + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Aaneengeslotenheid)
				+ ';nat_aselect;'            + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Aaneengeslotenheid_Aselect)
				+ ';nat_zelfde_type;'        + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Aaneengeslotenheid_Type)
				+ ';nat_vulgraad;'           + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Vulgraad)
				+ ';droog_aaneengesloten;'   + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Aaneengeslotenheid)
				+ ';droog_aselect;'          + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Aaneengeslotenheid_Aselect)
				+ ';droog_zelfde_type;'      + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Aaneengeslotenheid_Type)
				+ ';droog_vulgraad;'         + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Vulgraad)
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_vorm.txt'", StorageType = "str"
			, Descr = "Het spikkelpatroon uit #652 in een getal. Aaneengesloten is het aandeel van de dertien cellen binnen 50 meter dat ook natuur wordt, gemiddeld over de cellen die natuur worden; aselect is wat datzelfde getal zou zijn als de opgave willekeurig over de zeef was gestrooid. De verhouding tussen die twee is de toets.";

			parameter<String> krapte_droog              := 'regio;claim_ha;kandidaat_ha;krapte_ha;verlies_panden_ha|' + AsList(
			                                               /SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Claimregio_Droog/Label + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Claim_Totaal) + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Areaal_Kandidaat) + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Krapte) + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Droog/Controle/Areaal_Verlies_Pandentoets), '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_krapte_droog.txt'", StorageType = "str";

			parameter<String> krapte_nat                := 'regio;claim_ha;kandidaat_ha;krapte_ha;verlies_panden_ha|' + AsList(
			                                               /SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/Claimregio_Nat/Label + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Claim_Totaal) + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Areaal_Kandidaat) + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Krapte) + ';'
			                                               + string(/VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Zand/Alloc/Alloc_Nat/Controle/Areaal_Verlies_Pandentoets), '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_krapte_nat.txt'", StorageType = "str";
		}
		container Zand      := = /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Zand_T()' : '/Templates/Leeg', Descr = "Leeg zonder de variant NbSGenuanceerd (pbl-nl/model-RSopen#53).";

		container Veen
		: Descr = "De opgave, de realisatie en de onderrealisatie van de route die bepaalt wat er in het veen wordt opgelegd: de bouwsteenallocatie per peilgebied, gevolgd door de samenstelling binnen de
					bouwsteen (#684). De getallen voor de terugkoppeling van de onderrealisatie aan team Veen (#761); de veenketen zelf staat in Templates/VariantData/Natuur/Veen_T. Omdat de opgave op de
					kandidaatruimte is gebaseerd (#761) en de pandentoets is vervallen (#768) past zij per constructie, en is wat er aan tekort overblijft afrondingsgruis op hele cellen; loopt tekort_ha toch
					op, dan is er iets veranderd aan de zeef of aan dat oppervlak en niet aan de levering."
		{
			Template Bron_T
			: Descr = "De rekenstappen op de bouwsteenallocatie van NbSGenuanceerd; alleen geinstantieerd als die variant bestaat, als Bron (pbl-nl/model-RSopen#53)."
			{
				container          Levering                              := /VariantData/NbSGenuanceerd/NatuurLevering/Landschap/Veen;
				container          Bsn                                   := Levering/Alloc_Bouwsteen;

				unit<uint8>        BS                                    := Levering/BouwsteenType;

				attribute<Bool>    IsWaterBouwsteen                 (BS) := BS/deelstrategie == 'waterbuffering'
				, IntegrityCheck = "sum(uint32(this)) == 2"
				, Descr = "De twee bouwstenen die open water opleggen, in de brontabel 9a nieuw open water voor waterbuffering en 9b bestaand open water met extra buffercapaciteit. Herkend aan de kolom deelstrategie en niet aan de code, zodat de hernummering uit #762 hem niet stil uitschakelt; de IntegrityCheck telt dat het er precies twee zijn.";

				unit<uint32>       P                                     := Levering/Peilvak;
				unit<uint32>       D                                     := Levering/Deelgebied;

				parameter<float32> HaPerCel                              := float32(/Geography/AdminDomain/NrHaPerCell);

				attribute<float32> Opgave                            (P) := float32(Bsn/Controle/Claim_Totaal);
				attribute<float32> Ruimte                            (P) := float32(Bsn/Controle/Areaal_Kandidaat), Descr = "Wat het peilgebied na de zeef nog biedt: het gerasterde gebied min bestaand bebouwd gebied en min exogeen grondgebruik. Sinds #768 is dat ook het oppervlak waarover de aangeleverde fracties gelden, dus Opgave hoort hier onder te blijven.";
				attribute<float32> Gerealiseerd                      (P) := float32(Bsn/Controle/Gerealiseerd_Totaal);
				attribute<float32> Tekort                            (P) := float32(Bsn/Controle/Tekort_Totaal_Regio);
				attribute<float32> Krapte                            (P) := float32(Bsn/Controle/Krapte), Descr = "Opgave min kandidaatruimte. Positief betekent dat de opgave niet in het eigen peilgebied past, ongeacht hoe de allocator kiest. Hoort sinds #761 nergens meer positief te zijn, op afronding na.";
				attribute<float32> Opp                               (P) := float32(Levering/Opp_Peilvak);

				attribute<Bool>    IsVrij       (/Geography/AdminDomain) := Bsn/IsKandidaat && !Levering/HeeftBouwsteen, Descr = "Kandidaatcellen die geen bouwsteen hebben gekregen. Dat is het deel van de levering dat niet is aangeleverd, dus bouwsteen 0a, 0b, 1 en 10b, en die cellen houden hun huidige grondgebruik.";

				attribute<float32> Vrij_D                            (D) := sum(float32(IsVrij && IsDefined(D/Per_AdminDomain)), D/Per_AdminDomain) * HaPerCel;

				attribute<float32> Opgave_D                          (D) := sum(Opgave,       D/Per_Peilvak);
				attribute<float32> Gerealiseerd_D                    (D) := sum(Gerealiseerd, D/Per_Peilvak);
				attribute<float32> Tekort_D                          (D) := sum(Tekort,       D/Per_Peilvak);

				parameter<float32> Opp_BestaandWaterOnderAndereBouwsteen :=
					sum(float32(Levering/HeeftBouwsteen && !IsWaterBouwsteen[Levering/Bouwsteen_rel] && /SourceData/Grondgebruik/Natuur/Basisjaar/IsWater)) * HaPerCel
				, Descr = "Hoeveel hectare bestaand open water een bouwsteen krijgt die geen water oplegt. De zeef van de bouwsteenallocatie is het hele veengebied, dus bestaand water doet gewoon mee. Of dat zo hoort is een vraag aan Deltares, zie #761: als bestaand water alleen door 9a of 9b vervangen mag worden hoort die regel in Geschiktheid_Bouwsteen thuis.";

				parameter<String>  Regel_Realisatie                      :=
					  'claim_ha;'               + string(float32(Bsn/Controle/Claim_NL))
					+ ';gerealiseerd_ha;'       + string(float32(Bsn/Controle/Gerealiseerd_NL))
					+ ';tekort_ha;'             + string(float32(Bsn/Controle/Tekort_NL))
					+ ';afgedwongen_tekort_ha;' + string(sum(max_elem(Krapte, 0f)))
					+ ';n_peilvak;'             + string(float32(#P))
					+ ';n_krap;'                + string(sum(float32(Krapte > 0f)))
					+ ';veengebied_ha;'         + string(float32(Levering/Controle/Areaal_Veengebied))
					+ ';kandidaatruimte_ha;'    + string(sum(Ruimte))
					+ ';verlies_panden_ha;'     + string(float32(Bsn/Controle/Verlies_Pandentoets_NL))
					+ ';vrije_ruimte_ha;'       + string(sum(float32(IsVrij)) * HaPerCel)
					+ ';op_bestaand_water_ha;'  + string(Opp_BestaandWaterOnderAndereBouwsteen)
					+ ';bs9a_ha;'               + string(float32(Levering/Controle_Bouwsteen/Opp_NieuwWater))
					+ ';bs9a_op_landbouw_ha;'   + string(float32(Levering/Controle_Bouwsteen/Opp_NieuwWater_OpLandbouw))
					+ ';natuur_ha;'             + string(float32(Levering/Controle_Uitkomst/Opp_Natuur))
					+ ';natuur_op_bestaande_natuur_ha;'         + string(float32(Levering/Controle_Uitkomst/Opp_Natuur_OpBestaandeNatuur))
					+ ';bestaande_natuur_onder_bouwsteen_ha;'   + string(float32(Levering/Controle_Uitkomst/Opp_BestaandeNatuur_OnderBouwsteen))
					+ ';bebouwd_ha;'            + string(float32(Levering/Controle_Uitkomst/Opp_Bebouwd))
					+ ';bebouwd_op_bestaande_bebouwing_ha;'     + string(float32(Levering/Controle_Uitkomst/Opp_Bebouwd_OpBestaandeBebouwing))
					+ ';bestaande_natuur_onder_natuurbouwsteen_ha;'      + string(float32(Levering/Controle_Uitkomst/Opp_BestaandeNatuur_OnderNatuurBouwsteen))
					+ ';bestaande_bebouwing_onder_bouwsteen_ha;'          + string(float32(Levering/Controle_Uitkomst/Opp_BestaandeBebouwing_OnderBouwsteen))
					+ ';bestaande_bebouwing_onder_bebouwdbouwsteen_ha;'   + string(float32(Levering/Controle_Uitkomst/Opp_BestaandeBebouwing_OnderBebouwdBouwsteen));

				parameter<String>  Regel_Terugkoppeling                  := 'sleutel;deelgebied;opp_ha;opgave_ha;ruimte_ha;gerealiseerd_ha;tekort_ha|' + AsList(
				                                                              Levering/Peilvak/Sleutel + ';'
				                                                            + Levering/Peilvak/Deelgebied_Naam + ';'
				                                                            + string(Opp) + ';'
				                                                            + string(Opgave) + ';'
				                                                            + string(Ruimte) + ';'
				                                                            + string(Gerealiseerd) + ';'
				                                                            + string(Tekort), '|');

				parameter<String>  Regel_PerDeelgebied                   := 'deelgebied;opgave_ha;gerealiseerd_ha;tekort_ha;vrije_ruimte_ha|' + AsList(
				                                                              D/Label + ';'
				                                                            + string(Opgave_D) + ';'
				                                                            + string(Gerealiseerd_D) + ';'
				                                                            + string(Tekort_D) + ';'
				                                                            + string(Vrij_D), '|');

				parameter<String>  Regel_PerBouwsteen                    := 'bouwsteen;claim_ha;gerealiseerd_ha;tekort_ha|' + AsList(
				                                                              BS/code + ';'
				                                                            + string(float32(Levering/Controle_Bouwsteen/Claim_BS)) + ';'
				                                                            + string(float32(Levering/Controle_Bouwsteen/Gerealiseerd_BS)) + ';'
				                                                            + string(float32(Levering/Controle_Bouwsteen/Tekort_BS)), '|');

				parameter<String>  Regel_Waterkaart                      :=
					  'water_in_model_ha;'      + string(float32(Levering/Controle/Areaal_AlWater))
					+ '|claim_9b_ha;'           + string(float32(sum(Levering/Controle/Claim_BestaandWater_PerPeilvak)))
					+ '|water_te_weinig_voor_9b_ha;' + string(float32(Levering/Controle/Water_TeWeinigVoor9b))
					+ '|water_meer_dan_9b_ha;'  + string(float32(Levering/Controle/Water_MeerDan9b));
			}
			container          Bron              := = /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron_T()' : '/Templates/Leeg';

			parameter<Bool>    IsVanToepassing   := /VariantParameters/VariantK/HeeftLandschapslevering[rlookup(/Diagnose/Variant, /VariantParameters/VariantK/name)], Descr = "Draait deze casus de bouwsteenallocatie? Uit VariantK/Landschap_Levering, dus elke variant met een veenlevering. Staat hij op onwaar, dan schrijven de drie uitdraaien een regel die dat zegt, in plaats van een allocatie af te dwingen die deze casus niet gebruikt. Dat is nodig omdat GenerateAll deze items ook in een BAU-run opvraagt.";

			parameter<String>  NietVanToepassing := 'niet_van_toepassing;deze casus draait de bouwsteenallocatie niet';

			parameter<String>  realisatie        := =IsVanToepassing && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Regel_Realisatie' : 'NietVanToepassing'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veenbouwstenen_realisatie.txt'", StorageType = "str"
			, Descr = "De opgave van de bouwstenen en wat de allocatie ervan haalt, landelijk. Tekort_ha is het getal dat na een run aan team Veen wordt gemeld; het hoort klein te zijn en van afronding te komen,
						want MaxClaims kapt elke opgave per peilgebied per bouwsteen af op hele cellen, en er is bewust geen tweede trap die dat opruimt (zie Bouwsteen_rel over het besluit dat overhevelen tussen
						peilgebieden niet mag). Claim_ha hoort onder kandidaatruimte_ha te blijven, want die kandidaatruimte is het oppervlak waarover de aangeleverde fracties gelden (#761); vrije_ruimte_ha is wat
						er daarna aan kandidaatcellen over is, het niet aangeleverde deel van de levering. Verlies_panden_ha hoort nul te zijn en staat er als controle: loopt hij op, dan is de pandentoets ergens
						weer aangezet (#768). Afgedwongen_tekort_ha is de som van de positieve krapte per peilgebied; op_bestaand_water_ha staat er als openstaand punt, zie Opp_BestaandWaterOnderAndereBouwsteen. De
						velden daarachter meten de herkomstvoorkeur uit #660: bs9a_op_landbouw_ha hoort dicht bij bs9a_ha te liggen, en natuur_op_bestaande_natuur_ha en bebouwd_op_bestaande_bebouwing_ha lees je
						naast het beschikbare areaal dat erachter staat, want de teller wordt door de opgave begrensd en niet door het aanbod; blijft een van beide ver onder dat beschikbare areaal, dan doet de
						voorkeur haar werk niet.";

			parameter<String>  terugkoppeling    := =IsVanToepassing && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Regel_Terugkoppeling' : 'NietVanToepassing'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veenbouwstenen_terugkoppeling.txt'", StorageType = "str"
			, Descr = "De onderrealisatie per peilgebied van de route die de kaart maakt, de tabel die in #660 als actie voor team RS staat en in #761 op de bouwsteenroute is gezet. Alles gaat over de eigen opgave
						van het gebied; wat er niet past blijft in dat gebied liggen en schuift niet naar een buurgebied. De sleutel is GPGIDENT voor de peilvakkenlaag en de deelgebiednaam voor de laag zonder
						peilvak. Rijen gescheiden door een verticale streep; filter op tekort_ha groter dan nul voor de gebieden waar de opgave niet paste.";

			parameter<String>  perbouwsteen      := =IsVanToepassing && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Regel_PerBouwsteen' : 'NietVanToepassing'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veenbouwstenen_perbouwsteen.txt'", StorageType = "str"
			, Descr = "De opgave en de realisatie per bouwsteen, landelijk: de derde uitdraai naast die per peilgebied en die per deelgebied, en de enige die zegt welke bouwsteen het tekort veroorzaakt. Dat
						onderscheid is nodig omdat de bouwstenen drie verschillende watertoetsen dragen: een tekort bij 9b betekent dat de levering in dat peilgebied meer bestaand open water vraagt dan er ligt, een
						tekort bij de tien terrestrische bouwstenen dat hun opgave over een peilgebiedoppervlak geldt waar water in zit waar zij met WaterMagLandWorden uit niet op mogen, en wat daarnaast overblijft
						is de afkap op hele cellen.";

			parameter<String>  perdeelgebied     := =IsVanToepassing && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Regel_PerDeelgebied' : 'NietVanToepassing'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veenbouwstenen_perdeelgebied.txt'", StorageType = "str"
			, Descr = "Hetzelfde per deelgebied. Het deelgebied is geen eigen allocatieniveau (#761), dus deze tabel is een optelling van de peilgebieden. Vrije_ruimte_ha zegt hoeveel kandidaatruimte er in het deelgebied onbenut blijft, het niet aangeleverde deel van de levering.";
			parameter<String>  waterkaart        := =IsVanToepassing && /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Bron/Regel_Waterkaart' : 'NietVanToepassing'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veenbouwstenen_waterkaart.txt'", StorageType = "str"
			, Descr = "De twee kanten van het verschil tussen de waterkaart van het model en de 9b-fractie van de levering, voor de terugkoppeling aan team Veen (#660): waar de levering meer bestaand open
						water vraagt dan er ligt en waar er meer ligt dan zij vraagt. Meet de twee altijd samen, ze heffen elkaar landelijk grotendeels op; het is een verschil in ligging tussen twee
						waterkaarten en geen wateroppervlak. Welke kaart en welk peiljaar onder de 9b-fractie zit is de openstaande vraag in #660.";
		}

		Template Overzicht_T
		: Descr = "Op aanvraag. Zet de natuurbronnen naast elkaar en meet de overlap, op AdminDomain binnen het studiegebied. Twee stromen die uit elkaar gehouden moeten worden: opleggen betekent dat de cel van
					grondgebruik verandert en de indicatoren voor landgebruik, NDVI, koolstof en de sloop- en uitkoopkosten erop afrekenen; op slot betekent alleen dat er geen nieuwbouw meer bij komt. Een
					gebied kan het een zijn, het ander, of allebei."
		{
			parameter</Units/ha> Cel                                    := /Geography/AdminDomain/NrHaPerCell;

			attribute<Bool>      InStudy       (/Geography/AdminDomain) := /Geography/rdc_meter/IsStudyArea_AdminDomain;
			attribute<Bool>      MagOpleggen   (/Geography/AdminDomain) := /BaseData/StartState/Opleggingsmasker/MagOpleggen, Descr = "Het gedeelde opleggingsmasker, hetzelfde item dat VariantData/ExogeenOpleggen en de natuurallocatie lezen (#661), zodat de kolom die zegt hoeveel er na het masker overblijft dezelfde afbakening heeft als het model.";

			// de terrestrische natuur per landschap, zoals NatuurLevering die in NbSGenuanceerd levert; water blijft hier buiten zodat de vergelijking met MNP dezelfde grootheid houdt
			attribute<Bool>      Veen          (/Geography/AdminDomain) := InStudy && IsDefined(/VariantData/NbSGenuanceerd/NatuurLevering/Veen/Type)     && !/VariantData/NbSGenuanceerd/NatuurLevering/Veen/IsWater;
			attribute<Bool>      Kust          (/Geography/AdminDomain) := InStudy && IsDefined(/VariantData/NbSGenuanceerd/NatuurLevering/Kust/Type)     && !/VariantData/NbSGenuanceerd/NatuurLevering/Kust/IsWater;
			attribute<Bool>      Rivieren      (/Geography/AdminDomain) := InStudy && IsDefined(/VariantData/NbSGenuanceerd/NatuurLevering/Rivieren/Type) && !/VariantData/NbSGenuanceerd/NatuurLevering/Rivieren/IsWater;
			attribute<Bool>      Zand          (/Geography/AdminDomain) := InStudy && (IsDefined(/VariantData/NbSGenuanceerd/NatuurLevering/Zand/Type_Nat) || IsDefined(/VariantData/NbSGenuanceerd/NatuurLevering/Zand/Type_Droog));
			attribute<Bool>      MNP           (/Geography/AdminDomain) := InStudy && IsDefined(/BaseData/Grondgebruik/Natuur/Bron/Landelijk_BAU/INL_Beheertype_rel_AD) && !/Classifications/Grondgebruik/INL_Beheertype/IsWater[/BaseData/Grondgebruik/Natuur/Bron/Landelijk_BAU/INL_Beheertype_rel_AD];

			attribute<Bool>      VierBeelden   (/Geography/AdminDomain) := Veen || Kust || Rivieren || Zand;
			attribute<Bool>      MetMNP        (/Geography/AdminDomain) := VierBeelden || MNP;

			parameter<String>    opleggen                               :=
				  'bron;levering_ha;na_masker_ha'
				+ '|veen;'      + string(sum(float32(Veen)     * Cel)) + ';' + string(sum(float32(Veen     && MagOpleggen) * Cel))
				+ '|kust;'      + string(sum(float32(Kust)     * Cel)) + ';' + string(sum(float32(Kust     && MagOpleggen) * Cel))
				+ '|rivieren;'  + string(sum(float32(Rivieren) * Cel)) + ';' + string(sum(float32(Rivieren && MagOpleggen) * Cel))
				+ '|zand;'      + string(sum(float32(Zand)     * Cel)) + ';' + string(sum(float32(Zand     && MagOpleggen) * Cel))
				+ '|mnp_bau;'   + string(sum(float32(MNP)      * Cel)) + ';' + string(sum(float32(MNP      && MagOpleggen) * Cel))
				+ '|vier_beelden_unie;' + string(sum(float32(VierBeelden) * Cel)) + ';' + string(sum(float32(VierBeelden && MagOpleggen) * Cel))
				+ '|met_mnp_unie;'      + string(sum(float32(MetMNP)      * Cel)) + ';' + string(sum(float32(MetMNP      && MagOpleggen) * Cel))
				+ '|mnp_bovenop_beelden;' + string(sum(float32(MNP && !VierBeelden) * Cel)) + ';' + string(sum(float32(MNP && !VierBeelden && MagOpleggen) * Cel))
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_opleggen.txt'", StorageType = "str";

			parameter<String>    basisjaarnatuur                        :=
				  'maat;ha'
				+ '|natuur_basisjaar;'      + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_Natuur)
				+ '|met_beheertype;'        + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_MetBeheertype)
				+ '|zonder_beheertype;'     + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_ZonderBeheertype)
				+ '|mnp_plandeel;'          + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_MNP_Plandeel)
				+ '|bt_uit_nbp;'            + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_uit_NBP)
				+ '|bt_uit_mnp;'            + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_uit_MNP)
				+ '|bt_alleen_nbp;'         + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_alleen_NBP)
				+ '|bt_beide;'              + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_Beide)
				+ '|bt_eens;'               + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_Eens)
				+ '|nt_eens;'               + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_NT_Eens)
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_basisjaar.txt'", StorageType = "str";

			parameter<String>    oplegging_per_variant                  :=
				  'variant;opgelegd_ha'
				+ '|BAU;'             + string(sum(float32(/VariantData/BAU/ExogeenOpleggen/IsOpgelegd)             * Cel))
				+ '|NbSGenuanceerd;'  + string(sum(float32(/VariantData/NbSGenuanceerd/ExogeenOpleggen/IsOpgelegd)  * Cel))
				+ '|NbSGenuanceerder;'+ string(sum(float32(/VariantData/NbSGenuanceerder/ExogeenOpleggen/IsOpgelegd) * Cel))
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_oplegging_per_variant.txt'", StorageType = "str";

			// #511 liet een toets open: overlapt de BAU-rivierenkaart van Deltares met de MNP-kaart van WUR?
			attribute<Bool>      RivierBAU     (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_BAU/INL_Beheertype_rel_AD);
			attribute<Bool>      MNP_Natuur    (/Geography/AdminDomain) := MNP;

			parameter<String>    rivierbau_vs_mnp                       :=
				  'maat;ha'
				+ '|rivierbau_totaal;'        + string(sum(float32(RivierBAU) * Cel))
				+ '|ook_in_mnp;'              + string(sum(float32(RivierBAU && MNP_Natuur) * Cel))
				+ '|niet_in_mnp;'             + string(sum(float32(RivierBAU && !MNP_Natuur) * Cel))
				+ '|niet_in_mnp_en_nu_geen_natuur;' + string(sum(float32(RivierBAU && !MNP_Natuur && !/SourceData/Grondgebruik/Natuur/Basisjaar/IsNatuur) * Cel))
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rivierbau_vs_mnp.txt'", StorageType = "str";

			parameter<String>    rivieren_ecotopen                      := 'ecotoop;levering_ha;raster_ha;ratio|' + AsList(
			                                                               /Classifications/Grondgebruik/NbSRivieren/RivierEcotoop/name + ';'
			                                                               + string(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Controle/PerEcotoop/Vector) + ';'
			                                                               + string(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Controle/PerEcotoop/Raster) + ';'
			                                                               + string(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Controle/PerEcotoop/Ratio), '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rivieren_ecotopen.txt'", StorageType = "str";

			// klopt de zonering: loopt de diepte af langs de gradient, en landt het zomerbed op bestaand water
			unit<uint8> GradientK := /Classifications/Grondgebruik/NbSRivieren/Gradient
			{
				attribute<string>  Naam       := /Classifications/Grondgebruik/NbSRivieren/Gradient/name;
				attribute<float32> Diepte_Gem := mean(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Diepte_Cel[float32], /SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Gradient_rel_Cel);
				attribute<float32> Fr_OpWater := mean(float32(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/IsWater_Cel), /SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Gradient_rel_Cel);
				attribute<uint32>  Aantal     := pcount(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Gradient_rel_Cel)[uint32];
				attribute<float32> Kern_Gem   := mean(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Waterkern_AD[/SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/RivierCel/AdminDomain_rel], /SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/Gradient_rel_Cel);
				attribute<string>  Regel      := Naam + ';' + string(Aantal) + ';' + string(Diepte_Gem) + ';' + string(Fr_OpWater) + ';' + string(Kern_Gem);
			}

			parameter<String>    rivieren_zonering                      := 'ecotoop;cellen;diepte_gem_m;aandeel_op_bestaand_water;waterkern_gem|' + AsList(GradientK/Regel, '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rivieren_zonering.txt'", StorageType = "str";

			parameter<String>    opleg_overlap                          :=
				  'paar;overlap_ha'
				+ '|veen_kust;'         + string(sum(float32(Veen && Kust) * Cel))
				+ '|veen_rivieren;'     + string(sum(float32(Veen && Rivieren) * Cel))
				+ '|veen_zand;'         + string(sum(float32(Veen && Zand) * Cel))
				+ '|kust_rivieren;'     + string(sum(float32(Kust && Rivieren) * Cel))
				+ '|kust_zand;'         + string(sum(float32(Kust && Zand) * Cel))
				+ '|rivieren_zand;'     + string(sum(float32(Rivieren && Zand) * Cel))
				+ '|mnp_veen;'          + string(sum(float32(MNP && Veen) * Cel))
				+ '|mnp_kust;'          + string(sum(float32(MNP && Kust) * Cel))
				+ '|mnp_rivieren;'      + string(sum(float32(MNP && Rivieren) * Cel))
				+ '|mnp_zand;'          + string(sum(float32(MNP && Zand) * Cel))
				+ '|som_vier_los;'      + string(sum(float32(Veen) * Cel) + sum(float32(Kust) * Cel) + sum(float32(Rivieren) * Cel) + sum(float32(Zand) * Cel))
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_opleg_overlap.txt'", StorageType = "str";

			// de zeefkant: waar gaat het gebied op slot voor nieuwbouw
			attribute<Bool>      Zeef_Veen     (/Geography/AdminDomain) := InStudy && /BaseData/Omgeving/Bebouwingstype_Veen_NbSGenuanceerd/bebouwingstype_nbsnuanc/SlopenEnOpSlot;
			attribute<Bool>      Zeef_Kust     (/Geography/AdminDomain) := InStudy && /SourceData/Grondgebruik/Natuur/Bron/Kust_NbSGenuanceerd/IsKustIngreep;
			attribute<Bool>      Zeef_Zand     (/Geography/AdminDomain) := InStudy && /SourceData/Grondgebruik/Natuur/Bron/Zand_Allocatiebasis/NietBouwen;
			attribute<Bool>      Zeef_Rivieren (/Geography/AdminDomain) := InStudy && /SourceData/Grondgebruik/Natuur/Bron/Rivieren_NbSGenuanceerd/NietBouwen;
			attribute<Bool>      Zeef_Unie     (/Geography/AdminDomain) := Zeef_Veen || Zeef_Kust || Zeef_Zand || Zeef_Rivieren;

			parameter<String>    zeef                                   :=
				  'bron;op_slot_ha;waarvan_ook_opgelegd_ha'
				+ '|veen;'     + string(sum(float32(Zeef_Veen)     * Cel)) + ';' + string(sum(float32(Zeef_Veen     && VierBeelden && MagOpleggen) * Cel))
				+ '|kust;'     + string(sum(float32(Zeef_Kust)     * Cel)) + ';' + string(sum(float32(Zeef_Kust     && VierBeelden && MagOpleggen) * Cel))
				+ '|zand;'     + string(sum(float32(Zeef_Zand)     * Cel)) + ';' + string(sum(float32(Zeef_Zand     && VierBeelden && MagOpleggen) * Cel))
				+ '|rivieren;' + string(sum(float32(Zeef_Rivieren) * Cel)) + ';' + string(sum(float32(Zeef_Rivieren && VierBeelden && MagOpleggen) * Cel))
				+ '|unie;'     + string(sum(float32(Zeef_Unie)     * Cel)) + ';' + string(sum(float32(Zeef_Unie     && VierBeelden && MagOpleggen) * Cel))
				+ '|opgelegd_zonder_zeef;' + string(sum(float32(VierBeelden && MagOpleggen && !Zeef_Unie) * Cel)) + ';0'
				+ '|zeef_overlap_veen_zand;' + string(sum(float32(Zeef_Veen && Zeef_Zand) * Cel)) + ';0'
				+ '|zeef_overlap_zand_rivieren;' + string(sum(float32(Zeef_Zand && Zeef_Rivieren) * Cel)) + ';0'
				+ '|zeef_overlap_veen_rivieren;' + string(sum(float32(Zeef_Veen && Zeef_Rivieren) * Cel)) + ';0'
				+ '|zeef_overlap_veen_kust;' + string(sum(float32(Zeef_Veen && Zeef_Kust) * Cel)) + ';0'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_zeef.txt'", StorageType = "str";
		}
		container Overzicht := = /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Overzicht_T()' : '/Templates/Leeg', Descr = "Leeg zonder de variant NbSGenuanceerd (pbl-nl/model-RSopen#53).";

		Template Rangorde_T
		: Descr = "Op aanvraag. De voorrang tussen de landschappen in de natuurstroom (kust, zand nat, veen, rivieren, zand droog, onderlaag; Templates/VariantData/Natuur/Natuur_T/Levering) gelegd naast
					de twee stromen die haar niet kennen (#829): de landbouwstroom van veen, die in ExogeenOpleggen alleen landt waar geen beheertype ligt, ook als dat beheertype van een landschap van lagere
					rang komt; en de zandallocatie, die haar hectares ook zet op cellen die een levering van hogere rang daarna wint. Per paar de overlap binnen het studiegebied, met ernaast wat er na het
					opleggingsmasker van overblijft. Water telt hier mee, anders dan in Overzicht, want de voorrang loopt per landschap over natuur en water samen."
		{
			parameter</Units/ha> Cel                                         := /Geography/AdminDomain/NrHaPerCell;
			container            NL                                          := /VariantData/NbSGenuanceerd/NatuurLevering, Descr = "De stroom van de variant met landschapsleveringen, voor het masker.";

			attribute<Bool>      InStudy            (/Geography/AdminDomain) := /Geography/rdc_meter/IsStudyArea_AdminDomain;
			attribute<Bool>      MagOpleggen        (/Geography/AdminDomain) := /BaseData/StartState/Opleggingsmasker/MagOpleggen;

			attribute<Bool>      Kust               (/Geography/AdminDomain) := InStudy && IsDefined(NL/Kust/Type);
			attribute<Bool>      ZandNat            (/Geography/AdminDomain) := InStudy && IsDefined(NL/Zand/Type_Nat);
			attribute<Bool>      VeenNatuur         (/Geography/AdminDomain) := InStudy && IsDefined(NL/Veen/Type);
			attribute<Bool>      VeenLandbouw       (/Geography/AdminDomain) := InStudy && IsDefined(NL/Veen/LandbouwType_rel), Descr = "Natte teelt en de twee vernatte graslandtypen; binnen het veen sluiten natuur en landbouw elkaar per cel uit.";
			attribute<Bool>      Rivieren           (/Geography/AdminDomain) := InStudy && IsDefined(NL/Rivieren/Type);
			attribute<Bool>      ZandDroog          (/Geography/AdminDomain) := InStudy && IsDefined(NL/Zand/Type_Droog);
			attribute<Bool>      Onderlaag          (/Geography/AdminDomain) := InStudy && IsDefined(NL/Landelijk/Type_Onderlaag);
			attribute<Bool>      VeenCel            (/Geography/AdminDomain) := InStudy && NL/Landschap/Veen/IsVeenCel, Descr = "Binnen de aangeleverde veenpolygonen, ongeacht wat de allocatie er neerlegt.";
			attribute<Bool>      InLandschapVeen    (/Geography/AdminDomain) := /SourceData/Landschap/Landschapsgebieden/Impl/IsVeen, Descr = "De veenbegrenzing van #760 waarbinnen de onderlaag geblokkeerd is; de veenlevering hoort daarbinnen te liggen.";

			attribute<Bool>      BovenVeen          (/Geography/AdminDomain) := Kust || ZandNat,                Descr = "De leveringen die volgens de rangorde van veen mogen winnen.";
			attribute<Bool>      OnderVeen          (/Geography/AdminDomain) := Rivieren || ZandDroog || Onderlaag, Descr = "De leveringen die volgens de rangorde van veen horen te verliezen.";

			// de landbouwstroom na het masker: waar de veenlandbouw niet in de stand komt, en waar dat komt doordat een ander landschap er een nieuw beheertype neerlegt; het verschil zijn de cellen
			// waar een landschap van hogere rang bestaande natuur bevestigt en de cel dus blijft wat zij is
			attribute<Bool>      LandbouwVerdrongen (/Geography/AdminDomain) := VeenLandbouw && MagOpleggen && !IsDefined(/VariantData/NbSGenuanceerd/ExogeenOpleggen/LandbouwType_rel);
			attribute<Bool>      LandbouwVerdrongen_Beheertype (/Geography/AdminDomain) := VeenLandbouw && MagOpleggen &&  IsDefined(/VariantData/NbSGenuanceerd/ExogeenOpleggen/Beheertype);

			parameter<String>    rangorde                                    :=
				  'stroom;maat;levering_ha;na_masker_ha'
				+ '|landbouw;veen_landbouw;'                   + string(sum(float32(VeenLandbouw) * Cel))                          + ';' + string(sum(float32(VeenLandbouw && MagOpleggen) * Cel))
				+ '|landbouw;onder_kust;'                      + string(sum(float32(VeenLandbouw && Kust) * Cel))                  + ';' + string(sum(float32(VeenLandbouw && Kust && MagOpleggen) * Cel))
				+ '|landbouw;onder_zand_nat;'                  + string(sum(float32(VeenLandbouw && ZandNat) * Cel))               + ';' + string(sum(float32(VeenLandbouw && ZandNat && MagOpleggen) * Cel))
				+ '|landbouw;onder_rivieren;'                  + string(sum(float32(VeenLandbouw && Rivieren) * Cel))              + ';' + string(sum(float32(VeenLandbouw && Rivieren && MagOpleggen) * Cel))
				+ '|landbouw;onder_zand_droog;'                + string(sum(float32(VeenLandbouw && ZandDroog) * Cel))             + ';' + string(sum(float32(VeenLandbouw && ZandDroog && MagOpleggen) * Cel))
				+ '|landbouw;onder_onderlaag;'                 + string(sum(float32(VeenLandbouw && Onderlaag) * Cel))             + ';' + string(sum(float32(VeenLandbouw && Onderlaag && MagOpleggen) * Cel))
				+ '|landbouw;alleen_onder_lagere_rang;'        + string(sum(float32(VeenLandbouw && OnderVeen && !BovenVeen) * Cel)) + ';' + string(sum(float32(VeenLandbouw && OnderVeen && !BovenVeen && MagOpleggen) * Cel))
				+ '|landbouw;verdrongen;'                      + string(sum(float32(LandbouwVerdrongen) * Cel))                    + ';' + string(sum(float32(LandbouwVerdrongen) * Cel))
				+ '|landbouw;verdrongen_met_nieuw_beheertype;' + string(sum(float32(LandbouwVerdrongen_Beheertype) * Cel))         + ';' + string(sum(float32(LandbouwVerdrongen_Beheertype) * Cel))
				+ '|landbouw;verdrongen_door_lagere_rang;'     + string(sum(float32(LandbouwVerdrongen && !BovenVeen) * Cel))      + ';' + string(sum(float32(LandbouwVerdrongen && !BovenVeen) * Cel))
				+ '|landbouw;toegekend;'                       + string(sum(float32(InStudy && IsDefined(/VariantData/NbSGenuanceerd/ExogeenOpleggen/LandbouwType_rel)) * Cel)) + ';' + string(sum(float32(InStudy && IsDefined(/VariantData/NbSGenuanceerd/ExogeenOpleggen/LandbouwType_rel)) * Cel))
				+ '|zand;zand_nat;'                            + string(sum(float32(ZandNat) * Cel))                               + ';' + string(sum(float32(ZandNat && MagOpleggen) * Cel))
				+ '|zand;zand_nat_onder_kust;'                 + string(sum(float32(ZandNat && Kust) * Cel))                       + ';' + string(sum(float32(ZandNat && Kust && MagOpleggen) * Cel))
				+ '|zand;zand_droog;'                          + string(sum(float32(ZandDroog) * Cel))                             + ';' + string(sum(float32(ZandDroog && MagOpleggen) * Cel))
				+ '|zand;zand_droog_onder_kust;'               + string(sum(float32(ZandDroog && Kust) * Cel))                     + ';' + string(sum(float32(ZandDroog && Kust && MagOpleggen) * Cel))
				+ '|zand;zand_droog_onder_veen_natuur;'        + string(sum(float32(ZandDroog && VeenNatuur) * Cel))               + ';' + string(sum(float32(ZandDroog && VeenNatuur && MagOpleggen) * Cel))
				+ '|zand;zand_droog_onder_veen_landbouw;'      + string(sum(float32(ZandDroog && VeenLandbouw) * Cel))             + ';' + string(sum(float32(ZandDroog && VeenLandbouw && MagOpleggen) * Cel))
				+ '|zand;zand_droog_onder_rivieren;'           + string(sum(float32(ZandDroog && Rivieren) * Cel))                 + ';' + string(sum(float32(ZandDroog && Rivieren && MagOpleggen) * Cel))
				+ '|zand;zand_droog_onder_hogere_rang;'        + string(sum(float32(ZandDroog && (Kust || VeenNatuur || Rivieren)) * Cel)) + ';' + string(sum(float32(ZandDroog && (Kust || VeenNatuur || Rivieren) && MagOpleggen) * Cel))
				+ '|zand;zand_droog_onder_hogere_rang_met_veenlandbouw;' + string(sum(float32(ZandDroog && (Kust || VeenNatuur || VeenLandbouw || Rivieren)) * Cel)) + ';' + string(sum(float32(ZandDroog && (Kust || VeenNatuur || VeenLandbouw || Rivieren) && MagOpleggen) * Cel))
				+ '|veen;veen_natuur;'                         + string(sum(float32(VeenNatuur) * Cel))                            + ';' + string(sum(float32(VeenNatuur && MagOpleggen) * Cel))
				+ '|veen;veen_natuur_onder_kust;'              + string(sum(float32(VeenNatuur && Kust) * Cel))                    + ';' + string(sum(float32(VeenNatuur && Kust && MagOpleggen) * Cel))
				+ '|veen;veen_natuur_onder_zand_nat;'          + string(sum(float32(VeenNatuur && ZandNat) * Cel))                 + ';' + string(sum(float32(VeenNatuur && ZandNat && MagOpleggen) * Cel))
				+ '|veen;veen_landbouw_onder_kust;'            + string(sum(float32(VeenLandbouw && Kust) * Cel))                  + ';' + string(sum(float32(VeenLandbouw && Kust && MagOpleggen) * Cel))
				+ '|veen;veen_landbouw_onder_zand_nat;'        + string(sum(float32(VeenLandbouw && ZandNat) * Cel))               + ';' + string(sum(float32(VeenLandbouw && ZandNat && MagOpleggen) * Cel))
				+ '|veen;veen_cel_buiten_landschapsgebied;'    + string(sum(float32(VeenCel && !InLandschapVeen) * Cel))            + ';' + string(sum(float32(VeenCel && !InLandschapVeen && MagOpleggen) * Cel))
				+ '|veen;veen_cel_onder_onderlaag;'            + string(sum(float32(VeenCel && Onderlaag) * Cel))                   + ';' + string(sum(float32(VeenCel && Onderlaag && MagOpleggen) * Cel))
				+ '|veen;veen_cel_onder_onderlaag_zonder_type;'+ string(sum(float32(VeenCel && Onderlaag && !VeenNatuur && !VeenLandbouw) * Cel)) + ';' + string(sum(float32(VeenCel && Onderlaag && !VeenNatuur && !VeenLandbouw && MagOpleggen) * Cel))
				+ '|landbouw;onder_onderlaag_buiten_landschapsgebied;' + string(sum(float32(VeenLandbouw && Onderlaag && !InLandschapVeen) * Cel)) + ';' + string(sum(float32(VeenLandbouw && Onderlaag && !InLandschapVeen && MagOpleggen) * Cel))
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rangorde.txt'", StorageType = "str"
			, Descr = "Drie blokken. Landbouw: de landbouwstroom van veen tegen elke natuurlevering, met onderaan wat er na het masker werkelijk verdrongen wordt, welk deel daarvan door een nieuw beheertype
					en welk deel door een landschap van lagere rang; toegekend plus verdrongen is de levering na het masker, en verdrongen_door_lagere_rang hoort nul te zijn sinds de landbouwstroom rangbewust
					is (#829). Zand: de gealloceerde zandnatuur tegen de leveringen van hogere rang, zonder en met de veenlandbouw, die sinds #829 ook van zand droog wint; beide horen nul te zijn zodra de
					zeef ze overslaat. Veen: wat veen zelf verliest aan kust en zand nat; dat volgt uit de afgesproken volgorde, maar de veenallocatie weet het niet.";
		}
		container Rangorde  := = /Diagnose/Voorwaarde/MetNbSGenuanceerd ? 'Rangorde_T()' : '/Templates/Leeg', Descr = "Leeg zonder de variant NbSGenuanceerd (pbl-nl/model-RSopen#53).";
	}

	container Piekbuiberging
	: Descr = "Waar de dekkingsgraad van de piekbuiberging vandaan komt, uitgesplitst naar de mechanismen die er samen in zitten (#720, #741, #746, #757). Dekking hangt aan GenerateAll en
				batch/ToetsOplevering.ps1 leest het bestand piekbuiberging_<casus>_<jaar>.txt voor de dekkingsgraad; de getallen met een norm staan als rijen piekbui_* in Checks."
	{
		attribute<Bool>    IsWbCel (/Geography/AdminDomain) := = /ModelParameters/SectorAllocRegio/Uq_Sectors/HasWaterbergingSector
		                                                       ? /Diagnose/Pad_Z+'Stand/Sector_rel == /Classifications/Actor/Sector/V/Waterberging'
		                                                       : 'const(FALSE, /Geography/AdminDomain)';

		parameter<String>  Pad_A_Aanbod                     := /Diagnose/Pad_Z+'Piekbuiberging/Aanbod/WaarAllocatieHeeftPlaatsgevonden/';
		parameter<String>  Pad_G_Aanbod                     := /Diagnose/Pad_Z+'Piekbuiberging/Aanbod/WaarGeenAllocatieHeeftPlaatsgevonden/';

		unit<UInt8> MaatregelTerm : NrOfRows = 7
		, Descr = "De zeven maatregeltermen die Wonen/Totaal optelt. Als tabel en niet als uitgeschreven lijst, zodat de controle hieronder meebeweegt wanneer er een term bij komt."
		{
			attribute<String> pad : ['OpDaken/Resultaat','OpOverigVerhardUitgeefbaar/Resultaat','OpVerhardOpenbaar/Resultaat','OpGrasUitgeefbaar/Resultaat','OpGrasOpenbaar/Resultaat','OpOverigGroen/Resultaat','OpWater/Resultaat'], IntegrityCheck = "all(IsDefined(this))";
		}
		parameter<Float64> Opgave_mln_m3                    := ='sum(float64(/Indicatoren/'+/Diagnose/Casus+'/Basisjaar/Piekbuiberging/PerGrid/Opgave)) / 1e6', Descr = "De regel piekbui_opgave_mln_m3 in Checks: de opgave in bestaand bebouwd gebied, die in elke variant en elk zichtjaar gelijk is. Uit het basisjaar, want in het zichtjaar kan de opgave meegroeien met de stad (#867).";
		parameter<Float64> AanbodOpWbCellen_mln_m3          := ='sum(IsWbCel ? float64('+/Diagnose/Pad_Z+'Piekbuiberging/Aanbod/Totaal) : 0d) / 1e6', Descr = "De regel piekbui_aanbod_op_wbcellen_mln_m3: bergingscellen tellen niet mee in de dekking, dus nul.";
		parameter<Float64> AanbodSluiting_mln_m3            := ='abs(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Aanbod)) + sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/AanbodBuitenUrbanContour)) - sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/Aanbod/Totaal))) / 1e6', Descr = "De regel piekbui_aanbod_sluiting_mln_m3: het aanbod binnen plus buiten bestaand bebouwd gebied hoort het totaal te zijn; een gat wijst op de begrenzing of een null in BBGSamengesteld.";
		parameter<String>  Pad_S                            := /Diagnose/Pad_Z+'Piekbuiberging/Schade/';
		parameter<Float64> SchadeVolumeSluiting_mln_m3      := ='abs(sum(float64('+Pad_S+'Diepte_Met) * float64('+Pad_S+'FractieNat)) * float64(/Geography/AdminDomain/NrMeter2PerCell) - sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Ongedekt))) / 1e6'
		, Descr = "De regel piekbui_schade_volume_sluiting_mln_m3 (#875): de waterschijf die de schade leest moet optellen tot de ongedekte opgave, anders rekent de schade met ander water dan de dekkingsgraad.";
		parameter<Float64> SchadeVermedenFractie            := ='float64('+Pad_S+'Vermeden/PerNL/Totaal) / float64('+Pad_S+'Zonder/PerNL/Totaal)', Descr = "De regel piekbui_schade_vermeden_fractie: welk deel van de schade de maatregelen wegnemen.";
		parameter<Float64> SchadeVermedenMin_eur            := ='min(float64('+Pad_S+'Vermeden/Totaal))', Descr = "De regel piekbui_schade_vermeden_min_eur: meer water hoort nooit minder schade te geven.";
		parameter<String>  AlleZevenGedefinieerd            := AsList('IsDefined('+Pad_A_Aanbod+'Wonen/'+MaatregelTerm/pad+')', ' && ');

		parameter<String>  Dekking                          := = !(/Diagnose/Voorwaarde/DomeinWater && /Diagnose/Voorwaarde/MetWonen && /Diagnose/Voorwaarde/MetWerken) ? quote(/Diagnose/Voorwaarde/Zonder_DomeinWater) : (
		                                                             quote('maat;mln_m3')
		                                                           + ' + ' + quote('|opgave;')                 + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Opgave)) / 1e6)'
		                                                           + ' + ' + quote('|aanbod_totaal;')          + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/Aanbod/Totaal)) / 1e6)'
		                                                           + ' + ' + quote('|aanbod_op_wbcellen;')     + ' + string(sum(IsWbCel ? float64('+/Diagnose/Pad_Z+'Piekbuiberging/Aanbod/Totaal) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|aanbod;')                 + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Aanbod)) / 1e6)'
		                                                           + ' + ' + quote('|aanbod_buiten_bbg;')      + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/AanbodBuitenUrbanContour)) / 1e6)'
		                                                           + ' + ' + quote('|gedekt;')                 + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Gedekt)) / 1e6)'
		                                                           + ' + ' + quote('|aanbod_zonder_opgave;')   + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/AanbodZonderOpgave)) / 1e6)'
		                                                           + ' + ' + quote('|restopgave_onbegrensd;')   + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Restopgave)) / 1e6)'
		                                                           + ' + ' + quote('|restopgave_begrensd;')     + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/PerGrid/Ongedekt)) / 1e6)'
		                                                           + ' + ' + quote('|opgave_70mm_1h;')         + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/TweedeBui/Opgave)) / 1e6)'
		                                                           + ' + ' + quote('|ongedekt_70mm_1h;')       + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/TweedeBui/Ongedekt)) / 1e6)'
		                                                           + ' + ' + quote('|wbcellen_ha;')            + ' + string(sum(float64(IsWbCel) * 0.0625d))'
		                                                           // Het aanbod per maatregel. De vraag erachter is welke maatregelen capaciteit tellen die de bronkaart
		                                                           // van de opgave al veronderstelt: bodeminfiltratie zit erin, en verhard oppervlak in de bebouwde
		                                                           // kom voert er af op het riool. Zonder deze uitsplitsing was de
		                                                           // omvang daarvan nergens af te lezen. Wonen en werken, want verblijfsrecreatie is een schakelbare
		                                                           // sector en een ongeguarde verwijzing breekt zodra hij uit staat; nb_totaal sluit de rekening.
		                                                           + ' + ' + quote('|nb_totaal;')             + ' + string(sum(float64('+Pad_A_Aanbod+'Totaal)) / 1e6)'
		                                                           + ' + ' + quote('|nb_bergingopwater;')     + ' + string(sum(float64('+Pad_A_Aanbod+'Wonen/OpWater/Resultaat)) / 1e6)'
		                                                           + ' + ' + quote('|nb_doorlatendgroen;')    + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpGrasUitgeefbaar/ResultaatDoorlatendGroen)) + sum(float64('+Pad_A_Aanbod+'Wonen/OpGrasOpenbaar/ResultaatDoorlatendGroen)) + sum(float64('+Pad_A_Aanbod+'Wonen/OpOverigGroen/Resultaat))) / 1e6)'
		                                                           + ' + ' + quote('|nb_wadi;')               + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpGrasUitgeefbaar/ResultaatWadi)) + sum(float64('+Pad_A_Aanbod+'Wonen/OpGrasOpenbaar/ResultaatWadi)) + sum(float64('+Pad_A_Aanbod+'Werken/OpGrasUitgeefbaar/Resultaat)) + sum(float64('+Pad_A_Aanbod+'Werken/OpGrasOpenbaar/Resultaat))) / 1e6)'
		                                                           + ' + ' + quote('|nb_halfverharding;')     + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpOverigVerhardUitgeefbaar/Resultaat)) + sum(float64('+Pad_A_Aanbod+'Wonen/OpVerhardOpenbaar/ResultaatHalfverharding)) + sum(float64('+Pad_A_Aanbod+'Werken/OpOverigVerhardUitgeefbaar/Resultaat)) + sum(float64('+Pad_A_Aanbod+'Werken/OpVerhardOpenbaar/ResultaatHalfverharding))) / 1e6)'
		                                                           + ' + ' + quote('|nb_daken;')              + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpDaken/Resultaat)) + sum(float64('+Pad_A_Aanbod+'Werken/OpDaken/Resultaat))) / 1e6)'
		                                                           + ' + ' + quote('|best_totaal;')           + ' + string(sum(float64('+Pad_G_Aanbod+'Totaal)) / 1e6)'
		                                                           + ' + ' + quote('|best_daken;')            + ' + string(sum(float64('+Pad_G_Aanbod+'OpDaken/Resultaat)) / 1e6)'
		                                                           + ' + ' + quote('|best_overig;')           + ' + string(sum(float64('+Pad_G_Aanbod+'OpOverigePlekken/Totaal)) / 1e6)'
		                                                           // Het bestaand-gebiedaanbod per maatregel, landelijk en binnen bestaand bebouwd gebied (#757). best_overig stond hier
		                                                           // als een klomp, dus of de holle weg meetelde en hoeveel hij opbrengt was uit deze uitdraai niet af te lezen. De _bbg-regels
		                                                           // zijn het deel dat de dekkingsgraad haalt, en dat aandeel verschilt sterk per maatregel: daken liggen vrijwel geheel in de
		                                                           // stad, wadi's en halfverharding voor een groot deel erbuiten. DoorlatendGroen en BergingOpWater hebben in bestaand gebied
		                                                           // nog geen velddata en staan daarom niet in deze lijst; zie DoorlatendGroenCapaciteit_AdminDomain in SourceData.
		                                                           + ' + ' + quote('|best_halfverharding;')    + ' + string(sum(MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/Halfverharding), 0d)) / 1e6)'
		                                                           + ' + ' + quote('|best_halfverharding_bbg;') + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/Halfverharding), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|best_wadi;')              + ' + string(sum(MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/Wadi), 0d)) / 1e6)'
		                                                           + ' + ' + quote('|best_wadi_bbg;')          + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/Wadi), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|best_holleweg;')          + ' + string(sum(MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HolleWeg), 0d)) / 1e6)'
		                                                           + ' + ' + quote('|best_holleweg_bbg;')      + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HolleWeg), 0d) : 0d) / 1e6)'
		                                                           // De drie klassegroepen die #757 uit de uitspraken van team Stad heeft afgeleid: wijkweg, woonerf en inrit dragen
		                                                           // hetzelfde kental als de halfverharding hierboven maar een eigen aandeel per variant, en de wijkweg draagt daarnaast
		                                                           // de holle weg. Los uitgedraaid, want anders is niet te zien welke van de drie het verschil maakt.
		                                                           + ' + ' + quote('|best_hv_wijkweg;')        + ' + string(sum(MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HalfverhardingWijkweg), 0d)) / 1e6)'
		                                                           + ' + ' + quote('|best_hv_wijkweg_bbg;')    + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HalfverhardingWijkweg), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|best_hv_woonerf;')        + ' + string(sum(MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HalfverhardingWoonerf), 0d)) / 1e6)'
		                                                           + ' + ' + quote('|best_hv_woonerf_bbg;')    + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HalfverhardingWoonerf), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|best_hv_inrit;')          + ' + string(sum(MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HalfverhardingInrit), 0d)) / 1e6)'
		                                                           + ' + ' + quote('|best_hv_inrit_bbg;')      + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpOverigePlekken/PerWaterrententieK/HalfverhardingInrit), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|best_daken_bbg;')     + ' + string(sum(/BaseData/Omgeving/BebouwdGebied/UrbanContour ? MakeDefined(float64('+Pad_G_Aanbod+'OpDaken/Resultaat), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|nb_holleweg;')        + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpVerhardOpenbaar/ResultaatHolleWeg)) + sum(float64('+Pad_A_Aanbod+'Werken/OpVerhardOpenbaar/ResultaatHolleWeg))) / 1e6)'
		                                                           // Dakvorm (#746): het platte en schuine dakoppervlak in mln m2, bestaand en nieuwbouw (wonen plus werken),
		                                                           // en het dakenaanbod van nieuwe werkpanden apart, want dat kreeg met #746 voor het eerst een blauwe term.
		                                                           + ' + ' + quote('|best_dak_plat_mlnm2;')   + ' + string(sum(float64('+Pad_G_Aanbod+'OpDaken/DakoppervlakPlat)) / 1e6)'
		                                                           + ' + ' + quote('|best_dak_schuin_mlnm2;') + ' + string(sum(float64('+Pad_G_Aanbod+'OpDaken/DakoppervlakSchuin)) / 1e6)'
		                                                           + ' + ' + quote('|nb_dak_plat_mlnm2;')     + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpDaken/DakoppervlakPlat)) + sum(float64('+Pad_A_Aanbod+'Werken/OpDaken/DakoppervlakPlat))) / 1e6)'
		                                                           + ' + ' + quote('|nb_dak_schuin_mlnm2;')   + ' + string((sum(float64('+Pad_A_Aanbod+'Wonen/OpDaken/DakoppervlakSchuin)) + sum(float64('+Pad_A_Aanbod+'Werken/OpDaken/DakoppervlakSchuin))) / 1e6)'
		                                                           + ' + ' + quote('|nb_daken_werken;')       + ' + string(sum(float64('+Pad_A_Aanbod+'Werken/OpDaken/Resultaat)) / 1e6)'
		                                                           // Controle op de nullpropagatie die #741 heeft gerepareerd: wonencellen waar een van de zeven
		                                                           // maatregeltermen geen waarde heeft. Sinds die reparatie kost dat alleen die ene term; daarvoor
		                                                           // kostte het de hele cel. Loopt dit getal op, dan is er bovenstrooms iets veranderd aan de
		                                                           // ontwikkelpakketten of aan het toepassingsgebied van doorlatend groen.
		                                                           // De nieuwe stad buiten bestaand bebouwd gebied (#867): hoeveel hectare, welke opgave de dieptekaart daar geeft en hoeveel aanbod er ligt.
		                                                           + ' + ' + quote('|nieuw_buiten_bbg_ha;')       + ' + string(sum('+/Diagnose/Pad_Z+'Piekbuiberging/IsNieuwBuitenBestaand ? 0.0625d : 0d))'
		                                                           + ' + ' + quote('|nieuw_buiten_bbg_opgave;')   + ' + string(sum('+/Diagnose/Pad_Z+'Piekbuiberging/IsNieuwBuitenBestaand ? MakeDefined(float64(/SourceData/Water/WaterdiepteBijHevigeNeerslag_155mm_2h), 0d) * 625d : 0d) / 1e6)'
		                                                           + ' + ' + quote('|nieuw_buiten_bbg_opgave_70mm_1h;') + ' + string(sum('+/Diagnose/Pad_Z+'Piekbuiberging/IsNieuwBuitenBestaand ? MakeDefined(float64(/SourceData/Water/WaterdiepteBijHevigeNeerslag_70mm_1h), 0d) * 625d : 0d) / 1e6)'
		                                                           + ' + ' + quote('|nieuw_buiten_bbg_aanbod;')   + ' + string(sum('+/Diagnose/Pad_Z+'Piekbuiberging/IsNieuwBuitenBestaand ? MakeDefined(float64('+/Diagnose/Pad_Z+'Piekbuiberging/Aanbod/Totaal), 0d) : 0d) / 1e6)'
		                                                           + ' + ' + quote('|nieuw_binnen_bbg_aanbod;')   + ' + string(sum(/BaseData/Omgeving/UrbanContour ? MakeDefined(float64('+Pad_A_Aanbod+'Totaal), 0d) : 0d) / 1e6)'
		                                                           // Het gebied waarop de opgave telt, om de opgave als gemiddelde waterschijf in mm te lezen naast de normen van #435.
		                                                           + ' + ' + quote('|gebied_met_opgave_ha;')      + ' + string(sum(float64('+/Diagnose/Pad_Z+'Piekbuiberging/GebiedMetOpgave) * float64(/Geography/AdminDomain/NrHaPerCell)))'
		                                                           + ' + ' + quote('|nb_cellen_termnull;')    + ' + string(sum(uint32('+Pad_A_Aanbod+'Wonen/AllocatieHeeftPlaatsgevonden && !('+AlleZevenGedefinieerd+'))))'
		                                                       )
		, StorageName = "='%LocalDataProjDir%/Diagnose/piekbuiberging_'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'.txt'"
		, StorageType = "str"
		, Descr = "Waar de dekkingsgraad van de piekbuiberging vandaan komt, uitgesplitst naar de mechanismen die er samen in zitten (#720, #741). opgave_70mm_1h en ongedekt_70mm_1h zijn de balans van de tweede bui. opgave is de landelijke piekbuiopgave: de waterschijf bij
					hevige neerslag maal het celoppervlak, gemaskeerd op bestaand bebouwd gebied; aanbod_totaal is wat de indicator aan bergingscapaciteit telt; gedekt gedeeld door opgave is de dekkingsgraad
					die naar buiten gaat. aanbod_op_wbcellen toetst of de door de sector Waterberging gealloceerde cellen meetellen: een waterbergingscel valt in geen van de takken van Aanbod, dus dit getal
					hoort nul te zijn. aanbod is de som die de dekkingsgraad gebruikt, gemaskeerd op bestaand bebouwd gebied net als de opgave; aanbod_buiten_bbg is wat door die maskering afvalt, en
					aanbod_totaal is de twee bij elkaar; die drie horen op te tellen, en wijken ze af, dan is er iets met de begrenzing. restopgave_onbegrensd tegen restopgave_begrensd meet wat de begrenzing op
					blokken kost: het verschil is aanbodoverschot in blokken met minder opgave dan aanbod, dat niet naar een ander blok kan, en staat ook rechtstreeks als aanbod_zonder_opgave uit
					PerGrid/AanbodZonderOpgave.";
		parameter<String>  Pad_W                            := /Diagnose/Pad_Z+'Piekbuiberging/Weguitval/';
		parameter<Float64> WeguitvalKmVerschil              := ='float64('+Pad_W+'Met/PerNL/Lengte) - float64('+Pad_W+'Zonder/PerNL/Lengte)', Descr = "De regel piekbui_weguitval_km_verschil: de uitgevallen lengte met maatregelen min die zonder.";
		parameter<Float64> WegennetHoofdnetFractie          := float64(#/BaseData/Wegennet/KnoopHoofdnet) / float64(#/BaseData/Wegennet/Knoop), Descr = "De regel piekbui_wegennet_hoofdnet_fractie: het hoofdnet hoort vrijwel alle knopen te dragen; een lage waarde wijst op een fout in de koppeling van de wegvakken.";
		parameter<Float64> WegennetZiekenhuizen             := float64(#/BaseData/Wegennet/Ziekenhuis), Descr = "De regel piekbui_wegennet_ziekenhuizen: het aantal ziekenhuiscomplexen in de TOP10NL.";
		parameter<String>  Wegennet                         := 'wegvakken;'+string(#/BaseData/Wegennet/Wegvak)+'|km;'+string(sum(float64(/BaseData/Wegennet/Wegvak/Lengte)) / 1000d)+'|knopen;'+string(#/BaseData/Wegennet/Knoop)+'|delen;'+string(#/BaseData/Wegennet/Delen)+'|knopen_hoofdnet;'+string(#/BaseData/Wegennet/KnoopHoofdnet)+'|ziekenhuizen;'+string(#/BaseData/Wegennet/Ziekenhuis)+'|meetpunten;'+string(#/BaseData/Wegennet/Meetpunt)+'|reistijd_gemiddeld_min;'+string(mean(/BaseData/Wegennet/ReistijdZiekenhuis))+'|reistijd_max_min;'+string(max(/BaseData/Wegennet/ReistijdZiekenhuis))+'|km_per_wegklasse;'+AsList(string(sum(float64(/BaseData/Wegennet/Wegvak/Lengte), /BaseData/Wegennet/Wegvak/WegK_rel) / 1000d), ',')
		, StorageName = "%LocalDataProjDir%/Diagnose/piekbui_wegennet.txt"
		, StorageType = "str"
		, Descr = "De omvang van het wegennet van de weguitval (#873): hoeveel wegvakken, knopen en meetpunten, hoeveel knopen op het hoofdnet en hoeveel ziekenhuizen. Hangt niet van de casus af.";
		parameter<String>  Weguitval                        := = !(/Diagnose/Voorwaarde/DomeinWater && /Diagnose/Voorwaarde/MetWonen && /Diagnose/Voorwaarde/MetWerken) ? quote(/Diagnose/Voorwaarde/Zonder_DomeinWater) : (
		                                                             quote('maat;waarde')
		                                                           + ' + ' + quote('|zonder_lengte;') + ' + string('+Pad_W+'Zonder/PerNL/Lengte)'
		                                                           + ' + ' + quote('|zonder_woningengeisoleerd;') + ' + string('+Pad_W+'Zonder/PerNL/WoningenGeisoleerd)'
		                                                           + ' + ' + quote('|zonder_banengeisoleerd;') + ' + string('+Pad_W+'Zonder/PerNL/BanenGeisoleerd)'
		                                                           + ' + ' + quote('|zonder_woningenbovennorm;') + ' + string('+Pad_W+'Zonder/PerNL/WoningenBovenNorm)'
		                                                           + ' + ' + quote('|zonder_extrareistijd_min;') + ' + string('+Pad_W+'Zonder/PerNL/ExtraReistijd_min)'
		                                                           + ' + ' + quote('|met_lengte;') + ' + string('+Pad_W+'Met/PerNL/Lengte)'
		                                                           + ' + ' + quote('|met_woningengeisoleerd;') + ' + string('+Pad_W+'Met/PerNL/WoningenGeisoleerd)'
		                                                           + ' + ' + quote('|met_banengeisoleerd;') + ' + string('+Pad_W+'Met/PerNL/BanenGeisoleerd)'
		                                                           + ' + ' + quote('|met_woningenbovennorm;') + ' + string('+Pad_W+'Met/PerNL/WoningenBovenNorm)'
		                                                           + ' + ' + quote('|met_extrareistijd_min;') + ' + string('+Pad_W+'Met/PerNL/ExtraReistijd_min)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_lengte;') + ' + string('+Pad_W+'Zonder_70mm_1h/PerNL/Lengte)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_woningengeisoleerd;') + ' + string('+Pad_W+'Zonder_70mm_1h/PerNL/WoningenGeisoleerd)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_banengeisoleerd;') + ' + string('+Pad_W+'Zonder_70mm_1h/PerNL/BanenGeisoleerd)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_woningenbovennorm;') + ' + string('+Pad_W+'Zonder_70mm_1h/PerNL/WoningenBovenNorm)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_extrareistijd_min;') + ' + string('+Pad_W+'Zonder_70mm_1h/PerNL/ExtraReistijd_min)'
		                                                           + ' + ' + quote('|met_70mm_1h_lengte;') + ' + string('+Pad_W+'Met_70mm_1h/PerNL/Lengte)'
		                                                           + ' + ' + quote('|met_70mm_1h_woningengeisoleerd;') + ' + string('+Pad_W+'Met_70mm_1h/PerNL/WoningenGeisoleerd)'
		                                                           + ' + ' + quote('|met_70mm_1h_banengeisoleerd;') + ' + string('+Pad_W+'Met_70mm_1h/PerNL/BanenGeisoleerd)'
		                                                           + ' + ' + quote('|met_70mm_1h_woningenbovennorm;') + ' + string('+Pad_W+'Met_70mm_1h/PerNL/WoningenBovenNorm)'
		                                                           + ' + ' + quote('|met_70mm_1h_extrareistijd_min;') + ' + string('+Pad_W+'Met_70mm_1h/PerNL/ExtraReistijd_min)'
		                                                           + ' + ' + quote('|zonder_km_per_wegklasse;') + ' + AsList(string('+Pad_W+'Zonder/LengtePerWegK), ' + quote(',') + ')'
		                                                           + ' + ' + quote('|met_km_per_wegklasse;') + ' + AsList(string('+Pad_W+'Met/LengtePerWegK), ' + quote(',') + ')'
		                                                           + ' + ' + quote('|zonder_70mm_1h_km_per_wegklasse;') + ' + AsList(string('+Pad_W+'Zonder_70mm_1h/LengtePerWegK), ' + quote(',') + ')'
		                                                           + ' + ' + quote('|met_70mm_1h_km_per_wegklasse;') + ' + AsList(string('+Pad_W+'Met_70mm_1h/LengtePerWegK), ' + quote(',') + ')'
		                                                       )
		, StorageName = "='%LocalDataProjDir%/Diagnose/piekbuiweguitval_'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'.txt'"
		, StorageType = "str"
		, Descr = "De weguitval door de piekbui per bui en situatie, landelijk (#873): km uitgevallen, woningen en banen van het hoofdnet afgeraakt, woningen die boven de reistijdnorm naar een ziekenhuis komen, en de gemiddelde extra reistijd in minuten per woning.";
		parameter<String>  Schade                           := = !(/Diagnose/Voorwaarde/DomeinWater && /Diagnose/Voorwaarde/MetWonen && /Diagnose/Voorwaarde/MetWerken) ? quote(/Diagnose/Voorwaarde/Zonder_DomeinWater) : (
		                                                             quote('maat;mln_eur')
		                                                           + ' + ' + quote('|zonder_totaal;') + ' + string(float64('+Pad_S+'Zonder/PerNL/Totaal) / 1e6)'
		                                                           + ' + ' + quote('|zonder_wonen;') + ' + string(float64('+Pad_S+'Zonder/PerNL/Wonen) / 1e6)'
		                                                           + ' + ' + quote('|zonder_bedrijven;') + ' + string(float64('+Pad_S+'Zonder/PerNL/Bedrijven) / 1e6)'
		                                                           + ' + ' + quote('|zonder_overig;') + ' + string(float64('+Pad_S+'Zonder/PerNL/Overig) / 1e6)'
		                                                           + ' + ' + quote('|met_totaal;') + ' + string(float64('+Pad_S+'Met/PerNL/Totaal) / 1e6)'
		                                                           + ' + ' + quote('|met_wonen;') + ' + string(float64('+Pad_S+'Met/PerNL/Wonen) / 1e6)'
		                                                           + ' + ' + quote('|met_bedrijven;') + ' + string(float64('+Pad_S+'Met/PerNL/Bedrijven) / 1e6)'
		                                                           + ' + ' + quote('|met_overig;') + ' + string(float64('+Pad_S+'Met/PerNL/Overig) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_totaal;') + ' + string(float64('+Pad_S+'Vermeden/PerNL/Totaal) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_wonen;') + ' + string(float64('+Pad_S+'Vermeden/PerNL/Wonen) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_bedrijven;') + ' + string(float64('+Pad_S+'Vermeden/PerNL/Bedrijven) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_overig;') + ' + string(float64('+Pad_S+'Vermeden/PerNL/Overig) / 1e6)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_totaal;') + ' + string(float64('+Pad_S+'Zonder_70mm_1h/PerNL/Totaal) / 1e6)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_wonen;') + ' + string(float64('+Pad_S+'Zonder_70mm_1h/PerNL/Wonen) / 1e6)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_bedrijven;') + ' + string(float64('+Pad_S+'Zonder_70mm_1h/PerNL/Bedrijven) / 1e6)'
		                                                           + ' + ' + quote('|zonder_70mm_1h_overig;') + ' + string(float64('+Pad_S+'Zonder_70mm_1h/PerNL/Overig) / 1e6)'
		                                                           + ' + ' + quote('|met_70mm_1h_totaal;') + ' + string(float64('+Pad_S+'Met_70mm_1h/PerNL/Totaal) / 1e6)'
		                                                           + ' + ' + quote('|met_70mm_1h_wonen;') + ' + string(float64('+Pad_S+'Met_70mm_1h/PerNL/Wonen) / 1e6)'
		                                                           + ' + ' + quote('|met_70mm_1h_bedrijven;') + ' + string(float64('+Pad_S+'Met_70mm_1h/PerNL/Bedrijven) / 1e6)'
		                                                           + ' + ' + quote('|met_70mm_1h_overig;') + ' + string(float64('+Pad_S+'Met_70mm_1h/PerNL/Overig) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_70mm_1h_totaal;') + ' + string(float64('+Pad_S+'Vermeden_70mm_1h/PerNL/Totaal) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_70mm_1h_wonen;') + ' + string(float64('+Pad_S+'Vermeden_70mm_1h/PerNL/Wonen) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_70mm_1h_bedrijven;') + ' + string(float64('+Pad_S+'Vermeden_70mm_1h/PerNL/Bedrijven) / 1e6)'
		                                                           + ' + ' + quote('|vermeden_70mm_1h_overig;') + ' + string(float64('+Pad_S+'Vermeden_70mm_1h/PerNL/Overig) / 1e6)'
		                                                       )
		, StorageName = "='%LocalDataProjDir%/Diagnose/piekbuischade_'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'.txt'"
		, StorageType = "str"
		, Descr = "De schade door de piekbui per bui, situatie en groep, landelijk in miljoen euro (#875). De regels met 70mm_1h zijn de bui van 70 mm in 1 uur, de andere de bui van ModelParameters/Piekbuiberging/Bui_ref.";
	}

	container Groen
	: Descr = "Groen in de indicatoren: de twee telwijzen van de bereikbaarheid van groen naast elkaar (KlasseTegenFractie en TweeTelwijzen, #696 en #717, op aanvraag; de keuze ligt bij Deltares)
				en de toets of de groenwaarde van nieuwbouw een verandering meet (Groenwaarde, waarvan LekBedrag_eur in Checks)."
	{
		attribute<Bool>   NieuweNatuur696 (/Geography/AdminDomain) := =/Diagnose/Pad_Z+'Grondgebruik/Verandering/NieuweNatuur';
		parameter<String> PadK696                                  := /Diagnose/Pad_Z+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/';

		parameter<String> KlasseTegenFractie                       := =(
		                                                                    quote('maat;waarde')
		                                                                  + ' + ' + quote('|nieuwenatuur_ha;')          + ' + string(sum(float64(NieuweNatuur696) * 0.0625d))'
		                                                                  + ' + ' + quote('|klasse_ha_op_nieuwenatuur;')+ ' + string(sum(NieuweNatuur696 ? float64('+PadK696+'TotaalExAgrarisch/RelevantGroen) : 0d) / 10000d)'
		                                                                  + ' + ' + quote('|fractie_ha_op_nieuwenatuur;')+' + string(sum(NieuweNatuur696 ? float64('+PadK696+'Fractie/RelevantGroen) : 0d) / 10000d)'
		                                                                  + ' + ' + quote('|klasse_cellen_groen_daar;') + ' + string(sum(uint32(NieuweNatuur696 && float32('+PadK696+'TotaalExAgrarisch/RelevantGroen) > 0f)))'
		                                                                  + ' + ' + quote('|fractie_cellen_groen_daar;')+ ' + string(sum(uint32(NieuweNatuur696 && float32('+PadK696+'Fractie/RelevantGroen) > 0f)))'
		                                                              )
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_groen_klasse_tegen_fractie.txt'"
		, StorageType = "str"
		, Descr = "De directe toets op #696: ziet de bereikbaarheidsindicator de nieuwe natuur van dit zichtjaar? De klassebenadering registreert nieuwe natuur niet als groen, want gealloceerde natuur draagt
					een subsector en valt daardoor uit GroenInZichtjaar, en exogeen opgelegde natuur houdt haar basisjaarklasse, op omgezette landbouwgrond precies de klasse die TotaalExAgrarisch uitsluit. Deze
					uitdraai legt beide benaderingen naast elkaar op uitsluitend de cellen waar dit zichtjaar nieuwe natuur is ontstaan: telt de klassekolom daar nul of bijna nul hectare terwijl de fractiekolom
					het volledige areaal geeft, dan is #696 bevestigd voor de klassebenadering en opgelost door de fractiebenadering, die het landgebruik van het zichtjaar leest via LU_Mutatie.";

		parameter<String> Pad717                                   := /Diagnose/Pad_Z+'BereikbaarheidGroen/obv_BBG/PerRegios/Nationaal/Afstanden/Tot300m/AggrGroenKlassen/';

		parameter<String> TweeTelwijzen                            := =(
		                                                                    quote('maat;klasse;fractie')
		                                                                  + ' + ' + quote('|groen_per_woning_m2;')  + ' + string(sum(float64('+Pad717+'TotaalExAgrarisch/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated)))'
		                                                                  + ' + ' + quote(';')                      + ' + string(sum(float64('+Pad717+'Fractie/Indicatoren/Drukte_gecorrigeerd_groenaanbod_per_woning/Indicator_Aggregated)))'
		                                                                  + ' + ' + quote('|groenaanbod_m2;')       + ' + string(sum(float64('+Pad717+'TotaalExAgrarisch/Indicatoren/Groenaanbod/Indicator_Aggregated)))'
		                                                                  + ' + ' + quote(';')                      + ' + string(sum(float64('+Pad717+'Fractie/Indicatoren/Groenaanbod/Indicator_Aggregated)))'
		                                                                  + ' + ' + quote('|relevantgroen_ha;')     + ' + string(sum(float64('+Pad717+'TotaalExAgrarisch/RelevantGroen)) / 10000d)'
		                                                                  + ' + ' + quote(';')                      + ' + string(sum(float64('+Pad717+'Fractie/RelevantGroen)) / 10000d)'
		                                                              )
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_groen_twee_telwijzen.txt'"
		, StorageType = "str"
		, Descr = "De twee manieren waarop groen wordt geteld, naast elkaar op hetzelfde zichtjaar en dezelfde straal van 300 meter, de vergelijking waar #717 om vraagt. De klassekolom telt een cel helemaal
					mee of helemaal niet en houdt de eisen van vijf woningen per hectare en een hectare aaneengesloten; de fractiekolom telt het groene deel van elke cel en laat die eisen vallen, en alleen
					daarin is het groen binnen een ontwikkelpakket zichtbaar. relevantgroen_ha is de bron van het verschil: hoeveel hectare er in beide benaderingen als groen de potentiaal in gaat; loopt dat in
					de klassekolom terug terwijl het in de fractiekolom stijgt, dan is dat het artefact dat de indicator het NbS-verhaal liet tegenspreken.";

		container Groenwaarde
		: Descr = "Of de groenwaarde van nieuwbouw werkelijk een verandering meet en geen niveau (#678). LekBedrag_eur is de toets, de regel groenwaarde_lek_eur in Checks: de waardeverandering op
					cellen met nieuwbouw waar het groen niet veranderd is. Een handvol cellen met samen een paar euro is afrondingsruis in dGroenTerm, terwijl een niveau de volle premie zou geven op
					elke cel met onveranderd groen. LekNiveau telt die cellen, en Tabel (op aanvraag) zet de bedragen erbij."
		{
			parameter<String>  P             := /Diagnose/Pad_Z+'WaardeNabijheidGroen/Nieuwbouw/';
			parameter<UInt32>  LekNiveau     := =('sum(uint32(float32('+P+'n_nieuwbouw_cumulatief) > 0f && abs('+P+'dGroenTerm) < 0.000001f && abs(float32('+P+'dWaarde)) >= 0.01f))');
			parameter<Float64> LekBedrag_eur := =('sum(float64(float32('+P+'n_nieuwbouw_cumulatief) > 0f && abs('+P+'dGroenTerm) < 0.000001f ? abs(float32('+P+'dWaarde)) : 0f))');

			parameter<String>  Tabel         := =(
			                                          quote('maat;waarde')
			                                        + ' + ' + quote('|nieuwbouw_mld;')            + ' + string(sum(float64(MakeDefined(float32('+P+'dWaarde), 0f))) / 1e9)'
			                                        + ' + ' + quote('|bestaand_mld;')             + ' + string(sum(float64(MakeDefined(float32('+/Diagnose/Pad_Z+'WaardeNabijheidGroen/Bestaand/dWaarde), 0f))) / 1e9)'
			                                        + ' + ' + quote('|cellen_nieuwbouw;')         + ' + string(sum(uint32(float32('+P+'n_nieuwbouw_cumulatief) > 0f)))'
			                                        + ' + ' + quote('|cellen_groen_onveranderd;') + ' + string(sum(uint32(float32('+P+'n_nieuwbouw_cumulatief) > 0f && abs('+P+'dGroenTerm) < 0.000001f)))'
			                                        + ' + ' + quote('|lek_niveau_ipv_verandering;')+ ' + string(LekNiveau)'
			                                        + ' + ' + quote('|lek_bedrag_eur;')           + ' + string(LekBedrag_eur)'
			                                    )
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_groenwaarde_lek.txt'"
			, StorageType = "str"
			, Descr = "De bedragen en de celtelling naast de toets.";
		}
	}

	container Verharding
	: Descr = "Of de verharding werkelijk kan dalen (#697), en hoeveel. Cellen_Gedaald is de regel verharding_cellen_gedaald in Checks en hoort groter dan nul te zijn; is hij nul, dan is de daling niet
				aangesloten. Tabel (op aanvraag) zet daling en stijging naast elkaar; 0,0625 is het aantal hectare per cel van 25 meter, Result en Basisjaarverharding zijn fracties."
	{
		parameter<String> P              := /Diagnose/Pad_Z+'Verharding/';
		parameter<UInt32> Cellen_Gedaald := =('sum(uint32('+P+'Result < '+P+'Basisjaarverharding - 0.001f))');

		parameter<String> Tabel          := =(
		                                          quote('maat;waarde')
		                                        + ' + ' + quote('|cellen_beide_bekend;') + ' + string(sum(uint32(IsDefined('+P+'Result) && IsDefined('+P+'Basisjaarverharding))))'
		                                        + ' + ' + quote('|cellen_gedaald;')      + ' + string(Cellen_Gedaald)'
		                                        + ' + ' + quote('|cellen_gestegen;')     + ' + string(sum(uint32('+P+'Result > '+P+'Basisjaarverharding + 0.001f)))'
		                                        + ' + ' + quote('|daling_ha;')           + ' + string(sum(float64(max_elem('+P+'Basisjaarverharding - '+P+'Result, 0f)) * 0.0625d))'
		                                        + ' + ' + quote('|stijging_ha;')         + ' + string(sum(float64(max_elem('+P+'Result - '+P+'Basisjaarverharding, 0f)) * 0.0625d))'
		                                        + ' + ' + quote('|verhard_basisjaar_ha;')+ ' + string(sum(float64(IsDefined('+P+'Result) && IsDefined('+P+'Basisjaarverharding) ? '+P+'Basisjaarverharding : 0f) * 0.0625d))'
		                                        + ' + ' + quote('|verhard_zichtjaar_ha;')+ ' + string(sum(float64(IsDefined('+P+'Result) && IsDefined('+P+'Basisjaarverharding) ? '+P+'Result : 0f) * 0.0625d))'
		                                    )
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verharding_verandering.txt'"
		, StorageType = "str"
		, Descr = "De richting en de omvang van de verandering naast de toets in Cellen_Gedaald.";
	}

	container Wonen
	{
		parameter<String>  PadB                  := '/Indicatoren/'+/Diagnose/Casus+'/Basisjaar/Stand/';
		parameter<Float32> IJburg2_WoningenGroei := =('sum(/SourceData/RegioIndelingen/LMSSubzone/IsIJburg2_AdminDomain ? MakeDefined(float32('+/Diagnose/Pad_Z+'Stand/Aantal_Woningen_Totaal), 0f) - MakeDefined(float32('+PadB+'Aantal_Woningen_Totaal), 0f) : 0f)'), Descr = "Woningen erbij op IJburg2 sinds het basisjaar, de regel ijburg2_woningen_groei in Checks. Nieuw land zonder brondata, waar het exploitatiesaldo een proxy op de mediaan van IJburg1 is;
					nul of negatief betekent dat er niets is gebouwd, precies het geval dat de tie-break in Suitability_Wonen_perOP_T moest afvangen.";

		container WoningtypeEengezins
		: Descr = "Het aandeel per woningtype in de eengezinsnieuwbouw van het model in de periode tot dit zichtjaar, naast het gebouwde aandeel waar het quotum naar stuurt, per regio van de eerste
					allocatieregio van wonen (#847). Afwijking is de regel woningtype_eengezins_afwijking in Checks; PerRegio schrijft de tabel en staat in GenerateAll. Het model telt zonder BAG-nieuwbouw,
					zoals SloopNieuwbouwPerWoningtype."
		{
			unit<UInt32>       Regio                   := /BaseData/StartState/WoningtypeEengezins/RegioUnit;
			unit<UInt8>        Groep                   := /ModelParameters/Wonen/WoningtypeEengezins/Groep;
			parameter<String>  A                       := '/BaseData/StartState/WoningtypeEengezins/Aandeel/';

			container          Model                   :=
				for_each_nedv(
					Groep/name
					, 'sum(value('+/Diagnose/Pad_Z+'SloopNieuwbouwPerWoningtype/Nieuwbouw/'+Groep/WP4_name+', float32), Regio/Per_AdminDomain)'
					, Regio
					, Float32
				), Descr = "De eengezinsnieuwbouw van het model per groep en regio, zonder de vervanging van de bestaande voorraad (#859), die het quotum niet stuurt.";
			attribute<Float32> ModelTotaal     (Regio) := ='add('+AsItemList('Model/'+Groep/name)+')';

			attribute<Float32> Afwijking_Regio (Regio) := ='0.5f * ('+AsList('abs(Model/'+Groep/name+' / ModelTotaal - '+A+Groep/name+')', ' + ')+')', Descr = "Per regio de helft van de som van de absolute verschillen tussen het aandeel in de modelnieuwbouw en het gebouwde aandeel: nul bij dezelfde verdeling, een als ze niets gemeen hebben.";
			parameter<Float32> Afwijking               := sum(MakeDefined(Afwijking_Regio, 0f) * ModelTotaal) / sum(ModelTotaal), Descr = "Het met de modelnieuwbouw gewogen gemiddelde van Afwijking_Regio, zodat een regio die alles rij bouwt niet wegvalt tegen een die te veel vrijstaand bouwt.";

			attribute<Float32> ModelNL         (Groep) := ='union_data(Groep, '+AsItemList('sum(Model/'+Groep/name+') / sum(ModelTotaal)')+')', Descr = "Het landelijke aandeel per groep in de eengezinsnieuwbouw van het model.";

			attribute<String>  Regel           (Regio) := ='Regio/name + '+quote(';')+' + string('+A+'AantalGebouwd) + '+quote(';')+' + string(ModelTotaal)'
			                                              + AsList(' + '+quote(';')+' + string('+A+Groep/name+')', '')
			                                              + AsList(' + '+quote(';')+' + string(MakeDefined(Model/'+Groep/name+' / ModelTotaal, 0f))', '');
			parameter<String>  Tabel                   := 'regio;gebouwd_eengezins;model_eengezins' + AsList(';gebouwd_'+Groep/name, '') + AsList(';model_'+Groep/name, '') + '|' + AsList(Regel, '|')
			                                              + '|NL;' + string(sum(/BaseData/StartState/WoningtypeEengezins/AantalNL)) + ';' + string(sum(ModelTotaal))
			                                              + AsList(';' + string(/BaseData/StartState/WoningtypeEengezins/AandeelNL), '')
			                                              + AsList(';' + string(ModelNL), '');
			parameter<String>  PerRegio                := = !/Diagnose/Voorwaarde/MetWonen ? quote(/Diagnose/Voorwaarde/Zonder_Wonen) : 'Tabel'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_woningtype_eengezins.txt'", StorageType = "str"
			, Descr = "Per regio het aantal gebouwde eengezinswoningen in de basisperiode, de eengezinsnieuwbouw van het model, het gebouwde aandeel per groep en het aandeel in het model; de laatste regel is landelijk, met het werkelijk gebouwde landelijke aandeel.";
		}

		container UitstelNetcongestie
		: Descr = "Per regio van de eerste allocatieregio van wonen de vraag, het deel daarvan dat tot het zichtjaar gebouwd kan worden en de woningen die op de uitbreiding van het net wachten (#448, #392). Op aanvraag; leest alleen de claims, dus kost geen allocatie."
		{
			unit<UInt32>       Regio               := ='/SourceData/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_path;
			parameter<String>  C                   := /Diagnose/Pad_V+'Claims/'+first(/Classifications/Modellering/ScenarioK/name)+'/Zichtjaren/'+/Diagnose/Jaar+'/AllocRegios/'+/ModelParameters/SectorAllocRegio/WonenEersteAllocRegio_name+'/';
			attribute<Float32> Vraag       (Regio) := =C+'Wonen/Totaal[float32]';
			attribute<Float32> Bouwbaar    (Regio) := =C+'Wonen_Bouwbaar/Totaal[float32]';
			attribute<Float32> Uitsteldeel (Regio) := =C+'Wonen_Bouwbaar/Uitsteldeel';
			attribute<Float32> Basisjaar   (Regio) := =C+'Wonen/Read_Wonen_WP2xVSSH/eengezins_Proxy[float32] + '+C+'Wonen/Read_Wonen_WP2xVSSH/meergezins_Proxy[float32]';
			attribute<String>  Regel       (Regio) := Regio/name + ';' + string(Basisjaar) + ';' + string(Vraag) + ';' + string(Bouwbaar) + ';' + string(Vraag - Bouwbaar) + ';' + string(Uitsteldeel);
			parameter<String>  PerRegio            := = !/Diagnose/Voorwaarde/MetWonen ? quote(/Diagnose/Voorwaarde/Zonder_Wonen) : quote('regio;voorraad_basisjaar;vraag;bouwbaar;uitgesteld;uitsteldeel|')+' + AsList(Regel, '+quote('|')+')'
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_uitstel_netcongestie.txt'", StorageType = "str"
			, Descr = "Per regio de woningvoorraad van het basisjaar, de vraag, het bouwbare deel, het verschil en het uitsteldeel van de groei.";
		}

		container OmzettingEengezins
		: Descr = "Per allocatieregio van wonen en per regio daarvan de groei sinds het basisjaar per woningtype, de dichtheid en het aandeel meergezins van de nieuwbouw in de basisperiode, de grond die de
					groei vraagt tegen de grond die door de zeef en de vormtoets komt, en hoeveel eengezinswoningen naar meergezins gaan (#879). Op aanvraag; leest de claims en de zeef, dus kost geen allocatie."
		{
			unit<UInt8> Indeling    := /BaseData/StartState/EengezinsOmzetting/Indeling;

			Template PerIndeling_T
			{
				parameter<String>  Indeling_name;
				// end case parameters

				parameter<String>  C             := /Diagnose/Pad_V+'Claims/'+first(/Classifications/Modellering/ScenarioK/name)+'/Zichtjaren/'+/Diagnose/Jaar+'/EengezinsOmzetting/PerIndeling/'+Indeling_name+'/';
				parameter<String>  S             := ' + '+quote(';')+' + string(';
				unit<UInt32>       Regio         := =C+'Regio';
				attribute<String>  Regel (Regio) := ='Regio/name'+S+C+'Groei_eengezins)'+S+C+'Groei_meergezins)'+S+C+'Nieuwbouw/DichtheidEengezins)'+S+C+'Nieuwbouw/DichtheidMeergezins)'
				                                    +S+C+'Grondvraag)'+S+C+'Grond)'+S+C+'Nieuwbouw/AandeelMeergezins)'+S+C+'AandeelMax)'+S+C+'NodigOmTePassen)'+S+C+'RuimteTotGrens)'+S+C+'Omzetting)'
				                                    +S+C+'NaStart_eengezins)'+S+C+'NaStart_meergezins)';
				parameter<String>  PerRegio      := = !/Diagnose/Voorwaarde/MetWonen ? quote(/Diagnose/Voorwaarde/Zonder_Wonen) : quote('regio;groei_eengezins;groei_meergezins;dichtheid_eengezins;dichtheid_meergezins;grondvraag_ha;grond_ha;aandeel_meergezins_nieuwbouw;aandeel_meergezins_max;nodig_om_te_passen;ruimte_tot_grens;omzetting;na_start_eengezins;na_start_meergezins|')+' + AsList(Regel, '+quote('|')+')'
				, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_omzetting_eengezins_'+Indeling_name+'.txt'", StorageType = "str"
				, Descr = "Per regio de kolommen uit Claims/Zichtjaren/<jaar>/EengezinsOmzetting/PerIndeling/<indeling>: groei per woningtype, dichtheden in woningen per hectare, grondvraag en grond in hectare, het aandeel meergezins in de nieuwbouw en de grens, wat nodig is om te passen, de ruimte tot de grens en de omzetting.";
			}
			container   PerIndeling := for_each_ne(Indeling/name, 'PerIndeling_T('+quote(Indeling/name)+')');
		}

		container NieuwbouwVerVanKern
		: Descr = "Welk deel van de woningen die er in de periode tot dit zichtjaar bij kwamen verder dan Afstand_m van een BRT-woonkern ligt, de regel nieuwbouw_ver_van_kern in Checks (#862). Per cel telt de
					toename tegen de stand van het vorige zichtjaar, in het eerste zichtjaar tegen het basisjaar, zodat een zichtjaar waarin de uitbreiding losraakt van de kernen niet wegvalt tegen de periodes
					ervoor. De afstand staat op het raster van AllocDomain, dus op een cel van honderd meter nauwkeurig."
		{
			parameter<UInt32>  Afstand_m                             := 1000, Descr = "Vanaf welke afstand van een woonkern een nieuwe woning als ver telt; moet een straal uit Geography/Matrix zijn. Op een kilometer ligt de BAG-nieuwbouw vrijwel nergens.";
			parameter<Bool>    IsEersteZichtjaar                     := rjoin(/Diagnose/Jaar, /Classifications/Time/Zichtjaar/name, /Classifications/Time/Zichtjaar/IsFirstZichtjaar);
			parameter<String>  PadVorig                              := IsEersteZichtjaar ? '/Indicatoren/'+/Diagnose/Casus+'/Basisjaar/Stand/' : '/Indicatoren/'+/Diagnose/Casus+'/Zichtjaren/'+rjoin(/Diagnose/Jaar, /Classifications/Time/Zichtjaar/name, /Classifications/Time/Zichtjaar/PrevName)+'/Stand/', Descr = "De stand waartegen de toename telt.";
			attribute<Float32> Erbij        (/Geography/AdminDomain) := ='max_elem(MakeDefined(float32('+/Diagnose/Pad_Z+'Stand/Aantal_Woningen_Totaal), 0f) - MakeDefined(float32('+PadVorig+'Aantal_Woningen_Totaal), 0f), 0f)', Descr = "De toename van het aantal woningen per cel in de periode; alleen de toename, zodat sloop elders het aandeel niet verschuift.";
			attribute<Bool>    IsKern       (/Geography/AllocDomain) := sum(uint32(/BaseData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain), /Geography/AdminDomain/AllocDomain_rel) > 0;
			attribute<Bool>    IsBijKern    (/Geography/AllocDomain) := ='potential(float32(IsKern), /Geography/Distmatrices_'+/Geography/AllocDomain_ref_short+'/pot'+string(Afstand_m)+'m/Flat2) > 0f';
			attribute<Bool>    IsVerVanKern (/Geography/AdminDomain) := !IsBijKern[/Geography/AdminDomain/AllocDomain_rel];
			parameter<Float32> Aandeel                               := sum(Erbij * float32(IsVerVanKern)) / sum(Erbij), Descr = "Het aandeel van de toename dat verder dan Afstand_m van een woonkern ligt.";
		}

		container IjkingDichtheidsrem
		: Descr = "De invoer voor batch/IjkDichtheidsrem.py die het model niet wegschrijft (#899): per blok van 100 m het gemiddelde over de zestien cellen van de opslagen voor OV en groot water
					en van de kernklassen uit MaxWoningDichtheid_T, en de NVM-regio per cel van 25 m. Op aanvraag; leest alleen BaseData en SourceData, dus kost geen allocatie."
		{
			attribute<Float32> OV     (/Geography/AllocDomain) := mean(float32(/BaseData/Omgeving/OV_Reistijd/TotRailHalte/Smoothed), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/remfactor/rem_OV_100m.tif", StorageType = "gdalwrite.grid", Descr = "De nabijheid van een railhalte waarmee de rem de opslag voor OV schaalt, gemiddeld per blok.";
			attribute<Float32> Water  (/Geography/AllocDomain) := mean(float32(/BaseData/StartState/Landgebruik/NabijGrootWaterInBBG/Smoothed), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/remfactor/rem_Water_100m.tif", StorageType = "gdalwrite.grid", Descr = "De nabijheid van groot water waarmee de rem de opslag voor water schaalt, gemiddeld per blok.";
			attribute<Float32> K100   (/Geography/AllocDomain) := mean(float32(/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is100kPlus), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/remfactor/rem_K100_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok in de buffer rond een kern vanaf 100.000 inwoners.";
			attribute<Float32> K20    (/Geography/AllocDomain) := mean(float32(!/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is100kPlus && /BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is20kPlus), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/remfactor/rem_K20_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok in de buffer rond een kern van 20.000 tot 100.000 inwoners en niet in een grotere; de rem telt alleen de grootste klasse.";
			attribute<Float32> K20min (/Geography/AllocDomain) := mean(float32(!/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is100kPlus && !/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is20kPlus && /BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is20kMin), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/remfactor/rem_K20min_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok in de buffer rond een kern onder 20.000 inwoners en niet in een grotere.";
			attribute<UInt32>  NVM    (/Geography/AdminDomain) := uint32(/SourceData/RegioIndelingen/NVM/Per_AdminDomain)
			, StorageName = "%LocalDataProjDir%/Ijking/nvm.tif", StorageType = "gdalwrite.grid", Descr = "De NVM-regio per cel, overgenomen van het blok, dus de indeling waarover de rem het gemiddelde neemt.";
		}
	}

	container Koolstof
	: Descr = "Of de ketens van de cumulatieve vastlegging en afboeking (#758) heel zijn, de regels koolstof_* in Checks. De optelling in de exporttabel, vastlegging min afboeking min oxidatie is
				CO2Flow_TovBasisjaar, is per constructie nul omdat de oxidatie sinds het basisjaar als het saldo min de twee ketens is gedefinieerd; die som bewijst niets. Wat wel kan breken is de
				keten zelf: een ontbrekende of verouderde ketentif maakt de cumulatieve kaart null of te klein. KetenNull telt de cellen in het studiegebied waar een van de twee cumulatieve kaarten
				null is en hoort nul te zijn. VastleggingKetenMin is per cel de cumulatieve vastlegging min de vastlegging van deze periode, dus de stand aan het begin van de periode, en het minimum
				daarvan hoort niet onder nul te komen; AfboekingKetenMax is hetzelfde voor de afboeking met het teken om en hoort niet boven nul te komen. In het eerste zichtjaar zijn die twee precies nul."
	{
		parameter<String>  P                   := /Diagnose/Pad_Z+'CarbonStorageSequestration/Zichtjaar/CO2/';
		parameter<UInt32>  KetenNull           := =('sum(uint32(/Geography/rdc_meter/IsStudyArea_AdminDomain && !(IsDefined('+P+'Cumulatief/Vastlegging) && IsDefined('+P+'Cumulatief/Afboeking))))');
		parameter<Float32> VastleggingKetenMin := =('min(value('+P+'Cumulatief/Vastlegging, float32) - value('+P+'PerBron/Vastlegging, float32))');
		parameter<Float32> AfboekingKetenMax   := =('max(value('+P+'Cumulatief/Afboeking, float32) - value('+P+'PerBron/Afboeking, float32))');
	}

	container Basisjaar
	: Descr = "Grootheden van het basisjaar met een referentiewaarde, de rijen van ChecksBasisjaar; de norm per rij staat in die tabel. Ze lezen de basisjaarstand en BaseData en
				hangen niet aan een zichtjaar."
	{
		parameter<String>  PadB                             := '/Indicatoren/'+/Diagnose/Casus+'/Basisjaar/Stand/';
		parameter<Float32> Woningen                         := =('sum(float32('+PadB+'Aantal_Woningen_Totaal))'), Descr = "De woningvoorraad van het basisjaar zoals de stand hem draagt (#703); hoort naast de CBS-voorraad van dat jaar te liggen.";
		parameter<Float32> Banen                            := =('sum(float32('+PadB+'Aantal_Banen_Totaal))'), Descr = "De banen van het basisjaar zoals de stand ze draagt; hoort naast het LISA-totaal van dat jaar te liggen.";

		parameter<Float32> HogeGronden_ha                   := sum(float32(/BaseData/Omgeving/HogeGronden && /Geography/rdc_meter/IsStudyArea_AdminDomain) * float32(/Geography/AdminDomain/NrHaPerCell)), Descr = "Het areaal hoge gronden binnen het studiegebied (#698). De maskering op het studiegebied is nodig, want de terugval op NietOverstroombaar maakt elke cel buiten de dieptekaart hoog, en
					dat is de halve Noordzee; wie hier een grootheid bijzet die over AdminDomain sommeert moet zelf op het studiegebied maskeren.";

		parameter<String>  BT                               := '/BaseData/Suitabilities/Wonen/BouwperiodeTerm/';
		parameter<Float32> BouwperiodeTerm                  := =('float32(' + AsList('sum('+BT+/Classifications/Vastgoed/WP4/name+'/Term * '+BT+/Classifications/Vastgoed/WP4/name+'/Aantal)', ' + ') + ') / float32(' + AsList('sum('+BT+/Classifications/Vastgoed/WP4/name+'/Aantal)', ' + ') + ')'), Descr = "Het naar woningaantal gewogen gemiddelde van de bouwperiodecoefficient in de prijs van de bestaande voorraad, over de vier woningtypen (#675). Per constructie nul zolang de term niet
		                                                       in de prijs zit; een nul terwijl hij erin hoort betekent dat de keten niet is aangesloten.";

		parameter<Float64> Verwervingskosten_NietWoon_mld   := sum(float64(float32(/BaseData/Suitabilities/Wonen/Verwervingskosten/Niet_Woningen/Calc))) / 1e9, Descr = "De verwervingskosten van het bestaande niet-woon vastgoed in miljard euro (#674). Vraagt Calc op en niet de ontkoppelde tif, zodat de IntegrityCheck bij Niet_Woningen/Calc meevuurt en
					een verouderd bestand hier niet binnenvalt.";

		parameter<Float32> BouwjaarTelling                  := =('value(/Indicatoren/'+/Diagnose/Casus+'/Basisjaar/WoningvoorraadBouwjaar/Geteld_Per_NL, float32) / value(/Indicatoren/'+/Diagnose/Casus+'/Basisjaar/WoningvoorraadBouwjaar/Stand_Per_NL, float32)'), Descr = "De woningen van het basisjaar opnieuw geteld uit de BAG, gedeeld door de basisjaarstand (#836); wijkt het af van 1, dan komt het aandeel per bouwjaarklasse uit een andere BAG dan de stand.";
		parameter<UInt32>  CellenBuitenNL                   := sum(uint32(/Geography/rdc_meter/IsStudyArea_AdminDomain && IsNull(/SourceData/RegioIndelingen/NL/Per_AdminDomain_Fijn))), Descr = "Cellen van het studiegebied buiten de NL-indeling van de indicatorentabellen (#748); hoort nul te zijn, anders meten een som over de tabel en een som over de kaart iets anders.";

		parameter<Float32> VervangingPerJaar                := /BaseData/Suitabilities/Wonen/Vervanging/VerwachtPerJaar, Descr = "De verwachte vervanging van bestaande woningen per jaar op de voorraad van het basisjaar (#859): de som van de jaarlijkse vervangingskans per bouwperiode over de woon-vbo's. De norm is
					de band rond wat de kansen in ModelParameters/Wonen/Vervanging op de voorraad per bouwperiode van de BAG-levering 20260710 geven; buiten de band betekent een verschoven klasse, een
					andere vbo-set of een gewijzigde kans.";
		parameter<Float32> VervangingKaartTovVBO            := =('sum(/BaseData/Suitabilities/Wonen/Vervanging/Kans/Totaal * float32('+PadB+'Aantal_Woningen_Totaal)) / /BaseData/Suitabilities/Wonen/Vervanging/VerwachtPerJaar'), Descr = "De vervanging per jaar zoals de kaart hem geeft, de kans per cel maal de basisjaarstand, gedeeld door de som van de kans over de woon-vbo's (#859). Hoort een te zijn; een lagere waarde betekent dat kans en woningen op verschillende cellen staan en dat de kaart woningen mist zonder dat vervanging_per_jaar het ziet.";

		parameter<Float32> BRK_PandcellenMetPerceel         := /BaseData/Suitabilities/Wonen/Opstalkosten/AandeelPandcellenMetPerceel, Descr = "Het aandeel van de cellen met een BAG-pand met een kostenpost dat een kadastraal perceel heeft (#861). Een pand staat altijd op een perceel, dus dit hoort dicht bij een te liggen; een
					lagere waarde betekent een lege of verschoven perceelkaart, en dan smeert de woongeschiktheid niets uit zonder dat iets anders faalt.";
		parameter<Float64> BRK_UitsmeringBehoud             := ='/BaseData/Suitabilities/Wonen/Opstalkosten/PerZichtjaar/Y'+string(/ModelParameters/Model_FirstZichtjaar)+'/Verwerving_Woningen/Behoud', Descr = "Het totaal van de verwervingskosten van woningen na de uitsmering over het perceel gedeeld door het totaal ervoor, voor het eerste zichtjaar (#861); hoort een te zijn op afronding na, anders verliest of verdubbelt de uitsmering kosten.";
		parameter<Float32> HerontwikkelingVerwachtPerJaar   := =/Diagnose/Pad_V + 'Herontwikkelingskans/VerwachtPerJaar', Descr = "De verwachte herontwikkeling per jaar in woningen op de voorraad van het basisjaar (#869): de som over de percelen met woningen van de jaarlijkse herontwikkelingskans maal hun woningen, voor de variant
		                                                       van de casus. De norm is een band rond de verdichtende sloop-nieuwbouw in de BAG 2013 tot 2024, ongeveer 3.000 woningen per jaar, want de kans is geschat op alleen de sloop-nieuwbouw die netto woningen toevoegt; het niveau is niet geijkt, dus een waarde buiten de band is een bevinding
		                                                       over de vertaling van de schatting naar de percelen van het model en geen reden voor een constante.";

		parameter<String>  Logies                           := '/BaseData/StartState/PandFootprint/PerYear_AdminDomain/Y'+string(/ModelParameters/Model_StartYear)+'/pand_met_vbo/PerGebruiksdoel_corr/logies/';
		parameter<String>  Trend                            := '/BaseData/StartState/Verblijfsrecreatie_Trends/DataPrep/ReadData_BAG/Y'+string(/ModelParameters/BAG_RecentYear)+'/PerRegio/Objecten';
		parameter<Float32> Verblijfsrecreatie_StandTovTrend := =/ModelParameters/SectorAllocRegio/Uq_Sectors/HasVerblijfsrecreatieSector ? '(sum(float32('+Logies+'count_Per_AdminDomain_inCBSVerblijfsrecreatie)) + sum(value(/BaseData/StartState/BAG_nieuwbouw/Verblijfsrecreatie/Totaal_inCBSVerblijfsrecreatie, float32))) / sum(value('+Trend+', float32))' : 'null_f', Descr = "De basisjaarstand logies in de CBS-verblijfsrecreatiegebieden plus de BAG-nieuwbouw, gedeeld door het aantal logies van de trendreeks in het recente BAG-jaar (#364): boven 1 staat de
		                                                       stand al boven de claim voordat er iets is gealloceerd. Null zolang de sector verblijfsrecreatie niet alloceert, want dan is er geen claim om de stand tegen af te zetten en kost de
		                                                       telling over de BAG vier minuten voor niets.";
	}

	container Werken
	: Descr = "Op aanvraag. De zichtjaarzeef per werksubsector, de zeef waar de omgekeerde milieuzonering en de dichtheidsdrempel op werken (#669, #670, #713), de ijking van de werkdichtheid (#907) en hoe de banen meebewegen met de woningen (#911)."
	{
		container         Zeef             :=
			for_each_nedv(
				/Classifications/Actor/Jobs6/name
				, '/VariantData/'+/Diagnose/Variant+'/Zeef/'+/Diagnose/Jaar+'/SectorxSubsectoren/Werken/'+/Classifications/Actor/Jobs6/name+'/IsBeschikbaar'
				, /Geography/CompactedAdminDomain
				, bool
			), Descr = "De zichtjaarzeef per werksubsector. Dit is de zeef waar #669, #670 en #713 op werken. De containernamen dragen een schuine streep (Werken/Nijverheid), dus het zijn geneste containers en geen namen met een onderstreping.";

		parameter<String> ZeefPerSubsector := =(
		                                            quote('maat;cellen')
		                                          + ' + ' + quote('|zeef_nijverheid;') + ' + string(sum(uint32(Zeef/Nijverheid)))'
		                                          + ' + ' + quote('|zeef_logistiek;') + ' + string(sum(uint32(Zeef/Logistiek)))'
		                                          + ' + ' + quote('|zeef_detailhandel;') + ' + string(sum(uint32(Zeef/Detailhandel)))'
		                                          + ' + ' + quote('|zeef_ov_consumentendiensten;') + ' + string(sum(uint32(Zeef/Ov_consumentendiensten)))'
		                                          + ' + ' + quote('|zeef_zak_dienstverlening;') + ' + string(sum(uint32(Zeef/Zak_dienstverlening)))'
		                                          + ' + ' + quote('|zeef_overheid_kw_diensten;') + ' + string(sum(uint32(Zeef/Overheid_kw_diensten)))'
		                                      )
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zeef_werken.txt'"
		, StorageType = "str"
		, Descr = "Beschikbare cellen op het compacted domain per werksubsector in de zichtjaarzeef. Verschillen tussen de zes zeggen wat de omgekeerde milieuzonering en de dichtheidsdrempel per subsector wegnemen.";

		parameter<String> Combinamen       := =('AsList(/CaseClassifications/'+/Diagnose/Variant+'/Actor/VariantXSectorxSubsector/Combi_name, '+quote(';')+')')
		, StorageName = "='%LocalDataProjDir%/Diagnose/combinamen_'+/Diagnose/Variant+'.txt'"
		, StorageType = "str"
		, Descr = "De namen waaronder de zeef per sector en subsector hangt. Nodig omdat het pad /VariantData/<variant>/Zeef/<jaar>/SectorxSubsectoren/<naam> alleen te raden was; deze uitdraai maakt dat een opzoeking.";

		container IjkingDichtheid
		: Descr = "De invoer voor batch/IjkDichtheidWerken.py (#907): per blok van 100 m en per werksubsector de pandvoetafdruk uit de BAG van BAG_RecentYear, alles en alleen de panden vanaf Beginjaar, naast de
					dichtheid waarmee de allocatie nieuwe banen neerzet (Templates/Densities/Werken_T, Result) en dezelfde dichtheid zonder het blok zelf in het omgevingsmaximum, zoals een blok die krijgt dat nog geen
					werklocatie is. Daarnaast het aandeel van elke werkklasse in BBG 2012 en 2017, zodat het script de werklocaties van na 2012 kan kiezen, en per subsector de dichtheid die zo'n nieuwe werklocatie krijgt van de werklocaties van 2012 (Oud), uitgesplitst naar
					de termen van de dichtheidsfactor. Op aanvraag; leest de variantdata van Diagnose/Variant en schrijft naar %LocalDataProjDir%/Ijking/werkdichtheid."
		{
			parameter<UInt32>  Beginjaar       := 2011, Descr = "Het eerste bouwjaar dat als nieuwbouw telt; met BAG_RecentYear 2026 is dat de nieuwbouw van de vijftien jaar 2011 tot en met 2025.";
			parameter<String>  Pand_path       := '/SourceData/Vastgoed/BAG/PerJaar/Y'+string(/ModelParameters/BAG_RecentYear)+'/pand/met_vbo', Descr = "De panden met een verblijfsobject op 1 januari van BAG_RecentYear.";
			parameter<String>  Dichtheid_path  := '/VariantData/'+/Diagnose/Variant+'/Density/Impl/PerZichtjaar_AllocDomain/'+/Diagnose/Jaar+'/Src/Werken/Basisjaar/PandFootprint_perHa', Descr = "De pandvoetafdruk per hectare uit het basisjaar, voor elk zichtjaar dezelfde.";

			container PerDoel := for_each_ne(/Classifications/Vastgoed/vbo_gebruiksdoel_plus/name, 'PerDoel_T('+quote(/Classifications/Vastgoed/vbo_gebruiksdoel_plus/name)+')');
			container PerSubsector := for_each_ne(/Classifications/Actor/Jobs6/name, 'PerSubsector_T('+quote(/Classifications/Actor/Jobs6/name)+')');

			attribute<Float32> K100   (/Geography/AllocDomain) := mean(float32(/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is100kPlus), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/werkdichtheid/K100_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok in de buffer rond een kern vanaf 100.000 inwoners.";
			attribute<Float32> K20    (/Geography/AllocDomain) := mean(float32(!/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is100kPlus && /BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is20kPlus), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/werkdichtheid/K20_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok in de buffer rond een kern van 20.000 tot 100.000 inwoners en niet in een grotere.";
			attribute<Float32> K20min (/Geography/AllocDomain) := mean(float32(!/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is100kPlus && !/BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is20kPlus && /BaseData/Omgeving/BebouwdGebied/RondBevolkingskern/Is20kMin), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/werkdichtheid/K20min_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok in de buffer rond een kern onder 20.000 inwoners en niet in een grotere.";
			attribute<Float32> OV     (/Geography/AllocDomain) := mean(float32(/BaseData/Omgeving/OV_Reistijd/TotRailHalte/Smoothed), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/werkdichtheid/OV_100m.tif", StorageType = "gdalwrite.grid", Descr = "De nabijheid van een railhalte waarmee de dichtheidsfactor de opslag voor OV schaalt, gemiddeld per blok.";
			attribute<Float32> Water  (/Geography/AllocDomain) := mean(float32(/BaseData/StartState/Landgebruik/NabijGrootWaterInBBG/Smoothed), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/werkdichtheid/Water_100m.tif", StorageType = "gdalwrite.grid", Descr = "De nabijheid van groot water waarmee de dichtheidsfactor de opslag voor water schaalt, gemiddeld per blok.";

			parameter<Float32> GrensOud := 0.5f, Descr = "Het deel van een blok dat in BBG 2012 van de klasse moet zijn om als bestaande werklocatie mee te tellen in de omgevingsdichtheid van Oud.";
			attribute<SourceData/Grondgebruik/BBG/BBG_Reeks_1996_2017> Reeks (/Geography/AdminDomain) := poly2grid(/SourceData/Grondgebruik/BBG/BBG_Reeks_1996_2017/geometry, /Geography/AdminDomain), Descr = "Het vlak van de BBG-reeks 1996 tot en met 2017 per cel. Zonder opslag, want de modus per 100 meter in BaseData/Grondgebruik/BBG schrijft naar de brondata.";
			attribute<Classifications/Grondgebruik/CBS2010Klasse> BBG2012 (/Geography/AdminDomain) := /SourceData/Grondgebruik/BBG/BBG_Reeks_1996_2017/CBSKlasse_rel_2012[Reeks], Descr = "De CBS-klasse van BBG 2012 per cel, de stand van voor de nieuwbouw.";
			attribute<Classifications/Grondgebruik/CBS2010Klasse/Aggr> BBG2012_Aggr (/Geography/AdminDomain) := /Classifications/Grondgebruik/CBS2010Klasse/Aggr_rel[BBG2012];
			attribute<Classifications/Grondgebruik/CBS2010Klasse/Aggr> BBG2017_Aggr (/Geography/AdminDomain) := /Classifications/Grondgebruik/CBS2010Klasse/Aggr_rel[/SourceData/Grondgebruik/BBG/BBG_Reeks_1996_2017/CBSKlasse_rel_2017[Reeks]], Descr = "De klasse van BBG 2017, uit dezelfde reeks als 2012 en dus zonder het methodeverschil met het BBG van 2022.";
			attribute<Float32> Uitleg2012 (/Geography/AllocDomain) := mean(float32(IsDefined(BBG2012) && /Classifications/Grondgebruik/CBS2010Klasse/TXLUitleglocatie[BBG2012]), /Geography/AdminDomain/AllocDomain_rel)
			, StorageName = "%LocalDataProjDir%/Ijking/werkdichtheid/Uitleg2012_100m.tif", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok dat in BBG 2012 natuur, landbouw, water of overig terrein was, dus geen bebouwd gebied.";

			unit<UInt8> WerkKlasse := unique(/Classifications/Grondgebruik/CBSKlasse/Aggr/name[/Classifications/Actor/Jobs6/CBSKlasse_Aggr_rel]), Descr = "De CBS-klassen waarover het model de dichtheid van de werksubsectoren meet.";
			container PerKlasse := for_each_ne(WerkKlasse/Values, 'PerKlasse_T('+quote(WerkKlasse/Values)+')');

			Template PerKlasse_T
			{
				parameter<String> name;
				//

				parameter<Classifications/Grondgebruik/CBS2010Klasse/Aggr> Klasse_rel := rlookup(lowercase(name), lowercase(/Classifications/Grondgebruik/CBS2010Klasse/Aggr/name));
				attribute<Float32> Aandeel2012 (/Geography/AllocDomain) := mean(float32(IsDefined(BBG2012_Aggr) && BBG2012_Aggr == Klasse_rel), /Geography/AdminDomain/AllocDomain_rel)
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Aandeel2012_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok dat in BBG 2012 van deze klasse was.";
				attribute<Float32> Aandeel2017 (/Geography/AllocDomain) := mean(float32(IsDefined(BBG2017_Aggr) && BBG2017_Aggr == Klasse_rel), /Geography/AdminDomain/AllocDomain_rel)
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Aandeel2017_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "Het deel van het blok dat in BBG 2017 van deze klasse was.";
			}

			Template PerDoel_T
			: Descr = "De pandvoetafdruk van een gebruiksdoel per blok, over alle panden en over de panden vanaf Beginjaar, met dezelfde toedeling van pand naar blok."
			{
				parameter<String> name;
				//

				unit<UInt32> TM := =Pand_path+'/ToedelingsMatrix_AllocDomain';
				attribute<Units/m2PandFootprint> Footprint (TM) := =Pand_path+'/Oppervlaktes/Footprint_perGebruiksdoel/'+name+'[TM/Pand_rel]';
				attribute<Bool>                  IsNieuw   (TM) := =Pand_path+'/Bouwjaar_trunc[TM/Pand_rel] >= value(Beginjaar, Units/yr)';

				attribute<Units/m2PandFootprint> Totaal (/Geography/AllocDomain) := sum(Footprint * TM/ToedelingPand, TM/AllocDomain_rel);
				attribute<Units/m2PandFootprint> Nieuw  (/Geography/AllocDomain) := sum(IsNieuw ? Footprint * TM/ToedelingPand : 0[Units/m2PandFootprint], TM/AllocDomain_rel);
			}

			Template PerSubsector_T
			: Descr = "Per werksubsector de voetafdruk van de BAG en de dichtheid van het model per blok, als tif."
			{
				parameter<String> name;
				//

				parameter<String> Doelen_ref := /Classifications/Actor/Jobs6/vbo_gebruiksdoel_plus_ref[rlookup(name, /Classifications/Actor/Jobs6/name)];
				container         Model      := =Dichtheid_path+'/'+name;

				attribute<Units/m2PandFootprint>    Totaal         (/Geography/AllocDomain) := ='MakeDefined('+replace(Doelen_ref, '@', 'PerDoel/', '#', '/Totaal')+', 0[Units/m2PandFootprint])'
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Totaal_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De voetafdruk van alle panden van deze subsector in het blok.";
				attribute<Units/m2PandFootprint>    Nieuw          (/Geography/AllocDomain) := ='MakeDefined('+replace(Doelen_ref, '@', 'PerDoel/', '#', '/Nieuw')+', 0[Units/m2PandFootprint])'
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Nieuw_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De voetafdruk van de panden van deze subsector vanaf Beginjaar in het blok.";
				attribute<Units/m2PandFootprint_ha> Result         (/Geography/AllocDomain) := Model/Result
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Result_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De dichtheid waarmee de allocatie nieuwe banen van deze subsector in het blok neerzet.";
				attribute<Units/m2PandFootprint_ha> Omgeving       (/Geography/AllocDomain) := value(potential(max_elem(Model/Buurt, Model/Wijk, Model/Gemeente, Model/NVM, Model/COROP, Model/Provincie) * Model/DichtheidFactor, /Geography/Distmatrices_100m/pot2000m/rev_dist_scaled / sum(/Geography/Distmatrices_100m/pot2000m/rev_dist_scaled)), Units/m2PandFootprint_ha)
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Omgeving_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "Result zonder de eigen dichtheid van het blok in het omgevingsmaximum, de dichtheid die een blok krijgt dat in het basisjaar geen werklocatie van deze klasse is.";
				attribute<UInt8>                    InKlasse       (/Geography/AllocDomain) := uint8(Model/NoemerBasisjaar > 0[Units/ha])
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/InKlasse_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "Is het blok in het basisjaar van de CBS-klasse waarover het model de dichtheid van deze subsector meet?";
				attribute<Float32>                  Factor         (/Geography/AllocDomain) := Model/DichtheidFactor
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Factor_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De dichtheidsfactor van het blok, met de opslagen voor OV, groot water en de kerngrootte.";
				attribute<Units/m2PandFootprint_ha> Eigen          (/Geography/AllocDomain) := Model/per_domain
				, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Eigen_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De voetafdruk per hectare van het blok zelf in het basisjaar, zoals het model de dichtheid van een blok meet.";

				parameter<String> Klasse := /Classifications/Grondgebruik/CBSKlasse/Aggr/name[/Classifications/Actor/Jobs6/CBSKlasse_Aggr_rel[rlookup(name, /Classifications/Actor/Jobs6/name)]];

				container Oud
				: Descr = "Omgeving zoals een nieuwe werklocatie hem krijgt van de werklocaties die er in 2012 al waren: het omgevingsmaximum over de blokken die in BBG 2012 voor minstens GrensOud van de klasse waren, uitgesmeerd over 2 km. Uitgesplitst naar de termen van de dichtheidsfactor, zodat de omgevingsdichtheid bij andere factoren de som is van Basis maal de generieke factor en de andere termen maal hun opslag."
				{
					attribute<Float32>                  Aandeel2012 (/Geography/AllocDomain) := ='/Diagnose/Werken/IjkingDichtheid/PerKlasse/'+Klasse+'/Aandeel2012';
					attribute<Units/m2PandFootprint_ha> per_domain  (/Geography/AllocDomain) := Aandeel2012 >= GrensOud ? Model/per_domain : (0f/0f)[Units/m2PandFootprint_ha];
					attribute<Units/m2PandFootprint_ha> Buurt       (/Geography/AllocDomain) := mean(per_domain, /SourceData/RegioIndelingen/CBS/Gekozen/Buurt/per_AllocDomain)[/SourceData/RegioIndelingen/CBS/Gekozen/Buurt/per_AllocDomain];
					attribute<Units/m2PandFootprint_ha> Wijk        (/Geography/AllocDomain) := mean(per_domain, /SourceData/RegioIndelingen/CBS/Gekozen/Wijk/per_AllocDomain)[/SourceData/RegioIndelingen/CBS/Gekozen/Wijk/per_AllocDomain];
					attribute<Units/m2PandFootprint_ha> Gemeente    (/Geography/AllocDomain) := mean(per_domain, /SourceData/RegioIndelingen/CBS/Gekozen/Gemeente/per_AllocDomain)[/SourceData/RegioIndelingen/CBS/Gekozen/Gemeente/per_AllocDomain];
					attribute<Units/m2PandFootprint_ha> NVM         (/Geography/AllocDomain) := mean(per_domain, /SourceData/RegioIndelingen/NVM/per_AllocDomain)[/SourceData/RegioIndelingen/NVM/per_AllocDomain];
					attribute<Units/m2PandFootprint_ha> COROP       (/Geography/AllocDomain) := mean(per_domain, /SourceData/RegioIndelingen/CBS/Gekozen/COROP/per_AllocDomain)[/SourceData/RegioIndelingen/CBS/Gekozen/COROP/per_AllocDomain];
					attribute<Units/m2PandFootprint_ha> Provincie   (/Geography/AllocDomain) := mean(per_domain, /SourceData/RegioIndelingen/CBS/Gekozen/Provincie/per_AllocDomain)[/SourceData/RegioIndelingen/CBS/Gekozen/Provincie/per_AllocDomain];
					attribute<Units/m2PandFootprint_ha> Max         (/Geography/AllocDomain) := max_elem(Buurt, Wijk, Gemeente, NVM, COROP, Provincie);

					unit<SPoint> Kern := /Geography/Distmatrices_100m/pot2000m;
					attribute<Float32> Gewicht (Kern) := Kern/rev_dist_scaled / sum(Kern/rev_dist_scaled);

					attribute<Units/m2PandFootprint_ha> Omgeving (/Geography/AllocDomain) := value(potential(Max * Model/DichtheidFactor, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_Omgeving_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "Met de huidige dichtheidsfactor; de controle dat de termen samen deze omgevingsdichtheid geven.";
					attribute<Units/m2PandFootprint_ha> Basis    (/Geography/AllocDomain) := value(potential(Max, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_Basis_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De term van de generieke factor.";
					attribute<Units/m2PandFootprint_ha> OV       (/Geography/AllocDomain) := value(potential(Max * /Diagnose/Werken/IjkingDichtheid/OV, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_OV_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De term van de opslag voor OV.";
					attribute<Units/m2PandFootprint_ha> Water    (/Geography/AllocDomain) := value(potential(Max * /Diagnose/Werken/IjkingDichtheid/Water, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_Water_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De term van de opslag voor groot water.";
					attribute<Units/m2PandFootprint_ha> K100     (/Geography/AllocDomain) := value(potential(Max * /Diagnose/Werken/IjkingDichtheid/K100, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_K100_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De term van de opslag voor een kern vanaf 100.000 inwoners.";
					attribute<Units/m2PandFootprint_ha> K20      (/Geography/AllocDomain) := value(potential(Max * /Diagnose/Werken/IjkingDichtheid/K20, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_K20_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De term van de opslag voor een kern van 20.000 tot 100.000 inwoners.";
					attribute<Units/m2PandFootprint_ha> K20min   (/Geography/AllocDomain) := value(potential(Max * /Diagnose/Werken/IjkingDichtheid/K20min, Gewicht), Units/m2PandFootprint_ha)
					, StorageName = "='%LocalDataProjDir%/Ijking/werkdichtheid/Oud_K20min_'+name+'_100m.tif'", StorageType = "gdalwrite.grid", Descr = "De term van de opslag voor een kern onder 20.000 inwoners.";
				}
			}

			parameter<String> Generate := 'Ready', ExplicitSuppliers = "=AsList('PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Totaal;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Nieuw;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Result;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Omgeving;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/InKlasse;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Factor;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Eigen', ';')+';'+AsList('PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/Omgeving;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/Basis;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/OV;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/Water;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/K100;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/K20;PerSubsector/'+/Classifications/Actor/Jobs6/name+'/Oud/K20min', ';')+';'+AsList('PerKlasse/'+WerkKlasse/Values+'/Aandeel2012;PerKlasse/'+WerkKlasse/Values+'/Aandeel2017', ';')+';K100;K20;K20min;OV;Water;Uitleg2012'", Descr = "Schrijft alle tifs van deze container.";
		}

		container MeebewegingWoningen
		: Descr = "Op aanvraag. Hoe het aandeel van een regio in de landelijke banen per werksubsector meebeweegt met haar aandeel in de woningen, de onderbouwing van
					ModelParameters/ClaimBasisjaar/VerdelingVerzorgend (#911). Per indeling, periode en subsector een gewogen regressie (HC1) van de verandering van het banenaandeel op die van het
					woningaandeel, met en zonder het verschil tussen beide aandelen in het beginjaar, en per subsector de persistentie tussen de twee deelperioden. Banen uit LISA, woningen uit de BAG,
					per gemeente en opgeteld naar stadregio, pendelregio en provincie. De BAG is op het studiegebied geknipt, dus een landelijke schatting vraagt StudyArea Nederland. Generate schrijft per
					indeling twee csv's en het paneel per gemeente naar %LocalDataProjDir%/Diagnose."
		{
			parameter<UInt32>  Beginjaar  := 2012, Descr = "Het eerste jaar, het eerste jaar van de BAG-reeks (SourceData/Vastgoed/BAG/BAG_jaren).";
			parameter<UInt32>  Middenjaar := 2017, Descr = "De grens tussen de twee deelperiodes waarop de persistentie wordt gemeten.";
			parameter<UInt32>  Eindjaar   := /ModelParameters/LISA_FileYear, Descr = "Het laatste jaar, de laatste LISA-jaargang.";
			parameter<Float64> Drempel    := 50d, Descr = "Een regio telt in een schatting mee als ze in elk jaar ervan meer banen van de subsector heeft dan dit; bij minder banen is de verandering van het aandeel vooral toeval.";

			unit<UInt32> Gemeente := /SourceData/RegioIndelingen/CBS/Gekozen/Gemeente;

			unit<UInt32> Jaar : nrofrows = 3
			{
				attribute<UInt32> Jaartal := union_data(., Beginjaar, Middenjaar, Eindjaar);
				attribute<String> name    := 'Y'+string(Jaartal);
			}
			unit<UInt32> Periode : nrofrows = 3
			, Descr = "De hele periode en de twee deelperiodes."
			{
				attribute<UInt32> Van  := union_data(., Beginjaar, Beginjaar, Middenjaar);
				attribute<UInt32> Tot  := union_data(., Eindjaar, Middenjaar, Eindjaar);
				attribute<String> name := 'P'+string(Van)+'_'+string(Tot);
			}
			unit<UInt32> Rij := combine(Periode, /Classifications/Actor/Jobs6)
			, Descr = "Een schatting per periode en werksubsector."
			{
				attribute<String> Periode_name   := Periode/name[first_rel];
				attribute<String> Van_name       := 'Y'+string(Periode/Van[first_rel]);
				attribute<String> Tot_name       := 'Y'+string(Periode/Tot[first_rel]);
				attribute<String> Subsector_name := /Classifications/Actor/Jobs6/name[second_rel];
				attribute<String> name           := Periode_name+'_'+Subsector_name;
			}
			unit<UInt32> JaarSubsector := combine(Jaar, /Classifications/Actor/Jobs6)
			{
				attribute<String> Jaar_name      := Jaar/name[first_rel];
				attribute<UInt32> Jaartal        := Jaar/Jaartal[first_rel];
				attribute<String> Subsector_name := /Classifications/Actor/Jobs6/name[second_rel];
				attribute<String> name           := Jaar_name+'_'+Subsector_name;
			}

			container PerJaar := for_each_ne(Jaar/name, 'PerJaar_T('+quote(string(Jaar/Jaartal))+')');

			unit<UInt32> Indeling : nrofrows = 4
			, Descr = "De indelingen waarop geschat wordt, met de regio-eenheid en de koppeling van gemeente naar regio. Stadregio en pendelregio zijn opgebouwd uit hele gemeenten en worden via de
						toewijzingstabel gekoppeld, de provincie via het zwaartepunt van de gemeente."
			{
				attribute<String> name      : ['Gemeente', 'Stadregio', 'Pendelregio', 'Provincie'], IntegrityCheck = "all(IsDefined(this))";
				attribute<String> Regio     : ['/SourceData/RegioIndelingen/CBS/Gekozen/Gemeente', '/SourceData/RegioIndelingen/Stadregio', '/SourceData/RegioIndelingen/Pendelregio', '/SourceData/RegioIndelingen/CBS/Gekozen/Provincie'], IntegrityCheck = "all(IsDefined(this))";
				attribute<String> Koppeling :
				[
					  'id(Gemeente)'
					, '/SourceData/RegioIndelingen/Pendelregio_Gemeente/Stadregio_rel[rlookup(Gemeente/statcode, /SourceData/RegioIndelingen/Pendelregio_Gemeente/GM_code)]'
					, '/SourceData/RegioIndelingen/Pendelregio_Gemeente/Pendelregio_rel[rlookup(Gemeente/statcode, /SourceData/RegioIndelingen/Pendelregio_Gemeente/GM_code)]'
					, 'Gemeente/Provincie_rel'
				], IntegrityCheck = "all(IsDefined(this))";
			}

			container PerIndeling := for_each_ne(Indeling/name, 'Indeling_T('+quote(Indeling/name)+', '+quote(Indeling/Regio)+', '+quote(Indeling/Koppeling)+')');

			unit<UInt32> Paneel := ='union_unit('+AsList(const('Gemeente', JaarSubsector), ',')+')'
			, StorageName = "%LocalDataProjDir%/Diagnose/MeebewegingWoningen_paneel.csv"
			, StorageType = "gdalwrite.vect"
			, Descr = "De invoer van de schattingen per gemeente: een rij per jaar, subsector en gemeente met de banen en de woningen."
			{
				attribute<String>  gm_code   := ='union_data(., '+AsList(const('Gemeente/statcode', JaarSubsector), ',')+')';
				attribute<UInt32>  jaar      := ='union_data(., '+AsList('const('+string(JaarSubsector/Jaartal)+', Gemeente, UInt32)', ',')+')';
				attribute<String>  subsector := ='union_data(., '+AsList('const('+quote(JaarSubsector/Subsector_name)+', Gemeente)', ',')+')';
				attribute<Float64> banen     := ='union_data(., '+AsList('PerJaar/'+JaarSubsector/Jaar_name+'/Banen/'+JaarSubsector/Subsector_name, ',')+')';
				attribute<Float64> woningen  := ='union_data(., '+AsList('PerJaar/'+JaarSubsector/Jaar_name+'/Woningen', ',')+')';
			}

			parameter<String> Generate := 'Ready', ExplicitSuppliers = "=AsList('PerIndeling/'+Indeling/name+'/Tabel/eps;PerIndeling/'+Indeling/name+'/TabelPersistentie/helling', ';')+';Paneel/banen'", Descr = "Schrijft de tabellen van alle indelingen en het paneel.";

			Template PerJaar_T
			: Descr = "De banen per werksubsector en de woningen per gemeente in een jaar."
			{
				parameter<String> JaarStr;
				//

				unit<UInt32> LISA
				: StorageName     = "='%PrivDataDir%/LISA/LISA'+string(/ModelParameters/LISA_FileYear)+'_'+JaarStr+'_bas.csv'"
				, StorageType     = "gdal.vect"
				, StorageReadOnly = "True"
				, Descr           = "De LISA-vestigingen van dit jaar uit de jaargang LISA_FileYear."
				{
					attribute<Float64>   x_alt;
					attribute<Float64>   y_alt;
					attribute<Float64>   banen;
					attribute<String>    sbi08;
					attribute</Geography/rdc_meter> geometry := point_xy(x_alt, y_alt, /Geography/rdc_meter);
					attribute<Gemeente>  Gemeente_rel := point_in_polygon(geometry, Gemeente/geometry);
					attribute</Classifications/Actor/TXLJobs11> TXLJobs11_rel := MakeDefined(
					                                                                  rjoin(lowercase(sbi08), lowercase(/Classifications/Actor/SBI08/SBI2008), /Classifications/Actor/SBI08/TXLJobs11_rel)
					                                                                , rjoin(lowercase(left(sbi08, 4)), lowercase(/Classifications/Actor/SBI08/SBI2008), /Classifications/Actor/SBI08/TXLJobs11_rel)
					                                                                , rjoin(lowercase(left(sbi08, 3)), lowercase(/Classifications/Actor/SBI08/SBI2008), /Classifications/Actor/SBI08/TXLJobs11_rel)
					                                                                , rjoin(lowercase(left(sbi08, 2)), lowercase(/Classifications/Actor/SBI08/SBI2008), /Classifications/Actor/SBI08/TXLJobs11_rel)
					                                                              ), Descr = "De TXL-klasse van de SBI-code, en anders van de langste voorloper van de code die in de tabel staat.";
					attribute</Classifications/Actor/Jobs6> Jobs6_rel := /Classifications/Actor/TXLJobs11/Jobs6_rel[TXLJobs11_rel], Descr = "Null voor landbouw en voor een code zonder TXL-klasse.";
				}

				container Banen :=
					for_each_nedv(
						/Classifications/Actor/Jobs6/name
						, 'sum(MakeDefined(LISA/Jobs6_rel == /Classifications/Actor/Jobs6/V/'+/Classifications/Actor/Jobs6/name+', FALSE) ? LISA/banen : 0d, LISA/Gemeente_rel)'
						, Gemeente
						, Float64
					), Descr = "De banen per gemeente en per werksubsector.";

				parameter<Float64> AandeelZonderSubsector := sum(IsDefined(LISA/Jobs6_rel) ? 0d : LISA/banen) / sum(LISA/banen), Descr = "Het deel van de banen zonder werksubsector, vooral landbouw.";
				parameter<Float64> AandeelZonderGemeente  := sum(IsDefined(LISA/Gemeente_rel) ? 0d : LISA/banen) / sum(LISA/banen), Descr = "Het deel van de banen op een punt buiten de gemeenten.";

				unit<UInt32>        Woon               := ='/SourceData/Vastgoed/BAG/PerJaar/Y'+JaarStr+'/vbo/Per_gebruiksdoel/woon/select', Descr = "De verblijfsobjecten met een woonfunctie in de voorraad op 1 januari.";
				attribute<Gemeente> Woon_Gemeente_rel (Woon) := point_in_polygon(Woon/geometry, Gemeente/geometry);
				attribute<Float64>  Woningen (Gemeente) := float64(pcount(Woon_Gemeente_rel)), Descr = "De woningen per gemeente.";
			}

			Template Indeling_T
			: Descr = "De schattingen op een indeling: banen en woningen per regio en jaar, de regressie per periode en subsector, de persistentie per subsector, en de twee tabellen."
			{
				parameter<String> Indeling_name;
				parameter<String> Regio_pad;
				parameter<String> Koppeling;
				//

				unit<UInt32>     Regio                   := =Regio_pad;
				attribute<Regio> Gemeente_rel (Gemeente) := =Koppeling;

				container Banen    := for_each_nedv(JaarSubsector/name, 'sum(PerJaar/'+JaarSubsector/Jaar_name+'/Banen/'+JaarSubsector/Subsector_name+', Gemeente_rel)', Regio, Float64), Descr = "De banen per regio, jaar en subsector.";
				container Woningen := for_each_nedv(Jaar/name, 'sum(PerJaar/'+Jaar/name+'/Woningen, Gemeente_rel)', Regio, Float64), Descr = "De woningen per regio en jaar.";

				container Schatting    := for_each_ne(Rij/name, 'Schatting_T('+quote(Rij/Van_name)+', '+quote(Rij/Tot_name)+', '+quote(Rij/Subsector_name)+')');
				container Persistentie := for_each_ne(/Classifications/Actor/Jobs6/name, 'Persistentie_T('+quote(/Classifications/Actor/Jobs6/name)+')');

				unit<UInt32> Tabel := Rij
				, StorageName = "='%LocalDataProjDir%/Diagnose/MeebewegingWoningen_'+Indeling_name+'.csv'"
				, StorageType = "gdalwrite.vect"
				, Descr = "Een rij per periode en subsector. eps_alleen is de elasticiteit zonder het verschil in het beginjaar, eps en gat die met het verschil; se zijn de standaardfouten, r2 de
							verklaarde variantie en n het aantal regio's dat meetelt."
				{
					attribute<String>  periode    := Rij/Periode_name;
					attribute<String>  subsector  := Rij/Subsector_name;
					attribute<UInt32>  n          := ='union_data(., '+AsList('Schatting/'+Rij/name+'/N', ',')+')';
					attribute<Float64> eps_alleen := ='union_data(., '+AsList('Schatting/'+Rij/name+'/Eps_Alleen', ',')+')';
					attribute<Float64> se_alleen  := ='union_data(., '+AsList('Schatting/'+Rij/name+'/Se_Alleen', ',')+')';
					attribute<Float64> r2_alleen  := ='union_data(., '+AsList('Schatting/'+Rij/name+'/R2_Alleen', ',')+')';
					attribute<Float64> eps        := ='union_data(., '+AsList('Schatting/'+Rij/name+'/Eps', ',')+')';
					attribute<Float64> se_eps     := ='union_data(., '+AsList('Schatting/'+Rij/name+'/Se_Eps', ',')+')';
					attribute<Float64> gat        := ='union_data(., '+AsList('Schatting/'+Rij/name+'/Gat', ',')+')';
					attribute<Float64> se_gat     := ='union_data(., '+AsList('Schatting/'+Rij/name+'/Se_Gat', ',')+')';
					attribute<Float64> r2         := ='union_data(., '+AsList('Schatting/'+Rij/name+'/R2', ',')+')';
				}

				unit<UInt8> TabelPersistentie := /Classifications/Actor/Jobs6
				, StorageName = "='%LocalDataProjDir%/Diagnose/MeebewegingWoningen_persistentie_'+Indeling_name+'.csv'"
				, StorageType = "gdalwrite.vect"
				, Descr = "Een rij per subsector met de gewogen correlatie en de helling tussen de rest van de twee deelperiodes."
				{
					attribute<String>  subsector  := /Classifications/Actor/Jobs6/name;
					attribute<UInt32>  n          := ='union_data(., '+AsList('Persistentie/'+/Classifications/Actor/Jobs6/name+'/N', ',')+')';
					attribute<Float64> correlatie := ='union_data(., '+AsList('Persistentie/'+/Classifications/Actor/Jobs6/name+'/Correlatie', ',')+')';
					attribute<Float64> helling    := ='union_data(., '+AsList('Persistentie/'+/Classifications/Actor/Jobs6/name+'/Helling', ',')+')';
				}

				Template Schatting_T
				: Descr = "De regressie van de verandering van het banenaandeel (y) op die van het woningaandeel (x1) en het verschil tussen banen- en woningaandeel in het beginjaar (x2), met een
							constante, gewogen met de banen in het beginjaar. De constante valt weg door elke variabele om haar gewogen gemiddelde te nemen; de standaardfouten zijn de sandwichschatter
							met de correctie n / (n - k) (HC1)."
				{
					parameter<String> Van_name;
					parameter<String> Tot_name;
					parameter<String> Subsector_name;
					//

					attribute<Float64> E0   (Regio) := ='Banen/'+Van_name+'_'+Subsector_name;
					attribute<Float64> E1   (Regio) := ='Banen/'+Tot_name+'_'+Subsector_name;
					attribute<Float64> W0   (Regio) := ='Woningen/'+Van_name;
					attribute<Float64> W1   (Regio) := ='Woningen/'+Tot_name;
					attribute<Bool>    Telt (Regio) := E0 > Drempel && E1 > Drempel && W0 > 0d && W1 > 0d;
					attribute<Float64> w    (Regio) := Telt ? E0 : 0d;
					attribute<Float64> y    (Regio) := Telt ? log((E1 / sum(E1)) / (E0 / sum(E0))) : 0d;
					attribute<Float64> x1   (Regio) := Telt ? log((W1 / sum(W1)) / (W0 / sum(W0))) : 0d;
					attribute<Float64> x2   (Regio) := Telt ? log((E0 / sum(E0)) / (W0 / sum(W0))) : 0d;

					parameter<UInt32>  N    := sum(uint32(Telt));
					parameter<Float64> Sw   := sum(w);
					attribute<Float64> dy   (Regio) := Telt ? y  - sum(w * y)  / Sw : 0d;
					attribute<Float64> d1   (Regio) := Telt ? x1 - sum(w * x1) / Sw : 0d;
					attribute<Float64> d2   (Regio) := Telt ? x2 - sum(w * x2) / Sw : 0d;
					parameter<Float64> S11  := sum(w * d1 * d1);
					parameter<Float64> S12  := sum(w * d1 * d2);
					parameter<Float64> S22  := sum(w * d2 * d2);
					parameter<Float64> S1y  := sum(w * d1 * dy);
					parameter<Float64> S2y  := sum(w * d2 * dy);
					parameter<Float64> Syy  := sum(w * dy * dy);

					parameter<Float64> Eps_Alleen := S1y / S11;
					attribute<Float64> r_Alleen (Regio) := dy - Eps_Alleen * d1;
					parameter<Float64> Se_Alleen  := sqrt(sum(w * w * d1 * d1 * r_Alleen * r_Alleen) * float64(N) / (float64(N) - 2d)) / S11;
					parameter<Float64> R2_Alleen  := 1d - sum(w * r_Alleen * r_Alleen) / Syy;

					parameter<Float64> Det    := S11 * S22 - S12 * S12;
					parameter<Float64> A11    := S22 / Det;
					parameter<Float64> A12    := 0d - S12 / Det;
					parameter<Float64> A22    := S11 / Det;
					parameter<Float64> Eps    := A11 * S1y + A12 * S2y;
					parameter<Float64> Gat    := A12 * S1y + A22 * S2y;
					attribute<Float64> r (Regio) := dy - Eps * d1 - Gat * d2;
					parameter<Float64> M11    := sum(w * w * d1 * d1 * r * r);
					parameter<Float64> M12    := sum(w * w * d1 * d2 * r * r);
					parameter<Float64> M22    := sum(w * w * d2 * d2 * r * r);
					parameter<Float64> Hc1    := float64(N) / (float64(N) - 3d);
					parameter<Float64> Se_Eps := sqrt((A11 * A11 * M11 + 2d * A11 * A12 * M12 + A12 * A12 * M22) * Hc1);
					parameter<Float64> Se_Gat := sqrt((A12 * A12 * M11 + 2d * A12 * A22 * M12 + A22 * A22 * M22) * Hc1);
					parameter<Float64> R2     := 1d - sum(w * r * r) / Syy;
				}

				Template Persistentie_T
				: Descr = "De rest van een deelperiode is de verandering van het banenaandeel min die van het woningaandeel, dus wat een regio groeit boven een elasticiteit van 1. Correlatie en
							Helling meten met de banen in het beginjaar als gewicht of de rest van de tweede deelperiode die van de eerste volgt."
				{
					parameter<String> Subsector_name;
					//

					parameter<String>  J0    := 'Y'+string(Beginjaar);
					parameter<String>  J1    := 'Y'+string(Middenjaar);
					parameter<String>  J2    := 'Y'+string(Eindjaar);
					attribute<Float64> E0    (Regio) := ='Banen/'+J0+'_'+Subsector_name;
					attribute<Float64> E1    (Regio) := ='Banen/'+J1+'_'+Subsector_name;
					attribute<Float64> E2    (Regio) := ='Banen/'+J2+'_'+Subsector_name;
					attribute<Float64> W0    (Regio) := ='Woningen/'+J0;
					attribute<Float64> W1    (Regio) := ='Woningen/'+J1;
					attribute<Float64> W2    (Regio) := ='Woningen/'+J2;
					attribute<Bool>    Telt  (Regio) := E0 > Drempel && E1 > Drempel && E2 > Drempel && W0 > 0d && W1 > 0d && W2 > 0d;
					attribute<Float64> Rest1 (Regio) := Telt ? log((E1 / sum(E1)) / (E0 / sum(E0))) - log((W1 / sum(W1)) / (W0 / sum(W0))) : 0d;
					attribute<Float64> Rest2 (Regio) := Telt ? log((E2 / sum(E2)) / (E1 / sum(E1))) - log((W2 / sum(W2)) / (W1 / sum(W1))) : 0d;
					attribute<Float64> w     (Regio) := Telt ? E0 : 0d;

					parameter<UInt32>  N     := sum(uint32(Telt));
					attribute<Float64> d1    (Regio) := Telt ? Rest1 - sum(w * Rest1) / sum(w) : 0d;
					attribute<Float64> d2    (Regio) := Telt ? Rest2 - sum(w * Rest2) / sum(w) : 0d;
					parameter<Float64> S11   := sum(w * d1 * d1);
					parameter<Float64> S12   := sum(w * d1 * d2);
					parameter<Float64> S22   := sum(w * d2 * d2);
					parameter<Float64> Correlatie := S12 / sqrt(S11 * S22);
					parameter<Float64> Helling    := S12 / S11;
				}
			}
		}
	}
}
