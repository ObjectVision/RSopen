////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Tijdelijk controle-harnas voor #639. Elke regel in de tabel Checks wordt een parameter die zijn waarde naar
// een tekstbestand schrijft, zodat de uitkomsten buiten de GUI leesbaar zijn en een run in de batch te
// beoordelen is. Casus en zichtjaar komen uit de omgevingsvariabelen DiagCasus en DiagJaar.
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container Diagnose
: Descr = "Tijdelijk controle-harnas voor #639: schrijft de waarde van een set indicatoren naar losse tekstbestanden."
{
	parameter<String> Casus   := replace_value(expand(., '%env:DiagCasus%'), 'env:DiagCasus', 'WLO_hoog_NbSGenuanceerd');
	parameter<String> Jaar    := =replace_value(expand(., '%env:DiagJaar%'),  'env:DiagJaar',  quote('Y'+string(ModelParameters/Model_FirstZichtjaar)))
	, Descr = "Het zichtjaar waarover de controlewaarden gaan. Zonder de omgevingsvariabele DiagJaar valt hij terug op het eerste zichtjaar van de allocatie. Die default was hard op Y2030 gezet en klopte niet meer sinds Model_FirstZichtjaar met #658 instelbaar werd.";
	parameter<String> Variant := replace(Casus, 'WLO_hoog_', '');

	parameter<String> Pad_Z := '/Indicatoren/'+Casus+'/Zichtjaren/'+Jaar+'/';
	parameter<String> Pad_V := '/VariantData/'+Variant+'/';
	parameter<String> Pad_A := '/Allocatie/'+Casus+'/Zichtjaren/'+Jaar+'/';

	unit<uint32> Checks : nrofrows = 43
	{
		//                        pad, aggregatie, item
		//   pad: Z = onder het zichtjaar van de indicatoren, V = variantdata, A = allocatie
		//   aggr: p = parameter, s = som over grid, b = aantal cellen waar waar, c = aantal gevulde cellen, l = lijst per regio, m = maximum
		attribute<String> name :
		[
			 'stand_woningen', 'stand_banen'
			,'claimreal_NL_woningen', 'claimreal_NL_banen'
			,'claimreal_NVM_woningen', 'claimreal_Provincie_banen', 'claimreal_Waterberging'
			,'verstedelijking_ha', 'verstedelijking_vruchtbaar_ha'
			,'nieuwenatuur_ha', 'nieuwenatuur_vruchtbaar_ha', 'verdwenennatuur_ha'
			,'waterbergingveen_ha', 'waterbergingveen_vruchtbaar_ha'
			,'inbreiding_fractie', 'verharding_som', 'lu2120_areaal_natuur'
			,'woningwaarde_nieuwbouw', 'groenwaarde_woningen'
			,'uitkoop_nieuwenatuur', 'sloop_nieuwenatuur'
			,'uitkoop_waterberging', 'sloop_waterberging'
			,'mortaliteit', 'carbon_flow', 'somers_mediaan'
			,'nietbouwen_landschap_cellen', 'sloop_opslot_geen_natuur_woningen', 'exogeen_cellen'
			,'groenopslag_max', 'groenopslag_min'
			,'exogeen_gespaard_ha', 'exogeen_gespaard_woningen'
			,'sloop_natuur_niet_opslot_woningen', 'sloop_opslot_geen_natuur_ha', 'sloop_natuur_niet_opslot_ha'
			,'sloop_opslot_zonder_sloopbedoeling', 'sloop_zonder_masker'
			,'sloop_zondermasker_veen', 'sloop_zondermasker_buiten'
			,'sloop_opslot_geen_natuur_veen', 'sloop_opslot_geen_natuur_kust', 'sloop_opslot_geen_natuur_rivieren'
		];

		attribute<String> pad :
		[
			 'Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z'
			,'Z','Z','Z'
			,'V','V','V'
			,'A','A'
			,'V','V'
			,'V','V','V'
			,'V','V'
			,'V','V'
			,'V','V','V'
		];

		attribute<String> aggr :
		[
			 's','s'
			,'s','s'
			,'l','l','l'
			,'p','p'
			,'p','p','p'
			,'p','p'
			,'p','s','p'
			,'s','s'
			,'s','s'
			,'s','s'
			,'p','s','s'
			,'b','p','p'
			,'m','n'
			,'p','p'
			,'p','p','p'
			,'p','p'
			,'p','p'
			,'p','p','p'
		];

		attribute<String> item :
		[
			 'Stand/Aantal_Woningen_Totaal', 'Stand/Aantal_Banen_Totaal'
			,'ClaimRealisatie/Per_AllocRegio/Nederland/InDezeStudie/Aantal_Woningen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Nederland/InDezeStudie/Banen_Totaal'
			,'ClaimRealisatie/Per_AllocRegio/NVM/InDezeStudie/Aantal_Woningen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Provincie/InDezeStudie/Banen_Totaal', 'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/InDezeStudie/meter3_Waterberging'
			,'Grondgebruik/Verandering/Verstedelijking/Per_NL', 'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_NL'
			,'Grondgebruik/Verandering/NieuweNatuur/Per_NL', 'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_NL', 'Grondgebruik/Verandering/VerdwenenNatuur/Per_NL'
			,'Grondgebruik/Verandering/WaterbergingVeen/Per_NL', 'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_NL'
			,'Inbreiding/FractieWoningenErbijInBestaandBebouwdGebied', 'Verharding/Result', 'LandgebruikskaartNL2120/Areaal_Natuur'
			,'Woningwaarde/Nieuwbouw', 'WaardeNabijheidGroen/WaardeVeranderingDoorGroenVerandering_Woningen'
			,'SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten', 'SloopAlsGevolgVanNieuweNatuur/Sloopkosten'
			,'SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten', 'SloopAlsGevolgVanWaterbergingVeen/Sloopkosten'
			,'SterfteAfnameDoorGroenToename/Zichtjaar/Sterfte/AfnameCumulatief_Totaal', 'CarbonStorageSequestration/Write_CO2Flow_TovBasisjaar', 'SOMERS_CO2_laagveen/Emissies/Mediaan/Write_Result_SA'
			,'Bouwregime/OpSlotDoorLandschap', 'Sloop/Verschil/Woningen_OpSlotMaarGeenNatuur', 'ExogeenOpleggen/CountCellenOplegging'
			,'GroenNabijheid/Prijsopslag_perWP4/vrijstaand', 'GroenNabijheid/Prijsopslag_perWP4/vrijstaand'
			,'ExogeenOpleggen/Opp_GespaardInBebouwdGebied', 'ExogeenOpleggen/Woningen_GespaardInBebouwdGebied'
			,'Sloop/Verschil/Woningen_NatuurMaarNietOpSlot', 'Sloop/Verschil/Opp_OpSlotMaarGeenNatuur', 'Sloop/Verschil/Opp_NatuurMaarNietOpSlot'
			,'Sloop/Verschil/Woningen_OpSlotZonderSloopbedoeling', 'Sloop/Verschil/Woningen_ZonderMasker'
			,'Sloop/Verschil/Woningen_ZonderMasker_InVeenlevering', 'Sloop/Verschil/Woningen_ZonderMasker_Buiten'
			,'Sloop/Verschil/Woningen_Veen', 'Sloop/Verschil/Woningen_Kust', 'Sloop/Verschil/Woningen_Rivieren'
		];
	}

	container Resultaten :=
		for_each_ne(
			Checks/name
			, 'Check_T('+quote(Checks/name)+', '+quote(Checks/pad)+', '+quote(Checks/aggr)+', '+quote(Checks/item)+')'
		);

	parameter<String> GenerateAll := 'Klaar', ExplicitSuppliers = "=AsList('Resultaten/'+Checks/name+'/Waarde', ';')";

	Template Check_T
	{
		parameter<String> naam;
		parameter<String> pad;
		parameter<String> aggr;
		parameter<String> item;
		//

		parameter<String> VolPad := (pad == 'Z' ? /Diagnose/Pad_Z : pad == 'V' ? /Diagnose/Pad_V : /Diagnose/Pad_A) + item;

		parameter<String> Expr :=
			  aggr == 'p' ? 'string(value('+VolPad+', float32))'
			: aggr == 's' ? 'string(sum(value('+VolPad+', float32)))'
			: aggr == 'b' ? 'string(sum(uint32('+VolPad+')))'
			: aggr == 'c' ? 'string(sum(uint32(IsDefined('+VolPad+'))))'
			: aggr == 'm' ? 'string(max(value('+VolPad+', float32)))'
			: aggr == 'n' ? 'string(min(value('+VolPad+', float32)))'
			: 'AsList(string(value('+VolPad+', float32)), ('+quote(';')+'))';

		parameter<String> Waarde := =Expr
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_'+naam+'.txt'"
		, StorageType = "str";
	}
	parameter<String> NVM_namen := AsList(/SourceData/RegioIndelingen/NVM/name, ';')
	, StorageName = "='%LocalDataProjDir%/Diagnose/NVM_namen.txt'"
	, StorageType = "str";

	parameter<String> waterbergingsregio_namen := AsList(/SourceData/RegioIndelingen/Waterbergingsregio/label + ';' + string(/SourceData/RegioIndelingen/Waterbergingsregio/IsRestRegio), '|')
	, StorageName = "='%LocalDataProjDir%/Diagnose/waterbergingsregio_namen.txt'"
	, StorageType = "str"
	, Descr = "De negen waterbergingsregio's in de volgorde van de unit, dus de volgorde van de shapefile met de restregio erachter, plus de vlag die zegt welke de restregio is. Nodig om claimreal_Waterberging te kunnen lezen: die uitdraai gebruikt AsList en dat slaat de null-waarden over, dus een regio zonder opgave verschijnt er niet in en de posities schuiven op. Zonder deze lijst is niet te zeggen welke regio bij welk getal hoort.";

	parameter<String> waterberging_perregio := =('
		  '+quote('regio;opgave_m3;gerealiseerd_m3|')+' + AsList(
			/SourceData/RegioIndelingen/Waterbergingsregio/label + '+quote(';')+'
			+ string('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/MaxClaims/meter3_Waterberging) + '+quote(';')+'
			+ string('+Pad_Z+'ClaimRealisatie/Per_AllocRegio/Waterbergingsregio/Impl/Stand_PerAllocRegio/meter3_Waterberging), '+quote('|')+')
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_waterberging_perregio.txt'"
	, StorageType = "str"
	, Descr = "De opgave en het gerealiseerde volume per waterbergingsregio, met de naam erbij. claimreal_Waterberging geeft alleen de verhouding en laat via AsList de regio's zonder opgave weg, dus daar is niet uit te lezen welke regio welk getal heeft en hoe groot de opgave daar is. Deze uitdraai wel.";

	parameter<String> gesloopt_natuur := =('string('+Pad_Z+'SloopAlsGevolgVanNieuweNatuur/GesloopteWoningen_Per_NL)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_gesloopt_natuur.txt'"
	, StorageType = "str";

	parameter<String> gesloopt_waterberging := =('string('+Pad_Z+'SloopAlsGevolgVanWaterbergingVeen/GesloopteWoningen_Per_NL)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_gesloopt_waterberging.txt'"
	, StorageType = "str";

	parameter<String> gesloopt_bouwstenen := =('string('+Pad_Z+'SloopAlsGevolgVanOverigeBouwstenen/GesloopteWoningen_Per_NL)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_gesloopt_bouwstenen.txt'"
	, StorageType = "str";

	parameter<String> gesloopt_woningen_drieluik := =('
		  '+quote('oorzaak;woningen;banen;uitkoop_eur;sloop_eur')+'
		+ '+quote('|nieuwe_natuur;')+'      + string('+Pad_Z+'SloopAlsGevolgVanNieuweNatuur/GesloopteWoningen_Per_NL)      + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanNieuweNatuur/GesloopteBanen_Per_NL)      + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanNieuweNatuur/Uitkoopkosten_Per_NL)      + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanNieuweNatuur/Sloopkosten_Per_NL)
		+ '+quote('|waterberging_veen;')+'  + string('+Pad_Z+'SloopAlsGevolgVanWaterbergingVeen/GesloopteWoningen_Per_NL)  + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanWaterbergingVeen/GesloopteBanen_Per_NL)  + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanWaterbergingVeen/Uitkoopkosten_Per_NL)  + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanWaterbergingVeen/Sloopkosten_Per_NL)
		+ '+quote('|overige_bouwstenen;')+' + string('+Pad_Z+'SloopAlsGevolgVanOverigeBouwstenen/GesloopteWoningen_Per_NL) + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanOverigeBouwstenen/GesloopteBanen_Per_NL) + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanOverigeBouwstenen/Uitkoopkosten_Per_NL) + '+quote(';')+' + string('+Pad_Z+'SloopAlsGevolgVanOverigeBouwstenen/Sloopkosten_Per_NL)
		+ '+quote('|totaal;')+'             + string('+Pad_Z+'SloopTotaal/GesloopteWoningen_Per_NL)                        + '+quote(';')+' + string('+Pad_Z+'SloopTotaal/GesloopteBanen_Per_NL)                        + '+quote(';')+' + string('+Pad_Z+'SloopTotaal/Uitkoopkosten_Per_NL)                        + '+quote(';')+' + string('+Pad_Z+'SloopTotaal/Sloopkosten_Per_NL)
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_sloop_drieluik.txt'"
	, StorageType = "str"
	, Descr = "De drie sloopoorzaken uit #658 op een rij, met de woningen, de banen en de twee kostenposten. De totaalregel hoort de som van de drie te zijn; de IntegrityCheck op Sloopmaskers/AantalOorzaken bewaakt dat er geen cel dubbel telt.";

	// --- inbreiding: teller en noemer los, plus de omvang van het BBG-masker ---
	parameter<String> inbr_teller := =('string(sum('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar * float32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_inbr_teller.txt'", StorageType = "str";

	parameter<String> inbr_noemer := =('string(sum('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_inbr_noemer.txt'", StorageType = "str";

	parameter<String> inbr_bbg_cellen := =('string(sum(uint32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_inbr_bbg_cellen.txt'", StorageType = "str";

	// --- waterberging: hoeveel is er cumulatief afgewezen wegens clusteromvang ---
	parameter<String> wb_pad := '/Allocatie/'+Casus+'/Zichtjaren/'+Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_14/Allocatie/';

	parameter<String> wb_afgewezen := =('string(sum(uint32('+wb_pad+'IsAfgewezen_Cumulatief)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_afgewezen.txt'", StorageType = "str";

	parameter<String> wb_grootgenoeg := =('string(sum(uint32('+wb_pad+'IsAllocGroupLargeEnough)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_grootgenoeg.txt'", StorageType = "str";

	// --- inbreiding bruto: gebouwd en gesloopt binnen BBG apart ---
	parameter<String> inbr_bruto_bij_bbg := =('string(sum(max_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_inbr_bruto_bij_bbg.txt'", StorageType = "str";

	parameter<String> inbr_bruto_af_bbg := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32('+Pad_Z+'Inbreiding/BestaandBebouwdGebied)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_inbr_bruto_af_bbg.txt'", StorageType = "str";

	parameter<String> inbr_bruto_bij_nl := =('string(sum(max_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_inbr_bruto_bij_nl.txt'", StorageType = "str";

	// --- sloop uitgesplitst naar oorzaak (voorstel Jip): exogeen, gealloceerd, rest ---
	parameter<String> sloop_exogeen := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32('+Pad_Z+'Sloopmaskers/WordtGesloopt)))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_sloop_exogeen.txt'", StorageType = "str";

	parameter<String> sloop_gealloceerd := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32(!'+Pad_Z+'Sloopmaskers/WordtGesloopt && IsDefined('+Pad_Z+'Stand/Sector_rel))))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_sloop_gealloceerd.txt'", StorageType = "str";

	parameter<String> sloop_rest := =('string(sum(min_elem('+Pad_Z+'Inbreiding/Aantal_Woningen_Totaal_BijTovBasisjaar, 0f) * float32(!'+Pad_Z+'Sloopmaskers/WordtGesloopt && !IsDefined('+Pad_Z+'Stand/Sector_rel))))')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_sloop_rest.txt'", StorageType = "str";

	// --- clusteranalyse waterberging, los van de allocatie ---
	container WaterbergingClusters
	: Descr = "Aaneengesloten beschikbaar areaal voor waterberging binnen de veen-deelgebieden, met dezelfde district_8-methode als de allocatie maar zonder die te herrekenen."
	{
		attribute<Bool> IsVeenDeelgebied (/Geography/AdminDomain) :=
			MakeDefined(!/SourceData/RegioIndelingen/Waterbergingsregio/IsRestRegio[/SourceData/RegioIndelingen/Waterbergingsregio/Per_AdminDomain], FALSE);

		attribute<Bool> Beschikbaar_Compacted (/Geography/CompactedAdminDomain) :=
			=/Diagnose/Pad_V+'PotentieleState/'+/Diagnose/Jaar+'/per_SectorxSubsectoren/Waterberging/Totaal/IsBeschikbaar_zichtjaar';

		attribute<Bool> Beschikbaar (/Geography/AdminDomain) :=
			MakeDefined(recollect_by_cond(/Geography/AdminDomain/IsCompactedDomain, Beschikbaar_Compacted), FALSE) && IsVeenDeelgebied;

		unit<uint32> Clusters := district_8(Beschikbaar)
		{
			attribute<float32> Oppervlakte_ha (/Geography/AdminDomain) :=
				(pcount(Districts)[float32] * float32(/Geography/AdminDomain/NrHaPerCell))[Districts];
		}

		parameter<float32> HaPerCel        := float32(/Geography/AdminDomain/NrHaPerCell);
		parameter<float32> Areaal_totaal   := sum(float32(Beschikbaar)) * HaPerCel;
		parameter<float32> Areaal_vanaf2ha := sum(float32(Beschikbaar && Clusters/Oppervlakte_ha >= 2f)) * HaPerCel;
		parameter<float32> Areaal_onder2ha := sum(float32(Beschikbaar && Clusters/Oppervlakte_ha <  2f)) * HaPerCel;
		parameter<float32> Grootste_cluster := max(Clusters/Oppervlakte_ha);

		parameter<String> Samenvatting :=
			  'beschikbaar_totaal_ha;'  + string(Areaal_totaal)
			+ ';beschikbaar_vanaf2ha;'  + string(Areaal_vanaf2ha)
			+ ';beschikbaar_onder2ha;'  + string(Areaal_onder2ha)
			+ ';grootste_cluster_ha;'   + string(Grootste_cluster)
			+ ';aantal_clusters;'       + string(#Clusters)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_clusters.txt'", StorageType = "str";
	}

	// --- bebouwd gebied: nieuwe begrenzing tegenover de oude unie ---
	parameter<String> bbg_nieuw_cellen := 'x'
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_bbg_nieuw_cellen.txt'", StorageType = "str";

	parameter<String> bbg_vergelijk :=
		  'nieuw_cellen;'   + string(sum(uint32(/BaseData/Omgeving/BBGSamengesteld)))
		+ ';oud_cellen;'    + string(sum(uint32(/BaseData/Omgeving/BBGSamengesteld_Unie)))
		+ ';nieuw_ha;'      + string(sum(float32(/BaseData/Omgeving/BBGSamengesteld)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ ';oud_ha;'        + string(sum(float32(/BaseData/Omgeving/BBGSamengesteld_Unie)) * float32(/Geography/AdminDomain/NrHaPerCell))
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_bbg_vergelijk.txt'", StorageType = "str";

	// --- claimvintage: was de claim al gehaald voor de allocatie begon? ---
	parameter<String> restclaim_pad := Pad_A + 'StateVoorAllocatie/RestClaims/';

	parameter<String> restclaim_wonen := =('
		  '+quote('nr_regios;')+' + string('+restclaim_pad+'Wonen/NrRegios)
		+ '+quote(';al_gehaald_voor_alloc;')+' + string('+restclaim_pad+'Wonen/NrRegiosAlGehaald)
		+ '+quote(';restclaim_totaal;')+' + string(sum('+restclaim_pad+'Wonen/Totaal_RestClaim))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_restclaim_wonen.txt'", StorageType = "str";

	parameter<String> restclaim_werken := =('
		  '+quote('nr_regios;')+' + string('+restclaim_pad+'Werken/NrRegios)
		+ '+quote(';al_gehaald_voor_alloc;')+' + string('+restclaim_pad+'Werken/NrRegiosAlGehaald)
		+ '+quote(';restclaim_totaal;')+' + string(sum('+restclaim_pad+'Werken/Totaal_RestClaim))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_restclaim_werken.txt'", StorageType = "str";

	// --- restclaim per NVM-regio, om vintage van lek te scheiden ---
	parameter<String> restclaim_wonen_perregio := =('AsList(string('+restclaim_pad+'Wonen/Totaal_RestClaim), '+quote(';')+')')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_restclaim_wonen_perregio.txt'", StorageType = "str";

	parameter<String> restclaim_werken_perregio := =('AsList(string('+restclaim_pad+'Werken/Totaal_RestClaim), '+quote(';')+')')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_restclaim_werken_perregio.txt'", StorageType = "str";

	// --- de claimrealisatietoets zelf uitlezen ---
	parameter<String> claimtoets := =('
		  '+quote('regios;')+'      + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_Regios)
		+ '+quote(';al_gehaald;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_AlGehaald)
		+ '+quote(';telt_mee;')+'    + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_TeltMee)
		+ '+quote(';op_norm;')+'     + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_OpNorm)
		+ '+quote(';onder_norm;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_OnderNorm)
		+ '+quote(';boven_norm;')+'  + string('+Pad_Z+'ClaimRealisatie_Toets/Nr_BovenNorm)
		+ '+quote(';tekort;')+'      + string('+Pad_Z+'ClaimRealisatie_Toets/Tekort_woningen)
		+ '+quote(';overschot;')+'   + string('+Pad_Z+'ClaimRealisatie_Toets/Overschot_woningen)
		+ '+quote(';saldo;')+'       + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_woningen)
		+ '+quote(';saldo_algehaald;')+' + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_AlGehaald)
		+ '+quote(';saldo_alles;')+'     + string('+Pad_Z+'ClaimRealisatie_Toets/Saldo_Alles)
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_claimtoets.txt'", StorageType = "str";

	// --- grondbalans: sluit de verdwenen landbouw op de nieuwe bestemmingen? ---
	parameter<String> grondbalans := =('
		  '+quote('verdwenen_landbouw_ha;')+'    + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';verdwenen_vruchtbaar_ha;')+' + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_grondbalans.txt'", StorageType = "str";

	// --- waterberging: past de opgave uberhaupt in het beschikbare bergingsvolume? ---
	container WaterbergingVolume
	: Descr = "Per waterbergingsregio de opgave in m3 naast het bergingsvolume dat in alle beschikbare cellen samen zit. Dat volume is precies het gewicht waarmee IterSubsector_T de zaaglijn bepaalt: nth_element_weighted telt cellen op in volgorde van geschiktheid tot het gewicht de restclaim haalt. Is de som over alle beschikbare cellen kleiner dan de opgave, dan wordt de zaaglijn undefined, valt hij terug op 0, wordt alles gealloceerd en blijft de realisatie per definitie onder 1. Meer iteraties helpen dan niet. Deze container rekent de allocatie niet mee."
	{
		unit<uint32> Regio := /SourceData/RegioIndelingen/Waterbergingsregio;

		parameter<String> Scenario := replace(/Diagnose/Casus, '_'+/Diagnose/Variant, '')
		, Descr = "De casusnaam zonder de variantnaam, dus het scenario waaronder de claims hangen.";

		attribute<float32> Volume_perCel (/Geography/CompactedAdminDomain) :=
			=/Diagnose/Pad_V+'PotentieleState/'+/Diagnose/Jaar+'/per_SectorxSubsectoren/Waterberging/Totaal/Zichtjaar'
		, Descr = "Bergingsvolume in m3 per cel, al vermenigvuldigd met de beschikbaarheid in dit zichtjaar.";

		attribute<bool> IsDiepGenoeg (/Geography/CompactedAdminDomain) :=
			collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg)
		, Descr = "Haalt de cel de Minimum_Waterschijf? Zo niet, dan is de geschiktheid exact 0 en staat de cel onderaan de rij, maar hij blijft alloceerbaar.";

		attribute<Regio> Regio_rel (/Geography/CompactedAdminDomain) := /SourceData/RegioIndelingen/Waterbergingsregio/Per_CompactedAdminDomain;

		attribute<float32> Claim_m3       (Regio) := =/Diagnose/Pad_V+'Claims/'+/Diagnose/WaterbergingVolume/Scenario+'/Zichtjaren/'+/Diagnose/Jaar+'/SectorAllocRegios/Waterbergingsregio_Waterberging/Totaal';
		attribute<float32> Volume_m3      (Regio) := sum(Volume_perCel, Regio_rel);
		attribute<float32> Volume_diep_m3 (Regio) := sum(Volume_perCel * float32(IsDiepGenoeg), Regio_rel)
		, Descr = "Alleen de cellen met een waterschijf vanaf Minimum_Waterschijf, dus de cellen met een geschiktheid boven nul.";
		attribute<float32> Cellen         (Regio) := sum(float32(Volume_perCel > 0f), Regio_rel);
		attribute<float32> Dekking        (Regio) := Volume_m3 / Claim_m3;
		attribute<float32> Dekking_diep   (Regio) := Volume_diep_m3 / Claim_m3;

		attribute<float32> Cellen_totaal (Regio) := sum(float32(IsDefined(Regio_rel)), Regio_rel)
		, Descr = "Alle cellen in de regio, ongeacht beschikbaarheid, zodat een lege regio te onderscheiden is van een regio zonder beschikbare cellen.";

		attribute<String> Regel (Regio) :=
			MakeDefined(Regio/label, 'null') + ';' + string(MakeDefined(Claim_m3, -1f)) + ';' + string(MakeDefined(Volume_m3, -1f)) + ';' + string(MakeDefined(Volume_diep_m3, -1f))
			+ ';' + string(MakeDefined(Cellen, -1f)) + ';' + string(MakeDefined(Cellen_totaal, -1f)) + ';' + string(MakeDefined(Dekking, -1f));

		parameter<String> Samenvatting :=
			'regio;claim_m3;volume_m3;volume_diep_m3;cellen_beschikbaar;cellen_totaal;dekking|' + AsList(Regel, '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_volume.txt'", StorageType = "str";
	}

	// --- waterberging: convergeert de allocatie binnen het aantal iteraties? ---
	container WaterbergingIteraties
	: Descr = "Per iteratie de landelijke stand waterberging in m3 en het aantal cumulatief afgewezen cellen. Ligt de reeks aan het eind vlak, dan is het aantal iteraties niet de beperking en zit de rem in de morfologische cleaning en de minimale clusteromvang. Stijgt hij aan het eind nog, dan helpt ophogen van Default_NrOfIters wel. Het aantal iteraties volgt Default_NrOfIters, zodat deze container meebeweegt met de instelling die getest wordt."
	{
		parameter<String> PadIter := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/';

		unit<uint8> Iters := range(uint8, 0b, /ModelParameters/Default_NrOfIters)
		{
			attribute<String> name := 'Iter_'+string(id(.));
			attribute<String> expr :=
				  quote(name+';')
				+ ' + string(sum('+PadIter+name+'/Stand_PerAllocRegio/Waterberging/Totaal))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen_Cumulatief)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector))))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen)))'
				+ ' + ' + quote('|');
		}

		parameter<String> Samenvatting := =quote('iter;stand_m3;afgewezen_cumulatief;gealloceerd_deze_iter;afgewezen_deze_iter|')+' + '+AsList(Iters/expr, ' + ')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_convergentie.txt'", StorageType = "str";
	}

	// --- verharding: welke Copernicus-kaart is actief, en verschilt 2024 van 2021? ---
	parameter<String> imperviousness :=
		  'jaar;'        + /ModelParameters/Advanced/ImperviousnessMapYear
		+ ';gem_2021;'   + string(mean(float32(/SourceData/Grondgebruik/Imperviousness_Map/Y2021_25m)))
		+ ';gem_2024;'   + string(mean(float32(/SourceData/Grondgebruik/Imperviousness_Map/Y2024_25m)))
		+ ';gem_actief;' + string(mean(float32(/SourceData/Grondgebruik/Imperviousness_Map/InProcent)))
		+ ';verhardingsbestand;' + /Classifications/Grondgebruik/BGT/Classes/Verharding_Impl/VerhardingFile
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_imperviousness.txt'", StorageType = "str"
	, Descr = "Controle op de jaarschakelaar van de Copernicus-verhardingskaart. gem_actief hoort gelijk te zijn aan het jaar dat in ModelParameters/Advanced/ImperviousnessMapYear staat.";

	// --- waterberging: hoe versnipperd is wat de zaaglijn uitkiest? ---
	container WaterbergingClusterVerdeling
	: Descr = "Verdeling van de gealloceerde cellen over clustergroottes in iteratie 0, dus wat de zaaglijn uitkiest voordat de toets op clusteromvang er iets van weggooit. Leest de districten die de allocatie zelf al bepaalt. Hiermee is te zien of de ondergrens van 2 ha te hoog is of dat de selectie versnipperd is."
	{
		parameter<String> PadIter0 := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_0/Allocatie/';

		attribute<Bool>    Gealloceerd (/Geography/AdminDomain) := =PadIter0+'Cleaned';
		attribute<float32> ClusterOpp  (/Geography/AdminDomain) := =PadIter0+'VindAangeslotenCellen/Oppervlakte';

		parameter<float32> HaPerCel := float32(/Geography/AdminDomain/NrHaPerCell);

		parameter<float32> Totaal_ha    := sum(float32(Gealloceerd)) * HaPerCel;
		parameter<float32> Onder04_ha   := sum(float32(Gealloceerd && ClusterOpp <  0.4f)) * HaPerCel;
		parameter<float32> Van04tot1_ha := sum(float32(Gealloceerd && ClusterOpp >= 0.4f && ClusterOpp < 1f)) * HaPerCel;
		parameter<float32> Van1tot2_ha  := sum(float32(Gealloceerd && ClusterOpp >= 1f   && ClusterOpp < 2f)) * HaPerCel;
		parameter<float32> Vanaf2_ha    := sum(float32(Gealloceerd && ClusterOpp >= 2f)) * HaPerCel;
		parameter<float32> Grootste_ha  := max(ClusterOpp * float32(Gealloceerd));

		parameter<String> Samenvatting :=
			  'gealloceerd_ha;'   + string(Totaal_ha)
			+ ';onder_0,4ha;'     + string(Onder04_ha)
			+ ';0,4_tot_1ha;'     + string(Van04tot1_ha)
			+ ';1_tot_2ha;'       + string(Van1tot2_ha)
			+ ';vanaf_2ha;'       + string(Vanaf2_ha)
			+ ';grootste_cluster_ha;' + string(Grootste_ha)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_clusterverdeling.txt'", StorageType = "str";
	}

	// --- waterberging: zit de gerealiseerde berging wel in cellen die diep genoeg zijn? ---
	container WaterbergingDiepte
	: Descr = "Splitst de gerealiseerde berging naar cellen die de Minimum_Waterschijf wel en niet halen. Cellen die hem niet halen krijgen geschiktheid 0, maar dat sluit ze niet uit; ze tellen wel met hun volle volume mee in de claimrealisatie. Wat hier bij te_ondiep staat is berging die op papier meetelt maar er fysiek niet in past."
	{
		parameter<String> PadLaatste := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/Waterbergingsregio_Waterberging/Iters_Normaal/Iter_'+string(/ModelParameters/Default_NrOfIters - 1b)+'/';

		attribute<float32> Stand        (/Geography/CompactedAdminDomain) := =PadLaatste+'StateNaAllocatie/Waterberging/Totaal';
		attribute<bool>    IsDiepGenoeg (/Geography/CompactedAdminDomain) :=
			collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /BaseData/Suitabilities/Waterberging/IsDiepGenoeg);

		parameter<float32> HaPerCel := float32(/Geography/AdminDomain/NrHaPerCell);

		parameter<String> Samenvatting :=
			  'totaal_m3;'      + string(sum(Stand))
			+ ';diep_genoeg_m3;'+ string(sum(Stand * float32(IsDiepGenoeg)))
			+ ';te_ondiep_m3;'  + string(sum(Stand * float32(!IsDiepGenoeg)))
			+ ';totaal_ha;'     + string(sum(float32(Stand > 0f)) * HaPerCel)
			+ ';te_ondiep_ha;'  + string(sum(float32(Stand > 0f && !IsDiepGenoeg)) * HaPerCel)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wb_diepte.txt'", StorageType = "str";
	}

	// --- claimrealisatie werken per Jobs6-subsector, en de grondbalans na de #634-correctie ---
	parameter<String> claimtoets_werken := =('string('+Pad_Z+'ClaimRealisatie_Toets_Werken/Samenvatting)')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_claimtoets_werken.txt'", StorageType = "str";

	parameter<String> grondbalans_bestemmingen := =('
		  '+quote('verdwenen_vruchtbaar_ha;')+'      + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerdwenenVruchtbareLandbouw)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';verstedelijking_vruchtbaar_ha;')+' + string('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden/Per_NL)
		+ '+quote(';nieuwenatuur_vruchtbaar_ha;')+'    + string('+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden/Per_NL)
		+ '+quote(';waterberging_vruchtbaar_ha;')+'    + string('+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden/Per_NL)
		+ '+quote(';overlap_verst_natuur_ha;')+'      + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';overlap_verst_wb_ha;')+'          + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/VerstedelijkingOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
		+ '+quote(';overlap_natuur_wb_ha;')+'         + string(sum(float32('+Pad_Z+'Grondgebruik/Verandering/NieuweNatuurOpVruchtbareLandbouwgronden && '+Pad_Z+'Grondgebruik/Verandering/WaterbergingVeenOpVruchtbareLandbouwgronden)) * float32(/Geography/AdminDomain/NrHaPerCell))
	')
	, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_grondbalans_bestemmingen.txt'", StorageType = "str"
	, Descr = "Sluit de verdwenen vruchtbare landbouw op de drie bestemmingen? Met de oude definitie (klasse A, ongeacht vorig gebruik) telden de bestemmingen samen op tot meer dan het verlies. Zie #634.";

	// --- wonen: doet de clustertoets hetzelfde als bij waterberging? ---
	container WonenIteraties
	: Descr = "Per iteratie de stand woningen, het aantal gealloceerde en afgewezen cellen, en de splitsing binnenstedelijk tegen buitenstedelijk. Bedoeld om te zien of de vormtoetsen bij wonen dezelfde rem vormen als bij waterberging: kan een cluster aangroeien, en vallen binnenstedelijke locaties vaker af. Draai dit met alleen de regel Wonen op NVM in ModelParameters/SectorAllocRegio."
	{
		parameter<String> PadIter := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/NVM_Wonen/Iters_Normaal/';

		unit<uint8> Iters := range(uint8, 0b, /ModelParameters/Default_NrOfIters)
		{
			attribute<String> name := 'Iter_'+string(id(.));
			attribute<String> expr :=
				  quote(name+';')
				+ ' + string(sum('+PadIter+name+'/Stand_PerAllocRegio/wonen/Aantal_Woningen_Totaal))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector))))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen_Cumulatief)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector) && collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain))))'
				+ ' + ' + quote('|');
		}

		parameter<String> Samenvatting := =quote('iter;stand_woningen;gealloceerd;afgewezen_deze_iter;afgewezen_cumulatief;gealloceerd_in_woonkern|')+' + '+AsList(Iters/expr, ' + ')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_wonen_convergentie.txt'", StorageType = "str";
	}

	// --- werken: dezelfde meting als bij wonen ---
	container WerkenIteraties
	: Descr = "Per iteratie de stand banen, het aantal gealloceerde en afgewezen cellen, en de splitsing binnenstedelijk tegen buitenstedelijk, voor de regel Werken op NVM. Draai dit met alleen die regel in ModelParameters/SectorAllocRegio. Zie #643."
	{
		parameter<String> PadIter := '/Allocatie/'+/Diagnose/Casus+'/Zichtjaren/'+/Diagnose/Jaar+'/Sequences/Seq_0/SectorAllocRegios/NVM_Werken/Iters_Normaal/';
		parameter<String> StandExpr := 'add('+AsList('@P@Stand_PerAllocRegio/Werken/'+/Classifications/Actor/Jobs6/name, ', ')+')'
		, Descr = "Som over de zes Jobs6-subsectoren. @P@ is de plek waar het iteratiepad in komt; dat hoort per item en niet voor de add.";

		unit<uint8> Iters := range(uint8, 0b, /ModelParameters/Default_NrOfIters)
		{
			attribute<String> name := 'Iter_'+string(id(.));
			attribute<String> expr :=
				  quote(name+';')
				+ ' + string(sum('+replace(StandExpr, '@P@', PadIter+name+'/')+'))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector))))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32('+PadIter+name+'/Allocatie/IsAfgewezen_Cumulatief)))'
				+ ' + ' + quote(';')
				+ ' + string(sum(uint32(IsDefined('+PadIter+name+'/Allocatie/per_SectorxSubsector) && collect_by_cond(/Geography/CompactedAdminDomain, /Geography/AdminDomain/IsCompactedDomain, /SourceData/Grondgebruik/BRT/IsWoonkern/Per_AdminDomain))))'
				+ ' + ' + quote('|');
		}

		parameter<String> Samenvatting := =quote('iter;stand_banen;gealloceerd;afgewezen_deze_iter;afgewezen_cumulatief;gealloceerd_in_woonkern|')+' + '+AsList(Iters/expr, ' + ')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_werken_convergentie.txt'", StorageType = "str";
	}


	// --- verblijfsrecreatie: staat de stand al boven de claim voordat er iets gealloceerd is? (#364) ---
	container Verblijfsrecreatie_Stand
	: Descr = "Zet de basisjaarstand verblijfsrecreatie naast de telling waar de claim op rust. stand_allelogies is de telling van voor #364, stand_incbs die erna, en trend_recentjaar is het aantal logies binnen de CBS-verblijfsrecreatiegebieden in het recentste BAG-jaar, oftewel het startpunt van de claim."
	{
		parameter<String> Logies := '/BaseData/StartState/PandFootprint/PerYear_AdminDomain/Y'+string(/ModelParameters/Model_StartYear)+'/pand_met_vbo/PerGebruiksdoel_corr/logies/';
		parameter<String> Trend  := '/BaseData/StartState/Verblijfsrecreatie_Trends/DataPrep/ReadData_BAG/Y'+string(/ModelParameters/BAG_RecentYear)+'/PerRegio/Objecten';

		parameter<String> Samenvatting := =('
			  '+quote('stand_allelogies;')+'         + string(sum('+Logies+'count_Per_AdminDomain))
			+ '+quote(';stand_incbs;')+'             + string(sum('+Logies+'count_Per_AdminDomain_inCBSVerblijfsrecreatie))
			+ '+quote(';trend_recentjaar;')+'        + string(sum(value('+Trend+', float32)))
			+ '+quote(';nieuwbouw_allelogies;')+'    + string(sum(value(/BaseData/StartState/BAG_nieuwbouw/Verblijfsrecreatie/Totaal_AlleLogies, float32)))
			+ '+quote(';nieuwbouw_incbs;')+'         + string(sum(value(/BaseData/StartState/BAG_nieuwbouw/Verblijfsrecreatie/Totaal_inCBSVerblijfsrecreatie, float32)))
		')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_stand.txt'", StorageType = "str";

		unit<uint32> Prov := /SourceData/RegioIndelingen/CBS/Last/Provincie;

		attribute<Float32> stand_allelogies (Prov) := =('sum('+Logies+'count_Per_AdminDomain, Prov/Per_AdminDomain)');
		attribute<Float32> stand_incbs      (Prov) := =('sum('+Logies+'count_Per_AdminDomain_inCBSVerblijfsrecreatie, Prov/Per_AdminDomain)');
		attribute<Float32> trend_recentjaar (Prov) := =('value('+Trend+', float32)');
		attribute<Float32> nieuwb_allelogies(Prov) := sum(value(/BaseData/StartState/BAG_nieuwbouw/Verblijfsrecreatie/Totaal_AlleLogies, float32), Prov/Per_CompactedAdminDomain);
		attribute<Float32> nieuwb_incbs     (Prov) := sum(value(/BaseData/StartState/BAG_nieuwbouw/Verblijfsrecreatie/Totaal_inCBSVerblijfsrecreatie, float32), Prov/Per_CompactedAdminDomain);

		attribute<String> Regel (Prov) := Prov/name + ';' + string(stand_allelogies) + ';' + string(stand_incbs) + ';' + string(trend_recentjaar)
										+ ';' + string(nieuwb_allelogies) + ';' + string(nieuwb_incbs)
										+ ';' + string((stand_allelogies + nieuwb_allelogies) / trend_recentjaar)
										+ ';' + string((stand_incbs + nieuwb_incbs) / trend_recentjaar);

		parameter<String> PerProvincie := 'provincie;stand_alle;stand_incbs;trend_recentjaar;nieuwb_alle;nieuwb_incbs;ratio_oud;ratio_nieuw|' + AsList(Regel, '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_stand_prov.txt'", StorageType = "str";

		parameter<String> TrendFingerprint := /BaseData/StartState/Verblijfsrecreatie_Trends/Trends/Fingerprint
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_fingerprint.txt'", StorageType = "str"
		, Descr = "De verwachte fingerprint van het beta-bestand, om een elders gegenereerde mmd met een kloppend zijbestand herbruikbaar te maken.";
		parameter<String> TrendBetasFile := /BaseData/StartState/Verblijfsrecreatie_Trends/Trends/BetasFile
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_betasfile.txt'", StorageType = "str";

		container Daken
		: Descr = "Meet de dubbeltelling van logies in de dakensom van de waterberging-aanbodindicator. Die som telt Wonen plus Werken plus Verblijfsrecreatie, terwijl logies via de Jobs6-subsector Ov_consumentendiensten al in de werken-footprint zit. Sinds #364 telt de verblijfsrecreatie-term alleen nog logies binnen de CBS-verblijfsrecreatiegebieden, dus de overlap is de logies-footprint binnen dat gebied."
		{
			parameter<String> P := '/BaseData/StartState/PandFootprint/PerYear_AdminDomain/Y'+string(/ModelParameters/Model_StartYear)+'/pand_met_vbo/';

			parameter<Float32> CelM2 := value(/Geography/AdminDomain/NrMeter2PerCell, float32);

			attribute<Float32> FP_logies      (/Geography/AdminDomain) := =('MakeDefined(value('+P+'PerGebruiksdoel_corr/logies/Footprint_Per_AdminDomain, float32), 0f)');
			attribute<Float32> FP_logies_cbs  (/Geography/AdminDomain) := =('MakeDefined(value('+P+'PerGebruiksdoel_corr/logies/Footprint_Per_AdminDomain_inCBSVerblijfsrecreatie, float32), 0f)');
			attribute<Float32> FP_bijeenkomst (/Geography/AdminDomain) := =('MakeDefined(value('+P+'PerGebruiksdoel_corr/bijeenkomst/Footprint_Per_AdminDomain, float32), 0f)');
			attribute<Float32> FP_sport       (/Geography/AdminDomain) := =('MakeDefined(value('+P+'PerGebruiksdoel_corr/sport/Footprint_Per_AdminDomain, float32), 0f)');
			attribute<Float32> OvC            (/Geography/AdminDomain) := =('MakeDefined(value('+P+'Footprint_perJobs6_AdminDomain/Ov_consumentendiensten, float32), 0f)');

			attribute<Float32> OvC_zonderLogies (/Geography/AdminDomain) := min_elem(FP_bijeenkomst + FP_sport, CelM2)
			, Descr = "Dezelfde subsectorsom als Footprint_perJobs6_AdminDomain maar zonder de logies-term, met dezelfde afkapping op celoppervlak.";

			attribute<Float32> Logies_inWerken (/Geography/AdminDomain) := OvC - OvC_zonderLogies
			, Descr = "Wat logies feitelijk bijdraagt aan de werken-footprint, inclusief het effect van de afkapping op celoppervlak.";

			attribute<Float32> Dubbel (/Geography/AdminDomain) := min_elem(Logies_inWerken, FP_logies_cbs)
			, Descr = "Het deel van de dakensom dat twee keer meetelt: de logies-footprint die zowel in de werken-term als in de verblijfsrecreatie-term zit.";

			attribute<Float32> Dak_wonen  (/Geography/AdminDomain) := MakeDefined(value(/BaseData/StartState/StateBasisjaar/State/Wonen/Footprint, float32), 0f);
			attribute<Float32> Dak_werken (/Geography/AdminDomain) := MakeDefined(value(/BaseData/StartState/StateBasisjaar/State/PandFootprint/Totaal, float32), 0f);
			attribute<Float32> Dak_vbr    (/Geography/AdminDomain) := MakeDefined(value(/BaseData/StartState/StateBasisjaar/State/Verblijfsrecreatie/Footprint, float32), 0f);
			attribute<Float32> Dak_totaal (/Geography/AdminDomain) := Dak_wonen + Dak_werken + Dak_vbr;

			parameter<String> Samenvatting :=
				  'fp_logies_alle_m2;'      + string(sum(FP_logies))
				+ ';fp_logies_incbs_m2;'    + string(sum(FP_logies_cbs))
				+ ';logies_in_werken_m2;'   + string(sum(Logies_inWerken))
				+ ';dubbel_m2;'             + string(sum(Dubbel))
				+ ';dak_wonen_m2;'          + string(sum(Dak_wonen))
				+ ';dak_werken_m2;'         + string(sum(Dak_werken))
				+ ';dak_vbr_m2;'            + string(sum(Dak_vbr))
				+ ';dak_totaal_m2;'         + string(sum(Dak_totaal))
				+ ';dubbel_fractie_dak;'    + string(sum(Dubbel) / sum(Dak_totaal))
				+ ';cellen_met_dubbel;'     + string(sum(uint32(Dubbel > 0f)))
				+ ';cellen_met_vbr;'        + string(sum(uint32(Dak_vbr > 0f)))
				+ ';dubbel_max_cel_m2;'     + string(max(Dubbel))
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_daken.txt'", StorageType = "str";

			unit<uint32> ProvD := /SourceData/RegioIndelingen/CBS/Last/Provincie;

			attribute<String> Regel (ProvD) :=
				ProvD/name + ';' + string(sum(Dubbel, ProvD/Per_AdminDomain))
				+ ';' + string(sum(Dak_totaal, ProvD/Per_AdminDomain))
				+ ';' + string(sum(Dubbel, ProvD/Per_AdminDomain) / sum(Dak_totaal, ProvD/Per_AdminDomain));

			parameter<String> PerProvincie := 'provincie;dubbel_m2;dak_totaal_m2;fractie|' + AsList(Regel, '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_daken_prov.txt'", StorageType = "str";
		}

		unit<uint32> ProvB := /SourceData/RegioIndelingen/CBS/Last/Provincie;
		parameter<String> ClaimsPad := '/VariantData/BAU/Claims/WLO_hoog/Zichtjaren/';
		container Dichtheden
		: Descr = "Per provincie de gemiddelde en de marginale dichtheid en de claims voor 2030 en 2060, om de dichtheidsschakelaar te toetsen (leest de beta-mmd via het fingerprint-mechanisme, rekent de trendketen dus niet door)."
		{
			attribute<Float32> gemiddeld_2030 (ProvB) := =ClaimsPad+'Y2030/AllocRegios/Provincie/Verblijfsrecreatie/Object_perHa_gemiddeld[float32]';
			attribute<Float32> marginaal_2030 (ProvB) := =ClaimsPad+'Y2030/AllocRegios/Provincie/Verblijfsrecreatie/Object_perHa_marginaal[float32]';
			attribute<Float32> actief_2030    (ProvB) := =ClaimsPad+'Y2030/AllocRegios/Provincie/Verblijfsrecreatie/Object_perHa[float32]';
			attribute<Float32> objecten_2030  (ProvB) := =ClaimsPad+'Y2030/AllocRegios/Provincie/Verblijfsrecreatie/Objecten[float32]';
			attribute<Float32> objecten_2060  (ProvB) := =ClaimsPad+'Y2060/AllocRegios/Provincie/Verblijfsrecreatie/Objecten[float32]';
			attribute<Float32> brutoopp_2060  (ProvB) := =ClaimsPad+'Y2060/AllocRegios/Provincie/Verblijfsrecreatie/BrutoOpp[float32]';

			attribute<String> Regel (ProvB) := ProvB/name +';'+ string(gemiddeld_2030) +';'+ string(marginaal_2030) +';'+ string(actief_2030) +';'+ string(objecten_2030) +';'+ string(objecten_2060) +';'+ string(brutoopp_2060);
			parameter<String> Uitdraai := 'provincie;dichtheid_gemiddeld_2030;dichtheid_marginaal_2030;dichtheid_actief_2030;claim_objecten_2030;claim_objecten_2060;claim_brutoopp_2060|' + AsList(Regel, '|')
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_verblijfsrecreatie_dichtheden.txt'", StorageType = "str";
		}
	}

	// --- extra natuur zand: past de opgave in de zeef, en wat realiseert de allocatie (#652) ---
	container ZandNatuur
	: Descr = "Meet de twee dingen die bij de natuurallocatie van het landschapstype Zand mis kunnen gaan: een zeef die te klein is voor de opgave, en een allocatie die de opgave niet haalt. Het eerste is een gegeven van de invoer, het tweede kan ook aan de verdeling over de regio's liggen."
	{
		parameter<String> Pad := '/SourceData/Grondgebruik/Natuur/';

		parameter<String> zeven :=
			  'claimregios_ha;'   + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_Claimregios)
			+ ';zeef_nat_ha;'     + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_Zeef_Nat)
			+ ';zeef_droog_ha;'   + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_Zeef_Droog)
			+ ';droogbkn_ha;'     + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_DroogBKN)
			+ ';nnn_ha;'          + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_NNN)
			+ ';beekdal_ha;'      + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_Beekdal_Totaal)
			+ ';beekdal_landbouw_ha;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Controle/Areaal_Beekdal_AlleLandbouw)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_zeven.txt'", StorageType = "str";

		parameter<String> realisatie_NbSGenuanceerd :=
			  'claim_ha;'         + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Claim_NL)
			+ ';gerealiseerd_ha;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Gerealiseerd_NL)
			+ ';tekort_ha;'       + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Tekort_NL)
			+ ';nat_claim_ha;'    + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Claim_NL)
			+ ';nat_gereal_ha;'   + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Gerealiseerd_NL)
			+ ';droog_claim_ha;'  + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Claim_NL)
			+ ';droog_gereal_ha;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Gerealiseerd_NL)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_realisatie.txt'", StorageType = "str";

		parameter<String> vorm :=
			  'nat_aaneengesloten;'      + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Aaneengeslotenheid)
			+ ';nat_aselect;'            + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Aaneengeslotenheid_Aselect)
			+ ';nat_zelfde_type;'        + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Aaneengeslotenheid_Type)
			+ ';nat_vulgraad;'           + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Vulgraad)
			+ ';droog_aaneengesloten;'   + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Aaneengeslotenheid)
			+ ';droog_aselect;'          + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Aaneengeslotenheid_Aselect)
			+ ';droog_zelfde_type;'      + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Aaneengeslotenheid_Type)
			+ ';droog_vulgraad;'         + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Vulgraad)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_vorm.txt'", StorageType = "str"
		, Descr = "Het spikkelpatroon uit #652 in een getal. Aaneengesloten is het aandeel van de dertien cellen binnen 50 meter dat ook natuur wordt, gemiddeld over de cellen die natuur worden; aselect is wat datzelfde getal zou zijn als de opgave willekeurig over de zeef was gestrooid. De verhouding tussen die twee is de toets.";

		parameter<String> krapte_droog := 'regio;claim_ha;kandidaat_ha;krapte_ha;verlies_panden_ha|' + AsList(
			/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Claimregio_Droog/Label + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Claim_Totaal) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Areaal_Kandidaat) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Krapte) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Droog/Controle/Areaal_Verlies_Pandentoets), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_krapte_droog.txt'", StorageType = "str";

		parameter<String> krapte_nat := 'regio;claim_ha;kandidaat_ha;krapte_ha;verlies_panden_ha|' + AsList(
			/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Claimregio_Nat/Label + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Claim_Totaal) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Areaal_Kandidaat) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Krapte) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Alloc/Alloc_Nat/Controle/Areaal_Verlies_Pandentoets), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_zandnatuur_krapte_nat.txt'", StorageType = "str";
	}

	// --- natuur veen: haalt de allocatie de opgave, en wordt het geen spikkelkaart (#660) ---
	container VeenNatuur
	: Descr = "Meet wat er bij de veenallocatie mis kan gaan. Drie dingen. De zeef kan te klein zijn voor de opgave, en dan wordt het areaal niet gehaald. De rastering kan van de vectorbron weglopen, en dan klopt de opgave zelf al niet. En de allocatie kan de opgave halen met een kaart die uit losse cellen bestaat.

				Dat laatste is het punt waar de zandallocatie in #652 op strandde en het is met het oog niet te zien: op een uitgezoomde kaart oogt een spikkelkaart net zo groen als een vlekkenkaart. De uitdraai vorm hieronder is de toets."
	{
		parameter<String> zeven :=
			  'veengebied_ha;'        + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_Veengebied)
			+ ';zeef_natuur_ha;'      + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_Zeef_Natuur)
			+ ';zeef_water_ha;'       + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_Zeef_Water)
			+ ';bebouwing_blijft_ha;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_BebouwingBlijft)
			+ ';al_natuur_ha;'        + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_AlNatuur)
			+ ';al_water_ha;'         + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_AlWater)
			+ ';verlies_panden_ha;'   + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Verlies_Pandentoets)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veennatuur_zeven.txt'", StorageType = "str"
		, Descr = "Wat de twee schakelaars OntzieBebouwingsklassen en OntzieBestaandeNatuur uit het veengebied halen, en wat er voor de allocatie overblijft. De laatste kolom is wat de pandentoets uit #661 er nog eens afhaalt; die zit niet in de zeef van veen zelf maar in NatuurAlloc_T.";

		parameter<String> realisatie :=
			  'claim_ha;'            + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Claim_Totaal)
			+ ';claim_ntypen_ha;'    + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Claim_NTypen)
			+ ';claim_openwater_ha;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Claim_OppervlakteWater)
			+ ';gerealiseerd_ha;'    + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Gerealiseerd_Totaal)
			+ ';tekort_ha;'          + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Tekort_Totaal)
			+ ';opgelegd_natuur_ha;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_ExoNatuur)
			+ ';opgelegd_water_ha;'  + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/Areaal_ExoWater)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veennatuur_realisatie.txt'", StorageType = "str"
		, Descr = "De opgave, de realisatie en wat er uiteindelijk wordt opgelegd. Opgelegd_natuur ligt onder gerealiseerd, want NatuurAlloc_T rekent alles wat het gealloceerd heeft mee en de oplegging valt daarna nog door de toets op bestaand bebouwd gebied en op exogeen grondgebruik.";

		parameter<String> pertype := 'type;geleverd_ha;gerasterd_ha;ratio;gerealiseerd_ha;tekort_ha|' + AsList(
			  /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/PerType/Label + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/PerType/Vector) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/PerType/Raster) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/PerType/Ratio) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/PerType/Gerealiseerd) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Controle/PerType/Tekort), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veennatuur_pertype.txt'", StorageType = "str"
		, Descr = "Per natuurbeheertype en voor het oppervlaktewater: wat de levering geeft, wat het model ervan rastert, de verhouding daartussen, en wat de allocatie er neerzet.";

		parameter<String> vorm :=
			  'aaneengesloten;' + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Aaneengeslotenheid)
			+ ';aselect;'       + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Aaneengeslotenheid_Aselect)
			+ ';zelfde_type;'   + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Aaneengeslotenheid_Type)
			+ ';vulgraad;'      + string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Vulgraad)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veennatuur_vorm.txt'", StorageType = "str"
		, Descr = "De spikkeltoets. Aaneengesloten is het aandeel van de dertien cellen binnen 50 meter dat ook natuur wordt, gemiddeld over de cellen die natuur worden; aselect is wat datzelfde getal zou zijn als de opgave willekeurig over de zeef was gestrooid. De verhouding tussen die twee is de toets, niet de hoogte van een van de twee. Zelfde_type doet hetzelfde voor de buren met hetzelfde beheertype en zegt of de typen als vlekken naast elkaar liggen of door elkaar heen.

					Zelfde_type is duur: NatuurAlloc_T rekent daarvoor per type een potentiaal over het hele AdminDomain, en dat zijn er hier negentien tegen drie bij zand. Vraag hem apart op als een run krap zit.";

		container Krapte
		: Descr = "Splitst het tekort in het deel dat de capaciteit per peilvak afdwingt en het deel dat er binnen een peilvak nog te kiezen viel. Krapte is per peilvak de opgave min de kandidaatruimte van datzelfde peilvak, dus de som van de positieve krapte is het tekort dat eruit komt hoe de allocator ook kiest.

					Ligt die som dicht bij het gemeten tekort, dan is het tekort peilvakcapaciteit. Blijft hij er duidelijk onder, dan zit het verschil in de typekeuze binnen het peilvak en is er een tweede, losse oorzaak. Zie #660.

					De keerzijde staat er bewust naast. Een peilvak met meer kandidaatruimte dan opgave houdt ruimte over, en die kan per constructie niet naar een krap peilvak verhuizen. Bij 7.689 claimregio's van gemiddeld 69 ha is dat geen randverschijnsel."
		{
			unit<uint32> P := /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Peilvak;

			attribute<float32> Krapte (P) := float32(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Krapte)
			, Descr = "Positief betekent dat de opgave niet in de zeef van dat peilvak past. Let op dat Areaal_Kandidaat cellen telt die voor tenminste een type kandidaat zijn, dus voor de terrestrische typen apart is het krapper dan dit getal zegt.";

			attribute<float32> Opgave (P) := float32(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Claim_Totaal);
			attribute<float32> Ruimte (P) := float32(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Alloc/Controle/Areaal_Kandidaat);

			attribute<bool> IsKrap (P) := Krapte > 0f;
			attribute<bool> IsRuim (P) := Krapte < 0f;

			parameter<float32> Afgedwongen_Tekort := sum(max_elem(Krapte, 0f));
			parameter<float32> Overschot          := sum(max_elem(0f - Krapte, 0f));
			parameter<float32> N_Krap             := sum(float32(IsKrap));
			parameter<float32> N_Ruim             := sum(float32(IsRuim));
			parameter<float32> Opgave_in_Krappe   := sum(IsKrap ? Opgave : 0f);
			parameter<float32> Ruimte_in_Krappe   := sum(IsKrap ? Ruimte : 0f);

			parameter<String> uitdraai :=
				  'afgedwongen_tekort_ha;' + string(Afgedwongen_Tekort)
				+ ';overschot_ha;'         + string(Overschot)
				+ ';n_peilvak;'            + string(#P)
				+ ';n_krap;'               + string(N_Krap)
				+ ';n_ruim;'               + string(N_Ruim)
				+ ';opgave_in_krappe_ha;'  + string(Opgave_in_Krappe)
				+ ';ruimte_in_krappe_ha;'  + string(Ruimte_in_Krappe)
			, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_veennatuur_krapte.txt'", StorageType = "str"
			, Descr = "Leg afgedwongen_tekort_ha naast tekort_ha uit veennatuur_realisatie. Vallen die twee samen, dan is het tekort volledig peilvakcapaciteit en helpt alleen ruimte erbij in de krappe peilvakken of een opgave die zich naar die peilvakken voegt.";
		}
	}

	// --- natuur: welke bron legt waar op, en hoeveel overlappen ze (#652) ---
	container NatuurOverzicht
	: Descr = "Zet de natuurbronnen naast elkaar en meet de overlap. Alles op AdminDomain, binnen het studiegebied.

				Twee stromen die uit elkaar gehouden moeten worden. Opleggen betekent dat de cel van grondgebruik
				verandert: de bestaande bebouwing verdwijnt, de landbouw verdwijnt, en de indicatoren voor
				landgebruik, NDVI, koolstof en de sloop- en uitkoopkosten rekenen erop af. Op slot betekent alleen
				dat er geen nieuwbouw meer bij komt; wat er staat blijft staan. Een gebied kan het een zijn, het
				ander, of allebei."
	{
		parameter</Units/ha> Cel := /Geography/AdminDomain/NrHaPerCell;

		attribute<Bool> InStudy     (/Geography/AdminDomain) := /Geography/rdc_meter/IsStudyArea_AdminDomain;
		attribute<Bool> MagOpleggen (/Geography/AdminDomain) := /BaseData/Omgeving/Opleggingsmasker/MagOpleggen
		, Descr = "Het gedeelde opleggingsmasker, hetzelfde item dat VariantData/ExogeenOpleggen en de natuurallocatie lezen. Hier stond tot #661 een eigen kopie die alleen op bestaand bebouwd gebied toetste, waardoor de kolom die zegt hoeveel er na het masker overblijft te hoog uitkwam.";

		// de vier landschapstypen plus de MNP-achtervang, zoals ExogeenOpleggen ze in NbSGenuanceerd gebruikt
		attribute<Bool> Veen     (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Veen/Natuur);
		attribute<Bool> Kust     (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Kust/Natuur);
		attribute<Bool> Rivieren (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Natuur);
		attribute<Bool> Zand     (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/Natuur);
		attribute<Bool> MNP      (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Bron/Landelijk_BAU/ExoNatuur);

		attribute<Bool> VierBeelden (/Geography/AdminDomain) := Veen || Kust || Rivieren || Zand;
		attribute<Bool> MetMNP      (/Geography/AdminDomain) := VierBeelden || MNP;

		parameter<String> opleggen :=
			  'bron;levering_ha;na_masker_ha'
			+ '|veen;'      + string(sum(float32(Veen)     * Cel)) + ';' + string(sum(float32(Veen     && MagOpleggen) * Cel))
			+ '|kust;'      + string(sum(float32(Kust)     * Cel)) + ';' + string(sum(float32(Kust     && MagOpleggen) * Cel))
			+ '|rivieren;'  + string(sum(float32(Rivieren) * Cel)) + ';' + string(sum(float32(Rivieren && MagOpleggen) * Cel))
			+ '|zand;'      + string(sum(float32(Zand)     * Cel)) + ';' + string(sum(float32(Zand     && MagOpleggen) * Cel))
			+ '|mnp_bau;'   + string(sum(float32(MNP)      * Cel)) + ';' + string(sum(float32(MNP      && MagOpleggen) * Cel))
			+ '|vier_beelden_unie;' + string(sum(float32(VierBeelden) * Cel)) + ';' + string(sum(float32(VierBeelden && MagOpleggen) * Cel))
			+ '|met_mnp_unie;'      + string(sum(float32(MetMNP)      * Cel)) + ';' + string(sum(float32(MetMNP      && MagOpleggen) * Cel))
			+ '|mnp_bovenop_beelden;' + string(sum(float32(MNP && !VierBeelden) * Cel)) + ';' + string(sum(float32(MNP && !VierBeelden && MagOpleggen) * Cel))
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_opleggen.txt'", StorageType = "str";

		// wat legt de MNP-achtervang eigenlijk op: is dat bestaande natuur of landbouwgrond
		attribute<Bool> Achtervang (/Geography/AdminDomain) := MNP && !VierBeelden
		, Descr = "De cellen waar de MNP-BAU-kaart in de NbS-varianten natuur oplegt zonder dat een landschapstype daar iets zegt. Dit is precies wat er wegvalt als de achtervang eruit gaat.";

		attribute</Classifications/Grondgebruik/LGNKlasse> LGN (/Geography/AdminDomain) := /SourceData/Grondgebruik/LGN/m25;

		parameter<String> mnp_achtervang :=
			  'klasse;ha'
			+ '|achtervang_totaal;'  + string(sum(float32(Achtervang) * Cel))
			+ '|al_natuur_lgn;'      + string(sum(float32(Achtervang && MakeDefined(/Classifications/Grondgebruik/LGNKlasse/IsNatuur_hedonisch[LGN], FALSE)) * Cel))
			+ '|al_water_lgn;'       + string(sum(float32(Achtervang && MakeDefined(/Classifications/Grondgebruik/LGNKlasse/IsWater_hedonisch[LGN], FALSE)) * Cel))
			+ '|al_bebouwd_lgn;'     + string(sum(float32(Achtervang && MakeDefined(/Classifications/Grondgebruik/LGNKlasse/isBebouwd[LGN], FALSE)) * Cel))
			+ '|nu_landbouw;'        + string(sum(float32(Achtervang && MakeDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/IsAgrarisch[LGN], FALSE)) * Cel))
			+ '|in_natura2000;'      + string(sum(float32(Achtervang && /SourceData/Omgevingsrecht/EU/Natura2000/Result_AdminDomain) * Cel))
			+ '|in_nnn;'             + string(sum(float32(Achtervang && /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/IsNNN_100m[/Geography/AdminDomain/rdc_100m_rel]) * Cel))
			+ '|landbouw_buiten_nnn;' + string(sum(float32(Achtervang && MakeDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/IsAgrarisch[LGN], FALSE) && !/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/IsNNN_100m[/Geography/AdminDomain/rdc_100m_rel]) * Cel))
			+ '|restrictie_wonen_zeerhard;' + string(sum(float32(Achtervang && /SourceData/Restricties/Wonen/ZeerHard) * Cel))
			+ '|restrictie_wonen_hard;'     + string(sum(float32(Achtervang && /SourceData/Restricties/Wonen/Hard) * Cel))
			+ '|restrictie_wonen_geen;'     + string(sum(float32(Achtervang && /SourceData/Restricties/Wonen/Geen) * Cel))
			+ '|landbouw_zonder_restrictie;' + string(sum(float32(Achtervang && MakeDefined(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/IsAgrarisch[LGN], FALSE) && /SourceData/Restricties/Wonen/Geen) * Cel))
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_mnp_achtervang.txt'", StorageType = "str";

		parameter<String> basisjaarnatuur :=
			  'maat;ha'
			+ '|natuur_basisjaar;'      + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_Natuur)
			+ '|met_beheertype;'        + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_MetBeheertype)
			+ '|zonder_beheertype;'     + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_ZonderBeheertype)
			+ '|mnp_plandeel;'          + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_MNP_Plandeel)
			+ '|bt_uit_nvk;'            + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_uit_NVK)
			+ '|bt_uit_mnp;'            + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_uit_MNP)
			+ '|bt_alleen_nvk;'         + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_alleen_NVK)
			+ '|bt_beide;'              + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_Beide)
			+ '|bt_eens;'               + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_BT_Eens)
			+ '|nt_eens;'               + string(/SourceData/Grondgebruik/Natuur/Basisjaar/Controle/Areaal_NT_Eens)
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_basisjaar.txt'", StorageType = "str";

		parameter<String> oplegging_per_variant :=
			  'variant;opgelegd_ha'
			+ '|BAU;'            + string(sum(float32(IsDefined(/VariantData/BAU/ExogeenOpleggen/Totaal))            * Cel))
			+ '|NbSMax;'         + string(sum(float32(IsDefined(/VariantData/NbSMax/ExogeenOpleggen/Totaal))         * Cel))
			+ '|NbSGenuanceerd;' + string(sum(float32(IsDefined(/VariantData/NbSGenuanceerd/ExogeenOpleggen/Totaal)) * Cel))
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_oplegging_per_variant.txt'", StorageType = "str";

		// #511 liet een toets open: overlapt de BAU-rivierenkaart van Deltares met de MNP-kaart van WUR?
		attribute<Bool> RivierBAU (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Bron/Rivieren_BAU/NatuurTypen_rel_AD);
		attribute<Bool> MNP_Natuur (/Geography/AdminDomain) := InStudy && IsDefined(/SourceData/Grondgebruik/Natuur/Bron/Landelijk_BAU/ExoNatuur);

		parameter<String> rivierbau_vs_mnp :=
			  'maat;ha'
			+ '|rivierbau_totaal;'        + string(sum(float32(RivierBAU) * Cel))
			+ '|ook_in_mnp;'              + string(sum(float32(RivierBAU && MNP_Natuur) * Cel))
			+ '|niet_in_mnp;'             + string(sum(float32(RivierBAU && !MNP_Natuur) * Cel))
			+ '|niet_in_mnp_en_nu_geen_natuur;' + string(sum(float32(RivierBAU && !MNP_Natuur && !/SourceData/Grondgebruik/Natuur/Basisjaar/IsNatuur) * Cel))
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rivierbau_vs_mnp.txt'", StorageType = "str";

		parameter<String> rivieren_ecotopen := 'ecotoop;levering_ha;raster_ha;ratio|' + AsList(
			/Classifications/Grondgebruik/NbSRivieren/RivierEcotoop/name + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Controle/PerEcotoop/Vector) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Controle/PerEcotoop/Raster) + ';'
			+ string(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Controle/PerEcotoop/Ratio), '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rivieren_ecotopen.txt'", StorageType = "str";

		// klopt de zonering: loopt de diepte af langs de gradient, en landt het zomerbed op bestaand water
		unit<uint8> GradientK := /Classifications/Grondgebruik/NbSRivieren/Gradient
		{
			attribute<string>  Naam         := /Classifications/Grondgebruik/NbSRivieren/Gradient/name;
			attribute<float32> Diepte_Gem   := mean(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Diepte_Cel[float32], /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Gradient_rel_Cel);
			attribute<float32> Fr_OpWater   := mean(float32(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/IsWater_Cel), /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Gradient_rel_Cel);
			attribute<uint32>  Aantal       := pcount(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Gradient_rel_Cel)[uint32];
			attribute<float32> Kern_Gem     := mean(/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Waterkern_AD[/SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/RivierCel/AdminDomain_rel], /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/Gradient_rel_Cel);
			attribute<string>  Regel        := Naam + ';' + string(Aantal) + ';' + string(Diepte_Gem) + ';' + string(Fr_OpWater) + ';' + string(Kern_Gem);
		}

		parameter<String> rivieren_zonering := 'ecotoop;cellen;diepte_gem_m;aandeel_op_bestaand_water;waterkern_gem|' + AsList(GradientK/Regel, '|')
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_rivieren_zonering.txt'", StorageType = "str";

		parameter<String> opleg_overlap :=
			  'paar;overlap_ha'
			+ '|veen_kust;'         + string(sum(float32(Veen && Kust) * Cel))
			+ '|veen_rivieren;'     + string(sum(float32(Veen && Rivieren) * Cel))
			+ '|veen_zand;'         + string(sum(float32(Veen && Zand) * Cel))
			+ '|kust_rivieren;'     + string(sum(float32(Kust && Rivieren) * Cel))
			+ '|kust_zand;'         + string(sum(float32(Kust && Zand) * Cel))
			+ '|rivieren_zand;'     + string(sum(float32(Rivieren && Zand) * Cel))
			+ '|mnp_veen;'          + string(sum(float32(MNP && Veen) * Cel))
			+ '|mnp_kust;'          + string(sum(float32(MNP && Kust) * Cel))
			+ '|mnp_rivieren;'      + string(sum(float32(MNP && Rivieren) * Cel))
			+ '|mnp_zand;'          + string(sum(float32(MNP && Zand) * Cel))
			+ '|som_vier_los;'      + string(sum(float32(Veen) * Cel) + sum(float32(Kust) * Cel) + sum(float32(Rivieren) * Cel) + sum(float32(Zand) * Cel))
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_opleg_overlap.txt'", StorageType = "str";

		// de zeefkant: waar gaat het gebied op slot voor nieuwbouw
		attribute<Bool> Zeef_Veen     (/Geography/AdminDomain) := InStudy && /BaseData/Omgeving/Bebouwingstype_Veen_NbSGenuanceerd/bebouwingstype_nbsnuanc/NietBouwen;
		attribute<Bool> Zeef_Kust     (/Geography/AdminDomain) := InStudy && /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Kust/NietBouwen;
		attribute<Bool> Zeef_Zand     (/Geography/AdminDomain) := InStudy && /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Zand/NietBouwen;
		attribute<Bool> Zeef_Rivieren (/Geography/AdminDomain) := InStudy && /SourceData/Grondgebruik/Natuur/Varianten/NbSGenuanceerd/Landschap/Rivieren/NietBouwen;
		attribute<Bool> Zeef_Unie     (/Geography/AdminDomain) := Zeef_Veen || Zeef_Kust || Zeef_Zand || Zeef_Rivieren;

		parameter<String> zeef :=
			  'bron;op_slot_ha;waarvan_ook_opgelegd_ha'
			+ '|veen;'     + string(sum(float32(Zeef_Veen)     * Cel)) + ';' + string(sum(float32(Zeef_Veen     && VierBeelden && MagOpleggen) * Cel))
			+ '|kust;'     + string(sum(float32(Zeef_Kust)     * Cel)) + ';' + string(sum(float32(Zeef_Kust     && VierBeelden && MagOpleggen) * Cel))
			+ '|zand;'     + string(sum(float32(Zeef_Zand)     * Cel)) + ';' + string(sum(float32(Zeef_Zand     && VierBeelden && MagOpleggen) * Cel))
			+ '|rivieren;' + string(sum(float32(Zeef_Rivieren) * Cel)) + ';' + string(sum(float32(Zeef_Rivieren && VierBeelden && MagOpleggen) * Cel))
			+ '|unie;'     + string(sum(float32(Zeef_Unie)     * Cel)) + ';' + string(sum(float32(Zeef_Unie     && VierBeelden && MagOpleggen) * Cel))
			+ '|opgelegd_zonder_zeef;' + string(sum(float32(VierBeelden && MagOpleggen && !Zeef_Unie) * Cel)) + ';0'
			+ '|zeef_overlap_veen_zand;' + string(sum(float32(Zeef_Veen && Zeef_Zand) * Cel)) + ';0'
			+ '|zeef_overlap_zand_rivieren;' + string(sum(float32(Zeef_Zand && Zeef_Rivieren) * Cel)) + ';0'
			+ '|zeef_overlap_veen_rivieren;' + string(sum(float32(Zeef_Veen && Zeef_Rivieren) * Cel)) + ';0'
			+ '|zeef_overlap_veen_kust;' + string(sum(float32(Zeef_Veen && Zeef_Kust) * Cel)) + ';0'
		, StorageName = "='%LocalDataProjDir%/Diagnose/'+/Diagnose/Casus+'_'+/Diagnose/Jaar+'_natuur_zeef.txt'", StorageType = "str";
	}

}
