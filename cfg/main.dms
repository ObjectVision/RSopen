////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Dit is RSOpen, de open source versie van het model RuimteScanner. Het scipt wordt uitgegeven onder GNU-GPL licentie.
//
// RSOpen is ontwikkeld door PBL Planbureau voor de Leefomgeving, i.s.m Object Vision, VU Vrije Universiteit Amsterdam en Deltares
// Opdrachtgever/ontwikkelaar PBL: Bas van Bemmel (Bas.vanBemmel@pbl.nl)
// Contactpersoon/ontwikkelaar Object Vision: Jip Claassens (jclaassens@objectvision.nl)
// Contactpersoon/ontwikkelaar Deltares: Bart Rijken (bart.rijken@deltares.nl)
//
// Deze file specificeert:
// - het te evalueren (omgevings)scenario, de (beleids)Variant en daarmee de casus (= combinatie van scenario en Variant);
// - De ruimtelijke resolutie waarop wordt gerekend
// - de dms files die nodig zijn om betreffende caus te evalueren (met 'includes') 
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container RSopen : IntegrityCheck = "=GeoDMSVersion() >= 17.0904 ? 'TRUE' : 'Deze_error_geeft_aan_dat_je_een_nieuwere_GeoDMS_versie_moet_gebruiken'" //vanwege geos operatoren, phasecontainer, 
{
	#include <Units.dms>
	#include <Geography.dms>
	
	#include <ModelParameters.dms>
	#include <VariantParameters.dms>
	
	#include <Classifications.dms>
	container CaseClassifications := 
		for_each_ne(
			VariantParameters/VariantK/name
			,'Templates/Classificaties/CaseClassifications_T('+string(id(VariantParameters/VariantK))+'[uint8])'
		);
	
	#include <PrivData.dms>
	#include <SourceData.dms>
	#include <BaseData.dms>
	
	#include <VariantData.dms>
	#include <Allocatie.dms>

	#include <Indicatoren.dms>
	#include <PostAllocAnalyses.dms>
	
	#include <Templates.dms>
	
	#include <Preflight.dms>
	
	container CommitChecks: Descr = "Verzameling van evaluatie-triggers die de volledige berekeningsketen afdwingen via ExplicitSuppliers.
										Elke parameter evalueert pas naar 'Ready' nadat alle genoemde ExplicitSuppliers succesvol zijn berekend.
										Dit mechanisme wordt gebruikt om snel te kunnen kijken of het model nog werkt alvorens wijzigingen te committen.
										Niet geschikt voor productieruns."
	{
		parameter<string> MaakBaseData1               := 'Ready', ExplicitSuppliers = "/WriteBaseData/Generate_Run1";
		parameter<string> MaakBaseData2               := 'Ready', ExplicitSuppliers = "/WriteBaseData/Generate_Run2";
		parameter<string> MaakVariantData1            := 'Ready', ExplicitSuppliers = "=AsList('WriteVariantData/per_Variant/'+VariantParameters/VariantK/name+'/Generate_Run1',';')";
		parameter<string> MaakVariantData2            := 'Ready', ExplicitSuppliers = "=AsList('WriteVariantData/per_Variant/'+VariantParameters/VariantK/name+'/Generate_Run2',';')";
		parameter<string> MaakAllocatieFirstZichtjaar := 'Ready', ExplicitSuppliers = "=AsList('Allocatie/'+Classifications/Modellering/AllCases/Label+'/Zichtjaren/'+first(Classifications/Time/Zichtjaar/name)+'/Impl/Generate',';')";
		
		parameter<string> ClaimRealisatie_Prov_Min    := 'Ready', ExplicitSuppliers = "=AsList('/Indicatoren/'+first(Classifications/Modellering/AllCases/Label)+'/Zichtjaren/'+first(Classifications/Time/Zichtjaar/name)+'/ClaimRealisatie/Per_AllocRegio/Provincie/MinClaim_realisatie/'+CaseClassifications/BAU/StandVar/Claims_sub/name, ';')";
		parameter<string> ClaimRealisatie_Prov_Max    := 'Ready', ExplicitSuppliers = "=AsList('/Indicatoren/'+first(Classifications/Modellering/AllCases/Label)+'/Zichtjaren/'+first(Classifications/Time/Zichtjaar/name)+'/ClaimRealisatie/Per_AllocRegio/Provincie/MaxClaim_realisatie/'+CaseClassifications/BAU/StandVar/Claims_sub/name, ';')";
		parameter<string> ClaimRealisatie_Prov        := 'Ready', ExplicitSuppliers = "=AsList('/Indicatoren/'+first(Classifications/Modellering/AllCases/Label)+'/Zichtjaren/'+first(Classifications/Time/Zichtjaar/name)+'/ClaimRealisatie/Per_AllocRegio/Provincie/Claim_realisatie/all', ';')";
	}
	
	// Settings
	#include <ConfigSettings.dms>
	#include <ExportSettings.dms>
	
	// For debug purposes
	// container Desktops 
	// {
	// 	container x;
	// }
	
	#include <Diagnose.dms> //het controleharnas: de tabellen Checks en ChecksBasisjaar en de thematische uitdraaien
	#include <WritePrivData.dms>
	#include <WriteBaseData.dms>
	#include <WriteVariantData.dms>
	
	container WriteAllocatie
	: Descr = "Debug folder, om snel vanuit de GUI een hele casus door te kunnen rekenen. Elke casus heeft zelf een Impl/Generate_LastZichtjaar; dit is alleen een snelkoppeling naar de casus waar meestal aan gewerkt wordt."
	{
		parameter<string> Write_LastYear := /Allocatie/WLO_hoog_BAU/Impl/Generate_LastZichtjaar;
	}

	container BatchOndersteuning
	: Descr = "Hulpmiddel voor de batchscripts. De zichtjaren volgen uit ModelParameters/Model_FirstZichtjaar, Model_ZichtjaarInterval en Model_FinalYear, maar een cmd-script kan die set niet zelf uitlezen.
				Daarom schrijft Zichtjaren de namen als een spatiegescheiden regel weg, zodat RunZichtjaren.cmd erover kan itereren.
				Dit is bewust ALLEEN een uitleesmechanisme: het bevat geen enkele keuze over hoe de batch moet draaien. Die keuzes horen in de batch thuis, die de configuratie via omgevingsvariabelen overrult (zie ModelParameters/AlleenEindjaar en ModelParameters/StandAllocatieOntkoppeld) en dus zelf weet hoeveel processen hij moet starten."
	{
		parameter<string> ZichtjarenBestand := replace_value(expand(., '%env:RSO_ZICHTJARENFILE%'), 'env:RSO_ZICHTJARENFILE', '%LocalDataProjDir%/Allocatie/Zichtjaren.txt')
		, Descr = "Pad waar de zichtjaarlijst heen geschreven wordt. RunZichtjaren.cmd zet de omgevingsvariabele RSO_ZICHTJARENFILE zodat beide kanten gegarandeerd hetzelfde pad gebruiken.";

		parameter<string> Zichtjaren := asList(/Classifications/Time/Zichtjaar/name, ' ')
		, StorageName = "=ZichtjarenBestand", StorageType = "str"
		, Descr = "De zichtjaren, spatiegescheiden en op volgorde, bijvoorbeeld: Y2030 Y2040 Y2050 Y2060. Bij AlleenEindjaar op TRUE bevat deze lijst alleen het eindjaar, want dan bestaan de tussenliggende zichtjaren niet in de boom.";
	}
}